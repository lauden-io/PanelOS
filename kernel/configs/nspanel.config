# Config fragment merged on top of the arm64 defconfig (scripts/kconfig/merge_config.sh).
CONFIG_LOCALVERSION="-nspanel"

# Display: VOP + MIPI-DSI + ST7701S panel, fbdev console for bring-up
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# No kernel boot logo: otherwise the four penguins (one per CPU) flash up
# around the boot splash.
# CONFIG_LOGO is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y

# PMIC, regulators, I2C
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y

# eMMC
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# Logs that survive a warm reboot (read back from the stock Android)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# CONFIG_PSTORE_PMSG is not set

# Wi-Fi: Realtek RTL8723DS over SDIO (rtw88); firmware comes from the rootfs.
# RFKILL must be built in too, otherwise cfg80211 is capped at =m.
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RTW88=y
CONFIG_RTW88_8723DS=y
CONFIG_PWRSEQ_SIMPLE=y
# pwrseq_simple turns a single reset-gpios entry into a reset control, which
# needs the generic GPIO reset controller; as a module it never loads here.
CONFIG_RESET_GPIO=y
CONFIG_EXT4_FS=y

# Size: only the Rockchip platform, no PCI/ACPI/virtualisation (the panel has none)
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_NUMA is not set

# Size: the stock bootloader's time grows with the boot image
# (~50 s for 49 MB), so everything the panel does not use goes: no
# USB/Ethernet/SCSI/SATA/MTD/SPI, no NFS, no firewall, no
# EFI/kexec/hibernation, smaller symbol table. CONFIG_MODULES stays on: with
# it off, Kconfig turns every defconfig module (=m) into built-in (=y) – the
# kernel grew from 28.9 to 37.9 MB. Modules are built but never installed.
# CONFIG_USB_SUPPORT is not set
# CONFIG_ETHERNET is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_NFS_FS is not set
# CONFIG_NETFILTER is not set

# GPU (Mali-G31) for the web view: Panfrost with frequency scaling
CONFIG_DRM_PANFROST=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# The web bundle: a SquashFS image file on the persistent partition,
# mounted through a loop device
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
# CONFIG_EFI is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_MD is not set
# CONFIG_HID is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_PROFILING is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SECURITY is not set
# Second round: busybox init and the app use no cgroups, namespaces, BPF,
# audit or traffic control; build for size (-Os).
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_AUDIT is not set
# CONFIG_NET_SCHED is not set

# Touch (CST226SE, CST3xx protocol family) and raw I2C access for bring-up
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=y
CONFIG_INPUT_EVDEV=y
CONFIG_I2C_CHARDEV=y

# Ambient light + proximity (Sensortek STK3x3x) through IIO
CONFIG_IIO=y
CONFIG_STK3310=y

# Audio: RK809 codec (rk817 driver) on I2S1, simple-audio-card
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y
# Microphones on the SoC PDM controller (generic DMIC codec)
CONFIG_SND_SOC_ROCKCHIP_PDM=y
CONFIG_SND_SOC_DMIC=y

# Thermal shutdown, reboot mode register, initramfs
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
