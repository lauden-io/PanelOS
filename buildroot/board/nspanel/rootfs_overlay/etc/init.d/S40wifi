#!/bin/sh
# Bring up Wi-Fi.
#
# The system's own Wi-Fi config lives in persistent storage
# (/mnt/persist/nspanel/wpa_supplicant.conf, see S10persist). If it does not
# exist yet, it is imported once from the networks saved by the stock Android:
# its userdata partition is mounted read-only, nspanel-android-wifi reads each
# saved network on its own and turns the one in use (or else the first
# complete one: WPA personal with its password, or open) into a
# wpa_supplicant config, and the partition is unmounted again. The passphrase
# never leaves the device and is never logged (only the key wpa_passphrase
# computes from it is written).
#
# The panel never reboots because of Wi-Fi: wpa_supplicant keeps trying to
# associate and udhcpc keeps asking for an address, so a router restart or a
# Wi-Fi outage only shows as "not connected" until the network is back.

ANDROID_DATA=/dev/mmcblk0p20
WIFI_CONF=/tmp/wpa_supplicant.conf
SAVED_CONF=/mnt/persist/nspanel/wpa_supplicant.conf
WIFI_TIMEOUT=150

log() { echo "<5>nspanel-wifi: $*" > /dev/kmsg; }

config_from_android() {
	mkdir -p /mnt/android
	if ! mount -t ext4 -o ro,noload "$ANDROID_DATA" /mnt/android; then
		log "cannot mount the stock Android data partition"
		return 1
	fi
	CFG=/mnt/android/misc/wifi/WifiConfigStore.xml
	found=""
	result="no WifiConfigStore.xml"
	if [ -r "$CFG" ]; then
		result=$(nspanel-android-wifi "$CFG" "$WIFI_CONF") && found=1
	fi
	umount /mnt/android
	if [ -z "$found" ]; then
		log "no usable saved network found in the stock Android config ($result)"
		return 1
	fi
	log "using saved network $result"
	return 0
}

# Seconds to wait for wlan0 ($1).
wait_for_wlan() {
	i=0
	while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt "$1" ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -d /sys/class/net/wlan0 ]
}

# rtw88 sometimes fails at boot with "failed to dump efuse logical map" when
# the module was not really power-cycled (seen with the trimmed kernel after a
# warm restart). Rebinding the SDIO host switches its supply (vcc_wl,
# off-on-delay 200 ms) off and on and probes the card again; wlan0 is back
# 2 s after the bind.
SDIO_HOST=ff380000.mmc
heal_wlan() {
	for attempt in 1 2; do
		log "wlan0 missing, power-cycling the Wi-Fi module (attempt $attempt)"
		echo "$SDIO_HOST" > /sys/bus/platform/drivers/dwmmc_rockchip/unbind 2>/dev/null
		sleep 1
		echo "$SDIO_HOST" > /sys/bus/platform/drivers/dwmmc_rockchip/bind
		if wait_for_wlan 10; then
			log "wlan0 is back"
			return 0
		fi
	done
	return 1
}

# Kill by pid file and wait until the process is gone (a new wpa_supplicant
# started while the old one still holds its control socket does not connect).
stop_pid() {
	[ -f "$1" ] || return 0
	p=$(cat "$1")
	kill "$p" 2>/dev/null
	i=0
	while kill -0 "$p" 2>/dev/null && [ $i -lt 30 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	rm -f "$1"
}

watch_ip() {
	i=0
	while true; do
		addr=$(ip -4 -o addr show dev wlan0 2>/dev/null | sed -n 's/.* inet \([0-9.]*\).*/\1/p')
		if [ -n "$addr" ]; then
			log "connected, IP $addr"
			return 0
		fi
		if [ "$i" -eq "$WIFI_TIMEOUT" ]; then
			log "no IP address after ${WIFI_TIMEOUT}s, still trying"
			ip link show wlan0 > /dev/kmsg 2>&1
		fi
		sleep 2
		i=$((i + 2))
	done
}

start_wifi() {
	if ! wait_for_wlan 8 && ! heal_wlan; then
		log "wlan0 did not appear"
		ls /sys/class/net > /dev/kmsg
		exit 0
	fi
	if [ -s "$SAVED_CONF" ]; then
		umask 077
		cp "$SAVED_CONF" "$WIFI_CONF"
		log "using the saved Wi-Fi config"
	elif config_from_android; then
		if [ -d "$(dirname "$SAVED_CONF")" ]; then
			umask 077
			cp "$WIFI_CONF" "$SAVED_CONF"
			sync
			log "imported the stock Android network into the saved Wi-Fi config"
		fi
	else
		log "no Wi-Fi configuration"
		exit 0
	fi
	ip link set wlan0 up
	# Power save stays off, always: the panel runs on mains, and with it on the
	# RTL8723DS (rtw88) missed beacons and answered in 0.25-3 s instead of a few
	# ms. (The app keeps it off too, should a reconnect switch it on again.)
	iw dev wlan0 set power_save off 2>/dev/null
	# Connections, disconnections and access point changes go to the system
	# log (-s), when this wpa_supplicant build has syslog support.
	syslog=""
	wpa_supplicant -h 2>&1 | grep -q -- '-s = ' && syslog="-s"
	wpa_supplicant -B $syslog -i wlan0 -c "$WIFI_CONF" -P /var/run/wpa_supplicant.pid
	# Retry DHCP every second (default: 3 tries, then a 20 s pause), so an
	# association that finishes a little later still gets an address at once.
	udhcpc -i wlan0 -b -t 30 -T 1 -A 2 -p /var/run/udhcpc.wlan0.pid > /dev/null 2>&1
	watch_ip
}

case "$1" in
start)
	# In the background: the panel app (S90) starts at once and connects
	# when the network is up (it was held back until the DHCP lease, ~12 s).
	start_wifi &
	;;
stop)
	stop_pid /var/run/udhcpc.wlan0.pid
	stop_pid /var/run/wpa_supplicant.pid
	;;
restart | reload)
	"$0" stop
	"$0" start
	;;
esac
exit 0
