#!/bin/sh
# Persistent storage for this system's own settings (Wi-Fi, the Home Assistant
# address and pairing, the app's settings).
#
# A directory on the old Android "cache" partition (ext4): /mnt/persist/nspanel.
# Once the stock Android is removed (tools/remove_android.sh data), its old
# userdata partition, formatted ext4 with the label panelos-data, is mounted
# at /mnt/data for larger content.

MNT=/mnt/persist
DIR=$MNT/nspanel
DATA=/mnt/data

log() { echo "<5>nspanel-persist: $*" > /dev/kmsg; }

find_part() {
	for d in /sys/class/block/mmcblk0p*; do
		if grep -qx "PARTNAME=$1" "$d/uevent"; then
			echo "/dev/$(basename "$d")"
			return 0
		fi
	done
	return 1
}

case "$1" in
start)
	dev=$(find_part cache) || { log "no cache partition"; exit 0; }
	mkdir -p "$MNT"
	if mount -t ext4 -o rw,noatime "$dev" "$MNT"; then
		mkdir -p "$DIR"
		chmod 700 "$DIR"
		log "mounted $dev at $MNT"
	else
		log "cannot mount $dev, settings will not persist"
	fi
	if ud=$(find_part userdata) && blkid "$ud" 2>/dev/null | grep -q 'LABEL="panelos-data"'; then
		mkdir -p "$DATA"
		command -v e2fsck >/dev/null && e2fsck -p "$ud" >/dev/null 2>&1
		if mount -t ext4 -o rw,noatime "$ud" "$DATA"; then
			log "mounted $ud at $DATA"
		else
			log "cannot mount $ud at $DATA"
		fi
	fi
	;;
stop)
	sync
	mountpoint -q "$DATA" && umount "$DATA"
	mountpoint -q "$MNT" && umount "$MNT"
	;;
restart | reload)
	;;
esac
exit 0
