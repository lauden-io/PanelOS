// Assistant mode panels (swipeable pages), the clock faces (screensaver
// first, also usable as a panel) and the shared frame.

import { Theme, Act, Clock } from "theme.slint";
import { Icon, GlowText, RollPair, Jelly } from "widgets.slint";
import { PhotoSky } from "photo_sky.slint";
import { NixieClock, LcdClock, TwinBellClock } from "clocks.slint";

export struct Person {
    initials: string,
    home: bool,
    tint: color,
}

export struct TimerInfo {
    label: string,       // "Pasta", "" if unnamed
    text: string,        // "4:59"
    urgent: bool,        // running, in its last minute
    hours: bool,         // an hour or longer: room for "0:00:00" from the start
    tint: color,         // its colour (as on the timers page)
    fr: float,           // the part left (remaining / total)
    paused: bool,
    index: int,          // its place on the timers page
}

// One mark of the status bar's centre group (29.2): a 32 px cell whose width opens 0 → 32 px with a capped jelly
// overshoot (J-edge 90/240, at most 4 px over) and whose icon pops 0.6 → 1 with a wobble; it goes by shrinking and
// fading the icon (120 ms), then closing the width. hold: the cell opens but its icon waits (the timer island flies in).
component MarkCell inherits Rectangle {
    in property <bool> on;
    in property <bool> hold;
    in property <string> glyph;
    in property <color> ink;
    in property <int> badge: 0;           // the bell's count (0: none)
    callback tapped;
    // a pull down that starts on the mark opens the quick shade after 6 px (29.4): its distance, its end
    callback pull(length);
    callback pull-end(length);
    property <bool> pulling;
    property <duration> wt0;
    property <bool> wmove;
    changed on => { root.wt0 = animation-tick(); root.wmove = true; }
    Timer { interval: 820ms; running: root.wmove; triggered => { root.wmove = false; } }
    property <float> wt: root.wmove ? (animation-tick() - root.wt0) / 1ms : 100000;
    property <float> wv: root.on ? 32 * Jelly.edge(root.wt, 90, 240) : 32 * (1 - Jelly.edge(root.wt - 90, 90, 240));
    width: root.on ? max(0px, (32 + Jelly.cap(root.wv - 32, 4)) * 1px) : max(0px, root.wv * 1px);
    height: 32px;
    // the icon
    property <bool> showing: root.on && !root.hold;
    property <duration> it0;
    property <bool> imove;
    changed showing => { root.it0 = animation-tick(); root.imove = true; }
    Timer { interval: 820ms; running: root.imove; triggered => { root.imove = false; } }
    property <float> itt: root.imove ? (animation-tick() - root.it0) / 1ms : 100000;
    property <float> gone: clamp(root.itt / 120, 0, 1);
    property <float> k: root.showing ? (0.6 + 0.4 * Jelly.edge(root.itt - 40, 90, 230)) * Jelly.wobble(root.itt - 40, 0.18) : 1 - 0.4 * root.gone * root.gone;
    property <float> io: root.showing ? clamp((root.itt - 20) / 80, 0, 1) : 1 - root.gone * root.gone;
    // a press squashes the icon a little, the release springs back
    property <float> press: touch.pressed ? 0.9 : 1;
    animate press { duration: touch.pressed ? 90ms : 200ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    if root.io > 0.01: Icon { x: (root.width - 32px) / 2; y: 0; width: 32px; height: 32px; text: root.glyph; font-size: 18px * root.k * root.press;
        color: root.ink; opacity: root.io; }
    // the bell's count: a new one pops the badge 1 → 1.3 → 1 and rolls the number in from below (160 ms)
    property <int> last-badge;
    property <duration> bt0;
    property <bool> bmove;
    init => { root.last-badge = root.badge; }
    changed badge => { if root.badge > root.last-badge { root.bt0 = animation-tick(); root.bmove = true; } root.last-badge = root.badge; }
    Timer { interval: 540ms; running: root.bmove; triggered => { root.bmove = false; } }
    property <float> btt: root.bmove ? (animation-tick() - root.bt0) / 1ms : 100000;
    property <float> bk: root.btt < 160 ? 1 + 0.3 * Math.sin(180deg * root.btt / 160) : Jelly.wobble(root.btt - 160, 0.08);
    property <float> broll: clamp(root.btt / 160, 0, 1);
    if root.badge > 0 && root.io > 0.01: Rectangle {
        property <length> bw: max(15px, bt.preferred-width + 8px);
        x: (root.width - 32px) / 2 + 16px + (self.bw - self.bw * root.bk) / 2; y: 1px + (15px - 15px * root.bk) / 2;
        width: self.bw * root.bk; height: 15px * root.bk; border-radius: self.height / 2;
        background: #FF4A1C; opacity: root.io; clip: true;
        bt := Text { y: 6px * (1 - (1 - Math.pow(1 - root.broll, 3))); width: parent.width; height: parent.height; text: root.badge > 9 ? "9+" : root.badge;
            font-size: 10px * root.bk; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center;
            opacity: root.bmove ? root.broll : 1; }
    }
    touch := TouchArea { x: 0; y: -8px; width: root.width; height: 46px; enabled: root.on;
        clicked => { if !root.pulling { root.tapped(); } }
        moved => {
            if root.pulling || self.mouse-y - self.pressed-y > 6px {
                root.pulling = true;
                root.pull(max(0px, self.mouse-y - self.pressed-y - 6px));
            }
        }
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.pulling = false; }
            if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) && root.pulling {
                root.pull-end(max(0px, self.mouse-y - self.pressed-y - 6px));
            }
        }
    }
}

// Thin status line at the top of a panel (29.1): the hint from x 16 up to the mark group (at least to x 168), the mark group centred on x 240, the page's
// own chip at x 312–464 (drawn by the page). On the screensaver the hint and the bell rest.
export component StatusBar inherits Rectangle {
    callback pull(length);               // a pull down started on a mark (the shade follows it)
    callback pull-end(length);
    in property <string> hint;           // wake word hint, or the muted microphone's line (the app picks it)
    in property <bool> mic-muted;
    in property <bool> speaker-muted;    // the panel's volume at 0
    in property <bool> dnd;              // do not disturb is on: the bell sleeps
    in property <bool> listening;        // the assistant is hearing now (the voice screen covers the bar)
    in property <int> notes;             // notifications waiting (the bell with the number; a tap opens their list)
    in property <[TimerInfo]> timers;    // nearest first
    in property <bool> timer-mark;       // the timer island is away (or flying there): the timer mark shows
    in property <bool> timer-hold;       // … its icon waits for the flying capsule
    in property <bool> problem;          // connection problem: the hint line says it
    in property <bool> quiet;            // screensaver
    in property <bool> on-color;         // drawn over a plain page background (the theme's colours)
    in property <float> on-k: root.on-color ? 1 : 0;   // the same, mixed while a swipe crosses pages
    in property <bool> left-chips;       // (the page has its own chip at the right: every part has its fixed place anyway)
    in property <float> left-k;
    property <color> soft: (#ffffffb3).mix(Theme.faint, root.on-k);
    property <color> warn: (#f5a524).mix(Theme.warning, root.on-k);
    property <color> alert: (#ff5a5f).mix(Theme.danger, root.on-k);
    height: 32px;
    // the hint: the connection problem first, then the muted microphone's line, then the wake hint.
    // An empty mark group takes no room: the hint runs up to the page's chip (8 px before x 312; the whole line
    // where the page has no chip, mixed by the swipe). With marks it ends 4 px before the group and is cut there.
    property <length> hint-end: root.width - root.left-k * (root.width - 288px);
    Text {
        x: 0; y: 0; height: root.height;
        width: grp.preferred-width > 0.5px ? min(root.hint-end, grp.x - 4px) : root.hint-end;
        text: root.problem ? "No connection to Home Assistant" : root.quiet && !root.mic-muted ? "" : root.hint;
        font-size: Theme.font-caption;
        color: root.problem ? root.warn : root.mic-muted ? root.alert : root.soft;
        vertical-alignment: center;
        overflow: elide;
    }
    // the mark group: microphone off · speaker off · timers · bell, always centred
    property <TimerInfo> near: root.timers.length > 0 ? root.timers[0] : { tint: #ffffff };
    grp := HorizontalLayout {
        x: (root.width - self.preferred-width) / 2; y: 0; width: self.preferred-width; height: root.height;
        spacing: 0;
        MarkCell { on: root.mic-muted; glyph: "\u{F036D}"; ink: root.alert; tapped => { Act.act("mark.mic", ""); } pull(d) => { root.pull(d); } pull-end(d) => { root.pull-end(d); } }
        MarkCell { on: root.speaker-muted; glyph: "\u{F075F}"; ink: root.warn; tapped => { Act.act("mark.speaker", ""); } pull(d) => { root.pull(d); } pull-end(d) => { root.pull-end(d); } }
        MarkCell { on: root.timer-mark && root.timers.length > 0; hold: root.timer-hold; glyph: "\u{F13AB}";
            ink: root.near.urgent ? root.alert : root.near.tint; tapped => { Act.act("mark.timers", ""); } pull(d) => { root.pull(d); } pull-end(d) => { root.pull-end(d); } }
        MarkCell { on: (root.notes > 0 || root.dnd) && !root.quiet; glyph: root.dnd ? "\u{F00A0}" : "\u{F009A}"; ink: root.soft; badge: root.notes;
            tapped => { Act.act("notes.open", ""); } pull(d) => { root.pull(d); } pull-end(d) => { root.pull-end(d); } }
    }
}

// The timer island's ring (18 px, 2.5 px stroke).
component IslandRing inherits Rectangle {
    in property <float> fr;
    in property <color> arc;
    in property <color> track;
    in property <bool> paused;
    in property <color> bars;
    width: 18px; height: 18px;
    property <float> r: 7.75;
    property <angle> a: min(0.9999, max(0, root.fr)) * 360deg;
    Rectangle { border-radius: 9px; border-width: 2.5px; border-color: root.track; }
    if root.fr > 0.001: Path {
        x: -1.25px; y: -1.25px; width: 20.5px; height: 20.5px; viewbox-width: 18; viewbox-height: 18;
        stroke: root.arc; stroke-width: 2.5px;
        commands: "M 9 " + (9 - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.a > 180deg ? "1" : "0") + " 1 "
            + (9 + root.r * Math.sin(root.a)) + " " + (9 - root.r * Math.cos(root.a));
    }
    if root.paused: Rectangle { x: 6px; y: 5px; width: 2px; height: 8px; background: root.bars; }
    if root.paused: Rectangle { x: 10px; y: 5px; width: 2px; height: 8px; background: root.bars; }
}

// The timer island (29.3): one capsule under the status bar (y 46–74, centred) with the two nearest timers (a ring in
// the timer's colour, the name, the time) and "+N". A flick up flies it into the timer mark (closed-form jelly edges,
// ~600 ms); it comes back the same way when the app clears `away` (a new timer, a last minute). The element covers the
// screen, only the capsule takes touches.
export component TimerIsland inherits Rectangle {
    in property <[TimerInfo]> timers;
    in property <bool> light;            // a plain light page: the white capsule
    in property <bool> hidden;           // under the shade, the voice screen, on the timers page
    in property <length> mark-x: 240px;  // where the timer mark will sit (its centre)
    in-out property <bool> away;
    out property <bool> mark-on: root.timers.length > 0 && (root.away || root.flying == 1);
    out property <bool> mark-hold: root.flying == 1 && root.ft < 420;
    out property <length> cap-w: root.rest-w;
    out property <bool> shown: root.timers.length > 0 && !root.hidden && (!root.away || root.flying != 0);
    property <color> ink: root.light ? #101114 : #F5F3EE;
    property <color> lab: root.light ? #5F5E5A : #B4B2AC;
    property <color> alert: root.light ? #d0222a : #ff5a5f;
    property <color> track: root.light ? #10111424 : #F5F3EE2e;
    // the flight: 0 none, 1 out (to the mark), 2 back
    property <int> flying;
    property <duration> ft0;
    property <float> ft: root.flying != 0 ? (animation-tick() - root.ft0) / 1ms : 0;
    Timer { interval: 620ms; running: root.flying != 0; triggered => { if root.flying == 1 { root.away = true; } root.flying = 0; } }
    changed away => { if !root.away && root.flying == 0 && root.timers.length > 0 { root.ft0 = animation-tick(); root.flying = 2; } }
    // the resting capsule
    property <length> rest-w: root.w0 + (root.timers.length > 1 ? 1px + root.w1 : 0px) + (root.more > 0 ? 1px + 34px : 0px);
    property <length> rest-x: (root.width - root.rest-w) / 2;
    in property <length> rest-y: 46px;   // the capsule's top (lower while a status strip runs under the status bar)
    // the drag: up 1:1 with a little stretch, down at most 6 px; release up > 14 px or faster than 0.4 px/ms flies
    property <length> dy;
    property <bool> dragging;
    property <length> last-y;
    property <duration> last-t;
    property <float> vel;                // px/ms, negative = up
    property <length> rel-dy;
    property <duration> back-t0;
    property <bool> backing;
    Timer { interval: 520ms; running: root.backing; triggered => { root.backing = false; } }
    property <length> pose-dy: root.dragging ? root.dy : root.backing ? root.rel-dy * (1 - Jelly.edge((animation-tick() - root.back-t0) / 1ms, 70, 220)) : 0px;
    property <float> up: max(0, -root.pose-dy / 1px);
    property <float> down: max(0, root.pose-dy / 1px);
    property <float> sy: 1 + Jelly.cap(root.up * 0.16 / 50, 0.16);
    property <length> pose-y: (Jelly.cap(root.down / 5, 6) - root.up) * 1px;
    function press(y: length) { root.dragging = true; root.dy = 0; root.last-y = y; root.last-t = animation-tick(); root.vel = 0; root.backing = false; }
    function move(y: length, y0: length) {
        root.dy = y - y0;
        if animation-tick() > root.last-t {
            root.vel = 0.5 * root.vel + 0.5 * (y - root.last-y) / 1px / ((animation-tick() - root.last-t) / 1ms);
        }
        root.last-y = y; root.last-t = animation-tick();
    }
    function release(tap: int) {
        root.dragging = false;
        if root.dy < -14px || root.vel < -0.4 {
            root.ft0 = animation-tick(); root.flying = 1;
        } else {
            if Math.abs(root.dy / 1px) < 6 && tap >= -1 { if tap >= 0 { Act.act("island.timer", tap); } else { Act.act("mark.timers", ""); } }
            root.rel-dy = root.dy; root.back-t0 = animation-tick(); root.backing = true;
        }
        root.dy = 0;
    }
    // the edges of the flight (closed form)
    property <float> ea: Jelly.edge(root.ft, 90, 240);
    property <float> eb: Jelly.edge(root.ft - 30, 130, 340);
    property <float> ec: Jelly.edge(root.flying == 2 ? root.ft - 20 : root.ft, 48, 300);
    property <length> tl: root.mark-x - 9px;
    property <length> tr: root.mark-x + 9px;
    property <length> tt: 17px;
    property <length> tb: 35px;
    property <length> sl: root.rest-x;
    property <length> sr: root.rest-x + root.rest-w;
    property <length> st: root.rest-y;
    property <length> sb: root.rest-y + 28px;
    pure function lerp(a: length, b: length, k: float) -> length { a + (b - a) * k }
    pure function soft(x: length, c: float) -> length { Jelly.cap(x / 1px, c) * 1px }
    // out: the top races to the mark, the bottom follows 30 ms later, the sides squeeze in (never crossing)
    property <length> o-top: root.tt - root.soft(root.tt - root.lerp(root.st, root.tt, root.ea), 4);
    property <length> o-bot: root.tb - root.soft(root.tb - root.lerp(root.sb, root.tb, root.eb), 5);
    property <length> o-l: root.tl + root.soft(root.lerp(root.sl, root.tl, root.ec) - root.tl, 3);
    property <length> o-r: root.tr - root.soft(root.tr - root.lerp(root.sr, root.tr, root.ec), 3);
    // back: the bottom leads down, the top follows, the sides open
    property <length> b-bot: root.sb + root.soft(root.lerp(root.tb, root.sb, root.ea) - root.sb, 5);
    property <length> b-top: root.st + root.soft(root.lerp(root.tt, root.st, root.eb) - root.st, 4);
    property <length> b-l: root.sl - root.soft(root.sl - root.lerp(root.tl, root.sl, root.ec), 3);
    property <length> b-r: root.sr + root.soft(root.lerp(root.tr, root.sr, root.ec) - root.sr, 3);
    property <length> cx: root.flying == 1 ? root.o-l : root.flying == 2 ? root.b-l : root.rest-x + (root.rest-w - root.rest-w / root.sy) / 2;
    property <length> cy: root.flying == 1 ? root.o-top : root.flying == 2 ? root.b-top : root.rest-y + root.pose-y + (28px - 28px * root.sy) / 2;
    property <length> cw: root.flying == 1 ? max(12px, root.o-r - root.o-l) : root.flying == 2 ? max(12px, root.b-r - root.b-l) : root.rest-w / root.sy;
    property <length> ch: root.flying == 1 ? max(12px, root.o-bot - root.o-top) : root.flying == 2 ? max(12px, root.b-bot - root.b-top) : 28px * root.sy;
    property <float> body-o: root.flying == 1 ? 1 - clamp(root.ft / 120, 0, 1) : root.flying == 2 ? clamp((root.ft - 300) / 160, 0, 1) : 1;
    property <float> cap-o: root.flying == 1 ? 1 - clamp((root.ft - 420) / 100, 0, 1) : 1;
    property <TimerInfo> t0: root.timers.length > 0 ? root.timers[0] : { tint: #ffffff };
    property <TimerInfo> t1: root.timers.length > 1 ? root.timers[1] : { tint: #ffffff };
    property <int> more: max(0, root.timers.length - 2);
    probe-m := Text { visible: false; text: "00:00"; font-size: 15px; font-weight: 600; }
    probe-h := Text { visible: false; text: "0:00:00"; font-size: 15px; font-weight: 600; }
    if root.shown: Rectangle {
        x: root.cx; y: root.cy; width: root.cw; height: root.ch; border-radius: min(self.width, self.height) / 2;
        background: root.light ? #FFFFFFf5 : #121314e8;
        border-width: 1px; border-color: root.light ? #10111417 : #ffffff1f;
        drop-shadow-offset-y: 2px; drop-shadow-blur: 7px; drop-shadow-color: root.light ? #00000014 : #00000059;
        opacity: root.cap-o;
        clip: root.flying != 0;
        // the content keeps its resting size and stays centred in the capsule
        body := HorizontalLayout {
            x: (parent.width - root.rest-w) / 2; y: (parent.height - 28px) / 2; width: root.rest-w; height: 28px;
            opacity: root.body-o;
            spacing: 0;
            for seg[i] in [root.t0, root.t1]: HorizontalLayout {
                visible: i < root.timers.length;
                width: i < root.timers.length ? self.preferred-width : 0px;
                spacing: 0;
                if i > 0: VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: root.track; } }
                HorizontalLayout {
                    padding-left: 9px; padding-right: 11px; spacing: 6px; alignment: start;
                    VerticalLayout { alignment: center;
                        IslandRing { fr: seg.fr; paused: seg.paused; bars: root.lab; track: root.track;
                            arc: seg.urgent ? root.alert : seg.paused ? seg.tint.with-alpha(0.5) : seg.tint; } }
                    if seg.label != "": Text { text: seg.label; max-width: 92px; font-size: 13px; font-weight: 500; color: root.lab; vertical-alignment: center; overflow: elide; }
                    Text { text: seg.text; min-width: seg.hours ? probe-h.preferred-width : probe-m.preferred-width; font-size: 15px; font-weight: 600;
                        color: seg.urgent ? root.alert : seg.paused ? root.lab : root.ink; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            if root.more > 0: VerticalLayout { alignment: center; Rectangle { width: 1px; height: 14px; background: root.track; } }
            if root.more > 0: Text { text: "+" + root.more; min-width: 34px; font-size: 13px; font-weight: 600; color: root.lab;
                horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // touches (a static area over the resting capsule, so the drag is measured against the screen): a tap on a timer
    // opens its sheet, on "+N" the timers page; a drag flicks
    lp0 := Text { visible: false; text: root.t0.label; font-size: 13px; font-weight: 500; }
    lp1 := Text { visible: false; text: root.t1.label; font-size: 13px; font-weight: 500; }
    tp0 := Text { visible: false; text: root.t0.text; font-size: 15px; font-weight: 600; }
    tp1 := Text { visible: false; text: root.t1.text; font-size: 15px; font-weight: 600; }
    property <length> w0: 44px + (root.t0.label != "" ? min(92px, lp0.preferred-width) + 6px : 0px)
        + max(tp0.preferred-width, root.t0.hours ? probe-h.preferred-width : probe-m.preferred-width);
    property <length> w1: 44px + (root.t1.label != "" ? min(92px, lp1.preferred-width) + 6px : 0px)
        + max(tp1.preferred-width, root.t1.hours ? probe-h.preferred-width : probe-m.preferred-width);
    if root.shown && root.flying == 0: TouchArea {
        x: root.rest-x; y: root.rest-y - 6px; width: root.rest-w; height: 40px;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.press(self.mouse-y); }
            if ev.kind == PointerEventKind.up {
                root.release(self.mouse-x < root.w0 || root.timers.length == 1 ? root.t0.index
                    : self.mouse-x < root.w0 + 1px + root.w1 || root.timers.length == 2 ? root.t1.index : -1);
            }
            if ev.kind == PointerEventKind.cancel { root.release(-2); }
        }
        moved => { root.move(self.mouse-y, self.pressed-y); }
    }
}

// Page dots; they fade out a few seconds after the last swipe. During a swipe the pill and the dot it goes to
// stick together with a liquid neck (a Path, thinner in the middle as the swipe goes on); past 0.82 of the way
// the neck tears and the two wobble like pulled-apart jelly (width and height about the centre, the area kept,
// ~0.5 s); a swipe that goes back pulls the neck into the pill, which wobbles a little. Across the ends of the
// endless row a bud grows towards the outer edge instead and tears off.
export component PageDots inherits Rectangle {
    in property <int> count;
    in property <int> current;
    in property <int> next: -1;          // the page the swipe goes towards, and how far it is (0..1)
    in property <float> frac;
    in property <int> start: 0;          // the page the swipe started from (the settled page)
    in property <float> shown: 1;
    in property <bool> on-color;
    in property <float> on-k: root.on-color ? 1 : 0;
    opacity: root.shown;
    property <color> on-c: (#ffffff).mix(Theme.accent, root.on-k);
    property <color> off-c: (#ffffff80).mix(Theme.faint.with-alpha(0.6), root.on-k);
    // the row: dots 6 px apart, the pill 12 px wider than a dot
    property <length> row-w: root.count * 6px + 12px + (root.count - 1) * 6px;
    property <length> x0: (root.width - root.row-w) / 2;
    pure function w-of(i: int) -> float {
        return (i == root.current ? 1 - root.frac : 0) + (i == root.next ? root.frac : 0);
    }
    pure function left-of(i: int) -> length {
        // dots before i, plus the extra width of the pill parts before it
        return root.x0 + i * 12px + 12px * ((root.current < i ? 1 - root.frac : 0) + (root.next < i && root.next >= 0 ? root.frac : 0));
    }
    // how far the swipe has gone from where it started (0..1); the ends of the row are a wrap
    property <bool> moving: root.frac > 0.01 && root.frac < 0.99 && root.next >= 0;
    property <bool> wrap: root.moving && ((root.current == 0 && root.next == root.count - 1) || (root.current == root.count - 1 && root.next == 0));
    property <float> prog: !root.moving ? 0 : root.start == root.current ? root.frac : root.start == root.next ? 1 - root.frac : 0;
    property <int> from: root.start == root.next ? root.next : root.current;
    property <int> to: root.start == root.next ? root.current : root.next;
    // torn: the neck broke in this gesture (it re-forms only below 0.65)
    property <bool> torn;
    property <float> peak;               // the furthest point of this gesture (a snap back without a tear wobbles)
    // the wobble: which dot, when, how strong (0.16 the new pill, the old dot 0.10 the other way; 0.08 a snap back)
    property <int> wob-a: -1;
    property <int> wob-b: -1;
    property <float> wob-amp;
    property <duration> wob-t0;
    property <bool> wobbling;
    property <duration> tear-t0;
    changed prog => {
        if root.moving && !root.torn && root.prog > 0.82 {
            root.torn = true;
            root.tear-t0 = animation-tick();
            root.wob-a = root.to;
            root.wob-b = root.from;
            root.wob-amp = 0.16;
            root.wob-t0 = animation-tick();
            root.wobbling = true;
        } else if root.torn && root.moving && root.prog < 0.65 {
            root.torn = false;
        }
        if root.moving {
            root.peak = Math.max(root.peak, root.prog);
        }
    }
    changed moving => {
        if !root.moving {
            // the gesture ended: back where it began without a tear → the pill wobbles a little
            if !root.torn && root.peak > 0.15 && root.current == root.start {
                root.wob-a = root.start;
                root.wob-b = -1;
                root.wob-amp = 0.08;
                root.wob-t0 = animation-tick();
                root.wobbling = true;
            }
            root.torn = false;
            root.peak = 0;
        }
    }
    Timer { interval: 520ms; running: root.wobbling; triggered => { root.wobbling = false; } }
    property <float> wt: root.wobbling ? (animation-tick() - root.wob-t0) / 1ms : 1000;
    pure function sx-of(i: int) -> float {
        return !root.wobbling || root.wt > 500 ? 1
            : i == root.wob-a ? 1 + root.wob-amp * Math.pow(2.71828, -root.wt / 120) * Math.cos(360deg * root.wt / 180)
            : i == root.wob-b ? 1 - 0.10 * Math.pow(2.71828, -root.wt / 120) * Math.cos(360deg * root.wt / 180)
            : 1;
    }
    // the neck: from the pill's edge to the target dot's edge, its middle h(prog) = 6 · (1 − 0.75 · prog) high;
    // it grows out of the pill over the first 15 % of the way (and goes back into it the same way)
    property <bool> neck: root.moving && !root.wrap && !root.torn && root.to >= 0;
    property <length> from-l: root.left-of(root.from);
    property <length> from-r: root.from-l + (6px + 12px * root.w-of(root.from));
    property <length> to-l: root.left-of(root.to);
    property <length> to-r: root.to-l + (6px + 12px * root.w-of(root.to));
    property <bool> rightward: root.to > root.from;
    property <length> n1: root.rightward ? root.from-r - 2px : root.from-l + 2px;
    property <length> n2-full: root.rightward ? root.to-l + 2px : root.to-r - 2px;
    property <length> n2: root.n1 + (root.n2-full - root.n1) * Math.min(1, root.prog / 0.15);
    property <float> nh: 6 * (1 - 0.75 * root.prog);
    if root.neck: Path {
        x: 0; y: 0; width: root.width; height: 6px;
        viewbox-width: root.width / 1px; viewbox-height: 6;
        fill: root.on-c;
        MoveTo { x: root.n1 / 1px; y: 0; }
        QuadraticTo { control-x: (root.n1 + root.n2) / 2px; control-y: 6 - root.nh; x: root.n2 / 1px; y: 0; }
        LineTo { x: root.n2 / 1px; y: 6; }
        QuadraticTo { control-x: (root.n1 + root.n2) / 2px; control-y: root.nh; x: root.n1 / 1px; y: 6; }
        Close { }
    }
    // the bud across the ends: grows from the pill towards the outer edge, tears off at 0.82 and fades in 90 ms
    property <bool> bud: root.wrap && root.from >= 0;
    property <float> bud-k: root.torn ? Math.max(0, 1 - (animation-tick() - root.tear-t0) / 90ms) : 1;
    if root.bud && root.bud-k > 0.01: Rectangle {
        property <length> len: 10px * Math.min(1, root.prog / 0.6);
        property <bool> outward-right: root.from == root.count - 1;
        x: self.outward-right ? root.from-r - 2px : root.from-l + 2px - self.len;
        y: 1px; width: self.len; height: 4px; border-radius: 2px;
        background: root.on-c; opacity: root.bud-k;
    }
    for i in root.count: Rectangle {
        property <float> w: root.w-of(i);
        property <float> sx: root.sx-of(i);
        // across the ends the far dot grows in from 0.6 of its size with the wobble
        property <float> grow: root.wrap && root.torn && i == root.to ? 0.6 + 0.4 * Math.min(1, root.wt / 200) : 1;
        property <length> bw: (6px + 12px * self.w) * self.sx * self.grow;
        property <length> bh: 6px / self.sx * self.grow;
        x: root.left-of(i) + (6px + 12px * self.w - self.bw) / 2;
        y: (6px - self.bh) / 2;
        width: self.bw;
        height: self.bh;
        border-radius: Math.min(self.bw, self.bh) / 2;
        // the old end keeps the active colour while stuck, and fades only after the tear
        background: root.neck && i == root.from ? root.on-c : root.on-c.mix(root.off-c, self.w);
    }
}

// Who is home: small round heads (initials), away ones faded.
export component People inherits HorizontalLayout {
    in property <[Person]> people;
    spacing: 2px;
    for p in root.people: Rectangle {
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: p.home ? p.tint : Theme.surface-raised;
        Text {
            text: p.initials;
            font-size: 11px;
            font-weight: Theme.weight-strong;
            color: p.home ? #ffffff : Theme.faint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export struct ClockData {
    hh: string,          // "07" (24-hour: the hands, the dials, everything that computes with the hour)
    mm: string,          // "42"
    th: string,          // the hour a digital clock shows, in the panel's time format: "07" / "18", or "7" / "6"
    ampm: string,        // "" in 24-hour mode, else "AM" / "PM" (shown beside the digits)
    seconds: float,      // 0..60 (smooth)
    date: string,        // "Sunday, 8 November"
    weekday: string,     // "SUN"
    day: string,         // "8"
    weather-icon: string,
    temperature: string, // "12°"
    condition: string,
    high-low: string,    // "H 15° · L 7°"
    next: string,        // next event, "" if none
    lcd-day: string,     // "WE" (the LCD clock)
    lcd-date: string,    // "11-18" (month-day, the LCD clock)
    // Split-flap clock: current and previous digits (the shown hour: d1 "" for a blank card), flip progress 0..1.
    d1: string, d2: string, d3: string, d4: string,
    o1: string, o2: string, o3: string, o4: string,
    flip: float,
}

// Analog dial. shape 0 round, 1 square (fills the panel); numerals: 12/3/6/9
// in big figures; minimal: no face, four marks. Inside the square faces:
// a date window at 3 o'clock (or under the 12 with numerals) and, below the
// centre, weather and the next event; whatever is switched off leaves no gap.
export component AnalogDial inherits Rectangle {
    in property <float> h;     // hours 0..12 (fractional)
    in property <float> m;     // minutes 0..60 (fractional)
    in property <float> s;     // seconds 0..60
    in property <length> size: 280px;
    in property <int> shape: 0;
    in property <bool> numerals: false;
    in property <bool> minimal: false;
    in property <bool> show-seconds: true;
    in property <string> weekday;      // "" = no date inside
    in property <string> day;
    in property <string> weather;      // "" = no weather inside
    in property <string> weather-icon;
    in property <string> next;         // "" = no event inside
    in property <color> accent: Theme.accent;
    in property <int> weight: 600;
    // colours (defaults: the panel theme; the home page draws white on the weather picture)
    in property <brush> face: Theme.surface;
    in property <color> ink: Theme.text;
    in property <color> mark: Theme.muted;
    in property <color> fine: Theme.faint;
    in property <brush> window-bg: Theme.background;
    width: self.size;
    height: self.size;
    property <bool> date-window: root.weekday != "" && !root.numerals;
    // the hour that has begun (C3 glow at the full hour, C6 the accent numeral)
    property <int> hour-now: Math.mod(Math.floor(root.h + 0.0001), 12);
    property <bool> hour-new;
    property <duration> hour-t0;
    property <int> hour-old;
    property <int> hour-last;
    init => { root.hour-last = root.hour-now; root.hour-old = root.hour-now; }
    changed hour-now => { root.hour-old = root.hour-last; root.hour-last = root.hour-now; root.hour-t0 = animation-tick(); root.hour-new = true; }
    Timer { interval: 620ms; running: root.hour-new; triggered => { root.hour-new = false; } }
    property <float> hour-t: root.hour-new ? (animation-tick() - root.hour-t0) / 1ms : 1000;
    // C6: the numeral of the quarter the hour hand is in (12, 3, 6, 9)
    property <int> q-now: Math.floor(root.hour-now / 3);
    property <int> q-old: Math.floor(root.hour-old / 3);
    property <float> q-k: clamp(root.hour-t / 400, 0, 1);
    // Distance from the centre to the edge of the face in direction a (deg), viewbox units.
    function edge(a: float) -> float {
        root.shape == 0 ? 44 : 44 / max(abs(Math.sin(a * 1deg)), abs(Math.cos(a * 1deg)))
    }
    function seg(a: float, r0: float, r1: float) -> string {
        "M " + (50 + r0 * Math.sin(a * 1deg)) + " " + (50 - r0 * Math.cos(a * 1deg))
            + " L " + (50 + r1 * Math.sin(a * 1deg)) + " " + (50 - r1 * Math.cos(a * 1deg))
    }
    if !root.minimal: Rectangle {
        border-radius: root.shape == 0 ? root.size / 2 : root.size * 0.08;
        background: root.face;
    }
    for i in (root.minimal ? 0 : 60): Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        visible: Math.mod(i, 5) != 0;
        stroke: root.fine;
        stroke-width: 1px;
        commands: root.seg(i * 6, root.edge(i * 6) - 1, root.edge(i * 6) - 3);
    }
    for i in 12: Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        visible: !(root.numerals && Math.mod(i, 3) == 0) && !(root.date-window && i == 3)
            && !(root.minimal && Math.mod(i, 3) != 0);
        stroke: i == 0 ? root.accent : root.mark;
        stroke-width: root.minimal ? 4px : (Math.mod(i, 3) == 0 ? 3px : 2px);
        commands: root.minimal ? root.seg(i * 30, 42, 37)
            : root.seg(i * 30, root.edge(i * 30) - 1, root.edge(i * 30) - 7);
    }
    // C3: at the full hour the 12 index glows once in the accent (600 ms)
    if root.shape == 0 && !root.minimal && !root.numerals && root.hour-t < 600: Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        stroke: root.accent; stroke-width: 9px; stroke-line-cap: round; opacity: 0.45 * Math.sin(180deg * root.hour-t / 600);
        commands: root.seg(0, root.edge(0) - 1, root.edge(0) - 7);
    }
    for i in (root.numerals ? 4 : 0): Text {
        property <float> a: i * 90;
        property <float> r: root.edge(self.a) - 10;
        x: (50 + self.r * Math.sin(self.a * 1deg)) / 100 * root.size - self.width / 2;
        y: (50 - self.r * Math.cos(self.a * 1deg)) / 100 * root.size - self.height / 2;
        text: i == 0 ? "12" : i == 1 ? "3" : i == 2 ? "6" : "9";
        font-size: root.size * 0.11;
        font-weight: root.weight;
        // C6: the current quarter's numeral in the accent, crossfading to the next at the hour (400 ms)
        color: i == root.q-now ? (root.q-old != root.q-now ? root.accent.mix(root.ink, root.q-k) : root.accent)
            : i == root.q-old && root.q-k < 1 ? root.ink.mix(root.accent, root.q-k) : root.ink;
    }
    // Date: window at 3 o'clock, or a small label under the 12 with numerals.
    if root.date-window: Rectangle {
        x: root.size * 0.70;
        y: root.size * 0.5 - 14px;
        width: dw.preferred-width + 14px;
        height: 28px;
        border-radius: 6px;
        background: root.window-bg;
        dw := HorizontalLayout {
            padding-left: 7px;
            spacing: 4px;
            alignment: start;
            Text { text: root.weekday; font-size: 13px; color: root.mark; vertical-alignment: center; }
            // C4: at midnight the number rolls to the new one (400 ms)
            RollPair { text: root.day; font-size: 13px; font-weight: Theme.weight-strong; color: root.accent; dur: 400ms; }
        }
    }
    if root.numerals && root.weekday != "": HorizontalLayout {
        y: root.size * 0.25;
        width: root.size;
        height: 20px;
        alignment: center;
        spacing: 4px;
        Text { text: root.weekday; font-size: 14px; color: root.mark; }
        Text { text: root.day; font-size: 14px; font-weight: Theme.weight-strong; color: root.accent; }
    }
    // Below the centre: weather, then the next event (no gap if one is off).
    VerticalLayout {
        y: root.size * 0.64;
        width: root.size;
        height: root.size * 0.18;
        alignment: start;
        spacing: 4px;
        if root.weather != "": HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Icon { text: root.weather-icon; font-size: 20px; color: root.mark; }
            Text { text: root.weather; font-size: 16px; color: root.mark; vertical-alignment: center; }
        }
        if root.next != "": HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Icon { text: "\u{F00ED}"; font-size: 16px; color: root.accent; }
            Text { text: root.next; font-size: 14px; color: root.mark; vertical-alignment: center; }
        }
    }
    // Hands
    Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        stroke: root.ink;
        stroke-width: root.size * 0.022;
        commands: root.seg(root.h * 30, -4, 24);
    }
    Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        stroke: root.ink;
        stroke-width: root.size * 0.014;
        commands: root.seg(root.m * 6, -5, root.shape == 0 ? 36 : 38);
    }
    // C5: the minimal face's second hand leaves a short trail (3 ghost hands at 30 / 15 / 7 %, 1.5 degrees apart)
    for g[i] in (root.minimal && root.show-seconds ? [0.30, 0.15, 0.07] : []): Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        stroke: root.accent; stroke-width: 2px; opacity: g;
        commands: root.seg(root.s * 6 - (i + 1) * 1.5, -8, root.shape == 0 ? 40 : 42);
    }
    if root.show-seconds: Path {
        width: root.size; height: root.size; viewbox-width: 100; viewbox-height: 100;
        stroke: root.accent;
        stroke-width: 2px;
        commands: root.seg(root.s * 6, -8, root.shape == 0 ? 40 : 42);
    }
    Rectangle {
        width: 12px; height: 12px; border-radius: 6px;
        background: root.show-seconds ? root.accent : root.ink;
    }
}

// 25.C1: a line whose new text rises in from below while the old one slides up and out (300 ms); with fade, the two
// only crossfade. Clipped only while it changes.
component SwapText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <color> ink: Theme.text;
    in property <bool> fade;
    property <string> now-t;
    property <string> old-t;
    init => { root.now-t = root.text; }
    property <bool> moving;
    property <duration> t0;
    changed text => { root.old-t = root.now-t; root.now-t = root.text; root.t0 = animation-tick(); root.moving = root.old-t != "" && root.old-t != root.now-t; }
    Timer { interval: 320ms; running: root.moving; triggered => { root.moving = false; } }
    property <float> e: root.moving ? 1 - Math.pow(1 - clamp((animation-tick() - root.t0) / 300ms, 0, 1), 3) : 1;
    preferred-width: max(tn.preferred-width, root.moving ? to.preferred-width : 0px); preferred-height: tn.preferred-height;
    min-height: tn.preferred-height;
    clip: root.moving;
    to := Text { x: 0; y: root.fade ? 0px : -root.e * root.height; width: root.width; height: root.height; text: root.old-t; font-size: root.font-size; font-weight: root.font-weight;
        color: root.ink; vertical-alignment: center; opacity: root.moving ? 1 - root.e : 0; }
    tn := Text { x: 0; y: root.fade ? 0px : (1 - root.e) * root.height; width: root.width; height: root.height; text: root.now-t; font-size: root.font-size; font-weight: root.font-weight;
        color: root.ink; vertical-alignment: center; opacity: root.moving ? root.e : 1; }
}

// Date and weather on one line; the separator only when both show, so the
// one left alone is centred.
component InfoLine inherits HorizontalLayout {
    in property <ClockData> data;
    in property <bool> show-date;
    in property <bool> show-weather;
    in property <bool> condition;        // add the condition text after the temperature
    in property <length> size: 18px;
    in property <color> color: Theme.muted;
    alignment: center;
    spacing: 10px;
    if root.show-date: Text { text: root.data.date; font-size: root.size; color: root.color; vertical-alignment: center; }
    if root.show-date && root.show-weather: Text { text: "·"; font-size: root.size; color: Theme.faint; vertical-alignment: center; }
    if root.show-weather: Icon { text: root.data.weather-icon; font-size: root.size * 1.2; color: root.color; }
    if root.show-weather: Text {
        text: root.data.temperature + (root.condition ? "  " + root.data.condition : "");
        font-size: root.size; color: root.color; vertical-alignment: center;
    }
}

// The AM / PM mark of a digital clock in 12-hour mode: small letters after the minutes, on the digits' baseline (Noto
// Sans: the baseline lies 1.07 em down a 1.36 em line, the line centred in the row). No room taken in 24-hour mode.
export component AmPm inherits Rectangle {
    in property <string> text;            // "" (24-hour), "AM", "PM"
    in property <length> size;            // the digits' font size
    in property <int> font-weight: 600;
    in property <brush> ink: Theme.text;
    // the digits' rim and glow (GlowText)
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <bool> paper;
    property <length> fs: root.size * 0.24;
    property <length> gap: root.size * 0.1;
    preferred-width: root.text == "" ? 0px : g.preferred-width + root.gap;
    min-width: self.preferred-width;
    g := GlowText {
        visible: root.text != "";
        x: root.gap; y: (root.height - 1.36 * root.size) / 2 + 1.07 * (root.size - root.fs); height: 1.36 * root.fs;
        text: root.text; font-size: root.fs; font-weight: root.font-weight; color: root.ink;
        k: root.k; neon: root.neon; glow: root.glow; paper: root.paper;
    }
}

component NextLine inherits HorizontalLayout {
    in property <ClockData> data;
    in property <color> accent;
    in property <length> size: 15px;
    alignment: center;
    spacing: 8px;
    Icon { text: "\u{F00ED}"; font-size: root.size * 1.15; color: root.accent; }
    Text { text: root.data.next; font-size: root.size; color: Theme.muted; vertical-alignment: center; }
}

// One split-flap card, drawn from digit images so a flap can be foreshortened
// like a rigid plate (the software renderer scales images, not text). When
// the digit changes, the old top half rotates down to the hinge (getting
// shorter and darker), then the new bottom half falls open below it.
export component FlapCard inherits Rectangle {
    // The card flips by itself when its digit changes: the old top half folds to the hinge, then the new
    // bottom half falls open (2 x dur/2). It is drawn frame by frame only while it flips.
    in property <string> new-digit;
    in property <duration> delay: 0ms;   // later cards of a clock start a little after the minute units
    in property <duration> dur: 560ms;
    in property <int> weight: 600;
    in property <color> card: #1d1d21;
    in property <color> ink: #f4f4f5;
    in property <bool> search;           // 25.T5: a rise runs down through the numbers in between, 60 ms a flap
    // Digit images (white on transparent, 188 x 300), per weight.
    property <[image]> w300: [@image-url("digits/300/0.png"), @image-url("digits/300/1.png"), @image-url("digits/300/2.png"), @image-url("digits/300/3.png"), @image-url("digits/300/4.png"), @image-url("digits/300/5.png"), @image-url("digits/300/6.png"), @image-url("digits/300/7.png"), @image-url("digits/300/8.png"), @image-url("digits/300/9.png")];
    property <[image]> w600: [@image-url("digits/600/0.png"), @image-url("digits/600/1.png"), @image-url("digits/600/2.png"), @image-url("digits/600/3.png"), @image-url("digits/600/4.png"), @image-url("digits/600/5.png"), @image-url("digits/600/6.png"), @image-url("digits/600/7.png"), @image-url("digits/600/8.png"), @image-url("digits/600/9.png")];
    property <[image]> w700: [@image-url("digits/700/0.png"), @image-url("digits/700/1.png"), @image-url("digits/700/2.png"), @image-url("digits/700/3.png"), @image-url("digits/700/4.png"), @image-url("digits/700/5.png"), @image-url("digits/700/6.png"), @image-url("digits/700/7.png"), @image-url("digits/700/8.png"), @image-url("digits/700/9.png")];
    property <[image]> w800: [@image-url("digits/800/0.png"), @image-url("digits/800/1.png"), @image-url("digits/800/2.png"), @image-url("digits/800/3.png"), @image-url("digits/800/4.png"), @image-url("digits/800/5.png"), @image-url("digits/800/6.png"), @image-url("digits/800/7.png"), @image-url("digits/800/8.png"), @image-url("digits/800/9.png")];
    function idx(d: string) -> int {
        d == "1" ? 1 : d == "2" ? 2 : d == "3" ? 3 : d == "4" ? 4 : d == "5" ? 5
            : d == "6" ? 6 : d == "7" ? 7 : d == "8" ? 8 : d == "9" ? 9 : 0
    }
    property <image> blank;              // a blank card (12-hour mode: the hour's first card before 10)
    function glyph(d: string) -> image {
        d == "" ? root.blank : root.weight <= 450 ? root.w300[root.idx(d)] : root.weight <= 650 ? root.w600[root.idx(d)]
            : root.weight <= 750 ? root.w700[root.idx(d)] : root.w800[root.idx(d)]
    }
    property <string> old-digit;         // the digit before the change
    property <string> shown;             // the digit it settled on
    property <bool> flipping;
    property <duration> started;
    init => { root.shown = root.new-digit; root.old-digit = root.new-digit; }
    property <bool> searching;
    property <bool> quick;               // the searching flaps: 60 ms each, no delay
    property <int> goal;
    changed new-digit => {
        if root.search && root.idx(root.new-digit) > root.idx(root.shown) {
            root.goal = root.idx(root.new-digit);
            root.quick = true;
            root.searching = true;
            root.step();
        } else {
            root.searching = false;
            root.quick = false;
            root.old-digit = root.shown;
            root.shown = root.new-digit;
            root.started = animation-tick();
            root.flipping = root.old-digit != root.new-digit;
        }
    }
    function step() {
        root.old-digit = root.shown;
        root.shown = "" + Math.mod(root.idx(root.shown) + 9, 10);
        root.started = animation-tick();
        root.flipping = true;
        if root.idx(root.shown) == root.goal { root.searching = false; }
    }
    Timer { interval: 60ms; running: root.searching; triggered => { root.step(); } }
    property <duration> fdur: root.quick ? 60ms : root.dur;
    property <duration> fdelay: root.quick ? 0ms : root.delay;
    // the clock is read only while it flips, so a still card costs nothing
    property <float> flip: root.flipping ? Math.max(0, Math.min(1, (animation-tick() - root.started - root.fdelay) / root.fdur)) : 1;
    Timer { interval: root.fdelay + root.fdur + 60ms; running: root.flipping; triggered => { root.flipping = false; root.quick = root.searching; } }
    property <length> half: self.height / 2;
    property <bool> moving: root.flip < 1 && root.old-digit != root.shown;
    // 25.C8: the landing (50 ms after the flap falls open): a 1 px knock, the shadow flickering once
    property <float> landed: root.flipping && root.flip >= 1 ? (animation-tick() - root.started - root.fdelay - root.fdur) / 1ms : -1;
    property <length> knock: root.landed >= 0 && root.landed < 40 ? 1px : 0px;
    property <float> p1: min(1, root.flip * 2);         // top flap rotating down
    property <float> p2: max(0, root.flip * 2 - 1);     // bottom flap falling open
    property <length> h1: root.half * Math.cos(root.p1 * 90deg);
    property <length> h2: root.half * Math.sin(root.p2 * 90deg);
    border-radius: 10px;
    background: root.card;
    clip: true;
    // Fixed halves: new top (revealed behind the falling flap), old bottom (until covered).
    Image {
        y: root.knock; width: root.width; height: root.half;
        source: root.glyph(root.shown);
        source-clip-y: 0; source-clip-height: 150;
        image-fit: fill; colorize: root.ink;
    }
    Image {
        y: root.half + root.knock; width: root.width; height: root.half;
        source: root.glyph(root.moving ? root.old-digit : root.shown);
        source-clip-y: 150; source-clip-height: 150;
        image-fit: fill; colorize: root.ink;
    }
    // The falling flap's shadow on the lower half: it deepens while the top flap turns down and lifts again
    // while the bottom flap falls open over it (no step at the half-way point).
    if root.moving && root.p2 < 1: Rectangle {
        y: root.half; height: root.half;
        background: #000000.with-alpha(0.3 * (root.p1 < 1 ? root.p1 : 1 - root.p2));
    }
    // Top flap: a rigid plate turning down around the hinge.
    if root.moving && root.p1 < 1: Rectangle {
        y: root.half - root.h1; height: root.h1;
        background: root.card.mix(#000000, 1 - 0.55 * root.p1);
        Image {
            width: root.width; height: root.h1;
            source: root.glyph(root.old-digit);
            source-clip-y: 0; source-clip-height: 150;
            image-fit: fill; colorize: root.ink.mix(#000000, 1 - 0.55 * root.p1);
        }
        // Light catching the edge of the plate
        Rectangle { y: 0; height: 1px; background: #ffffff.with-alpha(0.12 * (1 - root.p1)); }
    }
    // Bottom flap: the new lower half falling open from the hinge.
    if root.moving && root.p2 > 0: Rectangle {
        y: root.half; height: root.h2;
        background: root.card.mix(#000000, 0.6 + 0.4 * root.p2);
        Image {
            width: root.width; height: root.h2;
            source: root.glyph(root.shown);
            source-clip-y: 150; source-clip-height: 150;
            image-fit: fill; colorize: root.ink.mix(#000000, 0.6 + 0.4 * root.p2);
        }
        Rectangle { y: parent.height - 1px; height: 1px; background: #000000.with-alpha(0.4 * (1 - root.p2)); }
    }
    if root.landed >= 20 && root.landed < 50: Rectangle { y: root.half; height: root.half; background: #000000.with-alpha(0.14); }
    // Hinge
    Rectangle { y: root.half - 1px; height: 2px; background: #000000.with-alpha(0.55); }
}

// Split-flap ("railway station") clock: four cards, accent colon dots.
export component FlipClock inherits HorizontalLayout {
    in property <ClockData> data;
    in property <int> weight: 600;
    in property <color> accent;
    in property <float> colon: 1;
    in property <length> card-width: 94px;
    in property <length> card-height: 150px;
    property <color> card: Theme.dark ? #1d1d21 : #2b2b31;
    spacing: 8px;
    alignment: center;
    FlapCard { width: root.card-width; height: root.card-height; card: root.card; weight: root.weight;
        new-digit: root.data.d1; delay: 210ms; }
    FlapCard { width: root.card-width; height: root.card-height; card: root.card; weight: root.weight;
        new-digit: root.data.d2; delay: 140ms; }
    VerticalLayout {
        alignment: center;
        spacing: root.card-height * 0.22;
        opacity: root.colon;
        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.accent; }
        Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.accent; }
    }
    FlapCard { width: root.card-width; height: root.card-height; card: root.card; weight: root.weight;
        new-digit: root.data.d3; delay: 70ms; }
    FlapCard { width: root.card-width; height: root.card-height; card: root.card; weight: root.weight;
        new-digit: root.data.d4; delay: 0ms; }
    // 12-hour mode: a small AM / PM flap at the foot of the minutes
    if root.data.ampm != "": VerticalLayout {
        alignment: end;
        Rectangle {
            width: root.card-height * 0.34; height: root.card-height * 0.22; border-radius: 6px; background: root.card;
            Text { text: root.data.ampm; font-size: root.card-height * 0.12; font-weight: root.weight; color: #f4f4f5;
                horizontal-alignment: center; vertical-alignment: center; }
            Rectangle { y: parent.height / 2 - 0.5px; height: 1px; background: #000000.with-alpha(0.55); }
        }
    }
}

// Clock face. style: 0 big clock + details, 1 huge digits, 2 round analog,
// 3 square analog (date window), 4 minimal analog, 5 square analog with
// numerals, 6 wandering, 7 split-flap. Every element except the time can be switched off;
// what is left is centred in the space they all shared.
export component ClockFace inherits Rectangle {
    in property <ClockData> data;
    in property <int> style: 0;
    in property <color> accent: Theme.accent;
    in property <int> weight: 600;
    in property <bool> show-date: true;
    in property <bool> show-weather: true;
    in property <bool> show-next: true;
    in property <bool> show-seconds: true;   // second hand / seconds line / breathing colon
    in property <bool> live: true;           // on screen: only then the seconds run (a page off screen stands still)
    // 0..60, moving smoothly (the app's clock, interpolated by the UI)
    in property <float> seconds: root.data.seconds;
    // Style 6 wanders like the classic bouncing screensaver: straight lines
    // at 45 degrees, bouncing off the edges; only the speed can be set.
    in property <float> wander-speed: 20;    // pixels per second
    in property <float> width-k: 1;          // the digits narrower (< 1) or wider (> 1), from the screensaver settings
    property <bool> has-next: root.show-next && root.data.next != "";
    property <bool> clock-only: !root.show-date && !root.show-weather && !root.has-next;
    // the colon breathes evenly, once in 2 s
    // the seconds, sampled 30 times a second: the colon, the second hand and the seconds line move at 30 fps
    property <float> s30;
    // Calm (Clock.calm: nobody near and nothing asked of the panel for 10 minutes): over 5 s the breathing turns into a
    // plain step, bright one second and dim the next, and then the seconds tick once a second, on the whole second (one
    // frame a second); anything that stirs the panel brings the breathing back, gradually over 2 s.
    property <float> calm-k;             // 0 breathing … 1 calm
    property <bool> calm-wait;           // waiting for the next whole second
    property <bool> calm-tick;           // ticking once a second
    property <duration> calm-d: 1s;
    property <int> calm-n;
    property <bool> calm-on: Clock.calm;
    changed calm-on => { if !root.calm-on { root.calm-wait = false; root.calm-tick = false; } }
    changed live => { root.calm-wait = false; root.calm-tick = false; }
    Timer {
        interval: !root.show-seconds ? 1s : 33ms;
        running: root.live && !root.calm-wait && !root.calm-tick;
        triggered => {
            root.s30 = root.seconds;
            if root.show-seconds {
                if root.calm-on {
                    root.calm-k = min(1, root.calm-k + 0.033 / 5);
                } else {
                    root.calm-k = max(0, root.calm-k - 0.033 / 2);
                }
                if root.calm-on && root.calm-k >= 1 {
                    root.calm-d = (1 - Math.mod(root.s30, 1)) * 1000ms + 20ms;
                    root.calm-wait = true;
                }
            }
        }
    }
    Timer {
        interval: root.calm-d;
        running: root.live && root.calm-wait;
        triggered => {
            root.calm-wait = false;
            root.s30 = Math.mod(Math.round(root.seconds), 60);
            root.calm-n = 0;
            root.calm-tick = true;
        }
    }
    Timer {
        interval: 1s;
        running: root.live && root.calm-tick;
        triggered => {
            root.s30 = Math.mod(Math.round(root.seconds), 60);
            root.calm-n += 1;
            // once a minute back onto the whole second (the ticks drift by a few ms)
            if root.calm-n >= 60 {
                root.calm-d = (1 - Math.mod(root.seconds, 1)) * 1000ms + 20ms;
                root.calm-tick = false;
                root.calm-wait = true;
            }
        }
    }
    // on a whole second the breath is at its top or bottom: calm and breathing meet there
    property <float> breath: 0.75 + 0.25 * Math.cos(root.s30 * 180deg);
    property <float> beat: Math.mod(Math.floor(root.s30 + 0.001), 2) == 0 ? 1 : 0.5;
    property <float> colon: root.show-seconds ? root.breath + (root.beat - root.breath) * root.calm-k : 1;
    property <float> minutes: root.data.mm.to-float() + root.s30 / 60;
    property <float> hours: Math.mod(root.data.hh.to-float(), 12) + root.minutes / 60;
    // Content area between the top line and the bottom row (heads, dots).
    property <length> top: 40px;
    property <length> bottom: 44px;
    background: style == 6 && Theme.dark ? #000000 : Theme.background;

    // 0: big clock with date, weather and next event under it (left), all
    //    vertically centred; the clock alone is centred both ways.
    if root.style == 0: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        padding-left: 28px;
        padding-right: 24px;
        alignment: center;
        spacing: 2px;
        // wider digits never leave the screen (scaled about the middle: the left margin limits too)
        Rectangle {
            transform-scale-x: min(root.width-k, (root.width - 52px) / max(1px, r0.preferred-width), 1 + 28px / ((root.width - 52px) / 2));
            r0 := HorizontalLayout {
                alignment: root.clock-only ? center : start;
                RollPair { text: root.data.th; font-size: 128px; font-weight: root.weight; color: Theme.text; }
                Text { text: ":"; font-size: 128px; font-weight: root.weight; color: root.accent; opacity: root.colon; }
                RollPair { text: root.data.mm; font-size: 128px; font-weight: root.weight; color: Theme.text; }
                AmPm { text: root.data.ampm; size: 128px; font-weight: root.weight; ink: Theme.text; }
            }
        }
        if root.show-date: SwapText { text: root.data.date; font-size: 22px; ink: Theme.muted; }
        if root.show-weather: HorizontalLayout {
            padding-top: 20px;
            spacing: 14px;
            alignment: start;
            Icon { text: root.data.weather-icon; font-size: 52px; color: Theme.text; }
            VerticalLayout {
                alignment: center;
                SwapText { text: root.data.temperature; font-size: 36px; font-weight: root.weight; ink: Theme.text; fade: true; }
            }
            VerticalLayout {
                alignment: center;
                SwapText { text: root.data.condition; font-size: Theme.font-body; ink: Theme.text; fade: true; }
                SwapText { text: root.data.high-low; font-size: Theme.font-label; ink: Theme.muted; fade: true; }
            }
        }
        if root.has-next: HorizontalLayout {
            padding-top: 16px;
            spacing: 8px;
            alignment: start;
            Icon { text: "\u{F00ED}"; font-size: 18px; color: root.accent; }
            Text { text: root.data.next; font-size: Theme.font-label; color: Theme.muted; vertical-alignment: center; }
        }
    }

    // 1: huge digits; seconds line, date · weather, next event (all optional)
    if root.style == 1: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        alignment: center;
        Rectangle {
            transform-scale-x: min(root.width-k, (root.width - 24px) / max(1px, r1.preferred-width));
            min-height: r1.preferred-height;
            // centred at its own width, so a time wider than the screen (12-hour, wide digits) scales about the middle
            r1 := HorizontalLayout {
                x: (parent.width - self.preferred-width) / 2; width: self.preferred-width;
                alignment: center;
                RollPair { text: root.data.th; font-size: 176px; font-weight: root.weight; color: Theme.text; ink: true; }
                Text { text: ":"; font-size: 176px; font-weight: root.weight; color: root.accent; opacity: root.colon; }
                RollPair { text: root.data.mm; font-size: 176px; font-weight: root.weight; color: Theme.text; ink: true; }
                AmPm { text: root.data.ampm; size: 176px; font-weight: root.weight; ink: Theme.text; }
            }
        }
        if root.show-seconds: HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 380px;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.surface-raised;
                Rectangle {
                    x: 0;
                    width: parent.width * root.s30 / 60;
                    background: root.accent;
                    border-radius: 1.5px;
                }
                // at the minute the full line fades out (0.25 s) over the new one instead of running back
                if root.s30 < 0.25: Rectangle {
                    x: 0;
                    background: root.accent;
                    border-radius: 1.5px;
                    opacity: 1 - root.s30 * 4;
                }
            }
        }
        if root.show-date || root.show-weather: InfoLine {
            padding-top: 18px;
            data: root.data; show-date: root.show-date; show-weather: root.show-weather; size: 20px;
        }
        if root.has-next: NextLine { padding-top: 10px; data: root.data; accent: root.accent; }
    }

    // 2: round analog; date · weather and next event under it
    if root.style == 2: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        alignment: center;
        spacing: 12px;
        HorizontalLayout {
            alignment: center;
            AnalogDial {
                size: root.clock-only ? 340px : 290px;
                show-seconds: root.show-seconds;
                h: root.hours; m: root.minutes; s: root.s30;
                accent: root.accent; weight: root.weight;
            }
        }
        if root.show-date || root.show-weather: InfoLine { data: root.data; show-date: root.show-date; show-weather: root.show-weather; }
        if root.has-next: NextLine { data: root.data; accent: root.accent; }
    }

    // 3: square analog filling the panel; date window, weather, next event inside
    if root.style == 3: AnalogDial {
        x: 16px; y: 16px;
        size: root.width - 32px;
        shape: 1;
        show-seconds: root.show-seconds;
        weekday: root.show-date ? root.data.weekday : ""; day: root.data.day;
        weather: root.show-weather ? root.data.temperature + "  " + root.data.condition : "";
        weather-icon: root.data.weather-icon;
        next: root.has-next ? root.data.next : "";
        h: root.hours; m: root.minutes; s: root.s30;
        accent: root.accent; weight: root.weight;
    }

    // 4: minimal analog; big date, weather and next event under it
    if root.style == 4: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            AnalogDial {
                size: root.clock-only ? 340px : 300px;
                minimal: true;
                show-seconds: root.show-seconds;
                h: root.hours; m: root.minutes; s: root.s30;
                accent: root.accent; weight: root.weight;
            }
        }
        if root.show-date: Text { text: root.data.date; font-size: 26px; font-weight: root.weight; color: Theme.text; horizontal-alignment: center; }
        if root.show-weather: InfoLine { data: root.data; show-date: false; show-weather: true; condition: true; }
        if root.has-next: NextLine { data: root.data; accent: root.accent; }
    }

    // 5: square analog with big numerals; date under the 12, weather and next inside
    if root.style == 5: AnalogDial {
        x: 16px; y: 16px;
        size: root.width - 32px;
        shape: 1;
        numerals: true;
        show-seconds: root.show-seconds;
        weekday: root.show-date ? root.data.weekday : ""; day: root.data.day;
        weather: root.show-weather ? root.data.temperature : "";
        weather-icon: root.data.weather-icon;
        next: root.has-next ? root.data.next : "";
        h: root.hours; m: root.minutes; s: root.s30;
        accent: root.accent; weight: root.weight;
    }

    // 7: split-flap cards; date · weather and next event under them
    if root.style == 7: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        alignment: center;
        spacing: 16px;
        Rectangle {
            transform-scale-x: min(root.width-k, (root.width - 24px) / max(1px, r7.preferred-width));
            min-height: r7.preferred-height;
            r7 := FlipClock {
                x: (parent.width - self.preferred-width) / 2; width: self.preferred-width;
                data: root.data; weight: root.weight; accent: root.accent; colon: root.colon;
                card-height: root.clock-only ? 170px : 150px;
            }
        }
        if root.show-date || root.show-weather: InfoLine { data: root.data; show-date: root.show-date; show-weather: root.show-weather; size: 19px; }
        if root.has-next: NextLine { data: root.data; accent: root.accent; }
    }

    // 8: nixie tubes on the walnut plinth, 9: the LCD quartz watch, 10: the twin-bell clock (spec 24.9): each fills the
    //    width like the others (centred, scaled to fit); date, weather and the next event under it (the LCD has its own
    //    weekday and date)
    property <length> look-w: root.width - 48px;
    if root.style >= 8 && root.style <= 10: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        padding-left: 24px;
        padding-right: 24px;
        alignment: center;
        spacing: 14px;
        if root.style == 8: NixieClock {
            height: min(root.clock-only ? 300px : 220px, root.look-w * 168 / (root.show-seconds ? 438 : 302));
            hh: root.data.th; ampm: root.data.ampm; mm: root.data.mm; seconds: root.s30; show-seconds: root.show-seconds; live: root.live && !root.calm-tick;
        }
        if root.style == 9: LcdClock {
            height: min(root.clock-only ? 300px : 236px, root.look-w * 200 / 348);
            hh: root.data.th; ampm: root.data.ampm; mm: root.data.mm; seconds: root.s30; weekday: root.data.lcd-day; date: root.data.lcd-date;
        }
        if root.style == 10: TwinBellClock {
            height: root.clock-only ? 320px : 252px;
            hours: root.hours; minutes: root.minutes; seconds: root.s30; show-seconds: root.show-seconds;
        }
        if (root.show-date && root.style != 9) || root.show-weather: InfoLine {
            data: root.data; show-date: root.show-date && root.style != 9; show-weather: root.show-weather; size: 19px;
        }
        if root.has-next: NextLine { data: root.data; accent: root.accent; }
    }

    // 6: smaller clock bouncing slowly around the screen
    property <length> wander-w: 260px;
    property <length> wander-h: 150px;
    property <float> wander-t: (animation-tick() - Clock.base) / 1ms / 1000;
    // the distance travelled carries on when the speed setting changes (no jump to another place)
    property <float> wander-p0;
    property <float> wander-t0;
    property <float> wander-v: root.wander-speed;
    changed wander-speed => {
        root.wander-p0 = root.wander-p0 + (root.wander-t - root.wander-t0) * root.wander-v;
        root.wander-t0 = root.wander-t;
        root.wander-v = root.wander-speed;
    }
    // a new clock base (the screensaver starts: the clock appears anew) restarts the count from there
    property <duration> wander-cb: Clock.base;
    changed wander-cb => { root.wander-t0 = root.wander-t; }
    property <float> wander-d: root.wander-p0 + max(0, root.wander-t - root.wander-t0) * root.wander-v;
    // Triangle wave: position along one axis bouncing between 0 and range.
    function bounce(dist: float, range: float) -> float {
        range - abs(Math.mod(dist, 2 * range) - range)
    }
    // C7: the distance since the last turn on each axis (the triangle wave turns at 0 and at its range), as time
    property <float> wrx: (root.width - root.wander-w) / 1px;
    property <float> wry: (root.height - root.wander-h) / 1px;
    property <float> wux: Math.mod(root.wander-d + 37, 2 * root.wrx);
    property <float> wuy: Math.mod(root.wander-d + 113, 2 * root.wry);
    property <float> wsx: (root.wux < root.wrx ? root.wux : root.wux - root.wrx) / max(1, root.wander-v);
    property <float> wsy: (root.wuy < root.wry ? root.wuy : root.wuy - root.wry) / max(1, root.wander-v);
    // … and until the next one: a squash runs 60 ms on each side of the hit
    property <float> wtx: (root.wux < root.wrx ? root.wrx - root.wux : 2 * root.wrx - root.wux) / max(1, root.wander-v);
    property <float> wty: (root.wuy < root.wry ? root.wry - root.wuy : 2 * root.wry - root.wuy) / max(1, root.wander-v);
    property <float> sqx: root.style == 6 ? 0.04 * max(0, 1 - min(root.wsx, root.wtx) / 0.06) : 0;
    property <float> sqy: root.style == 6 ? 0.04 * max(0, 1 - min(root.wsy, root.wty) / 0.06) : 0;
    // an exact corner (both turns within 40 ms of each other): a spark burst there for 400 ms
    // (two properties: written as one, the compiler computes the twice-used wsx before the style test, so every clock face read the
    // animation clock in every frame and drew 60 frames a second whatever its style)
    property <bool> spark-near: Math.abs(root.wsx - root.wsy) < 0.04 && root.wsx < 0.4;
    property <bool> spark: root.style == 6 && root.spark-near;
    if root.spark: Rectangle {
        property <float> k: root.wsx / 0.4;
        property <float> cx: root.wux < root.wrx ? 0 : root.width / 1px;
        property <float> cy: root.wuy < root.wry ? 0 : root.height / 1px;
        for d in 8: Rectangle {
            property <angle> a: d * 12.86deg;
            property <float> r: 6 + 46 * (1 - Math.pow(1 - parent.k, 2));
            x: (parent.cx + (parent.cx > 0 ? -1 : 1) * Math.abs(self.r * Math.cos(self.a)) - 2) * 1px;
            y: (parent.cy + (parent.cy > 0 ? -1 : 1) * Math.abs(self.r * Math.sin(self.a)) - 2) * 1px;
            width: 4px; height: 4px; border-radius: 2px; background: root.accent.mix(#ffffff, 0.6); opacity: 1 - parent.k;
        }
    }
    if root.style == 6: VerticalLayout {
        x: root.bounce(root.wander-d + 37, (root.width - root.wander-w) / 1px) * 1px;
        y: root.bounce(root.wander-d + 113, (root.height - root.wander-h) / 1px) * 1px;
        width: root.wander-w;
        height: root.wander-h;
        alignment: center;
        Rectangle {
            transform-scale-x: min(root.width-k, root.wander-w / max(1px, r6.preferred-width)) * (1 - root.sqx);
            min-height: r6.preferred-height;
            transform-scale-y: 1 - root.sqy;
            r6 := HorizontalLayout {
                x: (parent.width - self.preferred-width) / 2; width: self.preferred-width;
                alignment: center;
                RollPair { text: root.data.th; font-size: 84px; font-weight: root.weight; color: Theme.dark ? #c8c8cf : Theme.text; }
                Text { text: ":"; font-size: 84px; font-weight: root.weight; color: root.accent.with-alpha(0.85); opacity: root.colon; }
                RollPair { text: root.data.mm; font-size: 84px; font-weight: root.weight; color: Theme.dark ? #c8c8cf : Theme.text; }
                AmPm { text: root.data.ampm; size: 84px; font-weight: root.weight; ink: Theme.dark ? #c8c8cf : Theme.text; }
            }
        }
        if root.show-date || root.show-weather: InfoLine { data: root.data; show-date: root.show-date; show-weather: root.show-weather; size: 16px; color: Theme.faint; }
        if root.has-next: NextLine { padding-top: 4px; data: root.data; accent: root.accent.with-alpha(0.8); size: 14px; }
    }
}

export struct WeatherHour {
    label: string,       // "08"
    icon: string,
    temp: float,         // 12.0
    precip: int,         // %
}

export struct WeatherDay {
    label: string,       // "Mon"
    icon: string,
    high: float,
    low: float,
    precip: int,
}

export struct WeatherData {
    icon: string,
    temperature: string, // "12°"
    condition: string,
    feels: string,       // "Feels like 10°"
    wind: string,        // "12 km/h"
    humidity: string,    // "68 %"
    precip: string,      // "20 %"
    high-low: string,    // "H 15° · L 7°"
    sunrise: string,
    sunset: string,
    hours: [WeatherHour],
    days: [WeatherDay],
    mood: int,           // 0 sunny, 1 partly cloudy, 2 cloudy, 3 rain, 4 snow, 5 fog, 6 wind, 7 clear night, 8 thunder,
                         // 9 exceptional, 10 cloudy night, 11 rainy night, 12 snowy night, 13 mist, 14 winter sunny, 15 winter fog
    rain: int,           // 0 from the condition, 1 drizzle, 2 rain, 3 pouring (also over a sunny photo)
    dusk: float,         // 0..1 sunset light, from the sun elevation
    dawn: float,         // 0..1 sunrise light
    sky-loop: float,     // mockup only: seamless sky loop length in s (panel: 0)
    time-offset: float,  // mockup only: clock offset for long renders in batches
    wind-kmh: float,     // wind speed, km/h (sky speed, rain slant)
    gust-kmh: float,     // wind gust, km/h (gusts)
    theme: int,          // 0 nature, 1 countryside, 2 city (photo); 3 countryside, 4 city, 5 neutral, 6 big city (drawn); 7 line
    real-sun: bool,      // sun / moon follow the real sky (then the elevation also drives dusk, dawn and night)
    sun-az: float,       // degrees (HA sun.sun azimuth)
    sun-el: float,       // degrees (HA sun.sun elevation)
    moon-az: float,      // degrees (computed by the app)
    moon-el: float,
    moon-phase: float,   // 0 new, 0.5 full
    sun-veil: float,     // 0..1 how much the sun is behind a widget (the app computes it)
    moon-veil: float,
}

// Weather panel. variant: 0 full, 1 mood (animated sky), 2 compact, 3 chart.
// appear: 0..1 entrance when the page comes into view.
export component WeatherPanel inherits Rectangle {
    in property <WeatherData> data;
    in property <int> variant: 0;
    in property <float> appear: 1;
    in property <color> accent: Theme.accent;
    in property <int> weight: 600;
    in property <bool> show-details: true;   // wind, humidity, rain, sun times
    in property <bool> show-hours: true;
    in property <bool> show-days: true;
    in property <bool> fx-bolts: true;       // visible lightning bolts in a thunderstorm
    in property <bool> fx-flash: true;       // lightning flash
    in property <bool> fx-drops: true;       // rain drops on the glass
    in property <image> sky-frame;           // optional per-frame sky from the app
    in property <bool> shown;                // the page is the one on screen (25.W1: it opens)
    // 25.W1: when the page opens, the forecast bars grow from zero one after another (300 ms each, 20 ms apart)
    property <bool> opening;
    property <duration> open-t0;
    changed shown => { if root.shown { root.open-t0 = animation-tick(); root.opening = true; } }
    Timer { interval: 520ms; running: root.opening; triggered => { root.opening = false; } }
    property <float> open-t: root.opening ? (animation-tick() - root.open-t0) / 1ms : 10000;
    property <length> top: 40px;
    property <length> bottom: 44px;
    background: Theme.background;
    function fade(k: float) -> float { max(0, min(1, root.appear * 4 - k)) }
    // Temperature range of the days, for the bars.
    property <float> lo: root.data.days.length > 0 ? min(root.data.days[0].low, root.data.days[1].low, root.data.days[2].low, root.data.days[3].low) : 0;
    property <float> hi: root.data.days.length > 0 ? max(root.data.days[0].high, root.data.days[1].high, root.data.days[2].high, root.data.days[3].high) : 1;

    // 0: full
    if root.variant == 0: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        padding-left: 18px; padding-right: 18px;
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            opacity: root.fade(0);
            Icon { text: root.data.icon; font-size: 72px; color: Theme.text; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.data.temperature; font-size: 60px; font-weight: root.weight; color: Theme.text; }
                Text { text: root.data.condition; font-size: Theme.font-body; color: Theme.text; }
            }
            VerticalLayout {
                alignment: center;
                Text { text: root.data.high-low; font-size: Theme.font-label; color: Theme.muted; horizontal-alignment: right; }
                Text { text: root.data.feels; font-size: Theme.font-label; color: Theme.muted; horizontal-alignment: right; }
            }
        }
        if root.show-details: HorizontalLayout {
            spacing: 8px;
            alignment: center;
            opacity: root.fade(0.6);
            for c in [
                { icon: "\u{F059D}", text: root.data.wind },
                { icon: "\u{F058E}", text: root.data.humidity },
                { icon: "\u{F054A}", text: root.data.precip },
                { icon: "\u{F059C}", text: root.data.sunrise + " – " + root.data.sunset },
            ]: Rectangle {
                height: 30px;
                border-radius: 15px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 12px; spacing: 5px;
                    Icon { text: c.icon; font-size: 16px; color: Theme.muted; }
                    Text { text: c.text; font-size: Theme.font-caption; color: Theme.text; vertical-alignment: center; }
                }
            }
        }
        if root.show-hours: Rectangle {
            height: 84px;
            border-radius: Theme.radius-small;
            background: Theme.surface;
            opacity: root.fade(1.2);
            HorizontalLayout {
                padding: 6px;
                for h in root.data.hours: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text { text: h.label; font-size: Theme.font-caption; color: Theme.muted; horizontal-alignment: center; }
                    Icon { text: h.icon; font-size: 24px; color: Theme.text; }
                    Text { text: round(h.temp) + "°"; font-size: 15px; font-weight: Theme.weight-strong; color: Theme.text; horizontal-alignment: center; }
                    Text { text: h.precip + "%"; font-size: 11px; color: #4aa8ff; horizontal-alignment: center; }
                }
            }
        }
        if root.show-days: VerticalLayout {
            spacing: 2px;
            opacity: root.fade(1.8);
            for d[di] in root.data.days: grow-row := HorizontalLayout {
                height: 28px;
                spacing: 10px;
                property <float> grow: clamp((root.open-t - di * 20) / 300, 0, 1);
                Text { width: 44px; text: d.label; font-size: Theme.font-label; color: Theme.text; vertical-alignment: center; }
                Icon { width: 28px; text: d.icon; font-size: 20px; color: Theme.text; }
                Text { width: 40px; text: d.precip > 0 ? d.precip + "%" : ""; font-size: 12px; color: #4aa8ff; vertical-alignment: center; }
                Text { width: 34px; text: round(d.low) + "°"; font-size: Theme.font-label; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                // Range bar: where this day's low..high sits in the week's range.
                Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 6px; border-radius: 3px; background: Theme.surface-raised;
                            Rectangle {
                                x: parent.width * (d.low - root.lo) / max(1, root.hi - root.lo);
                                width: parent.width * (d.high - d.low) / max(1, root.hi - root.lo) * (1 - Math.pow(1 - grow-row.grow, 3));
                                border-radius: 3px;
                                background: @linear-gradient(90deg, #4aa8ff 0%, #ffb547 100%);
                            }
                        }
                    }
                }
                Text { width: 34px; text: round(d.high) + "°"; font-size: Theme.font-label; color: Theme.text; vertical-alignment: center; }
            }
        }
    }

    // 1: mood — animated sky, big temperature
    if root.variant == 1: wsky := PhotoSky {
        mood: root.data.mood;
        theme: root.data.theme;
        rain: root.data.rain;
        dusk: root.data.dusk;
        dawn: root.data.dawn;
        sky-loop: root.data.sky-loop;
        time-offset: root.data.time-offset;
        wind: root.data.wind-kmh;
        gust: root.data.gust-kmh;
        sky-frame: root.sky-frame;
        real-sun: root.data.real-sun;
        sun-az: root.data.sun-az;
        sun-el: root.data.sun-el;
        moon-az: root.data.moon-az;
        moon-el: root.data.moon-el;
        moon-phase: root.data.moon-phase;
        sun-veil: root.data.sun-veil;
        moon-veil: root.data.moon-veil;
        bolts: root.fx-bolts;
        flash: root.fx-flash;
        drops: root.fx-drops;
        VerticalLayout {
            y: root.top;
            height: root.height - root.top - root.bottom;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 10px;
                GlowText { icon: true; horizontal-alignment: center; k: wsky.glow-k; text: root.data.icon; font-size: 64px; color: #ffffff; }
                GlowText { k: wsky.glow-k; text: root.data.temperature; font-size: 104px; font-weight: root.weight; color: #ffffff; }
            }
            GlowText { k: wsky.glow-k; text: root.data.condition; font-size: 24px; color: #ffffff; horizontal-alignment: center; }
            GlowText { k: wsky.glow-k; text: root.data.high-low + "   ·   " + root.data.precip + " rain"; font-size: 16px; color: #ffffffcc; horizontal-alignment: center; }
            if root.show-hours: HorizontalLayout {
                padding-top: 22px;
                alignment: center;
                spacing: 6px;
                for h in root.data.hours: Rectangle {
                    width: 62px; height: 70px; border-radius: 14px;
                    background: #ffffff1f;
                    VerticalLayout {
                        alignment: center;
                        Text { text: h.label; font-size: 12px; color: #ffffffcc; horizontal-alignment: center; }
                        Icon { text: h.icon; font-size: 20px; color: #ffffff; }
                        Text { text: round(h.temp) + "°"; font-size: 14px; font-weight: Theme.weight-strong; color: #ffffff; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    // 2: compact — big and simple
    if root.variant == 2: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        alignment: center;
        spacing: 0px;
        opacity: root.fade(0);
        HorizontalLayout { alignment: center; Icon { text: root.data.icon; font-size: 110px; color: Theme.text; } }
        Text { text: root.data.temperature; font-size: 120px; font-weight: root.weight; color: Theme.text; horizontal-alignment: center; }
        Text { text: root.data.condition; font-size: 24px; color: Theme.text; horizontal-alignment: center; }
        HorizontalLayout {
            padding-top: 6px;
            alignment: center;
            spacing: 14px;
            Text { text: root.data.high-low; font-size: 18px; color: Theme.muted; }
            HorizontalLayout { spacing: 4px; Icon { text: "\u{F054A}"; font-size: 18px; color: #4aa8ff; } Text { text: root.data.precip; font-size: 18px; color: Theme.muted; } }
        }
    }

    // 3: chart — temperature curve for the next hours, rain bars under it
    if root.variant == 3: VerticalLayout {
        y: root.top;
        height: root.height - root.top - root.bottom;
        padding-left: 18px; padding-right: 18px;
        alignment: center;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Icon { text: root.data.icon; font-size: 56px; color: Theme.text; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.data.temperature + "  " + root.data.condition; font-size: 26px; font-weight: root.weight; color: Theme.text; }
                Text { text: root.data.high-low + " · " + root.data.feels; font-size: Theme.font-label; color: Theme.muted; }
            }
        }
        chart := Rectangle {
            height: 250px;
            border-radius: Theme.radius-small;
            background: Theme.surface;
            clip: true;
            property <length> pw: self.width - 24px;
            property <length> ph: 150px;
            property <float> tmin: min(root.data.hours[0].temp, root.data.hours[1].temp, root.data.hours[2].temp, root.data.hours[3].temp, root.data.hours[4].temp, root.data.hours[5].temp) - 1;
            property <float> tmax: max(root.data.hours[0].temp, root.data.hours[1].temp, root.data.hours[2].temp, root.data.hours[3].temp, root.data.hours[4].temp, root.data.hours[5].temp) + 1;
            // Point centres in pixels inside the plot.
            function cx(i: int) -> float { (self.pw / 1px) * (i + 0.5) / 6 }
            function cy(t: float) -> float { (self.ph / 1px - 12) * (1 - (t - self.tmin) / (self.tmax - self.tmin)) + 6 }
            // Rain bars
            for h[i] in root.data.hours: Rectangle {
                x: 12px + chart.pw * (i + 0.5) / root.data.hours.length - 10px;
                y: 200px - self.height;
                width: 20px;
                height: 40px * h.precip / 100 * min(1, root.appear * 1.5);
                border-radius: 3px;
                background: #4aa8ff.with-alpha(0.55);
            }
            // Curve, drawn in from the left as the page appears. Coordinates in
            // pixels; the Path is enlarged by its stroke so Slint's stroke inset
            // cancels out and the line meets the dots exactly.
            Rectangle {
                x: 12px; y: 30px; width: chart.pw * min(1, root.appear * 1.2); height: chart.ph + 20px; clip: true;
                Path {
                    x: -1.5px; y: -1.5px; width: chart.pw + 3px; height: chart.ph + 3px;
                    viewbox-width: chart.pw / 1px; viewbox-height: chart.ph / 1px;
                    stroke: root.accent;
                    stroke-width: 3px;
                    commands: "M " + chart.cx(0) + " " + chart.cy(root.data.hours[0].temp)
                        + " L " + chart.cx(1) + " " + chart.cy(root.data.hours[1].temp)
                        + " L " + chart.cx(2) + " " + chart.cy(root.data.hours[2].temp)
                        + " L " + chart.cx(3) + " " + chart.cy(root.data.hours[3].temp)
                        + " L " + chart.cx(4) + " " + chart.cy(root.data.hours[4].temp)
                        + " L " + chart.cx(5) + " " + chart.cy(root.data.hours[5].temp);
                }
                for h[i] in root.data.hours: Rectangle {
                    x: chart.cx(i) * 1px - 5px;
                    y: chart.cy(h.temp) * 1px - 5px;
                    width: 10px; height: 10px; border-radius: 5px;
                    background: root.accent;
                    Text {
                        y: -22px; x: -10px; width: 30px;
                        text: round(h.temp) + "°"; font-size: 13px; color: Theme.text; horizontal-alignment: center;
                    }
                }
            }
            // Hour labels
            for h[i] in root.data.hours: Text {
                x: 12px + chart.pw * (i + 0.5) / root.data.hours.length - 20px;
                y: 210px;
                width: 40px;
                text: h.label; font-size: 12px; color: Theme.muted; horizontal-alignment: center;
            }
        }
    }
}

// One assistant page (or the screensaver) with the shared frame around it.
export component AssistantPage inherits Rectangle {
    in property <string> hint;
    in property <bool> mic-muted;
    in property <[TimerInfo]> timers;
    in property <bool> problem;
    in property <int> page-count;
    in property <int> page;
    in property <float> dots-shown: 1;
    in property <[Person]> people;
    in property <bool> show-people: true;
    in property <bool> screensaver;      // quiet bar, no page dots
    in property <bool> on-color;         // panel draws its own coloured background
    background: Theme.background;
    @children
    StatusBar {
        x: 16px;
        y: 10px;
        width: root.width - 32px;
        hint: root.hint;
        mic-muted: root.mic-muted;
        timers: root.timers;
        problem: root.problem;
        quiet: root.screensaver;
        on-color: root.on-color;
    }
    if root.show-people && root.people.length > 0: People {
        x: 16px;
        y: root.height - 40px;
        people: root.people;
    }
    if !root.screensaver: PageDots {
        y: root.height - 22px;
        width: root.width;
        height: 6px;
        count: root.page-count;
        current: root.page;
        shown: root.dots-shown;
        on-color: root.on-color;
    }
}
