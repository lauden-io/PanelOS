            if !root.day-hidden: Image { x: root.fx + ws.oi * 1px; y: root.fy + (root.wy0 + k * 3) * 1px; width: 528px; height: 3px;
                source: root.fg(root.theme, root.mood); source-clip-x: 0; source-clip-y: root.wy0 + k * 3; source-clip-width: 528; source-clip-height: 3; }
            if !root.day-hidden: Image { x: root.fx + (ws.oi + 1) * 1px; y: root.fy + (root.wy0 + k * 3) * 1px; width: 528px; height: 3px; opacity: ws.of;
                source: root.fg(root.theme, root.mood); source-clip-x: 0; source-clip-y: root.wy0 + k * 3; source-clip-width: 528; source-clip-height: 3; }
            if root.has-grade && root.dk > 0 && root.nmix < 1: Image { x: root.fx + ws.oi * 1px; y: root.fy + (root.wy0 + k * 3) * 1px; width: 528px; height: 3px; opacity: root.dk;
                source: root.gfg(root.theme, root.mood, 0); source-clip-x: 0; source-clip-y: root.wy0 + k * 3; source-clip-width: 528; source-clip-height: 3; }
            if root.has-grade && root.dn > 0 && root.nmix < 1: Image { x: root.fx + ws.oi * 1px; y: root.fy + (root.wy0 + k * 3) * 1px; width: 528px; height: 3px; opacity: root.dn;
                source: root.gfg(root.theme, root.mood, 1); source-clip-x: 0; source-clip-y: root.wy0 + k * 3; source-clip-width: 528; source-clip-height: 3; }
            if root.nmix > 0: Image { x: root.fx + ws.oi * 1px; y: root.fy + (root.wy0 + k * 3) * 1px; width: 528px; height: 3px; opacity: root.nmix;
                source: root.fg(root.theme, root.nmood); source-clip-x: 0; source-clip-y: root.wy0 + k * 3; source-clip-width: 528; source-clip-height: 3; }
        }
    }
    if root.theme == 4: Path {
        // rooftop flag: wind from the right, so the cloth flies to the left; it hangs when calm
        property <float> lift: root.strong-wind ? 0.95 : root.wind >= 15 ? 0.6 : 0.16;
        animate lift { duration: 3s; easing: ease-in-out; }
        property <float> th: self.lift * 84;
        property <float> ph: root.flag-p0 + root.ph-e * root.flag-v;
        property <float> amp: 0.4 + 1.5 * self.lift;
        pure function px(u: float, e: float) -> float { 30 - u * 15 * Math.sin(self.th * 1deg) + e * 0
            + self.amp * u * Math.sin((self.ph - u * 220) * 1deg) * Math.cos(self.th * 1deg) }
        pure function py(u: float, e: float) -> float { 6 + e * 9 * (1 - 0.12 * u) + u * 15 * Math.cos(self.th * 1deg)
            + self.amp * u * Math.sin((self.ph - u * 220) * 1deg) * Math.sin(self.th * 1deg) }
        x: root.fx + 60.0px - 30px; y: root.fy + 238.0px - 6px; width: 36px; height: 40px;
        viewbox-width: 36; viewbox-height: 40;
        fill: #e8262d;
        commands: "M " + self.px(0, 0) + " " + self.py(0, 0) + " L " + self.px(0.25, 0) + " " + self.py(0.25, 0)
            + " L " + self.px(0.5, 0) + " " + self.py(0.5, 0) + " L " + self.px(0.75, 0) + " " + self.py(0.75, 0)
            + " L " + self.px(1, 0) + " " + self.py(1, 0) + " L " + self.px(1, 1) + " " + self.py(1, 1)
            + " L " + self.px(0.75, 1) + " " + self.py(0.75, 1) + " L " + self.px(0.5, 1) + " " + self.py(0.5, 1)
            + " L " + self.px(0.25, 1) + " " + self.py(0.25, 1) + " L " + self.px(0, 1) + " " + self.py(0, 1) + " Z";
    }
    if root.theme == 6: Path {
        // rooftop flag: wind from the right, so the cloth flies to the left; it hangs when calm
        property <float> lift: root.strong-wind ? 0.95 : root.wind >= 15 ? 0.6 : 0.16;
        animate lift { duration: 3s; easing: ease-in-out; }
        property <float> th: self.lift * 84;
        property <float> ph: root.flag-p0 + root.ph-e * root.flag-v;
        property <float> amp: 0.4 + 1.5 * self.lift;
        pure function px(u: float, e: float) -> float { 30 - u * 15 * Math.sin(self.th * 1deg) + e * 0
            + self.amp * u * Math.sin((self.ph - u * 220) * 1deg) * Math.cos(self.th * 1deg) }
        pure function py(u: float, e: float) -> float { 6 + e * 9 * (1 - 0.12 * u) + u * 15 * Math.cos(self.th * 1deg)
            + self.amp * u * Math.sin((self.ph - u * 220) * 1deg) * Math.sin(self.th * 1deg) }
        x: root.fx + 76.7px - 30px; y: root.fy + 237.0px - 6px; width: 36px; height: 40px;
        viewbox-width: 36; viewbox-height: 40;
        fill: #e8262d;
        commands: "M " + self.px(0, 0) + " " + self.py(0, 0) + " L " + self.px(0.25, 0) + " " + self.py(0.25, 0)
            + " L " + self.px(0.5, 0) + " " + self.py(0.5, 0) + " L " + self.px(0.75, 0) + " " + self.py(0.75, 0)
            + " L " + self.px(1, 0) + " " + self.py(1, 0) + " L " + self.px(1, 1) + " " + self.py(1, 1)
            + " L " + self.px(0.75, 1) + " " + self.py(0.75, 1) + " L " + self.px(0.5, 1) + " " + self.py(0.5, 1)
            + " L " + self.px(0.25, 1) + " " + self.py(0.25, 1) + " L " + self.px(0, 1) + " " + self.py(0, 1) + " Z";
    }

    // 5e. big city at night, at twilight and in dark weather: blinking aircraft lights, traffic
    //     with lights on the bridge
    property <float> city-l: max(root.night-k, root.dark-wx ? 0.8 : 0);
    if root.theme == 6 && root.city-l > 0.02: Rectangle {
        for l[i] in [{x: 22.0, y: 150.0}, {x: 352.0, y: 184.0}, {x: 458.0, y: 128.0}, {x: 442.0, y: 206.0}, {x: 474.0, y: 206.0}, {x: 120.0, y: 371.0}, {x: 408.0, y: 371.0}]: Image {
            property <float> ph: Math.mod(root.t + ((i >= 2 && i <= 4) ? 0 : i < 2 ? 0.5 : 0.9), 1.5);
            x: root.fx + (l.x - 7.5) * 1px; y: root.fy + (l.y - 7.5) * 1px; width: 15px; height: 15px;
            source: (root.light-variant ? @image-url("wx-light/vlight-red-light.png") : @image-url("wx/vlight-red.png"));
            opacity: (self.ph < 0.55 ? 0.15 + 0.85 * Math.sin(self.ph / 0.55 * 180deg) : 0.15) * root.city-l;
        }
    }
    if root.theme == 6 && root.city-l > 0.02: Rectangle {
        for i in 14: Rectangle {
            property <bool> east: Math.mod(i, 2) == 0;
            property <float> sp: 44 + Math.mod(i * 13, 24);
            property <float> d: Math.mod(root.t * self.sp + i * 97, 600);
            x: root.fx + (self.east ? self.d - 36 : 564 - self.d) * 1px; y: root.fy + (442 + (self.east ? 1 : 3)) * 1px;
            width: 3px; height: 1px;
            background: self.east ? #ff6a58 : #fff2d0;
            opacity: root.city-l;
        }
    }

    // 5f. strong wind on the drawn and line themes: wind lines draw themselves across the sky
    //     (a clip window runs along the line sprite: head first, then the tail), leaves tumble past
    property <bool> gusty: root.vector && root.strong-wind;
    property <float> gusty-k: root.gusty ? 1 : 0;
    animate gusty-k { duration: 2s; easing: ease-in-out; }
    if root.gusty-k > 0.001: Rectangle {
        opacity: root.gusty-k;
        // (line centre = y + 36: between the condition line and the cards, over the meadow, in the open sky)
        for g[i] in [{x: 150, y: 262, p: 3.6, ph: 0.0, v: 0, sp: 70}, {x: 120, y: 360, p: 4.4, ph: 1.7, v: 1, sp: 85},
                     {x: 170, y: 124, p: 5.2, ph: 3.1, v: 2, sp: 60}, {x: 130, y: 392, p: 4.0, ph: 2.6, v: 3, sp: 95},
                     {x: 100, y: 178, p: 4.8, ph: 0.9, v: 0, sp: 75}, {x: 60, y: 420, p: 3.9, ph: 2.2, v: 1, sp: 80},
                     {x: 190, y: 60, p: 4.6, ph: 0.4, v: 3, sp: 90}]: Rectangle {
            property <float> lt: Math.mod(root.t + g.ph, g.p);
            property <float> head: min(1, self.lt / 1.2);
            property <float> tail: max(0, min(1, (self.lt - 0.75) / 1.2));
            property <float> ox: g.x - g.sp * self.lt;
            visible: self.lt < 1.95;
            x: (self.ox + 320 * (1 - self.head)) * 1px; y: g.y * 1px; width: max(0, self.head - self.tail) * 320px; height: 72px;
            clip: true;
            Image { x: -320px * (1 - parent.head); y: 0; width: 320px; height: 72px;
                source: g.v == 0 ? (root.light-variant ? @image-url("wx-light/vgust-0-light.png") : @image-url("wx/vgust-0.png")) : g.v == 1 ? (root.light-variant ? @image-url("wx-light/vgust-1-light.png") : @image-url("wx/vgust-1.png")) : g.v == 2 ? (root.light-variant ? @image-url("wx-light/vgust-2-light.png") : @image-url("wx/vgust-2.png")) : (root.light-variant ? @image-url("wx-light/vgust-3-light.png") : @image-url("wx/vgust-3.png"));
                opacity: root.theme == 7 ? 0.45 : 0.9; }
        }
    }
    // a gust speeds the leaves up (+120 px/s at its peak): the gust's integral, not speed x time
    property <float> leaf-a: root.leaf-p0 + (root.gon-v ? 120 * (root.gint(root.t) - root.gint(root.ph-t0)) : 0);
    if root.gusty-k > 0.001 && root.theme != 7: Rectangle {
        opacity: root.gusty-k;
        for i in 9: Image {
            property <float> px: 520 - Math.mod(root.t * (190 + Math.mod(i * 37, 90)) + root.leaf-a + i * 173, 640);
            property <int> fr: Math.mod(Math.floor(root.t * 12 + i * 3), 8);
            x: self.px * 1px;
            y: (120 + Math.mod(i * 71, 250) + 26 * Math.sin((root.t * (1.6 + Math.mod(i, 3) * 0.4) + i) * 1rad) + 0.06 * (520 - self.px)) * 1px;
            width: 16px; height: 16px;
            source: (root.light-variant ? @image-url("wx-light/vleaf-light.png") : @image-url("wx/vleaf.png")); source-clip-x: self.fr * 16; source-clip-y: Math.mod(i, 4) * 16; source-clip-width: 16; source-clip-height: 16;
        }
    }

    // 6. winter fog: the fog is an "over" blend toward the fog colour, densest at the horizon
    if root.mood == 15 && root.theme != 7: Rectangle {
        background: @linear-gradient(180deg, #e6e8eb9e 0%, #e6e8ebc7 40%, #e6e8ebe6 56%, #e6e8ebb3 66%, #e6e8eb61 85%, #e6e8eb38 100%);
    }

    // 7. near mist, in front
    if root.misty: Image { x: -root.m2a * 1px; y: 150px; width: 1056px; height: 528px; source: root.theme == 7 ? (root.light-variant ? @image-url("wx-light/vline-fog-light.png") : @image-url("wx/vline-fog.png")) : @image-url("wx/mist.png"); opacity: 0.30 * (1 - root.wb); }
    if root.misty: Image { x: -root.m2a * 1px + 1056px; y: 150px; width: 1056px; height: 528px; source: root.theme == 7 ? (root.light-variant ? @image-url("wx-light/vline-fog-light.png") : @image-url("wx/vline-fog.png")) : @image-url("wx/mist.png"); opacity: 0.30 * (1 - root.wb); }
    if root.misty && root.wb > 0.004: Image { x: -root.m2b * 1px; y: 150px; width: 1056px; height: 528px; source: root.theme == 7 ? (root.light-variant ? @image-url("wx-light/vline-fog-light.png") : @image-url("wx/vline-fog.png")) : @image-url("wx/mist.png"); opacity: 0.30 * root.wb; }
    if root.misty && root.wb > 0.004: Image { x: -root.m2b * 1px + 1056px; y: 150px; width: 1056px; height: 528px; source: root.theme == 7 ? (root.light-variant ? @image-url("wx-light/vline-fog-light.png") : @image-url("wx/vline-fog.png")) : @image-url("wx/mist.png"); opacity: 0.30 * root.wb; }

    // 8. rain: far and near sheets, slanted by the wind (three strengths, wind from the right,
    //    so the rain falls down-left along its streaks); gusts lean the near rain further for ~3 s.
    property <float> far-a: root.rain-eff == 1 ? 0.35 : root.rain-eff == 2 ? 0.60 : root.rain-eff >= 3 ? 0.85 : 0;
    property <float> near-a: root.rain-eff == 2 ? 0.40 : root.rain-eff >= 3 ? 0.75 : 0;
    animate far-a, near-a { duration: 3s; easing: ease-in-out; }
    property <int> sl: root.wind >= 35 ? 2 : root.wind >= 15 ? 1 : 0;
    // a new slant crossfades in over 1.5 s: two sheet sets, the new one on top
    property <int> sla;
    property <int> slb;
    property <bool> sl-on-b;
    property <float> slk: root.sl-on-b ? 1 : 0;
    animate slk { duration: 1500ms; easing: ease-in-out; }
    changed sl => {
        if root.sl-on-b { root.sla = root.sl; root.sl-on-b = false; } else { root.slb = root.sl; root.sl-on-b = true; }
    }
    property <int> sl2: min(2, root.sl + 1);
    property <float> slv: root.sl == 2 ? 0.55 : root.sl == 1 ? 0.28 : 0.06;
    property <float> slv2: root.sl2 == 2 ? 0.55 : root.sl2 == 1 ? 0.28 : 0.06;
    property <float> gt: Math.mod(root.t + 3, 11);
    // gusts come and go over 2 s when the gust speed crosses the wind + 8 km/h
    property <float> gust-k: root.gust-on ? 1 : 0;
    animate gust-k { duration: 2s; easing: ease-in-out; }
    property <float> genv: root.gt < 3 ? root.gust-k * Math.sin(root.gt / 3 * 180deg) : 0;
    property <length> fy1: (Math.mod(root.t * 420, 528) - 528) * 1px;
    property <length> fx1: -Math.mod(root.fx-p0 + root.ph-e * 420 * root.slv-v, 528) * 1px;
    property <length> ny1: (Math.mod(root.t * 950, 528) - 528) * 1px;
    property <length> nx1: -Math.mod(root.nx-p0 + root.ph-e * 950 * root.slv-v, 528) * 1px;
    property <length> nx2: -Math.mod(root.nx2-p0 + root.ph-e * 950 * root.slv2-v, 528) * 1px;
    pure function far-tex(k: int) -> image { root.theme == 7 ? (k == 2 ? (root.light-variant ? @image-url("wx-light/vline-rain-far-s2-light.png") : @image-url("wx/vline-rain-far-s2.png")) : k == 1 ? (root.light-variant ? @image-url("wx-light/vline-rain-far-s1-light.png") : @image-url("wx/vline-rain-far-s1.png")) : (root.light-variant ? @image-url("wx-light/vline-rain-far-s0-light.png") : @image-url("wx/vline-rain-far-s0.png")))
        : k == 2 ? @image-url("wx/rain-far-s2.png") : k == 1 ? @image-url("wx/rain-far-s1.png") : @image-url("wx/rain-far-s0.png") }
    pure function near-tex(k: int) -> image { root.theme == 7 ? (k == 2 ? (root.light-variant ? @image-url("wx-light/vline-rain-near-s2-light.png") : @image-url("wx/vline-rain-near-s2.png")) : k == 1 ? (root.light-variant ? @image-url("wx-light/vline-rain-near-s1-light.png") : @image-url("wx/vline-rain-near-s1.png")) : (root.light-variant ? @image-url("wx-light/vline-rain-near-s0-light.png") : @image-url("wx/vline-rain-near-s0.png")))
        : k == 2 ? @image-url("wx/rain-near-s2.png") : k == 1 ? @image-url("wx/rain-near-s1.png") : @image-url("wx/rain-near-s0.png") }
    if root.far-a > 0.001 && root.slk < 0.999: Rectangle {
        for c in 4: Image {
            x: -24px + root.fx1 + Math.mod(c, 2) * 528px; y: root.fy1 + Math.floor(c / 2) * 528px;
            width: 528px; height: 528px; source: root.far-tex(root.sla); opacity: min(1, root.far-a * (1 + 0.3 * root.genv)) * (1 - root.slk);
        }
    }
    if root.far-a > 0.001 && root.slk > 0.001: Rectangle {
        for c in 4: Image {
            x: -24px + root.fx1 + Math.mod(c, 2) * 528px; y: root.fy1 + Math.floor(c / 2) * 528px;
            width: 528px; height: 528px; source: root.far-tex(root.slb); opacity: min(1, root.far-a * (1 + 0.3 * root.genv)) * root.slk;
        }
    }
    if root.near-a > 0.001 && root.slk < 0.999: Rectangle {
        for c in 4: Image {
            x: -24px + root.nx1 + Math.mod(c, 2) * 528px; y: root.ny1 + Math.floor(c / 2) * 528px;
            width: 528px; height: 528px; source: root.near-tex(root.sla); opacity: root.near-a * (1 - root.genv) * (1 - root.slk);
        }
    }
    if root.near-a > 0.001 && root.slk > 0.001: Rectangle {
        for c in 4: Image {
            x: -24px + root.nx1 + Math.mod(c, 2) * 528px; y: root.ny1 + Math.floor(c / 2) * 528px;
            width: 528px; height: 528px; source: root.near-tex(root.slb); opacity: root.near-a * (1 - root.genv) * root.slk;
        }
    }
    if root.near-a > 0.001 && root.genv > 0.01: Rectangle {
        for c in 4: Image {
            x: -24px + root.nx2 + Math.mod(c, 2) * 528px; y: root.ny1 + Math.floor(c / 2) * 528px;
            width: 528px; height: 528px; source: root.near-tex(root.sl2); opacity: min(1, root.near-a * 1.2) * root.genv;
        }
    }

    // 9. snow in three depths
    property <float> snow-k: root.snowing ? 1 : 0;
    animate snow-k { duration: 3s; easing: ease-in-out; }
    if root.snow-k > 0.001: Rectangle {
        opacity: root.snow-k;
        for i in 72: Image {
            property <int> c: Math.mod(i, 3);
            property <float> sp: self.c == 0 ? 16 : self.c == 1 ? 30 : 52;
            property <length> sz: root.theme == 7 ? (self.c == 0 ? 5px : self.c == 1 ? 8px : 14px) : self.c == 0 ? 4px : self.c == 1 ? 7px : 11px;
            x: (Math.mod(i * 97 + 14 * Math.sin((root.t * (0.4 + self.c * 0.2) + i) * 1rad), 528) - 24) * 1px;
            y: (Math.mod(i * 151 + root.t * self.sp, 560) - 30) * 1px;
            width: self.sz; height: self.sz;
            source: root.theme == 7 ? (self.c == 2 ? (root.light-variant ? @image-url("wx-light/vline-ast-light.png") : @image-url("wx/vline-ast.png")) : (root.light-variant ? @image-url("wx-light/vline-dot-light.png") : @image-url("wx/vline-dot.png"))) : @image-url("wx/flake.png");
            opacity: self.c == 0 ? 0.55 : self.c == 1 ? 0.75 : 0.9;
        }
    }

    // 10. lightning flash over everything
    if root.stormy && root.flash && root.pulse > 0: Rectangle { background: #dfe7ff; opacity: root.pulse * (root.theme == 7 ? 0.12 : 0.42); }

    // 11. drops on the glass: drawn by the app over the finished frame (they refract everything under them,
    //     text included): src/glass.rs, src/glass_gl.rs

    // 12. legibility for the white text: a photo's texture hides a soft dark glow, but on the flat
    //     drawn skies it shows as a dark spot, so they get about a third (light scenes a bit more);
    //     the dark line theme needs none. legi scales the halos (also the home widgets' own halos),
    //     scrim-k the top / bottom scrims.
    out property <float> legi: root.theme == 7 ? 0 : !root.vector ? 1 : root.light-scene ? 0.6 : 0.35;
    // the soft rim around the white letters (GlowText): everywhere except the dark line theme
    out property <float> glow-k: root.theme == 7 ? 0 : 1;
    // the light variants get no dark scrims (Ink text with a Paper rim, no dark patches)
    property <float> scrim-k: root.theme == 7 || root.light-variant ? 0 : root.vector ? 0.5 : 1;
    if root.light-scene && !root.light-variant: Rectangle { background: #0000001a; opacity: root.legi; }
    // 25.H2: a tap in a drawn scene: the city lights or darkens the window there, the country's trees shake, the flag
    // flutters harder for 2 s
    if root.taps && root.theme >= 3 && root.theme <= 6: TouchArea {
        clicked => {
            if root.theme == 4 || root.theme == 6 {
                root.flutter = true;
                Act.act("home.window", ((self.mouse-x - root.fx) / 1px) + ":" + ((self.mouse-y - root.fy) / 1px));
            } else {
                root.shake-t0 = animation-tick();
                root.shaking = true;
                root.flutter = true;
            }
        }
    }
    // (no dark discs behind the text: they showed as dark patches; the letters carry a soft rim)
    if root.scrim-k > 0: Rectangle { y: 0; height: 90px; opacity: root.scrim-k; background: @linear-gradient(180deg, #00000040 0%, #00000000 100%); }
    if root.scrim-k > 0: Rectangle { y: root.height - 230px; height: 230px; opacity: root.scrim-k; background: @linear-gradient(180deg, #00000000 0%, #00000059 100%); }
    @children
}
