// Living-photo weather background (mockup). Generated by gen_photo_sky.py.
import { Act, Clock } from "theme.slint";
struct Star { x: int, y: int, b: float }
export struct WinRect { x: float, y: float, w: float, h: float }

export component PhotoSky inherits Rectangle {
    in property <int> mood;              // see MOODS in gen_photo_sky.py
    in property <int> theme;             // photo: 0 nature, 1 countryside, 2 city; drawn: 3 countryside, 4 city, 5 neutral, 6 big city; 7 line
    in property <int> rain;              // 0 none (use the condition), 1 drizzle, 2 rain, 3 pouring
    in property <bool> drops: true;      // drops on the glass
    in property <bool> bolts: true;      // visible lightning bolts
    in property <bool> flash: true;      // lightning flash
    in property <float> dusk;            // 0..1 sunset light (crossfade)
    in property <float> dawn;            // 0..1 sunrise light (crossfade)
    in property <float> sky-loop;        // mockup only: >0 makes the sky drift loop seamlessly every N s (panel: 0)
    in property <float> time-offset;     // mockup only: continue the clock across render batches
    in property <float> wind;            // km/h: sky speed and rain slant
    in property <float> gust;            // km/h: gusts lean the rain further now and then
    in property <image> sky-frame;       // optional: the whole sky layer computed by the app per frame
    in property <bool> fixed-halo: true; // soft halos for the classic layout (the home page draws its own per widget)
    // The sun and the moon follow the real sky: azimuth and elevation in degrees (HA sun.sun; the
    // moon computed by the app). The scene looks south: east on the left, west on the right
    // (southern hemisphere: the app mirrors the azimuth). With real-sun the elevation also drives
    // the dawn / dusk light and the crossfade into the night scene; without it the fixed spots and
    // the dusk / dawn inputs are used.
    in property <bool> real-sun;
    in property <float> sun-az: 180;
    in property <float> sun-el: 40;
    in property <float> moon-az: 180;
    in property <float> moon-el: -30;
    in property <float> moon-phase: 0.5;  // 0 new, 0.25 first quarter, 0.5 full, 0.75 last quarter
    // 0..1: how much the sun / moon is behind a widget (computed by the app from the widget areas);
    // the disc and its glow fade there, so they never fight with the text
    in property <float> sun-veil;
    in property <float> moon-veil;
    property <bool> rust-sky: root.sky-frame.width > 0;
    property <float> t: (animation-tick() - Clock.base) / 1ms / 1000 + root.time-offset;
    clip: true;
    background: #000000;

    property <bool> stormy: root.mood == 8 || root.mood == 9;
    property <bool> clear-night: root.mood == 7;
    property <bool> snowing: root.mood == 4 || root.mood == 12;
    property <bool> misty: root.mood == 5 || root.mood == 13 || root.mood == 15;
    property <bool> night-any: root.mood == 7 || root.mood == 10 || root.mood == 11 || root.mood == 12 || root.mood == 16;
    property <bool> light-scene: root.theme != 7 && (root.mood == 2 || root.mood == 4 || root.mood == 5 || root.mood == 13 || root.mood == 15);
    property <int> rain-eff: root.rain > 0 ? root.rain
        : (root.mood == 3 || root.mood == 11) ? 2 : root.stormy ? 3 : 0;
    property <bool> has-grade: root.mood == 0 || root.mood == 1;
    // drawn and line themes in their light variant (the panel's light theme, or the page's own choice)
    in property <bool> light-variant;
    // city windows by the app (drawn city, big city): the unlit art with the lit windows on top
    in property <bool> taps;             // 25.H2: the home background answers taps (drawn themes)
    in property <bool> win-on;
    in property <image> win-base;
    in property <image> win-in;
    in property <WinRect> win-in-rect;
    in property <bool> win-in-show;
    in property <image> win-out;
    in property <WinRect> win-out-rect;
    in property <bool> win-out-show: true;
    property <float> win-in-k: root.win-in-show ? 1 : 0;
    animate win-in-k { duration: 900ms; easing: ease-in-out; }
    property <float> win-out-k: root.win-out-show ? 1 : 0;
    animate win-out-k { duration: 900ms; easing: ease-in-out; }
    property <bool> vector: root.theme >= 3;
    // The land's rows (528 px layer coordinates), the same in every picture of a theme (all conditions, night, light
    // and unlit variants, the columns on screen): its cut-out has content from `land-top` down and is opaque from
    // `land` down. What lies behind it is drawn only above `land`; the land itself from `land-top` down to where the
    // water's or the meadow's strips take over (they cover their rows whole, and opaque).
    property <int> land-top: root.theme == 0 ? 146 : root.theme == 1 ? 203 : root.theme == 2 ? 234 : root.theme == 3 ? 260
        : root.theme == 4 ? 201 : root.theme == 5 ? 202 : root.theme == 6 ? 128 : 300;
    property <int> land: root.theme == 0 ? 303 : root.theme == 1 ? 295 : root.theme == 2 ? 282 : root.theme == 3 ? 274
        : root.theme == 4 ? 279 : root.theme == 5 ? 287 : root.theme == 6 ? 370 : 360;
    property <int> land-bot: root.wa > 0 ? root.wy0 : root.sway-a > 0 ? root.sway-y0 : 528;

    // sun and moon on the screen (528 px layer coordinates): azimuth 2 px per degree around the
    // south (x 264); elevation from the theme's horizon (0 deg) up to y 60 (62 deg and above)
    property <float> hz: root.theme == 3 ? 271 : root.theme == 4 ? 277 : root.theme == 5 ? 273 : root.theme == 6 ? 258 : root.theme == 7 ? 352 : 300;
    pure function arc-x(az: float, el: float) -> float {
        264 + (az - 180) * 2 * Math.pow(Math.cos(max(0, min(89, el)) * 1deg), 1.2)
    }
    property <float> sun-px: root.real-sun ? root.arc-x(root.sun-az, root.sun-el) : root.mood == 13 ? 380 : 400;
    pure function arc-y(el: float) -> float {
        el >= 0 ? root.hz - (root.hz - 40) * Math.pow(min(1, el / 90), 0.6) : root.hz - el * (root.hz - 40) / 90 * 1.6
    }
    property <float> sun-py: root.real-sun ? root.arc-y(root.sun-el) : root.mood == 13 ? 205 : 120;
    property <float> moon-px: root.real-sun ? root.arc-x(root.moon-az, root.moon-el) : 395;
    property <float> moon-py: root.real-sun ? root.arc-y(root.moon-el) : 105;
    // low sun: warmer, bigger glow below 10 deg; the glow fades out once the disc is under the horizon
    property <float> low: root.real-sun ? max(0, min(1, (10 - root.sun-el) / 10)) : 0;
    property <float> sun-vis: root.real-sun ? max(0, min(1, (root.sun-el + 2.5) / 3.5)) : 1;
    property <float> sun-k: root.night-any ? 0 : root.mood == 0 || root.mood == 1 || root.mood == 6 || root.mood == 14 ? 1 : root.mood == 13 ? 0.7 : 0;
    // the moon: bright at night, pale by day (only when it is up and the sky is clear enough)
    property <float> moon-k: root.mood == 7 || root.mood == 16 ? 1 : !root.real-sun ? 0 : root.mood == 0 || root.mood == 1 || root.mood == 6 || root.mood == 14 ? 1 : root.mood == 13 ? 0.6 : 0;
    property <float> moon-a: root.moon-k * (root.night-any ? 1 : 0.32 + 0.68 * root.nmix) * (root.real-sun ? max(0, min(1, (root.moon-el + 2.5) / 3.5)) : 1);
    property <int> moon-fr: Math.mod(Math.round(root.moon-phase * 16), 16);
    // dawn / dusk light from the elevation (0 above 12 deg, full at the horizon), on the sun's side
    property <float> tws: max(0, min(1, (12 - root.sun-el) / 12));
    property <float> dk: root.real-sun ? (root.sun-az >= 180 ? root.tws : 0) : root.dusk;
    property <float> dn: root.real-sun ? (root.sun-az < 180 ? root.tws : 0) : root.dawn;
    // twilight: the night version of the scene fades in from 0 to -7 deg (same geometry, so a
    // plain crossfade); the app passes the day condition and lets the sun decide day or night
    property <float> nmix: root.real-sun && !root.night-any ? max(0, min(1, -root.sun-el / 7)) : 0;
    property <int> nmood: root.mood == 2 || root.mood == 5 || root.mood == 15 ? 10 : root.mood == 3 || root.mood == 8 || root.mood == 9 ? 11
        : root.mood == 4 ? 12 : root.mood == 14 ? 16 : 7;
    property <bool> clear-sky-night: root.clear-night || (root.vector && root.mood == 16);
    property <float> star-a: root.clear-sky-night ? 1 : root.nmood == 7 || (root.vector && root.nmood == 16) ? Math.pow(root.nmix, 1.5) : 0;
    property <float> night-k: root.night-any ? 1 : root.nmix;
    property <bool> dark-wx: root.mood == 2 || root.mood == 3 || root.mood == 4 || root.mood == 5 || root.mood == 8 || root.mood == 9 || root.mood == 15;
    // drawn themes: the cloud layer of the base light fades out while the dusk/dawn one fades in,
    // and both give way to the night clouds at twilight (cloud layers are transparent)
    property <float> gk: root.vector ? 1 - root.nmix : 1;
    property <float> base-a: (root.vector && root.has-grade ? max(0, 1 - root.dk - root.dn) : 1) * root.gk;
    // a picture at full opacity over the day pictures hides them where it is opaque (the backdrops and the photos' skies
    // everywhere, the land below its `land` row): the night pictures at night, the dusk or dawn ones in their full light
    property <bool> day-hidden: root.nmix >= 1 || (root.has-grade && (root.dk >= 1 || root.dn >= 1));

    // The landscape stays still (no pan): centre crop of the 528 px layers.
    property <length> sx: -24px;
    property <length> sy: -24px;
    property <length> fx: -24px;
    property <length> fy: -24px;
    // Sideways drift of the sky photo (its clouds move behind the trees and mountains).
    // Seamless 792 px tile (no mirroring); the speed follows the wind: one round takes 180 s when
    // calm, 66 s in a breeze, 33 s in strong wind; the night sky creeps (480 s).
    property <bool> strong-wind: root.wind >= 35 || root.mood == 6;
    property <float> drift: root.clear-night ? 1.65 : root.misty ? 1.2
        : root.strong-wind ? 9 : root.wind >= 15 ? 6.6 : root.stormy ? 5 : 4.4;

    // Phases that run at a speed the weather sets (sky drift, rain slant, flags, leaves in gusts) carry on
    // where they are when the speed changes: each counts from an anchor (its phase and the time then),
    // re-anchored on every change and every 10 minutes, so nothing jumps and the numbers stay small.
    property <bool> gust-on: root.gust > root.wind + 8;
    property <float> ph-t0;
    property <float> drift-p0;
    property <float> drift-v;
    property <float> fx-p0;
    property <float> nx-p0;
    property <float> nx2-p0;
    property <float> slv-v;
    property <float> slv2-v;
    property <float> flag-p0;
    property <float> flag-v;
    property <float> leaf-p0;
    property <bool> gon-v;
    // the gust envelope's integral up to x (one 3 s sine pulse every 11 s; one pulse = 6 / pi)
    pure function gint(x: float) -> float {
        Math.floor((x + 3) / 11) * 1.909859 + (Math.mod(x + 3, 11) < 3 ? 0.954930 * (1 - Math.cos(Math.mod(x + 3, 11) / 3 * 180deg)) : 1.909859)
    }
    function reanchor() {
        let e = root.t - root.ph-t0;
        root.drift-p0 = Math.mod(root.drift-p0 + e * root.drift-v, 792);
        root.fx-p0 = Math.mod(root.fx-p0 + e * 420 * root.slv-v, 528);
        root.nx-p0 = Math.mod(root.nx-p0 + e * 950 * root.slv-v, 528);
        root.nx2-p0 = Math.mod(root.nx2-p0 + e * 950 * root.slv2-v, 528);
        root.flag-p0 = Math.mod(root.flag-p0 + e * root.flag-v, 360);
        root.leaf-p0 = Math.mod(root.leaf-p0 + (root.gon-v ? 120 * (root.gint(root.t) - root.gint(root.ph-t0)) : 0), 640);
        root.ph-t0 = root.t;
        root.drift-v = root.drift;
        root.slv-v = root.slv;
        root.slv2-v = root.slv2;
        root.flag-v = (root.strong-wind ? 760 : 320) * (root.flutter ? 2.2 : 1);
        root.gon-v = root.gust-on;
    }
    init => { root.reanchor(); root.sla = root.sl; root.slb = root.sl; }
    changed drift => { root.reanchor(); }
    changed slv => { root.reanchor(); }
    changed slv2 => { root.reanchor(); }
    changed strong-wind => { root.reanchor(); }
    property <bool> flutter;
    changed flutter => { root.reanchor(); }
    Timer { interval: 2s; running: root.flutter; triggered => { root.flutter = false; } }
    // the trees' shake after a tap: a damped sway of their bend (600 ms)
    property <bool> shaking;
    property <duration> shake-t0;
    Timer { interval: 620ms; running: root.shaking; triggered => { root.shaking = false; } }
    property <length> shake: root.shaking ? 2.5px * Math.sin(360deg * 2.5 * (animation-tick() - root.shake-t0) / 1s) * (1 - (animation-tick() - root.shake-t0) / 600ms) : 0px;
    changed gust-on => { root.reanchor(); }
    Timer { interval: 600s; running: true; triggered => { root.reanchor(); } }
    property <float> ph-e: root.t - root.ph-t0;

    // Sub-pixel: drawn at floor(d) and once more one pixel further with opacity = fraction.
    property <float> dd: Math.mod(root.drift-p0 + root.ph-e * root.drift-v, 792);
    property <float> di: Math.floor(root.dd);
    property <float> df: root.dd - root.di;
    property <length> dx: -root.di * 1px;
    property <float> tl: root.t;   // used by the mist layers
    property <float> wb: 0;

    // Lightning timing: one strike every period, a double pulse.
    property <float> lp: root.mood == 9 ? 5.0 : 7.0;
    property <float> lt: Math.mod(root.t + 2.0, root.lp);
    property <int> lc: Math.floor((root.t + 2.0) / root.lp);
    property <float> pulse: !root.stormy ? 0
        : root.lt < 0.07 ? 1.0 : root.lt < 0.13 ? 0.25 : root.lt < 0.20 ? 0.85
        : root.lt < 0.60 ? 0.85 * (0.60 - root.lt) / 0.40 : 0;

    pure function sky(t: int, m: int) -> image { t == 0 ? (m == 0 ? @image-url("wx/nature-sunny-sky.jpg") : m == 1 ? @image-url("wx/nature-partly-cloudy-sky.jpg") : m == 2 ? @image-url("wx/nature-cloudy-sky.jpg") : m == 3 ? @image-url("wx/nature-rain-sky.jpg") : m == 4 ? @image-url("wx/nature-snow-sky.jpg") : m == 5 ? @image-url("wx/nature-fog-sky.jpg") : m == 6 ? @image-url("wx/nature-wind-sky.jpg") : m == 7 ? @image-url("wx/nature-clear-night-sky.jpg") : m == 8 ? @image-url("wx/nature-thunder-sky.jpg") : m == 9 ? @image-url("wx/nature-exceptional-sky.jpg") : m == 10 ? @image-url("wx/nature-cloudy-night-sky.jpg") : m == 11 ? @image-url("wx/nature-rainy-night-sky.jpg") : m == 12 ? @image-url("wx/nature-snowy-night-sky.jpg") : m == 13 ? @image-url("wx/nature-mist-sky.jpg") : m == 14 ? @image-url("wx/nature-winter-sunny-sky.jpg") : m == 15 ? @image-url("wx/nature-snow-sky.jpg") : m == 16 ? @image-url("wx/nature-snowy-night-sky.jpg") : @image-url("wx/nature-sunny-sky.jpg")) : t == 1 ? (m == 0 ? @image-url("wx/countryside-sunny-sky.jpg") : m == 1 ? @image-url("wx/countryside-partly-cloudy-sky.jpg") : m == 2 ? @image-url("wx/countryside-cloudy-sky.jpg") : m == 3 ? @image-url("wx/countryside-rain-sky.jpg") : m == 4 ? @image-url("wx/countryside-snow-sky.jpg") : m == 5 ? @image-url("wx/countryside-fog-sky.jpg") : m == 6 ? @image-url("wx/countryside-wind-sky.jpg") : m == 7 ? @image-url("wx/countryside-clear-night-sky.jpg") : m == 8 ? @image-url("wx/countryside-thunder-sky.jpg") : m == 9 ? @image-url("wx/countryside-exceptional-sky.jpg") : m == 10 ? @image-url("wx/countryside-cloudy-night-sky.jpg") : m == 11 ? @image-url("wx/countryside-rainy-night-sky.jpg") : m == 12 ? @image-url("wx/countryside-snowy-night-sky.jpg") : m == 13 ? @image-url("wx/countryside-mist-sky.jpg") : m == 14 ? @image-url("wx/countryside-winter-sunny-sky.jpg") : m == 15 ? @image-url("wx/countryside-snow-sky.jpg") : m == 16 ? @image-url("wx/countryside-snowy-night-sky.jpg") : @image-url("wx/countryside-sunny-sky.jpg")) : t == 2 ? (m == 0 ? @image-url("wx/city-sunny-sky.jpg") : m == 1 ? @image-url("wx/city-partly-cloudy-sky.jpg") : m == 2 ? @image-url("wx/city-cloudy-sky.jpg") : m == 3 ? @image-url("wx/city-rain-sky.jpg") : m == 4 ? @image-url("wx/city-snow-sky.jpg") : m == 5 ? @image-url("wx/city-fog-sky.jpg") : m == 6 ? @image-url("wx/city-wind-sky.jpg") : m == 7 ? @image-url("wx/city-clear-night-sky.jpg") : m == 8 ? @image-url("wx/city-thunder-sky.jpg") : m == 9 ? @image-url("wx/city-exceptional-sky.jpg") : m == 10 ? @image-url("wx/city-cloudy-night-sky.jpg") : m == 11 ? @image-url("wx/city-rainy-night-sky.jpg") : m == 12 ? @image-url("wx/city-snowy-night-sky.jpg") : m == 13 ? @image-url("wx/city-mist-sky.jpg") : m == 14 ? @image-url("wx/city-winter-sunny-sky.jpg") : m == 15 ? @image-url("wx/city-snow-sky.jpg") : m == 16 ? @image-url("wx/city-snowy-night-sky.jpg") : @image-url("wx/city-sunny-sky.jpg")) : t == 3 ? (m == 0 ? (root.light-variant ? @image-url("wx-light/vcountryside-sunny-clouds-light.png") : @image-url("wx/vcountryside-sunny-clouds.png")) : m == 1 ? (root.light-variant ? @image-url("wx-light/vcountryside-partly-cloudy-clouds-light.png") : @image-url("wx/vcountryside-partly-cloudy-clouds.png")) : m == 2 ? (root.light-variant ? @image-url("wx-light/vcountryside-cloudy-clouds-light.png") : @image-url("wx/vcountryside-cloudy-clouds.png")) : m == 3 ? (root.light-variant ? @image-url("wx-light/vcountryside-rain-clouds-light.png") : @image-url("wx/vcountryside-rain-clouds.png")) : m == 4 ? (root.light-variant ? @image-url("wx-light/vcountryside-snow-clouds-light.png") : @image-url("wx/vcountryside-snow-clouds.png")) : m == 5 ? (root.light-variant ? @image-url("wx-light/vcountryside-fog-clouds-light.png") : @image-url("wx/vcountryside-fog-clouds.png")) : m == 6 ? (root.light-variant ? @image-url("wx-light/vcountryside-wind-clouds-light.png") : @image-url("wx/vcountryside-wind-clouds.png")) : m == 7 ? (root.light-variant ? @image-url("wx-light/vcountryside-cle