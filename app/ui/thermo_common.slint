// The thermostat page's shared parts: the device and room rows the app fills in, the colours and glyphs of the modes,
// and the remote's segment digit (the page and its menus both draw them).

export struct ClimateDev {
    name: string,           // its name, as Home Assistant has it
    icon: string,           // air-conditioner / radiator glyph
    mode: int,              // index into modes
    modes: [int],           // 0 off, 1 heat, 2 cool, 3 auto (heat_cool), 4 dry, 5 fan only
    action: int,            // what it does right now, same codes: 0 nothing (off / idle), 1 heating, 2 cooling, 4 drying, 5 fan
    label: string,          // "Cooling to", "Heat · Idle", "Off" …
    target: float,
    show-target: bool,      // false: off / dry / fan only → the room's temperature is the big number
    current: float,
    humidity: float,        // < 0: unknown
    tmin: float,
    tmax: float,
    step: float,            // 1 or 0.5 (shows one decimal)
    fan: string,            // "" = the device has no such option
    swing: string,
    preset: string,         // "" = none / not supported; "Eco", "Boost", "Away"
    has-preset: bool,
    fans: [string],
    swings: [string],
    presets: [string],
    fan-level: int,         // 1 … 5 when the fan mode is a speed, else 0
    fan-i: int,             // the current one in fans / swings / presets (-1: none)
    swing-i: int,
    preset-i: int,
    fan-caps: [string],     // short capitals for the remote and the wall looks: AUTO, QUIET, 1 … / OFF, VERT … / OFF, ECO …
    swing-caps: [string],
    preset-caps: [string],
}

export struct ClimateRoom {
    name: string,
    temp: string,           // "21.3°"
    hum: string,            // "65 %" or ""
    outside: bool,
    temp-v: float,          // the temperature as a number (the remote's segment digits)
    hum-v: float,           // the humidity as a number, < 0: unknown
    dev: [string],          // device lines: "Heat 23° · heating", "Heat 20° · idle", "Off"
    dev-icon: [string],
    dev-mode: [int],        // each device's mode code (its colour)
    dev-busy: [bool],       // it works right now (heating, cooling, drying, fan)
    dev-caps: [string],     // short capitals for the remote's zone LCD: "HEAT 23", "IDLE 20", "OFF"
    dev-index: [int],       // which of the page's devices each line is (what a tap on it shows)
    sel: int,               // -1, or which of this room's devices is on the dial now
}

export global TK {
    // colours per mode / action: off, heat, cool, auto, dry, fan (neon: the synthwave look)
    out property <[color]> tints: [#8a8a92, #ff7a33, #3d9bff, #a76bff, #22c9a0, #9aa7c4];
    out property <[color]> neons: [#9a8cff, #ff6a3d, #22d8ff, #c27bff, #2bffc6, #aab8ff];
    out property <[string]> glyphs: ["\u{F0425}", "\u{F0238}", "\u{F0717}", "\u{F1B17}", "\u{F058E}", "\u{F0210}"];
    out property <[string]> caps: ["OFF", "HEAT", "COOL", "AUTO", "DRY", "FAN"];
    // the remote's mode icons (sun for heat, as remotes print it)
    out property <[string]> lcd-glyphs: ["\u{F0425}", "\u{F0599}", "\u{F0717}", "\u{F1B17}", "\u{F058C}", "\u{F0210}"];
    // the position of `s` in `items` (-1: not there); the option lists have at most a dozen steps
    public pure function index-of(items: [string], s: string) -> int {
        items.length > 0 && items[0] == s ? 0 : items.length > 1 && items[1] == s ? 1 : items.length > 2 && items[2] == s ? 2
            : items.length > 3 && items[3] == s ? 3 : items.length > 4 && items[4] == s ? 4 : items.length > 5 && items[5] == s ? 5
            : items.length > 6 && items[6] == s ? 6 : items.length > 7 && items[7] == s ? 7 : items.length > 8 && items[8] == s ? 8
            : items.length > 9 && items[9] == s ? 9 : items.length > 10 && items[10] == s ? 10 : items.length > 11 && items[11] == s ? 11 : -1
    }
    public pure function eo(u: float) -> float { 1 - Math.pow(1 - clamp(u, 0, 1), 3) }
    public pure function ei(u: float) -> float { Math.pow(clamp(u, 0, 1), 3) }
    public pure function num(v: float, step: float) -> string {
        step < 1 ? (Math.round(v * 10) / 10 == Math.round(v) ? Math.round(v) + ".0" : "" + Math.round(v * 10) / 10) : "" + Math.round(v)
    }
}


// one segment-display digit (viewbox 60 x 100, slanted); unlit segments stay faintly visible as on a real LCD
export component Seg7 inherits Rectangle {
    in property <int> v;            // 0 … 9; 10 "-", 11 blank, 12 "F"
    in property <color> ink;
    in property <color> ghost;
    in property <bool> lag: true;   // a segment comes on in 60 ms and goes off in 120 ms, like a real LCD (25.R2, T8)
    in property <int> mask: 127;    // the segments this cell has (6: a half digit "1", segments b and c)
    property <int> bits: [63, 6, 91, 79, 102, 109, 125, 7, 127, 111, 64, 0, 113][max(0, min(12, root.v))];
    for s[i] in ["M 19.8 8.0 L 25.2 3.0 L 46.4 3.0 L 51.0 8.0 L 45.6 13.0 L 24.4 13.0 Z", "M 52.2 9.4 L 56.8 14.4 L 54.5 43.6 L 49.1 48.6 L 44.5 43.6 L 46.8 14.4 Z", "M 48.9 51.4 L 53.5 56.4 L 51.2 85.6 L 45.8 90.6 L 41.2 85.6 L 43.5 56.4 Z", "M 13.0 92.0 L 18.4 87.0 L 39.6 87.0 L 44.2 92.0 L 38.8 97.0 L 17.6 97.0 Z", "M 14.9 51.4 L 19.5 56.4 L 17.2 85.6 L 11.8 90.6 L 7.2 85.6 L 9.5 56.4 Z", "M 18.2 9.4 L 22.8 14.4 L 20.5 43.6 L 15.1 48.6 L 10.5 43.6 L 12.8 14.4 Z", "M 16.4 50.0 L 21.8 45.0 L 43.0 45.0 L 47.6 50.0 L 42.2 55.0 L 21.0 55.0 Z"]: Path {
        visible: Math.mod(Math.floor(root.mask / Math.pow(2, i)), 2) == 1;
        x: 0; y: 0; width: root.width; height: root.height;
        viewbox-width: 60; viewbox-height: 100;
        property <bool> lit: Math.mod(Math.floor(root.bits / Math.pow(2, i)), 2) == 1;
        fill: self.lit ? root.ink : root.ghost;
        commands: s;
        states [
            lag-on when root.lag && self.lit: { fill: root.ink; in { animate fill { duration: 60ms; } } }
            lag-off when root.lag && !self.lit: { fill: root.ghost; in { animate fill { duration: 120ms; } } }
        ]
    }
}

