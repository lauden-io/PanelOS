                    show-seconds: root.clock-inst[slot.n].seconds;
                    wander-speed: root.clock-inst[slot.n].speed;
                    seconds: root.clock-sec;
                }
                if slot.kind == "music": MusicPage {
                    title: root.music-inst[slot.n].title; artist: root.music-inst[slot.n].artist; album: root.music-inst[slot.n].album;
                    playing: root.music-inst[slot.n].playing; pos: root.music-pos[slot.n]; dur: root.music-inst[slot.n].dur;
                    shuffle: root.music-inst[slot.n].shuffle; repeat: root.music-inst[slot.n].repeat; volume: root.music-inst[slot.n].volume;
                    player: root.music-inst[slot.n].player; art: root.music-inst[slot.n].art; art-bg: root.music-inst[slot.n].art-bg;
                    cs-cover: root.music-inst[slot.n].cs-cover; cover-blur: root.music-inst[slot.n].cover-blur; has-art: root.music-inst[slot.n].has-art;
                    kind-icon: root.music-kind-icon; accent: root.music-inst[slot.n].accent; record: root.music-inst[slot.n].record;
