    in property <image> home-fl-palm-l2: root.palms-l[root.palm-il + 1];
    in property <image> home-fl-palm-r2: root.palms-r[root.palm-ir + 1];
    in property <float> home-fl-palm-lk: root.palm-fl - root.palm-il;
    in property <float> home-fl-palm-rk: root.palm-fr - root.palm-ir;
