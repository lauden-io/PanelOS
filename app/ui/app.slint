    // (web-loading false fades it, web-overlay false removes it).
    in property <bool> web-loading: true;
    in property <bool> web-overlay: true;
    // The line under the loading screen's mark (two texts that cross-fade).
    in property <string> loading-line-a;
    in property <string> loading-line-b;
    in property <bool> loading-show-a: true;
    // Pull to refresh: how far the page is pulled down (0 none, 1 far enough to reload).
    in property <float> web-pull: 0;
    in property <image> loading-image;
    out property <bool> web-shown: root.paired && root.dashboard-mode && root.web-active;

    // ---- clock: the seconds move smoothly between the app's updates ----
    in-out property <float> sec-base;
    in-out property <duration> sec-tick;
    public function sync-seconds(s: float) {
        root.sec-base = s;
        root.sec-tick = animation-tick();
    }
    // At the minute the seconds hold at the very end until the app's new minute arrives (some ms later), so a
    // minute hand made of minute + seconds never flicks back; a sync later than 0.3 s lets them run on as before.
    property <float> sec-run: root.sec-base + (animation-tick() - root.sec-tick) / 1s;
    out property <float> clock-sec: root.sec-run < 60.3 ? Math.min(59.999, root.sec-run) : Math.mod(root.sec-run, 60);

    // ---- pager ----
    in property <[PageSlot]> pages;
    in-out property <int> page: 0;
    // Pages swiped away to the right, the screensaver, the voice view, the
    // settings and the status screens hide the dots.
    in property <bool> dots-hidden;
    in property <bool> screensaver-on;
    in property <string> app-version;
    in property <int> saver-style;
    // the screensaver clock's own settings (the integration's Display page)
    in property <color> saver-accent: Theme.accent;
    in property <int> saver-weight: 600;
    in property <float> saver-width: 1;
    in property <bool> saver-date: true;
    in property <bool> saver-weather: true;
    in property <bool> saver-next: true;
    in property <bool> saver-seconds: true;
    in property <float> saver-speed: 20;
    property <length> drag-x;
    out property <bool> dragging;
    // Endless: `pos` counts pages without wrapping (after the last page comes the first from the same side);
    // the page shown is pos modulo the count. A page set by the app (out of step with pos) is taken as it is.
    property <int> pos;
    pure function near(d: int) -> int {
        d * 2 > root.pages.length ? d - root.pages.length : d * 2 < -root.pages.length ? d + root.pages.length : d
    }
    property <int> base: root.pages.length > 0 ? root.pos + root.near(root.page - Math.mod(root.pos, root.pages.length)) : root.page;
    // where the picture was when the finger took it (the snap may still have been running)
    property <length> drag-start;
    property <length> drag-x0;
    property <length> offset: root.dragging ? root.drag-start + root.drag-x - root.drag-x0 : -root.base * root.width;
    property <float> pf: -root.offset / root.width;
    // set by the app for one frame when pages are renumbered (a temporary page leaves): no slide
    in-out property <bool> instant;
    animate offset { duration: root.dragging || root.instant ? 0ms : 260ms; easing: cubic-bezier(0.2, 0.8, 0.25, 1); }
    // The page that covers most of the screen now (status bar colour while swiping).
    property <int> shown-page: Math.mod(round(root.pf), max(1, root.pages.length));
    // the status bar's and the dots' light text mixed by how far the swipe is between two pages
    property <int> pg-a: Math.mod(Math.floor(root.pf), max(1, root.pages.length));
    property <int> pg-b: Math.mod(Math.floor(root.pf) + 1, max(1, root.pages.length));
    property <float> pg-f: root.pf - Math.floor(root.pf);
    property <float> on-k: root.pages.length == 0 ? 0
        : (root.on-color(root.pages[root.pg-a]) ? 1 : 0) * (1 - root.pg-f) + (root.on-color(root.pages[root.pg-b]) ? 1 : 0) * root.pg-f;
    out property <bool> swiping: root.dragging;
    // a temporary page comes or goes: the frame restarts at the page shown (same picture, no slide)
    public function reset-pos() {
        root.pos = root.page;
    }
    // the status line's right-hand side (the bell, the problem mark, the timers) moves to the left where the page
    // has its own chip at the top right, mixed by the swipe like the colours
    pure function chips-left(p: PageSlot) -> bool {
        p.kind == "music" || p.kind == "thermostat" || p.kind == "camera" || p.kind == "calendar" || p.kind == "todo"
    }
    property <float> left-k: root.screensaver-on || root.status-on || root.pages.length == 0 ? 0
        : (root.chips-left(root.pages[root.pg-a]) ? 1 : 0) * (1 - root.pg-f) + (root.chips-left(root.pages[root.pg-b]) ? 1 : 0) * root.pg-f;

    // ---- rain on the glass: the app draws the drops over the finished frame (src/glass.rs, src/glass_gl.rs) ----
    // the storm scenes' lightning, flashes and bolts (the panel's switch)
    in property <bool> lightning: true;
    // there are drops on the glass for a stroke to wipe
    in property <bool> glass-wet;
    // the pages with a photo background: the weather pages' photos and the weather details' living photo
    pure function glass-page(p: PageSlot) -> bool {
        p.kind == "home" ? (p.theme >= 0 ? p.theme : root.weather.theme) >= 0 && (p.theme >= 0 ? p.theme : root.weather.theme) <= 2
            : p.kind == "weather" && p.variant == 1 && root.weather.theme >= 0 && root.weather.theme <= 2
    }
    // nothing over the pages that the drops would lie on
    property <bool> glass-clear: !root.intro-visible && root.warm-page < 0 && root.paired && !root.connecting && root.offline-cause == 0
        && !root.setup && !root.setup-pick-open && !root.wifi-setup && !root.wifi-password-open && !root.hidden-open
        && !root.prox-test && !root.touch-test && !root.web-shown && !root.status-on && !root.timers-ringing && root.set-view == 0
        && !root.sheet-open && !root.home-editing && !root.home-lock;
    // how much of the screen shows a photo page with nothing over it (0..1): the drops show (and fade) with it
    out property <float> glass-k: !root.glass-clear || root.pages.length == 0 ? 0
        : ((root.glass-page(root.pages[root.pg-a]) ? 1 : 0) * (1 - root.pg-f) + (root.glass-page(root.pages[root.pg-b]) ? 1 : 0) * root.pg-f)
            * (1 - root.saver-k) * (1 - root.voice-k) * (1 - Math.clamp(root.shade-pos, 0, 1));
    // H1: a stroke up or down (or steeply slanted) on a wet glass wipes the drops along the finger
    property <bool> glass-wipe-ok: root.glass-wet && root.glass-k > 0.5 && !Act.hold-swipe;
    // the stroke under way: 0 not decided, 1 a page drag, 2 a wipe, 3 neither (a slanted stroke with one page)
    property <int> stroke;

    // Taps, holds and drags of every page and layer: what ("music.play",
    // "timers.cancel", ...) and a value ("", an id, a number as text).
    callback act(string, string);
    // The page shown after a swipe.
    callback page-changed(int);
    callback touch-test-event(int, float, float);  // 0 down, 1 move, 2 up; screen coordinates
    callback web-touch(int, float, float);  // 0 down, 1 move, 2 up; screen coordinates

    callback setup-pick(string);
    callback setup-key(string);
    callback setup-connect();
    callback setup-change-wifi();
    callback setup-choose-many();
    callback setup-pick-back();
    callback setup-back();
    callback wifi-back();
    callback wifi-pick(string);
    callback wifi-rescan();
    callback wifi-other();
    callback theme-mode-changed(int);
    callback wifi-password-back();
    callback wifi-password-key(string);
    callback wifi-password-toggle-show();
    callback hidden-focus-field(int);

    // a Custom page on a light scene (drawn, line or plain in light): dark status bar text
    pure function light-home(p: PageSlot) -> bool {
        (p.light == 1 || (p.light == 0 && !Theme.dark)) && (p.theme >= 0 ? p.theme : root.weather.theme) >= 3 && (p.theme >= 0 ? p.theme : root.weather.theme) != 8
    }
    pure function on-color(p: PageSlot) -> bool {
        ((p.kind == "home" || p.kind == "weather") && !root.light-home(p)) || (p.kind == "music" && !(p.variant == 1 && !Theme.dark)) || (p.kind == "timers" && (root.timers-ringing || (p.variant == 3 && root.timers-inst[p.n].mode == 1))) || (p.kind == "thermostat" && p.variant == 3) || (p.kind == "todo" && p.variant == 2) || (p.kind == "calendar" && p.variant == 1) || (p.kind == "info" && (root.info-critical || p.variant == 3)) || root.status-on || (p.kind == "quick" && p.variant > 0) || (p.kind == "camera" && ((root.cam-ring && p.n == root.cam-ring-n) || (root.cam-inst[p.n].view == 0 && root.cam-inst[p.n].items.length > 0 && root.cam-inst[p.n].items[root.cam-inst[p.n].sel].state == 0 && (root.cam-inst[p.n].fit == 0 || Theme.dark))))
    }

    // ---- the pages, side by side ----
    // A swipe down that starts on the status bar pulls the quick shade (the
    // pages are inside, so taps and sideways swipes still reach them).
    // the shade follows a pull down from the status bar (or from one of its marks)
    function shade-move(d: length) {
        if !root.shade-pulling {
            root.act("shade.peek", "");
            root.pull-t = animation-tick();
            root.pull-last = 0px;
            root.pull-v = 0;
        }
        root.shade-pulling = true;
        root.shade-pull = d;
        let dt = (animation-tick() - root.pull-t) / 1ms;
        if dt >= 16 {
            root.pull-v = root.pull-v * 0.4 + 0.6 * ((root.shade-pull - root.pull-last) / 1px) / dt;
            root.pull-last = root.shade-pull;
            root.pull-t = animation-tick();
        }
    }
    function shade-release(d: length) {
        let p = root.p-of-pull(d);
        root.shade-pulling = false;
        // past 1.5 straight to the second step; from 40 % (or a flick down) the first; else it closes
        root.p-go(p, p >= 1.5 ? 2 : (p >= 0.4 || root.pull-v > 0.5) ? 1 : 0);
    }
    shade-swipe := SwipeGestureHandler {
        // the timer island takes its own drags (29.4)
        handle-swipe-down: !root.screensaver-on && root.set-view == 0 && self.pressed-position.y < 56px && !root.home-editing && !root.home-lock
            && !(island.shown && self.pressed-position.y >= 44px && Math.abs(self.pressed-position.x / 1px - 240) < island.cap-w / 2px);
        moved => { root.shade-move(self.current-position.y - self.pressed-position.y); }
        swiped => { root.shade-release(self.current-position.y - self.pressed-position.y); }
        cancelled => { root.shade-pulling = false; root.p-go(root.p-of-pull(root.shade-pull), 0); }
    pager := Rectangle {
        clip: true;
        y: 4px * root.sink-k;
        opacity: 1 - 0.5 * root.sink-k;
        // fully covered by the saver or the wake distance calibration (it measures while nothing is drawn): not drawn
        visible: root.saver-k < 0.999 && !root.prox-cal-on;
        swipe := SwipeGestureHandler {
            // a drag that starts on a page's rotary control (Act.lock-*) never becomes a swipe or a wipe
            handle-swipe-left: root.pages.length > 1 && !Act.hold-swipe && !root.sheet-open && !Act.locked(self.pressed-position.x, self.pressed-position.y);
            handle-swipe-right: root.pages.length > 1 && !Act.hold-swipe && !root.sheet-open && !Act.locked(self.pressed-position.x, self.pressed-position.y);
            handle-swipe-up: root.glass-wipe-ok && !Act.locked(self.pressed-position.x, self.pressed-position.y);
            handle-swipe-down: root.glass-wipe-ok && !Act.locked(self.pressed-position.x, self.pressed-position.y);
            moved => {
                // the recogniser reports moves before it takes the swipe (and when it never does): the pages follow
                // only a recognised swipe, else a press that moved a little would leave them a few pixels off, still
                // dragging
                if !self.swiping {
                    return;
                }
                // on a wet glass the stroke is decided once it is recognised: steeper than 50° wipes, else it turns
                // the page (before that nothing moves)
                if root.glass-wipe-ok && root.stroke == 0 && self.swiping && !root.dragging {
                    root.stroke = Math.abs(self.current-position.y - self.pressed-position.y)
                        > 1.19 * Math.abs(self.current-position.x - self.pressed-position.x) ? 2 : root.pages.length > 1 ? 1 : 3;
                    if root.stroke == 2 {
                        root.act("glass.wipe", "\{self.pressed-position.x / 1px}:\{self.pressed-position.y / 1px}");
                    }
                }
                if root.stroke == 2 {
                    root.act("glass.wipe", "\{self.current-position.x / 1px}:\{self.current-position.y / 1px}");
                } else if root.stroke == 1 || (root.stroke == 0 && (!root.glass-wipe-ok || root.dragging)) {
                    if !root.dragging {
                        // a new swipe takes the picture where it is: the running snap stops under the finger, and the
                        // recogniser's start distance is not jumped over
                        root.drag-start = root.offset;
                        root.pos = root.base;
                        root.drag-x0 = self.current-position.x - self.pressed-position.x;
                    }
                    root.drag-x = self.current-position.x - self.pressed-position.x;
                    root.dragging = true;
                }
            }
            swiped => {
                if root.stroke == 2 {
                    root.stroke = 0;
                    root.act("glass.wipe-end", "");
                } else if root.stroke == 3 {
                    root.stroke = 0;
                } else {
                    root.stroke = 0;
                    let dx = self.current-position.x - self.pressed-position.x;
                    // the page it settles on: the next one in the swipe's direction past 22 % of a width, else the nearest
                    let rp = -(root.drag-start + dx - root.drag-x0) / root.width;
                    let target = dx < -root.width * 0.22 ? Math.ceil(rp - 0.05) : dx > root.width * 0.22 ? Math.floor(rp + 0.05) : Math.round(rp);
                    let before = root.page;
                    root.pos = target;
                    root.dragging = false;
                    root.drag-x = 0;
                    root.page = Math.mod(target, root.pages.length);
                    if root.page != before {
                        root.page-changed(root.page);
                    }
                }
            }
            cancelled => {
                if root.stroke == 2 {
                    root.stroke = 0;
                    root.act("glass.wipe-end", "");
                } else if root.stroke == 3 {
                    root.stroke = 0;
                } else {
                    root.stroke = 0;
                    let rp = -(root.drag-start + root.drag-x - root.drag-x0) / root.width;
                    root.pos = Math.round(rp);
                    root.dragging = false;
                    root.drag-x = 0;
                    root.page = Math.mod(root.pos, root.pages.length);
                }
            }
            for slot[i] in root.pages: home-slot := Rectangle {
                // warm-up: each page drawn once in view, under the page shown (start-up, a new page list)
                // each page at its copy nearest to the position shown (endless both ways)
                x: i == root.warm-page ? 0px : (i + root.pages.length * round((root.pf - i) / root.pages.length)) * root.width + root.offset;
                z: i == root.warm-page ? -1 : 0;
                width: root.width;
                height: root.height;
                // (a weather page's background covers the whole page, opaque)
                background: self.grid-page ? transparent : Theme.background;
                // a page's drawing stays on its page (the half cassette's reel slides past its edge)
                clip: true;
                // (partly) on screen: a page off screen stands still (its clocks' seconds do not run)
                property <bool> on-view: !root.screensaver-on && (i == root.warm-page || (self.x > -root.width && self.x < root.width));

                // several weather pages may each have their own background and widgets; the weather details page is such a
                // page too, with weather widgets only
                property <bool> grid-page: slot.kind == "home" || slot.kind == "weather";
                property <int> home-theme: slot.theme >= 0 ? slot.theme : root.weather.theme;
                // the light scene: drawn and line themes (and plain) follow the panel's theme, or the page's choice
                property <bool> home-light: slot.light == 1 || (slot.light == 0 && !Theme.dark);
                property <bool> light-scene: self.home-light && self.home-theme >= 3 && self.home-theme != 8;
                // clear night with the real sun: the clear day picture, the sun's elevation turns it to night
                // (no swap of the whole scene when the weather service says clear-night after sunset)
                property <int> mood-now: root.weather.real-sun && root.weather.mood == 7 ? 0 : root.weather.mood;
                property <int> mood-a;
                property <int> mood-b;
                property <bool> mood-on-b;
                init => { self.mood-a = self.mood-now; self.mood-b = self.mood-now; }
                changed mood-now => {
                    if self.mood-on-b { self.mood-a = self.mood-now; self.mood-on-b = false; } else { self.mood-b = self.mood-now; self.mood-on-b = true; }
                }
                property <float> mood-k: self.mood-on-b ? 1 : 0;
                animate mood-k { duration: 3s; easing: ease-in-out; }
                property <[HomeItem]> home-items: slot.layout >= 0 && slot.layout < root.home-layouts.length ? root.home-layouts[slot.layout].items
                    : slot.kind == "weather" ? root.weather-items : root.home-items;
                // the plain background: one colour, the panel's own ground (Night or Paper), the widgets in Ink on Paper
                if home-slot.grid-page && home-slot.home-theme == 9: Rectangle {
                    background: home-slot.home-light ? #F5F3EE : #000000;
                    HomeGrid {
                        live: home-slot.on-view;
                        rise: true; shown: root.page == i && !root.screensaver-on;
                        items: home-slot.home-items;
                        weather-only: slot.kind == "weather";
                        data: root.weather;
                        clock: root.clock;
                        event: root.home-inst[slot.n].event;
                        music: root.home-inst[slot.n].music;
                        seconds: root.clock-sec;
                        music-pos: root.home-music-pos[slot.n];
                        weekday-long: root.home-weekday;
                        day-month: root.home-day-month;
                        accent: root.clock-accent;
                        halo: 0;
                        ink: home-slot.home-light ? #101114 : #ffffff;
                        year: root.home-year;
                        week: root.home-week;
                        editing: root.home-editing && root.page == i;
                        ha-mode: root.home-ha;
                        selected: root.home-selected;
                        picker-scroll: root.home-picker-scroll;
                        lock: root.home-lock && root.page == i;
                        lock-p: root.home-lock-p;
                        lock-title: root.home-lock-title;
                        lock-sub: root.home-lock-sub;
                        settings: root.home-settings;
                        info: root.home-info;
                        lifted: root.home-lifted;
                        lift-dx: root.home-lift-dx;
                        lift-dy: root.home-lift-dy;
                        drop-col: root.home-drop-col;
                        drop-row: root.home-drop-row;
                        picker: root.home-picker;
                        place: root.home-place; free: root.home-free; layer-back: root.home-layer-back; layer-fwd: root.home-layer-fwd;
                        neon-on: root.home-neon-on; sensors: root.home-sensors; sensor-demo: root.home-sensor-demo;
                        sensor-names: root.home-sensor-names; sensor-sel: root.home-sensor-sel; timers: root.timers; people: root.home-people;
                        person-names: root.home-person-names; person-on: root.home-person-on;
                    }
                }
                // the weather picture changes softly: on a new condition the new picture fades in over the old one,
                // or the old one fades out over the new one (3 s); the widgets lie over both, drawn once
                if home-slot.grid-page && home-slot.home-theme != 8 && home-slot.home-theme != 9 && home-slot.mood-k < 0.999: PhotoSky {
                    taps: home-slot.mood-k <= 0.001;
                    bolts: root.lightning;
                    flash: root.lightning;
                    mood: home-slot.mood-a;
                    theme: home-slot.home-theme;
                    light-variant: home-slot.light-scene;
                    win-on: root.win-on && (home-slot.home-theme == 4 || home-slot.home-theme == 6);
                    win-base: root.win-base; win-in: root.win-in; win-in-rect: root.win-in-rect; win-in-show: root.win-in-show;
                    win-out: root.win-out; win-out-rect: root.win-out-rect; win-out-show: root.win-out-show;
                    rain: root.weather.rain;
                    dusk: root.weather.dusk;
                    dawn: root.weather.dawn;
                    sky-loop: root.weather.sky-loop;
                    time-offset: root.weather.time-offset;
                    wind: root.weather.wind-kmh;
                    gust: root.weather.gust-kmh;
                    sky-frame: root.weather-sky-frame;
                    fixed-halo: false;
                    real-sun: root.weather.real-sun;
                    sun-az: root.weather.sun-az;
                    sun-el: root.weather.sun-el;
                    moon-az: root.weather.moon-az;
                    moon-el: root.weather.moon-el;
                    // Home Assistant moves the sun every few minutes: each step glides over 3 s (disc, light, night)
                    animate sun-az, sun-el, moon-az, moon-el { duration: 3s; easing: ease-in-out; }
                    moon-phase: root.weather.moon-phase;
                    sun-veil: root.weather.sun-veil;
                    moon-veil: root.weather.moon-veil;
                }
                if home-slot.grid-page && home-slot.home-theme != 8 && home-slot.home-theme != 9 && home-slot.mood-k > 0.001: PhotoSky {
                    taps: true;
                    bolts: root.lightning;
                    flash: root.lightning;
                    mood: home-slot.mood-b;
                    opacity: home-slot.mood-k;
                    theme: home-slot.home-theme;
                    light-variant: home-slot.light-scene;
                    win-on: root.win-on && (home-slot.home-theme == 4 || home-slot.home-theme == 6);
                    win-base: root.win-base; win-in: root.win-in; win-in-rect: root.win-in-rect; win-in-show: root.win-in-show;
                    win-out: root.win-out; win-out-rect: root.win-out-rect; win-out-show: root.win-out-show;
                    rain: root.weather.rain;
                    dusk: root.weather.dusk;
                    dawn: root.weather.dawn;
                    sky-loop: root.weather.sky-loop;
                    time-offset: root.weather.time-offset;
                    wind: root.weather.wind-kmh;
                    gust: root.weather.gust-kmh;
                    sky-frame: root.weather-sky-frame;
                    fixed-halo: false;
                    real-sun: root.weather.real-sun;
                    sun-az: root.weather.sun-az;
                    sun-el: root.weather.sun-el;
                    moon-az: root.weather.moon-az;
                    moon-el: root.weather.moon-el;
                    // Home Assistant moves the sun every few minutes: each step glides over 3 s (disc, light, night)
                    animate sun-az, sun-el, moon-az, moon-el { duration: 3s; easing: ease-in-out; }
                    moon-phase: root.weather.moon-phase;
                    sun-veil: root.weather.sun-veil;
                    moon-veil: root.weather.moon-veil;
                }
                // 25.H3: after the screensaver the line drawing draws itself once, left to right (1.2 s): the page's ground
                // drawn back from the left over the scene, with a soft leading edge
                property <bool> saver: root.screensaver-on;
                property <bool> line-drawing;
                property <duration> line-t0;
                changed saver => { if !self.saver && self.grid-page && self.home-theme == 7 && root.page == i { self.line-t0 = animation-tick(); self.line-drawing = true; } }
                Timer { interval: 1250ms; running: home-slot.line-drawing; triggered => { home-slot.line-drawing = false; } }
                property <float> line-k: self.line-drawing ? clamp((animation-tick() - self.line-t0) / 1200ms, 0, 1) : 1;
                if home-slot.grid-page && home-slot.home-theme == 7 && home-slot.line-drawing: Rectangle {
                    x: (root.width + 24px) * home-slot.line-k - 24px; width: root.width + 24px; height: root.height;
                    Rectangle { x: 0; width: 24px; background: @linear-gradient(90deg, Theme.background.with-alpha(0) 0%, Theme.background 100%); }
                    Rectangle { x: 24px; width: root.width; background: Theme.background; }
                }
                if home-slot.grid-page && home-slot.home-theme != 8 && home-slot.home-theme != 9: Rectangle {
                    HomeGrid {
                        live: home-slot.on-view;
                        items: home-slot.home-items;
                        weather-only: slot.kind == "weather";
                        data: root.weather;
                        clock: root.clock;
                        event: root.home-inst[slot.n].event;
                        music: root.home-inst[slot.n].music;
                        seconds: root.clock-sec;
                        music-pos: root.home-music-pos[slot.n];
                        weekday-long: root.home-weekday;
                        day-month: root.home-day-month;
                        accent: root.clock-accent;
                        halo: home-slot.home-theme == 7 ? 0 : 1;
                        ink: home-slot.light-scene ? #101114 : #ffffff;
                        year: root.home-year;
                        week: root.home-week;
                        editing: root.home-editing && root.page == i;
                        ha-mode: root.home-ha;
                        selected: root.home-selected;
                        picker-scroll: root.home-picker-scroll;
                        lock: root.home-lock && root.page == i;
                        lock-p: root.home-lock-p;
                        lock-title: root.home-lock-title;
                        lock-sub: root.home-lock-sub;
                        settings: root.home-settings;
                        info: root.home-info;
                        lifted: root.home-lifted;
                        lift-dx: root.home-lift-dx;
                        lift-dy: root.home-lift-dy;
                        drop-col: root.home-drop-col;
                        drop-row: root.home-drop-row;
                        picker: root.home-picker;
                        place: root.home-place; free: root.home-free; layer-back: root.home-layer-back; layer-fwd: root.home-layer-fwd;
                        neon-on: root.home-neon-on; sensors: root.home-sensors; sensor-demo: root.home-sensor-demo;
                        sensor-names: root.home-sensor-names; sensor-sel: root.home-sensor-sel; timers: root.timers; people: root.home-people;
                        person-names: root.home-person-names; person-on: root.home-person-on;
                    }
                }
                if home-slot.grid-page && home-slot.home-theme == 8: FastLane {
                    scene: root.home-fl-scene; back-a: root.home-fl-back-a; floor-a: root.home-fl-floor-a; back-b: root.home-fl-back-b; floor-b: root.home-fl-floor-b;
                    back-c: root.home-fl-back-c; floor-c: root.home-fl-floor-c; mix-c: root.home-fl-mix-c;
                    mix: root.home-fl-mix; grid: root.home-fl-grid; star-k: root.home-fl-star; t: root.home-fl-t; cars: root.home-fl-cars-on ? root.home-fl-cars : [];
                    palm-l: root.home-fl-palm-l; palm-r: root.home-fl-palm-r; palm-l2: root.home-fl-palm-l2; palm-r2: root.home-fl-palm-r2; palm-lk: root.home-fl-palm-lk; palm-rk: root.home-fl-palm-rk;
                    HomeGrid {
                        live: home-slot.on-view;
                        items: home-slot.home-items;
                        weather-only: slot.kind == "weather";
                        data: root.weather;
                        clock: root.clock;
                        event: root.home-inst[slot.n].event;
                        music: root.home-inst[slot.n].music;
                        seconds: root.clock-sec;
                        music-pos: root.home-music-pos[slot.n];
                        weekday-long: root.home-weekday;
                        day-month: root.home-day-month;
                        halo: 1;
                        neon: root.home-fl-neon; glow: root.home-fl-grid;
                        fast-lane: true; bg-sheet: root.home-bg-sheet; fl-scene: root.home-fl-scene; fl-cars: root.home-fl-cars-on;
                        accent: root.home-fl-grid;
                        year: root.home-year;
                        week: root.home-week;
                        editing: root.home-editing && root.page == i;
                        ha-mode: root.home-ha;
                        selected: root.home-selected;
                        picker-scroll: root.home-picker-scroll;
                        lock: root.home-lock && root.page == i;
                        lock-p: root.home-lock-p;
                        lock-title: root.home-lock-title;
                        lock-sub: root.home-lock-sub;
                        settings: root.home-settings;
                        info: root.home-info;
                        lifted: root.home-lifted;
                        lift-dx: root.home-lift-dx;
                        lift-dy: root.home-lift-dy;
                        drop-col: root.home-drop-col;
                        drop-row: root.home-drop-row;
                        picker: root.home-picker;
                        place: root.home-place; free: root.home-free; layer-back: root.home-layer-back; layer-fwd: root.home-layer-fwd;
                        neon-on: root.home-neon-on; sensors: root.home-sensors; sensor-demo: root.home-sensor-demo;
                        sensor-names: root.home-sensor-names; sensor-sel: root.home-sensor-sel; timers: root.timers; people: root.home-people;
                        person-names: root.home-person-names; person-on: root.home-person-on;
                    }
                }
                if slot.kind == "clock": ClockFace {
                    data: root.clock;
                    live: home-slot.on-view;
                    style: slot.variant;
                    accent: root.clock-inst[slot.n].own-accent ? root.clock-inst[slot.n].accent : root.clock-accent;
                    weight: root.clock-inst[slot.n].weight;
                    width-k: root.clock-inst[slot.n].width;
