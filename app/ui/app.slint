// The panel's UI: the pages of the assistant view side by side in a pager
// (swiped with the finger), the status bar and the page dots over them, the
// layers above (voice, status strip, settings) and the system screens (setup,
// Wi-Fi, pairing, connecting, offline). Every page's look and data come from
// the properties below, set by the app; taps and drags come back through
// `act(what, value)`.

import "./fonts/NotoSans[wdth,wght].ttf";
import "./fonts/SpaceGrotesk[wght].ttf";
import "./fonts/materialdesignicons-webfont.ttf";
import "./fonts/DejaVuSansMono.ttf";
import "./fonts/DejaVuSansMono-Bold.ttf";
import "./fonts/Caveat[wght].ttf";
// the looks' menus (record sleeve, J-card, arcade screen)
import "./fonts/PressStart2P-Regular.ttf";
import "./fonts/Oswald[wght].ttf";
import "./fonts/CourierPrime-Regular.ttf";
import "./fonts/CourierPrime-Bold.ttf";

import { Theme, Act, Clock, Words } from "theme.slint";
import { Jelly, PageMenu, TextButton } from "widgets.slint";
import { ChildLockLayer, ProxCalLayer } from "device_layers.slint";
import { PairingScreen, FoundHa, SetupScreen, WifiNet, WifiScreen, WifiPasswordScreen, HiddenNetworkScreen, HaPickScreen, ConnectingScreen, OfflineScreen, Phrases } from "overlays.slint";
import { Person, TimerInfo, ClockData, ClockFace, StatusBar, TimerIsland, PageDots, People, WeatherHour, WeatherDay, WeatherData } from "panels.slint";
import { HomeItem, HomeEvent, HomeMusic, HomeSensor, HomeGrid, WxIcons } from "home.slint";
import { PhotoSky, WinRect } from "photo_sky.slint";
import { FastLane } from "fast_lane.slint";
import { MusicPlayer, MusicPage } from "music.slint";
import { TimerItem, AlarmItem, SwCar, TimersPage } from "timers.slint";
import { ClimateDev, ClimateRoom, ThermostatPage } from "thermostat.slint";
import { CamItem, CamAction, CameraPage } from "camera.slint";
import { TodoItem, TodoList, TodoPage } from "todo.slint";
import { CalEvent, CalDay, CalCell, CalBoard, WallCell, CalItem, CalendarPage } from "calendar.slint";
import { InfoNote, InfoStatus, InfoPage } from "info.slint";
import { NotifWindow } from "notify_window.slint";
import { StatusScreen, StatusPage, TopStrip } from "status.slint";
import { VoicePage } from "voice.slint";
import { QuickTile, QuickGroup, QuickDetails, QuickPage } from "quick.slint";
import { SetRow, SetBar, SetSeg, SetSection, SettingsLayer } from "settings.slint";
import { WebLoading, PullToRefresh } from "loading.slint";
import { AlarmNow } from "clocks.slint";

export { WxIcons }
export { PeoplePics } from "home.slint";
export { Theme, Act, Clock, Words, Phrases, FoundHa, WifiNet, Person, TimerInfo, ClockData, WeatherHour, WeatherDay, WeatherData }
export { HomeItem, HomeEvent, HomeMusic, HomeSensor, MusicPlayer, TimerItem, AlarmItem, SwCar, ClimateDev, ClimateRoom, CamItem, CamAction }
export { TodoItem, TodoList, CalEvent, CalDay, CalCell, CalBoard, WallCell, InfoNote, InfoStatus, StatusScreen, QuickTile, QuickGroup }
export { SetRow, SetBar, SetSeg, SetSection, WinRect }

// One page of the pager: which kind, and the variant / look where a kind has several.
export struct PageSlot {
    kind: string,
    variant: int,
    // a weather (home) page's own background (-1: the panel's) and widget layout (-1: the panel's)
    theme: int,
    layout: int,
    // drawn, line and plain backgrounds: 0 the panel's setting, 1 light, 2 dark
    light: int,
    // which page of its kind (0 the first): the row of the kind's per-page data (quick-inst, todo-inst …)
    n: int,
    // its place in the integration's page list (-1: not on it, a temporary page)
    cfg: int,
}

// the widgets of one more weather page
export struct HomeLayout {
    items: [HomeItem],
}

// One notifications page's own data: the pager's finish (0 graphite, 1 purple, 2 clear, 3 off-white) and its body
export struct InfoInst {
    finish: int,
    pager-body: image,
}

// One clock page's own options (the integration's page options)
export struct ClockInst {
    own-accent: bool,
    accent: color,
    weight: int,
    width: float,
    date: bool,
    weather: bool,
    next: bool,
    seconds: bool,
    speed: float,
}

// One timers page's own data: the tab shown, its functions, the stopwatch's and the alarms' looks, its colours and its
// synthwave scene (the timers themselves are the panel's, here in this page's colours)
export struct TimersInst {
    // set once the row has its first tab (a new page opens on the timers)
    ready: bool,
    list: [TimerItem],
    mode: int,
    colourful: bool,
    alarm-on: bool,
    timer-on: bool,
    watch-on: bool,
    sw-look: int,
    alarm-look: int,
    sw-choice: int,
    sw-scene: int,
    sw-back: image,
    sw-floor: image,
}

// One music page's own data: its player's track, cover and colours, and its options
export struct MusicInst {
    title: string,
    artist: string,
    album: string,
    playing: bool,
    dur: float,
    shuffle: bool,
    repeat: int,
    volume: float,
    player: string,
    record: color,
    has-record: bool,
    art: image,
    art-bg: image,
    has-art: bool,
    accent: color,
    cs-cover: bool,
    cover-blur: bool,
    holds: int,
    scroll: bool,
    scroll-speed: float,
    wood: int,
    tt-deck: image,
    cs-back: image,
    cs-front: image,
    cs-hub: image,
}

// One custom page's own widget data: the music widget (the page's player) and the next event (the page's calendars)
export struct HomeInst {
    music: HomeMusic,
    event: HomeEvent,
}

// One calendar page's own data: its view (the plain look's) and its calendars' events in every view and look
export struct CalInst {
    view: int,
    title: string,
    sub: string,
    chip: string,
    agenda: [CalDay],
    day-events: [CalEvent],
    day-allday: [CalEvent],
    day-today: bool,
    day-free: string,
    week-names: [string],
    week-nums: [int],
    week-today: int,
    week-events: [CalEvent],
    week-allday: [CalEvent],
    month-cells: [CalCell],
    board-rows: [CalBoard],
    tear-events: [CalEvent],
    tear-more: string,
    wall-cells: [WallCell],
    cals: [CalItem],
}

// One to-do page's own data
export struct TodoInst {
    lists: [TodoList],
    sel: int,
    open-items: [TodoItem],
    leaving: int,
    done-items: [TodoItem],
    show-done: bool,
    label-head: image,
    label-done-head: image,
    label-empty-tape: image,
    note-head: image,
    note-done: image,
}

// One cameras page's own data
export struct CamInst {
    items: [CamItem],
    sel: int,
    view: int,
    fit: int,
    bg: image,
    bg-corners: [color],
}

// One thermostat page's own data
export struct ThermoInst {
    devices: [ClimateDev],
    sel: int,
    rooms: [ClimateRoom],
}

// One quick controls page's own data (a page of the kind each: PageSlot.n)
export struct QuickInst {
    tiles: [QuickTile],
    title: string,
    mood: string,
    groups: [QuickGroup],
    deck-panel: image,
}

export component AppWindow inherits Window {
    width: 480px;
    height: 480px;
    background: #000000;
    default-font-family: "Noto Sans";

    in property <string> time: "--:--";
    in property <string> date: "";
    in property <string> long-date: "";
    in property <bool> paired: false;
    in property <image> qr;
    in property <string> pair-hint: "";
    in property <string> pair-url: "";
    in property <string> pair-ha-url: "";      // Home Assistant the code logs in to
    in property <int> pair-state: 0;           // 0 waiting, 1 logged in, 2 failed
    in property <int> pair-variant: 0;         // random, picked when the screen opens
    // First connection to Home Assistant (after pairing / late data)
    in property <bool> connecting: false;
    in property <bool> connect-slow: false;
    in property <float> connect-progress: 0;
    in property <int> connect-step: 0;
    in property <int> connect-variant: 0;
    // Nothing to connect to yet: 1 no network, 2 Home Assistant not answering
    in property <int> offline-cause: 0;
    in property <float> offline-retry-start: 0;
    in property <float> offline-retry-total: 0;
    in property <int> offline-variant: 0;
    // Assistant mode panels (new design)
    in property <int> panel-variant: 0;
    in property <ClockData> clock;
    in property <WeatherData> weather;
    // home page: widgets on the living weather background
    in property <[HomeItem]> home-items;
    in property <[HomeLayout]> home-layouts;
    // a weather details page without widgets of its own: the weather widgets it shows (weather now, details, hours, days)
    in property <[HomeItem]> weather-items;
    // thermostat panel: the climate devices, the one on the dial, the rooms (device picker), the options sheet
    // each thermostat page's own devices, the one shown and the rooms
    in property <[ThermoInst]> thermo-inst;
    in property <bool> thermo-picker;
    in property <bool> thermo-sheet;
    in property <bool> thermo-settings;
    in property <float> thermo-pulse: 1;
    in property <int> thermo-key-down: -1;
    in property <bool> thermo-fahrenheit;
    in property <int> thermo-clock-h;
    in property <int> thermo-clock-m;
    // camera panel: the cameras, the one shown, one / all, whole picture / fill, the blurred copy, linked entities;
    // the visitor overlay (doorbell)
    // each cameras page's own cameras, the one shown, one / all, the picture's fit and its blurred copy
    in property <[CamInst]> cam-inst;
    in property <[CamAction]> cam-actions;
    in property <bool> cam-settings;
    in property <length> cam-grid-scroll;
    in property <bool> cam-ring;
    in property <int> cam-ring-n;              // the cameras page whose doorbell rang (PageSlot.n)
    in property <image> cam-ring-frame;
    in property <image> cam-ring-bg;
    in property <string> cam-ring-title;
    in property <string> cam-ring-sub;
    in property <[CamAction]> cam-ring-state;
    in property <bool> cam-can-open;
    in property <bool> cam-can-talk;
    in property <float> cam-hold;
    // breathing ring round the visitor's picture (only computed while it shows)
    in property <float> cam-pulse: 0.5 + 0.5 * Math.sin((animation-tick() - Clock.base) / 1600ms * 360deg);
    in property <bool> cam-replies;
    in property <[string]> cam-reply-list;
    // each notifications page's own pager finish and the pager's body in it
    in property <[InfoInst]> info-inst;
    in property <[InfoNote]> info-notes;
    // the active status screens and the critical alert, listed above the notifications in every look
    in property <[InfoStatus]> info-statuses;
    in property <length> info-scroll;
    in property <string> info-empty-title;
    in property <string> info-empty-sub;
    in property <bool> info-card;
    // a new notification as a card above any page (the panel's "card" setting for new notifications)
    in property <bool> pop-on;
    in property <InfoNote> pop-note;
    in property <[InfoNote]> pop-notes;        // the window's notifications (several: "i of n")
    in property <int> pop-index;
    in property <int> pop-count;
    in property <int> pop-look;                // the notifications page's look: 0 plain, 1 fridge, 2 pager, 3 TV news
    in property <bool> pop-until;              // until answered
    in property <float> pop-seconds: 10;
    in property <image> pop-pager;             // the pager device for the window (375 × 320)
    in property <InfoNote> info-card-note;
    in property <int> info-card-index;
    in property <int> info-card-count;
    in property <bool> info-critical;
    in property <string> info-crit-title;
    in property <string> info-crit-message;
    in property <string> info-crit-icon;
    in property <string> info-crit-source;
    in property <float> info-crit-hold;
    // breathing (2 s), only computed while a critical alert shows
    in property <float> info-crit-pulse: 0.5 + 0.5 * Math.sin((animation-tick() - Clock.base) / 2000ms * 360deg);
    in property <bool> info-settings;
    in property <int> info-minute: -1;       // the clock (minutes of the day) for the pager and the TV news
    in property <string> info-pager-empty;
    in property <string> info-news-ticker;
    in property <int> info-news-epoch;
    in property <string> info-news-empty;
    in property <image> info-fridge-door;
    in property <image> info-fridge-empty;
    in property <image> info-pager-led;
    in property <int> info-pager-first;
    in property <bool> info-crit-button: true;
    // each quick controls page's own tiles, title, line under them, group frames and the deck's plate
    in property <[QuickInst]> quick-inst;
    in property <string> quick-placard;
    in-out property <bool> quick-sheet;
    in-out property <bool> quick-settings;
    in property <QuickTile> quick-sheet-tile;
    in property <int> quick-sheet-index;
    in property <QuickDetails> quick-details; in property <image> quick-settings-tape;
    in property <image> quick-mixer-panel; in property <image> quick-fader;
    in property <[image]> quick-lever-frames;
    in property <image> quick-toggle-up; in property <image> quick-toggle-down; in property <image> quick-lamp-on;
    in property <image> quick-lamp-amber; in property <image> quick-lamp-off; in property <image> quick-screw;
    in property <image> quick-lamp-glow; in property <image> quick-lamp-spec; in property <int> quick-grid;
    in property <[color]> quick-sheet-colours;
    in property <[string]> quick-sheet-effects;
    // status screens (whole screen, above any panel) and the strip on top while one (or a critical alert) is active
    in property <bool> status-on;
    in property <StatusScreen> status-screen;
    in property <float> conn-morse-t;
    in property <int> set-view;
    in property <bool> set-auto;               // the shade's Auto box: the light sensor sets the brightness
    in property <string> set-shade-title; in property <float> set-brightness; in property <float> set-volume; in property <bool> set-mic-on: true;
    in property <string> set-mic-state; in property <string> set-theme-state; in property <bool> set-dnd; in property <string> set-dnd-state;
    in property <string> set-sleep-state; in property <string> set-lock-title; in property <float> set-hold; in property <string> set-title;
    in property <[SetRow]> set-rows; in property <string> set-tagline; in property <string> set-page-title; in property <string> set-page-sub;
    in property <float> set-used; in property <string> set-used-text; in property <[SetBar]> set-bars; in property <[SetSection]> set-sections; in property <string> set-confirm-title;
    in property <string> set-confirm-line;
    // the settings pages (display, voice, about)
    in property <[string]> set-saver-options; in property <int> set-saver-index; in property <int> set-saver-style;
    in property <[string]> set-wake-options; in property <int> set-wake1: -1; in property <[string]> set-wake-options2; in property <int> set-wake2;
    in property <[SetRow]> set-about-rows; in property <[SetRow]> set-about-links; in property <int> set-about-link; in property <image> set-about-qr;
    in property <bool> voice-on;
    in property <int> voice-look;
    in property <int> voice-state: 1;
    in property <string> voice-assistant;
    in property <string> voice-heard;
    in property <string> voice-answer;
    in property <string> voice-line;
    in property <string> voice-detail;
    in property <float> voice-level;
    in property <float> voice-left: -1;
    in property <string> voice-wave;
    in property <string> voice-wave1;          // the oscilloscope's afterglow: the three traces before
    in property <string> voice-wave2;
    in property <string> voice-wave3;
    in property <int> voice-peaks;             // counts the voice peaks
    in property <string> voice-typed;          // the answer as far as it has come
    in property <image> voice-scan;
    in property <image> voice-dots;
    in property <bool> strip-on;
    in property <string> strip-title;
    in property <string> strip-sub;
    in property <string> strip-icon;
    in property <image> strip-picto;
    in property <bool> strip-has-picto;
    in property <color> strip-tint;
    in property <bool> strip-critical;
    in property <float> strip-pulse: 0.5 + 0.5 * Math.sin((animation-tick() - Clock.base) / 2000ms * 360deg);
    // nothing animated in view (screensaver, screen off): the animations' clock starts again
    public function reset-clock() { Clock.base = animation-tick(); }
    // each calendar page's own view and what its calendars show in it
    in property <[CalInst]> cal-inst;
    in property <string> cal-board-clock;
    in property <string> cal-board-date;
    in property <string> cal-board-ticker;
    in property <int> cal-board-epoch;
    in property <string> cal-board-empty;
    in property <string> cal-tear-month;
    in property <int> cal-tear-day;
    in property <string> cal-tear-weekday;
    in property <bool> cal-tear-sunday;
    in property <string> cal-tear-info;
    in property <string> cal-tear-line;
    in property <string> cal-wall-month;
    in property <string> cal-wall-year;
    in property <image> cal-wall-photo;
    in property <length> cal-scroll;
    in property <string> cal-empty-title;
    in property <string> cal-empty-sub;
    in property <int> cal-now-min;
    in property <[string]> cal-month-names;
    in property <bool> cal-edit;
    in property <string> cal-edit-title;
    in property <string> cal-edit-cal;
    in property <string> cal-edit-code;
    in property <color> cal-edit-tint;
    in property <string> cal-edit-day;
    in-out property <bool> cal-edit-allday;
    in-out property <int> cal-edit-start-min;
    in-out property <int> cal-edit-end-min;
    in-out property <int> cal-edit-open;
    in property <bool> cal-edit-typing;
    in property <bool> cal-edit-can-delete;
    in property <int> cal-kb-layer;
    in property <bool> cal-undo;
    in property <string> cal-undo-text;
    in property <bool> cal-picker;        // the chip's picker: the plain look's view and the calendars shown
    in property <[string]> cal-board-clock-cells;
    in property <string> cal-desk-line;
    in property <bool> cal-settings;
    in property <bool> cal-day-sheet;
    in property <string> cal-day-sheet-title;
    in property <string> cal-day-sheet-caps;
    in property <string> cal-day-sheet-short;
    in property <bool> cal-day-sheet-week;
    in property <[CalDay]> cal-day-sheet-days;
    in property <string> cal-day-sheet-free;
    in-out property <bool> cal-detail;
    in-out property <CalEvent> cal-detail-ev;
    in-out property <string> cal-detail-when;
    // each to-do page's own lists, the one shown, its open (with the ticked ones still leaving, M24) and done items
    in property <[TodoInst]> todo-inst;
    in property <length> todo-scroll;
    in property <bool> todo-picker;
    in property <bool> todo-settings;          // the to-do page settings in the look's own menu (spec 40)
    in property <int> todo-pend-look: -1;      // the terminal look's config: a look chosen there, applied when it is left
    in property <string> todo-menu-stamp;
    in property <[image]> todo-menu-tapes;
    in property <string> todo-empty-title;
    in property <string> todo-empty-sub;
    in property <bool> todo-adding;
    in property <string> todo-draft;
    in property <bool> todo-can-due;
    in property <int> todo-due-pick: -1;
    in property <string> todo-due-picked;
    in property <int> todo-kb-layer;
    in property <string> todo-note-draft;
    in property <bool> todo-note-on;
    in property <bool> todo-can-note;
    in property <string> todo-stamp;
    in property <string> todo-receipt-footer;
    in property <string> todo-receipt-empty;
    in property <string> todo-term-empty;
    in property <image> todo-note-empty;
    // the synthwave home background (weather.theme 8): scene, the two views being faded (a -> b by mix),
    // the view's colour, night amount (shooting star), floor time, cars (empty = switched off), palms,
    // neon letters, and the panel's background sheet
    in property <int> home-fl-scene;
    in property <image> home-fl-back-a;
    in property <image> home-fl-floor-a;
    in property <image> home-fl-back-b;
    in property <image> home-fl-floor-b;
    in property <float> home-fl-mix;
    in property <image> home-fl-back-c;
    in property <image> home-fl-floor-c;
    in property <float> home-fl-mix-c;
    in property <color> home-fl-grid: #ff2bd6;
    in property <float> home-fl-star;
    // the synthwave scenes' clock and the palms' sway run in the UI
    // the synthwave scenes' clock in seconds, from a base the app moves on every 20 minutes (a whole
    // number of the scenes' loops), so the number stays small and exact however long the panel runs
    in-out property <duration> scene-base;
    out property <float> scene-t: (animation-tick() - root.scene-base) / 1s;
    property <[image]> palms-l: [@image-url("timers/sw/palm-l-00.png"), @image-url("timers/sw/palm-l-01.png"), @image-url("timers/sw/palm-l-02.png"), @image-url("timers/sw/palm-l-03.png"), @image-url("timers/sw/palm-l-04.png"), @image-url("timers/sw/palm-l-05.png"), @image-url("timers/sw/palm-l-06.png"), @image-url("timers/sw/palm-l-07.png"), @image-url("timers/sw/palm-l-08.png"), @image-url("timers/sw/palm-l-09.png"), @image-url("timers/sw/palm-l-10.png"), @image-url("timers/sw/palm-l-11.png"), @image-url("timers/sw/palm-l-12.png"), @image-url("timers/sw/palm-l-13.png"), @image-url("timers/sw/palm-l-14.png"), @image-url("timers/sw/palm-l-15.png"), @image-url("timers/sw/palm-l-16.png"), @image-url("timers/sw/palm-l-17.png"), @image-url("timers/sw/palm-l-18.png"), @image-url("timers/sw/palm-l-19.png"), @image-url("timers/sw/palm-l-20.png"), @image-url("timers/sw/palm-l-21.png"), @image-url("timers/sw/palm-l-22.png"), @image-url("timers/sw/palm-l-23.png"), @image-url("timers/sw/palm-l-24.png"), @image-url("timers/sw/palm-l-25.png"), @image-url("timers/sw/palm-l-26.png"), @image-url("timers/sw/palm-l-27.png"), @image-url("timers/sw/palm-l-28.png"), @image-url("timers/sw/palm-l-29.png"), @image-url("timers/sw/palm-l-30.png"), @image-url("timers/sw/palm-l-31.png"), @image-url("timers/sw/palm-l-32.png")];
    property <[image]> palms-r: [@image-url("timers/sw/palm-r-00.png"), @image-url("timers/sw/palm-r-01.png"), @image-url("timers/sw/palm-r-02.png"), @image-url("timers/sw/palm-r-03.png"), @image-url("timers/sw/palm-r-04.png"), @image-url("timers/sw/palm-r-05.png"), @image-url("timers/sw/palm-r-06.png"), @image-url("timers/sw/palm-r-07.png"), @image-url("timers/sw/palm-r-08.png"), @image-url("timers/sw/palm-r-09.png"), @image-url("timers/sw/palm-r-10.png"), @image-url("timers/sw/palm-r-11.png"), @image-url("timers/sw/palm-r-12.png"), @image-url("timers/sw/palm-r-13.png"), @image-url("timers/sw/palm-r-14.png"), @image-url("timers/sw/palm-r-15.png"), @image-url("timers/sw/palm-r-16.png"), @image-url("timers/sw/palm-r-17.png"), @image-url("timers/sw/palm-r-18.png"), @image-url("timers/sw/palm-r-19.png"), @image-url("timers/sw/palm-r-20.png"), @image-url("timers/sw/palm-r-21.png"), @image-url("timers/sw/palm-r-22.png"), @image-url("timers/sw/palm-r-23.png"), @image-url("timers/sw/palm-r-24.png"), @image-url("timers/sw/palm-r-25.png"), @image-url("timers/sw/palm-r-26.png"), @image-url("timers/sw/palm-r-27.png"), @image-url("timers/sw/palm-r-28.png"), @image-url("timers/sw/palm-r-29.png"), @image-url("timers/sw/palm-r-30.png"), @image-url("timers/sw/palm-r-31.png"), @image-url("timers/sw/palm-r-32.png")];
    // The palms in the wind: three sines of unrelated periods (4.8, 7.5, 12.5 s: each a whole part of the
    // scene clock's 1200 s rebase, so the rebase never shows) with each palm's own
    // phases, scaled by gusts (synth.rs starts one every 6-14 s; it reaches the right palm 0.22 s
    // later). The frame (33 per side, one sweep across the sway) comes from that angle every frame, so
    // nothing repeats and the two palms never move together.
    in property <float> palm-gust-at: -100;   // scene time the next or last gust starts
    in property <float> palm-gust-peak: 1.8;
    in property <float> palm-gust-hold: 2;
    in property <float> palm-calm: 0.7;
    // the calm sway before this gust: the gust rises from it and settles into the new calm (no step)
    in property <float> palm-calm-before: 0.7;
    pure function sstep(x: float) -> float { Math.max(0, Math.min(1, x)) * Math.max(0, Math.min(1, x)) * (3 - 2 * Math.max(0, Math.min(1, x))) }
    // rise 1 s, hold, fall 2.5 s; calm between gusts
    pure function gust(d: float) -> float {
        d < 0 ? root.palm-calm-before
            : d > 3.5 + root.palm-gust-hold ? root.palm-calm
            : d < 1 ? root.palm-calm-before + (root.palm-gust-peak - root.palm-calm-before) * root.sstep(d)
            : d < 1 + root.palm-gust-hold ? root.palm-gust-peak
            : root.palm-gust-peak + (root.palm-calm - root.palm-gust-peak) * root.sstep((d - 1 - root.palm-gust-hold) / 2.5)
    }
    // the frames are one sweep from the full left lean (0) to the full right lean (32), 16 upright; a gust's
    // peak (1.8) reaches the ends, the calm sway about 40 % of the way
    pure function palm-pos(t: float, p1: float, p2: float, p3: float, delay: float) -> float {
        16 + 16 * Math.max(-1, Math.min(1, root.gust(t - delay - root.palm-gust-at) / 1.8
            * (0.55 * Math.sin((t / 4.8 * 360 + p1) * 1deg) + 0.30 * Math.sin((t / 7.5 * 360 + p2) * 1deg) + 0.15 * Math.sin((t / 12.5 * 360 + p3) * 1deg))))
    }
    // each palm between two of its 33 frames: the lower frame, the next one over it at the fraction
    property <float> palm-fl: root.palm-pos(root.scene-t, 17, 211, 98, 0);
    property <float> palm-fr: root.palm-pos(root.scene-t, 143, 37, 281, 0.22);
    property <int> palm-il: Math.min(31, Math.floor(root.palm-fl));
    property <int> palm-ir: Math.min(31, Math.floor(root.palm-fr));
