                    style: slot.variant; tape-scope: root.music-tape-scope; q-played: root.music-q-played; q-total: root.music-q-total;
                    q-index: root.music-q-index; q-count: root.music-q-count; tt-deck: root.music-inst[slot.n].tt-deck; tt-grooves: root.music-tt-grooves;
                    cs-back: root.music-inst[slot.n].cs-back; cs-front: root.music-inst[slot.n].cs-front; cs-hub: root.music-inst[slot.n].cs-hub; cs-hub-r: root.music-cs-hub-r;
                    tt-arm-r: root.music-tt-arm-r; tt-lift: root.music-tt-lift; tape-rem: root.music-tape-rem;
                    scroll: root.music-inst[slot.n].scroll; scroll-speed: root.music-inst[slot.n].scroll-speed; settings: root.music-settings && root.page == i;
