                    lap-at: root.timers-lap-at; lap-best: root.timers-lap-best; lap-marks: root.timers-lap-marks;
                    sw-look: root.timers-inst[slot.n].sw-look; alarm-look: root.timers-inst[slot.n].alarm-look;
                    now-h: root.clock.hh.to-float() + root.clock.mm.to-float() / 60; now-s: root.clock-sec; next-h: root.timers-next-h; next-in: root.timers-next-in; next-time: root.timers-next-time; next-label: root.timers-next-label; dawn-from: root.timers-dawn-from;
                    sunrise-h: root.timers-sunrise-h; sunset-h: root.timers-sunset-h;
                    ring-alarm: root.timers-ring-alarm; ring-time: root.timers-ring-time; ring-tint: root.timers-ring-tint; settings: root.timers-settings && root.page == i;
                    colourful: root.timers-inst[slot.n].colourful; alarm-on: root.timers-inst[slot.n].alarm-on; timer-on: root.timers-inst[slot.n].timer-on;
                    watch-on: root.timers-inst[slot.n].watch-on;
                    next-tint: root.timers-next-tint; watch-tint: root.timers-watch-tint;
                    hg-sand-mask: root.timers-hg-sand-mask; hg-sand-shade: root.timers-hg-sand-shade; hg-peak: root.timers-hg-peak;
                    hg-stream-mask: root.timers-hg-stream-mask; hg-stream-shade: root.timers-hg-stream-shade;
                    sw-scene: root.timers-inst[slot.n].sw-scene; sw-choice: root.timers-inst[slot.n].sw-choice; sw-back: root.timers-inst[slot.n].sw-back;
                    sw-floor: root.timers-inst[slot.n].sw-floor; sw-t: root.timers-sw-t;
                    sw-cars: root.timers-sw-cars; sw-palm-l: root.timers-sw-palm-l; sw-palm-r: root.timers-sw-palm-r; sw-palm-l2: root.timers-sw-palm-l2; sw-palm-r2: root.timers-sw-palm-r2; sw-palm-lk: root.timers-sw-palm-lk; sw-palm-rk: root.timers-sw-palm-rk;
                    edit: root.timers-edit && root.page == i; edit-new: root.timers-edit-new; edit-timer: root.timers-edit-timer; edit-h <=> root.timers-edit-h; edit-m <=> root.timers-edit-m; edit-days: root.timers-edit-days;
                    edit-label: root.timers-edit-label; edit-sound: root.timers-edit-sound; edit-ha-sound: root.timers-edit-ha-sound; ha-sounds: root.timers-ha-sounds; edit-keyboard: root.timers-edit-keyboard && root.page == i; kb-layer: root.timers-kb-layer; kb-layout: root.kb-layout;
                    edit-info: root.timers-edit-info; edit-tint: root.timers-edit-tint;
                    on-screen: i == root.shown-page && !root.screensaver-on; snooze-h: root.timers-snooze-h; ring-h: root.timers-ring-h; cells: root.timers-grid;
                }
                if slot.kind == "thermostat" && slot.variant == 3: FastLane {
                    scene: root.home-fl-scene; back-a: root.home-fl-back-a; floor-a: root.home-fl-floor-a; back-b: root.home-fl-back-b; floor-b: root.home-fl-floor-b;
                    back-c: root.home-fl-back-c; floor-c: root.home-fl-floor-c; mix-c: root.home-fl-mix-c;
                    mix: root.home-fl-mix; grid: root.home-fl-grid; star-k: root.home-fl-star; t: root.home-fl-t; cars: root.home-fl-cars-on ? root.home-fl-cars : [];
                    palm-l: root.home-fl-palm-l; palm-r: root.home-fl-palm-r; palm-l2: root.home-fl-palm-l2; palm-r2: root.home-fl-palm-r2; palm-lk: root.home-fl-palm-lk; palm-rk: root.home-fl-palm-rk;
                }
                if slot.kind == "thermostat": ThermostatPage {
                    devices: root.thermo-inst[slot.n].devices; sel: root.thermo-inst[slot.n].sel; rooms: root.thermo-inst[slot.n].rooms;
                    // (the menus are the page on screen's)
                    picker: root.thermo-picker && root.page == i; sheet: root.thermo-sheet && root.page == i;
                    settings: root.thermo-settings && root.page == i; look: slot.variant; pulse: root.thermo-pulse; clock-h: root.thermo-clock-h; clock-m: root.thermo-clock-m; key-down: root.thermo-key-down; fahrenheit: root.thermo-fahrenheit;
                    grid: root.home-fl-grid; fl-scene: root.home-fl-scene; fl-cars: root.home-fl-cars-on;
                    shown: root.page == i && !root.screensaver-on;
                    look-names: [Words.line("ui.looks.thermostat.0"), Words.line("ui.looks.thermostat.1"), Words.line("ui.looks.thermostat.2"), Words.line("ui.looks.thermostat.3")];
                    scene-names: [Words.line("ui.looks.thermostat.4"), Words.line("ui.looks.thermostat.5"), Words.line("ui.looks.thermostat.6"), Words.line("ui.looks.thermostat.7")];
                    cars-name: Words.line("ui.looks.thermostat.8");
                }
                if slot.kind == "quick": QuickPage {
                    look: slot.variant; tiles: root.quick-inst[slot.n].tiles; title: root.quick-inst[slot.n].title; mood: root.quick-inst[slot.n].mood;
                    placard: root.quick-placard;
                    sheet <=> root.quick-sheet; settings <=> root.quick-settings; on-screen: root.page == i && !root.screensaver-on;
                    sheet-tile: root.quick-sheet-tile; sheet-index: root.quick-sheet-index; details: root.quick-details; settings-tape: root.quick-settings-tape;
                    mixer-panel: root.quick-mixer-panel; fader: root.quick-fader;
                    deck-panel: root.quick-inst[slot.n].deck-panel; toggle-up: root.quick-toggle-up; toggle-down: root.quick-toggle-down; lever-frames: root.quick-lever-frames; lamp-glow: root.quick-lamp-glow; lamp-spec: root.quick-lamp-spec;
                    grid: root.quick-grid; sheet-colours: root.quick-sheet-colours;
                    sheet-effects: root.quick-sheet-effects; groups: root.quick-inst[slot.n].groups;
                    lamp-amber: root.quick-lamp-amber; lamp-off: root.quick-lamp-off; screw: root.quick-screw;
                }
                if slot.kind == "camera": CameraPage {
                    cams: root.cam-inst[slot.n].items; sel: root.cam-inst[slot.n].sel; view: root.cam-inst[slot.n].view; fit: root.cam-inst[slot.n].fit;
                    bg: root.cam-inst[slot.n].bg; bg-corners: root.cam-inst[slot.n].bg-corners; actions: root.cam-actions;
                    settings: root.cam-settings && root.page == i; grid-scroll: root.cam-grid-scroll;
                    ring: root.cam-ring && slot.n == root.cam-ring-n; ring-frame: root.cam-ring-frame; ring-bg: root.cam-ring-bg; ring-title: root.cam-ring-title; ring-sub: root.cam-ring-sub;
                    ring-state: root.cam-ring-state; can-open: root.cam-can-open; can-talk: root.cam-can-talk; hold: root.cam-hold; pulse: root.cam-pulse;
                    replies: root.cam-replies && slot.n == root.cam-ring-n; reply-list: root.cam-reply-list;
                    on-screen: i == root.page && !root.screensaver-on;
                }
                if slot.kind == "calendar": CalendarPage {
                    live: home-slot.on-view;
                    on-screen: i == root.page && !root.screensaver-on;
                    look: slot.variant; board-rows: root.cal-inst[slot.n].board-rows; board-clock: root.cal-board-clock; board-date: root.cal-board-date;
                    board-ticker: root.cal-board-ticker; board-epoch: root.cal-board-epoch; board-empty: root.cal-board-empty; tear-month: root.cal-tear-month; tear-day: root.cal-tear-day;
                    tear-weekday: root.cal-tear-weekday; tear-sunday: root.cal-tear-sunday; tear-info: root.cal-tear-info; tear-events: root.cal-inst[slot.n].tear-events;
                    tear-more: root.cal-inst[slot.n].tear-more; tear-line: root.cal-tear-line; wall-month: root.cal-wall-month; wall-year: root.cal-wall-year;
                    wall-photo: root.cal-wall-photo; wall-cells: root.cal-inst[slot.n].wall-cells;
                    view: root.cal-inst[slot.n].view; chip: root.cal-inst[slot.n].chip; title: root.cal-inst[slot.n].title; sub: root.cal-inst[slot.n].sub;
                    scroll: root.cal-scroll; agenda: root.cal-inst[slot.n].agenda;
                    empty-title: root.cal-empty-title; empty-sub: root.cal-empty-sub; day-events: root.cal-inst[slot.n].day-events; day-allday: root.cal-inst[slot.n].day-allday;
                    day-today: root.cal-inst[slot.n].day-today; day-free: root.cal-inst[slot.n].day-free; now-min: root.cal-now-min;
                    week-names: root.cal-inst[slot.n].week-names; week-nums: root.cal-inst[slot.n].week-nums;
                    week-today: root.cal-inst[slot.n].week-today; week-events: root.cal-inst[slot.n].week-events; week-allday: root.cal-inst[slot.n].week-allday;
                    month-names: root.cal-month-names; month-cells: root.cal-inst[slot.n].month-cells;
                    // (the menus are the page on screen's)
                    edit: root.cal-edit && root.page == i; edit-title: root.cal-edit-title; edit-cal: root.cal-edit-cal; edit-code: root.cal-edit-code;
                    edit-tint: root.cal-edit-tint; edit-day: root.cal-edit-day; edit-allday <=> root.cal-edit-allday; edit-start-min <=> root.cal-edit-start-min;
                    edit-end-min <=> root.cal-edit-end-min; edit-open <=> root.cal-edit-open;
                    edit-typing: root.cal-edit-typing; edit-can-delete: root.cal-edit-can-delete; kb-layer: root.cal-kb-layer; kb-layout: root.kb-layout;
                    undo: root.cal-undo && root.page == i; undo-text: root.cal-undo-text;
                    picker: root.cal-picker && root.page == i; cals: root.cal-inst[slot.n].cals; clock-cells: root.cal-board-clock-cells; desk-line: root.cal-desk-line;
                    settings: root.cal-settings && root.page == i; detail <=> root.cal-detail; detail-ev <=> root.cal-detail-ev; detail-when <=> root.cal-detail-when;
                    day-sheet: root.cal-day-sheet && root.page == i; day-sheet-title: root.cal-day-sheet-title; day-sheet-caps: root.cal-day-sheet-caps;
                    day-sheet-short: root.cal-day-sheet-short; day-sheet-week: root.cal-day-sheet-week; day-sheet-days: root.cal-day-sheet-days;
                    day-sheet-free: root.cal-day-sheet-free;
                }
                if slot.kind == "todo": TodoPage {
                    lists: root.todo-inst[slot.n].lists; sel: root.todo-inst[slot.n].sel; open-items: root.todo-inst[slot.n].open-items;
                    leaving: root.todo-inst[slot.n].leaving; done-items: root.todo-inst[slot.n].done-items; show-done: root.todo-inst[slot.n].show-done;
                    // (the menus and the adding form are the page on screen's)
                    scroll: root.todo-scroll; picker: root.todo-picker && root.page == i; settings: root.todo-settings && root.page == i;
                    pend-look: root.page == i ? root.todo-pend-look : -1;
                    menu-stamp: root.todo-menu-stamp; menu-tapes: root.todo-menu-tapes; on-screen: i == root.shown-page && !root.screensaver-on;
                    empty-title: root.todo-empty-title; empty-sub: root.todo-empty-sub;
                    adding: root.todo-adding && root.page == i; draft: root.todo-draft; can-due: root.todo-can-due; due-pick: root.todo-due-pick; due-picked: root.todo-due-picked;
                    kb-layer: root.todo-kb-layer; kb-layout: root.kb-layout; look: slot.variant; note-draft: root.todo-note-draft; note-on: root.todo-note-on; can-note: root.todo-can-note; stamp: root.todo-stamp;
                    receipt-footer: root.todo-receipt-footer; receipt-empty: root.todo-receipt-empty; term-empty: root.todo-term-empty;
                    label-head: root.todo-inst[slot.n].label-head; label-done-head: root.todo-inst[slot.n].label-done-head;
                    label-empty-tape: root.todo-inst[slot.n].label-empty-tape;
                    note-head: root.todo-inst[slot.n].note-head; note-done: root.todo-inst[slot.n].note-done; note-empty: root.todo-note-empty;
                }
                if slot.kind == "info": InfoPage {
                    live: home-slot.on-view;
                    look: slot.variant; notes: root.info-notes; statuses: root.info-statuses; scroll: root.info-scroll;
                    empty-title: root.info-empty-title; empty-sub: root.info-empty-sub;
                    card: root.info-card && root.page == i; card-note: root.info-card-note; card-index: root.info-card-index; card-count: root.info-card-count;
                    critical: root.info-critical; crit-title: root.info-crit-title; crit-message: root.info-crit-message; crit-icon: root.info-crit-icon;
                    crit-source: root.info-crit-source; crit-hold: root.info-crit-hold; crit-pulse: root.info-crit-pulse; settings: root.info-settings && root.page == i;
                    current: i == root.page && !root.screensaver-on; minute: root.info-minute; finish: root.info-inst[slot.n].finish;
                    pager-empty: root.info-pager-empty; news-ticker: root.info-news-ticker; news-epoch: root.info-news-epoch; news-empty: root.info-news-empty;
                    fridge-door: root.info-fridge-door; fridge-empty: root.info-fridge-empty;
                    pager-body: root.info-inst[slot.n].pager-body; pager-led: root.info-pager-led; pager-first: root.info-pager-first; crit-button: root.info-crit-button;
                }
                if root.show-people && root.people.length > 0 && !root.home-editing: People {
                    x: 16px;
                    y: root.height - 40px;
                    people: root.people;
                }
            }
        }
    }
    }

    // ---- over every page ----
    // A ringing timer or alarm: a tap anywhere stops it, except on the ringing screen's second button
    // ("+1 min" / "Snooze 9 min", 140 x 44 at the bottom middle, see timers.slint), with a margin for the finger.
    if root.timers-ringing: TouchArea {
        clicked => {
            if self.mouse-x > (root.width - 140px) / 2 - 12px && self.mouse-x < (root.width + 140px) / 2 + 12px
                && self.mouse-y > 392px - 10px && self.mouse-y < 392px + 44px + 14px {
                root.act("timers.more", "");
            } else {
                root.act("timers.stop", "");
            }
        }
    }
    property <float> status-k: root.status-on ? 1 : 0;
    animate status-k { duration: 300ms; easing: ease-in-out; }
    if root.status-k > 0.001: StatusPage { s: root.status-screen; opacity: root.status-k; }
    StatusBar {
        x: 16px;
        y: 10px;
        width: root.width - 32px;
        pull(d) => { if !root.screensaver-on && root.set-view == 0 { root.shade-move(d); } }
        pull-end(d) => { if root.shade-pulling { root.shade-release(d); } }
        hint: root.wake-hint;
        mic-muted: root.mic-muted;
        speaker-muted: root.speaker-muted;
        dnd: root.dnd-on;
        listening: root.voice-on && root.voice-state == 1;
        notes: root.info-unread;
        timers: root.timers;
        timer-mark: island.mark-on;
        timer-hold: island.mark-hold;
        problem: !root.connected;
        quiet: root.screensaver-on;
        on-color: root.status-on || (root.pages.length > 0 && root.on-color(root.pages[root.shown-page]));
        on-k: root.status-on ? 1 : root.on-k;
        left-chips: root.left-k > 0.5;
        left-k: root.left-k;
    }
    // the running timers: the island under the status line (29.3); a flick sends it into the timer mark
    island := TimerIsland {
        x: 0; y: 0; width: root.width; height: root.height;
        timers: root.timers;
        away <=> root.island-away;
        // under the status strip while it runs
        rest-y: 46px + 46px * root.strip-k;
        light: !root.status-on && root.on-k < 0.5 && !Theme.dark;
        hidden: root.voice-on || root.shade-pos > 0.002 || root.set-view > 0 || root.screensaver-on
            || (root.pages.length > 0 && root.pages[root.shown-page].kind == "timers");
        // the timer mark's place once the group has its final marks
        mark-x: 240px + ((root.mic-muted ? 1 : 0) + (root.speaker-muted ? 1 : 0)) * 32px + 16px
            - ((root.mic-muted ? 1 : 0) + (root.speaker-muted ? 1 : 0) + 1 + ((root.info-unread > 0 || root.dnd-on) && !root.screensaver-on ? 1 : 0)) * 16px;
    }
    // a finger resting on a weather page may open its edit lock (the app also checks the integration's switch): the page
    // is on screen with nothing over it
    out property <bool> home-hold-ok: root.pages.length > 0 && (root.pages[root.page].kind == "home" || root.pages[root.page].kind == "weather") && !root.home-editing && !root.home-lock
        && !root.screensaver-on && !root.voice-on && root.set-view == 0 && root.shade-pos < 0.002 && !root.status-on && !root.timers-ringing
        && !root.web-shown && !root.sheet-open && !root.dragging && root.paired && !root.connecting && root.offline-cause == 0
        && !root.info-critical && !root.cam-ring;
    // every page sheet, editor and keyboard view (the dots are never drawn over them)
    property <bool> sheet-open: root.quick-sheet || root.quick-settings || root.thermo-sheet || root.thermo-picker || root.thermo-settings || root.music-picker
        || root.music-settings || root.cal-detail || root.cal-settings || root.cal-day-sheet || root.cal-edit || root.cal-picker || root.timers-quick
        || root.timers-sheet >= 0 || root.timers-settings || root.timers-edit || root.timers-edit-keyboard || root.todo-picker
        || root.todo-settings || root.todo-adding || root.cam-settings || root.cam-replies || root.info-settings || root.info-card || root.home-bg-sheet || root.home-picker
        || root.home-settings >= 0 || root.home-editing || root.home-lock;
    // a sheet opening while a page drag runs (the pager stops taking swipes): the drag snaps back, never left halfway
    changed sheet-open => {
        if root.sheet-open && root.dragging {
            let rp = -(root.drag-start + root.drag-x - root.drag-x0) / root.width;
            root.pos = Math.round(rp);
            root.dragging = false;
            root.drag-x = 0;
            root.page = Math.mod(root.pos, root.pages.length);
        }
    }
    // the dots fade (200 ms) when a sheet, the screensaver or a temporary page hides them, and back
    property <float> dots-k: !root.screensaver-on && !root.dots-hidden && !root.sheet-open && root.pages.length > 1 ? 1 : 0;
    animate dots-k { duration: 200ms; easing: ease-out; }
    if root.dots-k > 0.001 && root.pages.length > 1: PageDots {
        y: root.height - 22px;
        width: root.width;
        height: 6px;
        count: root.pages.length;
        current: root.pg-a;
        next: root.pg-b;
        frac: root.pg-f;
        start: root.page;
        shown: root.dots-k;
        on-color: root.pages.length > 0 && root.on-color(root.pages[root.shown-page]);
        on-k: root.on-k;
    }

    // ---- dashboard mode: the web view fills the screen; a swipe down from the
    // top edge opens the panel's quick settings ----
    if root.web-shown: Rectangle {
        background: Theme.background;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.web-frame;
        }
        if !root.web-ready: Text {
            text: "Loading the dashboard…";
            font-size: 16px;
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.web-touch(0, self.mouse-x / 1px, self.mouse-y / 1px);
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    root.web-touch(2, self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
            moved => { root.web-touch(1, self.mouse-x / 1px, self.mouse-y / 1px); }
        }
    }

    // let go: the disc slides back up (200 ms) instead of vanishing
    property <float> pull-shown: root.web-pull;
    animate pull-shown { duration: root.web-pull > 0 ? 0ms : 200ms; easing: ease-out; }
    if root.web-shown && root.pull-shown > 0.001: PullToRefresh {
        pull: root.pull-shown;
        x: (root.width - self.width) / 2;
        y: -self.height + root.pull-shown * 80px;
    }

    if root.web-shown && root.web-overlay: WebLoading {
        loading: root.web-loading;
        background-image: root.loading-image;
        line-a: root.loading-line-a;
        line-b: root.loading-line-b;
        show-a: root.loading-show-a;
    }

    // Swipe down from the status bar: the quick settings follow the finger,
    // and open when let go far enough (or flicked), else slide back.
    property <bool> shade-pulling;
    property <length> shade-pull;
    property <duration> pull-t;
    property <length> pull-last;
    property <float> pull-v;                 // px per ms, + downwards
    // the shade in two steps (29.5): P 0 closed … 1 the first step … 2 the second; `shade-morph` of finger travel morphs one
    // into the other; past the second a rubber band (24 px at most)
    property <int> shade-step: 1;
    property <bool> shade-moving;            // a vertical drag on the open shade
    property <length> shade-d;               // … how far (+ down)
    property <int> shade-from: 1;            // … from which step
    // the quick shade's page row (spec 32.0): the page on screen has settings in its look's menu (the page fills in
    // PageMenu); kinds without page settings never show it, whatever an earlier page left there
    pure function menu-kind(kind: string) -> bool {
        kind == "music" || kind == "thermostat" || kind == "timers" || kind == "calendar" || kind == "camera" || kind == "info"
            || kind == "todo" || kind == "quick"
    }
    property <bool> page-row: PageMenu.has-settings && !root.screensaver-on && root.pages.length > 0
        && root.page >= 0 && root.page < root.pages.length && root.menu-kind(root.pages[root.page].kind);
    // its tap: the shade closes, then (300 ms later, the shade gone) the page opens its settings
    property <bool> page-row-pending;
    Timer { interval: 300ms; running: root.page-row-pending; triggered => { root.page-row-pending = false; PageMenu.open-request += 1; } }
    // the finger travel that morphs the first step into the second: what "Now" moves by (60 px more with the page row)
    property <length> shade-morph: root.page-row ? 196px : 136px;
    pure function shade-band(d: length) -> float {
        return 24px * (1 - Math.pow(2.71828, -(d / 80px))) / root.shade-morph;
    }
    // the first step's height (what the shade slides in by): its controls, what runs now, the handle band
    property <length> shade-h1: min(472px, 182px + (root.timers-list.length > 0 ? 28px + root.timers-list.length * 60px : 0px)
        + (root.info-notes.length > 0 ? 28px + min(6, root.info-notes.length) * 60px + (root.info-notes.length > 6 ? 40px : 0px) : 0px) + 20px);
    pure function p-of-pull(d: length) -> float {
        return d <= root.shade-h1 ? max(0, d / root.shade-h1)
            : d <= root.shade-h1 + root.shade-morph ? 1 + (d - root.shade-h1) / root.shade-morph
            : 2 + root.shade-band(d - root.shade-h1 - root.shade-morph);
    }
    pure function p-of-move(from: int, d: length) -> float {
        return from == 1 ? (d >= 0 ? (d <= root.shade-morph ? 1 + d / root.shade-morph : 2 + root.shade-band(d - root.shade-morph)) : max(0, 1 + d / root.shade-h1))
            : (d >= 0 ? 2 + root.shade-band(d) : d >= -root.shade-morph ? 2 + d / root.shade-morph : max(0, 1 + (d + root.shade-morph) / root.shade-h1));
    }
    // P springs to its step with J-edge(60, 320)
    property <float> p-from;
    property <float> p-to;
    property <duration> p-t0;
    property <bool> p-anim;
    Timer { interval: 900ms; running: root.p-anim; triggered => { root.p-anim = false; } }
    property <float> p-rest: (root.set-view == 1 || root.set-view == 2) ? root.shade-step : 0;
    property <float> p-rest-old;
    changed p-rest => {
        if !root.p-anim { root.p-from = root.p-rest-old; root.p-to = root.p-rest; root.p-t0 = animation-tick(); root.p-anim = true; }
        root.p-rest-old = root.p-rest;
        if root.p-rest == 0 { root.shade-step = 1; }
    }
    function p-go(from: float, to: int) {
        root.p-from = from; root.p-to = to; root.p-t0 = animation-tick(); root.p-anim = true;
        if to == 0 { root.act("shade.close", ""); } else { root.shade-step = to; if root.set-view == 0 { root.act("shade.open", ""); } }
    }
    out property <float> shade-pos: root.shade-pulling ? root.p-of-pull(root.shade-pull)
        : root.shade-moving ? root.p-of-move(root.shade-from, root.shade-d)
        : root.p-anim ? root.p-from + (root.p-to - root.p-from) * Jelly.edge((animation-tick() - root.p-t0) / 1ms, 60, 320)
        : root.p-rest;
    SwipeGestureHandler {
        y: 0;
        height: 56px;
        enabled: root.web-shown;
        handle-swipe-down: !root.screensaver-on && root.set-view == 0;
        moved => { root.shade-move(self.current-position.y - self.pressed-position.y); }
        swiped => { root.shade-release(self.current-position.y - self.pressed-position.y); }
        cancelled => { root.shade-pulling = false; root.p-go(root.p-of-pull(root.shade-pull), 0); }
    }
    // a pull or a drag of the shade whose release never reached it (a switch between the dashboard and the pages took
    // its handler away, the touch went to the other side, a second finger called it off): it settles as if let go, at
    // once on the switch, else a moment after the last finger lifted; while it hung on, it covered everything
    in property <bool> finger-down;          // a one-finger press under way (the platform tells after every touch)
    function shade-settle() {
        if root.shade-pulling {
            root.shade-pulling = false;
            root.p-go(root.p-of-pull(root.shade-pull), 0);
        }
        if root.shade-moving {
            root.shade-moving = false;
            root.p-go(root.p-of-move(root.shade-from, root.shade-d), root.shade-from);
            root.shade-d = 0px;
        }
    }
    changed web-shown => { root.shade-settle(); }
    Timer {
        interval: 250ms;
        running: (root.shade-pulling || root.shade-moving) && !root.finger-down;
        triggered => { root.shade-settle(); }
    }

    // the theme switch: every colour of the palette eases between light and dark
    // light / dark: 700 ms when someone switches it, 3 s when Auto does (a change by itself blends over a few
    // seconds, nobody waits for it); a sine ease-in-out, softer at both ends; every colour moves together
    in property <bool> theme-slow;
    property <float> theme-k: Theme.dark ? 1 : 0;
    animate theme-k { duration: root.theme-slow ? 3000ms : 700ms; easing: cubic-bezier(0.37, 0, 0.63, 1); }
    changed theme-k => { Theme.k = root.theme-k; }
    // the clocks of spec 24.9 show the next alarm and ring with it
    changed timers-next-h => { AlarmNow.next-h = root.timers-next-h; }
    changed timers-ringing => { AlarmNow.ringing = root.timers-ringing && root.timers-ring-alarm; }
    changed timers-ring-alarm => { AlarmNow.ringing = root.timers-ringing && root.timers-ring-alarm; }
    init => { Theme.k = Theme.dark ? 1 : 0; }
    // §22.6: the whole screen crossfades between the looks: a picture of the screen before the switch fades out
    // over the new look (700 ms by hand, 3 s by Auto, sine ease-in-out); pictures and images that have a light and
    // a dark version change with it, not in a jump
    in-out property <image> theme-shot;
    property <bool> shot-on;
    property <duration> shot-t0;
    property <duration> shot-dur: root.theme-slow ? 3000ms : 700ms;
    public function theme-fade() { root.shot-t0 = animation-tick(); root.shot-on = true; }
    Timer { interval: root.shot-dur + 30ms; running: root.shot-on; triggered => { root.shot-on = false; root.theme-shot = @image-url(""); } }
    property <float> shot-x: root.shot-on ? clamp((animation-tick() - root.shot-t0) / root.shot-dur, 0, 1) : 1;
    property <float> shot-k: root.shot-on ? (1 + Math.cos(180deg * root.shot-x)) / 2 : 0;

    // ---- screensaver ----
    property <float> saver-k: root.screensaver-on ? 1 : 0;
    // M9: entering the screensaver, the page dims and sinks 4 px over 600 ms under the fading-in saver
    property <float> sink-k: root.screensaver-on ? 1 : 0;
    animate sink-k { duration: root.screensaver-on ? 600ms : 0ms; easing: ease-out; }
    animate saver-k { duration: root.screensaver-on ? 800ms : 200ms; easing: ease-in-out; }
    if root.saver-k > 0.001: Rectangle {
        opacity: root.saver-k;
        background: Theme.background;
        ClockFace {
            data: root.clock;
            style: root.saver-style;
            accent: root.saver-accent;
            weight: root.saver-weight;
            width-k: root.saver-width;
            show-date: root.saver-date;
            show-weather: root.saver-weather;
            show-next: root.saver-next;
            show-seconds: root.saver-seconds;
            wander-speed: root.saver-speed;
            seconds: root.clock-sec;
        }
        TouchArea {
            clicked => { root.act("saver.wake", ""); }
        }
    }

    // ---- layers ----

    // the status strip (#91): right under the status bar, which stays visible; under the new-notification window, the voice
    // view and the shade; it steps aside while a page's menu or sheet is open (those come down from y 48)
    property <float> strip-k: root.strip-on && !root.sheet-open ? 1 : 0;
    animate strip-k { duration: 200ms; easing: ease-out; }
    if root.strip-k > 0.001: TopStrip {
        x: 0; y: 44px - 6px * (1 - root.strip-k); width: root.width; opacity: root.strip-k;
        title: root.strip-title; sub: root.strip-sub; icon: root.strip-icon; picto: root.strip-picto; has-picto: root.strip-has-picto;
        tint: root.strip-tint; critical: root.strip-critical; pulse: root.strip-pulse;
        open => { root.act("strip.open", ""); }
        close => { root.act("strip.close", ""); }
    }
    // the new-notification window (30), in the notifications page's look
    NotifWindow { x: 0; y: 0; width: root.width; height: root.height;
        on: root.pop-on; notes: root.pop-notes; index: root.pop-index; count: root.pop-count; look: root.pop-look; until: root.pop-until;
        seconds: root.pop-seconds; minute: root.info-minute; pager: root.pop-pager; led: root.info-pager-led; }
    property <float> voice-k: root.voice-on ? 1 : 0;
    animate voice-k { duration: root.voice-on ? 200ms : 250ms; easing: ease-in-out; }
    if root.voice-k > 0.001: VoicePage {
        opacity: root.voice-k;
        x: 0; y: 0; width: root.width; height: root.height;
        look: root.voice-look; state: root.voice-state; assistant: root.voice-assistant; heard: root.voice-heard; answer: root.voice-answer;
        line: root.voice-line; detail: root.voice-detail; level: root.voice-level; left: root.voice-left; wave: root.voice-wave;
        wave1: root.voice-wave1; wave2: root.voice-wave2; wave3: root.voice-wave3; peaks: root.voice-peaks; typed: root.voice-typed; closing: !root.voice-on;
        scan: root.voice-scan; dots: root.voice-dots; version: root.app-version;
        // the terminal's cursor and the comic's dots blink (530 ms)
        blink: Math.mod(animation-tick() / 1ms, 1060) < 530;
    }
    if root.voice-on: TouchArea {
        clicked => { root.act("voice.close", ""); }
    }
    if root.set-view > 0: TouchArea {
        clicked => { root.act("shade.close", ""); }
    }
    // Kept while the shade slides in or out (it shows the shade meanwhile).
    if root.set-view > 0 || root.shade-pos > 0.002: SettingsLayer {
        x: 0; y: 0; width: root.width; height: root.height;
        view: root.set-view > 0 ? root.set-view : 1; shade-pos: root.shade-pos; shade-title: root.set-shade-title; brightness: root.set-brightness; volume: root.set-volume; mic-on: root.set-mic-on;
        mic-state: root.set-mic-state; theme-state: root.set-theme-state; dnd: root.set-dnd; dnd-state: root.set-dnd-state; sleep-state: root.set-sleep-state;
        lock-title: root.set-lock-title; hold: root.set-hold; title: root.set-title; rows: root.set-rows; tagline: root.set-tagline;
        page-title: root.set-page-title; page-sub: root.set-page-sub; used: root.set-used; used-text: root.set-used-text; bars: root.set-bars; sections: root.set-sections;
        confirm-title: root.set-confirm-title; confirm-line: root.set-confirm-line;
        theme-mode: root.theme-mode;
        saver-options: root.set-saver-options; saver-index: root.set-saver-index; saver-style: root.set-saver-style;
        wake-options: root.set-wake-options; wake1: root.set-wake1; wake-options2: root.set-wake-options2; wake2: root.set-wake2;
        about-rows: root.set-about-rows; about-links: root.set-about-links; about-link: root.set-about-link; about-qr: root.set-about-qr;
        auto-bright: root.set-auto; now-timers: root.timers-list; now-notes: root.info-notes; moving: root.shade-moving;
        page-row: root.page-row;
        page-open => { root.page-row-pending = true; root.p-go(root.shade-pos, 0); }
        shade-move(d, done) => {
            if !done {
                if !root.shade-moving {
                    root.shade-from = root.shade-step;
                    root.pull-t = animation-tick();
                    root.pull-last = 0px;
                    root.pull-v = 0;
                }
                root.shade-moving = true;
                root.shade-d = d;
                let dt = (animation-tick() - root.pull-t) / 1ms;
                if dt >= 16 {
                    root.pull-v = root.pull-v * 0.4 + 0.6 * ((d - root.pull-last) / 1px) / dt;
                    root.pull-last = d;
                    root.pull-t = animation-tick();
                }
            } else if root.shade-moving {
                let p = root.p-of-move(root.shade-from, root.shade-d);
                root.shade-moving = false;
                // a flick goes to the next / previous step; otherwise the nearest (the second from halfway, the first
                // from 70 % shown)
                root.p-go(p, root.pull-v > 0.5 ? (p >= 1 ? 2 : 1) : root.pull-v < -0.5 ? (p > 1.05 ? 1 : 0) : p >= 1.5 ? 2 : p >= 0.7 ? 1 : 0);
                root.shade-d = 0px;
            }
        }
        shade-step(n) => { root.p-go(root.shade-pos, n); }
    }
    // the status bar stays readable over the shade and the settings (drawn above them, theme colours there)
    if root.set-view > 0 || root.shade-pos > 0.002 || root.pop-on: StatusBar {
        x: 16px;
        y: 10px;
        width: root.width - 32px;
        hint: root.wake-hint;
        mic-muted: root.mic-muted;
        speaker-muted: root.speaker-muted;
        dnd: root.dnd-on;
        listening: root.voice-on && root.voice-state == 1;
        notes: root.info-unread;
        timers: root.timers;
        timer-mark: island.mark-on;
        timer-hold: island.mark-hold;
        problem: !root.connected;
        quiet: root.screensaver-on;
        on-k: root.pop-on && root.set-view == 0 && root.shade-pos < 0.002 ? 1 : root.set-view >= 3 ? 0 : (root.status-on ? 1 : root.on-k) * (1 - min(1, root.shade-pos));
        left-chips: root.left-k > 0.5;
        left-k: root.left-k;
    }

    // ---- system screens ----
    if !root.paired: PairingScreen {
        qr: root.qr;
        hint: root.pair-hint;
        ha-url: root.pair-ha-url;
        state: root.pair-state;
        variant: root.pair-variant;
        theme-mode: root.theme-mode;
        wifi-bars: root.net-bars;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }
    if root.connecting: ConnectingScreen {
        morse-t: (animation-tick() - Clock.base) / 1s;
        ha-url: root.pair-ha-url;
        slow: root.connect-slow;
        progress: root.connect-progress;
        step: root.connect-step;
        variant: root.connect-variant;
        theme-mode: root.theme-mode;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }
    if root.offline-cause > 0: OfflineScreen {
        morse-t: (animation-tick() - Clock.base) / 1s;
        cause: root.offline-cause;
        retry-start: root.offline-retry-start;
        retry-total: root.offline-retry-total;
        net-name: root.net-name;
        ha-url: root.pair-ha-url;
        variant: root.offline-variant;
        theme-mode: root.theme-mode;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }
    if root.setup: SetupScreen {
        found: root.setup-found;
        address: root.setup-address;
        message: root.setup-message;
        message-kind: root.setup-message-kind;
        variant: root.setup-variant;
        theme-mode: root.theme-mode;
        wifi-name: root.net-name;
        wifi-bars: root.net-bars;
        wifi-ip: root.net-ip;
        wifi-info-open: root.setup-wifi-info;
        change-wifi => { root.setup-change-wifi(); }
        choose-many => { root.setup-choose-many(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
        busy: root.setup-busy;
        can-back: root.setup-can-back;
        back => { root.setup-back(); }
        pick(url) => { root.setup-pick(url); }
        key(k) => { root.setup-key(k); }
        connect => { root.setup-connect(); }
    }
    if root.setup-pick-open: HaPickScreen {
        found: root.setup-found;
        variant: root.setup-variant;
        theme-mode: root.theme-mode;
        back => { root.setup-pick-back(); }
        pick(url) => { root.setup-pick(url); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }
    if root.wifi-setup: WifiScreen {
        networks: root.wifi-networks;
        scanning: root.wifi-scanning;
        variant: root.wifi-variant;
        theme-mode: root.theme-mode;
        can-back: root.wifi-can-back;
        back => { root.wifi-back(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
        pick(ssid) => { root.wifi-pick(ssid); }
        rescan => { root.wifi-rescan(); }
        other => { root.wifi-other(); }
    }
    if root.wifi-password-open: WifiPasswordScreen {
        ssid: root.wifi-ssid;
        shown-text: root.wifi-shown-text;
        show: root.wifi-show-password;
        layer: root.wifi-key-layer;
        layout: root.kb-layout;
        message: root.wifi-message;
        message-kind: root.wifi-message-kind;
        busy: root.wifi-busy;
        variant: root.wifi-variant;
        held-key: root.kb-held-key;
        popup-options: root.kb-popup-options;
        popup-x: root.kb-popup-x;
        popup-y: root.kb-popup-y;
        popup-selected: root.kb-popup-selected;
        theme-mode: root.theme-mode;
        back => { root.wifi-password-back(); }
        key(k) => { root.wifi-password-key(k); }
        toggle-show => { root.wifi-password-toggle-show(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }
    if root.hidden-open: HiddenNetworkScreen {
        name: root.hidden-name;
        shown-password: root.wifi-shown-text;
        show: root.wifi-show-password;
        field: root.hidden-focus;
        layer: root.wifi-key-layer;
        layout: root.kb-layout;
        message: root.wifi-message;
        message-kind: root.wifi-message-kind;
        busy: root.wifi-busy;
        variant: root.wifi-variant;
        theme-mode: root.theme-mode;
        back => { root.wifi-password-back(); }
        key(k) => { root.wifi-password-key(k); }
        focus-field(i) => { root.hidden-focus-field(i); }
        toggle-show => { root.wifi-password-toggle-show(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    // ---- the child lock and the wake distance calibration ----
    // over every page, layer and system screen; not while a timer rings (a tap stops it) or a critical alert is up (it
    // is held to silence it), not before the panel is set up and paired; the touch test stays above it
    if root.child-lock && root.paired && !root.setup && !root.timers-ringing && !root.info-critical: ChildLockLayer {
        saver: root.screensaver-on;
        open <=> root.child-lock-open;
    }
    if root.prox-cal-on: ProxCalLayer { step: root.prox-cal-step; count: root.prox-cal-count; reach: root.prox-cal-reach; ok: root.prox-cal-ok; }

    // ---- development views ----
    // Proximity test view: still black background, only the numbers change.
    if root.prox-test: Rectangle {
        background: #000000;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 18px;
            Text {
                text: root.prox-test-prompt;
                font-size: 30px;
                font-weight: 700;
                color: #ffd54f;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.prox-test-distance;
                font-size: 110px;
                font-weight: 700;
                color: root.prox-test-near ? #e53935 : #ffffff;
                horizontal-alignment: center;
            }
            Text {
                text: root.prox-test-details;
                font-size: 22px;
                color: #a0a0a0;
                horizontal-alignment: center;
            }
        }
    }

    // Touch test view: the points to touch on black; touches go nowhere else.
    if root.touch-test: Rectangle {
        background: #000000;
        for p[i] in [
            { x: 16, y: 16 }, { x: 240, y: 16 }, { x: 464, y: 16 },
            { x: 464, y: 240 }, { x: 464, y: 464 }, { x: 240, y: 464 },
            { x: 16, y: 464 }, { x: 16, y: 240 }, { x: 240, y: 240 },
        ]: Rectangle {
            property <bool> now: i == root.touch-test-step;
            property <color> c: now ? #FF4A1C : i < root.touch-test-step ? #5a5a5a : #d8d8d8;
            x: p.x * 1px - 14px;
            y: p.y * 1px - 14px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            border-width: now ? 3px : 2px;
            border-color: c;
            Rectangle { x: 13px; y: 4px; width: 2px; height: 20px; background: c; }
            Rectangle { x: 4px; y: 13px; width: 20px; height: 2px; background: c; }
        }
        Text {
            y: 300px;
            width: parent.width;
            text: root.touch-test-text;
            font-size: 20px;
            color: #d8d8d8;
            horizontal-alignment: center;
        }
        TouchArea {
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    root.touch-test-event(0, self.mouse-x / 1px, self.mouse-y / 1px);
                } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                    root.touch-test-event(2, self.mouse-x / 1px, self.mouse-y / 1px);
                }
            }
            moved => { root.touch-test-event(1, self.mouse-x / 1px, self.mouse-y / 1px); }
        }
        // the way out: nothing is changed (away from every point, above the TouchArea so its taps never count)
        if root.touch-test-step < 9: TextButton { x: 180px; y: 352px; width: 120px; text: "Cancel"; clicked => { Act.act("touch.cancel", ""); } }
    }

    // Hand-over from the boot splash: its last frame (logo and text on

    // Hand-over from the boot splash
    if root.intro-visible: Rectangle {
        background: #000000;
        opacity: root.intro ? 1 : 0;
        animate opacity { duration: 500ms; easing: ease-in-out; }
        Image {
            x: root.intro-x;
            y: root.intro-y;
            source: root.intro-logo;
        }
    }
    // the theme crossfade's picture of the screen before the switch, over everything
    if root.shot-k > 0.001: Image { x: 0; y: 0; width: root.width; height: root.height; source: root.theme-shot; opacity: root.shot-k; }
}
