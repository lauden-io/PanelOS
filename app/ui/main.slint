            title: root.music-title; artist: root.music-artist; album: root.music-album;
            playing: root.music-playing; pos: root.music-pos; dur: root.music-dur;
            shuffle: root.music-shuffle; repeat: root.music-repeat; volume: root.music-volume;
            player: root.music-player; art: root.music-art; art-bg: root.music-art-bg; has-art: root.music-has-art;
            kind-icon: root.music-kind-icon; accent: root.music-accent; players: root.music-players; picker: root.music-picker;
            style: root.music-style; tape-scope: root.music-tape-scope; q-played: root.music-q-played; q-total: root.music-q-total;
            q-index: root.music-q-index; q-count: root.music-q-count; tt-deck: root.music-tt-deck; tt-grooves: root.music-tt-grooves;
            cs-back: root.music-cs-back; cs-front: root.music-cs-front; cs-hub: root.music-cs-hub; cs-hub-r: root.music-cs-hub-r;
            tt-arm-r: root.music-tt-arm-r; tt-lift: root.music-tt-lift; tape-rem: root.music-tape-rem;
            scroll: root.music-scroll; scroll-speed: root.music-scroll-speed; settings: root.music-settings; holds: root.music-holds; wood: root.music-wood; woods: root.music-woods;
        }
