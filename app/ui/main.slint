            board-ticker: root.cal-board-ticker; board-empty: root.cal-board-empty; tear-month: root.cal-tear-month; tear-day: root.cal-tear-day;
            tear-weekday: root.cal-tear-weekday; tear-sunday: root.cal-tear-sunday; tear-info: root.cal-tear-info; tear-events: root.cal-tear-events;
            tear-more: root.cal-tear-more; tear-line: root.cal-tear-line; wall-month: root.cal-wall-month; wall-year: root.cal-wall-year;
            wall-photo: root.cal-wall-photo; wall-cells: root.cal-wall-cells;
            view: root.cal-view; title: root.cal-title; sub: root.cal-sub; scroll: root.cal-scroll; agenda: root.cal-agenda;
            empty-title: root.cal-empty-title; empty-sub: root.cal-empty-sub; day-events: root.cal-day-events; day-allday: root.cal-day-allday;
            day-today: root.cal-day-today; day-free: root.cal-day-free; now-min: root.cal-now-min; week-names: root.cal-week-names; week-nums: root.cal-week-nums;
            week-today: root.cal-week-today; week-events: root.cal-week-events; week-allday: root.cal-week-allday; month-names: root.cal-month-names;
            month-cells: root.cal-month-cells; edit: root.cal-edit; edit-title: root.cal-edit-title; edit-cal: root.cal-edit-cal; edit-tint: root.cal-edit-tint;
            edit-day: root.cal-edit-day; edit-allday <=> root.cal-edit-allday; edit-start-min <=> root.cal-edit-start-min; edit-end-min <=> root.cal-edit-end-min;
            edit-typing: root.cal-edit-typing; edit-can-delete: root.cal-edit-can-delete; settings: root.cal-settings; detail: root.cal-detail; detail-ev: root.cal-detail-ev; detail-when: root.cal-detail-when;
        }
        if root.panel == "todo": TodoPage {
            lists: root.todo-lists; sel: root.todo-sel; open-items: root.todo-open; done-items: root.todo-done; show-done: root.todo-show-done;
            scroll: root.todo-scroll; picker: root.todo-picker; empty-title: root.todo-empty-title; empty-sub: root.todo-empty-sub;
            adding: root.todo-adding; draft: root.todo-draft; can-due: root.todo-can-due; due-pick: root.todo-due-pick; due-picked: root.todo-due-picked;
            kb-layer: root.todo-kb-layer; look: root.todo-look; settings: root.todo-settings; stamp: root.todo-stamp;
            receipt-footer: root.todo-receipt-footer; receipt-empty: root.todo-receipt-empty; term-empty: root.todo-term-empty;
            label-head: root.todo-label-head; label-done-head: root.todo-label-done-head; label-empty-tape: root.todo-label-empty-tape;
            note-head: root.todo-note-head; note-done: root.todo-note-done; note-empty: root.todo-note-empty;
        }
        if root.panel == "camera": CameraPage {
            cams: root.cam-items; sel: root.cam-sel; view: root.cam-view; fit: root.cam-fit; bg: root.cam-bg; bg-corners: root.cam-bg-corners; actions: root.cam-actions; settings: root.cam-settings; grid-scroll: root.cam-grid-scroll;
            ring: root.cam-ring; ring-frame: root.cam-ring-frame; ring-bg: root.cam-ring-bg; ring-title: root.cam-ring-title; ring-sub: root.cam-ring-sub;
            ring-state: root.cam-ring-state; can-open: root.cam-can-open; can-talk: root.cam-can-talk; hold: root.cam-hold; pulse: root.cam-pulse;
            replies: root.cam-replies; reply-list: root.cam-reply-list;
        }
