        page-title: root.set-page-title; page-sub: root.set-page-sub; used: root.set-used; used-text: root.set-used-text; bars: root.set-bars; sections: root.set-sections;
        confirm-title: root.set-confirm-title; confirm-line: root.set-confirm-line;
    }


    if root.more-info-open: MoreInfo {
