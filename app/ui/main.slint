// NSPanel Pro 86 panel UI: top bar, view tabs, native Home Assistant
// dashboard rows, the assistant mode home screen, and the full-screen
// layers (details, settings, screensaver, pairing, camera, conversation,
// weather, media, messages).

import "./fonts/NotoSans[wdth,wght].ttf";
import "./fonts/SpaceGrotesk[wght].ttf";
import "./fonts/materialdesignicons-webfont.ttf";
import "./fonts/DejaVuSansMono.ttf";
import "./fonts/DejaVuSansMono-Bold.ttf";

import { Theme } from "theme.slint";
import { Icon, RoundButton, ChipRow, MarkButton } from "widgets.slint";
import { TileData, RowData, RowView } from "rows.slint";
import { MoreInfoData, MoreInfo, SettingsData, SettingsPage, Screensaver, PairingScreen, AssistPanel, TimerAlarm, FoundHa, SetupScreen, WifiNet, WifiScreen, WifiPasswordScreen, HiddenNetworkScreen, HaPickScreen, ConnectingScreen, OfflineScreen, Phrases } from "overlays.slint";
import { ForecastItem, AssistantData, AssistantHome, AssistFull, MessageCard, WeatherFull, MediaFull } from "assistant.slint";
import { Person, TimerInfo, ClockData, ClockFace, AssistantPage, WeatherHour, WeatherDay, WeatherData, WeatherPanel } from "panels.slint";
import { HomeItem, HomeEvent, HomeMusic, HomeGrid } from "home.slint";
import { PhotoSky } from "photo_sky.slint";
import { FastLane } from "fast_lane.slint";
import { MusicPlayer, MusicPage } from "music.slint";
import { TimerItem, AlarmItem, SwCar, TimersPage } from "timers.slint";
import { ClimateDev, ClimateRoom, ThermostatPage } from "thermostat.slint";
import { CamItem, CamAction, CameraPage } from "camera.slint";
import { TodoItem, TodoList, TodoPage } from "todo.slint";
import { CalEvent, CalDay, CalCell, CalBoard, WallCell, CalendarPage } from "calendar.slint";
import { InfoNote, InfoPage } from "info.slint";
import { StatusScreen, StatusPage, TopStrip } from "status.slint";
import { VoicePage } from "voice.slint";
import { QuickTile, QuickGroup, QuickPage } from "quick.slint";
import { SetRow, SetBar, SetSeg, SetSection, SettingsLayer } from "settings.slint";

export { HomeItem, HomeEvent, HomeMusic, MusicPlayer, TimerItem, AlarmItem }
export { Theme, TileData, RowData, MoreInfoData, SettingsData, ForecastItem, AssistantData, FoundHa, WifiNet, Person, TimerInfo, ClockData, WeatherHour, WeatherDay, WeatherData }

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: Theme.background;
    default-font-family: "Noto Sans";

    in property <string> time: "--:--";
    in property <string> date: "";
    in property <string> long-date: "";
    in property <bool> paired: false;
    in property <image> qr;
    in property <string> pair-hint: "";
    in property <string> pair-url: "";
    in property <string> pair-ha-url: "";      // Home Assistant the code logs in to
    in property <int> pair-state: 0;           // 0 waiting, 1 logged in, 2 failed
    in property <int> pair-variant: 0;         // random, picked when the screen opens
    // First connection to Home Assistant (after pairing / late data)
    in property <bool> connecting: false;
    in property <bool> connect-slow: false;
    in property <float> connect-progress: 0;
    in property <int> connect-step: 0;
    in property <int> connect-variant: 0;
    // Nothing to connect to yet: 1 no network, 2 Home Assistant not answering
    in property <int> offline-cause: 0;
    in property <float> offline-retry-start: 0;
    in property <float> offline-retry-total: 0;
    in property <int> offline-variant: 0;
    // Assistant mode panels (new design)
    in property <string> panel: "";            // "clock", ...
    in property <int> panel-variant: 0;
    in property <ClockData> clock;
    in property <float> clock-speed: 20;     // wandering clock, px/s
    in property <WeatherData> weather;
    // home page: widgets on the living weather background
    in property <[HomeItem]> home-items;
    // thermostat panel: the climate devices, the one on the dial, the rooms (device picker), the options sheet
    in property <[ClimateDev]> thermo-devices;
    in property <int> thermo-sel;
    in property <[ClimateRoom]> thermo-rooms;
    in property <bool> thermo-picker;
    in property <bool> thermo-sheet;
    in property <bool> thermo-settings;
    in property <int> thermo-look;            // 0 dial, 1 remote control, 2 wall thermostat, 3 neon (synthwave, the home page's Fast Lane views)
    in property <float> thermo-pulse: 1;
    in property <int> thermo-key-down: -1;
    in property <bool> thermo-fahrenheit;
    in property <int> thermo-clock-h;
    in property <int> thermo-clock-m;
    // camera panel: the cameras, the one shown, one / all, whole picture / fill, the blurred copy, linked entities;
    // the visitor overlay (doorbell)
    in property <[CamItem]> cam-items;
    in property <int> cam-sel;
    in property <int> cam-view;
    in property <int> cam-fit;
    in property <image> cam-bg;
    in property <[color]> cam-bg-corners;
    in property <[CamAction]> cam-actions;
    in property <bool> cam-settings;
    in property <length> cam-grid-scroll;
    in property <bool> cam-ring;
    in property <image> cam-ring-frame;
    in property <image> cam-ring-bg;
    in property <string> cam-ring-title;
    in property <string> cam-ring-sub;
    in property <[CamAction]> cam-ring-state;
    in property <bool> cam-can-open;
    in property <bool> cam-can-talk;
    in property <float> cam-hold;
    in property <float> cam-pulse: 1;
    in property <bool> cam-replies;
    in property <[string]> cam-reply-list;
    in property <int> info-look;
    in property <[InfoNote]> info-notes;
    in property <length> info-scroll;
    in property <string> info-empty-title;
    in property <string> info-empty-sub;
    in property <bool> info-card;
    in property <InfoNote> info-card-note;
    in property <int> info-card-index;
    in property <int> info-card-count;
    in property <bool> info-critical;
    in property <string> info-crit-title;
    in property <string> info-crit-message;
    in property <string> info-crit-icon;
    in property <string> info-crit-source;
    in property <float> info-crit-hold;
    in property <float> info-crit-pulse: 1;
    in property <bool> info-settings;
    in property <string> info-clock;
    in property <string> info-pager-empty;
    in property <string> info-news-ticker;
    in property <string> info-news-empty;
    in property <image> info-fridge-door;
    in property <image> info-fridge-empty;
    in property <image> info-pager-body;
    in property <image> info-pager-led;
    in property <bool> info-crit-button: true;
    in property <int> quick-look;
    in property <[QuickTile]> quick-tiles;
    in property <string> quick-title: "Quick controls";
    in property <string> quick-mood;
    in property <string> quick-placard;
    in property <bool> quick-sheet;
    in property <QuickTile> quick-sheet-tile;
    in property <image> quick-mixer-panel; in property <image> quick-fader; in property <image> quick-deck-panel;
    in property <image> quick-toggle-up; in property <image> quick-toggle-down; in property <image> quick-lamp-on;
    in property <image> quick-lamp-amber; in property <image> quick-lamp-off; in property <image> quick-screw;
    in property <image> quick-lamp-glow; in property <image> quick-lamp-spec; in property <int> quick-grid;
    in property <float> quick-sheet-temp: -1; in property <string> quick-sheet-temp-text; in property <[color]> quick-sheet-colours;
    in property <[string]> quick-sheet-effects;
    in property <[QuickGroup]> quick-groups;
    // status screens (whole screen, above any panel) and the strip on top while one (or a critical alert) is active
    in property <bool> status-on;
    in property <StatusScreen> status-screen;
    in property <float> conn-morse-t;
    in property <int> set-view;
    in property <string> set-shade-title; in property <float> set-brightness; in property <float> set-volume; in property <bool> set-mic-on: true;
    in property <string> set-mic-state; in property <string> set-theme-state; in property <bool> set-dnd; in property <string> set-dnd-state;
    in property <string> set-sleep-state; in property <string> set-lock-title; in property <float> set-hold; in property <string> set-title;
    in property <[SetRow]> set-rows; in property <string> set-tagline; in property <string> set-page-title; in property <string> set-page-sub;
    in property <float> set-used; in property <string> set-used-text; in property <[SetBar]> set-bars; in property <[SetSection]> set-sections; in property <string> set-confirm-title;
    in property <string> set-confirm-line;
    in property <bool> voice-on;
    in property <int> voice-look;
    in property <int> voice-state: 1;
    in property <string> voice-assistant;
    in property <string> voice-heard;
    in property <string> voice-answer;
    in property <string> voice-line;
    in property <string> voice-detail;
    in property <float> voice-level;
    in property <float> voice-left: -1;
    in property <string> voice-wave;
    in property <image> voice-scan;
    in property <image> voice-dots;
    in property <bool> voice-blink: true;
    in property <bool> strip-on;
    in property <string> strip-title;
    in property <string> strip-sub;
    in property <string> strip-icon;
    in property <image> strip-picto;
    in property <bool> strip-has-picto;
    in property <color> strip-tint;
    in property <bool> strip-critical;
    in property <float> strip-pulse: 1;
    in property <int> cal-view;
    in property <int> cal-look;
    in property <[CalBoard]> cal-board-rows;
    in property <string> cal-board-clock;
    in property <string> cal-board-date;
    in property <string> cal-board-ticker;
    in property <string> cal-board-empty;
    in property <string> cal-tear-month;
    in property <int> cal-tear-day;
    in property <string> cal-tear-weekday;
    in property <bool> cal-tear-sunday;
    in property <string> cal-tear-info;
    in property <[CalEvent]> cal-tear-events;
    in property <string> cal-tear-more;
    in property <string> cal-tear-line;
    in property <string> cal-wall-month;
    in property <string> cal-wall-year;
    in property <image> cal-wall-photo;
    in property <[WallCell]> cal-wall-cells;
    in property <string> cal-title;
    in property <string> cal-sub;
    in property <length> cal-scroll;
    in property <[CalDay]> cal-agenda;
    in property <string> cal-empty-title;
    in property <string> cal-empty-sub;
    in property <[CalEvent]> cal-day-events;
    in property <[CalEvent]> cal-day-allday;
    in property <bool> cal-day-today;
    in property <string> cal-day-free;
    in property <int> cal-now-min;
    in property <[string]> cal-week-names;
    in property <[int]> cal-week-nums;
    in property <int> cal-week-today: -1;
    in property <[CalEvent]> cal-week-events;
    in property <[CalEvent]> cal-week-allday;
    in property <[string]> cal-month-names;
    in property <[CalCell]> cal-month-cells;
    in property <bool> cal-edit;
    in property <string> cal-edit-title;
    in property <string> cal-edit-cal;
    in property <color> cal-edit-tint;
    in property <string> cal-edit-day;
    in-out property <bool> cal-edit-allday;
    in-out property <int> cal-edit-start-min;
    in-out property <int> cal-edit-end-min;
    in property <bool> cal-edit-typing;
    in property <bool> cal-edit-can-delete;
    in property <bool> cal-settings;
    in property <bool> cal-detail;
    in property <CalEvent> cal-detail-ev;
    in property <string> cal-detail-when;
    in property <[TodoList]> todo-lists;
    in property <int> todo-sel;
    in property <[TodoItem]> todo-open;
    in property <[TodoItem]> todo-done;
    in property <bool> todo-show-done;
    in property <length> todo-scroll;
    in property <bool> todo-picker;
    in property <string> todo-empty-title;
    in property <string> todo-empty-sub;
    in property <bool> todo-adding;
    in property <string> todo-draft;
    in property <bool> todo-can-due;
    in property <int> todo-due-pick: -1;
    in property <string> todo-due-picked;
    in property <int> todo-kb-layer;
    in property <int> todo-look;
    in property <bool> todo-settings;
    in property <string> todo-stamp;
    in property <string> todo-receipt-footer;
    in property <string> todo-receipt-empty;
    in property <string> todo-term-empty;
    in property <image> todo-label-head;
    in property <image> todo-label-done-head;
    in property <image> todo-label-empty-tape;
    in property <image> todo-note-head;
    in property <image> todo-note-done;
    in property <image> todo-note-empty;
    // home background "In the Fast Lane" (weather.theme 8): scene, the two views being faded (a -> b by mix),
    // the view's colour, night amount (shooting star), floor time, cars (empty = switched off), palms,
    // neon letters, and the panel's background sheet
    in property <int> home-fl-scene;
    in property <image> home-fl-back-a;
    in property <image> home-fl-floor-a;
    in property <image> home-fl-back-b;
    in property <image> home-fl-floor-b;
    in property <float> home-fl-mix;
    in property <color> home-fl-grid: #ff2bd6;
    in property <float> home-fl-star;
    in property <float> home-fl-t;
    in property <[SwCar]> home-fl-cars;
    in property <bool> home-fl-cars-on: true;
    in property <int> home-fl-palm-il: 16;
    in property <int> home-fl-palm-ir: 16;
    in property <bool> home-fl-neon;
    in property <bool> home-bg-sheet;
    in property <HomeMusic> home-music;
    in property <HomeEvent> home-event;
    in property <string> home-weekday: "Monday";
    in property <string> home-day-month: "9 November";
    in property <bool> home-editing;
    in property <int> home-lifted: -1;
    in property <length> home-lift-dx;
    in property <length> home-lift-dy;
    in property <int> home-drop-col: -1;
    in property <int> home-drop-row: -1;
    in property <bool> home-picker;
    in property <length> home-picker-scroll;
    in property <bool> home-ha;                // the editor as Home Assistant shows it (no lock, its own controls)
    in property <int> home-selected: -1;
    in property <bool> home-lock;
    in property <float> home-lock-p;
    in property <string> home-lock-title: "Redecorating again?";
    in property <string> home-lock-sub: "Hold the lock to start editing.";
    in property <int> home-settings: -1;
    in property <bool> home-info;
    // music page
    in property <string> music-title;
    in property <string> music-artist;
    in property <string> music-album;
    in property <bool> music-playing;
    in property <float> music-pos;
    in property <float> music-dur;
    in property <bool> music-shuffle;
    in property <int> music-repeat;
    in property <float> music-volume: 0.5;
    in property <string> music-player;
    in property <image> music-art;
    in property <image> music-art-bg;
    in property <bool> music-has-art: true;
    in property <string> music-kind-icon: "\u{F0387}";
    in property <color> music-accent: #e8262d;
    in property <[MusicPlayer]> music-players;
    in property <bool> music-picker;
    in property <int> music-style;
    in property <int> music-tape-scope;
    in property <float> music-q-played;
    in property <float> music-q-total;
    in property <int> music-q-index;
    in property <int> music-q-count;
    in property <image> music-tt-deck;
    in property <image> music-tt-grooves;
    in property <image> music-cs-back;
    in property <image> music-cs-front;
    in property <image> music-cs-hub;
    in property <image> music-cs-hub-r;
    in property <float> music-tt-arm-r: -1;
    in property <float> music-tt-lift: -1;
    in property <float> music-tape-rem: -1;
    in property <bool> music-scroll;
    in property <float> music-scroll-speed: 3;
    in property <bool> music-settings;
    // timers page
    in property <[TimerItem]> timers-list;
    in property <bool> timers-ringing;
    in property <string> timers-ring-label;
    in property <float> timers-ring-over;
    in property <float> timers-pulse;
    in property <int> timers-mode: 1;
    in property <int> timers-theme;
    in property <int> timers-focus;
    in property <[AlarmItem]> timers-alarms;
    in property <string> timers-next-alarm;
    in property <float> timers-watch;
    in property <bool> timers-watch-running;
    in property <[float]> timers-laps;
    in property <bool> timers-ring-alarm;
    in property <string> timers-ring-time;
    in property <color> timers-ring-tint: #e8262d;
    in property <bool> timers-settings;
    in property <bool> timers-colourful: true;
    in property <bool> timers-alarm-on: true;
    in property <bool> timers-timer-on: true;
    in property <bool> timers-watch-on: true;
    in property <color> timers-next-tint: #ffb21e;
    in property <color> timers-watch-tint: #3d9bff;
    in property <image> timers-hg-sand-mask;
    in property <image> timers-hg-sand-shade;
    in property <float> timers-hg-peak: 214;
    in property <image> timers-hg-stream-mask;
    in property <image> timers-hg-stream-shade;
    in property <int> timers-sw-scene;
    in property <int> timers-sw-choice: -1;
    in property <image> timers-sw-back;
    in property <image> timers-sw-floor;
    in property <float> timers-sw-t;
    in property <[SwCar]> timers-sw-cars;
    in property <int> timers-sw-palm-il: 16;
    in property <int> timers-sw-palm-ir: 16;
    in property <bool> timers-edit;
    in property <bool> timers-edit-new: true;
    in property <int> timers-edit-h: 6;
    in property <int> timers-edit-m: 45;
    in property <[bool]> timers-edit-days: [true, true, true, true, true, false, false];
    in property <string> timers-edit-label;
    in property <int> timers-edit-sound;
    in property <string> timers-edit-ha-sound;
    in property <bool> timers-edit-keyboard;
    in property <bool> timers-edit-info;
    in property <color> timers-edit-tint: #ffb21e;
    in property <int> music-holds;
    in property <int> music-wood;
    in property <[image]> music-woods;
    in property <string> home-year: "2026";
    in property <string> home-week: "Week 46";
    in property <image> weather-sky-frame;   // optional per-frame sky from the app (radial cloud flow)
    in property <float> panel-appear: 1;
    in property <bool> weather-details: true;
    in property <bool> weather-hours: true;
    in property <bool> weather-days: true;
    in property <[Person]> people;
    in property <bool> show-people: true;
    in property <int> page-count: 6;
    in property <int> page: 0;
    in property <float> dots-shown: 1;
    in property <string> wake-hint: "";
    in property <[TimerInfo]> timers;
    in property <bool> screensaver-mode: false;
    in property <color> clock-accent: Theme.accent;
    in property <int> clock-weight: 600;
    in property <bool> clock-date: true;
    in property <bool> clock-weather: true;
    in property <bool> clock-next: true;
    in property <bool> clock-seconds: true;
    in property <string> status: "";
    in property <bool> connected: false;
    in property <string> header-info: "";
    in property <[RowData]> rows;
    in property <[string]> views;
    in property <int> view-index: 0;
    in property <image> camera-image;
    in-out property <bool> camera-full: false;
    in property <MoreInfoData> more-info;
    in-out property <bool> more-info-open: false;
    in property <SettingsData> settings;
    in property <[string]> screensaver-labels;
    in-out property <bool> settings-open: false;
    in property <bool> screensaver: false;
    in property <bool> screensaver-black: false;
    in property <string> saver-info: "";
    in property <string> saver-icon: "";
    in property <int> assist-state: 0;
    in property <string> assist-heard: "";
    in property <string> assist-answer: "";
    in property <string> timer-text: "";
    in property <bool> timer-ringing: false;
    in property <string> timer-name: "";
    in property <bool> mic-muted: false;
    // Hand-over from the boot splash
    in property <image> intro-logo;
    in property <length> intro-x;
    in property <length> intro-y;
    in-out property <bool> intro: true;
    in-out property <bool> intro-visible: true;
    // Assistant mode
    in property <int> display-mode: 0;          // 0 dashboard, 1 assistant
    in-out property <bool> show-dashboard: false; // assistant mode: dashboard opened for a while
    in property <AssistantData> assistant;
    in property <[RowData]> assistant-rows;
    in property <image> media-art;
    in property <bool> has-art: false;
    in property <bool> assist-full: false;     // full-screen conversation
    in-out property <bool> message-open: false;
    in property <string> message-title: "";
    in property <string> message-text: "";
    in property <string> message-icon: "";
    in-out property <bool> weather-open: false;
    in-out property <bool> media-open: false;
    in property <int> assistant-reset: 0;      // change it to scroll the home screen to the top
    // First-start setup (no settings yet)
    in property <bool> setup: false;
    in property <[FoundHa]> setup-found;
    in-out property <string> setup-address: "";
    in property <string> setup-message: "";
    in property <int> setup-message-kind: 0;   // 0 info, 1 error, 2 success
    in property <int> setup-variant: 0;        // random, picked when the setup screen opens
    in property <bool> setup-pick-open: false; // several Home Assistants found: the list
    in property <string> net-name: "";         // Wi-Fi the panel is on
    in property <int> net-bars: 4;             // its signal, 1..4
    in property <string> net-ip: "";           // the panel's own address
    in property <bool> setup-wifi-info: false; // preview: the Wi-Fi info card open
    in property <bool> setup-busy: false;
    // First start without network: Wi-Fi network list
    in property <bool> wifi-setup: false;
    in property <[WifiNet]> wifi-networks;
    in property <bool> wifi-scanning: false;
    in property <int> wifi-variant: 0;     // random, picked when the screen opens
    in property <int> theme-mode: 2;       // 0 light, 1 dark, 2 auto (light sensor)
    // Wi-Fi password of the picked network
    in property <bool> wifi-password-open: false;
    in property <string> wifi-ssid: "";
    in property <string> wifi-shown-text: "";
    in property <bool> wifi-show-password: false;
    in property <int> wifi-key-layer: 0;
    in property <string> wifi-message: "";
    in property <int> wifi-message-kind: 0;
    in property <bool> wifi-busy: false;
    in property <string> kb-held-key: "";
    in property <[string]> kb-popup-options;
    in property <length> kb-popup-x;
    in property <length> kb-popup-y;
    in property <int> kb-popup-selected: -1;
    in property <int> kb-layout: 0;        // 0 Latin, 1 Cyrillic
    // Hidden network: name and password typed
    in property <bool> hidden-open: false;
    in property <string> hidden-name: "";
    in property <int> hidden-focus: 0;
    property <bool> dashboard-visible: root.display-mode == 0 || root.show-dashboard;

    out property <length> scroll-y: flick.content-y;
    out property <length> list-height: flick.height;
    property <length> tabs-height: root.views.length > 1 ? 52px : 0px;

    callback action(string, string);
    callback view-selected(int);
    callback more-info-slider(string, float);
    callback more-info-select(string, int);
    callback more-info-action(string);
    callback more-info-closed();
    callback settings-opened();
    callback setting-changed(string, string);
    callback wake();
    callback stop-timer();
    callback dismiss-assist();
    callback media-action(string);
    callback media-volume(float);
    callback overlay-closed();
    callback scroll-by(length);
    callback setup-pick(string);
    callback setup-key(string);
    callback setup-connect();
    callback setup-change-wifi();
    callback setup-choose-many();
    callback setup-pick-back();
    callback wifi-pick(string);
    callback wifi-rescan();
    callback wifi-other();
    callback theme-mode-changed(int);
    callback wifi-password-back();
    callback wifi-password-key(string);
    callback wifi-password-toggle-show();
    callback hidden-focus-field(int);
    scroll-by(d) => {
        flick.content-y = max(min(0px, flick.content-y - d), flick.height - flick.content-height);
    }
    public function scroll-top() {
        flick.content-y = 0px;
    }

    // Top bar: clock, date / page title, connection state, settings.
    Rectangle {
        height: 64px;
        y: 0;
        visible: root.paired && root.dashboard-visible;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 10px;
            spacing: 12px;
            Text {
                text: root.time;
                font-size: 34px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.date; font-size: 14px; color: Theme.muted; overflow: elide; }
                Text { text: root.header-info; font-size: 14px; color: Theme.muted; overflow: elide; }
            }
            if root.timer-text != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: timer-row.preferred-width + 20px;
                    border-radius: 16px;
                    background: #f59e0b30;
                    timer-row := HorizontalLayout {
                        x: 10px;
                        spacing: 4px;
                        Icon { text: "\u{F051B}"; font-size: 18px; color: #f59e0b; }
                        Text { text: root.timer-text; font-size: 15px; color: Theme.text; vertical-alignment: center; }
                    }
                }
            }
            if root.mic-muted: VerticalLayout {
                alignment: center;
                Icon { text: "\u{F036D}"; font-size: 22px; color: #ef4444; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.connected ? #22c55e : #ef4444;
                }
            }
            if root.display-mode == 1: VerticalLayout {
                alignment: center;
                RoundButton {
                    icon: "\u{F02DC}";
                    size: 40px;
                    tint: Theme.muted;
                    clicked => { root.show-dashboard = false; }
                }
            }
            VerticalLayout {
                alignment: center;
                MarkButton {
                    size: 40px;
                    clicked => {
                        root.settings-open = true;
                        root.settings-opened();
                    }
                }
            }
        }
    }

    if root.paired && root.dashboard-visible && root.views.length > 1: ChipRow {
        x: 16px;
        y: 64px;
        width: root.width - 32px;
        items: root.views;
        selected: root.view-index;
        picked(i) => { root.view-selected(i); }
    }

    flick := Flickable {
        y: 64px + root.tabs-height;
        height: root.height - 64px - root.tabs-height;
        width: root.width;
        content-height: list.preferred-height;
        visible: root.paired && root.dashboard-visible;
        list := VerticalLayout {
            width: root.width;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 4px;
            padding-bottom: 20px;
            spacing: 8px;
            for row in root.rows: RowView {
                data: row;
                camera-frame: root.camera-image;
                act(e, a) => { root.action(e, a); }
                camera-full => { root.camera-full = true; }
            }
            if root.rows.length == 0: Text {
                text: root.status;
                font-size: 16px;
                color: Theme.muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    if root.paired && !root.dashboard-visible: AssistantHome {
        reset: root.assistant-reset;
        time: root.time;
        date: root.long-date;
        data: root.assistant;
        rows: root.assistant-rows;
        art: root.media-art;
        has-art: root.has-art;
        camera-frame: root.camera-image;
        connected: root.connected;
        mic-muted: root.mic-muted;
        timer-text: root.timer-text;
        act(e, a) => { root.action(e, a); }
        media-act(a) => { root.media-action(a); }
        open-media => { root.media-open = true; }
        open-weather => { root.weather-open = true; }
        open-dashboard => { root.show-dashboard = true; }
        open-settings => {
            root.settings-open = true;
            root.settings-opened();
        }
        camera-full => { root.camera-full = true; }
    }

    if !root.paired: PairingScreen {
        qr: root.qr;
        hint: root.pair-hint;
        ha-url: root.pair-ha-url;
        state: root.pair-state;
        variant: root.pair-variant;
        theme-mode: root.theme-mode;
        wifi-bars: root.net-bars;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    if root.connecting: ConnectingScreen {
        morse-t: root.conn-morse-t;
        ha-url: root.pair-ha-url;
        slow: root.connect-slow;
        progress: root.connect-progress;
        step: root.connect-step;
        variant: root.connect-variant;
        theme-mode: root.theme-mode;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    if root.offline-cause > 0: OfflineScreen {
        morse-t: root.conn-morse-t;
        cause: root.offline-cause;
        retry-start: root.offline-retry-start;
        retry-total: root.offline-retry-total;
        net-name: root.net-name;
        ha-url: root.pair-ha-url;
        variant: root.offline-variant;
        theme-mode: root.theme-mode;
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    if root.panel != "": AssistantPage {
        hint: root.wake-hint;
        mic-muted: root.mic-muted;
        timers: root.timers;
        problem: !root.connected;
        page-count: root.page-count;
        page: root.page;
        dots-shown: root.dots-shown;
        people: root.people;
        show-people: root.show-people;
        screensaver: root.screensaver-mode;
        on-color: (root.panel == "weather" && root.panel-variant == 1) || root.panel == "home" || (root.panel == "music" && !(root.music-style == 1 && !Theme.dark)) || (root.panel == "timers" && (root.timers-ringing || (root.timers-theme == 3 && root.timers-mode == 1))) || (root.panel == "thermostat" && root.thermo-look == 3) || (root.panel == "todo" && root.todo-look == 2) || (root.panel == "calendar" && root.cal-look == 1) || (root.panel == "info" && (root.info-critical || root.info-look == 3)) || root.status-on || (root.panel == "quick" && root.quick-look > 0) || (root.panel == "camera" && (root.cam-ring || (root.cam-view == 0 && root.cam-items.length > 0 && root.cam-items[root.cam-sel].state == 0 && (root.cam-fit == 0 || Theme.dark))));
        if root.panel == "timers": TimersPage {
            timers: root.timers-list; ringing: root.timers-ringing; ring-label: root.timers-ring-label; ring-over: root.timers-ring-over;
            pulse: root.timers-pulse; mode: root.timers-mode; theme: root.timers-theme; pick: root.timers-focus; alarms: root.timers-alarms;
            next-alarm: root.timers-next-alarm; watch: root.timers-watch; watch-running: root.timers-watch-running; laps: root.timers-laps;
            ring-alarm: root.timers-ring-alarm; ring-time: root.timers-ring-time; ring-tint: root.timers-ring-tint; settings: root.timers-settings;
