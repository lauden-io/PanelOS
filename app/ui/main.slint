            next-tint: root.timers-next-tint; watch-tint: root.timers-watch-tint;
            hg-sand-mask: root.timers-hg-sand-mask; hg-sand-shade: root.timers-hg-sand-shade; hg-peak: root.timers-hg-peak;
            hg-stream-mask: root.timers-hg-stream-mask; hg-stream-shade: root.timers-hg-stream-shade;
            sw-scene: root.timers-sw-scene; sw-choice: root.timers-sw-choice; sw-back: root.timers-sw-back; sw-floor: root.timers-sw-floor; sw-t: root.timers-sw-t;
            sw-cars: root.timers-sw-cars; sw-palm-il: root.timers-sw-palm-il; sw-palm-ir: root.timers-sw-palm-ir;
            edit: root.timers-edit; edit-new: root.timers-edit-new; edit-h: root.timers-edit-h; edit-m: root.timers-edit-m; edit-days: root.timers-edit-days;
            edit-label: root.timers-edit-label; edit-sound: root.timers-edit-sound; edit-ha-sound: root.timers-edit-ha-sound; edit-keyboard: root.timers-edit-keyboard;
            edit-info: root.timers-edit-info; edit-tint: root.timers-edit-tint;
        }
        if root.panel == "thermostat" && root.thermo-look == 3: FastLane {
            scene: root.home-fl-scene; back-a: root.home-fl-back-a; floor-a: root.home-fl-floor-a; back-b: root.home-fl-back-b; floor-b: root.home-fl-floor-b;
            mix: root.home-fl-mix; grid: root.home-fl-grid; star-k: root.home-fl-star; t: root.home-fl-t; cars: root.home-fl-cars;
            palm-il: root.home-fl-palm-il; palm-ir: root.home-fl-palm-ir;
        }
        if root.panel == "quick": QuickPage {
            look: root.quick-look; tiles: root.quick-tiles; title: root.quick-title; mood: root.quick-mood; placard: root.quick-placard;
            sheet: root.quick-sheet; sheet-tile: root.quick-sheet-tile; mixer-panel: root.quick-mixer-panel; fader: root.quick-fader;
            deck-panel: root.quick-deck-panel; toggle-up: root.quick-toggle-up; toggle-down: root.quick-toggle-down; lamp-glow: root.quick-lamp-glow; lamp-spec: root.quick-lamp-spec;
            grid: root.quick-grid; sheet-colours: root.quick-sheet-colours;
