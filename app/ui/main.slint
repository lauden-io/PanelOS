            fridge-door: root.info-fridge-door; fridge-empty: root.info-fridge-empty;
            pager-body: root.info-pager-body; pager-led: root.info-pager-led; crit-button: root.info-crit-button;
        }
        if root.panel == "calendar": CalendarPage {
