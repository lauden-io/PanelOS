            settings: root.thermo-settings; look: root.thermo-look; pulse: root.thermo-pulse; clock-h: root.thermo-clock-h; clock-m: root.thermo-clock-m; key-down: root.thermo-key-down; fahrenheit: root.thermo-fahrenheit;
            grid: root.home-fl-grid; fl-scene: root.home-fl-scene; fl-cars: root.home-fl-cars-on;
        }
