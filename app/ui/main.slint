            root.more-info-closed();
        }
        slider(what, v) => { root.more-info-slider(what, v); }
        select(what, i) => { root.more-info-select(what, i); }
        act(a) => { root.more-info-action(a); }
    }

    if root.weather-open: WeatherFull {
        data: root.assistant;
        close => {
            root.weather-open = false;
            root.overlay-closed();
        }
    }

    if root.media-open: MediaFull {
        data: root.assistant;
        art: root.media-art;
        has-art: root.has-art;
        close => {
            root.media-open = false;
            root.overlay-closed();
        }
        act(a) => { root.media-action(a); }
        volume(v) => { root.media-volume(v); }
    }

    if root.camera-full: Rectangle {
        background: #000000;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.camera-image;
            image-fit: contain;
        }
        TouchArea {
            clicked => {
                root.camera-full = false;
                root.overlay-closed();
            }
        }
    }

    if root.settings-open: SettingsPage {
        data: root.settings;
        screensaver-labels: root.screensaver-labels;
        close => { root.settings-open = false; }
        changed(k, v) => { root.setting-changed(k, v); }
    }

    if root.screensaver: Screensaver {
        time: root.time;
        date: root.date;
        info: root.saver-info;
        info-icon: root.saver-icon;
        black: root.screensaver-black;
        wake => { root.wake(); }
    }

    if root.message-open: MessageCard {
        title: root.message-title;
        message: root.message-text;
        icon: root.message-icon;
        dismiss => {
            root.message-open = false;
            root.overlay-closed();
        }
    }

    if root.assist-state > 0 && root.assist-full: AssistFull {
        state: root.assist-state;
        heard: root.assist-heard;
        answer: root.assist-answer;
        dismiss => { root.dismiss-assist(); }
    }

    if root.assist-state > 0 && !root.assist-full: AssistPanel {
        x: 10px;
        y: root.height - self.height - 10px;
        width: root.width - 20px;
        state: root.assist-state;
        heard: root.assist-heard;
        answer: root.assist-answer;
        dismiss => { root.dismiss-assist(); }
    }

    if root.timer-ringing: TimerAlarm {
        name: root.timer-name;
        stop => { root.stop-timer(); }
    }

    if root.setup: SetupScreen {
        found: root.setup-found;
        address: root.setup-address;
        message: root.setup-message;
        message-kind: root.setup-message-kind;
        variant: root.setup-variant;
        theme-mode: root.theme-mode;
        wifi-name: root.net-name;
        wifi-bars: root.net-bars;
        wifi-ip: root.net-ip;
        wifi-info-open: root.setup-wifi-info;
        change-wifi => { root.setup-change-wifi(); }
        choose-many => { root.setup-choose-many(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
        busy: root.setup-busy;
        pick(url) => { root.setup-pick(url); }
        key(k) => { root.setup-key(k); }
        connect => { root.setup-connect(); }
    }

    if root.setup-pick-open: HaPickScreen {
        found: root.setup-found;
        variant: root.setup-variant;
        theme-mode: root.theme-mode;
        back => { root.setup-pick-back(); }
        pick(url) => { root.setup-pick(url); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    if root.wifi-setup: WifiScreen {
        networks: root.wifi-networks;
        scanning: root.wifi-scanning;
        variant: root.wifi-variant;
        theme-mode: root.theme-mode;
        theme-changed(m) => { root.theme-mode-changed(m); }
        pick(ssid) => { root.wifi-pick(ssid); }
        rescan => { root.wifi-rescan(); }
        other => { root.wifi-other(); }
    }

    if root.wifi-password-open: WifiPasswordScreen {
        ssid: root.wifi-ssid;
        shown-text: root.wifi-shown-text;
        show: root.wifi-show-password;
        layer: root.wifi-key-layer;
        layout: root.kb-layout;
        message: root.wifi-message;
        message-kind: root.wifi-message-kind;
        busy: root.wifi-busy;
        variant: root.wifi-variant;
        held-key: root.kb-held-key;
        popup-options: root.kb-popup-options;
        popup-x: root.kb-popup-x;
        popup-y: root.kb-popup-y;
        popup-selected: root.kb-popup-selected;
        theme-mode: root.theme-mode;
        back => { root.wifi-password-back(); }
        key(k) => { root.wifi-password-key(k); }
        toggle-show => { root.wifi-password-toggle-show(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    if root.hidden-open: HiddenNetworkScreen {
        name: root.hidden-name;
        shown-password: root.wifi-shown-text;
        show: root.wifi-show-password;
        field: root.hidden-focus;
        layer: root.wifi-key-layer;
        layout: root.kb-layout;
        message: root.wifi-message;
        message-kind: root.wifi-message-kind;
        busy: root.wifi-busy;
        variant: root.wifi-variant;
        theme-mode: root.theme-mode;
        back => { root.wifi-password-back(); }
        key(k) => { root.wifi-password-key(k); }
        focus-field(i) => { root.hidden-focus-field(i); }
        toggle-show => { root.wifi-password-toggle-show(); }
        theme-changed(m) => { root.theme-mode-changed(m); }
    }

    // Hand-over from the boot splash: its last frame (logo and text on
    // black, same pixels), then it fades into the UI.
    if root.intro-visible: Rectangle {
        background: #000000;
        opacity: root.intro ? 1 : 0;
        animate opacity { duration: 500ms; easing: ease-in-out; }
        Image {
            x: root.intro-x;
            y: root.intro-y;
            source: root.intro-logo;
        }
    }
}
