            accent: root.clock-accent;
            weight: root.clock-weight;
            show-date: root.clock-date;
            show-weather: root.clock-weather;
            show-next: root.clock-next;
            show-seconds: root.clock-seconds;
            wander-speed: root.clock-speed;
        }
