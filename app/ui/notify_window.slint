// The new-notification window (spec 30): centred under the status bar over a 55 % scrim, in the notifications page's
// look (plain card, fridge note, pager, TV news), with Dismiss / OK (or the notification's own buttons), "i of n" for
// several, a sideways swipe or the arrows to step, the time it stays (a finger holds it) or "until answered".

import { Theme, Act } from "theme.slint";
import { Icon, Crawl, Jelly } from "widgets.slint";
import { InfoNote, PlainCard, NoteTime } from "info.slint";

export component NotifWindow inherits Rectangle {
    in property <bool> on;
    in property <[InfoNote]> notes;
    in property <int> index;
    in property <int> count;
    in property <int> look;               // 0 plain, 1 fridge notes, 2 pager, 3 TV news
    in property <bool> until;             // until answered: no time, a tap beside it only nudges it
    in property <float> seconds: 10;
    in property <int> minute: -1;         // the clock (minutes of the day) for the pager and the news window
    in property <image> pager;            // the pager device (375 × 320, drawn at its size)
    in property <image> led;
    property <InfoNote> n: root.index >= 0 && root.index < root.notes.length ? root.notes[root.index] : { title: "" };
    // ---- opening and closing
    property <float> scrim-k: root.on ? 1 : 0;
    animate scrim-k { duration: 200ms; easing: ease-out; }
    property <duration> op-t0;
    property <bool> opening;
    property <bool> closing;
    changed on => {
        if root.on { root.op-t0 = animation-tick(); root.opening = true; root.closing = false; root.el = 0; root.last-index = root.index; }
        else { root.op-t0 = animation-tick(); root.closing = true; root.opening = false; }
    }
    Timer { interval: 1000ms; running: root.opening; triggered => { root.opening = false; } }
    Timer { interval: 230ms; running: root.closing; triggered => { root.closing = false; } }
    property <float> ot: root.opening ? (animation-tick() - root.op-t0) / 1ms : 100000;
    property <float> ct: root.closing ? (animation-tick() - root.op-t0) / 1ms : 0;
    property <bool> shown: root.on || root.closing;
    // ---- stepping (index changes): the direction and when
    property <int> last-index;
    property <int> dir: 1;
    property <duration> st-t0;
    property <bool> stepping;
    property <InfoNote> prev-n;
    property <InfoNote> cur-n;
    changed index => {
        if root.on && !root.opening {
            root.dir = root.index >= root.last-index ? 1 : -1;
            root.prev-n = root.cur-n;
            root.st-t0 = animation-tick(); root.stepping = true;
        }
        root.last-index = root.index; root.el = 0;
    }
    changed n => { root.cur-n = root.n; }
    init => { root.cur-n = root.n; }
    Timer { interval: 700ms; running: root.stepping; triggered => { root.stepping = false; } }
    property <float> stt: root.stepping ? (animation-tick() - root.st-t0) / 1ms : 100000;
    // ---- the time: counts while nobody holds the window; over = closes as OK (left unread)
    property <float> el;
    property <bool> holding: hold-ta.pressed;
    Timer { interval: 50ms; running: root.on && !root.until && !root.holding;
        triggered => { root.el += 50; if root.el >= root.seconds * 1000 { root.el = 0; Act.act("pop.timeout", ""); } } }
    property <float> left: root.until ? 1 : clamp(1 - root.el / max(1, root.seconds * 1000), 0, 1);
    // ---- a tap beside it: OK (until answered: a small nudge)
    property <duration> nudge-t0;
    property <bool> nudging;
    Timer { interval: 300ms; running: root.nudging; triggered => { root.nudging = false; } }
    property <length> nudge: root.nudging ? 6px * Math.sin(720deg * (animation-tick() - root.nudge-t0) / 300ms) * (1 - (animation-tick() - root.nudge-t0) / 300ms) : 0px;
    // ---- the sideways swipe: the window follows the finger; past 80 px or a flick it steps, else springs back
    property <length> sw-dx;
    property <float> sw-v;
    property <length> sw-last;
    property <duration> sw-lt;
    property <length> back-from;
    property <duration> back-t0;
    property <bool> backing;
    Timer { interval: 520ms; running: root.backing; triggered => { root.backing = false; } }
    // (the pager device stays put while a sideways swipe steps its messages)
    property <length> dx: root.look == 2 ? 0px : hold-ta.pressed ? root.sw-dx : root.backing ? root.back-from * (1 - Jelly.edge((animation-tick() - root.back-t0) / 1ms, 70, 220)) : 0px;
    pure function c-of(i: int) -> string { root.count > 1 ? (i + 1) + " of " + root.count : "" }
    // the area under the status bar: y 46–480, its centre at y 263
    property <length> cy: 263px;
    if root.shown: Rectangle {
        background: #000000.with-alpha(0.55 * root.scrim-k);
        TouchArea { enabled: root.on; clicked => { if root.until { root.nudge-t0 = animation-tick(); root.nudging = true; } else { Act.act("pop.close", ""); } } }
    }
    // ------------------------------------------------------------------ the window (its box: the look's own size)
    property <length> win-w: root.look == 2 ? 375px : root.look == 1 ? 360px : 416px;
    property <length> win-h: root.look == 0 ? plain-h.preferred-height : root.look == 1 ? 300px + 18px + 44px + 14px : root.look == 2 ? 320px + 10px + 44px : news-h.preferred-height;
    property <length> wx: (root.width - root.win-w) / 2 + root.dx + root.nudge;
    property <length> wy: root.cy - root.win-h / 2;
    // hidden copies that give the plain card's and the news window's heights
    Rectangle { visible: false;
    plain-h := VerticalLayout { width: 416px; padding: 20px; padding-bottom: 22px; spacing: 10px;
        Rectangle { height: 44px; }
        Text { text: root.n.message; font-size: 16px; wrap: word-wrap; max-height: 112px; width: 376px; }
        if root.n.has-image: Rectangle { height: 196px; }
        Rectangle { height: 16px + 44px; } }
    news-h := VerticalLayout { width: 416px; padding-top: 14px; padding-bottom: 14px; spacing: 0;
        Rectangle { height: 26px; } Rectangle { height: 16px + 34px + 3px + 56px; }
        Text { text: root.n.message; font-size: 15px; wrap: word-wrap; width: 360px; min-height: 52px - 18px; }
        Rectangle { height: 18px + 12px + 28px + 12px + 44px; } }
    }
    // the window's touches: a finger holds the time; a sideways drag steps
    hold-ta := TouchArea {
        x: root.wx - root.dx - root.nudge; y: root.wy; width: root.win-w; height: root.win-h; enabled: root.on;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.sw-dx = 0; root.sw-v = 0; root.sw-last = self.mouse-x; root.sw-lt = animation-tick(); root.backing = false; }
            if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                if root.count > 1 && (Math.abs(root.sw-dx / 1px) > 80 || Math.abs(root.sw-v) > 0.6)
                    && ((root.sw-dx < 0 && root.index + 1 < root.count) || (root.sw-dx > 0 && root.index > 0)) {
                    Act.act("pop.step", root.sw-dx < 0 ? "1" : "-1");
                    root.sw-dx = 0;
                } else {
                    root.back-from = root.sw-dx; root.back-t0 = animation-tick(); root.backing = true; root.sw-dx = 0;
                }
            }
        }
        moved => {
            if root.count > 1 {
                root.sw-dx = self.mouse-x - self.pressed-x;
                if animation-tick() > root.sw-lt { root.sw-v = 0.5 * root.sw-v + 0.5 * (self.mouse-x - root.sw-last) / 1px / ((animation-tick() - root.sw-lt) / 1ms); }
                root.sw-last = self.mouse-x; root.sw-lt = animation-tick();
            }
        }
    }

    // ------------------------------------------------------------------ 0 plain card
    // arrival: k = 0.92 + 0.08 · J-edge(90, 260) with a small wobble, opacity in 120 ms; close: 0.96 and a fade in 160 ms;
    // a step slides the old card out the finger's way (200 ms) and the new one in from the other side (J-edge 80/300)
    property <float> p-k: root.closing ? 1 - 0.04 * clamp(root.ct / 160, 0, 1) * clamp(root.ct / 160, 0, 1)
        : (0.92 + 0.08 * Jelly.edge(root.ot, 90, 260)) * Jelly.wobble(root.ot, 0.035);
    property <float> p-o: root.closing ? 1 - clamp(root.ct / 160, 0, 1) : clamp(root.ot / 120, 0, 1);
    property <length> in-x: root.stepping ? root.dir * 440px * (1 - Jelly.edge(root.stt, 80, 300)) : 0px;
    property <length> out-x: root.stepping ? -root.dir * 440px * (1 - Math.pow(1 - clamp(root.stt / 200, 0, 1), 3)) : 0px;
    if root.shown && root.look == 0 && root.stepping && root.stt < 200: PlainCard {
        x: root.wx + root.out-x; y: root.wy; width: 416px; height: root.win-h; n: root.prev-n; opacity: 1 - clamp(root.stt / 200, 0, 1); left: 1; until: true;
    }
    if root.shown && root.look == 0: PlainCard {
        x: root.wx + root.in-x; y: root.wy; width: 416px; height: root.win-h; n: root.n; counter: root.c-of(root.index); left: root.left; until: root.until;
        opacity: root.p-o * (root.stepping ? clamp(root.stt / 140, 0, 1) : 1);
        transform-scale-x: root.p-k; transform-scale-y: root.p-k; transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    // ------------------------------------------------------------------ 1 fridge notes: the big note slaps on
    property <float> f-t: root.stepping ? root.stt - 90 : root.ot;
    property <float> f-k: root.f-t < 140 ? 1.08 - 0.08 * Math.pow(clamp(root.f-t / 140, 0, 1), 2) : 1;
    property <float> f-w: root.f-t >= 140 ? Jelly.wobble(root.f-t - 140, 0.03) : 1;
    property <length> f-y: root.f-t < 140 ? -12px * (1 - Math.pow(clamp(root.f-t / 140, 0, 1), 2)) : 0px;
    property <float> f-o: root.closing ? 1 - clamp(root.ct / 160, 0, 1) : clamp(root.f-t / 80, 0, 1);
    if root.shown && root.look == 1: Rectangle {
        x: root.wx; y: root.wy; width: 360px; height: root.win-h;
        // up to two next notes peek behind it
        for k in [2, 1]: Image { visible: root.index + k < root.notes.length; x: k * 8.5px; y: k * 7px; width: 360px; height: 300px;
            source: root.index + k < root.notes.length ? root.notes[root.index + k].paper : root.n.paper; rotation-angle: (k == 1 ? 2deg : -2.5deg); opacity: 0.9; }
        // the old note is pulled off sideways (420 px, +14°, 220 ms)
        if root.stepping && root.stt < 220: Image { x: -root.dir * 420px * (1 - Math.pow(1 - clamp(root.stt / 220, 0, 1), 3)); y: 0; width: 360px; height: 300px;
            source: root.prev-n.paper; rotation-angle: -root.dir * 14deg * clamp(root.stt / 220, 0, 1); }
        Image { x: (360px - 360px * root.f-k * root.f-w) / 2; y: root.f-y + (300px - 300px * root.f-k / root.f-w) / 2;
            width: 360px * root.f-k * root.f-w; height: 300px * root.f-k / root.f-w; source: root.n.paper; opacity: root.f-o * (root.stepping && root.stt < 90 ? 0 : 1);
            rotation-angle: root.dx / 25px * 1deg; }
        // the pills, fading up from 140 ms
        HorizontalLayout { x: 0; y: 300px + 18px + 8px * (1 - clamp((root.f-t - 140) / 220, 0, 1)); width: 360px; height: 44px; spacing: 8px; alignment: center;
            opacity: clamp((root.f-t - 140) / 220, 0, 1) * root.f-o;
            for a[i] in root.n.actions: Rectangle { height: 44px; width: fa.preferred-width + 36px; border-radius: 22px;
                background: i == root.n.actions.length - 1 ? #f4f4f2 : #ffffff33; border-width: 1px; border-color: #ffffff59;
                TouchArea { clicked => { Act.act("pop.action", i); } }
                fa := Text { x: 18px; width: self.preferred-width; height: parent.height; text: a; font-size: 15px; font-weight: 600;
                    color: i == root.n.actions.length - 1 ? #1d1d1f : #ffffff; vertical-alignment: center; } } }
        // the time: a 120 × 2 px line
        if !root.until: Rectangle { x: 120px; y: 300px + 18px + 44px + 12px; width: 120px; height: 2px; background: #ffffff1f;
            Rectangle { x: 0; width: parent.width * root.left; background: #ffffff8c; } }
        if root.count > 1: Text { x: 0; y: -22px; width: 360px; height: 18px; text: root.c-of(root.index); font-size: 12px; font-weight: 600; color: #ffffffcc;
            horizontal-alignment: right; }
    }

    // ------------------------------------------------------------------ 2 pager: drops in and buzzes, its keys step
    property <float> g-o: root.closing ? 1 - clamp(root.ct / 160, 0, 1) : clamp(root.ot / 180, 0, 1);
    property <length> g-y: root.closing ? 16px * clamp(root.ct / 160, 0, 1) : 24px * (1 - (1 - Math.pow(1 - clamp(root.ot / 180, 0, 1), 3)));
    // the buzz: ±2 px at 30 Hz, two 400 ms bursts with 200 ms between (from 180 ms); a key at the first / last: one burst
    property <duration> bz-t0;
    property <bool> bz-one;
    Timer { interval: 420ms; running: root.bz-one; triggered => { root.bz-one = false; } }
    property <float> bt: root.bz-one ? (animation-tick() - root.bz-t0) / 1ms : root.ot - 180;
    property <length> buzz: root.bt >= 0 && root.bt < (root.bz-one ? 400 : 1000) && Math.mod(root.bt, 600) < 400 ? (Math.sin(360deg * 30 * root.bt / 1000) >= 0 ? 2px : -2px) : 0px;
    property <bool> led-on: Math.mod((animation-tick() - root.op-t0) / 1ms, 1000) < 250;
    property <int> key-down: -1;
    property <duration> key-t0;
    Timer { interval: 100ms; running: root.key-down >= 0; triggered => { root.key-down = -1; } }
    property <color> lcd-ink: #1e2a17;
    if root.shown && root.look == 2: Rectangle {
        x: root.wx + root.buzz; y: root.wy + root.g-y; width: 375px; height: root.win-h; opacity: root.g-o;
        Image { x: 0; y: 0; width: 375px; height: 320px; source: root.pager; }
        if root.led-on: Image { x: 320px; y: 5px; width: 39px; height: 39px; source: root.led; }
        // the LCD (flickers in on a step: 3 steps over 120 ms)
        Rectangle { x: 33px; y: 53px; width: 310px; height: 162px; clip: true;
            opacity: root.stepping && root.stt < 120 ? 0.15 + 0.85 * Math.floor(root.stt / 40) / 3 : 1;
            for l in [{ t: "MSG " + (root.index + 1) + "/" + root.count, a: 0 }, { t: NoteTime.text(root.minute, 1), a: 1 }]: Rectangle {
                Text { x: 11.5px; y: 7px; width: 288px; height: 17px; text: l.t; font-family: "DejaVu Sans Mono"; font-size: 12.3px; font-weight: 700;
                    color: root.lcd-ink.with-alpha(0.17); horizontal-alignment: l.a == 1 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                Text { x: 10.5px; y: 5px; width: 288px; height: 17px; text: l.t; font-family: "DejaVu Sans Mono"; font-size: 12.3px; font-weight: 700;
                    color: root.lcd-ink; horizontal-alignment: l.a == 1 ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; } }
            Rectangle { x: 10.5px; y: 25px; width: 289px; height: 2px; background: root.lcd-ink.with-alpha(0.6); }
            for l in [{ t: root.n.title.to-uppercase(), s: 14px, w: 700, y: 30px, h: 20px }, { t: root.n.message.to-uppercase(), s: 12.3px, w: 400, y: 53px, h: 66px }]: Rectangle {
                Text { x: 11.5px; y: l.y + 2px; width: 288px; height: l.h; text: l.t; font-family: "DejaVu Sans Mono"; font-size: l.s; font-weight: l.w;
                    color: root.lcd-ink.with-alpha(0.17); wrap: l.h > 30px ? TextWrap.word-wrap : TextWrap.no-wrap; overflow: elide; vertical-alignment: top; }
                Text { x: 10.5px; y: l.y; width: 288px; height: l.h; text: l.t; font-family: "DejaVu Sans Mono"; font-size: l.s; font-weight: l.w;
                    color: root.lcd-ink; wrap: l.h > 30px ? TextWrap.word-wrap : TextWrap.no-wrap; overflow: elide; vertical-alignment: top; } }
            // the time as 12 LCD blocks
            if !root.until: Text { x: 10.5px; y: 162px - 6px - 17px; width: 288px; height: 17px; font-family: "DejaVu Sans Mono"; font-size: 12.3px; letter-spacing: 1px;
                color: root.lcd-ink;
                text: root.blocks(Math.ceil(root.left * 12)); }
        }
        // the keys: ▲ steps back, OK, ▼ steps on; a key sinks for 100 ms
        for k[i] in [{ x: 46px }, { x: 144px }, { x: 243px }]: Rectangle {
            x: k.x; y: 241px + (root.key-down == i ? 1.5px : 0px); width: 88px; height: 49px; border-radius: 24px;
            background: root.key-down == i ? #00000047 : transparent;
            TouchArea { clicked => {
                root.key-down = i; root.key-t0 = animation-tick();
                if i == 1 { Act.act("pop.ok", ""); }
                else if (i == 0 && root.index == 0) || (i == 2 && root.index + 1 >= root.count) { root.bz-t0 = animation-tick(); root.bz-one = true; }
                else { Act.act("pop.step", i == 0 ? "-1" : "1"); }
            } } }
        // Dismiss under it
        Rectangle { x: (375px - dz.preferred-width - 36px) / 2; y: 330px; width: dz.preferred-width + 36px; height: 44px; border-radius: 22px; background: #ffffff2e;
            TouchArea { clicked => { Act.act("pop.dismiss", ""); } }
            dz := Text { x: 18px; width: self.preferred-width; height: parent.height; text: "Dismiss"; font-size: 15px; font-weight: 600; color: #ffffff; vertical-alignment: center; } }
    }
    pure function blocks(k: int) -> string {
        (k > 0 ? "▮" : "▯") + (k > 1 ? "▮" : "▯") + (k > 2 ? "▮" : "▯") + (k > 3 ? "▮" : "▯") + (k > 4 ? "▮" : "▯") + (k > 5 ? "▮" : "▯")
            + (k > 6 ? "▮" : "▯") + (k > 7 ? "▮" : "▯") + (k > 8 ? "▮" : "▯") + (k > 9 ? "▮" : "▯") + (k > 10 ? "▮" : "▯") + (k > 11 ? "▮" : "▯")
    }

    // ------------------------------------------------------------------ 3 TV news: switches on like a CRT
    // scaleY 0.01 → 1 in 140 ms with a brightness flash (3 → 1 over 220 ms); the bar wipes in from 140 ms (300 ms), the title
    // types from 300 ms at 40 characters a second, then the message fades in; a step runs the wipe and the typing again
    property <float> tv-t: root.stepping ? root.stt + 140 : root.ot;
    property <float> tv-sy: root.closing ? max(0.01, 1 - (1 - Math.pow(1 - clamp(root.ct / 200, 0, 1), 3))) : max(0.01, 1 - Math.pow(1 - clamp(root.ot / 140, 0, 1), 3));
    property <float> tv-flash: root.closing ? 0.6 * clamp(root.ct / 200, 0, 1) : 0.66 * (1 - clamp(root.ot / 220, 0, 1));
    property <float> wipe: clamp((root.tv-t - 140) / 300, 0, 1);
    property <float> typed: max(0, (root.tv-t - 300) / 25);          // characters
    property <int> title-chars: root.n.title.character-count;
    property <float> type-k: root.title-chars > 0 ? clamp(root.typed / root.title-chars, 0, 1) : 1;
    property <float> msg-o: clamp((root.tv-t - 300 - root.title-chars * 25) / 150, 0, 1);
    if root.shown && root.look == 3: Rectangle {
        x: root.wx; y: root.wy + root.win-h * (1 - root.tv-sy) / 2; width: 416px; height: root.win-h * root.tv-sy; clip: true;
        border-radius: 8px; background: @linear-gradient(160deg, #0b1f4d 0%, #071230 100%);
        drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: #00000080;
        Rectangle { y: (parent.height - root.win-h) / 2; height: root.win-h;
            VerticalLayout { padding-top: 14px; padding-bottom: 14px; spacing: 0;
                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 6px; height: 26px;
                    Rectangle { width: 112px; border-radius: 4px; background: #ffffff;
                        Text { x: 8px; height: parent.height; text: "HOME NEWS"; font-size: 12px; font-weight: 900; letter-spacing: 1px; color: #0b1f4d; vertical-alignment: center; } }
                    Rectangle { width: 58px; border-radius: 4px; background: #d8202a;
                        Rectangle { x: 8px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px; background: #ffffff;
                            opacity: Math.mod((animation-tick() - root.op-t0) / 1ms, 1000) < 500 ? 1 : 0.25; }
                        Text { x: 18px; height: parent.height; text: "LIVE"; font-size: 12px; font-weight: 900; letter-spacing: 1px; color: #ffffff; vertical-alignment: center; } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.count > 1 ? (root.index + 1) + "/" + root.count : ""; font-size: 12px; font-weight: 700; color: #9fb0d6; vertical-alignment: center; } }
                Rectangle { height: 16px; }
                HorizontalLayout { padding-left: 14px; height: 34px; alignment: start;
                    Rectangle { width: 150px * root.wipe; clip: true; background: root.n.level == 1 ? #d8202a : #f2a51a;
                        Text { x: 12px; width: 140px; height: parent.height; text: root.n.level == 1 ? "BREAKING" : "JUST IN"; font-size: 17px; font-weight: 900;
                            letter-spacing: 1px; color: #ffffff; vertical-alignment: center; } } }
                HorizontalLayout { padding-left: 14px; padding-right: 14px; height: 3px;
                    Rectangle { Rectangle { x: 0; width: root.until ? 0px : parent.width * root.left; background: #d8202a; } } }
                HorizontalLayout { padding-left: 14px; padding-right: 14px; height: 56px;
                    Rectangle { background: #ffffff;
                        Rectangle { x: 14px; width: (parent.width - 28px) * root.type-k; clip: true;
                            Text { x: 0; width: 360px; height: 56px; text: root.n.title.to-uppercase(); font-size: 22px; font-weight: 900; color: #0b1f4d;
                                vertical-alignment: center; overflow: elide; } } } }
                HorizontalLayout { padding-left: 14px; padding-right: 14px;
                    Rectangle { background: #e9edf5; min-height: 52px;
                        mt := Text { x: 14px; y: 9px; width: parent.width - 28px; height: parent.height - 18px; text: root.n.message; font-size: 15px; font-weight: 500;
                            color: #1d2a44; wrap: word-wrap; opacity: root.msg-o; }
                        preferred-height: mt.preferred-height + 18px; } }
                Rectangle { height: 12px; }
                HorizontalLayout { padding-left: 14px; padding-right: 14px; height: 28px; spacing: 0;
                    Rectangle { width: 72px; background: #d8202a;
                        Text { width: parent.width; height: parent.height; text: NoteTime.text(root.minute, 2); font-size: 15px; font-weight: 900; color: #ffffff;
                            horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { background: #ffffff;
                        Crawl { x: 8px; width: parent.width - 8px; height: parent.height; font-size: 13px; font-weight: 700; ink: #0b1f4d; speed: 0.046;
                            text: (root.n.source + " · " + root.n.when + "   +++   " + root.n.title).to-uppercase() + "   +++   "; } } }
                Rectangle { height: 12px; }
                HorizontalLayout { padding-left: 14px; padding-right: 14px; height: 44px; spacing: 8px; alignment: end;
                    for a[i] in root.n.actions: Rectangle { width: ta.preferred-width + 32px; background: i == root.n.actions.length - 1 ? #d8202a : #ffffff;
                        TouchArea { clicked => { Act.act("pop.action", i); } }
                        ta := Text { x: 16px; width: self.preferred-width; height: parent.height; text: a.to-uppercase(); font-size: 14px; font-weight: 900; letter-spacing: 1px;
                            color: i == root.n.actions.length - 1 ? #ffffff : #0b1f4d; vertical-alignment: center; } } }
            }
        }
        // the brightness flash
        if root.tv-flash > 0.01: Rectangle { background: #ffffff.with-alpha(root.tv-flash); }
    }
}
