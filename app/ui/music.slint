// Music page: what plays on the chosen Music Assistant player, in one of five looks:
//   0 plain (blurred cover behind), 1 full-screen cover (top / bottom fade to dark or light),
//   2 turntable (cover = label, tone arm = position), 3 cassette, 4 half cassette.
// The accent (bars, play button, vinyl, label stripes) and the blurred background are computed by
// the app once per track. The speaker chip opens "Play on"; the page's settings open from the quick
// shade's page row. Both are menus of the look (music_menu.slint).
// The software renderer can't rotate images or clip to a circle, so the vinyl hole is a thick round
// border over the square cover, and the tone arm / tape run are paths computed here.
import { Theme, Act, Clock } from "theme.slint";
import { Icon, Glyph, PlayGlyph, GlowText, Marquee, MenuHost, PageMenu, TapArea } from "widgets.slint";
import { VolumeIcon } from "settings.slint";
import { MusicPlayer, MusicMenu } from "music_menu.slint";
export { MusicPlayer }

component Ctl inherits Rectangle {
    in property <string> icon;
    in property <length> size: 48px;
    in property <length> icon-size: 32px;
    in property <bool> on: true;           // shuffle / repeat state
    in property <color> accent;
    in property <color> ink: #ffffff;
    in property <bool> toggle;             // shows the on state with the accent and a dot
    in property <string> act;              // what a tap does (Act)
    callback tapped();
    width: self.size; height: self.size;
    opacity: touch.pressed ? 0.55 : 1;
    touch := TapArea { x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px; tapped => { if root.act != "" { Act.act(root.act, ""); root.tapped(); } } }
    Icon { text: root.icon; font-size: root.icon-size; color: root.toggle && root.on ? root.accent : root.toggle ? root.ink.with-alpha(0.5) : root.ink; }
    if root.toggle && root.on: Rectangle { x: (parent.width - 4px) / 2; y: parent.height - 4px; width: 4px; height: 4px; border-radius: 2px; background: root.accent; }
}

// Cubic ease-in-out for the eases counted by hand (from a start time).
global Root-ease {
    public pure function f(x: float) -> float {
        x <= 0 ? 0 : x >= 1 ? 1 : x < 0.5 ? 4 * x * x * x : 1 - (2 - 2 * x) * (2 - 2 * x) * (2 - 2 * x) / 2
    }
}

// Follows the finger while it is down (the app's value otherwise); `done` with
// the value where the finger lifted.
component Bar inherits Rectangle {
    in property <float> value;
    in property <color> fill;
    in property <color> track;
    in property <color> knob;
    callback done(float);
    property <float> drag-v;
    // let go: the bar stays where the finger left it until the player's value moves (or 3 s), then the
    // difference eases out in 0.3 s (no snap back and forth)
    property <bool> holding;
    property <float> v0;
    property <float> off;
    property <duration> off-t;
    property <bool> easing;
    property <float> off-p: root.easing ? Math.min(1, (animation-tick() - root.off-t) / 300ms) : 1;
    property <float> eased: root.value + root.off * (1 - Root-ease.f(root.off-p));
    function let-go() {
        root.off = root.drag-v - root.value;
        root.off-t = animation-tick();
        root.easing = true;
        root.holding = false;
    }
    changed value => { if root.holding && Math.abs(root.value - root.v0) > 0.004 { root.let-go(); } }
    Timer { interval: 3s; running: root.holding; triggered => { root.let-go(); } }
    Timer { interval: 50ms; running: root.easing; triggered => { if root.off-p >= 1 { root.easing = false; } } }
    // the drag's direction, decided after 8 px (26.2 axis lock): 0 not yet, 1 along the bar, 2 across it (ignored)
    property <int> axis;
    property <float> shown: (touch.pressed && root.axis != 2) || root.holding ? root.drag-v : root.eased;
    height: 4px; border-radius: 2px; background: root.track;
    Rectangle { x: 0; width: parent.width * root.shown; border-radius: 2px; background: root.fill; }
    // M14: the thumb grows from 0 to 12 px while touched (no thumb at rest, 28.2)
    in property <bool> grow;
    property <length> ks: !root.grow || (touch.pressed && root.axis != 2) || root.holding ? 12px : 0px;
    animate ks { duration: 140ms; easing: ease-out; }
    if root.ks > 0.5px: Rectangle { x: parent.width * root.shown - root.ks / 2; y: 2px - root.ks / 2; width: root.ks; height: root.ks; border-radius: root.ks / 2; background: root.knob; }
    touch := TouchArea {
        x: -10px; y: -18px; width: parent.width + 20px; height: parent.height + 36px;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.axis = 0;
                root.drag-v = max(0, min(1, (self.mouse-x - 10px) / root.width));
                root.easing = false;
            } else if ev.kind == PointerEventKind.up {
                // a flick can arrive as a press and a release with no move between (the pager holds the press for
                // 100 ms before it hands it over): the release decides the axis then, and a flick across the bar
                // never sets it
                if root.axis == 0 && max(Math.abs((self.mouse-x - self.pressed-x) / 1px), Math.abs((self.mouse-y - self.pressed-y) / 1px)) > 8 {
                    root.axis = Math.abs(self.mouse-x - self.pressed-x) >= Math.abs(self.mouse-y - self.pressed-y) ? 1 : 2;
                    if root.axis == 1 { root.drag-v = max(0, min(1, (self.mouse-x - 10px) / root.width)); }
                }
                if root.axis != 2 {
                    root.v0 = root.value;
                    root.holding = true;
                    root.done(root.drag-v);
                }
            }
        }
        moved => {
            if root.axis == 0 && max(Math.abs((self.mouse-x - self.pressed-x) / 1px), Math.abs((self.mouse-y - self.pressed-y) / 1px)) > 8 {
                root.axis = Math.abs(self.mouse-x - self.pressed-x) >= Math.abs(self.mouse-y - self.pressed-y) ? 1 : 2;
            }
            if root.axis != 2 { root.drag-v = max(0, min(1, (self.mouse-x - 10px) / root.width)); }
        }
    }
}

// The cassette's volume: a press held still for half a second takes the bar (its thumb grows meanwhile); then the
// thumb follows the finger left and right, as the touch slider's (28.2), and the pages do not turn until the finger
// lifts. A tap anywhere on the bar sets that point. A press that moves before the half second is a page swipe (or
// nothing): it never changes the volume. The value goes when the finger lifts; the bar keeps it until the player
// follows (or 3 s), then eases out like the other bars.
component HoldBar inherits Rectangle {
    in property <float> value;
    in property <color> fill;
    in property <color> track;
    in property <color> knob;
    callback done(float);
    property <float> drag-v;
    // the bar is held (after the half second), or the press moved first (not the bar's)
    property <bool> armed;
    property <bool> moved-off;
    property <duration> press-t;
    property <bool> holding;
    property <float> v0;
    property <float> off;
    property <duration> off-t;
    property <bool> easing;
    property <float> off-p: root.easing ? Math.min(1, (animation-tick() - root.off-t) / 300ms) : 1;
    property <float> eased: root.value + root.off * (1 - Root-ease.f(root.off-p));
    function let-go() {
        root.off = root.drag-v - root.value;
        root.off-t = animation-tick();
        root.easing = true;
        root.holding = false;
    }
    function set-at(v: float) {
        root.drag-v = v;
        root.v0 = root.value;
        root.holding = true;
        root.done(v);
    }
    changed value => { if root.holding && Math.abs(root.value - root.v0) > 0.004 { root.let-go(); } }
    Timer { interval: 3s; running: root.holding; triggered => { root.let-go(); } }
    Timer { interval: 50ms; running: root.easing; triggered => { if root.off-p >= 1 { root.easing = false; } } }
    // the pager hands a still press over after 100 ms: 400 ms more make the half second from the touch
    Timer {
        interval: 400ms;
        running: touch.pressed && !root.armed && !root.moved-off;
        triggered => {
            root.armed = true;
            Act.hold-swipe = true;
            root.easing = false;
            root.gliding = true;
            root.drag-v = root.at(touch.mouse-x);
        }
    }
    // taking the bar and a tap glide the thumb to the finger (180 ms, as the touch slider's first touch); a drag follows
    // it at once
    property <bool> gliding;
    Timer { interval: 200ms; running: root.gliding; triggered => { root.gliding = false; } }
    property <float> shown-raw: root.armed || root.holding ? root.drag-v : root.eased;
    out property <float> shown: root.shown-raw;
    animate shown { duration: root.gliding ? 180ms : 0ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    pure function at(x: length) -> float { max(0, min(1, (x - 10px) / root.width)) }
    height: 4px; border-radius: 2px; background: root.track;
    Rectangle { x: 0; width: parent.width * root.shown; border-radius: 2px; background: root.fill; }
    // the thumb grows from 0 to 12 px over the hold (no thumb at rest, M14), stays while held and after the release
    property <float> arm-p: !touch.pressed || root.moved-off ? 0 : root.armed ? 1 : Math.min(1, (animation-tick() - root.press-t) / 400ms);
    property <length> ks-rest: root.armed || root.holding ? 12px : 0px;
    animate ks-rest { duration: 140ms; easing: ease-out; }
    property <length> ks: max(root.ks-rest, 12px * root.arm-p);
    if root.ks > 0.5px: Rectangle { x: parent.width * root.shown - root.ks / 2; y: 2px - root.ks / 2; width: root.ks; height: root.ks; border-radius: root.ks / 2; background: root.knob; }
    touch := TouchArea {
        x: -10px; y: -16px; width: parent.width + 20px; height: parent.height + 32px;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.armed = false;
                root.moved-off = false;
                root.press-t = animation-tick();
            } else if ev.kind == PointerEventKind.up {
                if root.armed {
                    Act.hold-swipe = false;
                    root.armed = false;
                    root.set-at(root.drag-v);
                } else if !root.moved-off && max(Math.abs((self.mouse-x - self.pressed-x) / 1px), Math.abs((self.mouse-y - self.pressed-y) / 1px)) <= 8 {
                    // a tap: the volume of the point touched
                    root.easing = false;
                    root.gliding = true;
                    root.set-at(root.at(self.pressed-x));
                }
            } else if ev.kind == PointerEventKind.cancel {
                if root.armed { Act.hold-swipe = false; }
                root.armed = false;
            }
        }
        moved => {
            if root.armed {
                root.gliding = false;
                root.drag-v = root.at(self.mouse-x);
            } else if !root.moved-off && max(Math.abs((self.mouse-x - self.pressed-x) / 1px), Math.abs((self.mouse-y - self.pressed-y) / 1px)) > 8 {
                root.moved-off = true;
            }
        }
    }
}

// [elapsed][—— bar ——][remaining] and [speaker 37 %][—— bar ——]: both bars equally long.
component BarRows inherits Rectangle {
    in property <float> pos;
    in property <float> dur;
    in property <float> volume;
    in property <length> row1;             // centre line of the time row
    in property <length> row2;             // centre line of the volume row
    in property <color> fill;
    in property <color> vol-fill;
    in property <color> track;
    in property <color> knob;
    in property <color> ink;
    in property <color> soft;
    in property <length> lpad: 20px;       // left label column
    in property <length> colw: 64px;
    in property <length> rpad: 20px;
    property <length> bx: root.lpad + root.colw + 12px;
    property <length> bw: root.width - root.bx - root.rpad - root.colw - 12px;
    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function mmss(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(t / 60), 60)) + ":" + root.two(Math.mod(Math.floor(t), 60))
            : Math.floor(t / 60) + ":" + root.two(Math.mod(Math.floor(t), 60))
    }
    if root.dur > 0: Text { x: root.lpad; y: root.row1 - 10px; width: root.colw; height: 20px; text: root.mmss(root.pos); font-size: 13px; color: root.soft; horizontal-alignment: right; vertical-alignment: center; }
    if root.dur > 0: Bar { x: root.bx; y: root.row1 - 2px; width: root.bw; value: max(0, min(1, root.pos / root.dur)); fill: root.fill; track: root.track; knob: root.knob; grow: true;
        done(v) => { Act.act("music.seek", v * root.dur); } }
    if root.dur > 0: Text { x: root.bx + root.bw + 12px; y: root.row1 - 10px; width: root.colw; height: 20px; text: "−" + root.mmss(max(0, root.dur - root.pos)); font-size: 13px; color: root.soft; vertical-alignment: center; }
    if root.dur <= 0: Rectangle {
        x: (root.width - 52px) / 2; y: root.row1 - 10px; width: 52px; height: 20px; border-radius: 10px; background: root.fill.with-alpha(0.25);
        Text { text: "LIVE"; font-size: 11px; font-weight: 700; color: root.ink; horizontal-alignment: center; vertical-alignment: center; }
    }
    // M15: the shade's speaker (27.3): its waves light up one by one with the level
    VolumeIcon { x: root.lpad + root.colw - 22px; y: root.row2 - 11px; width: 22px; height: 22px; v: root.volume; ink: root.soft; }
    Bar { x: root.bx; y: root.row2 - 2px; width: root.bw; value: root.volume; fill: root.vol-fill; track: root.track; knob: root.knob; grow: true;
        done(v) => { Act.act("music.volume", v); } }
    Text { x: root.bx + root.bw + 12px; y: root.row2 - 10px; width: root.colw; height: 20px; text: Math.round(root.volume * 100) + "%"; font-size: 13px; color: root.soft; vertical-alignment: center; }
}

component Controls inherits HorizontalLayout {
    in property <bool> playing;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> live;
    in property <color> accent;
    in property <color> ink: #ffffff;
    in property <color> play-bg;
    in property <length> play: 72px;
    in property <bool> key;                // 25.U4: the play key stays down 2 px while it plays (80 ms), like a deck key
    callback skipped(int);                 // -1 previous, 1 next
    alignment: center;
    spacing: 16px;
    VerticalLayout { alignment: center; Ctl { icon: "\u{F049F}"; size: 40px; icon-size: 22px; toggle: true; on: root.shuffle; accent: root.accent; ink: root.ink; opacity: root.live ? 0 : 1; act: root.live ? "" : "music.shuffle"; } }
    VerticalLayout { alignment: center; Ctl { icon: "\u{F04AE}"; size: 48px; icon-size: 34px; ink: root.ink; act: "music.prev"; tapped => { root.skipped(-1); } } }
    VerticalLayout { alignment: center;
        Rectangle {
            width: root.play; height: root.play;
            property <length> down: root.key && root.playing ? 2px : 0px;
            animate down { duration: 80ms; easing: ease-out; }
            Rectangle {
                y: parent.down; width: root.play; height: root.play; border-radius: root.play / 2; background: root.play-bg;
                opacity: play-touch.pressed ? 0.75 : 1;
                PlayGlyph { width: parent.width; height: parent.height; playing: root.playing; ink: #ffffff; }
            }
            play-touch := TouchArea { clicked => { Act.act("music.play", ""); } }
        }
    }
    VerticalLayout { alignment: center; Ctl { icon: "\u{F04AD}"; size: 48px; icon-size: 34px; ink: root.ink; act: "music.next"; tapped => { root.skipped(1); } } }
    VerticalLayout { alignment: center; Ctl { icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}"; size: 40px; icon-size: 22px; toggle: true; on: root.repeat > 0; accent: root.accent; ink: root.ink; opacity: root.live ? 0 : 1; act: root.live ? "" : "music.repeat"; } }
}

export component MusicPage inherits Rectangle {
    in property <int> style;               // 0 plain, 1 full cover, 2 turntable, 3 cassette, 4 half cassette
    // turning parts: time since a base set every minute (the speeds make whole turns per minute, so the
    // new base is not seen; a small number stays exact however long the panel runs)
    // The platter's angle in degrees: it spins up to 33 1/3 rpm in 1.2 s (ease-in), coasts down in 2 s
    // (ease-out) and stays where it stopped (no snap back). A start while it still coasts (or a stop while it
    // spins up) goes on from the speed it has: each phase starts at the point of its curve with that speed
    // (spin-x0), so the speed never jumps. Counted from the last start or stop; while it plays the count moves
    // on by whole minutes (33 whole turns), so the number stays small and exact.
    property <float> spin-a0;
    property <duration> spin-t0;
    property <float> spin-x0;
    property <bool> spin-on;
    property <bool> coasting;
    init => {
        root.spin-on = root.playing;
        root.spin-x0 = root.playing ? 1.2 : 2;
        root.latch();
        if root.shown { root.claim(); }
    }
    pure function up-f(x: float) -> float { return x < 1.2 ? x * x * x / 4.32 : 0.4 + x - 1.2; }
    pure function down-f(x: float) -> float { return x < 2 ? (1 - (1 - x / 2) * (1 - x / 2) * (1 - x / 2)) * 2 / 3 : 2 / 3; }
    pure function spin-at(dt: float) -> float {
        root.spin-on
            ? root.spin-a0 + 198 * (root.up-f(root.spin-x0 + dt) - root.up-f(root.spin-x0))
            : root.spin-a0 + 198 * (root.down-f(root.spin-x0 + dt) - root.down-f(root.spin-x0))
    }
    // the speed now, 0..1 of 33 1/3 rpm
    function spin-speed() -> float {
        let x = root.spin-x0 + (animation-tick() - root.spin-t0) / 1s;
        return root.spin-on ? (x < 1.2 ? (x / 1.2) * (x / 1.2) : 1) : root.coasting ? (x < 2 ? (1 - x / 2) * (1 - x / 2) : 0) : 0;
    }
    // the clock is read only while the platter turns
    property <float> spin-deg: root.spin-on || root.coasting ? root.spin-at((animation-tick() - root.spin-t0) / 1s)
        : root.spin-a0 + 198 * (2 / 3 - root.down-f(root.spin-x0));
    changed playing => {
        let u = root.spin-speed();
        root.spin-a0 = Math.mod(root.spin-deg, 360);
        root.spin-t0 = animation-tick();
        root.spin-x0 = root.playing ? 1.2 * Math.sqrt(u) : 2 * (1 - Math.sqrt(u));
        root.coasting = !root.playing && u > 0;
        root.spin-on = root.playing;
    }
    Timer { interval: Math.max(0.1, 2.1 - root.spin-x0) * 1s; running: root.coasting; triggered => { root.coasting = false; } }
    // while it plays, the count starts again every minute from the angle it has (anchored 1.2 s back, so
    // the formula stays in its steady part and nothing moves)
    Timer { interval: 60s; running: root.spin-on; triggered => {
        if root.spin-x0 + (animation-tick() - root.spin-t0) / 1s > 1.5 {
            root.spin-a0 = Math.mod(root.spin-deg - 79.2, 360);
            root.spin-x0 = 0;
            root.spin-t0 = animation-tick() - 1200ms;
        }
    } }
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <bool> playing;
    in property <float> pos;               // seconds
    in property <float> dur;               // seconds; 0 = live stream (no progress)
    in property <bool> shuffle;
    in property <int> repeat;              // 0 off, 1 all, 2 one
    in property <float> volume: 0.5;       // 0..1
    in property <string> player;           // name of the active player (+ "+2" when grouped)
    in property <image> art;
    in property <image> art-bg;
    in property <bool> cs-cover;           // cassettes: the cover behind the cassette (the integration's option; off = the designed backdrop)
    in property <bool> cover-blur: true;   // the cover behind the player blurred into colour (off: recognisable, darkened)
    // the cover background crossfades (400 ms) to the next track's cover (or to the other blur setting): two
    // layers, the new one fades in on top
    property <image> bg-src: root.cover-blur ? root.art-bg : root.art;
    property <image> bg-a: root.bg-src;
    property <image> bg-b;
    property <bool> on-b;
    changed bg-src => {
        if root.on-b { root.bg-a = root.bg-src; root.on-b = false; } else { root.bg-b = root.bg-src; root.on-b = true; }
    }
    in property <bool> has-art: true;
    // the cover itself: the next one fades in over the last (300 ms), two layers
    property <image> art-a: root.art;
    property <image> art-b;
    property <bool> art-on-b;
    changed art => {
        if root.art-on-b { root.art-a = root.art; root.art-on-b = false; } else { root.art-b = root.art; root.art-on-b = true; }
    }
    property <float> art-k: root.art-on-b ? 1 : 0;
    animate art-k { duration: root.slide-dir != 0 ? 260ms : 300ms; easing: ease-in-out; }
    // 25.U2: a skip's direction; the next cover change slides that way (a skip without a new cover forgets it in 5 s)
    property <int> slide-dir;
    Timer { interval: 5s; running: root.slide-dir != 0; triggered => { root.slide-dir = 0; } }
    property <float> slide-u: root.art-on-b ? root.art-k : 1 - root.art-k;
    property <length> slide-a: root.slide-dir == 0 ? 0px : root.art-on-b ? -root.slide-dir * root.width * root.slide-u : root.slide-dir * root.width * (1 - root.slide-u);
    property <length> slide-b: root.slide-dir == 0 ? 0px : root.art-on-b ? root.slide-dir * root.width * (1 - root.slide-u) : -root.slide-dir * root.width * root.slide-u;
    // 25.U1: the plain look's cover drifts 8 px over 30 s, back and forth, eased (moved ten times a second); it rests
    // while the music is paused (a paused page stands still)
    property <float> pan-t;
    Timer { interval: 100ms; running: root.style == 0 && root.playing; triggered => { root.pan-t = animation-tick() / 1ms; } }
    property <length> pan: -4px + 4px * Math.cos(180deg * root.pan-t / 30000);
    in property <string> kind-icon: "\u{F0387}";   // shown instead of the cover (radio, story …)
    in property <color> accent: #e8262d;
    in property <[MusicPlayer]> players;
    in property <bool> picker;             // "Play on" (from the chip)
    in property <int> tape-scope;          // cassette: the tape shows 0 this track, 1 the whole queue
    in property <float> q-played;          // seconds of the queue before the current track
    in property <float> q-total;           // seconds of the whole queue
    in property <int> q-index;             // current track in the queue (0-based)
    in property <int> q-count;
    in property <image> tt-deck;
    in property <image> tt-grooves;
    in property <image> cs-back;
    in property <image> cs-front;
    in property <image> cs-hub;
    in property <image> cs-hub-r;          // right hub frame (both reels turn at their own speed); empty = cs-hub
    in property <float> tt-arm-r: -1;      // turntable: stylus radius set by the app (track change: lift, return); -1 = from the position
    in property <float> tt-lift: -1;       // 0 down … 1 lifted; -1 = by play / pause
    in property <float> tape-rem: -1;
    in property <bool> scroll;             // long titles scroll instead of being cut off …
    in property <float> scroll-speed: 3;   // … at this speed (1 slow .. 5 fast)
    in property <bool> settings;           // the page's settings menu (from the quick shade's page row)
    in property <int> holds;               // turntable / cassette: the record / tape holds 0 one track, 1 the whole queue
    in property <int> wood;                // turntable: the counter under it (index into woods)
    in property <[image]> woods;           // swatches of the wood choices      // cassette: tape left on the supply reel set by the app (rewind); -1 = from the position
    property <bool> light: root.style == 1 && !Theme.dark;
    property <color> acc: root.light ? root.accent.darker(0.35) : root.accent;
    animate acc { duration: 400ms; easing: ease-in-out; }
    // the record on the turntable: the cover's own colour as it is (black, white and grey too)
    in property <color> record;
    in property <bool> has-record;
    property <color> vinyl: root.has-record ? root.record : root.acc.mix(#000000, 0.82);
    animate vinyl { duration: 400ms; easing: ease-in-out; }
    property <color> ink: root.light ? #18181b : #ffffff;
    property <color> soft: root.ink.with-alpha(root.light ? 0.7 : 0.62);
    property <bool> live: root.dur <= 0;
    // The position runs on smoothly between the app's updates (about once a second, to the millisecond):
    // counted on from the last update while playing. Views that show it as a place (the arm, the tape) ease
    // over real jumps (another track, a seek, a skip) themselves.
    property <float> pos-base: root.pos;
    property <duration> pos-t;
    changed pos => { root.pos-base = root.pos; root.pos-t = animation-tick(); }
    property <float> pos-live: root.playing && !root.live
        ? Math.min(root.dur, root.pos-base + Math.min(2, (animation-tick() - root.pos-t) / 1s)) : root.pos-base;
    property <float> fr: root.live ? 0 : max(0, min(1, root.pos-live / root.dur));
    background: #101014;

    // ---------- 0 plain ----------
    if root.style == 0: Rectangle {
        // the cover fills the screen: blurred into colour, or recognisable (the option), darkened to ~55 %
        // (light: 45 % towards Paper)
        Image { x: root.pan - 4px; width: root.width + 8px; height: root.height; source: root.bg-a; image-fit: cover; }
        Image { x: root.pan - 4px; width: root.width + 8px; height: root.height; source: root.bg-b; image-fit: cover; opacity: root.on-b ? 1 : 0; animate opacity { duration: 400ms; easing: ease-in-out; } }
        Rectangle { background: root.light ? #F5F3EE73 : #00000073; }
        Rectangle { background: @linear-gradient(180deg, #00000033 0%, #00000000 35%, #00000000 60%, #00000059 100%); }
        Rectangle { x: (root.width - 196px) / 2 + 2px; y: 59px; width: 196px; height: 196px; border-radius: 3px; background: #0000004d; }
        Rectangle {
            x: (root.width - 196px) / 2; y: 52px; width: 196px; height: 196px;
            background: @linear-gradient(135deg, root.acc.mix(#000000, 0.55) 0%, root.acc.mix(#000000, 0.25) 100%);
            if root.has-art && root.art-k < 0.999: Image { width: parent.width; height: parent.height; source: root.art-a; image-fit: cover; }
            if root.has-art && root.art-k > 0.001: Image { width: parent.width; height: parent.height; source: root.art-b; image-fit: cover; opacity: root.art-k; }
            if !root.has-art: Icon { text: root.kind-icon; font-size: 84px; color: #ffffffd9; }
        }
        Marquee { x: 30px; y: 262px; width: root.width - 60px; height: 30px; text: root.title; font-size: 22px; font-weight: 600; color: #ffffff;
            horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 30px; y: 293px; width: root.width - 60px; height: 22px; text: root.artist + (root.album != "" ? "  ·  " + root.album : "");
            font-size: 15px; color: #ffffffb3; horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        BarRows { pos: root.pos-live; dur: root.dur; volume: root.volume; row1: 338px; row2: 443px;
            fill: root.acc; vol-fill: #ffffffcc; track: #ffffff33; knob: #ffffff; ink: #ffffff; soft: #ffffff9e; }
        Controls { y: 358px; width: root.width; height: 72px; playing: root.playing; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.acc.mix(#ffffff, 0.8); play-bg: root.acc; }
    }

    // ---------- 1 full-screen cover ----------
    if root.style == 1: Rectangle {
        background: root.acc.mix(#000000, 0.4);
        if root.has-art && root.art-k < 0.999: Image { x: root.slide-a; width: root.width; height: root.height; source: root.art-a; image-fit: cover; }
        if root.has-art && root.art-k > 0.001: Image { x: root.slide-b; width: root.width; height: root.height; source: root.art-b; image-fit: cover;
            opacity: root.slide-dir != 0 ? 1 : root.art-k; }
        if !root.has-art: Icon { y: 96px; height: 160px; text: root.kind-icon; font-size: 112px; color: #ffffffb3; }
        property <color> veil: root.light ? #ffffff : #000000;
        // one stop per rectangle: the software renderer leaves a 1 px seam at an inner gradient stop
        Rectangle { y: 0; height: 42px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.9 : 0.74) 0%, parent.veil.with-alpha(root.light ? 0.86 : 0.68) 100%); }
        Rectangle { y: 42px; height: 108px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.86 : 0.68) 0%, parent.veil.with-alpha(0) 100%); }
        Rectangle { y: 232px; height: 74px; background: @linear-gradient(180deg, parent.veil.with-alpha(0) 0%, parent.veil.with-alpha(root.light ? 0.9 : 0.82) 100%); }
        Rectangle { y: 306px; height: root.height - 306px; background: @linear-gradient(180deg, parent.veil.with-alpha(root.light ? 0.9 : 0.84) 0%, parent.veil.with-alpha(root.light ? 0.96 : 0.94) 100%); }
        Marquee { x: 30px; y: 282px; width: root.width - 60px; height: 30px; text: root.title; font-size: 22px; font-weight: 600; color: root.ink; k: root.light ? 0 : 1;
            horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 30px; y: 312px; width: root.width - 60px; height: 22px; text: root.artist + (root.album != "" ? "  ·  " + root.album : "");
            font-size: 15px; color: root.soft; k: root.light ? 0 : 1; horizontal-alignment: center; scroll: root.scroll; speed: root.scroll-speed; }
        BarRows { pos: root.pos-live; dur: root.dur; volume: root.volume; row1: 350px; row2: 443px;
            fill: root.acc; vol-fill: root.ink.with-alpha(0.8); track: root.ink.with-alpha(root.light ? 0.16 : 0.25); knob: root.ink; ink: root.ink; soft: root.soft; }
        Controls { y: 366px; width: root.width; height: 64px; play: 64px; playing: root.playing; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.light ? root.acc : root.acc.mix(#ffffff, 0.8); ink: root.ink; play-bg: root.acc;
            skipped(d) => { root.slide-dir = d; } }
    }

    // ---------- 2 turntable ----------
    if root.style == 2: tt := Rectangle {
        property <float> cx: 172;
        property <float> cy: 254;
        property <float> rv: 134;
        property <float> rl: 54;
        property <float> px: 394;
        property <float> py: 138;
        property <float> la: 238;          // pivot to stylus
        property <float> r-out: 128;
        property <float> r-in: 66;
        // the groove of the position; a jump (another track, a seek, a skip) glides over in 0.6 s, eased, from
        // where the arm is (lifted on the way when it is a long way)
        property <float> r-at: root.tt-arm-r >= 0 ? root.tt-arm-r : self.r-out - root.fr * (self.r-out - self.r-in);
        property <float> r-last: self.r-at;
        property <float> glide-d;
        property <duration> glide-t;
        property <bool> glide-on;
        property <float> glide-p: self.glide-on ? Math.min(1, (animation-tick() - self.glide-t) / 600ms) : 1;
        property <float> glide-left: self.glide-d * (1 - Root-ease.f(self.glide-p));
        property <float> glide-lift: self.glide-on ? Math.min(1, 6 * self.glide-p * (1 - self.glide-p)) * Math.min(1, Math.abs(self.glide-d) / 6) : 0;
        changed r-at => {
            if self.hold-rec && Math.abs(self.r-at - self.hold-r) < 3 {
                // the player follows the drop: the arm is already there
                let before = self.th;
                self.hold-rec = false;
                self.rel-from(before);
            } else if !self.hold-rec && Math.abs(self.r-at - self.r-last) > 1 {
                self.glide-d = self.r-last + self.glide-left - self.r-at;
                self.glide-t = animation-tick();
                self.glide-on = true;
            }
            self.r-last = self.r-at;
        }
        Timer { interval: 50ms; running: tt.glide-on; triggered => { if tt.glide-p >= 1 { tt.glide-on = false; } } }
        property <float> r: self.r-at + self.glide-left;
        property <float> d: Math.sqrt((self.cx - self.px) * (self.cx - self.px) + (self.cy - self.py) * (self.cy - self.py));
        property <angle> th-c: Math.atan2(self.cy - self.py, self.cx - self.px);
        pure function th-of(r: float) -> angle { self.th-c - Math.acos((self.la * self.la + self.d * self.d - r * r) / (2 * self.la * self.d)) }
        property <angle> th-groove: self.th-of(self.r);
        property <angle> rest: 94deg;
        // paused or stopped: the arm lifts, swings to its rest and sets down there (0.2 + 0.75 s); playing: back
        // onto the groove of the position
        property <float> park: root.playing || self.hold-rec ? 0 : 1;
        animate park { duration: 750ms; delay: 200ms; easing: ease-in-out; }
        // dragging: the arm follows the finger around the pivot, between the rest and the run-out groove
        property <bool> drag;
        property <angle> th-drag: 94deg;
        // letting go and the holds: the arm moves on from where it was (no snap); the difference to where it
        // belongs eases out over 0.3 s. Dropped on the record it keeps that groove until the player's position
        // follows (or 3 s); dropped on the rest it stays there while the player pauses.
        property <bool> hold-rec;
        property <float> hold-r;
        property <bool> hold-rest;
        property <angle> rel-d;
        property <duration> rel-t;
        property <bool> releasing;
        property <float> rel-p: self.releasing ? Math.min(1, (animation-tick() - self.rel-t) / 300ms) : 1;
        property <angle> rel-left: self.rel-d * (1 - Root-ease.f(self.rel-p));
        function rel-from(before: angle) {
            self.rel-d = before - self.th-base;
            self.rel-t = animation-tick();
            self.releasing = true;
        }
        Timer { interval: 50ms; running: tt.releasing; triggered => { if tt.rel-p >= 1 { tt.releasing = false; } } }
        Timer { interval: 3s; running: tt.hold-rec || tt.hold-rest; triggered => {
            let before = tt.th;
            tt.hold-rec = false;
            tt.hold-rest = false;
            tt.rel-from(before);
        } }
        changed park => { if self.hold-rest && self.park > 0.999 { self.hold-rest = false; } }
        property <angle> th-base: self.hold-rest ? self.rest : self.hold-rec ? self.th-of(self.hold-r)
            : self.th-groove + (self.rest - self.th-groove) * self.park;
        property <angle> th: self.drag ? self.th-drag : self.th-base + self.rel-left;
        // where the stylus is while dragging: over the rest, or this far into the record (0 lead-in … 1 run-out)
        property <bool> drag-rest: self.th-drag < self.th-of(self.r-out) - 3deg;
        property <float> drag-r: Math.sqrt((self.px + self.la * Math.cos(self.th-drag) - self.cx) * (self.px + self.la * Math.cos(self.th-drag) - self.cx)
            + (self.py + self.la * Math.sin(self.th-drag) - self.cy) * (self.py + self.la * Math.sin(self.th-drag) - self.cy));
        property <float> drag-f: Math.max(0, Math.min(1, (self.r-out - self.drag-r) / (self.r-out - self.r-in)));
        property <float> ux: Math.cos(self.th);
        property <float> uy: Math.sin(self.th);
        property <float> sx: self.px + self.la * self.ux;
        property <float> sy: self.py + self.la * self.uy;
        property <angle> th-h: self.th + 16deg;      // headshell offset
        property <float> hx: Math.cos(self.th-h);
        property <float> hy: Math.sin(self.th-h);
        // lifted while it swings or is dragged; down on the record or on its rest
        property <float> drag-k: self.drag ? 1 : 0;
        animate drag-k { duration: 150ms; easing: ease-out; }
        property <float> lift: root.tt-lift >= 0 ? root.tt-lift
            : Math.max(self.drag-k, Math.max(self.glide-lift, Math.min(1, self.park * (1 - self.park) * 12)));
        property <float> so-x: 5 + 6 * self.lift;
        property <float> so-y: 7 + 7 * self.lift;
        property <color> amber: #ffb54c;
        property <float> f0: 176;
        property <float> f1: 372;
        Image { width: root.width; height: root.height; source: root.tt-deck; }
        // display window
        Marquee { x: 32px; y: 60px; width: 340px; height: 24px; text: root.title; font-size: 18px; font-weight: 600; color: tt.amber; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: 32px; y: 82px; width: 340px; height: 18px; text: root.artist + (root.album != "" ? "  ·  " + root.album : ""); font-size: 13px; color: tt.amber.with-alpha(0.7);
            scroll: root.scroll; speed: root.scroll-speed; }
        Text { x: 380px; y: 60px; width: 68px; height: 24px; text: root.live ? "LIVE" : self.mmss(root.pos-live); font-size: 18px; font-weight: 600; color: tt.amber; horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !root.live: Text { x: 372px; y: 82px; width: 76px; height: 18px; text: "−" + self.mmss(max(0, root.dur - root.pos-live)); font-size: 13px; color: tt.amber.with-alpha(0.7); horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        // the record: square cover under a thick round border = round label
        Rectangle {
            x: (tt.cx - 70) * 1px; y: (tt.cy - 70) * 1px; width: 140px; height: 140px;   // ~1.3 × the label: its middle shows
            background: root.acc.mix(#000000, 0.5);
            if root.has-art && root.art-k < 0.999: Image { width: parent.width; height: parent.height; source: root.art-a; image-fit: cover;
                rotation-angle: root.spin-deg * 1deg;      // 33 rpm, spinning up and coasting down
                rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
            if root.has-art && root.art-k > 0.001: Image { width: parent.width; height: parent.height; source: root.art-b; image-fit: cover; opacity: root.art-k;
                rotation-angle: root.spin-deg * 1deg;
                rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
            if !root.has-art: Icon { text: root.kind-icon; font-size: 52px; color: #ffffffcc; }
        }
        Rectangle {
            x: (tt.cx - tt.rv) * 1px; y: (tt.cy - tt.rv) * 1px; width: 2 * tt.rv * 1px; height: self.width;
            border-radius: tt.rv * 1px; border-width: (tt.rv - tt.rl) * 1px; border-color: root.vinyl;
        }
        Image { x: (tt.cx - tt.rv) * 1px; y: (tt.cy - tt.rv) * 1px; width: 2 * tt.rv * 1px; height: self.width; source: root.tt-grooves; }
        // tone arm: shadow, counterweight, tube, headshell, pivot cap. Stroked Paths sit in a box one stroke
        // larger (Slint fits the stroke inside the box), so the lines land exactly where computed; the
        // counterweight (12..31 px behind the pivot) stays clear of the display window in every arm position
        Path { x: -(9px) / 2; y: -(9px) / 2; width: 480px + 9px; height: 480px + 9px; viewbox-width: 480; viewbox-height: 480; stroke: #00000040; stroke-width: 9px * (1 - 0.3 * tt.lift);
            MoveTo { x: tt.px + tt.so-x; y: tt.py + tt.so-y; }
            LineTo { x: tt.sx - 24 * tt.hx + tt.so-x; y: tt.sy - 24 * tt.hy + tt.so-y; } }
        Path { width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #00000040;
            MoveTo { x: tt.sx + 6 * tt.hx - 8 * tt.hy + tt.so-x; y: tt.sy + 6 * tt.hy + 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx + 6 * tt.hx + 8 * tt.hy + tt.so-x; y: tt.sy + 6 * tt.hy - 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx - 26 * tt.hx + 8 * tt.hy + tt.so-x; y: tt.sy - 26 * tt.hy - 8 * tt.hx + tt.so-y; }
            LineTo { x: tt.sx - 26 * tt.hx - 8 * tt.hy + tt.so-x; y: tt.sy - 26 * tt.hy + 8 * tt.hx + tt.so-y; }
            Close {} }
        Path { x: -(26px) / 2; y: -(26px) / 2; width: 480px + 26px; height: 480px + 26px; viewbox-width: 480; viewbox-height: 480; stroke: #3c3f46; stroke-width: 26px;
            MoveTo { x: tt.px - 12 * tt.ux; y: tt.py - 12 * tt.uy; }
            LineTo { x: tt.px - 31 * tt.ux; y: tt.py - 31 * tt.uy; } }
        Path { x: -(20px) / 2; y: -(20px) / 2; width: 480px + 20px; height: 480px + 20px; viewbox-width: 480; viewbox-height: 480; stroke: #8d929c; stroke-width: 20px;
            MoveTo { x: tt.px - 14 * tt.ux; y: tt.py - 14 * tt.uy; }
            LineTo { x: tt.px - 29 * tt.ux; y: tt.py - 29 * tt.uy; } }
        Path { x: -(8px) / 2; y: -(8px) / 2; width: 480px + 8px; height: 480px + 8px; viewbox-width: 480; viewbox-height: 480; stroke: #5d616a; stroke-width: 8px;
            MoveTo { x: tt.px; y: tt.py; }
            LineTo { x: tt.sx - 24 * tt.hx; y: tt.sy - 24 * tt.hy; } }
        Path { x: -(5px) / 2; y: -(5px) / 2; width: 480px + 5px; height: 480px + 5px; viewbox-width: 480; viewbox-height: 480; stroke: #dfe2e7; stroke-width: 5px;
            MoveTo { x: tt.px; y: tt.py; }
            LineTo { x: tt.sx - 24 * tt.hx; y: tt.sy - 24 * tt.hy; } }
        Path { x: -(1.4px) / 2; y: -(1.4px) / 2; width: 480px + 1.4px; height: 480px + 1.4px; viewbox-width: 480; viewbox-height: 480; stroke: #ffffffb0; stroke-width: 1.4px;
            MoveTo { x: tt.px - 1.2 * tt.uy; y: tt.py + 1.2 * tt.ux; }
            LineTo { x: tt.sx - 24 * tt.hx - 1.2 * tt.uy; y: tt.sy - 24 * tt.hy + 1.2 * tt.ux; } }
        // headshell (dark) with the cartridge (the brand colour, the same for every record) and a finger lift
        Path { x: -(1px) / 2; y: -(1px) / 2; width: 480px + 1px; height: 480px + 1px; viewbox-width: 480; viewbox-height: 480; fill: #26272b; stroke: #6a6e77; stroke-width: 1px;
            MoveTo { x: tt.sx + 6 * tt.hx - 8 * tt.hy; y: tt.sy + 6 * tt.hy + 8 * tt.hx; }
            LineTo { x: tt.sx + 6 * tt.hx + 8 * tt.hy; y: tt.sy + 6 * tt.hy - 8 * tt.hx; }
            LineTo { x: tt.sx - 26 * tt.hx + 7 * tt.hy; y: tt.sy - 26 * tt.hy - 7 * tt.hx; }
            LineTo { x: tt.sx - 26 * tt.hx - 7 * tt.hy; y: tt.sy - 26 * tt.hy + 7 * tt.hx; }
            Close {} }
        Path { width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: Theme.accent;
            MoveTo { x: tt.sx + 3 * tt.hx - 5 * tt.hy; y: tt.sy + 3 * tt.hy + 5 * tt.hx; }
            LineTo { x: tt.sx + 3 * tt.hx + 5 * tt.hy; y: tt.sy + 3 * tt.hy - 5 * tt.hx; }
            LineTo { x: tt.sx - 13 * tt.hx + 5 * tt.hy; y: tt.sy - 13 * tt.hy - 5 * tt.hx; }
            LineTo { x: tt.sx - 13 * tt.hx - 5 * tt.hy; y: tt.sy - 13 * tt.hy + 5 * tt.hx; }
            Close {} }
        Path { x: -(3px) / 2; y: -(3px) / 2; width: 480px + 3px; height: 480px + 3px; viewbox-width: 480; viewbox-height: 480; stroke: #c9ccd2; stroke-width: 3px;
            MoveTo { x: tt.sx - 6 * tt.hx - 8 * tt.hy; y: tt.sy - 6 * tt.hy + 8 * tt.hx; }
            LineTo { x: tt.sx - 6 * tt.hx - 17 * tt.hy; y: tt.sy - 6 * tt.hy + 17 * tt.hx; } }
        Rectangle { x: (tt.px - 11) * 1px; y: (tt.py - 11) * 1px; width: 22px; height: 22px; border-radius: 11px; background: #e4e6ea; border-width: 1px; border-color: #7a7e86; }
        Rectangle { x: (tt.px - 4) * 1px; y: (tt.py - 4) * 1px; width: 8px; height: 8px; border-radius: 4px; background: #44474e; }
        // drag the arm to seek: a press on the arm or the headshell lifts it, it follows the finger, a
        // bubble shows the time; let go on the record = seek there (and play), on the rest = pause
        TouchArea {
            x: 20px; y: 110px; width: 400px; height: 300px;
            pure function dist-to-arm(mx: float, my: float) -> float {
                Math.min(Math.sqrt((mx - tt.sx) * (mx - tt.sx) + (my - tt.sy) * (my - tt.sy)),
                    Math.abs((my - tt.py) * tt.ux - (mx - tt.px) * tt.uy))
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && self.dist-to-arm(self.x / 1px + self.mouse-x / 1px, self.y / 1px + self.mouse-y / 1px) < 26 {
                    tt.th-drag = tt.th;
                    tt.drag = true;
                    Act.hold-swipe = true;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && tt.drag {
                    Act.hold-swipe = false;
                    // a cancelled touch only lets the arm go back
                    if e.kind == PointerEventKind.up && tt.drag-rest {
                        tt.hold-rest = true;
                        Act.act("music.pause", "");
                    } else if e.kind == PointerEventKind.up && !root.live {
                        tt.hold-rec = true;
                        tt.hold-r = tt.drag-r;
                        Act.act("music.seek", tt.drag-f * root.dur);
                        if !root.playing { Act.act("music.resume", ""); }
                    }
                    tt.rel-from(tt.th-drag);
                    tt.drag = false;
                }
            }
            moved => {
                if tt.drag {
                    tt.th-drag = Math.max(tt.rest, Math.min(tt.th-of(tt.r-in), Math.atan2(self.y / 1px + self.mouse-y / 1px - tt.py, self.x / 1px + self.mouse-x / 1px - tt.px)));
                }
            }
        }
        if tt.drag && !root.live: Rectangle {
            x: (tt.sx - 34) * 1px; y: (tt.sy - 52) * 1px; width: 68px; height: 28px; border-radius: 14px; background: #000000cc;
            Text { text: tt.drag-rest ? "Pause" : Math.floor(tt.drag-f * root.dur / 60) + ":" + (Math.mod(Math.floor(tt.drag-f * root.dur), 60) < 10 ? "0" : "") + Math.mod(Math.floor(tt.drag-f * root.dur), 60);
                font-size: 15px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        // volume fader (dark print on aluminium)
        // speaker over the value, both centred on the fader (100 % fits inside the plate)
        // a tap on the strip jumps the fader there; a drag moves it by as much as the finger moves (no jump at the
        // start); the volume is set when the finger lets go
        property <bool> fdrag;
        property <bool> fpress;
        property <length> fy0;
        property <length> fx0;
        property <float> fbase;
        property <float> fv;
        // let go: the fader stays where it was dropped until the player's volume follows (or 3 s), then glides
        property <bool> fhold;
        property <float> ha-vol: root.volume;
        changed ha-vol => { self.fhold = false; }
        Timer { interval: 3s; running: tt.fhold; triggered => { tt.fhold = false; } }
        property <float> vol: self.fdrag || self.fhold ? self.fv : root.volume;
        animate vol { duration: tt.fdrag ? 0ms : 200ms; easing: ease-out; }
        Icon { x: 426px; y: 122px; width: 40px; height: 18px; text: tt.vol <= 0 ? "\u{F0581}" : "\u{F057E}"; font-size: 16px; color: #3a3c42; }
        Text { x: 418px; y: 142px; width: 56px; height: 18px; text: Math.round(tt.vol * 100) + "%"; font-size: 13px; font-weight: 600; color: #3a3c42;
            horizontal-alignment: center; vertical-alignment: center; }
        Rectangle {
            x: 431px; y: (tt.f1 - tt.vol * (tt.f1 - tt.f0) - 9) * 1px; width: 30px; height: 18px; border-radius: 3px;
            background: #d6d8dc; border-width: 1px; border-color: #6d7078;
            Rectangle { y: 8px; height: 2px; x: 4px; width: parent.width - 8px; background: root.acc; }
        }
        TouchArea {
            x: 418px; y: (tt.f0 - 16) * 1px; width: 56px; height: (tt.f1 - tt.f0 + 32) * 1px;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down {
                    tt.fpress = true;
                    tt.fdrag = false;
                    tt.fy0 = self.mouse-y;
                    tt.fx0 = self.mouse-x;
                }
                if ev.kind == PointerEventKind.up {
                    if tt.fdrag {
                        tt.fhold = true; Act.act("music.volume", tt.fv);
                    } else if tt.fpress && abs(self.mouse-y - tt.fy0) > 6px && abs(self.mouse-y - tt.fy0) >= abs(self.mouse-x - tt.fx0) {
                        // a flick along the fader that came as a press and a release (the pager holds the press for
                        // 100 ms): it moves the fader by as much as the finger moved, like a drag
                        tt.fv = max(0, min(1, tt.vol + (tt.fy0 - self.mouse-y) / 1px / (tt.f1 - tt.f0)));
                        tt.fhold = true; Act.act("music.volume", tt.fv);
                    } else if tt.fpress && abs(self.mouse-y - tt.fy0) <= 6px && abs(self.mouse-x - tt.fx0) <= 6px {
                        // a tap: the fader jumps to where the finger was (a flick across it changes nothing)
                        tt.fv = max(0, min(1, (tt.f1 - (self.y + tt.fy0) / 1px) / (tt.f1 - tt.f0)));
                        tt.fhold = true; Act.act("music.volume", tt.fv);
                    }
                    tt.fdrag = false;
                    tt.fpress = false;
                }
                if ev.kind == PointerEventKind.cancel { tt.fdrag = false; tt.fpress = false; }
            }
            moved => {
                if tt.fpress && !tt.fdrag && abs(self.mouse-y - tt.fy0) > 6px {
                    // a drag starts from the value shown (during the hold after a release: the one dropped there)
                    tt.fbase = tt.vol;
                    tt.fdrag = true;
                }
                if tt.fdrag {
                    tt.fv = max(0, min(1, tt.fbase + (tt.fy0 - self.mouse-y) / 1px / (tt.f1 - tt.f0)));
                }
            }
        }
        // start / stop and the small buttons
        Rectangle {
            x: 21px; y: 405px; width: 82px; height: 36px; border-radius: 6px;
            background: tt-play.pressed ? #b02a20 : #cf3428;
            Rectangle { x: 6px; y: 3px; width: parent.width - 12px; height: 2px; border-radius: 1px; background: #ffffff4d; }
            PlayGlyph { x: (parent.width - 44px) / 2; y: (parent.height - 44px) / 2; width: 44px; height: 44px; playing: root.playing; ink: #ffffff; }
            tt-play := TouchArea { clicked => { Act.act("music.play", ""); } }
        }
        for b[i] in [
            { icon: "\u{F049F}", on: root.shuffle, toggle: true, act: "music.shuffle" },
            { icon: "\u{F04AE}", on: false, toggle: false, act: "music.prev" },
            { icon: "\u{F04AD}", on: false, toggle: false, act: "music.next" },
            { icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}", on: root.repeat > 0, toggle: true, act: "music.repeat" },
        ]: Rectangle {
            x: (297 + i * 42) * 1px; y: 407px; width: 34px; height: 32px; border-radius: 5px;
            background: tt-key.pressed ? #b9bcc2 : #d3d6db;
            tt-key := TapArea { tapped => { if !(b.toggle && root.live) { Act.act(b.act, ""); } } }
            Rectangle { x: 4px; y: parent.height - 4px; width: parent.width - 8px; height: 2px; border-radius: 1px; background: #00000026; }
            opacity: b.toggle && root.live ? 0.35 : 1;
            Icon { text: b.icon; font-size: 20px; color: #2c2e33; }
            if b.toggle: Rectangle { x: (parent.width - 6px) / 2; y: -9px; width: 6px; height: 4px; border-radius: 2px; background: b.on ? root.acc : #00000040; }
        }
    }

    // ---------- 3 cassette, 4 half cassette ----------
    if root.style == 3 || root.style == 4: cs := Rectangle {
        property <bool> half: root.style == 4;
        // 25.U5: while playing, the half cassette's tape flutters slightly between the guides (0.5 px, 4 Hz)
        property <length> flutter: cs.half && root.playing ? 0.5px * Math.sin(360deg * 4 * (animation-tick() - Clock.base) / 1s) : 0px;
        property <float> k: self.half ? 6.2 : 4.4;            // px per mm
        property <float> ox: self.half ? 16 : 19;              // cassette body origin
        property <float> oy: 52;
        property <float> hub-r: 10.6;
        property <float> pack-max: 23;
        property <float> hub-y: 30.5;
        property <float> sx0: 50.2 - 21.25;                    // supply reel (left)
        property <float> tx0: 50.2 + 21.25;                    // take-up reel (right)
        property <float> rem-at: root.tape-rem >= 0 ? root.tape-rem : root.tape-scope == 1 && root.q-total > 0
            ? max(0, min(1, 1 - (root.q-played + root.pos-live) / root.q-total)) : 1 - root.fr;
        // a jump of the tape (another track, a seek, a skip; not the running play) winds over in 1 s, eased,
        // from where the tape is shown; a new jump meanwhile starts from there. The reels turn with the wound
        // tape (the same way as playing when it winds forward) and keep the turn afterwards.
        property <float> rem-last: self.rem-at;
        property <float> wind-d;
        property <duration> wind-t;
        property <bool> winding;
        property <float> hub-acc;
        property <float> wind-p: self.winding ? Math.min(1, (animation-tick() - self.wind-t) / 1s) : 1;
        property <float> wind-left: self.wind-d * (1 - Root-ease.f(self.wind-p));
        changed rem-at => {
            if Math.abs(self.rem-at - self.rem-last) > 0.004 {
                let left = self.wind-left;
                self.hub-acc = Math.mod(self.hub-acc - (self.wind-d - left) * 2400, 360);
                self.wind-d = self.rem-last + left - self.rem-at;
                self.wind-t = animation-tick();
                self.winding = true;
            }
            self.rem-last = self.rem-at;
        }
        Timer { interval: 50ms; running: cs.winding; triggered => { if cs.wind-p >= 1 { cs.winding = false; } } }
        property <float> rem: max(0, min(1, self.rem-at + self.wind-left));
        property <float> wind: self.hub-acc - (self.wind-d - self.wind-left) * 2400;
        property <float> rs: Math.sqrt(self.hub-r * self.hub-r + self.rem * (self.pack-max * self.pack-max - self.hub-r * self.hub-r));
        property <float> rt: Math.sqrt(self.hub-r * self.hub-r + (1 - self.rem) * (self.pack-max * self.pack-max - self.hub-r * self.hub-r));
        // tape: supply pack (outer side) → round the left corner roller → along the front → round the
        // right roller → take-up pack (outer side). External tangents: n·(P − C) = rr − R.
        property <float> rr: 2.3;                               // tape centre line round the roller (r 2.1)
        property <float> ry: 58.2;                              // roller centres (y), x 8.6 / 91.8
        property <float> d1x: 8.6 - self.sx0;
        property <float> d1y: self.ry - self.hub-y;
        property <float> d1: Math.sqrt(self.d1x * self.d1x + self.d1y * self.d1y);
        property <angle> f1: Math.atan2(self.d1y, self.d1x) - Math.acos((self.rr - self.rs) / self.d1);
        property <float> d2x: 91.8 - self.tx0;
        property <float> d2: Math.sqrt(self.d2x * self.d2x + self.d1y * self.d1y);
        property <angle> f2: Math.atan2(self.d1y, self.d2x) + Math.acos((self.rr - self.rt) / self.d2);
        pure function px(mm: float) -> float { self.ox + mm * self.k }
        pure function py(mm: float) -> float { self.oy + mm * self.k }
        property <string> tape: "M " + self.px(self.sx0 - self.rs * Math.cos(self.f1)) + " " + self.py(self.hub-y - self.rs * Math.sin(self.f1))
            + " L " + self.px(8.6 - self.rr * Math.cos(self.f1)) + " " + self.py(self.ry - self.rr * Math.sin(self.f1))
            + " A " + (self.rr * self.k) + " " + (self.rr * self.k) + " 0 0 0 " + self.px(8.6) + " " + self.py(self.ry + self.rr)
            + " L " + self.px(91.8) + " " + self.py(self.ry + self.rr)
            + " A " + (self.rr * self.k) + " " + (self.rr * self.k) + " 0 0 0 " + self.px(91.8 - self.rr * Math.cos(self.f2)) + " " + self.py(self.ry - self.rr * Math.sin(self.f2))
            + " L " + self.px(self.tx0 - self.rt * Math.cos(self.f2)) + " " + self.py(self.hub-y - self.rt * Math.sin(self.f2));
        property <length> label-r: self.half ? 336px : root.width;   // visible right edge of the label
        // the designed backdrop, or (the integration's option) the cover behind the cassette; 250 ms between them
        Rectangle { background: @linear-gradient(180deg, root.acc.mix(#000000, 0.22) 0%, root.acc.mix(#000000, 0.1) 100%); }
        Rectangle {
            opacity: root.cs-cover ? 1 : 0;
            animate opacity { duration: 250ms; easing: ease-in-out; }
            Image { width: root.width; height: root.height; source: root.bg-a; image-fit: cover; }
            Image { width: root.width; height: root.height; source: root.bg-b; image-fit: cover; opacity: root.on-b ? 1 : 0; animate opacity { duration: 400ms; easing: ease-in-out; } }
            Rectangle { background: #00000059; }
        }
        Image { x: (cs.ox - 14) * 1px; y: (cs.oy - 14) * 1px; source: root.cs-back; }
        // tape packs
        Rectangle {
            x: (cs.ox + (cs.sx0 - cs.rs) * cs.k) * 1px; y: (cs.oy + (cs.hub-y - cs.rs) * cs.k) * 1px;
            width: 2 * cs.rs * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: #563d2e; border-width: 1px; border-color: #8a6a52;
            Rectangle { x: parent.width * 0.16; y: self.x; width: parent.width * 0.68; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff14; }
        }
        Rectangle {
            x: (cs.ox + (cs.tx0 - cs.rt) * cs.k) * 1px; y: (cs.oy + (cs.hub-y - cs.rt) * cs.k) * 1px;
            width: 2 * cs.rt * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: #563d2e; border-width: 1px; border-color: #8a6a52;
            Rectangle { x: parent.width * 0.16; y: self.x; width: parent.width * 0.68; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: #ffffff14; }
        }
        Path { x: -((0.7 * cs.k) * 1px) / 2; y: -((0.7 * cs.k) * 1px) / 2 + cs.flutter; width: 480px + (0.7 * cs.k) * 1px; height: 480px + (0.7 * cs.k) * 1px; viewbox-width: 480; viewbox-height: 480; stroke: #4b3427; stroke-width: (0.7 * cs.k) * 1px; commands: cs.tape; }
        // hubs (on the panel: a sprite frame per rotation step)
        Image { x: (cs.ox + cs.sx0 * cs.k) * 1px - self.width / 2; y: (cs.oy + cs.hub-y * cs.k) * 1px - self.height / 2; source: root.cs-hub;
            rotation-angle: (-root.spin-deg * 90 / 198 + cs.wind) * 1deg; rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
        Image { x: (cs.ox + cs.tx0 * cs.k) * 1px - self.width / 2; y: (cs.oy + cs.hub-y * cs.k) * 1px - self.height / 2; source: root.cs-hub-r.width > 0 ? root.cs-hub-r : root.cs-hub;
            rotation-angle: (-root.spin-deg * 120 / 198 + cs.wind) * 1deg; rotation-origin-x: self.width / 2; rotation-origin-y: self.height / 2; }
        Image { x: (cs.ox - 14) * 1px; y: (cs.oy - 14) * 1px; source: root.cs-front; }
        // label: side letter, title, artist, stripes in the accent
        Rectangle {
            x: (cs.ox + 6.6 * cs.k) * 1px; y: (cs.oy + 5.4 * cs.k) * 1px; width: 7.6 * cs.k * 1px; height: self.width; border-radius: self.width / 2;
            background: root.acc;
            Text { text: "A"; font-size: 5.2 * cs.k * 1px; font-weight: 700; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        Marquee { x: (cs.ox + 17.4 * cs.k) * 1px; y: (cs.oy + 5.0 * cs.k) * 1px; width: cs.label-r - self.x - (cs.half ? 12px : (100.4 - 93) * cs.k * 1px + cs.ox * 1px);
            height: 5.8 * cs.k * 1px; text: root.title; font-size: cs.half ? 24px : 4.5 * cs.k * 1px; font-weight: 700; color: #26221d; scroll: root.scroll; speed: root.scroll-speed; }
        Marquee { x: (cs.ox + 17.6 * cs.k) * 1px; y: (cs.oy + 11.0 * cs.k) * 1px;
            width: cs.label-r - self.x - (cs.half ? 12px : (100.4 - 93) * cs.k * 1px + cs.ox * 1px) - (cs.half ? 0px : 96px);
            height: 4.6 * cs.k * 1px; text: root.artist; font-size: cs.half ? 17px : 3.2 * cs.k * 1px; color: #4d453c; scroll: root.scroll; speed: root.scroll-speed; }
        if !cs.half && root.q-count > 0: Text { x: (cs.ox + 92.6 * cs.k) * 1px - 92px; y: (cs.oy + 11.0 * cs.k) * 1px; width: 92px; height: 4.6 * cs.k * 1px;
            text: (root.q-index + 1) + " / " + root.q-count; font-size: 3.0 * cs.k * 1px; color: #6d6458; horizontal-alignment: right; vertical-alignment: bottom; }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 17.4 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 2.3 * cs.k * 1px; background: root.acc; }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 20.1 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 0.8 * cs.k * 1px; background: root.acc.darker(0.3); }
        Rectangle { x: (cs.ox + 4.6 * cs.k) * 1px; y: (cs.oy + 21.5 * cs.k) * 1px; width: min(cs.label-r - self.x, 91.2 * cs.k * 1px); height: 0.8 * cs.k * 1px; background: root.acc.brighter(0.35); }

        // full cassette: times + controls + volume below, clear of the page dots (y 458): the keys' row centred at
        // y 376, the volume row at y 432 (its touch reaches y 450)
        if !cs.half && !root.live: Text { x: 20px; y: 366px; width: 64px; height: 20px; text: self.mmss(root.pos-live); font-size: 13px; color: #ffffff9e; horizontal-alignment: right; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !cs.half && !root.live: Text { x: 396px; y: 366px; width: 64px; height: 20px; text: "−" + self.mmss(max(0, root.dur - root.pos-live)); font-size: 13px; color: #ffffff9e; vertical-alignment: center;
            pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
            pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
        }
        if !cs.half: Controls { y: 344px; width: root.width; height: 64px; play: 64px; spacing: 12px; playing: root.playing; key: true; shuffle: root.shuffle; repeat: root.repeat; live: root.live;
            accent: root.acc.mix(#ffffff, 0.8); play-bg: root.acc; }
        // [speaker][—— bar ——][37 %] with the plain look's columns (BarRows); the bar is held before it drags
        if !cs.half: Rectangle {
            property <length> vrow: 432px;
            // M15: the shade's speaker (27.3) and the value follow the finger while the bar is held
            VolumeIcon { x: 62px; y: parent.vrow - 11px; width: 22px; height: 22px; v: vbar.shown; ink: #ffffff9e; }
            vbar := HoldBar { x: 96px; y: parent.vrow - 2px; width: 288px; value: root.volume; fill: #ffffffcc; track: #ffffff33; knob: #ffffff;
                done(v) => { Act.act("music.volume", v); } }
            Text { x: 396px; y: parent.vrow - 10px; width: 64px; height: 20px; text: Math.round(vbar.shown * 100) + "%"; font-size: 13px; color: #ffffff9e; vertical-alignment: center; }
        }

        // half cassette: the right half slides under the control panel
        if cs.half: Rectangle {
            x: 314px; width: 24px; background: @linear-gradient(90deg, #00000000 0%, #00000080 100%);
        }
        if cs.half: Rectangle {
            x: 336px; width: root.width - 336px;
            background: @linear-gradient(180deg, #1d1d22 0%, #141418 100%);
            Rectangle { x: 0; width: 1px; background: #ffffff1f; }
                        if !root.live: Text { x: 0; y: 90px; width: parent.width; height: 32px; text: self.mmss(root.pos-live); font-size: 26px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center;
                pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
                pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
            }
            if !root.live: Text { x: 0; y: 122px; width: parent.width; height: 20px; text: "−" + self.mmss(max(0, root.dur - root.pos-live)); font-size: 14px; color: #ffffff9e; horizontal-alignment: center; vertical-alignment: center;
                pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
                pure function mmss(t: float) -> string { t >= 3600 ? Math.floor(t / 3600) + ":" + self.two(Math.mod(Math.floor(t / 60), 60)) + ":" + self.two(Math.mod(Math.floor(t), 60)) : Math.floor(t / 60) + ":" + self.two(Math.mod(Math.floor(t), 60)) }
            }
            Rectangle {
                x: (parent.width - 72px) / 2; y: 158px; width: 72px; height: 72px; border-radius: 36px; background: root.acc;
                opacity: half-play.pressed ? 0.75 : 1;
                PlayGlyph { width: parent.width; height: parent.height; playing: root.playing; ink: #ffffff; }
                half-play := TouchArea { clicked => { Act.act("music.play", ""); } }
            }
            Ctl { x: parent.width / 2 - 56px; y: 246px; size: 48px; icon-size: 34px; icon: "\u{F04AE}"; act: "music.prev"; }
            Ctl { x: parent.width / 2 + 8px; y: 246px; size: 48px; icon-size: 34px; icon: "\u{F04AD}"; act: "music.next"; }
            Ctl { x: parent.width / 2 - 52px; y: 306px; size: 40px; icon-size: 22px; icon: "\u{F049F}"; toggle: true; on: root.shuffle; accent: root.acc.mix(#ffffff, 0.8); opacity: root.live ? 0 : 1;
                act: root.live ? "" : "music.shuffle"; }
            Ctl { x: parent.width / 2 + 12px; y: 306px; size: 40px; icon-size: 22px; icon: root.repeat == 2 ? "\u{F0458}" : "\u{F0456}"; toggle: true; on: root.repeat > 0; accent: root.acc.mix(#ffffff, 0.8); opacity: root.live ? 0 : 1;
                act: root.live ? "" : "music.repeat"; }
            Icon { x: 8px; y: 370px; width: 20px; height: 20px; text: root.volume <= 0 ? "\u{F0581}" : root.volume > 0.6 ? "\u{F057E}" : root.volume > 0.25 ? "\u{F0580}" : "\u{F057F}"; font-size: 18px; color: #ffffff9e; }
            Bar { x: 36px; y: 378px; width: parent.width - 36px - 46px; value: root.volume; fill: #ffffffcc; track: #ffffff33; knob: #ffffff; grow: true;
                done(v) => { Act.act("music.volume", v); } }
            Text { x: parent.width - 38px; y: 370px; width: 34px; height: 20px; text: Math.round(root.volume * 100) + "%"; font-size: 13px; color: #ffffff9e; vertical-alignment: center; }
        }
    }

    // speaker chip (top right): tap = choose which player this page shows
    Rectangle {
        // the same fixed place and width on every look (x 312–464)
        x: root.width - 16px - self.width; y: 10px; height: 32px;
        width: 152px;
        border-radius: 16px; background: root.light ? #0000001a : #ffffff1f;
        Icon { x: 12px; y: 0; width: 20px; height: parent.height; text: "\u{F04C3}"; font-size: 18px; color: root.ink.with-alpha(0.9); }
        sp := Text { x: 36px; y: 0; width: parent.width - 46px; height: parent.height; text: root.player; font-size: 14px; font-weight: 600; color: root.ink; vertical-alignment: center; overflow: elide; }
        TouchArea { y: -6px; height: parent.height + 12px; clicked => { Act.act("music.picker", ""); } }
    }

    // ---------- the menus of the look (spec 32.1) ----------
    // "Play on" hangs from the chip; the settings come down under the status bar when the quick shade's page row asks
    // for them (PageMenu). A tap beside the menu (the chip too), Done or a pick closes it; leaving the page closes it.
    in property <bool> shown;              // the page is on screen
    property <int> skin: root.style <= 1 ? 0 : root.style == 2 ? 1 : 2;
    property <bool> menu-open: root.picker || root.settings;
    // the kind and the skin stay as they were opened while the menu leaves
    property <int> m-kind;
    property <int> m-skin;
    function latch() {
        root.m-kind = root.settings ? 1 : 0;
        root.m-skin = root.skin;
    }
    changed picker => { if self.picker { root.latch(); } }
    changed settings => { if self.settings { root.latch(); } }
    function close-menu() {
        if root.settings { Act.act("music.settings-close", ""); }
        if root.picker { Act.act("music.picker-close", ""); }
    }
    // the quick shade's page row: what it shows while this page is on screen ("Music settings · Turntable")
    property <string> look-name: root.style == 0 ? "Plain" : root.style == 1 ? "Full cover" : root.style == 2 ? "Turntable" : root.style == 3 ? "Cassette" : "Half cassette";
    function claim() {
        PageMenu.title = "Music settings";
        PageMenu.look = root.look-name;
        PageMenu.icon = root.style == 0 ? "\u{F14FB}" : root.style == 1 ? "\u{F02EB}" : root.style == 2 ? "\u{F0025}" : "\u{F09D4}";
        PageMenu.has-settings = true;
    }
    changed shown => {
        if self.shown { root.claim(); } else { root.close-menu(); root.look-next = -1; root.reopen = false; }
    }
    changed style => { if root.shown { root.claim(); } }
    property <int> open-request: PageMenu.open-request;
    changed open-request => { if root.shown { Act.act("music.settings", ""); } }
    // a new look in the settings: the menu goes (its own way out), the look changes, and the settings come back as the
    // new look's menu
    property <int> look-next: -1;
    property <bool> reopen;
    Timer {
        interval: host.out-ms + 20ms;
        running: root.look-next >= 0 && !root.settings;
        triggered => {
            Act.act("music.look", root.look-next);
            root.look-next = -1;
            root.reopen = true;
        }
    }
    Timer { interval: 60ms; running: root.reopen; triggered => { root.reopen = false; if root.shown { Act.act("music.settings", ""); } } }
    host := MenuHost {
        open: root.menu-open;
        kind: root.m-kind;
        menu-w: root.m-kind == 1 ? 448px : root.m-skin == 0 ? 320px : root.m-skin == 1 ? 340px : 344px;
        need: menu.need;
        in-ms: root.m-skin == 0 ? 140ms : root.m-skin == 1 ? (root.m-kind == 0 ? 650ms : 700ms) : 520ms;
        out-ms: root.m-skin == 0 ? 100ms : root.m-skin == 1 ? 180ms : 200ms;
        close => { root.close-menu(); }
        menu := MusicMenu {
            x: host.menu-x; y: host.menu-y; width: host.menu-w; height: host.menu-h;
            skin: root.m-skin; kind: root.m-kind; open: host.open; t-in: host.t-in; t-out: host.t-out;
            players: root.players; style: root.style; holds: root.holds; wood: root.wood; woods: root.woods;
            scroll: root.scroll; scroll-speed: root.scroll-speed; cover-blur: root.cover-blur; cs-cover: root.cs-cover;
            tape: root.acc;
            pick-look(i) => {
                if i != root.style {
                    root.look-next = i;
                    Act.act("music.settings-close", "");
                }
            }
            done => { Act.act("music.settings-close", ""); }
        }
    }
}
