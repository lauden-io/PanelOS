// Home page: the living weather background with widgets placed on a 4 x 4 grid.
// Every widget has a kind, a size in cells (w x h) and its own look (style, accent, weight, switches).
// The layout is edited in Home Assistant; editing on the panel itself is optional (switched on in
// HA): a long press opens a lock, holding the lock unlocks the edit mode.
import { Theme, Act, Words, Clock } from "theme.slint";
import { Icon, Glyph, PlayGlyph, GlowText, Marquee, RollPair, Segmented, Dropdown, Toggle, CheckBox } from "widgets.slint";
import { WeatherData, ClockData, AnalogDial, FlipClock, AmPm } from "panels.slint";
import { NixieClock, LcdClock, TwinBellClock } from "clocks.slint";

export struct HomeItem {
    kind: int,      // 0 clock, 1 date, 2 weather now, 3 next event, 4 forecast curve, 5 hourly cards, 6 daily cards, 7 music,
                    // 11 weather details (wind, humidity, rain, the sun's times)
    col: int,
    row: int,
    w: int,         // cells
    h: int,
    style: int,     // clock: 0 digital, 1 big digits + seconds line, 2 round analog, 3 square analog,
                    //        4 minimal analog, 5 analog with numerals, 6 split-flap, 7 the time in words,
                    //        8 nixie tubes, 9 LCD quartz watch, 10 twin-bell
    accent: color,  // the app fills in the panel accent when the widget has none of its own
    weight: int,    // font weight (300 .. 800), the app fills in the panel weight
    tap: bool,      // a tap opens the widget's view (fixed per kind, see tap-text in HomeGrid); off: no tap action
    neon: bool,     // neon letters on the synthwave background (each widget its own; the scene must be synthwave)
    opts: int,      // switches (bits) per kind:
                    //   clock: 1 seconds, 2 date, 4 weather, 8 next event
                    //   date: 1 year, 2 week number; weather: 1 condition, 2 high / low, 4 rain chance, 8 feels like
                    //   event: 1 time, 2 calendar colour; curve: 1 rain bars, 2 icons; hourly / daily: 1 rain chance
                    //   weather details: 1 wind, 2 humidity, 4 chance of rain, 8 sunrise and sunset
                    //   music: 1 long titles scroll (style = speed 1..5) instead of being cut off
    card: int,      // the card behind the widget: 0 = the widget's own (as designed), 1..101 = (card - 1) %
                    // opacity of a card in the card colour (the integration's "Background" slider)
}

// What the panel's music player plays (the last used player); accent = from the cover.
export struct HomeMusic {
    title: string,
    artist: string,
    player: string,
    active: bool,   // playing or paused; stopped / off / gone: the widget disappears
    playing: bool,
    pos: float,     // seconds
    dur: float,     // seconds; 0 = live stream
    art: image,
    has-art: bool,
    accent: color,
}

export struct HomeEvent {
    title: string,  // "Dentist"
    time: string,   // "15:00 – 15:45"
    rel: string,    // "in 33 min"
    tint: color,    // calendar colour
}

component Glass inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <bool> off;                // a card set in the integration replaces the glass (the content stays)
    border-radius: 16px;
    background: root.off ? transparent : root.ink.with-alpha(0.12);
}

// --------------------------------------------------------------------------- clock
component ClockW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <ClockData> clock;
    in property <WeatherData> data;
    in property <HomeEvent> event;
    in property <HomeItem> it;
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    in property <float> seconds;
    in property <bool> live: true;        // the page is on screen: only then the seconds run (a page off screen stands still)
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    property <bool> secs: root.on(1);
    property <bool> show-date: root.on(2);
    property <bool> show-wx: root.on(4);
    property <bool> show-next: root.on(8) && root.event.title != "";
    property <bool> info: root.show-date || root.show-wx;
    // the colon breathes evenly, once in 2 s
    // the seconds, sampled 30 times a second: the colon, the second hand and the seconds line move at 30 fps
    property <float> s30;
    // Calm (Clock.calm: nobody near and nothing asked of the panel for 10 minutes): over 5 s the breathing turns into a
    // plain step, bright one second and dim the next, and then the seconds tick once a second, on the whole second;
    // anything that stirs the panel brings the breathing back, gradually over 2 s.
    property <float> calm-k;
    property <bool> calm-wait;
    property <bool> calm-tick;
    property <duration> calm-d: 1s;
    property <int> calm-n;
    property <bool> calm-on: Clock.calm;
    changed calm-on => { if !root.calm-on { root.calm-wait = false; root.calm-tick = false; } }
    changed live => { root.calm-wait = false; root.calm-tick = false; }
    Timer {
        interval: root.secs ? 33ms : 1s;
        running: root.live && !root.calm-wait && !root.calm-tick;
        triggered => {
            root.s30 = root.seconds;
            if root.secs {
                if root.calm-on {
                    root.calm-k = min(1, root.calm-k + 0.033 / 5);
                } else {
                    root.calm-k = max(0, root.calm-k - 0.033 / 2);
                }
                if root.calm-on && root.calm-k >= 1 {
                    root.calm-d = (1 - Math.mod(root.s30, 1)) * 1000ms + 20ms;
                    root.calm-wait = true;
                }
            }
        }
    }
    Timer {
        interval: root.calm-d;
        running: root.live && root.calm-wait;
        triggered => {
            root.calm-wait = false;
            root.s30 = Math.mod(Math.round(root.seconds), 60);
            root.calm-n = 0;
            root.calm-tick = true;
        }
    }
    Timer {
        interval: 1s;
        running: root.live && root.calm-tick;
        triggered => {
            root.s30 = Math.mod(Math.round(root.seconds), 60);
            root.calm-n += 1;
            // once a minute back onto the whole second (the ticks drift by a few ms)
            if root.calm-n >= 60 {
                root.calm-d = (1 - Math.mod(root.seconds, 1)) * 1000ms + 20ms;
                root.calm-tick = false;
                root.calm-wait = true;
            }
        }
    }
    // on a whole second the breath is at its top or bottom: calm and breathing meet there
    property <float> breath: 0.75 + 0.25 * Math.cos(root.s30 * 180deg);
    property <float> beat: Math.mod(Math.floor(root.s30 + 0.001), 2) == 0 ? 1 : 0.5;
    property <float> colon: root.secs ? root.breath + (root.beat - root.breath) * root.calm-k : 1;
    // the accent (colon, seconds line, hands), unless it would vanish into the background: a pale accent on a light
    // scene or a dark one on a dark scene draws in the text colour instead
    property <float> acc-l: (root.it.accent.red * 0.299 + root.it.accent.green * 0.587 + root.it.accent.blue * 0.114) / 255;
    property <bool> paper-bg: root.ink.red < 128;
    property <color> acc: (root.paper-bg && root.acc-l > 0.78) || (!root.paper-bg && root.acc-l < 0.22) ? root.ink : root.it.accent;
    property <float> minutes: root.clock.mm.to-float() + root.s30 / 60;
    property <float> hours: Math.mod(root.clock.hh.to-float(), 12) + root.minutes / 60;
    property <int> st: root.it.style;
    property <bool> analog: root.st >= 2 && root.st <= 5;
    property <bool> wide: root.width > root.height * 1.5;
    property <length> side: min(root.width, root.height) - 14px;


    // 0 digital, 1 big digits with a seconds line
    if root.st == 0 || root.st == 1: dg := VerticalLayout {
        property <int> lines: root.it.h >= 2 ? (root.info ? 1 : 0) + (root.show-next ? 1 : 0) : 0;
        // (12-hour mode: the AM / PM mark takes about half a digit more)
        property <length> fs: min((root.width - 16px) / (root.clock.ampm != "" ? 3.25 : 2.75), root.st == 1 ? (root.it.h >= 2 ? 150px - self.lines * 26px : root.it.w >= 4 ? 78px : 58px)
            : root.it.h >= 2 ? 136px - self.lines * 18px : root.it.w >= 4 ? 72px : root.it.w >= 2 ? 60px : 34px);
        alignment: center;
        spacing: 0;
        HorizontalLayout {
            alignment: center;
            RollPair { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.th; font-size: dg.fs; font-weight: root.it.weight; color: root.ink; ink: root.st == 1; }
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: ":"; font-size: dg.fs; font-weight: root.it.weight; color: root.acc; opacity: root.colon; }
            RollPair { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.mm; font-size: dg.fs; font-weight: root.it.weight; color: root.ink; ink: root.st == 1; }
            AmPm { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.ampm; size: dg.fs; font-weight: root.it.weight; ink: root.ink; }
        }
        if root.st == 1 && root.secs: HorizontalLayout {
            alignment: center;
            padding-bottom: 6px;
            Rectangle {
                width: root.width * 0.78; height: 3px; border-radius: 1.5px; background: root.ink.with-alpha(0.20);
                Rectangle { x: 0; width: parent.width * root.s30 / 60; border-radius: 1.5px; background: root.acc; }
                // at the minute the full line fades out (0.25 s) over the new one instead of running back
                if root.s30 < 0.25: Rectangle { x: 0; border-radius: 1.5px; background: root.acc; opacity: 1 - root.s30 * 4; }
            }
        }
        if root.it.h >= 2 && root.info: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if root.show-date: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.date; font-size: 20px; color: root.ink.with-alpha(0.85); }
            if root.show-date && root.show-wx: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: "·"; font-size: 20px; color: root.ink.with-alpha(0.50); }
            if root.show-wx: GlowText { paper: root.ink.red < 128; icon: true; horizontal-alignment: center; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.icon; font-size: 22px; color: root.ink.with-alpha(0.85); }
            if root.show-wx: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: 20px; color: root.ink.with-alpha(0.85); }
        }
        if root.it.h >= 2 && root.show-next: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Icon { text: "\u{F00ED}"; font-size: 17px; color: root.acc; }
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.event.rel + " · " + root.event.title; font-size: 16px; color: root.ink.with-alpha(0.80); overflow: elide; }
        }
    }

    // 2..5 analog: centred; in a wide area the date / weather / next event go to its right
    if root.analog: HorizontalLayout {
        alignment: center;
        spacing: 18px;
        padding-right: root.wide ? 10px : 0px;
        VerticalLayout {
            alignment: center;
            AnalogDial {
                size: root.side;
                shape: root.st == 3 || root.st == 5 ? 1 : 0;
                minimal: root.st == 4;
                numerals: root.st == 5;
                show-seconds: root.secs;
                weekday: !root.wide && root.show-date && (root.st == 3 || root.st == 5) ? root.clock.weekday : "";
                day: root.clock.day;
                h: root.hours; m: root.minutes; s: root.s30;
                accent: root.acc; weight: root.it.weight;
                face: root.st == 4 ? transparent : #00000033;
                ink: root.ink; mark: root.ink.with-alpha(0.80); fine: root.ink.with-alpha(0.40); window-bg: #00000040;
            }
        }
        if root.wide && (root.info || root.show-next): VerticalLayout {
            alignment: center;
            spacing: 6px;
            if root.show-date: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.date; font-size: 22px; font-weight: root.it.weight; color: root.ink; overflow: elide; }
            if root.show-wx: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                GlowText { paper: root.ink.red < 128; icon: true; horizontal-alignment: center; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.icon; font-size: 26px; color: root.ink; }
                GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature + "  " + root.data.condition; font-size: 18px; color: root.ink.with-alpha(0.85); overflow: elide; }
            }
            if root.show-next: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Icon { text: "\u{F00ED}"; font-size: 18px; color: root.acc; }
                GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.event.rel + " · " + root.event.title; font-size: 15px; color: root.ink.with-alpha(0.80); overflow: elide; }
            }
        }
    }

    // 6 split-flap cards
    if root.st == 6: fg := VerticalLayout {
        // (12-hour mode: the AM / PM flap beside the minutes, 0.34 of the card height and a gap)
        property <length> chh: min(150px, root.height - 22px - (root.it.h >= 2 && root.info ? 34px : 0px) - (root.it.h >= 2 && root.show-next ? 30px : 0px),
            (root.width - 52px - (root.clock.ampm != "" ? 8px : 0px)) / (root.clock.ampm != "" ? 2.848 : 2.508));
        alignment: center;
        spacing: 10px;
        FlipClock {
            data: root.clock; weight: root.it.weight; accent: root.acc; colon: root.colon;
            card-height: fg.chh; card-width: fg.chh * 0.627;
        }
        if root.it.h >= 2 && root.info: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if root.show-date: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.date; font-size: 19px; color: root.ink.with-alpha(0.85); }
            if root.show-date && root.show-wx: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: "·"; font-size: 19px; color: root.ink.with-alpha(0.50); }
            if root.show-wx: GlowText { paper: root.ink.red < 128; icon: true; horizontal-alignment: center; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.icon; font-size: 21px; color: root.ink.with-alpha(0.85); }
            if root.show-wx: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: 19px; color: root.ink.with-alpha(0.85); }
        }
        if root.it.h >= 2 && root.show-next: HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Icon { text: "\u{F00ED}"; font-size: 17px; color: root.acc; }
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.event.rel + " · " + root.event.title; font-size: 16px; color: root.ink.with-alpha(0.80); overflow: elide; }
        }
    }

    // 8 nixie tubes (seconds from 4 cells wide), 9 the LCD quartz watch (its case from 3 x 2 cells), 10 the twin-bell
    //   clock (spec 24.9); each scaled to fit, centred, nothing behind it
    if root.st == 8: NixieClock {
        x: 4px; y: 4px; width: root.width - 8px; height: root.height - 8px;
        hh: root.clock.th; ampm: root.clock.ampm; mm: root.clock.mm; seconds: root.s30; show-seconds: root.secs && root.it.w >= 4; live: root.live && !root.calm-tick;
    }
    if root.st == 9: LcdClock {
        x: 4px; y: 4px; width: root.width - 8px; height: root.height - 8px;
        hh: root.clock.th; ampm: root.clock.ampm; mm: root.clock.mm; seconds: root.s30; weekday: root.clock.lcd-day; date: root.clock.lcd-date;
        cased: root.it.w >= 3 && root.it.h >= 2;
    }
    if root.st == 10: TwinBellClock {
        x: 4px; y: 4px; width: root.width - 8px; height: root.height - 8px;
        hours: root.hours; minutes: root.minutes; seconds: root.s30; show-seconds: root.secs;
    }

    // 7 the time in words, to the minute ("twenty-seven past / two", "quarter to / three",
    //   "seven / o'clock"); the hour word in the accent; the two lines sit close together
    property <int> th: Math.mod(root.clock.hh.to-float(), 12);
    property <int> tmin: root.clock.mm.to-float();
    property <[string]> hour-words: ["twelve", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven"];
    property <[string]> num-words: ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
        "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty",
        "twenty-one", "twenty-two", "twenty-three", "twenty-four", "twenty-five", "twenty-six", "twenty-seven", "twenty-eight", "twenty-nine"];
    property <bool> to-next: root.tmin > 30;
    property <int> mins: root.to-next ? 60 - root.tmin : root.tmin;
    property <string> hour-word: root.hour-words[Math.mod(root.th + (root.to-next ? 1 : 0), 12)];
    property <string> lead: root.mins == 15 ? (root.to-next ? "quarter to" : "quarter past") : root.mins == 30 ? "half past"
        : root.num-words[root.mins] + (root.mins == 1 ? " minute" : "") + (root.to-next ? " to" : " past");
    property <bool> on-hour: root.tmin == 0;
    property <string> line1: root.on-hour ? root.hour-word : root.lead;
    property <string> line2: root.on-hour ? "o'clock" : root.hour-word;
    property <length> big: min((root.width - 24px) / max(3, root.hour-word.character-count * 0.56), root.it.h >= 2 ? (root.it.w >= 4 ? 84px : 52px) : (root.it.w >= 4 ? 40px : 30px));
    property <length> small: min((root.width - 24px) / max(3, (root.on-hour ? 7 : root.lead.character-count) * 0.54), root.big * 0.6);
    if root.st == 7: VerticalLayout {
        alignment: center;
        spacing: -(root.big * 0.24);
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.line1; font-size: root.on-hour ? root.big : root.small; font-weight: root.it.weight;
            color: root.on-hour ? root.acc.mix(root.ink, 0.85) : root.ink.with-alpha(0.90); horizontal-alignment: center; }
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.line2; font-size: root.on-hour ? root.small : root.big; font-weight: root.it.weight;
            color: root.on-hour ? root.ink.with-alpha(0.90) : root.acc.mix(root.ink, 0.85); horizontal-alignment: center; }
    }
}

// --------------------------------------------------------------------------- date
component DateW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <ClockData> clock;
    in property <HomeItem> it;
    in property <string> weekday-long;
    in property <string> day-month;
    in property <string> year;
    in property <string> week;
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    property <string> dm: root.day-month + (root.on(1) ? " " + root.year : "");
    property <string> wl: root.weekday-long + (root.on(2) ? "  ·  " + root.week : "");
    property <length> fs4: min(28px, (root.width - 28px) / ((root.weekday-long.character-count + root.dm.character-count + 2) * 0.55));
    property <length> fs2a: min(17px, (root.width - 26px) / (root.wl.character-count * 0.56));
    property <length> fs2b: min(27px, (root.width - 26px) / (root.dm.character-count * 0.56));
    if root.it.w >= 4: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.weekday-long + ","; font-size: root.fs4; font-weight: root.it.weight; color: root.it.accent.mix(root.ink, 0.75); }
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.dm; font-size: root.fs4; font-weight: root.it.weight; color: root.ink; }
        }
        if root.on(2) && root.it.h >= 1: GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.week; font-size: 15px; color: root.ink.with-alpha(0.70); horizontal-alignment: center; }
    }
    if root.it.w >= 2 && root.it.w < 4: VerticalLayout {
        alignment: center;
        padding-left: 12px; padding-right: 10px;
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.wl; font-size: root.fs2a; font-weight: 600; color: root.it.accent.mix(root.ink, 0.75); overflow: elide; }
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.dm; font-size: root.fs2b; font-weight: root.it.weight; color: root.ink; overflow: elide; }
    }
    if root.it.w < 2: VerticalLayout {
        alignment: center;
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.weekday; font-size: 15px; font-weight: 600; color: root.it.accent.mix(root.ink, 0.75); horizontal-alignment: center; }
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.clock.day; font-size: 40px; font-weight: root.it.weight; color: root.ink; horizontal-alignment: center; }
    }
}

// --------------------------------------------------------------------------- weather now
// --------------------------------------------------------------------------- weather icon life (M12)
// The frames of the current condition, set by the app: n frames per size, the sizes 34, 44, 50, 64 in this order.
export global WxIcons {
    in property <[image]> frames;
    in property <int> n;
    // 0 none, 1 sunny (breathe 1.6 s), 2 clear night (breathe 2.4 s), 3 drops (160 ms a frame), 4 snow (240 ms),
    // 5 lightning (frame 1 for 80 ms every 3–6 s), 6 drift (no frames), 7 lightning-rainy (drops + the bolt layer, frame 3)
    in property <int> kind;
}

// The weather glyph with a little life: frames cut from the same glyph (white masks coloured with the ink; the rim
// and the neon glow drawn from the same frame, as GlowText does for text). Without frames it is the glyph, drifting
// for the cloud and wind conditions.
component WxIcon inherits Rectangle {
    in property <string> glyph;
    in property <length> size;
    in property <color> ink;
    in property <float> halo;
    in property <bool> paper;
    in property <bool> neon;
    in property <color> glow;
    property <int> si: root.size >= 64px ? 3 : root.size >= 50px ? 2 : root.size >= 44px ? 1 : 0;
    property <int> n: WxIcons.n;
    property <int> kind: WxIcons.kind;
    property <bool> has: root.n > 0 && root.kind != 6 && WxIcons.frames.length >= (root.si + 1) * root.n;
    preferred-width: root.size * 1.25; preferred-height: root.size * 1.25;
    min-width: root.size * 1.25; min-height: root.size * 1.25;
    property <float> t: (root.kind > 0 ? animation-tick() : 0ms) / 1ms;
    property <float> ph: Math.mod(root.size / 1px * 397, 4000);      // a phase of its own
    // sunny / clear night: frame 1 (dim) always, frame 0 over it fading in and out
    property <float> mix: root.kind == 1 ? 0.5 + 0.5 * Math.sin(360deg * (root.t + root.ph) / 1600)
        : root.kind == 2 ? 0.5 + 0.5 * Math.sin(360deg * (root.t + root.ph) / 2400) : 0;
    property <int> step: root.kind == 3 || root.kind == 7 ? Math.mod(Math.floor(root.t / 160), 3) : root.kind == 4 ? Math.mod(Math.floor(root.t / 240), 3) : 0;
    // the flash: 80 ms after a gap of 3–6 s (a new gap each time)
    property <int> flashes;
    property <duration> flash-t0: -1s;
    Timer {
        interval: 3000ms + Math.mod(root.flashes * 1543 + Math.round(root.ph), 3001) * 1ms;
        running: root.kind == 5 || root.kind == 7;
        triggered => { root.flash-t0 = animation-tick(); root.flashes += 1; }
    }
    property <bool> flash: (root.kind == 5 || root.kind == 7) && (animation-tick() - root.flash-t0) < 80ms && (animation-tick() - root.flash-t0) >= 0ms;
    property <length> drift: root.kind == 6 ? 1.5px * Math.sin(360deg * (root.t + root.ph) / 4500) : 0px;
    property <int> base: root.si * root.n;
    property <int> f0: root.kind == 3 || root.kind == 4 || root.kind == 7 ? root.step : root.kind == 5 ? (root.flash ? 1 : 0) : root.kind == 1 || root.kind == 2 ? 1 : 0;
    property <image> main: root.has ? WxIcons.frames[root.base + root.f0] : @image-url("");
    property <image> shape: root.has ? WxIcons.frames[root.base] : @image-url("");
    property <image> bolt: root.has && root.kind == 7 && root.n >= 4 ? WxIcons.frames[root.base + 3] : @image-url("");
    property <length> d: max(0.8px, min(2.2px, root.size / 46));
    property <length> gi: max(1.8px, min(5px, root.size / 22));
    property <color> rim: root.paper ? #F5F3EE.with-alpha(0.55 * min(1, root.halo)) : #000000.with-alpha(0.18 * min(1, root.halo));
    property <length> ix: (root.width - root.size) / 2;
    property <length> iy: (root.height - root.size) / 2;
    if !root.has: GlowText { x: root.drift; width: parent.width; height: parent.height; paper: root.paper; icon: true; horizontal-alignment: center;
        k: root.halo; neon: root.neon; glow: root.glow; text: root.glyph; font-size: root.size; color: root.ink; }
    // neon: one ring of glow copies (as GlowText)
    if root.has && root.neon: Rectangle {
        for o in [{ x: -1, y: 0 }, { x: 1, y: 0 }, { x: 0, y: -1 }, { x: 0, y: 1 }, { x: -0.71, y: -0.71 }, { x: 0.71, y: -0.71 }, { x: -0.71, y: 0.71 }, { x: 0.71, y: 0.71 }]: Image {
            x: root.ix + o.x * root.gi; y: root.iy + o.y * root.gi; width: root.size; height: root.size; source: root.shape; colorize: root.glow.with-alpha(0.24); }
    }
    // the rim: four faint copies, a little more downwards (as GlowText)
    if root.has && !root.neon && root.halo > 0.01: Rectangle {
        for o in [{ x: -1, y: -0.35 }, { x: 1, y: -0.35 }, { x: -1, y: 1.5 }, { x: 1, y: 1.5 }]: Image {
            x: root.ix + o.x * root.d; y: root.iy + o.y * root.d; width: root.size; height: root.size;
            source: root.main; colorize: root.rim; }
        // sunny / clear night: the full shape's rim fades with it
        if root.kind == 1 || root.kind == 2: Rectangle {
            for o in [{ x: -1, y: -0.35 }, { x: 1, y: -0.35 }, { x: -1, y: 1.5 }, { x: 1, y: 1.5 }]: Image {
                x: root.ix + o.x * root.d; y: root.iy + o.y * root.d; width: root.size; height: root.size; source: root.shape; colorize: root.rim; opacity: root.mix; }
        }
        if root.kind == 7: Rectangle {
            for o in [{ x: -1, y: -0.35 }, { x: 1, y: -0.35 }, { x: -1, y: 1.5 }, { x: 1, y: 1.5 }]: Image {
                x: root.ix + o.x * root.d; y: root.iy + o.y * root.d; width: root.size; height: root.size; source: root.bolt; colorize: root.rim; }
        }
    }
    if root.has: Image { x: root.ix; y: root.iy; width: root.size; height: root.size; source: root.main; colorize: root.ink; }
    if root.has && (root.kind == 1 || root.kind == 2): Image { x: root.ix; y: root.iy; width: root.size; height: root.size;
        source: root.shape; colorize: root.ink; opacity: root.mix; }
    if root.has && root.kind == 7: Image { x: root.ix; y: root.iy; width: root.size; height: root.size;
        source: root.bolt; colorize: root.ink; opacity: root.flash ? 0.35 : 1; }
    // neon: the hot whiter core
    if root.has && root.neon: Image { x: root.ix; y: root.iy; width: root.size; height: root.size; source: root.main; colorize: #ffffff73; }
}

component WeatherW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <HomeItem> it;
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    property <string> sep: root.it.w >= 4 && root.it.h >= 2 ? "   ·   " : " · ";
    property <string> extra: (root.on(2) ? root.data.high-low : "")
        + (root.on(2) && root.on(4) ? root.sep : "") + (root.on(4) ? root.data.precip + " rain" : "")
        + ((root.on(2) || root.on(4)) && root.on(8) ? root.sep : "") + (root.on(8) ? root.data.feels : "");
    if root.it.h >= 2: VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            WxIcon { glyph: root.data.icon; size: 64px; ink: root.ink; halo: root.halo; paper: root.ink.red < 128; neon: root.neon; glow: root.glow; }
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: 104px; font-weight: root.it.weight; color: root.ink; }
        }
        if root.on(1): GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.condition; font-size: 24px; color: root.ink; horizontal-alignment: center; }
        if root.extra != "": GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.extra; font-size: 16px; color: root.ink.with-alpha(0.80); horizontal-alignment: center; }
    }
    if root.it.h < 2 && root.it.w >= 4: HorizontalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 10px; padding-right: 10px;
        WxIcon { glyph: root.data.icon; size: 50px; ink: root.ink; halo: root.halo; paper: root.ink.red < 128; neon: root.neon; glow: root.glow; }
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: 60px; font-weight: root.it.weight; color: root.ink; }
        VerticalLayout {
            alignment: center;
            if root.on(1): GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.condition; font-size: 18px; color: root.ink; overflow: elide; }
            if root.extra != "": GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.extra; font-size: 14px; color: root.ink.with-alpha(0.80); overflow: elide; }
        }
    }
    if root.it.h < 2 && root.it.w >= 2 && root.it.w < 4: HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 10px; padding-right: 10px;
        WxIcon { glyph: root.data.icon; size: 44px; ink: root.ink; halo: root.halo; paper: root.ink.red < 128; neon: root.neon; glow: root.glow; }
        VerticalLayout {
            alignment: center;
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: root.on(1) && root.extra != "" ? 34px : 40px; font-weight: root.it.weight; color: root.ink; }
            if root.on(1): GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.condition; font-size: 14px; color: root.ink.with-alpha(0.80); overflow: elide; }
            if root.extra != "": GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.extra; font-size: 12px; color: root.ink.with-alpha(0.75); overflow: elide; }
        }
    }
    if root.it.w < 2: VerticalLayout {
        alignment: center;
        WxIcon { glyph: root.data.icon; size: 34px; ink: root.ink; halo: root.halo; paper: root.ink.red < 128; neon: root.neon; glow: root.glow; }
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.data.temperature; font-size: 26px; font-weight: root.it.weight; color: root.ink; horizontal-alignment: center; }
    }
}

// --------------------------------------------------------------------------- next event
component EventW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <HomeEvent> event;
    in property <HomeItem> it;
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    Glass { ink: root.ink; off: root.it.card > 0;
        x: 4px; y: 6px; width: parent.width - 8px; height: parent.height - 12px;
        Rectangle { x: 12px; y: 14px; width: 4px; height: parent.height - 28px; border-radius: 2px; background: root.on(2) ? root.event.tint : root.it.accent; }
        if root.it.w >= 4: VerticalLayout {
            x: 28px; width: parent.width - 40px;
            alignment: center;
            spacing: 1px;
            Text { text: root.event.rel + (root.on(1) ? "  ·  " + root.event.time : ""); font-size: 14px; color: root.ink.with-alpha(0.80); }
            Text { text: root.event.title; font-size: 24px; font-weight: root.it.weight; color: root.ink; overflow: elide; }
        }
        if root.it.w < 4: VerticalLayout {
            x: 26px; width: parent.width - 34px;
            alignment: center;
            Text { text: root.event.rel + (root.on(1) && root.event.time != "" ? " · " + root.event.time : ""); font-size: 13px; color: root.ink.with-alpha(0.80); overflow: elide; }
            Text { text: root.event.title; font-size: 19px; font-weight: root.it.weight; color: root.ink; overflow: elide; }
        }
    }
}

// --------------------------------------------------------------------------- forecast curve
component CurveW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <HomeItem> it;
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    property <bool> icons: root.it.h >= 2 && root.on(2);
    Glass { ink: root.ink; off: root.it.card > 0; x: 4px; y: 6px; width: parent.width - 8px; height: parent.height - 12px; }
    property <length> pw: self.width - 56px;
    property <length> top: self.icons ? 64px : 30px;
    property <length> ph: self.height - self.top - 34px;
    property <float> tmin: min(root.data.hours[0].temp, root.data.hours[1].temp, root.data.hours[2].temp, root.data.hours[3].temp, root.data.hours[4].temp, root.data.hours[5].temp) - 0.5;
    property <float> tmax: max(root.data.hours[0].temp, root.data.hours[1].temp, root.data.hours[2].temp, root.data.hours[3].temp, root.data.hours[4].temp, root.data.hours[5].temp) + 0.5;
    function cx(i: int) -> float { (root.pw / 1px) * i / 5 }
    function cy(t: float) -> float { (root.ph / 1px) * (1 - (t - root.tmin) / (root.tmax - root.tmin)) }
    // rain chance as faint bars under the curve
    for h[i] in root.data.hours: Rectangle {
        visible: root.on(1);
        x: 28px + root.cx(i) * 1px - 9px; width: 18px;
        height: (root.ph + 6px) * h.precip / 100;
        y: root.top + root.ph + 6px - self.height;
        border-radius: 3px;
        background: #6cb6ff55;
    }
    Path {
        x: 28px - 1.5px; y: root.top - 1.5px; width: root.pw + 3px; height: root.ph + 3px;
        viewbox-width: root.pw / 1px; viewbox-height: root.ph / 1px;
        stroke: root.ink; stroke-width: 2.5px;
        commands: "M " + root.cx(0) + " " + root.cy(root.data.hours[0].temp)
            + " C " + (root.cx(0) + root.cx(1)) / 2 + " " + root.cy(root.data.hours[0].temp) + " " + (root.cx(0) + root.cx(1)) / 2 + " " + root.cy(root.data.hours[1].temp) + " " + root.cx(1) + " " + root.cy(root.data.hours[1].temp)
            + " C " + (root.cx(1) + root.cx(2)) / 2 + " " + root.cy(root.data.hours[1].temp) + " " + (root.cx(1) + root.cx(2)) / 2 + " " + root.cy(root.data.hours[2].temp) + " " + root.cx(2) + " " + root.cy(root.data.hours[2].temp)
            + " C " + (root.cx(2) + root.cx(3)) / 2 + " " + root.cy(root.data.hours[2].temp) + " " + (root.cx(2) + root.cx(3)) / 2 + " " + root.cy(root.data.hours[3].temp) + " " + root.cx(3) + " " + root.cy(root.data.hours[3].temp)
            + " C " + (root.cx(3) + root.cx(4)) / 2 + " " + root.cy(root.data.hours[3].temp) + " " + (root.cx(3) + root.cx(4)) / 2 + " " + root.cy(root.data.hours[4].temp) + " " + root.cx(4) + " " + root.cy(root.data.hours[4].temp)
            + " C " + (root.cx(4) + root.cx(5)) / 2 + " " + root.cy(root.data.hours[4].temp) + " " + (root.cx(4) + root.cx(5)) / 2 + " " + root.cy(root.data.hours[5].temp) + " " + root.cx(5) + " " + root.cy(root.data.hours[5].temp);
    }
    for h[i] in root.data.hours: Rectangle {
        x: 28px + root.cx(i) * 1px - 4px; y: root.top + root.cy(h.temp) * 1px - 4px; width: 8px; height: 8px; border-radius: 4px;
        background: i == 0 ? root.it.accent : root.ink;
    }
    for h[i] in root.data.hours: Text {
        x: 28px + root.cx(i) * 1px - 20px; y: root.top + root.cy(h.temp) * 1px - 22px; width: 40px;
        text: round(h.temp) + "°"; font-size: 13px; font-weight: root.it.weight; color: root.ink; horizontal-alignment: center;
    }
    if root.icons: Rectangle {
        for h[i] in root.data.hours: Icon {
            x: 28px + root.cx(i) * 1px - 14px; y: 14px; width: 28px; height: 28px;
            text: h.icon; font-size: 22px; color: root.ink;
        }
    }
    for h[i] in root.data.hours: Text {
        x: 28px + root.cx(i) * 1px - 20px; y: root.height - 30px; width: 40px;
        text: i == 0 ? "Now" : h.label; font-size: 12px; color: root.ink.with-alpha(0.80); horizontal-alignment: center;
    }
}

// --------------------------------------------------------------------------- forecast cards
component HourlyW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <HomeItem> it;
    property <bool> rain: Math.mod(root.it.opts, 2) == 1;
    property <length> chh: root.rain ? 84px : 70px;
    // as many hours as fit the widget's width (the forecast has up to 12)
    property <int> fit: Math.floor((root.width - 4px + 6px) / 68px);
    HorizontalLayout {
        alignment: center;
        padding-top: (root.height - root.chh) / 2; padding-bottom: (root.height - root.chh) / 2;
        for h[i] in root.data.hours: Rectangle {
            width: i >= root.fit ? 0px : i == 0 ? 62px : 68px;
            visible: i < root.fit;
            Rectangle {
                x: parent.width - 62px; width: 62px; height: root.chh; border-radius: 14px;
                background: root.ink.with-alpha(0.12);
                VerticalLayout {
                    alignment: center;
                    Text { text: h.label; font-size: 12px; color: root.ink.with-alpha(0.80); horizontal-alignment: center; }
                    Icon { text: h.icon; font-size: 20px; color: root.ink; }
                    Text { text: round(h.temp) + "°"; font-size: 14px; font-weight: root.it.weight; color: root.ink; horizontal-alignment: center; }
                    if root.rain: Text { text: h.precip + "%"; font-size: 11px; color: root.ink.red < 128 ? #1f6fc0 : #8cc8ff; horizontal-alignment: center; }
                }
            }
        }
    }
}

component DailyW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <HomeItem> it;
    property <bool> rain: Math.mod(root.it.opts, 2) == 1;
    property <length> chh: root.rain ? 86px : 76px;
    // as many days as fit the widget's width (the forecast has up to 7)
    property <int> fit: Math.floor((root.width - 4px + 6px) / 90px);
    HorizontalLayout {
        alignment: center;
        padding-top: (root.height - root.chh) / 2; padding-bottom: (root.height - root.chh) / 2;
        for d[i] in root.data.days: Rectangle {
            width: i >= root.fit ? 0px : i == 0 ? 84px : 90px;
            visible: i < root.fit;
            Rectangle {
                x: parent.width - 84px; width: 84px; height: root.chh; border-radius: 14px;
                background: root.ink.with-alpha(0.12);
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text { text: d.label; font-size: 12px; color: root.ink.with-alpha(0.80); horizontal-alignment: center; }
                    Icon { text: d.icon; font-size: 22px; color: root.ink; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: round(d.high) + "°"; font-size: 14px; font-weight: root.it.weight; color: root.ink; }
                        Text { text: round(d.low) + "°"; font-size: 14px; color: root.ink.with-alpha(0.60); }
                    }
                    if root.rain: Text { text: d.precip + "%"; font-size: 11px; color: root.ink.red < 128 ? #1f6fc0 : #8cc8ff; horizontal-alignment: center; }
                }
            }
        }
    }
}

// --------------------------------------------------------------------------- weather details
// One part of the details as a chip: its icon and value (with the widgets' glyph rim, or neon, over the background).
component DetailChip inherits Rectangle {
    in property <color> ink;
    in property <string> icon;
    in property <string> text;
    in property <int> weight: 600;
    in property <bool> small;              // the narrow widget's two rows
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    height: root.small ? 30px : 36px;
    border-radius: self.height / 2;
    background: root.ink.with-alpha(0.12);
    HorizontalLayout {
        padding-left: root.small ? 8px : 10px; padding-right: root.small ? 10px : 12px; spacing: root.small ? 4px : 5px;
        VerticalLayout { alignment: center;
            GlowText { icon: true; paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.icon; font-size: root.small ? 14px : 16px; color: root.ink.with-alpha(0.85); } }
        VerticalLayout { alignment: center;
            GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.text; font-size: root.small ? 12px : 14px; font-weight: root.weight; color: root.ink; } }
    }
}

// One part of the details as a line of a tall widget: its icon, name and value.
component DetailLine inherits HorizontalLayout {
    in property <color> ink;
    in property <string> icon;
    in property <string> name;
    in property <string> text;
    in property <int> weight: 600;
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    height: 36px;
    spacing: 10px;
    VerticalLayout { alignment: center; width: 26px;
        GlowText { icon: true; horizontal-alignment: center; paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.icon; font-size: 22px; color: root.ink.with-alpha(0.85); } }
    VerticalLayout { alignment: center; horizontal-stretch: 1;
        GlowText { paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.name; font-size: 16px; color: root.ink.with-alpha(0.85); } }
    VerticalLayout { alignment: center;
        GlowText { horizontal-alignment: right; paper: root.ink.red < 128; k: root.halo; neon: root.neon; glow: root.glow; text: root.text; font-size: 18px; font-weight: root.weight; color: root.ink; } }
}

// Wind, humidity, the chance of rain and the sun's times (opts 1, 2, 4, 8): a row of chips on a wide widget, two rows of
// two on a narrower one, name and value line by line on a tall one.
component DetailsW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <HomeItem> it;
    in property <float> halo;
    in property <bool> neon;
    in property <color> glow;
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.it.opts / bit), 2) == 1 }
    property <string> sun: root.data.sunrise + " – " + root.data.sunset;
    property <bool> tall: root.it.h >= 2;
    property <bool> wide: !root.tall && root.it.w >= 4;
    if root.tall: VerticalLayout {
        padding-left: 18px; padding-right: 18px;
        alignment: center;
        spacing: 4px;
        if root.on(1): DetailLine { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059D}"; name: "Wind"; text: root.data.wind; }
        if root.on(2): DetailLine { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F058E}"; name: "Humidity"; text: root.data.humidity; }
        if root.on(4): DetailLine { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F054A}"; name: "Rain"; text: root.data.precip; }
        if root.on(8): DetailLine { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059C}"; name: "Sun"; text: root.sun; }
    }
    if root.wide: HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-top: (root.height - 36px) / 2; padding-bottom: (root.height - 36px) / 2;
        if root.on(1): DetailChip { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059D}"; text: root.data.wind; }
        if root.on(2): DetailChip { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F058E}"; text: root.data.humidity; }
        if root.on(4): DetailChip { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F054A}"; text: root.data.precip; }
        if root.on(8): DetailChip { ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059C}"; text: root.sun; }
    }
    if !root.tall && !root.wide: VerticalLayout {
        alignment: center;
        spacing: 6px;
        if root.on(1) || root.on(2): HorizontalLayout {
            alignment: center;
            spacing: 6px;
            if root.on(1): DetailChip { small: true; ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059D}"; text: root.data.wind; }
            if root.on(2): DetailChip { small: true; ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F058E}"; text: root.data.humidity; }
        }
        if root.on(4) || root.on(8): HorizontalLayout {
            alignment: center;
            spacing: 6px;
            if root.on(4): DetailChip { small: true; ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F054A}"; text: root.data.precip; }
            if root.on(8): DetailChip { small: true; ink: root.ink; halo: root.halo; neon: root.neon; glow: root.glow; weight: root.it.weight; icon: "\u{F059C}"; text: root.sun; }
        }
    }
}

// --------------------------------------------------------------------------- music
component MusicW inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <HomeMusic> m;
    in property <float> pos;
    in property <HomeItem> it;
    in property <float> halo: 1;
    in property <bool> neon;
    in property <color> glow;
    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function mmss(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(t / 60), 60)) + ":" + root.two(Math.mod(Math.floor(t), 60))
            : Math.floor(t / 60) + ":" + root.two(Math.mod(Math.floor(t), 60))
    }
    // the position runs on between the app's updates (about once a second), stepped by a timer whenever the shown
    // second changes: nothing here follows the animation clock, so the times stay cached layers between seconds
    // (over the synthwave scene a time redrawn every frame cost about 10 ms a frame)
    property <float> pos-base: root.pos;
    property <duration> pos-t;
    property <float> pos-live: root.pos;
    changed pos => { root.pos-base = root.pos; root.pos-t = animation-tick(); root.pos-live = root.pos; }
    Timer {
        interval: 250ms;
        running: root.m.playing && root.m.dur > 0;
        triggered => {
            let p = Math.min(root.m.dur, root.pos-base + Math.min(2, (animation-tick() - root.pos-t) / 1s));
            if Math.floor(p) != Math.floor(root.pos-live) { root.pos-live = p; }
        }
    }
    property <float> fr: root.m.dur > 0 ? max(0, min(1, root.pos-live / root.m.dur)) : 0;
    property <color> acc: root.m.accent;
    // the weight slider of the integration: the title at that weight, the smaller lines a step lighter
    property <int> sub-weight: max(300, root.it.weight - 100);
    // the cover: the next one fades in over the last (300 ms)
    property <image> art-in: root.m.art;
    property <image> art-a: root.m.art;
    property <image> art-b;
    property <bool> art-on-b;
    changed art-in => {
        if root.art-on-b { root.art-a = root.art-in; root.art-on-b = false; } else { root.art-b = root.art-in; root.art-on-b = true; }
    }
    property <float> art-k: root.art-on-b ? 1 : 0;
    animate art-k { duration: 300ms; easing: ease-in-out; }
    property <bool> scroll: Math.mod(root.it.opts, 2) == 1;
    property <float> speed: root.it.style > 0 ? root.it.style : 3;
    // the widget comes and goes with the player's track over 250 ms instead of popping
    property <float> active-k: root.m.active ? 1 : 0;
    animate active-k { duration: 250ms; easing: ease-in-out; }
    if root.active-k > 0.001: Glass { ink: root.ink; off: root.it.card > 0; opacity: root.active-k;
        x: 4px; y: 6px; width: parent.width - 8px; height: parent.height - 12px;
        // 1 x 1: the cover, a thin progress line under it and the time
        if root.it.w < 2: Rectangle {
            Rectangle {
                x: (parent.width - 54px) / 2; y: 6px; width: 54px; height: 54px;
                background: @linear-gradient(135deg, root.acc.mix(#000000, 0.55) 0%, root.acc.mix(#000000, 0.25) 100%);
                if root.m.has-art && root.art-k < 0.999: Image { width: parent.width; height: parent.height; source: root.art-a; image-fit: cover; }
                if root.m.has-art && root.art-k > 0.001: Image { width: parent.width; height: parent.height; source: root.art-b; image-fit: cover; opacity: root.art-k; }
                if !root.m.has-art: Icon { text: "\u{F0387}"; font-size: 30px; color: root.ink.with-alpha(0.80); }
            }
            if root.m.dur > 0: Rectangle {
                x: (parent.width - 54px) / 2; y: 63px; width: 54px; height: 3px; border-radius: 1.5px; background: root.ink.with-alpha(0.20);
                Rectangle { x: 0; width: parent.width * root.fr; border-radius: 1.5px; background: root.acc; }
            }
            GlowText { paper: root.ink.red < 128; x: 0; y: 67px; width: parent.width; height: 16px; text: root.m.dur > 0 ? root.mmss(root.pos-live) : "LIVE"; k: root.halo; neon: root.neon; glow: root.glow;
                font-size: 12px; font-weight: root.sub-weight; color: root.ink.with-alpha(0.88); horizontal-alignment: center; }
            if !root.m.playing: Rectangle {
                x: (parent.width - 54px) / 2 + 54px - 20px; y: 6px + 54px - 20px; width: 20px; height: 20px; border-radius: 10px; background: #000000a0;
                Icon { width: parent.width; height: parent.height; text: "\u{F03E4}"; font-size: 14px; color: root.ink; }
            }
        }
        // 2 x 1 and wider: cover, title, artist, progress with the times; 3 x 1 + play; 4 x 1 + previous / next, player
        property <length> rgt: root.it.w >= 4 ? 124px : root.it.w >= 3 ? 64px : 12px;
        if root.it.w >= 2: Rectangle {
            x: 8px; y: 8px; width: 70px; height: 70px;
            background: @linear-gradient(135deg, root.acc.mix(#000000, 0.55) 0%, root.acc.mix(#000000, 0.25) 100%);
            if root.m.has-art && root.art-k < 0.999: Image { width: parent.width; height: parent.height; source: root.art-a; image-fit: cover; }
                if root.m.has-art && root.art-k > 0.001: Image { width: parent.width; height: parent.height; source: root.art-b; image-fit: cover; opacity: root.art-k; }
            if !root.m.has-art: Icon { text: "\u{F0387}"; font-size: 36px; color: root.ink.with-alpha(0.80); }
        }
        if root.it.w >= 2: Marquee { x: 90px; y: 9px; width: parent.width - 90px - parent.rgt; height: 20px; text: root.m.title; k: root.halo; neon: root.neon; glow: root.glow;
            font-size: 15px; font-weight: root.it.weight; color: root.ink; scroll: root.scroll; speed: root.speed; }
        if root.it.w >= 2: Marquee { x: 90px; y: 29px; width: parent.width - 90px - parent.rgt; height: 18px; text: root.m.artist; k: root.halo; neon: root.neon; glow: root.glow;
            font-size: 12px; font-weight: root.sub-weight; color: root.ink.with-alpha(0.88); scroll: root.scroll; speed: root.speed; }
        if root.it.w >= 2 && root.m.dur > 0: Rectangle {
            x: 90px; y: 56px; width: parent.width - 90px - parent.rgt; height: 3px; border-radius: 1.5px; background: root.ink.with-alpha(0.20);
            Rectangle { x: 0; width: parent.width * root.fr; border-radius: 1.5px; background: root.acc; }
        }
        if root.it.w >= 2 && root.m.dur > 0: GlowText { paper: root.ink.red < 128; x: 90px; y: 61px; width: 50px; height: 16px; text: root.mmss(root.pos-live); k: root.halo; neon: root.neon; glow: root.glow;
            font-size: 12px; font-weight: root.sub-weight; color: root.ink.with-alpha(0.92); }
        if root.it.w >= 2 && root.m.dur > 0: GlowText { paper: root.ink.red < 128; x: parent.width - parent.rgt - 50px; y: 61px; width: 50px; height: 16px; k: root.halo; neon: root.neon; glow: root.glow;
            text: "−" + root.mmss(max(0, root.m.dur - root.pos-live)); font-size: 12px; font-weight: root.sub-weight; color: root.ink.with-alpha(0.92); horizontal-alignment: right; }
        if root.it.w >= 2 && root.m.dur <= 0: Rectangle {
            x: 90px; y: 56px; width: 40px; height: 18px; border-radius: 9px; background: root.acc.with-alpha(0.3);
            Text { text: "LIVE"; font-size: 10px; font-weight: 700; color: root.ink; horizontal-alignment: center; vertical-alignment: center; }
        }
        // 4 x 1: the player between the times
        if root.it.w >= 4 && root.m.dur > 0: HorizontalLayout {
            x: 90px + 50px; y: 61px; width: parent.width - 90px - parent.rgt - 100px; height: 16px; alignment: center; spacing: 3px;
            GlowText { paper: root.ink.red < 128; icon: true; text: "\u{F04C3}"; font-size: 11px; color: root.ink.with-alpha(0.80); k: root.halo; neon: root.neon; glow: root.glow; }
            GlowText { paper: root.ink.red < 128; text: root.m.player; font-size: 11px; font-weight: root.sub-weight; color: root.ink.with-alpha(0.80); overflow: elide; k: root.halo; neon: root.neon; glow: root.glow; horizontal-stretch: 1; }
        }
        // the buttons act on the widget's player in place (hit areas of 48 px); the page does not change
        if root.it.w >= 3: Rectangle {
            x: parent.width - (root.it.w >= 4 ? 84px : 52px); y: (parent.height - 44px) / 2; width: 44px; height: 44px; border-radius: 22px;
            background: play-ta.pressed ? root.acc.darker(0.3) : root.acc;
            animate background { duration: 120ms; easing: ease-out; }
            PlayGlyph { width: parent.width; height: parent.height; playing: root.m.playing; ink: root.ink; }
            play-ta := TouchArea { x: -2px; y: -2px; width: 48px; height: 48px; clicked => { Act.act("music.play", "widget"); } }
        }
        if root.it.w >= 4: Rectangle {
            x: parent.width - 126px; y: (parent.height - 48px) / 2; width: 48px; height: 48px; border-radius: 24px;
            background: prev-ta.pressed ? root.ink.with-alpha(0.18) : transparent;
            animate background { duration: 120ms; easing: ease-out; }
            Icon { width: parent.width; height: parent.height; text: "\u{F04AE}"; font-size: 26px; color: root.ink; }
            prev-ta := TouchArea { clicked => { Act.act("music.prev", "widget"); } }
        }
        if root.it.w >= 4: Rectangle {
            x: parent.width - 46px; y: (parent.height - 48px) / 2; width: 48px; height: 48px; border-radius: 24px;
            background: next-ta.pressed ? root.ink.with-alpha(0.18) : transparent;
            animate background { duration: 120ms; easing: ease-out; }
            Icon { width: parent.width; height: parent.height; text: "\u{F04AD}"; font-size: 26px; color: root.ink; }
            next-ta := TouchArea { clicked => { Act.act("music.next", "widget"); } }
        }
    }
}

// Any widget, sized by its parent (grid cell, picker preview, settings preview).
export component HomeWidget inherits Rectangle {
    in property <color> ink: #ffffff;      // text and lines (Ink on the plain light background)
    in property <HomeItem> it;
    in property <WeatherData> data;
    in property <ClockData> clock;
    in property <HomeEvent> event;
    in property <string> weekday-long;
    in property <string> day-month;
    in property <string> year;
    in property <string> week;
    in property <float> halo: 1;
    in property <bool> neon;
    in property <color> glow;
    in property <HomeMusic> music;
    in property <float> seconds;
    in property <float> music-pos;
    in property <bool> live: true;        // on screen (the clock's seconds run only then)
    // Widgets without per-second changes are drawn once into a layer; the clock and
    // the music widget keep their moving parts live (their texts are layers of their own).
    cache-rendering-hint: root.it.kind != 0 && root.it.kind != 7 && !(root.it.kind == 2 && WxIcons.kind > 0);
    // a card set in the integration (0 % = none, 100 % = solid), dark under white text, Paper under Ink
    if root.it.card > 0: Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; border-radius: 16px;
        background: (root.ink.red > 128 ? #121314 : #F5F3EE).with-alpha((root.it.card - 1) / 100);
    }
    if root.it.kind == 7: MusicW { width: root.width; height: root.height; ink: root.ink; m: root.music; pos: root.music-pos; it: root.it; halo: root.halo; neon: root.neon; glow: root.glow; }
    if root.it.kind == 0: ClockW { width: root.width; height: root.height; ink: root.ink; clock: root.clock; seconds: root.seconds; data: root.data; event: root.event; it: root.it; halo: root.halo; neon: root.neon; glow: root.glow; live: root.live; }
    if root.it.kind == 1: DateW { width: root.width; height: root.height; ink: root.ink; clock: root.clock; it: root.it; weekday-long: root.weekday-long; day-month: root.day-month;
        year: root.year; week: root.week; halo: root.halo; neon: root.neon; glow: root.glow; }
    if root.it.kind == 2: WeatherW { width: root.width; height: root.height; ink: root.ink; data: root.data; it: root.it; halo: root.halo; neon: root.neon; glow: root.glow; }
    if root.it.kind == 3: EventW { width: root.width; height: root.height; ink: root.ink; event: root.event; it: root.it; }
    if root.it.kind == 4: CurveW { width: root.width; height: root.height; ink: root.ink; data: root.data; it: root.it; }
    if root.it.kind == 5: HourlyW { width: root.width; height: root.height; ink: root.ink; data: root.data; it: root.it; }
    if root.it.kind == 6: DailyW { width: root.width; height: root.height; ink: root.ink; data: root.data; it: root.it; }
    if root.it.kind == 11: DetailsW { width: root.width; height: root.height; ink: root.ink; data: root.data; it: root.it; halo: root.halo; neon: root.neon; glow: root.glow; }
}

// Edit frame of a widget: the outline with the same rounded corners, a thicker arc on the
// bottom-right corner (drag it to resize) and the remove badge.
component EditFrame inherits Rectangle {
    in property <bool> up;          // being dragged
    in property <bool> selected;    // its settings are open (HA)
    in property <color> accent;
    property <length> s: 5px;       // arc stroke
    property <float> X: self.width / 1px - 2.75;
    property <float> Y: self.height / 1px - 2.75;
    property <float> r: 15.25;
    property <float> L: 20;
    Rectangle {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; border-radius: 16px;
        background: root.up ? #ffffff26 : root.selected ? #ffffff1a : #ffffff0f;
        border-width: root.up || root.selected ? 2px : 1.5px;
        border-color: root.up || root.selected ? root.accent : #ffffffb3;
    }
    Path {
        x: -root.s / 2; y: -root.s / 2; width: root.width + root.s; height: root.height + root.s;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.up || root.selected ? root.accent : #ffffff; stroke-width: root.s;
        commands: "M " + root.X + " " + (root.Y - root.r - root.L) + " L " + root.X + " " + (root.Y - root.r)
            + " A " + root.r + " " + root.r + " 0 0 1 " + (root.X - root.r) + " " + root.Y
            + " L " + (root.X - root.r - root.L) + " " + root.Y;
    }
    Rectangle {
        x: -4px; y: -4px; width: 24px; height: 24px; border-radius: 12px; background: #3a3a40; border-width: 1.5px; border-color: #ffffffcc;
        Icon { text: "\u{F0374}"; font-size: 16px; color: #ffffff; }
    }
}


// Clean editor: explanations sit behind an info button; a tap opens a small card with them.
component InfoButton inherits Rectangle {
    in property <bool> on;
    width: 36px; height: 36px; border-radius: 18px;
    background: root.on ? #ffffff40 : #ffffff1f;
    Icon { text: "\u{F02FD}"; font-size: 21px; color: #ffffffe6; }
}

component InfoPop inherits Rectangle {
    in property <[string]> lines;
    in property <length> w: 320px;
    // M5: the bubble grows out of its button (140 ms)
    property <float> grow: 0;
    init => { root.grow = 1; }
    animate grow { duration: 140ms; easing: ease-out; }
    opacity: root.grow;
    transform-scale-x: 0.85 + 0.15 * root.grow;
    transform-scale-y: 0.85 + 0.15 * root.grow;
    transform-origin: { x: 18px, y: self.height };
    width: self.w;
    height: 20px + self.lines.length * 26px;
    border-radius: 16px;
    background: #2a2a2ff7;
    border-width: 1px; border-color: #ffffff1a;
    for l[i] in root.lines: Text {
        x: 16px; y: 10px + i * 26px; width: root.width - 32px; height: 26px;
        text: l; font-size: 14px; color: #ffffffdd; vertical-alignment: center;
    }
}

export component HomeGrid inherits Rectangle {
    in property <[HomeItem]> items;
    in property <color> ink: #ffffff;     // the widgets' text and lines (Ink on the plain light background)
    in property <WeatherData> data;
    in property <ClockData> clock;
    in property <HomeEvent> event;
    in property <HomeMusic> music;
    in property <float> seconds;
    in property <float> music-pos;
    in property <string> weekday-long: "Monday";
    in property <string> day-month: "9 November";
    in property <string> year: "2026";
    in property <string> week: "Week 46";
    in property <color> accent: Theme.accent;
    in property <float> halo: 1;          // how much glow the background needs behind white text
    in property <bool> neon;              // neon letters (Fast Lane background)
    in property <color> glow;             // … in the scene's colour
    in property <bool> fast-lane;         // the background is the synthwave scene: the edit mode offers its sheet
    in property <bool> weather-only;      // the weather details page: its picker offers the weather widgets only, and
                                          // its widgets open nothing (they are on the page they would open)
    in property <bool> bg-sheet;          // panel edit mode: the background sheet is open
    in property <int> fl-scene;
    in property <bool> fl-cars: true;
    in property <bool> rise;              // 25.H6: the widgets rise into place when the page comes into view (the plain background)
    in property <bool> shown;
    in property <bool> live: true;        // the page is (partly) on screen: clocks run only then
    property <bool> rising;
    property <duration> rise-t0;
    changed shown => { if root.rise && root.shown { root.rise-t0 = animation-tick(); root.rising = true; } }
    Timer { interval: 700ms; running: root.rising; triggered => { root.rising = false; } }
    property <float> rise-t: root.rising ? (animation-tick() - root.rise-t0) / 1ms : 10000;
    in property <bool> editing;
    in property <bool> ha-mode;           // the editor inside Home Assistant: same look, its own controls
    in property <int> selected: -1;       // HA: the widget whose settings are shown
    in property <int> lifted: -1;         // edit mode: the widget being dragged
    in property <length> lift-dx;         // ... and how far it is from its cell
    in property <length> lift-dy;
    in property <int> drop-col: -1;       // the cells it would land on
    in property <int> drop-row: -1;
    in property <bool> picker;            // the "add widget" sheet
    in property <length> picker-scroll;
    in property <bool> lock;              // long press with panel editing allowed: the lock dialog
    in property <float> lock-p;           // holding the lock: 0..1, at 1 the edit mode opens
    in property <string> lock-title: "Redecorating again?";
    in property <string> lock-sub: "Hold the lock to start editing.";
    in property <int> settings: -1;       // panel: the widget whose settings sheet is open
    in property <bool> info;              // panel editor: the info card is open
    // 4 x 4 grid between the status bar and the people / page dots
    property <length> gx: 16px;
    property <length> gy: 44px;
    property <length> cw: (self.width - 32px) / 4;
    property <length> ch: 98px;

    if root.editing: Rectangle { background: root.settings >= 0 ? #00000040 : #00000059; }
    if root.editing && root.settings < 0: Rectangle {
        for c in 16: Rectangle {
            x: root.gx + Math.mod(c, 4) * root.cw + 4px; y: root.gy + Math.floor(c / 4) * root.ch + 4px;
            width: root.cw - 8px; height: root.ch - 8px; border-radius: 14px;
            border-width: 1px; border-color: #ffffff2e;
        }
    }
    if root.editing && root.drop-col >= 0: Rectangle {
        x: root.gx + root.drop-col * root.cw + 4px; y: root.gy + root.drop-row * root.ch + 4px;
        width: root.items[root.lifted].w * root.cw - 8px; height: root.items[root.lifted].h * root.ch - 8px;
        border-radius: 16px; background: #ffffff1a; border-width: 2px; border-color: root.accent;
    }

    for it[i] in root.items: cell := Rectangle {
        property <bool> up: root.editing && i == root.lifted;
        // 25.H6: on the plain background the widgets rise into place one after another as the page comes into view
        property <float> rise-k: root.rising ? clamp((root.rise-t - i * 30) / 220, 0, 1) : 1;
        opacity: cell.rise-k;
        visible: root.settings < 0;
        // M11: in edit mode the widgets jiggle by ±1 px, each with its own phase; a dropped widget settles with a 2 px dip
        property <float> jt: root.editing && !self.up ? (animation-tick() / 1ms + i * 337) / 520 : 0;
        property <duration> drop-t0;
        property <bool> settling;
        changed up => { if !self.up && root.editing { self.drop-t0 = animation-tick(); self.settling = true; } }
        Timer { interval: 220ms; running: cell.settling; triggered => { cell.settling = false; } }
        property <length> settle: cell.settling ? 2px * Math.sin(180deg * clamp((animation-tick() - cell.drop-t0) / 200ms, 0, 1)) : 0px;
        x: root.gx + it.col * root.cw + (self.up ? root.lift-dx : 0px) + 1px * Math.sin(360deg * self.jt);
        y: root.gy + it.row * root.ch + (self.up ? root.lift-dy : 0px) + 1px * Math.cos(360deg * self.jt * 0.83) + self.settle + 6px * (1 - (1 - Math.pow(1 - self.rise-k, 2)));
        width: it.w * root.cw; height: it.h * root.ch;
        if cell.up: Rectangle { x: -2px; y: 4px; width: parent.width + 4px; height: parent.height; border-radius: 18px; background: #00000059; }
        // a tap opens the widget's view (the app knows which page that is); it lies under the widget, so a
        // widget's own buttons (the music widget's) take their taps first
        if !root.editing && it.tap: TouchArea { clicked => { Act.act("home.tap", it.kind); } }
        HomeWidget {
            width: parent.width; height: parent.height;
            it: it; data: root.data; clock: root.clock; event: root.event; halo: root.halo; music: root.music; ink: root.ink;
            seconds: root.seconds; music-pos: root.music-pos; live: root.live;
            neon: root.neon && it.neon; glow: root.glow;
            weekday-long: root.weekday-long; day-month: root.day-month; year: root.year; week: root.week;
        }
        if root.editing: EditFrame { width: parent.width; height: parent.height; up: cell.up; selected: i == root.selected; accent: root.accent; }
    }

    // panel edit mode: hint on top, add / done at the bottom
    if root.editing && !root.ha-mode && !root.picker && root.settings < 0 && !root.bg-sheet: InfoButton { x: root.width - 50px; y: 4px; on: root.info; }
    if root.editing && !root.ha-mode && !root.picker && root.settings < 0 && !root.bg-sheet: Rectangle {
        x: 16px; y: root.height - 46px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff26;
        Icon { text: "\u{F0415}"; font-size: 22px; color: #ffffff; }
    }
    // the background's own options (only the synthwave scene has any)
    if root.editing && !root.ha-mode && !root.picker && root.settings < 0 && !root.bg-sheet && root.fast-lane: Rectangle {
        x: 62px; y: root.height - 46px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff26;
        Icon { text: "\u{F03D8}"; font-size: 21px; color: #ffffff; }
    }
    if root.editing && !root.ha-mode && !root.picker && root.settings < 0 && !root.bg-sheet: Rectangle {
        x: root.width - 16px - 96px; y: root.height - 46px; width: 96px; height: 36px; border-radius: 18px; background: #F5F3EE;
        Text { text: "Done"; font-size: 15px; font-weight: 600; color: #101114; horizontal-alignment: center; vertical-alignment: center; }
    }

    if root.editing && root.info && !root.ha-mode && !root.picker && root.settings < 0 && !root.bg-sheet: InfoPop {
        w: 260px;
        x: root.width - 16px - self.width; y: 46px;
        lines: root.fast-lane ? ["Drag to move", "Drag the thick corner to resize", "Tap for settings", "Palette: the background"]
            : ["Drag to move", "Drag the thick corner to resize", "Tap for settings"];
    }

    // ------------------------------------------------------------------ background sheet (panel, Fast Lane)
    // the page stays visible above it and follows every change; scenes wrap into two tight rows, the
    // switches come after a wider gap
    if root.editing && root.bg-sheet: GlowText { x: 0; y: 12px; width: root.width; height: 30px; horizontal-alignment: center; k: root.halo;
        text: "Background"; font-size: 20px; font-weight: 600; color: #ffffff; }
    if root.editing && root.bg-sheet: Rectangle {
        x: root.width - 16px - 88px; y: 10px; width: 88px; height: 34px; border-radius: 17px; background: #F5F3EE;
        Text { text: "Done"; font-size: 15px; font-weight: 600; color: #101114; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.editing && root.bg-sheet: bgs := Rectangle {
        property <length> r0: 26px;
        property <length> r1: self.r0 + 40px + 18px;    // the switch rows under the scene
        property <length> r2: self.r1 + 54px;
        property <length> need: self.r2 + 40px + 24px;
        x: 0; y: root.height - self.need; width: root.width; height: self.need;
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: #1a1a1df7;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: #ffffff40; }
        Segmented { x: 16px; y: bgs.r0; width: parent.width - 32px;
            options: [Words.line("ui.looks.home.0"), Words.line("ui.looks.home.1"), Words.line("ui.looks.home.2"), Words.line("ui.looks.home.3")];
            selected: root.fl-scene; }
        // the switches: a row each (the name, the switch at the right end)
        for sr[k] in [{ t: Words.line("ui.looks.home.4"), on: root.neon }, { t: Words.line("ui.looks.home.5"), on: root.fl-cars }]: Rectangle {
            x: 16px; y: (k == 0 ? bgs.r1 : bgs.r2); width: parent.width - 32px; height: 40px;
            Text { x: 0; y: 0; width: parent.width - 120px; height: parent.height; text: sr.t; font-size: 16px; color: #ffffff; vertical-alignment: center; overflow: elide; }
            Toggle { x: parent.width - self.width; y: 4px; on: sr.on; }
        }
        InfoButton { x: parent.width - 16px - 56px - 44px; y: bgs.r1 + 2px; on: root.info; }
        if root.info: InfoPop {
            w: 250px;
            x: 16px; y: bgs.r2 - 6px - self.height;
            lines: ["Glow Up: neon letters", "Joyride: cars on the floor"];
        }
    }

    // ------------------------------------------------------------------ widget picker (live previews)
    property <HomeItem> pv-analog: { kind: 0, w: 2, h: 2, style: 2, accent: root.accent, weight: 600, opts: 1, neon: true };
    property <HomeItem> pv-digital: { kind: 0, w: 2, h: 1, style: 0, accent: root.accent, weight: 600, opts: 1, neon: true };
    property <HomeItem> pv-flip: { kind: 0, w: 2, h: 1, style: 6, accent: root.accent, weight: 700, opts: 1, neon: true };
    property <HomeItem> pv-weather: { kind: 2, w: 2, h: 1, accent: root.accent, weight: 600, opts: 1, neon: true };
    property <HomeItem> pv-date: { kind: 1, w: 2, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-event: { kind: 3, w: 4, h: 1, accent: root.accent, weight: 600, opts: 3, neon: true };
    property <HomeItem> pv-curve: { kind: 4, w: 4, h: 1, accent: root.accent, weight: 600, opts: 1, neon: true };
    property <HomeItem> pv-hourly: { kind: 5, w: 4, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-daily: { kind: 6, w: 4, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-music1: { kind: 7, w: 1, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-music3: { kind: 7, w: 3, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-music4: { kind: 7, w: 4, h: 1, accent: root.accent, weight: 600, opts: 0, neon: true };
    property <HomeItem> pv-details: { kind: 11, w: 2, h: 1, accent: root.accent, weight: 600, opts: 15, neon: true };
    property <HomeItem> pv-details4: { kind: 11, w: 4, h: 1, accent: root.accent, weight: 600, opts: 15, neon: true };
    // the picker fades in (240 ms) and out (200 ms) instead of popping
    property <float> picker-k: root.picker ? 1 : 0;
    animate picker-k { duration: root.picker ? 240ms : 200ms; easing: ease-out; }
    if root.picker-k > 0.001: Rectangle { opacity: root.picker-k; background: #00000080; }
    if root.picker-k > 0.001: Rectangle { opacity: root.picker-k;
        x: 0; y: 40px; width: root.width; height: root.height - 40px;
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: #202024f7;
        clip: true;
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: #ffffff40; }
        Text { x: 20px; y: 20px; text: "Add widget"; font-size: 20px; font-weight: 600; color: #ffffff; }
        InfoButton { x: parent.width - 96px; y: 18px; on: root.info; }
        Rectangle {
            x: parent.width - 52px; y: 18px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff14;
            Icon { text: "\u{F0156}"; font-size: 20px; color: #ffffffcc; }
        }
        // the weather details page: the weather widgets only
        if root.weather-only: Rectangle {
            y: 64px; height: parent.height - 64px;
            clip: true;
            Rectangle {
                y: -root.picker-scroll;
                height: 690px;
                HomeWidget { x: 16px; y: 0; width: 224px; height: 98px; it: root.pv-weather; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                HomeWidget { x: 240px; y: 0; width: 224px; height: 98px; it: root.pv-details; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 104px; text: "Weather now"; font-size: 15px; font-weight: 600; color: #ffffff; }
                Text { x: 244px; y: 104px; text: "Details"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 138px; width: 448px; height: 98px; it: root.pv-details4; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 242px; text: "Details"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 276px; width: 448px; height: 98px; it: root.pv-curve; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 380px; text: "Forecast curve"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 414px; width: 448px; height: 98px; it: root.pv-hourly; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 518px; text: "Hourly forecast"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 552px; width: 448px; height: 98px; it: root.pv-daily; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 656px; text: "Daily forecast"; font-size: 15px; font-weight: 600; color: #ffffff; }
            }
        }
        if !root.weather-only: Rectangle {
            y: 64px; height: parent.height - 64px;
            clip: true;
            Rectangle {
                y: -root.picker-scroll;
                height: 1240px;
                HomeWidget { x: 16px; y: 0; width: 224px; height: 196px; it: root.pv-analog; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                HomeWidget { x: 240px; y: 0; width: 224px; height: 98px; it: root.pv-digital; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                HomeWidget { x: 240px; y: 98px; width: 224px; height: 98px; it: root.pv-flip; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 202px; text: "Clock"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 236px; width: 224px; height: 98px; it: root.pv-weather; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                HomeWidget { x: 240px; y: 236px; width: 224px; height: 98px; it: root.pv-date; data: root.data; clock: root.clock; event: root.event; halo: 0;
                    weekday-long: root.weekday-long; day-month: root.day-month; year: root.year; week: root.week; }
                Text { x: 20px; y: 340px; text: "Weather now"; font-size: 15px; font-weight: 600; color: #ffffff; }
                Text { x: 244px; y: 340px; text: "Date"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 374px; width: 448px; height: 98px; it: root.pv-event; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 478px; text: "Next event"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 512px; width: 448px; height: 98px; it: root.pv-curve; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 616px; text: "Forecast curve"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 650px; width: 448px; height: 98px; it: root.pv-hourly; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 754px; text: "Hourly forecast"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 788px; width: 448px; height: 98px; it: root.pv-daily; data: root.data; clock: root.clock; event: root.event; halo: 0; }
                Text { x: 20px; y: 892px; text: "Daily forecast"; font-size: 15px; font-weight: 600; color: #ffffff; }
                HomeWidget { x: 16px; y: 926px; width: 112px; height: 98px; it: root.pv-music1; data: root.data; clock: root.clock; event: root.event; halo: 0; music: root.music; }
                HomeWidget { x: 128px; y: 926px; width: 336px; height: 98px; it: root.pv-music3; data: root.data; clock: root.clock; event: root.event; halo: 0; music: root.music; }
                HomeWidget { x: 16px; y: 1024px; width: 448px; height: 98px; it: root.pv-music4; data: root.data; clock: root.clock; event: root.event; halo: 0; music: root.music; }
                Text { x: 20px; y: 1128px; text: "Music"; font-size: 15px; font-weight: 600; color: #ffffff; }
            }
        }
        // more below: a soft fade at the bottom edge
        Rectangle { y: parent.height - 40px; height: 40px; background: @linear-gradient(180deg, #20202400 0%, #202024f7 100%); }
        if root.info: InfoPop { w: 250px; x: parent.width - 16px - self.width; y: 60px; lines: ["Tap one, then choose its place"]; }
    }

    // ------------------------------------------------------------------ widget settings (panel)
    property <HomeItem> cur: root.settings >= 0 ? root.items[root.settings] : root.pv-digital;
    // where a tap leads, per widget kind (decided by the design, not configurable)
    pure function tap-text(kind: int) -> string {
        kind == 0 ? "Opens timers and alarms" : kind == 1 ? "Opens the calendar at today"
            : kind == 2 ? "Opens the weather details" : kind == 3 ? "Opens the event in the calendar"
            : kind == 4 ? "Opens the hourly forecast" : kind == 5 ? "Opens the forecast at that hour"
            : kind == 6 ? "Opens that day's forecast" : kind == 11 ? "Opens the weather details" : "Opens the music player"
    }
    property <int> prev-rows: min(2, root.cur.h);
    property <length> sheet-y: 54px + root.prev-rows * root.ch + 4px;
    if root.settings >= 0: GlowText { x: 0; y: 12px; width: root.width; height: 30px; horizontal-alignment: center; k: root.halo; text: root.cur.kind == 0 ? "Clock" : root.cur.kind == 1 ? "Date" : root.cur.kind == 2 ? "Weather now"
        : root.cur.kind == 3 ? "Next event" : root.cur.kind == 4 ? "Forecast curve" : root.cur.kind == 5 ? "Hourly forecast" : root.cur.kind == 6 ? "Daily forecast"
        : root.cur.kind == 11 ? "Details" : "Music";
        font-size: 20px; font-weight: 600; color: #ffffff; }
    if root.settings >= 0: Rectangle {
        x: root.width - 16px - 88px; y: 10px; width: 88px; height: 34px; border-radius: 17px; background: #F5F3EE;
        Text { text: "Done"; font-size: 15px; font-weight: 600; color: #101114; horizontal-alignment: center; vertical-alignment: center; }
    }
    // live preview: the widget as it will look, updated with every change
    if root.settings >= 0: HomeWidget {
        x: (root.width - root.cur.w * root.cw) / 2; y: 54px; width: root.cur.w * root.cw; height: root.prev-rows * root.ch;
        it: root.cur; data: root.data; clock: root.clock; event: root.event; halo: root.halo; music: root.music;
        neon: root.neon && root.cur.neon; glow: root.glow;
        weekday-long: root.weekday-long; day-month: root.day-month; year: root.year; week: root.week;
    }
    if root.settings >= 0: sheet := Rectangle {
        // as tall as its rows need, never over the preview; scrolls when the rows don't fit
        // (settings 54 px apart: 32 px chips + 22 px)
        property <length> need: root.cur.kind == 7 ? 26px + (Math.mod(root.cur.opts, 2) == 1 ? 108px : 54px) + 32px + 24px : 26px + 216px + 32px + 24px;
        x: 0; y: max(root.sheet-y, root.height - self.need); width: root.width; height: root.height - self.y;
        border-top-left-radius: 24px; border-top-right-radius: 24px;
        background: #1a1a1df7;
        clip: true;
        Flickable {
            viewport-height: max(sheet.need, sheet.height);
            Rectangle {
                height: sheet.need;
                property <length> r0: 26px;
            // music: nothing to set but the tap (the colour comes from the cover)
            property <bool> m-scroll: root.cur.kind == 7 && Math.mod(root.cur.opts, 2) == 1;
            property <float> m-speed: root.cur.style > 0 ? root.cur.style : 3;
            property <length> tap-y: root.cur.kind == 7 ? (self.m-scroll ? 108px : 54px) : 216px;
            // music: long titles cut off or scroll, and how fast
            if root.cur.kind == 7: HorizontalLayout {
                x: 16px; y: parent.r0; height: 32px; alignment: start; spacing: 6px;
                Segmented { width: 240px; options: ["Cut off", "Scroll"]; selected: Math.mod(root.cur.opts, 2) == 1 ? 1 : 0; }
            }
            if root.cur.kind == 7 && Math.mod(root.cur.opts, 2) == 1: msl := Rectangle {
                x: 16px; y: parent.r0 + 54px; width: parent.width - 32px; height: 32px;
                Icon { x: 0; width: 28px; height: parent.height; text: "\u{F0D3B}"; font-size: 22px; color: #ffffffb3; }
                Icon { x: parent.width - 28px; width: 28px; height: parent.height; text: "\u{F0907}"; font-size: 22px; color: #ffffffb3; }
                property <float> sp: root.cur.style > 0 ? root.cur.style : 3;
                Rectangle {
                    x: 44px; y: 14px; width: parent.width - 88px; height: 4px; border-radius: 2px; background: #ffffff33;
                    Rectangle { x: 0; width: parent.width * (msl.sp - 1) / 4; border-radius: 2px; background: root.accent; }
                    for i in 5: Rectangle { x: parent.width * i / 4 - 2px; y: -3px; width: 4px; height: 10px; border-radius: 2px; background: i <= msl.sp - 1 ? root.accent : #ffffff59; }
                    Rectangle { x: parent.width * (msl.sp - 1) / 4 - 9px; y: -7px; width: 18px; height: 18px; border-radius: 9px; background: #ffffff; }
                }
            }
            // Style (clock)
            if root.cur.kind != 7: Rectangle {
                x: 16px; y: parent.r0; width: parent.width - 16px; height: 32px; clip: true;
                HorizontalLayout {
                    alignment: start; spacing: 6px;
                    Dropdown { width: 300px;
                        options: [Words.line("ui.looks.home.6"), Words.line("ui.looks.home.7"), Words.line("ui.looks.home.8"), Words.line("ui.looks.home.9"),
                            Words.line("ui.looks.home.10"), Words.line("ui.looks.home.11"), Words.line("ui.looks.home.12"), Words.line("ui.looks.home.13"),
                            "Nixie", "LCD quartz", "Twin-bell"];
                        selected: root.cur.style; }
                }
                Rectangle { x: parent.width - 56px; width: 56px; background: @linear-gradient(90deg, #1a1a1d00 0%, #1a1a1dff 85%); }
            }
            // Colour: eight swatches here, any colour in Home Assistant
            for c[i] in (root.cur.kind == 7 ? [] : [#FF4A1C, #ff7a33, #ffc23d, #3ecf8e, #2ec4d6, #4c8dff, #a66cff, #f2f2f2]): Rectangle {
                x: 16px + i * 42px; y: parent.r0 + 54px; width: 32px; height: 32px; border-radius: 16px;
                border-width: c == root.cur.accent ? 2px : 0px; border-color: #ffffff;
                Rectangle { x: 5px; y: 5px; width: 22px; height: 22px; border-radius: 11px; background: c; }
            }
            // Weight: each chip in its own weight
            if root.cur.kind != 7: HorizontalLayout {
                x: 16px; y: parent.r0 + 108px; height: 32px; width: parent.width - 32px;
                alignment: start; spacing: 6px;
                Segmented { options: ["Light", "Regular", "Semibold", "Bold"];
                    selected: root.cur.weight <= 300 ? 0 : root.cur.weight <= 400 ? 1 : root.cur.weight <= 600 ? 2 : 3; }
            }
            // Show: what the widget adds next to the time
            if root.cur.kind != 7: HorizontalLayout {
                x: 16px; y: parent.r0 + 162px; height: 32px; width: parent.width - 32px;
                alignment: start; spacing: 6px;
                for cb[k] in ["Seconds", "Date", "Weather", "Event"]: HorizontalLayout { spacing: 8px; alignment: start;
                    VerticalLayout { alignment: center; CheckBox { checked: Math.mod(Math.floor(root.cur.opts / Math.pow(2, k)), 2) == 1; } }
                    Text { text: cb; font-size: 14px; color: #ffffff; vertical-alignment: center; } }
            }
            // Tap: on / off only; where it leads is fixed per widget (named in the info card); none on the weather details page
            if !root.weather-only: Rectangle { x: 16px; y: parent.r0 + parent.tap-y - 4px; width: parent.width - 32px; height: 40px;
                Text { x: 0; y: 0; width: parent.width - 160px; height: parent.height; text: "Opens on tap"; font-size: 16px; color: #ffffff; vertical-alignment: center; }
                Toggle { x: parent.width - self.width; y: 4px; on: root.cur.tap; } }
            if !root.weather-only: InfoButton { x: parent.width - 16px - 56px - 44px; y: parent.r0 + parent.tap-y - 2px; on: root.info; }
            if root.info && !root.weather-only: InfoPop {
                w: 260px;
                x: 16px; y: parent.r0 + parent.tap-y - 6px - self.height;
                lines: [root.tap-text(root.cur.kind)];
            }
            }
        }
        // grab handle (always): drag the sheet down to look behind it (the live preview / page updates);
        // while held it can be pulled back up; flicked down it stays down with only this strip showing
        Rectangle { x: (parent.width - 40px) / 2; y: 8px; width: 40px; height: 4px; border-radius: 2px; background: #ffffff40; }
        // more below: a soft fade at the bottom edge
        if sheet.need > sheet.height: Rectangle { y: parent.height - 36px; height: 36px; background: @linear-gradient(180deg, #1a1a1d00 0%, #1a1a1df7 100%); }
    }

    // ------------------------------------------------------------------ lock (panel editing allowed in HA)
    // long press -> this dialog; hold the lock until the ring is full -> edit mode.
    // The X or a tap anywhere outside the card closes it.
    property <float> lp: max(0, min(1, root.lock-p));
    if root.lock: Rectangle { background: #00000099; }
    if root.lock: Rectangle {
        x: 40px; y: 122px; width: root.width - 80px; height: 130px + lock-texts.preferred-height + 26px; border-radius: 24px;
        background: #1e1e22f7; border-width: 1px; border-color: #ffffff17;
        Rectangle {
            x: parent.width - 50px; y: 14px; width: 36px; height: 36px; border-radius: 18px; background: #ffffff14;
            Icon { text: "\u{F0156}"; font-size: 20px; color: #ffffffcc; }
        }
        Rectangle {
            x: (parent.width - 88px) / 2; y: 26px; width: 88px; height: 88px;
            Rectangle { border-radius: 44px; background: root.lp > 0 ? root.accent.with-alpha(0.14) : #ffffff10; border-width: 3px; border-color: #ffffff1f; }
            // the hold ring fills clockwise from the top
            if root.lp > 0.001: Path {
                property <float> a: min(0.9999, root.lp) * 360;
                x: -2px; y: -2px; width: 92px; height: 92px;
                viewbox-width: 88; viewbox-height: 88;
                stroke: root.accent; stroke-width: 4px;
                commands: "M 44 1.5 A 42.5 42.5 0 " + (self.a > 180 ? "1" : "0") + " 1 "
                    + (44 + 42.5 * Math.sin(self.a * 1deg)) + " " + (44 - 42.5 * Math.cos(self.a * 1deg));
            }
            Icon { text: root.lp >= 1 ? "\u{F0FC6}" : "\u{F033E}"; font-size: 40px; color: root.lp > 0 ? root.accent.mix(#ffffff, 0.8) : #ffffff; }
        }
        lock-texts := VerticalLayout {
            x: 24px; y: 130px; width: parent.width - 48px; height: self.preferred-height;
            spacing: 6px;
            Text { text: root.lock-title; font-size: 22px; font-weight: 600; color: #ffffff; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: root.lock-sub; font-size: 15px; color: #ffffffa8; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}
