// Device settings, in the PanelOS colours. A swipe down from the status bar opens the quick shade (brightness, volume,
// microphone, theme, do not disturb, screen off); the PanelOS mark in it opens the full settings after a hold (so children
// do not wander in). Editors for the pages stay in Home Assistant. Every text here is fixed: one line per place, the same
// every time.
import { Icon, MarkButton, CheckBox, Brand, TouchSlider, PageMenu, Segmented, Dropdown, Toggle, ThemeSwitch, TapArea } from "widgets.slint";
export { Brand }
import { TimerItem } from "timers.slint";
import { InfoNote } from "info.slint";
import { Theme, Act, Clock } from "theme.slint";


// the PanelOS mark: P in Morse as two rows (dot dash / dash dot)
export component Mark inherits Rectangle {
    in property <length> unit: 3px;           // 1 unit = the dot radius / 10 of the 100 x 60 drawing
    width: self.unit * 10; height: self.unit * 6;
    Rectangle { x: 0; y: 0; width: root.unit * 2; height: root.unit * 2; border-radius: root.unit; background: Brand.signal; }
    Rectangle { x: root.unit * 4; y: 0; width: root.unit * 6; height: root.unit * 2; border-radius: root.unit; background: Brand.dark ? Brand.paper : Brand.ink; }
    Rectangle { x: 0; y: root.unit * 4; width: root.unit * 6; height: root.unit * 2; border-radius: root.unit; background: Brand.dark ? Brand.paper : Brand.ink; }
    Rectangle { x: root.unit * 8; y: root.unit * 4; width: root.unit * 2; height: root.unit * 2; border-radius: root.unit; background: Brand.signal; }
}

// the brightness icon: a sun whose rays grow with the level (1 + 4·v px on 24 px) and vanish at 0
component SunIcon inherits Rectangle {
    in property <float> v;
    in property <color> ink: Brand.text;
    width: 26px; height: 26px;
    property <float> len: 1 + 4 * root.v;
    Rectangle { x: parent.width * 7.5 / 24; y: parent.height * 7.5 / 24; width: parent.width * 9 / 24; height: self.width; border-radius: self.width / 2;
        background: root.ink; }
    if root.v > 0.01: Path {
        width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
        stroke: root.ink; stroke-width: 1.8px; stroke-line-cap: round;
        MoveTo { x: 12 + 1 * 7.2; y: 12 + 0 * 7.2; } LineTo { x: 12 + 1 * (7.2 + root.len); y: 12 + 0 * (7.2 + root.len); }
        MoveTo { x: 12 + 0.7071 * 7.2; y: 12 + 0.7071 * 7.2; } LineTo { x: 12 + 0.7071 * (7.2 + root.len); y: 12 + 0.7071 * (7.2 + root.len); }
        MoveTo { x: 12 + 0 * 7.2; y: 12 + 1 * 7.2; } LineTo { x: 12 + 0 * (7.2 + root.len); y: 12 + 1 * (7.2 + root.len); }
        MoveTo { x: 12 + -0.7071 * 7.2; y: 12 + 0.7071 * 7.2; } LineTo { x: 12 + -0.7071 * (7.2 + root.len); y: 12 + 0.7071 * (7.2 + root.len); }
        MoveTo { x: 12 + -1 * 7.2; y: 12 + 0 * 7.2; } LineTo { x: 12 + -1 * (7.2 + root.len); y: 12 + 0 * (7.2 + root.len); }
        MoveTo { x: 12 + -0.7071 * 7.2; y: 12 + -0.7071 * 7.2; } LineTo { x: 12 + -0.7071 * (7.2 + root.len); y: 12 + -0.7071 * (7.2 + root.len); }
        MoveTo { x: 12 + 0 * 7.2; y: 12 + -1 * 7.2; } LineTo { x: 12 + 0 * (7.2 + root.len); y: 12 + -1 * (7.2 + root.len); }
        MoveTo { x: 12 + 0.7071 * 7.2; y: 12 + -0.7071 * 7.2; } LineTo { x: 12 + 0.7071 * (7.2 + root.len); y: 12 + -0.7071 * (7.2 + root.len); }
    }
}

// the volume icon: a speaker whose three waves light at 0, 33 and 66 %; at 0 a Signal slash draws across it (150 ms)
export component VolumeIcon inherits Rectangle {
    in property <float> v;
    in property <color> ink: Brand.text;
    width: 26px; height: 26px;
    property <float> sk: root.v <= 0.005 ? 1 : 0;
    animate sk { duration: 150ms; easing: ease-out; }
    Path { width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24; fill: root.ink;
        MoveTo { x: 3; y: 9; } LineTo { x: 7; y: 9; } LineTo { x: 12; y: 4.5; } LineTo { x: 12; y: 19.5; } LineTo { x: 7; y: 15; } LineTo { x: 3; y: 15; } Close { } }
    for w[i] in [1, 2, 3]: Path {
        width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
        stroke: root.ink.with-alpha(root.v > i * 0.33 + 0.005 ? 1 : 0.22); stroke-width: 1.6px;
        MoveTo { x: 13.5 + w * 2.2; y: 12 - w * 2.6; }
        QuadraticTo { control-x: 15 + w * 3.4; control-y: 12; x: 13.5 + w * 2.2; y: 12 + w * 2.6; }
    }
    if root.sk > 0.01: Path { width: parent.width; height: parent.height; viewbox-width: 24; viewbox-height: 24;
        stroke: Brand.signal; stroke-width: 2.2px;
        MoveTo { x: 3; y: 3; } LineTo { x: 3 + 18 * root.sk; y: 3 + 18 * root.sk; } }
}

// a shade tile (27.4): 104 × 86, raised, radius 16, the icon 26 px over a 12 px label; lit: Signal-soft ground and a
// Signal icon; a press squishes it (0.95) and springs back with a small overshoot (M1), switching on blooms the icon (M27)
component ShadeTile inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    in property <float> label-k: 1;           // the label's opacity (0 on the first step's compact row)
    callback clicked;
    width: 104px; height: 86px;
    property <float> sq: touch.pressed ? 0.95 : 1;
    animate sq { duration: touch.pressed ? 60ms : 180ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    property <float> lit: root.on ? 1 : 0;
    animate lit { duration: 160ms; easing: ease-out; }
    property <float> bloom: root.on ? 1 : 0;
    animate bloom { duration: 200ms; easing: cubic-bezier(0.34, 1.8, 0.64, 1); }
    inner := Rectangle {
        x: root.width * (1 - root.sq) / 2; y: root.height * (1 - root.sq) / 2; width: root.width * root.sq; height: root.height * root.sq;
        border-radius: 16px;
        background: touch.pressed ? (Brand.dark ? #2a2c2f : #DEDAD1) : Brand.raised.mix(Brand.signal, 1 - root.lit * (Brand.dark ? 0.20 : 0.13));
        // the icon's glow when lit
        Rectangle { x: (parent.width - 44px) / 2; y: 10px - (86px - root.height) * 0.13; width: 44px; height: 44px; border-radius: 22px;
            background: Brand.signal.with-alpha(0.18 * root.bloom * (1 - Math.max(0, root.bloom - 1) * 4)); }
        @children
        if root.label-k > 0.01: Text { x: 6px; y: parent.height - 26px; width: parent.width - 12px; height: 16px; text: root.label; font-size: 12px; font-weight: 600;
            color: Brand.text; horizontal-alignment: center; vertical-alignment: center; overflow: elide; opacity: root.label-k; }
    }
    touch := TapArea { tapped => { root.clicked(); } }
}

// holding the mark in the popup writes P in Morse (spec 27.5): unit 100 ms, 1.1 s in all — the first dot lights and
// pops, the first dash grows left to right, then the second, then the last dot; the ring fills with it (an arc Path).
// Done: a white flash, the disc clicks, `done` fires. Released early, everything runs back at double speed.
component HoldMorse inherits Rectangle {
    callback done;
    width: 160px; height: 160px;
    property <bool> holding: touch.pressed;
    property <duration> drain: 550ms;
    property <float> p: root.holding ? 1 : 0;
    animate p { duration: root.holding ? 1100ms : root.drain; easing: linear; }
    changed holding => { if !root.holding { root.drain = 550ms * root.p; } }
    property <bool> fired;
    property <duration> fired-t;
    Timer { interval: 1100ms; running: root.holding && !root.fired; triggered => { root.fired = true; root.fired-t = animation-tick(); } }
    Timer { interval: 220ms; running: root.fired; triggered => { root.fired = false; root.done(); } }
    property <float> ft: root.fired ? (animation-tick() - root.fired-t) / 1ms : 1000;
    property <float> t: root.p * 1100;                 // where the Morse is, in ms
    pure function clamp01(v: float) -> float { return Math.max(0, Math.min(1, v)); }
    pure function pop(t0: float) -> float {             // a 100 ms pop to ×1.17 and back
        return root.t < t0 ? 1 : root.t > t0 + 100 ? 1 : 1 + 0.17 * Math.sin(180deg * (root.t - t0) / 100);
    }
    // the ring: track and progress, r 62, 4 px, clockwise from the top
    Path { width: parent.width; height: parent.height; viewbox-width: 160; viewbox-height: 160; stroke: Brand.line; stroke-width: 4px;
        MoveTo { x: 80; y: 18; } ArcTo { x: 80; y: 142; radius-x: 62; radius-y: 62; sweep: true; } ArcTo { x: 80; y: 18; radius-x: 62; radius-y: 62; sweep: true; } }
    property <angle> a: 360deg * Math.min(0.9999, root.p);
    if root.p > 0.002: Path { width: parent.width; height: parent.height; viewbox-width: 160; viewbox-height: 160; stroke: Brand.signal; stroke-width: 4px;
        stroke-line-cap: round;
        MoveTo { x: 80; y: 18; }
        ArcTo { x: 80 + 62 * Math.sin(root.a); y: 80 - 62 * Math.cos(root.a); radius-x: 62; radius-y: 62; sweep: true; large-arc: root.p > 0.5; } }
    // the disc: clicks ×0.94 → 1.04 → 1 when done
    property <float> click: root.ft < 60 ? 1 - 0.06 * root.ft / 60 : root.ft < 120 ? 0.94 + 0.10 * (root.ft - 60) / 60 : root.ft < 180 ? 1.04 - 0.04 * (root.ft - 120) / 60 : 1;
    disc := Rectangle {
        x: 80px - 48px * root.click; y: 80px - 48px * root.click; width: 96px * root.click; height: self.width; border-radius: self.width / 2;
        background: Brand.raised;
        // the mark in 6 px units (60 × 36), resting at 25 %; its parts light as the Morse runs
        property <color> dash-c: Brand.dark ? Brand.paper : Brand.ink;
        Rectangle { x: (parent.width - 60px) / 2; y: (parent.height - 36px) / 2; width: 60px; height: 36px;
            // dot 1 (top left), dash 1 (top right), dash 2 (bottom left), dot 2 (bottom right): resting shapes
            Rectangle { x: 0; y: 0; width: 12px; height: 12px; border-radius: 6px; background: Brand.signal; opacity: 0.25; }
            Rectangle { x: 24px; y: 0; width: 36px; height: 12px; border-radius: 6px; background: disc.dash-c; opacity: 0.25; }
            Rectangle { x: 0; y: 24px; width: 36px; height: 12px; border-radius: 6px; background: disc.dash-c; opacity: 0.25; }
            Rectangle { x: 48px; y: 24px; width: 12px; height: 12px; border-radius: 6px; background: Brand.signal; opacity: 0.25; }
            // lit parts
            if root.t > 0: Rectangle { property <float> s: root.pop(0); x: 6px - 6px * self.s; y: 6px - 6px * self.s; width: 12px * self.s; height: self.width;
                border-radius: self.width / 2; background: Brand.signal; }
            if root.t > 200: Rectangle { x: 24px; y: 0; width: 12px + 24px * root.clamp01((root.t - 200) / 300); height: 12px; border-radius: 6px; background: disc.dash-c; }
            if root.t > 600: Rectangle { x: 0; y: 24px; width: 12px + 24px * root.clamp01((root.t - 600) / 300); height: 12px; border-radius: 6px; background: disc.dash-c; }
            if root.t > 1000: Rectangle { property <float> s: root.pop(1000); x: 54px - 6px * self.s; y: 30px - 6px * self.s; width: 12px * self.s; height: self.width;
                border-radius: self.width / 2; background: Brand.signal; }
        }
    }
    // the flash: r 50, white @90 %, over 200 ms
    if root.ft < 200: Rectangle { x: 30px; y: 30px; width: 100px; height: 100px; border-radius: 50px; background: #ffffff;
        opacity: 0.9 * (1 - root.ft / 200); }
    touch := TouchArea { }
}

export struct SetRow { icon: string, label: string, value: string, danger: bool }

// The head of a settings page, at the settings list's title row: back to the list, the page's name.
component PageHead inherits Rectangle {
    in property <string> title;
    Icon { x: 16px; y: 56px; width: 36px; height: 36px; text: "\u{F0141}"; font-size: 26px; color: Brand.text;
        TouchArea { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; clicked => { Act.act("set.view", "3"); } } }
    Text { x: 56px; y: 52px; height: 44px; text: root.title; font-size: 21px; font-family: "Space Grotesk"; font-weight: 500; color: Brand.text; vertical-alignment: center; }
}

// A row of a settings page (60 px; a line above all but the first): its name at the left, wrapping when long, the
// control at the right (`control-w` wide, placed by the row's children).
component PageRow inherits Rectangle {
    in property <string> label;
    in property <string> sub;              // a second line under the name (a value)
    in property <bool> first;
    in property <length> control-w;
    height: 60px;
    if !root.first: Rectangle { x: 14px; y: 0; width: parent.width - 28px; height: 1px; background: Brand.line; }
    VerticalLayout {
        x: 14px; y: 0; width: parent.width - 28px - root.control-w - (root.control-w > 0 ? 12px : 0px); height: parent.height;
        alignment: center; spacing: 1px;
        Text { text: root.label; font-size: 15px; font-weight: 500; color: Brand.text; wrap: word-wrap; }
        if root.sub != "": Text { text: root.sub; font-size: 12px; color: Brand.muted; wrap: word-wrap; }
    }
    @children
}

// A card of rows on a settings page.
component PageCard inherits Rectangle {
    border-radius: 16px; background: Brand.surface; border-width: 1px; border-color: Brand.line;
    VerticalLayout { padding-top: 4px; padding-bottom: 4px; @children }
}
export struct SetBar { label: string, value: float, tint: color, text: string }
export struct SetSeg { share: float, tint: color }
export struct SetSection { name: string, size: string, segs: [SetSeg], rows: [SetBar], note: string }

export component SettingsLayer inherits Rectangle {
    in property <int> view;                   // 1 quick shade, 2 hold to open, 3 settings list, 4 storage, 5 restart confirm,
                                              // 6 display, 7 voice, 8 sound, 9 about
    in property <float> shade-pos: 1;         // the quick shade: 0 hidden above … 1 down (follows the finger; a little over 1 = the rubber band)
    in property <string> shade-title;
    in property <float> brightness;
    in property <float> volume;
    in property <bool> mic-on;
    in property <string> mic-state;
    in property <string> theme-state;
    in property <int> theme-mode;             // 0 light, 1 dark, 2 auto
    in property <bool> dnd;
    in property <string> dnd-state;
    in property <string> sleep-state;
    in property <string> lock-title;
    in property <float> hold;                 // 0 … 1 while the mark is held
    in property <string> title;
    in property <[SetRow]> rows;
    in property <string> tagline;
    in property <string> page-title;
    in property <string> page-sub;
    in property <float> used;                 // storage: share used
    in property <string> used-text;
    in property <[SetBar]> bars;
    in property <[SetSection]> sections;
    in property <string> confirm-title;
    in property <string> confirm-line;
    in property <bool> auto-bright;           // the light sensor sets the brightness (the Auto box)
    in property <[TimerItem]> now-timers;     // what runs now: the timers (the timers page's order) …
    in property <[InfoNote]> now-notes;       // … and the notifications, newest first
    in property <bool> moving;                // a drag on the open shade runs (its directions stay on)
    // the settings pages: display (6), voice (7), sound (8), about (9)
    in property <[string]> saver-options;     // screensaver after: Never, 30 s, 1 min …
    in property <int> saver-index;
    in property <int> saver-style;            // 0 a clock, 1 screen off
    in property <[string]> wake-options;      // the voice satellite's wake words (their phrases)
    in property <int> wake1: -1;              // index in wake-options, -1 none
    in property <[string]> wake-options2;     // the second one's: "None" first
    in property <int> wake2: 0;               // index in wake-options2
    in property <[SetRow]> about-rows;        // version, model, addresses
    in property <[SetRow]> about-links;       // the project's pages (label, address)
    in property <int> about-link;             // the one the QR code shows
    in property <image> about-qr;
    callback shade-move(length, bool);        // a vertical drag on the open shade: how far (px, + down), and whether the finger let go
    callback shade-step(int);                 // the chevron: the second step
    in property <bool> page-row;              // the second step shows the page row (the page on screen has settings, PageMenu)
    callback page-open();                     // its tap: the shade closes and the page opens its settings in its look's menu

    // the hold popup: a scrim (#000 @65 %) fades in over 200 ms and the card pops 0.96 → 1 with a fade
    property <float> pop-k: root.view == 2 ? 1 : 0;
    animate pop-k { duration: root.view == 2 ? 200ms : 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    property <float> sc: 0.96 + 0.04 * root.pop-k;
    // ------------------------------------------------------------------ 1 quick shade in two steps (29.5)
    // P = shade-pos: 0 closed … 1 the first step … 2 the second; e drives the morph between them. Everything between the
    // status bar and the handle band scrolls as one; the first step has the brightness (with Auto), the tiles as icons
    // and a chevron, the second the rows of 27.1; under both: what runs now (timers, the newest notifications).
    property <float> e: clamp(root.shade-pos - 1, 0, 1);
    property <float> e2: root.e * root.e;
    // the page row (spec 32.0) sits under the tiles on the second step: what runs now moves 60 px further down
    property <length> row-h: root.page-row ? 60px : 0px;
    property <length> morph: 136px + root.row-h;                         // the finger travel of the morph
    property <length> over: max(0, root.shade-pos - 2) * root.morph;     // pulled on past the second step (the rubber)
    property <int> nt: root.now-timers.length;
    property <int> nn: min(6, root.now-notes.length);
    property <length> now-h: (root.nt > 0 ? 28px + root.nt * 60px : 0px)
        + (root.nn > 0 ? 28px + root.nn * 60px + (root.now-notes.length > 6 ? 40px : 0px) : 0px);
    property <length> now-y: 182px + root.morph * root.e;                    // where "Now" starts (screen y, unscrolled)
    property <length> h1: min(472px, 182px + root.now-h + 20px);
    property <length> h2: min(472px, 318px + root.row-h + root.now-h + 20px);
    property <length> bottom: root.h1 + (root.h2 - root.h1) * root.e + root.over;
    property <length> slide: (Math.min(1, root.shade-pos) - 1) * root.h1;   // sliding in from the top (P < 1)
    pure function lerp(a: length, b: length, k: float) -> length { a + (b - a) * k }
    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function clock(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(t / 60), 60)) + ":" + root.two(Math.mod(Math.floor(t), 60))
            : Math.floor(t / 60) + ":" + root.two(Math.mod(Math.floor(t), 60))
    }
    // arriving at the first step the chevron dips 3 px twice (450 ms each): there is more
    property <bool> at-one: root.shade-pos > 0.97 && root.shade-pos < 1.03;
    property <duration> dip-t0;
    property <bool> dipping;
    changed at-one => { if root.at-one && root.e < 0.01 { root.dip-t0 = animation-tick(); root.dipping = true; } }
    Timer { interval: 900ms; running: root.dipping; triggered => { root.dipping = false; } }
    property <length> dip: root.dipping ? 3px * Math.abs(Math.sin(180deg * (animation-tick() - root.dip-t0) / 450ms)) : 0px;
    if root.view == 1 || root.view == 2: Rectangle {
        // the page under the shade dims to 0.45 with the shown part; a tap there closes it
        background: #000000.with-alpha(0.45 * Math.min(1, root.shade-pos));
        // a vertical drag that starts on the shade scrolls while the content can; at its top a pull down is the next step,
        // at its end a push up the step before (then closing). It covers the whole layer, so it keeps the finger while the
        // shade moves under it; the directions stay on while a drag runs.
        sw := SwipeGestureHandler {
        property <bool> on-shade: self.pressed-position.y < root.slide + root.bottom;
        handle-swipe-down: root.moving || (self.on-shade && fl.content-y >= -0.5px);
        handle-swipe-up: root.moving || (self.on-shade && fl.content-y <= fl.height - fl.content-height + 0.5px);
        moved => { root.shade-move(self.current-position.y - self.pressed-position.y, false); }
        swiped => { root.shade-move(self.current-position.y - self.pressed-position.y, true); }
        cancelled => { root.shade-move(0px, true); }
        TouchArea { clicked => { Act.act("shade.close", ""); } }
        // the surface (its top lies behind the status bar), bottom corners 22 px, the shadow
        Rectangle { x: 0; y: root.slide; width: parent.width; height: root.bottom; background: Brand.surface;
            border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000066;
            TouchArea { } }
        // the handle in its own band
        Rectangle { x: (parent.width - 36px) / 2; y: root.slide + root.bottom - 12px; width: 36px; height: 4px; border-radius: 2px; background: Brand.text.with-alpha(0.3); }
        // the content: clipped from y 46 to the handle band; it slides out from under the status bar, never across it
        Rectangle { x: 0; y: 46px; width: parent.width; height: max(0px, root.slide + root.bottom - 20px - 46px); clip: true;
            Rectangle { y: root.slide; height: max(0px, root.bottom - 20px - 46px);
                fl := Flickable {
                    width: parent.width; height: parent.height;
                    content-width: parent.width;
                    content-height: max(self.height, root.now-y - 46px + root.now-h + 8px);
                    // the second step: the title and the mark button (it appears only here)
                    if root.e > 0.01: Text { x: 22px; y: 6px; height: 44px; text: root.shade-title; font-size: 21px; font-family: "Space Grotesk"; font-weight: 500;
                        color: Brand.text; vertical-alignment: center; opacity: root.e2; }
                    if root.e > 0.01: MarkButton { x: 416px; y: 6px; size: 44px; opacity: root.e2; clicked => { Act.act("set.view", "2"); } }
                    if root.e > 0.01 && root.e <= 0.9: TouchArea { x: 416px; y: 6px; width: 44px; height: 44px; }
                    // brightness with its Auto box (the sun shows a small A while Auto sets the level)
                    Rectangle { x: 0; y: 6px + 56px * root.e; width: parent.width; height: 44px;
                        SunIcon { x: 20px; y: 9px; v: root.brightness; }
                        if root.auto-bright: Text { x: 36px; y: 26px; width: 12px; height: 12px; text: "A"; font-size: 10px; font-weight: 700; color: Brand.signal;
                            horizontal-alignment: center; vertical-alignment: center; }
                        TouchSlider { x: 62px; y: 0; width: 322px; value: root.brightness;
                            changed(v, final) => { Act.act(final ? "set.brightness.done" : "set.brightness", Math.max(0.01, v)); } }
                        CheckBox { x: 394px; y: 11px; checked: root.auto-bright; toggled => { Act.act("set.auto", ""); } }
                        Text { x: 422px; y: 0; width: 44px; height: 44px; text: "Auto"; font-size: 13px; font-weight: 600; color: Brand.muted; vertical-alignment: center; }
                        TapArea { x: 388px; y: 0; width: 80px; height: 44px; tapped => { Act.act("set.auto", ""); } }
                    }
                    // the second step: volume (0 = the speaker off; its mark appears)
                    if root.e > 0.01: Rectangle { x: 0; y: 114px; width: parent.width; height: 44px; opacity: root.e2;
                        VolumeIcon { x: 20px; y: 9px; v: root.volume; }
                        TouchSlider { x: 62px; y: 0; width: 398px; value: root.volume;
                            changed(v, final) => { if final { Act.act("set.volume", v); } } }
                        if root.e <= 0.9: TouchArea { }
                    }
                    // the tiles: a compact icon row on the first step, 104 × 86 with labels on the second
                    property <length> ty: 58px + 116px * root.e;
                    property <length> th: 48px + 38px * root.e;
                    property <length> iy: 9px + 5px * root.e;
                    mic-tile := ShadeTile { x: 20px; y: fl.ty; height: fl.th; label-k: root.e2; on: root.mic-on; label: root.mic-on ? "Microphone" : "Mic off"; clicked => { Act.act("set.mic", ""); }
                        property <float> slash: root.mic-on ? 0 : 1;
                        animate slash { duration: 160ms; easing: ease-out; }
                        Icon { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px; height: 30px; text: "\u{F036C}"; font-size: 26px; color: root.mic-on ? Brand.signal : Brand.text; }
                        if mic-tile.slash > 0.01: Path { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px; height: 30px; viewbox-width: 30; viewbox-height: 30;
                            stroke: Brand.signal; stroke-width: 2.4px; stroke-line-cap: round;
                            MoveTo { x: 5; y: 5; } LineTo { x: 5 + 20 * mic-tile.slash; y: 5 + 20 * mic-tile.slash; } }
                    }
                    theme-tile := ShadeTile { x: 132px; y: fl.ty; height: fl.th; label-k: root.e2; on: false;
                        label: root.theme-mode == 2 ? "Theme: Auto" : root.theme-mode == 1 ? "Theme: Dark" : "Theme: Light";
                        clicked => { Act.act("set.theme", ""); }
                        // the icon rolls up to the next one (180 ms)
                        property <int> cur: root.theme-mode;
                        property <int> prev;
                        property <duration> t0;
                        property <bool> rolling;
                        init => { self.prev = root.theme-mode; }
                        changed cur => { self.rolling = true; self.t0 = animation-tick(); }
                        Timer { interval: 200ms; running: theme-tile.rolling; triggered => { theme-tile.prev = theme-tile.cur; theme-tile.rolling = false; } }
                        property <float> rk: self.rolling ? Math.min(1, (animation-tick() - self.t0) / 180ms) : 1;
                        property <float> ek: 1 - (1 - self.rk) * (1 - self.rk);
                        Rectangle { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px; height: 30px; clip: true;
                            if theme-tile.rolling: Icon { y: -30px * theme-tile.ek; width: 30px; height: 30px;
                                text: theme-tile.prev == 2 ? "\u{F00E1}" : theme-tile.prev == 1 ? "\u{F0594}" : "\u{F05A8}"; font-size: 26px; color: Brand.text; }
                            Icon { y: 30px * (1 - theme-tile.ek); width: 30px; height: 30px;
                                text: root.theme-mode == 2 ? "\u{F00E1}" : root.theme-mode == 1 ? "\u{F0594}" : "\u{F05A8}"; font-size: 26px; color: Brand.text; }
                        }
                    }
                    dnd-tile := ShadeTile { x: 244px; y: fl.ty; height: fl.th; label-k: root.e2; on: root.dnd; label: "Do not disturb"; clicked => { Act.act("set.dnd", ""); }
                        // the moon fills from left to right when it turns on and empties the same way (200 ms)
                        property <float> fill: root.dnd ? 1 : 0;
                        animate fill { duration: 200ms; easing: ease-in-out; }
                        Icon { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px; height: 30px; text: "\u{F0F65}"; font-size: 26px; color: Brand.text.with-alpha(0.35); }
                        Rectangle { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px * dnd-tile.fill; height: 30px; clip: true;
                            Icon { x: 0; y: 0; width: 30px; height: 30px; text: "\u{F0F65}"; font-size: 26px; color: root.dnd ? Brand.signal : Brand.text; } }
                    }
                    ShadeTile { x: 356px; y: fl.ty; height: fl.th; label-k: root.e2; on: false; label: "Screen off"; clicked => { Act.act("set.sleep", ""); }
                        Icon { x: (parent.width - 30px) / 2; y: fl.iy; width: 30px; height: 30px; text: "\u{F0D90}"; font-size: 26px; color: Brand.text; }
                    }
                    // the first step: the chevron (there is more); a tap opens the second step
                    if root.e < 0.99: Rectangle { x: (parent.width - 48px) / 2; y: 110px + root.dip; width: 48px; height: 22px; opacity: 1 - root.e;
                        Icon { width: parent.width; height: parent.height; text: "\u{F0140}"; font-size: 22px; color: Brand.muted; }
                        TouchArea { clicked => { root.shade-step(2); } } }
                    // the second step: the page row (a 28.11 navigation row): the page's settings in its look's menu
                    // ("Music settings" over "Turntable", the look's lead icon); a tap closes the shade, then the page
                    // opens them
                    if root.e > 0.01 && root.page-row: Rectangle {
                        x: 16px; y: 314px - 46px; width: 448px; height: 52px; border-radius: 16px; opacity: root.e2;
                        background: page-ta.pressed ? Brand.pressed : Brand.raised;
                        Rectangle { x: 7px; y: 7px; width: 38px; height: 38px; border-radius: 12px; background: Brand.surface;
                            Icon { text: PageMenu.icon; font-size: 21px; color: Brand.text; } }
                        Text { x: 57px; y: 8px; width: parent.width - 57px - 42px; height: 20px; text: PageMenu.title; font-size: 15px; font-weight: 600;
                            color: Brand.text; vertical-alignment: center; }
                        Text { x: 57px; y: 28px; width: parent.width - 57px - 42px; height: 16px; text: PageMenu.look; font-size: 12px;
                            color: Brand.muted; vertical-alignment: center; }
                        Icon { x: parent.width - 30px; y: 0; width: 22px; height: parent.height; text: "\u{F0142}"; font-size: 22px; color: Brand.muted; }
                        page-ta := TouchArea { enabled: root.e > 0.9; clicked => { root.page-open(); } }
                    }
                    // what runs now
                    Rectangle { x: 0; y: root.now-y - 46px; width: parent.width; height: root.now-h;
                        if root.nt > 0: Text { x: 20px; y: 6px; height: 16px; text: "TIMERS"; font-size: 11px; font-weight: 600; color: Brand.muted; vertical-alignment: center; }
                        for t[i] in root.now-timers: tc := Rectangle {
                            x: 16px; y: 28px + i * 60px; width: 448px; height: 52px; border-radius: 16px; background: Brand.raised;
                            TouchArea { clicked => { Act.act("island.timer", i); } }
                            property <float> fr: t.total > 0 ? t.remaining / t.total : 0;
                            property <angle> a: min(0.9999, max(0, self.fr)) * 360deg;
                            Rectangle { x: 10px; y: 8px; width: 36px; height: 36px; border-radius: 18px; border-width: 3.5px; border-color: Brand.text.with-alpha(0.14); }
                            if tc.fr > 0.001: Path { x: 10px - 1.75px; y: 8px - 1.75px; width: 39.5px; height: 39.5px; viewbox-width: 36; viewbox-height: 36;
                                stroke: t.running ? t.tint : t.tint.with-alpha(0.5); stroke-width: 3.5px;
                                commands: "M 18 1.75 A 16.25 16.25 0 " + (tc.a > 180deg ? "1" : "0") + " 1 " + (18 + 16.25 * Math.sin(tc.a)) + " " + (18 - 16.25 * Math.cos(tc.a)); }
                            Text { x: 56px; y: 8px; width: 150px; height: 20px; text: t.label != "" ? t.label : "Timer"; font-size: 15px; font-weight: 600; color: Brand.text;
                                vertical-alignment: center; overflow: elide; }
                            Text { x: 56px; y: 28px; width: 150px; height: 16px; text: t.running ? "of " + root.clock(t.total) : "Paused"; font-size: 12px; color: Brand.muted;
                                vertical-alignment: center; overflow: elide; }
                            Text { x: 196px; y: 0; width: 80px; height: 52px; text: root.clock(t.remaining); font-size: 22px; font-weight: 600;
                                color: t.running && t.remaining < 60 ? Brand.bad : Brand.text; horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle { x: 286px; y: 8px; width: 64px; height: 36px; border-radius: 18px; background: Brand.surface;
                                Text { width: parent.width; height: parent.height; text: "+1 min"; font-size: 13px; font-weight: 600; color: Brand.text;
                                    horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { clicked => { Act.act("timers.add", i); } } }
                            Rectangle { x: 358px; y: 8px; width: 36px; height: 36px; border-radius: 18px; background: Brand.surface;
                                Icon { width: parent.width; height: parent.height; text: t.running ? "\u{F03E4}" : "\u{F040A}"; font-size: 20px; color: Brand.text; }
                                TapArea { tapped => { Act.act("timers.toggle", i); } } }
                            Rectangle { x: 402px; y: 8px; width: 36px; height: 36px; border-radius: 18px; background: Brand.surface;
                                Icon { width: parent.width; height: parent.height; text: "\u{F04DB}"; font-size: 20px; color: Brand.text; }
                                TouchArea { clicked => { Act.act("timers.cancel", i); } } }
                        }
                        property <length> ny: root.nt > 0 ? 28px + root.nt * 60px : 0px;
                        if root.nn > 0: Text { x: 20px; y: parent.ny + 6px; height: 16px; text: "NOTIFICATIONS"; font-size: 11px; font-weight: 600; color: Brand.muted; vertical-alignment: center; }
                        if root.nn > 0: Text { x: parent.width - 120px; y: parent.ny; width: 100px; height: 28px; text: "Clear all"; font-size: 13px; font-weight: 600; color: Brand.muted;
                            horizontal-alignment: right; vertical-alignment: center;
                            TouchArea { clicked => { Act.act("info.clear", ""); } } }
                        for n[i] in root.now-notes: Rectangle {
                            visible: i < 6;
                            x: 16px + self.sx; y: parent.ny + 28px + i * 60px; width: 448px; height: 52px; border-radius: 16px; background: Brand.raised;
                            opacity: 1 - min(1, Math.abs(self.sx / 1px) / 240);
                            // a sideways swipe past 120 px dismisses it; a tap opens it in its window
                            property <length> sx: nta.pressed && Math.abs((nta.mouse-x - nta.pressed-x) / 1px) > 6 ? nta.mouse-x - nta.pressed-x : 0px;
                            nta := TouchArea {
                                clicked => { Act.act("info.show", i); }
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.up && Math.abs((self.mouse-x - self.pressed-x) / 1px) > 120 { Act.act("info.dismiss", i); }
                                }
                            }
                            Rectangle { x: 10px; y: 10px; width: 32px; height: 32px; border-radius: 16px; background: n.level == 1 ? Brand.bad.with-alpha(0.18) : Brand.signal.with-alpha(0.16);
                                Icon { width: parent.width; height: parent.height; text: n.icon; font-size: 18px; color: n.level == 1 ? Brand.bad : Brand.signal; } }
                            Text { x: 52px; y: 8px; width: 300px; height: 20px; text: n.title; font-size: 14px; font-weight: 600; color: Brand.text; vertical-alignment: center; overflow: elide; }
                            Text { x: 52px; y: 27px; width: 300px; height: 18px; text: n.message; font-size: 13px; color: Brand.muted; vertical-alignment: center; overflow: elide; }
                            Text { x: 352px; y: 8px; width: 84px; height: 20px; text: n.when; font-size: 12px; color: Brand.muted; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                        }
                        if root.now-notes.length > 6: Text { x: 20px; y: parent.ny + 28px + 6 * 60px; height: 40px; text: (root.now-notes.length - 6) + " more";
                            font-size: 13px; font-weight: 600; color: Brand.signal; vertical-alignment: center;
                            TouchArea { clicked => { Act.act("notes.open", ""); } } }
                    }
                }
            }
        }
        }
        // ------------------------------------------------------------------ 2 tap the mark, then hold it in the popup
        if root.pop-k > 0.01: Rectangle { background: #000000.with-alpha(0.65 * root.pop-k);
            TouchArea { clicked => { Act.act("set.view", "1"); } }
            Rectangle { x: 240px - 200px * root.sc; y: 240px - 130px * root.sc; width: 400px * root.sc; height: 260px * root.sc;
                opacity: root.pop-k; border-radius: 26px; background: Brand.surface; border-width: 1px; border-color: Brand.line;
                TouchArea { }
                Text { x: 24px; y: 22px; width: parent.width - 48px; text: root.lock-title; font-size: 23px; font-family: "Space Grotesk"; font-weight: 500; color: Brand.text;
                    horizontal-alignment: center; }
                HoldMorse { x: (parent.width - 160px) / 2; y: 60px * root.sc; done => { Act.act("set.view", "3"); } }
                Text { x: 24px; y: 222px * root.sc; width: parent.width - 48px; text: "Hold the mark"; font-size: 14px; color: Brand.muted; horizontal-alignment: center; }
            }
        }
    }

    // ------------------------------------------------------------------ 3 the settings list, under the status bar
    property <float> list-k: root.view == 3 || root.view == 5 ? 1 : 0;
    animate list-k { duration: 300ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }
    if root.view == 3 || root.view == 5: Rectangle {
        background: Brand.bg;
        TouchArea { }
        property <length> lift: (1 - root.list-k) * 60px;
        // the title row: the mark, "Settings", close
        Mark { x: 24px; y: 52px + 22px - 9px + parent.lift; unit: 3px; }
        Text { x: 60px; y: 52px + parent.lift; height: 44px; text: root.title; font-size: 21px; font-family: "Space Grotesk"; font-weight: 500; color: Brand.text; vertical-alignment: center; }
        Rectangle { x: 420px; y: 52px + parent.lift; width: 44px; height: 44px; border-radius: 22px; background: close-ta.pressed ? Brand.pressed : Brand.raised;
            Icon { text: "\u{F0156}"; font-size: 22px; color: Brand.text; }
            close-ta := TouchArea { clicked => { Act.act("shade.close", ""); } } }
        // the rows on one card: 52 px each, a line between them; the card scrolls when it is taller than the room
        property <length> card-h: Math.min(root.rows.length * 52px + 28px, parent.height - 106px - 40px);
        Rectangle {
            x: 16px; y: 106px + parent.lift; width: 448px; height: parent.card-h; border-radius: 18px; background: Brand.surface; border-width: 1px; border-color: Brand.line;
            clip: true;
            Flickable { x: 0; y: 14px; width: parent.width; height: parent.height - 28px;
                viewport-height: Math.max(self.height, root.rows.length * 52px);
                for r[i] in root.rows: Rectangle {
                    x: 14px; y: i * 52px; width: parent.width - 28px; height: 52px;
                    background: row-touch.pressed ? Brand.raised : transparent;
                    row-touch := TapArea { tapped => { Act.act("set.row", i); } }
                    if i > 0: Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Brand.line; }
                    Rectangle { x: 0; y: 10px; width: 32px; height: 32px; border-radius: 10px; background: Brand.raised;
                        Icon { text: r.icon; font-size: 19px; color: r.danger ? Brand.bad : Brand.muted; } }
                    rl := Text { x: 46px; y: 0; width: self.preferred-width; height: parent.height; text: r.label; font-size: 15px; font-weight: 500; color: r.danger ? Brand.bad : Brand.text;
                        vertical-alignment: center; }
                    // the value takes the rest of the row
                    Text { x: rl.x + rl.width + 12px; y: 0; width: parent.width - self.x - (r.danger ? 4px : 30px); height: parent.height; text: r.value; font-size: 13px; color: Brand.muted;
                        horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                    if !r.danger: Icon { x: parent.width - 24px; y: 0; width: 22px; height: parent.height; text: "\u{F0142}"; font-size: 20px; color: Brand.muted; }
                }
            }
        }
        Text { x: 16px; y: parent.height - 30px; width: parent.width - 32px; text: root.tagline; font-size: 12px; color: Brand.muted; horizontal-alignment: center; }
        // ------------------------------------------------------------------ 5 restart: are you sure
        if root.view == 5: Rectangle { background: #000000a6;
            TouchArea { clicked => { Act.act("set.view", "3"); } }
            Rectangle { x: 32px; y: 140px; width: 416px; height: 200px; border-radius: 26px; background: Brand.surface;
                TouchArea { }
                Text { x: 24px; y: 24px; width: parent.width - 48px; text: root.confirm-title; font-size: 21px; font-family: "Space Grotesk"; font-weight: 500; color: Brand.text; wrap: word-wrap;
                    horizontal-alignment: center; }
                Text { x: 24px; y: 88px; width: parent.width - 48px; text: root.confirm-line; font-size: 14px; color: Brand.muted; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle { x: 24px; y: parent.height - 68px; width: 176px; height: 48px; border-radius: 24px;
                    background: never.pressed ? (Brand.dark ? #2a2c2f : #DEDAD1) : Brand.raised;
                    Text { text: "Never mind"; font-size: 15px; font-weight: 700; color: Brand.text; }
                    never := TouchArea { clicked => { Act.act("set.view", "3"); } } }
                // brand: button text Ink or Paper, never on a Signal ground
                Rectangle { x: parent.width - 200px; y: parent.height - 68px; width: 176px; height: 48px; border-radius: 24px;
                    background: restart.pressed ? Brand.text.with-alpha(0.8) : Brand.text;
                    Text { text: "Restart"; font-size: 15px; font-weight: 700; color: Brand.bg; }
                    restart := TouchArea { clicked => { Act.act("set.restart", ""); } } }
            } }
    }

    // ------------------------------------------------------------------ 4 a page: storage, one section per partition
    if root.view == 4: Rectangle {
        background: Brand.bg;
        TouchArea { }
        // under the status bar, at the settings list's title row
        Icon { x: 16px; y: 56px; width: 36px; height: 36px; text: "\u{F0141}"; font-size: 26px; color: Brand.text;
            TouchArea { x: -8px; y: -8px; width: parent.width + 16px; height: parent.height + 16px; clicked => { Act.act("set.view", "3"); } } }
        Text { x: 56px; y: 52px; height: 44px; text: root.page-title; font-size: 21px; font-family: "Space Grotesk"; font-weight: 500; color: Brand.text; vertical-alignment: center; }
        Text { x: 20px; y: 98px; width: parent.width - 40px; text: root.page-sub; font-size: 13px; color: Brand.muted; }
        // more sections than fit: the list scrolls
        Flickable { x: 16px; y: 124px; width: parent.width - 32px; height: parent.height - 132px;
            viewport-height: max(self.height, col.preferred-height);
        col := VerticalLayout { width: parent.width; spacing: 10px; alignment: start;
            for sec in root.sections: Rectangle {
                height: 50px + sec.rows.length * 24px + (sec.note != "" ? 20px : 0px); border-radius: 16px; background: Brand.surface;
                Text { x: 14px; y: 10px; text: sec.name; font-size: 15px; font-weight: 700; color: Brand.text; }
                Text { x: parent.width - 214px; y: 10px; width: 200px; text: sec.size; font-size: 13px; color: Brand.muted; horizontal-alignment: right; }
                // the bar: one coloured part per content, the rest is free
                Rectangle { x: 14px; y: 34px; width: parent.width - 28px; height: 8px; border-radius: 4px; background: Brand.raised; clip: true;
                    for g[k] in sec.segs: Rectangle {
                        property <float> before: k == 0 ? 0 : k == 1 ? sec.segs[0].share : k == 2 ? sec.segs[0].share + sec.segs[1].share : sec.segs[0].share + sec.segs[1].share + sec.segs[2].share;
                        x: parent.width * self.before; y: 0; width: max(3px, parent.width * g.share); height: parent.height; background: g.tint; } }
                for r[k] in sec.rows: Rectangle { x: 14px; y: 48px + k * 24px; width: parent.width - 28px; height: 24px;
                    Rectangle { x: 0; y: 8px; width: 8px; height: 8px; border-radius: 4px; background: r.tint; }
                    Text { x: 16px; y: 0; width: parent.width - 120px; height: parent.height; text: r.label; font-size: 13px; color: Brand.text; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 100px; y: 0; width: 100px; height: parent.height; text: r.text; font-size: 13px; color: Brand.muted; horizontal-alignment: right; vertical-alignment: center; } }
                if sec.note != "": Text { x: 14px; y: 48px + sec.rows.length * 24px; width: parent.width - 28px; text: sec.note; font-size: 12px; color: Brand.muted; overflow: elide; }
            }
        }
        }
    }


    // ------------------------------------------------------------------ 6 display: theme, brightness, time format, screensaver
    if root.view == 6: Rectangle {
        background: Brand.bg;
        TouchArea { }
        PageHead { title: "Display"; }
        Flickable { x: 16px; y: 108px; width: parent.width - 32px; height: parent.height - 112px;
            viewport-height: max(self.height, dcol.preferred-height + 8px);
            dcol := VerticalLayout { width: parent.width; spacing: 12px; alignment: start;
                PageCard {
                    PageRow { label: "Theme"; first: true; control-w: 300px;
                        ThemeSwitch { x: parent.width - 14px - 300px; y: 10px; width: 300px; selected: root.theme-mode; changed(m) => { Act.act("set.theme.mode", m); } } }
                    // the quick shade's brightness with its Auto box (moving the slider unticks it)
                    PageRow { label: "Brightness"; control-w: 300px;
                        TouchSlider { x: parent.width - 14px - 300px; y: 8px; width: 216px; value: root.brightness;
                            changed(v, final) => { Act.act(final ? "set.brightness.done" : "set.brightness", Math.max(0.01, v)); } }
                        CheckBox { x: parent.width - 14px - 70px; y: 19px; checked: root.auto-bright; toggled => { Act.act("set.auto", ""); } }
                        Text { x: parent.width - 14px - 42px; y: 0; width: 42px; height: parent.height; text: "Auto"; font-size: 13px; font-weight: 600; color: Brand.muted; vertical-alignment: center; }
                        TapArea { x: parent.width - 14px - 76px; y: 8px; width: 80px; height: 44px; tapped => { Act.act("set.auto", ""); } } }
                    PageRow { label: "Time format"; control-w: 220px;
                        Segmented { x: parent.width - 14px - 220px; y: 10px; width: 220px; options: ["24-hour", "12-hour"]; selected: Clock.h24 ? 0 : 1;
                            picked(i) => { Act.act("set.timefmt", i); } } }
                }
                PageCard {
                    PageRow { label: "Screensaver after"; first: true; control-w: 180px;
                        Dropdown { x: parent.width - 14px - 180px; y: 6px; width: 180px; options: root.saver-options; selected: root.saver-index;
                            picked(i) => { Act.act("set.saver", i); } } }
                    PageRow { label: "Screensaver"; control-w: 220px;
                        Segmented { x: parent.width - 14px - 220px; y: 10px; width: 220px; options: ["Clock", "Screen off"]; selected: root.saver-style;
                            picked(i) => { Act.act("set.saver.style", i); } } }
                }
            }
        }
    }

    // ------------------------------------------------------------------ 7 voice: the microphone, the two wake words
    if root.view == 7: Rectangle {
        background: Brand.bg;
        TouchArea { }
        PageHead { title: "Voice"; }
        Flickable { x: 16px; y: 108px; width: parent.width - 32px; height: parent.height - 112px;
            viewport-height: max(self.height, vcol.preferred-height + 8px);
            vcol := VerticalLayout { width: parent.width; spacing: 12px; alignment: start;
                PageCard {
                    PageRow { label: "Microphone"; first: true; control-w: 56px;
                        Toggle { x: parent.width - 14px - 56px; y: 14px; on: root.mic-on; toggled => { Act.act("set.mic", ""); } } }
                    PageRow { label: "Wake word"; control-w: 220px;
                        Dropdown { x: parent.width - 14px - 220px; y: 6px; width: 220px; options: root.wake-options; selected: root.wake1;
                            picked(i) => { Act.act("set.wake1", i); } } }
                    PageRow { label: "Second wake word"; control-w: 220px;
                        Dropdown { x: parent.width - 14px - 220px; y: 6px; width: 220px; options: root.wake-options2; selected: root.wake2;
                            picked(i) => { Act.act("set.wake2", i); } } }
                }
            }
        }
    }

    // ------------------------------------------------------------------ 8 sound: the volume (a chime at the new level)
    if root.view == 8: Rectangle {
        background: Brand.bg;
        TouchArea { }
        PageHead { title: "Sound"; }
        PageCard { x: 16px; y: 108px; width: parent.width - 32px; height: 68px;
            PageRow { label: "Volume"; first: true; control-w: 320px;
                VolumeIcon { x: parent.width - 14px - 320px; y: 17px; v: root.volume; }
                TouchSlider { x: parent.width - 14px - 284px; y: 8px; width: 230px; value: root.volume;
                    changed(v, final) => { if final { Act.act("set.volume", v); } } }
                Text { x: parent.width - 14px - 46px; y: 0; width: 46px; height: parent.height; text: Math.round(root.volume * 100) + " %"; font-size: 13px;
                    color: Brand.muted; horizontal-alignment: right; vertical-alignment: center; } }
        }
    }

    // ------------------------------------------------------------------ 9 about: version, model, addresses, the project's pages
    if root.view == 9: Rectangle {
        background: Brand.bg;
        TouchArea { }
        PageHead { title: "About"; }
        Flickable { x: 16px; y: 108px; width: parent.width - 32px; height: parent.height - 112px;
            viewport-height: max(self.height, acol.preferred-height + 8px);
            acol := VerticalLayout { width: parent.width; spacing: 12px; alignment: start;
                PageCard {
                    for r[i] in root.about-rows: PageRow { label: r.label; first: i == 0; height: 52px; control-w: 220px;
                        Text { x: parent.width - 14px - 220px; y: 0; width: 220px; height: parent.height; text: r.value; font-size: 13px; color: Brand.muted;
                            horizontal-alignment: right; vertical-alignment: center; wrap: word-wrap; } }
                }
                // the links as a QR code to scan with a phone (a tap on a link shows its code)
                PageCard {
                    Rectangle { height: max(140px, root.about-links.length * 64px + 8px);
                        Rectangle { x: 14px; y: (parent.height - 116px) / 2; width: 116px; height: 116px; border-radius: 10px; background: #ffffff;
                            Image { x: 6px; y: 6px; width: 104px; height: 104px; source: root.about-qr; image-rendering: pixelated; } }
                        for l[i] in root.about-links: Rectangle {
                            x: 144px; y: 4px + i * 64px; width: parent.width - 144px - 8px; height: 64px; border-radius: 12px;
                            background: lta.pressed ? Brand.raised : transparent;
                            lta := TapArea { tapped => { Act.act("set.link", i); } }
                            if i == root.about-link: Rectangle { x: 0; y: 23px; width: 4px; height: 18px; border-radius: 2px; background: Brand.signal; }
                            VerticalLayout { x: 14px; width: parent.width - 20px; alignment: center; spacing: 2px;
                                Text { text: l.label; font-size: 15px; font-weight: i == root.about-link ? 600 : 500; color: Brand.text; wrap: word-wrap; }
                                Text { text: l.value; font-size: 12px; color: Brand.muted; wrap: word-wrap; } }
                        }
                    }
                }
            }
        }
    }
}
