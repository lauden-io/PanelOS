// Full-screen layers: entity details ("more info"), settings, screensaver,
// pairing (QR login).

import { Theme, Clock, Words } from "theme.slint";
import { Icon, LogoMark, ThemeSwitch, RoundButton, TextButton, Chip, ChipRow, Toggle, BigSlider, MorseMark, TapArea } from "widgets.slint";
import { MorseWrite } from "loading.slint";

export struct MoreInfoData {
    entity: string,
    name: string,
    icon: string,
    state: string,
    accent: color,
    on: bool,
    domain: string,        // light, cover, climate, media_player, ...
    can-toggle: bool,
    has-brightness: bool,
    brightness: float,     // 0..1
    has-ct: bool,
    ct: float,             // 0..1 between ct-min and ct-max
    ct-min: int,           // kelvin
    ct-max: int,
    has-color: bool,
    hue: float,            // 0..1
    has-position: bool,
    position: float,       // 0..1
    target: string,
    current: string,
    hvac-labels: [string],
    hvac-index: int,
    fan-labels: [string],
    fan-index: int,
    preset-labels: [string],
    preset-index: int,
    swing-labels: [string],
    swing-index: int,
    title: string,
    artist: string,
    playing: bool,
    volume: float,         // 0..1
    source-labels: [string],
    source-index: int,
}

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        font-size: 14px;
        color: Theme.muted;
    }
    @children
}

export component MoreInfo inherits Rectangle {
    in property <MoreInfoData> data;
    callback close();
    callback slider(string, float);
    callback select(string, int);
    callback act(string);
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        y: 24px;
        height: parent.height - 24px;
        border-radius: 22px;
        background: Theme.sheet;
        TouchArea { }   // keeps taps on the sheet from closing it
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: root.data.on ? root.data.accent.with-alpha(0.22) : Theme.badge-off;
                    Icon {
                        text: root.data.icon;
                        font-size: 28px;
                        color: root.data.on ? root.data.accent : Theme.muted;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.data.name; font-size: 20px; font-weight: 700; color: Theme.text; overflow: elide; }
                    Text { text: root.data.state; font-size: 15px; color: Theme.muted; overflow: elide; }
                }
                if root.data.can-toggle: VerticalLayout {
                    alignment: center;
                    Toggle { on: root.data.on; toggled => { root.act("toggle"); } }
                }
                VerticalLayout {
                    alignment: center;
                    RoundButton { icon: "\u{F0156}"; size: 40px; clicked => { root.close(); } }
                }
            }
            Flickable {
                content-height: body.preferred-height;
                body := VerticalLayout {
                    spacing: 16px;
                    padding-bottom: 12px;
                    // Lights
                    if root.data.has-brightness: BigSlider {
                        title: "Brightness";
                        value: root.data.brightness;
                        fill: root.data.accent;
                        changed(v) => { root.slider("brightness", v); }
                    }
                    if root.data.has-ct: BigSlider {
                        title: "White";
                        value: root.data.ct;
                        unit: 1;
                        min-value: root.data.ct-min;
                        max-value: root.data.ct-max;
                        show-fill: false;
                        track: @linear-gradient(90deg, #ffb347 0%, #fff3e0 50%, #cfe3ff 100%);
                        changed(v) => { root.slider("ct", v); }
                    }
                    if root.data.has-color: BigSlider {
                        title: "Colour";
                        value: root.data.hue;
                        unit: 2;
                        show-fill: false;
                        track: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
                        changed(v) => { root.slider("hue", v); }
                    }
                    // Shutters
                    if root.data.has-position: BigSlider {
                        title: "Open";
                        value: root.data.position;
                        changed(v) => { root.slider("position", v); }
                    }
                    if root.data.domain == "cover": HorizontalLayout {
                        alignment: center;
                        spacing: 16px;
                        RoundButton { icon: "\u{F005D}"; size: 56px; clicked => { root.act("open"); } }
                        RoundButton { icon: "\u{F04DB}"; size: 56px; clicked => { root.act("stop"); } }
                        RoundButton { icon: "\u{F0045}"; size: 56px; clicked => { root.act("close"); } }
                    }
                    // Climate
                    if root.data.domain == "climate": HorizontalLayout {
                        alignment: center;
                        spacing: 16px;
                        VerticalLayout { alignment: center; RoundButton { icon: "\u{F0374}"; size: 56px; clicked => { root.act("temp_down"); } } }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.data.target;
                                font-size: 48px;
                                font-weight: 700;
                                color: root.data.on ? root.data.accent : Theme.muted;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Now " + root.data.current;
                                font-size: 15px;
                                color: Theme.muted;
                                horizontal-alignment: center;
                            }
                        }
                        VerticalLayout { alignment: center; RoundButton { icon: "\u{F0415}"; size: 56px; clicked => { root.act("temp_up"); } } }
                    }
                    if root.data.hvac-labels.length > 0: Section {
                        title: "Mode";
                        ChipRow { items: root.data.hvac-labels; selected: root.data.hvac-index; picked(i) => { root.select("hvac", i); } }
                    }
                    if root.data.fan-labels.length > 0: Section {
                        title: "Fan";
                        ChipRow { items: root.data.fan-labels; selected: root.data.fan-index; picked(i) => { root.select("fan", i); } }
                    }
                    if root.data.preset-labels.length > 0: Section {
                        title: "Preset";
                        ChipRow { items: root.data.preset-labels; selected: root.data.preset-index; picked(i) => { root.select("preset", i); } }
                    }
                    if root.data.swing-labels.length > 0: Section {
                        title: "Swing";
                        ChipRow { items: root.data.swing-labels; selected: root.data.swing-index; picked(i) => { root.select("swing", i); } }
                    }
                    // Media
                    if root.data.domain == "media_player": VerticalLayout {
                        spacing: 4px;
                        Text { text: root.data.title; font-size: 18px; color: Theme.text; overflow: elide; horizontal-alignment: center; }
                        Text { text: root.data.artist; font-size: 15px; color: Theme.muted; overflow: elide; horizontal-alignment: center; }
                    }
                    if root.data.domain == "media_player": HorizontalLayout {
                        alignment: center;
                        spacing: 16px;
                        RoundButton { icon: "\u{F04AE}"; size: 56px; clicked => { root.act("prev"); } }
                        RoundButton {
                            icon: root.data.playing ? "\u{F03E4}" : "\u{F040A}";
                            size: 64px;
                            tint: root.data.accent;
                            clicked => { root.act("play_pause"); }
                        }
                        RoundButton { icon: "\u{F04AD}"; size: 56px; clicked => { root.act("next"); } }
                    }
                    if root.data.domain == "media_player": BigSlider {
                        title: "Volume";
                        value: root.data.volume;
                        fill: root.data.accent;
                        changed(v) => { root.slider("volume", v); }
                    }
                    if root.data.source-labels.length > 0: Section {
                        title: "Source";
                        ChipRow { items: root.data.source-labels; selected: root.data.source-index; picked(i) => { root.select("source", i); } }
                    }
                }
            }
        }
    }
}

export struct SettingsData {
    theme-index: int,          // 0 dark, 1 light, 2 auto
    brightness: float,         // 0..1 (manual)
    auto-brightness: bool,
    screensaver-index: int,    // index into the app's timeout list
    style-index: int,          // 0 clock, 1 black
    proximity: bool,
    dashboards: [string],
    dashboard-index: int,
    display-mode: int,         // 0 dashboard, 1 assistant
    volume: float,             // 0..1
    about: string,
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    spacing: 12px;
    Text {
        text: root.title;
        font-size: 17px;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}

export component SettingsPage inherits Rectangle {
    in property <SettingsData> data;
    in property <[string]> screensaver-labels;
    callback close();
    callback changed(string, string);
    background: Theme.background;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Settings";
                font-size: 24px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            RoundButton { icon: "\u{F0156}"; size: 40px; clicked => { root.close(); } }
        }
        Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                spacing: 14px;
                padding-bottom: 16px;
                Section {
                    title: "Display mode";
                    ChipRow {
                        items: ["Dashboard", "Assistant"];
                        selected: root.data.display-mode;
                        picked(i) => { root.changed("display_mode", i == 0 ? "dashboard" : "assistant"); }
                    }
                }
                Section {
                    title: "Theme";
                    ChipRow {
                        items: ["Dark", "Light", "Auto"];
                        selected: root.data.theme-index;
                        picked(i) => { root.changed("theme", i == 0 ? "dark" : i == 1 ? "light" : "auto"); }
                    }
                }
                Section {
                    title: "Brightness";
                    SettingRow {
                        title: "Automatic (light sensor)";
                        Toggle {
                            on: root.data.auto-brightness;
                            toggled => { root.changed("auto_brightness", root.data.auto-brightness ? "false" : "true"); }
                        }
                    }
                    if !root.data.auto-brightness: BigSlider {
                        title: "Brightness";
                        value: root.data.brightness;
                        changed(v) => { root.changed("brightness", "" + round(v * 100)); }
                    }
                }
                Section {
                    title: "Sound";
                    BigSlider {
                        title: "Volume";
                        value: root.data.volume;
                        changed(v) => { root.changed("volume", "" + round(v * 100)); }
                    }
                }
                Section {
                    title: "Screensaver after";
                    ChipRow {
                        items: root.screensaver-labels;
                        selected: root.data.screensaver-index;
                        picked(i) => { root.changed("screensaver_index", "" + i); }
                    }
                    ChipRow {
                        items: ["Clock", "Screen off"];
                        selected: root.data.style-index;
                        picked(i) => { root.changed("screensaver_style", i == 0 ? "clock" : "black"); }
                    }
                    SettingRow {
                        title: "Wake when someone approaches";
                        Toggle {
                            on: root.data.proximity;
                            toggled => { root.changed("proximity_wake", root.data.proximity ? "false" : "true"); }
                        }
                    }
                }
                Section {
                    title: "Dashboard";
                    ChipRow {
                        items: root.data.dashboards;
                        selected: root.data.dashboard-index;
                        picked(i) => { root.changed("dashboard_index", "" + i); }
                    }
                }
                Section {
                    title: "About";
                    Text {
                        text: root.data.about;
                        font-size: 14px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    TextButton { text: "Restart app"; clicked => { root.changed("restart_app", ""); } }
                    TextButton { text: "Reboot panel"; clicked => { root.changed("reboot", ""); } }
                }
                TextButton { text: "Log out of Home Assistant"; danger: true; clicked => { root.changed("logout", ""); } }
            }
        }
    }
}

export component Screensaver inherits Rectangle {
    in property <string> time;
    in property <string> date;
    in property <string> info;
    in property <string> info-icon;
    in property <bool> black;
    callback wake();
    background: #000000;
    if !root.black: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: root.time;
            font-size: 120px;
            font-weight: 700;
            color: #e5e7eb;
            horizontal-alignment: center;
        }
        Text {
            text: root.date;
            font-size: 22px;
            color: #9ca3af;
            horizontal-alignment: center;
        }
        if root.info != "": HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Icon { text: root.info-icon; font-size: 30px; color: #9ca3af; }
            Text { text: root.info; font-size: 22px; color: #9ca3af; vertical-alignment: center; }
        }
    }
    // Wake on release: the whole tap stays on the screensaver, so nothing
    // underneath receives half of it.
    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) {
                root.wake();
            }
        }
    }
}

// Voice conversation feedback at the bottom of the screen.
// state: 1 listening, 2 thinking, 3 answer, 4 error.
export component AssistPanel inherits Rectangle {
    in property <int> state;
    in property <string> heard;
    in property <string> answer;
    callback dismiss();
    height: 168px;
    border-radius: 22px;
    background: Theme.sheet;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    TouchArea { clicked => { root.dismiss(); } }
    HorizontalLayout {
        padding: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 64px;
                border-radius: 32px;
                background: root.state == 1 ? #3b82f6 : root.state == 2 ? #f59e0b : root.state == 4 ? #ef4444 : #22c55e;
                animate background { duration: 200ms; }
                Icon {
                    text: root.state == 1 ? "\u{F036C}" : root.state == 2 ? "\u{F12CA}" : root.state == 4 ? "\u{F05D6}" : "\u{F05CB}";
                    font-size: 36px;
                    color: #ffffff;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: root.state == 1 ? (root.heard == "" ? "Listening…" : root.heard)
                    : root.state == 2 ? (root.heard == "" ? "…" : root.heard)
                    : root.heard;
                font-size: 17px;
                color: Theme.muted;
                wrap: word-wrap;
                overflow: elide;
            }
            if root.state >= 3: Text {
                text: root.answer;
                font-size: 18px;
                color: Theme.text;
                wrap: word-wrap;
                overflow: elide;
            }
        }
    }
}

export component TimerAlarm inherits Rectangle {
    in property <string> name;
    callback stop();
    background: #000000e8;
    TouchArea { }
    VerticalLayout {
        alignment: center;
        spacing: 16px;
        Icon { text: "\u{F009E}"; font-size: 96px; color: #f59e0b; }
        Text {
            text: root.name == "" ? "Timer" : root.name;
            font-size: 30px;
            font-weight: 700;
            color: #ffffff;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            TextButton { width: 200px; text: "Stop"; clicked => { root.stop(); } }
        }
    }
}

export component PairingScreen inherits Rectangle {
    in property <image> qr;
    in property <string> hint;           // earlier plain hint (kept for the app)
    in property <string> ha-url;         // the Home Assistant the code logs in to
    in property <int> state: 0;          // 0 waiting, 1 logged in, 2 failed
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    in property <int> wifi-bars: 4;
    callback change-ha();
    callback wifi-info();
    callback theme-changed(int);
    property <[string]> titles: Words.list("ui.pairingscreen.titles");
    property <[string]> subtitles: Words.list("ui.pairingscreen.subtitles");
    property <[string]> hints: Words.list("ui.pairingscreen.hints");
    property <[string]> done-texts: Words.list("ui.pairingscreen.done-texts");
    property <[string]> failed-texts: Words.list("ui.pairingscreen.failed-texts");
    property <[string]> change-texts: Words.list("ui.pairingscreen.change-texts");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.switch-top - 8px;
        padding: Theme.pad;
        padding-bottom: 0px;
        spacing: 6px;
        alignment: start;

        // Logo, title, what to do; the Wi-Fi signal as on the setup screen.
        HorizontalLayout {
            spacing: 12px;
            padding-bottom: 4px;
            VerticalLayout {
                alignment: center;
                LogoMark { size: 40px; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 0px;
                Text {
                    text: root.pick-text(root.titles, 1);
                    font-size: Theme.font-title; font-family: Theme.heading-family;
                    font-weight: Theme.weight-strong;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.pick-text(root.subtitles, 7);
                    font-size: Theme.font-label;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                RoundButton {
                    icon: ["\u{F091F}", "\u{F0922}", "\u{F0925}", "\u{F0928}"][max(0, min(3, root.wifi-bars - 1))];
                    size: 40px;
                    tint: root.wifi-bars <= 1 ? Theme.warning : Theme.muted;
                    clicked => { root.wifi-info(); }
                }
            }
        }

        // The code, always black on white so every phone reads it.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 236px;
                height: 236px;
                border-radius: 16px;
                background: #ffffff;
                border-width: Theme.dark ? 0px : 1px;
                border-color: Theme.outline;
                Image {
                    width: 216px;
                    height: 216px;
                    source: root.qr;
                    image-rendering: pixelated;
                    opacity: root.state == 1 ? 0.15 : 1;
                }
                // M31: paired: a check mark that draws itself (250 ms)
                if root.state == 1: Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    background: Theme.success;
                    property <float> draw: 0;
                    init => { self.draw = 1; }
                    animate draw { duration: 250ms; easing: ease-out; }
                    Rectangle { x: 0; y: 0; width: 72px * parent.draw; height: 72px; clip: true;
                        Path { x: 0; y: 0; width: 72px; height: 72px; viewbox-width: 72; viewbox-height: 72; stroke: #ffffff; stroke-width: 6px;
                            stroke-line-cap: round; stroke-line-join: round;
                            MoveTo { x: 21; y: 37; } LineTo { x: 31; y: 47; } LineTo { x: 51; y: 26; } } }
                }
            }
        }
        Text {
            text: root.ha-url;
            font-size: Theme.font-caption;
            color: Theme.faint;
            horizontal-alignment: center;
            overflow: elide;
        }

        // What to do / what happened.
        HorizontalLayout {
            height: 40px;
            alignment: center;
            spacing: 8px;
            if root.state != 0: VerticalLayout {
                alignment: start;
                Icon {
                    text: root.state == 1 ? "\u{F05E1}" : "\u{F05D6}";
                    font-size: 18px;
                    color: root.state == 1 ? Theme.success : Theme.danger;
                }
            }
            Text {
                text: root.state == 1 ? root.pick-text(root.done-texts, 13)
                    : root.state == 2 ? root.pick-text(root.failed-texts, 13)
                    : root.pick-text(root.hints, 13);
                font-size: Theme.font-label;
                color: root.state == 1 ? Theme.success : root.state == 2 ? Theme.danger : Theme.muted;
                // With an icon the lines start next to it; without one they are centred.
                horizontal-alignment: root.state != 0 ? left : center;
                vertical-alignment: top;
                wrap: word-wrap;
                max-width: 400px;
            }
        }

        // Back to the Home Assistant setup.
        if root.state != 1: HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                width: ch.preferred-width + 16px;
                border-radius: 8px;
                background: cht.pressed ? Theme.surface-pressed : transparent;
                cht := TouchArea { clicked => { root.change-ha(); } }
                ch := Text {
                    x: 8px;
                    text: root.pick-text(root.change-texts, 61);
                    font-size: Theme.font-label;
                    font-weight: Theme.weight-strong;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}

// First start without settings: Home Assistant found on the network (mDNS),
// or its address typed on the keyboard.
export struct FoundHa {
    name: string,
    url: string,
}

// Status / error line under an input: icon and up to two lines of text.
// It always keeps its height, so nothing below it moves.
component MessageLine inherits HorizontalLayout {
    in property <string> message;
    in property <int> kind: 0;       // 0 info, 1 error, 2 success
    in property <bool> busy;
    height: 40px;
    spacing: 8px;
    padding-left: 4px;
    if root.message != "": VerticalLayout {
        alignment: start;
        Icon {
            text: root.busy ? "\u{F051F}" : root.kind == 1 ? "\u{F05D6}" : root.kind == 2 ? "\u{F05E1}" : "\u{F02FD}";
            font-size: 18px;
            color: root.kind == 1 ? Theme.danger : root.kind == 2 ? Theme.success : Theme.muted;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.message;
        font-size: 14px;
        color: root.kind == 1 ? Theme.danger : root.kind == 2 ? Theme.success : Theme.muted;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
    }
}

// On-screen keyboard: letters (lower / upper case) and two symbol pages.
// Every page has the same key grid (10 / 9 / shift + 7 + back / bottom row),
// so a key never moves when the page changes. Keys send their text; special
// keys send "shift", "symbols", "layout", "back", "enter". Holding a letter
// shows its accented forms above it (popup-options).
component Key inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary: false;
    in property <color> accent: Theme.accent;   // the primary key's colour (the screen's action colour)
    in property <bool> active: false;
    in property <bool> caption: false;   // small, muted label (space bar: language)
    in property <string> value: self.label;
    in property <bool> has-variants;     // a long press shows its accented forms
    callback pressed-key(string);
    callback held(string, length, length);   // long press: the key's value, its centre x and top y (window)
    callback slide(length);                  // the finger's x (window) while held
    callback let-go();
    property <bool> long;
    property <bool> swallow;             // the release after a long press types nothing more
    height: Theme.key-height;
    preferred-width: 10px;
    border-radius: 10px;
    background: root.primary ? (t.pressed ? Theme.text.with-alpha(0.8) : Theme.text)
        : root.active ? Theme.surface-pressed
        : (t.pressed ? Theme.surface-pressed : Theme.surface-raised);
    Timer {
        interval: 400ms;
        running: root.has-variants && t.pressed && !root.long;
        triggered => {
            root.long = true;
            root.held(root.value, root.absolute-position.x + root.width / 2, root.absolute-position.y);
        }
    }
    t := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.swallow = false;
                root.long = false;
            }
            if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.long {
                root.long = false;
                root.swallow = true;
                root.let-go();
            }
        }
        moved => { if root.long { root.slide(root.absolute-position.x + self.mouse-x); } }
        clicked => {
            if root.swallow { root.swallow = false; } else { root.pressed-key(root.value); }
        }
    }
    if root.label != "": Text {
        text: root.label;
        font-size: root.caption ? Theme.font-caption : root.primary ? Theme.font-label : 20px;
        font-weight: root.primary ? Theme.weight-strong : Theme.weight-regular;
        color: root.primary ? Theme.background : root.caption ? Theme.muted : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon != "": Icon {
        text: root.icon;
        font-size: 22px;
        color: root.primary ? Theme.background : Theme.text;
    }
}

export component Keyboard inherits Rectangle {
    in property <int> layer: 0;          // 0 lower case, 1 upper case, 2 symbols, 3 more symbols
    in property <int> layout: 0;         // letters: 0 Latin, 1 Cyrillic (globe key switches)
    in property <string> enter-label: "Connect";
    in property <color> accent: Theme.accent;    // enter key and accent picker: the screen's action colour
    // Long press on a letter: its accented forms, where to show them, which one the finger is on.
    in property <string> held-key;
    in property <[string]> popup-options;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <int> popup-selected: -1;
    callback key(string);
    height: 4 * Theme.key-height + 3 * Theme.key-gap;
    // the accented forms of a letter (Hungarian first), shown on a long press
    pure function variants(k: string) -> [string] {
        return k == "a" ? ["á", "ä", "à", "â", "å"] : k == "A" ? ["Á", "Ä", "À", "Â", "Å"]
            : k == "e" ? ["é", "ë", "è", "ê"] : k == "E" ? ["É", "Ë", "È", "Ê"]
            : k == "i" ? ["í", "ï", "ì", "î"] : k == "I" ? ["Í", "Ï", "Ì", "Î"]
            : k == "o" ? ["ó", "ö", "ő", "ô", "ò", "ø"] : k == "O" ? ["Ó", "Ö", "Ő", "Ô", "Ò", "Ø"]
            : k == "u" ? ["ú", "ü", "ű", "û", "ù"] : k == "U" ? ["Ú", "Ü", "Ű", "Û", "Ù"]
            : k == "c" ? ["ç", "č", "ć"] : k == "C" ? ["Ç", "Č", "Ć"]
            : k == "s" ? ["š", "ß", "ś"] : k == "S" ? ["Š", "Ś"]
            : k == "z" ? ["ž", "ź", "ż"] : k == "Z" ? ["Ž", "Ź", "Ż"]
            : k == "n" ? ["ñ", "ń"] : k == "N" ? ["Ñ", "Ń"]
            : k == "y" ? ["ý", "ÿ"] : k == "Y" ? ["Ý"]
            : k == "е" ? ["ё"] : k == "Е" ? ["Ё"] : k == "ь" ? ["ъ"] : k == "Ь" ? ["Ъ"]
            : [];
    }
    // the held key, its forms, where they show and which one the finger is on
    property <string> h-key;
    property <[string]> h-opts: root.variants(root.h-key);
    property <length> h-x;
    property <length> h-y;
    property <int> h-sel;
    function hold(v: string, cx: length, top: length) {
        root.h-key = v;
        root.h-x = Math.max(0px, Math.min(root.width - (root.h-opts.length * 42px + 8px), cx - root.absolute-position.x - (root.h-opts.length * 42px + 8px) / 2));
        root.h-y = top - root.absolute-position.y - 58px;
        root.h-sel = 0;
    }
    function slide-to(fx: length) {
        root.h-sel = Math.max(0, Math.min(root.h-opts.length - 1, Math.floor((fx - root.absolute-position.x - root.h-x - 4px) / 42px)));
    }
    function release() {
        if root.h-key != "" && root.h-sel >= 0 && root.h-sel < root.h-opts.length {
            root.key(root.h-opts[root.h-sel]);
        }
        root.h-key = "";
    }
    property <[string]> pop-opts: root.h-key != "" ? root.h-opts : root.popup-options;
    property <[string]> row1: root.layer == 3 ? ["[", "]", "{", "}", "<", ">", "^", "~", "`", "|"]
        : root.layer == 2 ? ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]
        : root.layout == 1 ? (root.layer == 1 ? ["Й", "Ц", "У", "К", "Е", "Н", "Г", "Ш", "Щ", "З", "Х"] : ["й", "ц", "у", "к", "е", "н", "г", "ш", "щ", "з", "х"])
        : root.layer == 1 ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]
        : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
    property <[string]> row2: root.layer == 3 ? ["_", "=", "\\", "?", "€", "£", "¥", "§", "°"]
        : root.layer == 2 ? ["@", "#", "$", "%", "&", "*", "-", "+", "("]
        : root.layout == 1 ? (root.layer == 1 ? ["Ф", "Ы", "В", "А", "П", "Р", "О", "Л", "Д", "Ж", "Э"] : ["ф", "ы", "в", "а", "п", "р", "о", "л", "д", "ж", "э"])
        : root.layer == 1 ? ["A", "S", "D", "F", "G", "H", "J", "K", "L"]
        : ["a", "s", "d", "f", "g", "h", "j", "k", "l"];
    property <[string]> row3: root.layer == 3 ? ["…", "«", "»", "„", "”", "¿", "¡"]
        : root.layer == 2 ? [")", "!", "\"", "'", ":", ";", "/"]
        : root.layout == 1 ? (root.layer == 1 ? ["Я", "Ч", "С", "М", "И", "Т", "Ь", "Б", "Ю"] : ["я", "ч", "с", "м", "и", "т", "ь", "б", "ю"])
        : root.layer == 1 ? ["Z", "X", "C", "V", "B", "N", "M"]
        : ["z", "x", "c", "v", "b", "n", "m"];
    // Half-key indent on the second row, as on Latin keyboards (all pages).
    property <bool> indent: root.layout == 0 || root.layer >= 2;
    VerticalLayout {
        spacing: Theme.key-gap;
        HorizontalLayout {
            spacing: 5px;
            for k in root.row1: Key { horizontal-stretch: 1; label: k; active: k == root.held-key || k == root.h-key; has-variants: root.variants(k).length > 0;
                pressed-key(v) => { root.key(v); } held(v, x, y) => { root.hold(v, x, y); } slide(x) => { root.slide-to(x); } let-go => { root.release(); } }
        }
        HorizontalLayout {
            spacing: 5px;
            if root.indent: Rectangle { horizontal-stretch: 0.5; preferred-width: 1px; }
            for k in root.row2: Key { horizontal-stretch: 1; label: k; active: k == root.held-key || k == root.h-key; has-variants: root.variants(k).length > 0;
                pressed-key(v) => { root.key(v); } held(v, x, y) => { root.hold(v, x, y); } slide(x) => { root.slide-to(x); } let-go => { root.release(); } }
            if root.indent: Rectangle { horizontal-stretch: 0.5; preferred-width: 1px; }
        }
        HorizontalLayout {
            spacing: 5px;
            Key {
                horizontal-stretch: 1.5;
                // Letters: shift; symbols: the other symbol page.
                icon: root.layer == 1 ? "\u{F0632}" : root.layer == 0 ? "\u{F0636}" : "";
                label: root.layer == 2 ? "=\\<" : root.layer == 3 ? "?123" : "";
                active: root.layer == 1;
                value: "shift";
                pressed-key(v) => { root.key(v); }
            }
            for k in root.row3: Key { horizontal-stretch: 1; label: k; active: k == root.held-key || k == root.h-key; has-variants: root.variants(k).length > 0;
                pressed-key(v) => { root.key(v); } held(v, x, y) => { root.hold(v, x, y); } slide(x) => { root.slide-to(x); } let-go => { root.release(); } }
            Key { horizontal-stretch: 1.5; icon: "\u{F0B5C}"; value: "back"; pressed-key(v) => { root.key(v); } }
        }
        HorizontalLayout {
            spacing: 5px;
            Key { horizontal-stretch: 1.5; label: root.layer >= 2 ? "abc" : "?123"; value: "symbols"; pressed-key(v) => { root.key(v); } }
            Key { horizontal-stretch: 1; icon: "\u{F059F}"; value: "layout"; pressed-key(v) => { root.key(v); } }
            Key { horizontal-stretch: 1; label: ","; pressed-key(v) => { root.key(v); } }
            Key { horizontal-stretch: 3; caption: true; label: root.layout == 1 ? "Русский" : "English"; value: " "; pressed-key(v) => { root.key(v); } }
            Key { horizontal-stretch: 1; label: "."; pressed-key(v) => { root.key(v); } }
            Key { horizontal-stretch: 2.5; primary: true; accent: root.accent; label: root.enter-label; value: "enter"; pressed-key(v) => { root.key(v); } }
        }
    }

    // Accented forms of the held letter; sliding the finger picks one.
    if root.pop-opts.length > 0: Rectangle {
        x: root.h-key != "" ? root.h-x : root.popup-x;
        y: root.h-key != "" ? root.h-y : root.popup-y;
        width: root.pop-opts.length * 42px + 8px;
        height: 54px;
        border-radius: 12px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.outline;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000070;
        HorizontalLayout {
            padding: 4px;
            for o[i] in root.pop-opts: Rectangle {
                width: 42px;
                border-radius: 9px;
                background: i == (root.h-key != "" ? root.h-sel : root.popup-selected) ? Theme.text : transparent;
                Text {
                    text: o;
                    font-size: 22px;
                    color: i == (root.h-key != "" ? root.h-sel : root.popup-selected) ? Theme.background : Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component SetupScreen inherits Rectangle {
    in property <[FoundHa]> found;
    in property <string> address;
    in property <int> layer: 0;
    in property <int> layout: 0;
    in property <string> message;
    in property <int> message-kind: 0;   // 0 info, 1 error, 2 success
    in property <bool> busy;
    in property <int> variant: 0;        // random, picked when the screen opens
    in property <int> theme-mode: 2;
    // The Wi-Fi the panel is on: name, signal 1..4 bars, own address.
    in property <string> wifi-name;
    in property <int> wifi-bars: 4;
    in property <string> wifi-ip;
    in-out property <bool> wifi-info-open: false;
    callback pick(string);
    callback key(string);
    callback connect();
    callback change-wifi();
    callback choose-many();
    callback theme-changed(int);
    in property <bool> can-back;         // opened from the settings: a back arrow instead of the logo
    callback back();
    property <[string]> titles: Words.list("ui.setupscreen.titles");
    property <[string]> subtitles: Words.list("ui.setupscreen.subtitles");
    property <[string]> searching: Words.list("ui.setupscreen.searching");
    property <[string]> searching-hints: Words.list("ui.setupscreen.searching-hints");
    // More than one found: count in the middle (text before / after).
    property <[string]> many-before: Words.list("ui.setupscreen.many-before");
    property <[string]> many-after: Words.list("ui.setupscreen.many-after");
    property <[string]> many-hints: Words.list("ui.setupscreen.many-hints");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}

    // Everything above the keyboard.
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.keyboard-top;
        padding: Theme.pad;
        padding-bottom: 0px;
        spacing: 6px;
        alignment: start;

        // Logo, title, what to do; Wi-Fi can still be changed.
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                if !root.can-back: LogoMark { size: 40px; }
                if root.can-back: RoundButton { icon: "\u{F0141}"; size: 40px; tint: Theme.text; clicked => { root.back(); } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 0px;
                Text {
                    text: root.pick-text(root.titles, 1);
                    font-size: Theme.font-title; font-family: Theme.heading-family;
                    font-weight: Theme.weight-strong;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.pick-text(root.subtitles, 7);
                    font-size: Theme.font-label;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                // Signal of the current Wi-Fi; tap: which network, change it.
                RoundButton {
                    icon: ["\u{F091F}", "\u{F0922}", "\u{F0925}", "\u{F0928}"][max(0, min(3, root.wifi-bars - 1))];
                    size: 40px;
                    tint: root.wifi-bars <= 1 ? Theme.warning : Theme.muted;
                    clicked => { root.wifi-info-open = !root.wifi-info-open; }
                }
            }
        }

        // One found, several found, or still looking.
        if root.found.length == 1: Rectangle {
            height: 52px;
            border-radius: Theme.radius-small;
            background: t.pressed ? Theme.surface-pressed : Theme.surface;
            t := TouchArea {
                clicked => { root.pick(root.found[0].url); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 19px;
                        background: #18bcf226;
                        Icon { text: "\u{F07D0}"; font-size: 22px; color: #18bcf2; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.found[0].name;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-strong;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.found[0].url;
                        font-size: Theme.font-caption;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                Icon { text: "\u{F0142}"; font-size: 24px; color: Theme.faint; }
            }
        }
        if root.found.length > 1: Rectangle {
            height: 52px;
            border-radius: Theme.radius-small;
            background: tm.pressed ? Theme.surface-pressed : Theme.surface;
            tm := TouchArea {
                clicked => { root.choose-many(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: 19px;
                        background: #18bcf226;
                        Icon { text: "\u{F07D0}"; font-size: 22px; color: #18bcf2; }
                        // How many were found.
                        Rectangle {
                            x: parent.width - 14px;
                            y: -4px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            // brand: a number never sits on Signal
                            background: Theme.text;
                            Text {
                                text: root.found.length;
                                font-size: 12px;
                                font-weight: Theme.weight-strong;
                                color: Theme.background;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.pick-text(root.many-before, 37) + root.found.length + root.pick-text(root.many-after, 37);
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-strong;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.pick-text(root.many-hints, 211);
                        font-size: Theme.font-caption;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
                Icon { text: "\u{F0142}"; font-size: 24px; color: Theme.faint; }
            }
        }
        if root.found.length == 0: Rectangle {
            height: 52px;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 38px;
                        height: 38px;
                        Icon { text: "\u{F0437}"; font-size: 22px; color: Theme.faint; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.pick-text(root.searching, 37);
                        font-size: Theme.font-label;
                        color: Theme.muted;
                        overflow: elide;
                    }
                    Text {
                        text: root.pick-text(root.searching-hints, 211);
                        font-size: Theme.font-caption;
                        color: Theme.faint;
                        overflow: elide;
                    }
                }
            }
        }

        // Typed address with a caret; a long one moves left, so its end stays in view.
        Rectangle {
            height: 50px;
            border-radius: Theme.radius-small;
            background: Theme.surface;
            border-width: 2px;
            border-color: root.message-kind == 1 ? Theme.danger : Theme.accent;
            Rectangle {
                x: 16px;
                width: parent.width - 32px;
                clip: true;
                HorizontalLayout {
                    x: min(0px, parent.width - self.preferred-width);
                    width: self.preferred-width;
                    spacing: 2px;
                    if root.address != "": Text {
                        text: root.address;
                        font-size: 22px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 2px; height: 26px; background: Theme.accent; }
                    }
                    if root.address == "": Text {
                        text: "192.168.0.10";
                        font-size: 22px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // What happened, right under the address.
        MessageLine {
            message: root.message;
            kind: root.message-kind;
            busy: root.busy;
        }
    }

    // The full keyboard, as for the Wi-Fi password; its ?123 key switches to the digits.
    Keyboard {
        x: Theme.pad;
        y: Theme.keyboard-top;
        width: root.width - 2 * Theme.pad;
        layer: root.layer;
        layout: root.layout;
        enter-label: root.busy ? "…" : "Connect";
        key(k) => {
            if k == "enter" {
                root.connect();
            } else {
                root.key(k);
            }
        }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }

    // Which Wi-Fi the panel is on, and a way back to the network picker.
    if root.wifi-info-open: Rectangle {
        TouchArea { clicked => { root.wifi-info-open = false; } }
        Rectangle {
            x: root.width - self.width - Theme.pad;
            y: 64px;
            width: 280px;
            height: card.preferred-height;
            border-radius: Theme.radius-small;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.outline;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000080;
            TouchArea { }
            card := VerticalLayout {
                padding: 14px;
                padding-top: 8px;
                padding-right: 8px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: "Connected to";
                        font-size: Theme.font-caption;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    // Small close button.
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: cx.pressed ? Theme.surface-pressed : Theme.surface;
                        cx := TouchArea { clicked => { root.wifi-info-open = false; } }
                        Icon { text: "\u{F0156}"; font-size: 16px; color: Theme.muted; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Icon {
                        text: ["\u{F091F}", "\u{F0922}", "\u{F0925}", "\u{F0928}"][max(0, min(3, root.wifi-bars - 1))];
                        font-size: 26px;
                        color: root.wifi-bars <= 1 ? Theme.warning : Theme.text;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: root.wifi-name;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-strong;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: (root.wifi-bars >= 4 ? "Strong signal" : root.wifi-bars == 3 ? "Good signal" : root.wifi-bars == 2 ? "Weak signal" : "Very weak signal") + " · " + root.wifi-ip;
                            font-size: Theme.font-caption;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                }
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                    background: cn.pressed ? Theme.accent.with-alpha(0.15) : transparent;
                    cn := TouchArea { clicked => { root.wifi-info-open = false; root.change-wifi(); } }
                    Text {
                        text: "Change network";
                        font-size: Theme.font-label;
                        font-weight: Theme.weight-strong;
                        color: Theme.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Phrase lists shared by more than one screen. The hidden-network row of the
// Wi-Fi list and the title of the hidden-network screen use the same list and
// the same random number, so the screen is titled with the row that was tapped.
export global Phrases {
    out property <[string]> wifi-hidden: Words.list("ui.phrases.wifi-hidden");
    out property <int> wifi-hidden-stride: 28561;
}

// First start without network: pick a Wi-Fi network (scan results),
// or a hidden one by name.
export struct WifiNet {
    ssid: string,
    strength: int,     // 1..4 bars
    secure: bool,
    saved: bool,
}

component WifiRow inherits Rectangle {
    in property <string> icon;
    in property <color> icon-color: Theme.text;
    in property <string> label;
    in property <string> detail;
    in property <bool> divider: true;
    callback clicked;
    height: 48px;
    background: t.pressed ? Theme.surface-pressed : transparent;
    t := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Icon { text: root.icon; font-size: 24px; color: root.icon-color; }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: Theme.font-caption;
            color: Theme.muted;
            vertical-alignment: center;
        }
        Icon { text: "\u{F0142}"; font-size: 24px; color: Theme.faint; }
    }
    if root.divider: Rectangle {
        x: 52px;
        y: parent.height - 1px;
        width: parent.width - 52px;
        height: 1px;
        background: Theme.outline;
    }
}

export component WifiScreen inherits Rectangle {
    in property <[WifiNet]> networks;
    in property <bool> scanning;
    callback pick(string);
    callback rescan();
    callback other();
    in property <bool> can-back;       // opened from the settings or the setup screen: a back arrow instead of the logo
    callback back();
    in property <int> theme-mode: 2;   // 0 light, 1 dark, 2 auto
    callback theme-changed(int);
    // Random number from the app (0..1e9), picked each time the screen
    // opens. Every text below comes from its own list (lists may differ in
    // length) and each list uses a different stride of the number, so any
    // title can meet any subtitle; each title fits each subtitle.
    in property <int> variant: 0;
    property <[string]> titles: Words.list("ui.wifiscreen.titles");
    property <[string]> subtitles: Words.list("ui.wifiscreen.subtitles");
    property <[string]> scanning-texts: Words.list("ui.wifiscreen.scanning-texts");
    property <[string]> saved-texts: Words.list("ui.wifiscreen.saved-texts");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}
    VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;

        // Logo, title, what to do, scan again.
        HorizontalLayout {
            spacing: 12px;
            padding-bottom: 2px;
            VerticalLayout {
                alignment: center;
                if !root.can-back: LogoMark { size: 40px; }
                if root.can-back: RoundButton { icon: "\u{F0141}"; size: 40px; tint: Theme.text; clicked => { root.back(); } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: root.pick-text(root.titles, 1);
                    font-size: Theme.font-title; font-family: Theme.heading-family;
                    font-weight: Theme.weight-strong;
                    color: Theme.text;
                }
                Text {
                    text: root.scanning ? root.pick-text(root.scanning-texts, 169) : root.pick-text(root.subtitles, 13);
                    font-size: Theme.font-label;
                    color: Theme.muted;
                }
            }
            VerticalLayout {
                alignment: center;
                // M30: while it scans, the signal bars light up one after another (250 ms each)
                RoundButton {
                    icon: root.scanning ? ["\u{F091F}", "\u{F0922}", "\u{F0925}", "\u{F0928}"][Math.mod(Math.floor(animation-tick() / 250ms), 4)] : "\u{F0450}";
                    size: 40px;
                    tint: Theme.muted;
                    clicked => { root.rescan(); }
                }
            }
        }

        // Networks, strongest first, then a hidden one by name.
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-small;
            background: Theme.surface;
            clip: true;
            Flickable {
                content-height: list.preferred-height;
                list := VerticalLayout {
                    for n[i] in root.networks: WifiRow {
                        icon: n.secure
                            ? ["\u{F0921}", "\u{F0924}", "\u{F0927}", "\u{F092A}"][max(0, min(3, n.strength - 1))]
                            : ["\u{F091F}", "\u{F0922}", "\u{F0925}", "\u{F0928}"][max(0, min(3, n.strength - 1))];
                        icon-color: n.strength <= 1 ? Theme.muted : Theme.text;
                        label: n.ssid;
                        detail: n.saved ? root.pick-text(root.saved-texts, 2197) : "";
                        clicked => { root.pick(n.ssid); }
                    }
                    WifiRow {
                        icon: "\u{F16C3}";
                        icon-color: Theme.muted;
                        label: root.pick-text(Phrases.wifi-hidden, Phrases.wifi-hidden-stride);
                        divider: false;
                        clicked => { root.other(); }
                    }
                }
            }
        }

        // Light, dark or automatic (light sensor), from the first start on.
        HorizontalLayout {
            alignment: center;
            ThemeSwitch {
                selected: root.theme-mode;
                changed(m) => { root.theme-changed(m); }
            }
        }
    }
}

// Back button, title and subtitle at the top of the keyboard screens.
component BackHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    callback back();
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        RoundButton { icon: "\u{F0141}"; size: 40px; tint: Theme.text; clicked => { root.back(); } }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 0px;
        Text {
            text: root.title;
            font-size: Theme.font-title; font-family: Theme.heading-family;
            font-weight: Theme.weight-strong;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            text: root.subtitle;
            font-size: Theme.font-label;
            color: Theme.muted;
            overflow: elide;
        }
    }
}

// One input line (name or password).
component InputField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> focused;
    in property <bool> error;
    in property <bool> secret;           // shows the eye button
    in property <bool> show;
    callback tapped();
    callback toggle-show();
    height: 46px;
    border-radius: Theme.radius-small;
    background: Theme.surface;
    border-width: root.focused || root.error ? 2px : 1px;
    border-color: root.error ? Theme.danger : root.focused ? Theme.accent : Theme.outline;
    TouchArea { clicked => { root.tapped(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 2px;
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.focused: VerticalLayout {
            alignment: center;
            Rectangle { width: 2px; height: 24px; background: Theme.accent; }
        }
        if root.text == "": Text {
            text: root.placeholder;
            font-size: Theme.font-body;
            color: Theme.faint;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.secret: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: st.pressed ? Theme.surface-pressed : transparent;
                st := TapArea { tapped => { root.toggle-show(); } }
                Icon { text: root.show ? "\u{F06D1}" : "\u{F06D0}"; font-size: 22px; color: Theme.muted; }
            }
        }
    }
}

// Password of the picked network.
export component WifiPasswordScreen inherits Rectangle {
    in property <string> ssid;
    in property <string> shown-text;     // the password, or dots while hidden
    in property <bool> show: false;
    in property <int> layer: 0;
    in property <int> layout: 0;
    in property <string> message;
    in property <int> message-kind: 0;   // 0 working, 1 error, 2 success
    in property <bool> busy;
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    in property <string> held-key;
    in property <[string]> popup-options;
    in property <length> popup-x;
    in property <length> popup-y;
    in property <int> popup-selected: -1;
    callback back();
    callback key(string);
    callback toggle-show();
    callback theme-changed(int);
    property <[string]> prompts: Words.list("ui.wifipasswordscreen.prompts");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.keyboard-top;
        padding: Theme.pad;
        padding-bottom: 0px;
        spacing: 8px;
        alignment: start;
        BackHeader {
            title: root.ssid;
            subtitle: root.pick-text(root.prompts, 1);
            back => { root.back(); }
        }
        InputField {
            height: 52px;
            text: root.shown-text;
            placeholder: "Password";
            focused: true;
            error: root.message-kind == 1;
            secret: true;
            show: root.show;
            toggle-show => { root.toggle-show(); }
        }
        MessageLine {
            message: root.message;
            kind: root.message-kind;
            busy: root.busy;
        }
    }

    Keyboard {
        x: Theme.pad;
        y: Theme.keyboard-top;
        width: root.width - 2 * Theme.pad;
        layer: root.layer;
        layout: root.layout;
        held-key: root.held-key;
        popup-options: root.popup-options;
        popup-x: root.popup-x;
        popup-y: root.popup-y;
        popup-selected: root.popup-selected;
        enter-label: root.busy ? "…" : "Connect";
        key(k) => { root.key(k); }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}

// A hidden network: its name and password, typed.
export component HiddenNetworkScreen inherits Rectangle {
    in property <string> name;
    in property <string> shown-password;  // the password, or dots while hidden
    in property <bool> show: false;
    in property <int> field: 0;           // focused field: 0 name, 1 password
    in property <int> layer: 0;
    in property <int> layout: 0;
    in property <string> message;
    in property <int> message-kind: 0;    // 0 working, 1 error, 2 success
    in property <bool> busy;
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    callback back();
    callback key(string);
    callback focus-field(int);
    callback toggle-show();
    callback theme-changed(int);
    property <[string]> subtitles: Words.list("ui.hiddennetworkscreen.subtitles");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.keyboard-top;
        padding: Theme.pad;
        padding-bottom: 0px;
        spacing: 6px;
        alignment: start;
        BackHeader {
            // The row tapped on the Wi-Fi list.
            title: root.pick-text(Phrases.wifi-hidden, Phrases.wifi-hidden-stride);
            subtitle: root.pick-text(root.subtitles, 3);
            back => { root.back(); }
        }
        InputField {
            text: root.name;
            placeholder: "Network name";
            focused: root.field == 0;
            error: root.message-kind == 1;
            tapped => { root.focus-field(0); }
        }
        InputField {
            text: root.shown-password;
            placeholder: "Password (empty if open)";
            focused: root.field == 1;
            secret: true;
            show: root.show;
            tapped => { root.focus-field(1); }
            toggle-show => { root.toggle-show(); }
        }
        MessageLine {
            message: root.message;
            kind: root.message-kind;
            busy: root.busy;
        }
    }

    Keyboard {
        x: Theme.pad;
        y: Theme.keyboard-top;
        width: root.width - 2 * Theme.pad;
        layer: root.layer;
        layout: root.layout;
        enter-label: root.field == 0 ? "Next" : (root.busy ? "…" : "Connect");
        key(k) => { root.key(k); }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}

// Several Home Assistants found: pick the one this panel belongs to.
export component HaPickScreen inherits Rectangle {
    in property <[FoundHa]> found;
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    callback back();
    callback pick(string);
    callback theme-changed(int);
    property <string> multiples: root.found.length == 2 ? "Twins" : root.found.length == 3 ? "Triplets"
        : root.found.length == 4 ? "Quadruplets" : root.found.length == 5 ? "Quintuplets" : "A whole crowd";
    property <[string]> titles: Words.list("ui.hapickscreen.titles");
    property <[string]> subtitles: Words.list("ui.hapickscreen.subtitles");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    background: Theme.background;
    TouchArea {}
    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.switch-top - 8px;
        padding: Theme.pad;
        padding-bottom: 0px;
        spacing: 10px;
        alignment: start;
        BackHeader {
            title: root.pick-text(root.titles, 1);
            subtitle: root.pick-text(root.subtitles, 7);
            back => { root.back(); }
        }
        Rectangle {
            height: min(root.found.length * 60px, 5 * 60px);
            border-radius: Theme.radius-small;
            background: Theme.surface;
            clip: true;
            Flickable {
                content-height: list.preferred-height;
                list := VerticalLayout {
                    for ha[i] in root.found: Rectangle {
                        height: 60px;
                        background: t.pressed ? Theme.surface-pressed : transparent;
                        t := TouchArea { clicked => { root.pick(ha.url); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    border-radius: 19px;
                                    background: #18bcf226;
                                    Icon { text: "\u{F07D0}"; font-size: 22px; color: #18bcf2; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: ha.name;
                                    font-size: Theme.font-body;
                                    font-weight: Theme.weight-strong;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: ha.url;
                                    font-size: Theme.font-caption;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                            Icon { text: "\u{F0142}"; font-size: 24px; color: Theme.faint; }
                        }
                        if i < root.found.length - 1: Rectangle {
                            x: 60px;
                            y: parent.height - 1px;
                            width: parent.width - 60px;
                            height: 1px;
                            background: Theme.outline;
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}

// First connection to Home Assistant (after pairing, or when the data is
// late after a start): logo in a progress ring, what is happening, which
// Home Assistant. The ring follows the real milestones of the session;
// a faint glow keeps running ahead of it so it never looks stuck.
export component ConnectingScreen inherits Rectangle {
    in property <float> morse-t;          // the Morse light's clock (seconds)
    in property <string> ha-url;
    in property <bool> slow: false;       // no data after ~10 s
    in property <float> progress: 0;      // 0..1, reached milestones
    in property <int> step: 0;            // the current milestone, 0..5
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    callback theme-changed(int);
    property <[string]> titles: Words.list("ui.connectingscreen.titles");
    property <[string]> slow-texts: Words.list("ui.connectingscreen.slow-texts");
    // One short line per milestone (they pass quickly).
    property <[string]> step0: Words.list("ui.connectingscreen.step0");
    property <[string]> step1: Words.list("ui.connectingscreen.step1");
    property <[string]> step2: Words.list("ui.connectingscreen.step2");
    property <[string]> step3: Words.list("ui.connectingscreen.step3");
    property <[string]> step4: Words.list("ui.connectingscreen.step4");
    property <[string]> step5: Words.list("ui.connectingscreen.step5");
    function step-label() -> string {
        root.step == 0 ? root.pick-text(root.step0, 11) : root.step == 1 ? root.pick-text(root.step1, 11)
            : root.step == 2 ? root.pick-text(root.step2, 11) : root.step == 3 ? root.pick-text(root.step3, 11)
            : root.step == 4 ? root.pick-text(root.step4, 11) : root.pick-text(root.step5, 11)
    }
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }

    // The mark writes itself over the calm Morse pattern, as on the start-up
    // and the dashboard's loading screen (no glow, nothing in its clear space).
    background: Theme.background;
    TouchArea {}
    Image {
        width: 480px;
        height: 480px;
        source: Theme.dark ? @image-url("images/wait-dark.png") : @image-url("images/wait-light.png");
    }
    MorseWrite {
        u: 16px;
        dark: Theme.dark;
        x: (parent.width - self.width) / 2;
        y: 180px - self.height / 2;
    }

    VerticalLayout {
        x: Theme.pad;
        y: 254px;
        width: root.width - 2 * Theme.pad;
        height: Theme.switch-top - 8px - self.y;
        alignment: start;
        spacing: 8px;
        Text {
            text: root.pick-text(root.titles, 1);
            font-size: Theme.font-title; font-family: Theme.heading-family;
            font-weight: Theme.weight-strong;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.step-label() + " · " + root.ha-url;
            font-size: Theme.font-label;
            color: Theme.muted;
            horizontal-alignment: center;
            overflow: elide;
        }
        // Shown only when it takes long.
        Text {
            height: 40px;
            text: root.slow ? root.pick-text(root.slow-texts, 7) : "";
            font-size: Theme.font-label;
            color: Theme.warning;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}

// No data at all yet and nothing to connect to: no network, or Home
// Assistant does not answer. The ring empties towards the next attempt.
export component OfflineScreen inherits Rectangle {
    in property <float> morse-t;          // the Morse light's clock (seconds)
    in property <int> cause: 1;           // 1 no network, 2 Home Assistant not answering
    // Next attempt: started at retry-start (ms on the animation clock, the
    // platform's time since start) and comes after retry-total ms.
    in property <float> retry-start: 0;
    in property <float> retry-total: 0;   // 0: trying right now
    in property <string> net-name;
    in property <string> ha-url;
    in property <int> variant: 0;
    in property <int> theme-mode: 2;
    callback try-now();
    callback change-wifi();
    callback change-ha();
    callback theme-changed(int);
    property <[string]> net-titles: Words.list("ui.offlinescreen.net-titles");
    property <[string]> net-hints: Words.list("ui.offlinescreen.net-hints");
    property <[string]> ha-titles: Words.list("ui.offlinescreen.ha-titles");
    property <[string]> ha-hints: Words.list("ui.offlinescreen.ha-hints");
    function pick-text(list: [string], stride: int) -> string {
        list[Math.mod(floor(root.variant / stride), list.length)]
    }
    property <float> now: (animation-tick() - Clock.base) / 1ms;
    property <float> left-ms: root.retry-total > 0 ? max(0, root.retry-start + root.retry-total - root.now) : 0;
    property <float> wait: root.retry-total > 0 ? root.left-ms / root.retry-total : 0;
    property <int> seconds: ceil(root.left-ms / 1000);
    // The mark writes itself over the calm Morse pattern (one family with the
    // start-up and the loading screen); what is missing is said in the text
    // under it, nothing enters the mark's clear space.
    background: Theme.background;
    TouchArea {}
    Image {
        width: 480px;
        height: 480px;
        source: Theme.dark ? @image-url("images/wait-dark.png") : @image-url("images/wait-light.png");
    }
    MorseWrite {
        u: 16px;
        dark: Theme.dark;
        x: (parent.width - self.width) / 2;
        y: 180px - self.height / 2;
    }

    VerticalLayout {
        x: Theme.pad;
        y: 248px;
        width: root.width - 2 * Theme.pad;
        height: Theme.switch-top - 4px - self.y;
        alignment: start;
        spacing: 8px;

        Text {
            text: root.cause == 1 ? root.pick-text(root.net-titles, 1) : root.pick-text(root.ha-titles, 1);
            font-size: Theme.font-title; font-family: Theme.heading-family;
            font-weight: Theme.weight-strong;
            color: Theme.text;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            Icon {
                text: root.cause == 1 ? "\u{F05AA}" : "\u{F15D0}";
                font-size: 17px;
                color: Theme.warning;
            }
            Text {
                text: (root.cause == 1 ? "Wi-Fi " + root.net-name + " · no connection" : root.ha-url + " · not answering")
                    + " · " + (root.seconds > 0 ? "trying again in " + root.seconds + " s" : "trying now…");
                font-size: Theme.font-label;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            height: 40px;
            text: root.cause == 1 ? root.pick-text(root.net-hints, 7) : root.pick-text(root.ha-hints, 7);
            font-size: Theme.font-label;
            color: Theme.warning;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
        }

        // Try at once, or fix the setting.
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            Rectangle {
                height: 40px;
                width: tn.preferred-width + 32px;
                border-radius: 20px;
                border-width: 1.5px;
                border-color: Theme.accent;
                background: tt.pressed ? Theme.accent.with-alpha(0.15) : transparent;
                tt := TouchArea { clicked => { root.try-now(); } }
                tn := Text {
                    x: 16px;
                    text: "Try now";
                    font-size: Theme.font-label;
                    font-weight: Theme.weight-strong;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 40px;
                width: cg.preferred-width + 32px;
                border-radius: 20px;
                background: ct.pressed ? Theme.surface-pressed : Theme.surface-raised;
                ct := TouchArea { clicked => { if root.cause == 1 { root.change-wifi(); } else { root.change-ha(); } } }
                cg := Text {
                    x: 16px;
                    text: root.cause == 1 ? "Change Wi-Fi" : "Change Home Assistant";
                    font-size: Theme.font-label;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
        }
    }

    HorizontalLayout {
        y: Theme.switch-top;
        height: 40px;
        alignment: center;
        ThemeSwitch {
            selected: root.theme-mode;
            changed(m) => { root.theme-changed(m); }
        }
    }
}
