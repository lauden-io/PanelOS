// Small building blocks: icon text, round buttons, chips, toggles, sliders.

import { Theme, Clock, Act } from "theme.slint";

// A bottom sheet that follows the finger (spec 26): its scrim, the handle and the sheet; the content goes in as
// children (drawn from the sheet's top, `need` high). It opens with a small spring, follows a drag on the handle
// strip and the header (top 64 px) 1:1, stretches at most 24 px above its height (rubber band), and on release
// closes (a flick down faster than 0.5 px/ms, or pulled past min(30 % of its height, 120 px)) or springs back
// from where the finger left it. The scrim fades with the visible part; a tap on it closes the sheet.
export component DragSheet inherits Rectangle {
    in property <bool> open;
    in property <length> need;                   // the sheet's height (sized to its content)
    in property <color> sheet-color: Theme.surface;
    in property <color> ink: Theme.text;          // the handle's colour (the sheet's text colour)
    callback close();                            // a tap on the scrim, or the sheet dragged away
    in property <bool> dismissable: true;        // false: it follows the finger with the rubber band and springs back
    in property <float> scrim-alpha: 0.5;
    in property <length> grab: 64px;             // the strip at the top that drags the sheet
    // a tall sheet (its content over 424 px; `need` is then 424 px): it opens at medium (300 px high) and goes up to
    // full (just under the status bar), where its content scrolls; the content stays the sheet's own business
    in property <length> content-need: 0px;
    property <bool> tall: root.content-need > 424px;
    property <int> level;                        // a tall sheet: 0 medium, 1 full
    property <length> base: root.tall && root.level == 0 ? root.need - 300px : 0px;
    out property <bool> shown: root.open || root.close-k < 0.999;
    // open: the M3 spring (300 ms, a 3 px overshoot); close: 200 ms ease-in
    property <float> open-k: root.open ? 1 : 0;
    animate open-k { duration: root.open ? 300ms : 0ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }
    property <float> close-k: root.open ? 0 : 1;
    animate close-k { duration: root.open ? 0ms : 200ms; easing: cubic-bezier(0.4, 0, 1, 1); }
    property <length> travel: root.need + 24px;
    property <length> slide: root.open ? (1 - root.open-k) * root.travel : root.close-k * root.travel;
    // the drag: the finger's offset (down +), the rubber band above; after release it moves to its target
    property <bool> held;
    property <bool> snap;                        // set the drag without motion (a fresh opening)
    property <length> drag;
    property <duration> drag-ms: 300ms;
    animate drag { duration: root.held || root.snap ? 0ms : root.drag-ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> last-y;
    property <duration> last-t;
    property <float> vel;                        // px per ms, + downwards, over the last movement
    property <bool> leaving;
    changed open => {
        if root.open {
            root.snap = true;
            root.level = 0;
            root.drag = 0px;
            root.leaving = false;
            root.snap = false;
        }
    }
    // to another height: the position kept (the drag takes up the difference at once), then the spring to the new one
    function go-level(l: int, ms: duration) {
        let pos = root.base + root.drag;
        root.snap = true;
        root.level = l;
        root.drag = pos - root.base;
        root.snap = false;
        root.drag-ms = ms;
        root.drag = 0px;
    }
    pure function band(d: length) -> length {
        // above the sheet's height: 24 px · (1 − e^(−d / 80 px))
        return -24px * (1 - Math.pow(2.71828, -(d / 80px)));
    }
    Timer {
        interval: root.drag-ms + 20ms;
        running: root.leaving;
        triggered => {
            root.leaving = false;
            root.close();
        }
    }
    property <length> open-h: root.need - root.base;
    property <length> visible-h: Math.max(0px, root.need - root.slide - root.base - root.drag);
    Rectangle {
        visible: root.shown;
        background: #000000;
        // the scrim follows the sheet; at full height up to 1.15 x the theme's (at most 0.6)
        opacity: root.visible-h <= root.open-h ? root.scrim-alpha * Math.min(1, root.visible-h / Math.max(1px, root.open-h))
            : Math.min(0.6, root.scrim-alpha * (1 + 0.15 * Math.min(1, (root.visible-h - root.open-h) / Math.max(1px, root.need - root.open-h))));
        TouchArea {
            enabled: !root.held;
            clicked => { if root.dismissable { root.close(); } }
        }
    }
    sheet := Rectangle {
        visible: root.shown;
        x: 0; y: root.height - root.need + root.slide + root.base + root.drag; width: root.width; height: root.need + 24px;
        border-radius: 24px; background: root.sheet-color;
        TouchArea { }
        // the handle: 36 × 4 at 30 %, 52 × 5 at 55 % while held
        property <bool> wide: root.held;
        Rectangle {
            property <float> hk: sheet.wide ? 1 : 0;
            animate hk { duration: sheet.wide ? 120ms : 160ms; easing: ease-out; }
            x: (parent.width - (36px + 16px * self.hk)) / 2; y: 8px - 0.5px * self.hk;
            width: 36px + 16px * self.hk; height: 4px + 1px * self.hk; border-radius: 2.5px;
            background: root.ink.with-alpha(0.3 + 0.25 * self.hk);
        }
        grab-ta := TouchArea {
            x: 0; y: 0; width: parent.width; height: root.grab;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.held = true;
                    root.last-y = self.mouse-y;
                    root.last-t = animation-tick();
                    root.vel = 0;
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.held && root.tall {
                    root.held = false;
                    // a tall sheet (26.3): flicks change the height (or close), then the distances decide
                    if root.level == 1 && root.vel > 1.6 && root.dismissable {
                        root.drag-ms = Math.max(90ms, Math.min(200ms, ((root.travel + root.need - root.drag) / 1px) / root.vel * 1ms));
                        root.drag = root.travel + root.need;
                        root.leaving = true;
                    } else if root.level == 1 && root.vel > 0.5 {
                        root.go-level(0, root.vel > 0.8 ? 220ms : 300ms);
                    } else if root.level == 0 && root.vel > 0.5 && root.dismissable {
                        root.drag-ms = root.vel > 0.8 ? Math.max(90ms, Math.min(200ms, ((root.travel - root.drag) / 1px) / root.vel * 1ms)) : 200ms;
                        root.drag = root.travel;
                        root.leaving = true;
                    } else if root.level == 0 && root.vel < -0.5 {
                        root.go-level(1, Math.abs(root.vel) > 0.8 ? 220ms : 300ms);
                    } else if root.dismissable && root.drag > Math.min((root.need - root.base) * 0.3, 120px) {
                        root.drag-ms = 200ms;
                        root.drag = root.travel + root.need;
                        root.leaving = true;
                    } else if root.level == 1 && root.drag > (root.need - 300px) * 0.3 {
                        root.go-level(0, 300ms);
                    } else if root.level == 0 && root.drag < -(root.need - 300px) * 0.3 {
                        root.go-level(1, 300ms);
                    } else {
                        root.drag-ms = Math.abs(root.vel) > 0.8 ? 220ms : 300ms;
                        root.drag = 0px;
                    }
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) && root.held {
                    root.held = false;
                    // the decision: a flick down, or far enough down → close; else back to the sheet's height
                    if root.dismissable && (root.vel > 0.5 || root.drag > Math.min(root.need * 0.3, 120px)) {
                        let remaining = root.travel - root.drag;
                        root.drag-ms = root.vel > 0.8 ? Math.max(90ms, Math.min(200ms, (remaining / 1px) / root.vel * 1ms)) : 200ms;
                        root.drag = root.travel;
                        root.leaving = true;
                    } else {
                        root.drag-ms = Math.abs(root.vel) > 0.8 ? 220ms : 300ms;
                        root.drag = 0px;
                    }
                }
            }
            moved => {
                if root.held {
                    let dy = self.mouse-y - self.pressed-y;
                    let raw = root.dismissable ? dy : Math.min(dy, 24px);
                    // a tall sheet at medium follows the finger 1:1 up to full; above the top height the rubber band
                    root.drag = raw >= -root.base ? raw : -root.base + root.band(-raw - root.base);
                    // velocity over the latest movement (at least 16 ms apart), smoothed
                    let dt = (animation-tick() - root.last-t) / 1ms;
                    if dt >= 16 {
                        root.vel = root.vel * 0.4 + 0.6 * ((self.mouse-y - root.last-y) / 1px) / dt;
                        root.last-y = self.mouse-y;
                        root.last-t = animation-tick();
                    }
                }
            }
        }
        // a sideways drag on the sheet belongs to the sheet: it neither turns the page under it nor ends as a tap on
        // a row (the gesture takes it from the rows)
        SwipeGestureHandler {
            width: parent.width; height: parent.height;
            handle-swipe-left: true; handle-swipe-right: true;
            @children
        }
    }
}

// A news crawl: the text rolls on from right to left without end, drawn twice for a seamless loop. A new text
// joins at the tail (never under the eye); a new `epoch` starts it afresh (bumped while its page is out of sight).
export component Crawl inherits Rectangle {
    in property <string> text;
    in property <int> epoch;
    in property <bool> live: true;         // its page is on screen: off screen it stands still and starts afresh on return
    in property <length> font-size: 13px;
    in property <int> font-weight: 700;
    in property <string> font-family;
    in property <length> letter-spacing: 0;
    in property <color> ink;
    in property <float> speed: 0.07;       // px per ms
    clip: true;
    // the gap between the copies is the app's own separator ("   •   "), so the seam looks like every other joint
    sep-probe := Text { visible: false; text: "a   \u{2022}   a"; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; }
    pair-probe := Text { visible: false; text: "aa"; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; }
    property <length> gap: sep-probe.preferred-width - pair-probe.preferred-width;
    property <string> lead;                // the copy in front
    property <string> tail;                // the copy behind it
    property <duration> t0;
    // a copy never shorter than the strip, so the strip is never half empty
    property <length> span: max(lead-text.preferred-width, root.width) + root.gap;
    property <length> off: (animation-tick() - root.t0) / 1ms * root.speed * 1px;
    function restart() {
        root.lead = root.text;
        root.tail = root.text;
        root.t0 = animation-tick();
    }
    init => { root.restart(); }
    changed epoch => { root.restart(); }
    changed live => { if root.live { root.restart(); } }
    changed text => {
        if root.lead == "" {
            root.restart();
        } else if root.span - root.off > root.width {
            root.tail = root.text;
        }
    }
    // when the front copy has rolled out, the one behind leads and the newest text follows it (a late look only
    // moves the swap into the gap: the picture does not jump)
    Timer {
        interval: 250ms;
        running: root.lead != "" && root.live;
        triggered => {
            if root.off >= root.span {
                root.t0 += root.span / 1px / root.speed * 1ms;
                root.lead = root.tail;
                root.tail = root.text;
            }
        }
    }
    lead-text := Text { x: -root.off; y: 0; height: root.height; text: root.lead; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; color: root.ink; vertical-alignment: center; }
    Text { x: root.span - root.off - root.gap / 2 - self.preferred-width / 2; y: 0; height: root.height; text: "\u{2022}"; font-size: root.font-size;
        font-weight: root.font-weight; font-family: root.font-family; color: root.ink; vertical-alignment: center; }
    Text { x: root.span - root.off; y: 0; height: root.height; text: root.tail; font-size: root.font-size; font-weight: root.font-weight;
        font-family: root.font-family; letter-spacing: root.letter-spacing; color: root.ink; vertical-alignment: center; }
}

// The play triangle sits 1/16 em right of the middle in the icon font (its box: 171..405 of 512): an icon in a
// round button moves it back by this much, so play and pause are both in the middle of the circle.
export global Glyph {
    pure public function nudge(text: string, size: length) -> length {
        return text == "\u{F040A}" ? -size * 0.0625 : 0px;
    }
}

// Play / pause as one shape (M13): the play triangle (38,28) (68,48) (38,68) in a 96 px square, its centroid in
// the middle, split at x 53 into two quads that morph into the pause bars (34–44 and 52–62, y 30–66) in 160 ms.
export component PlayGlyph inherits Rectangle {
    in property <bool> playing;          // true: the pause bars (it plays), false: the play triangle
    in property <color> ink: #ffffff;
    property <float> k: root.playing ? 1 : 0;
    animate k { duration: 160ms; easing: ease-in-out; }
    pure function m(a: float, b: float) -> float { return a + (b - a) * root.k; }
    Path {
        width: root.width; height: root.height; viewbox-width: 96; viewbox-height: 96; fill: root.ink;
        MoveTo { x: root.m(38, 34); y: root.m(28, 30); }
        LineTo { x: root.m(53, 44); y: root.m(38, 30); }
        LineTo { x: root.m(53, 44); y: root.m(58, 66); }
        LineTo { x: root.m(38, 34); y: root.m(68, 66); }
        Close { }
        MoveTo { x: root.m(53, 52); y: root.m(38, 30); }
        LineTo { x: root.m(68, 62); y: root.m(48, 30); }
        LineTo { x: root.m(68, 62); y: root.m(48, 66); }
        LineTo { x: root.m(53, 52); y: root.m(58, 66); }
        Close { }
    }
}

export component Icon inherits Text {
    font-family: "Material Design Icons";
    // No layer of its own: a cached Text item kept showing the old glyph after
    // its text changed (play / pause), and a glyph is cheap on the GPU.
    horizontal-alignment: center;
    vertical-alignment: center;
}

// White text over the weather picture with a soft dark rim hugging the glyphs: four faint copies
// offset diagonally (a little more downwards). Readable over white clouds without a dark patch
// behind it. (The software renderer ignores Text stroke, so the rim is drawn this way.)
// k: strength (0 = plain text); icon: use the icon font.
export component GlowText {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k: 1;
    in property <bool> icon;
    in property <string> family;      // another font (e.g. the to-do terminal look's monospace); empty: the default
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextOverflow> overflow: clip;
    in property <TextWrap> wrap: no-wrap;  // long names wrap (the copies wrap the same way)
    // neon letters (home page, synthwave background): a coloured glow around the letters and a
    // firm dark rim instead of the soft one (as the timers page's synthwave theme)
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    // Text that changes every second (time labels): drawn directly. Any other
    // text is drawn once into its own layer: the rim copies cost nothing then.
    in property <bool> live;
    cache-rendering-hint: !root.live;
    property <length> d: max(0.8px, min(2.2px, root.font-size / 46));
    in property <bool> paper;          // dark text on a light scene: a Paper rim instead of the dark one
    property <color> rim: root.paper ? #F5F3EE.with-alpha(0.55 * min(1, root.k)) : #000000.with-alpha(0.18 * min(1, root.k));
    // the glow: one ring of copies just outside the thin dark rim, enough to show on every background
    // without turning into a halo (two rings are too much neon); the rim keeps the letters
    // readable on bright skies
    property <length> gi: max(1.8px, min(5px, root.font-size / 22));
    property <length> nr: max(0.7px, min(1.6px, root.font-size / 48));
    property <float> neon-rim: 0;     // the dark rim under the glow: off (no black frame with neon)
    preferred-width: t.preferred-width;
    preferred-height: t.preferred-height;
    min-height: t.preferred-height;
    for o in [{ x: -1, y: 0 }, { x: 1, y: 0 }, { x: 0, y: -1 }, { x: 0, y: 1 }, { x: -0.71, y: -0.71 }, { x: 0.71, y: -0.71 }, { x: -0.71, y: 0.71 }, { x: 0.71, y: 0.71 }]: Text {
        visible: root.neon;
        x: o.x * root.gi; y: o.y * root.gi; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.glow.with-alpha(0.24);
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow; wrap: root.wrap;
    }
    for o in [{ x: -1, y: -1 }, { x: 1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 1 }, { x: 0, y: -1.4 }, { x: 0, y: 1.4 }, { x: -1.4, y: 0 }, { x: 1.4, y: 0 }]: Text {
        visible: root.neon && root.neon-rim > 0;
        x: o.x * root.nr; y: o.y * root.nr; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.glow.mix(#000000, 0.22).with-alpha(0.85 * root.neon-rim);
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow; wrap: root.wrap;
    }
    for o in [{ x: -1, y: -0.35 }, { x: 1, y: -0.35 }, { x: -1, y: 1.5 }, { x: 1, y: 1.5 }]: Text {
        visible: root.k > 0.01 && !root.neon;
        x: o.x * root.d; y: o.y * root.d; width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.rim;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow; wrap: root.wrap;
    }
    t := Text {
        width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: root.color;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow; wrap: root.wrap;
    }
    // neon: a hot, whiter core (as a lit tube) — coloured letters turn pastel and stand out from a glow
    // of their own colour on a sky of the same hue; white letters stay white
    if root.neon: Text {
        width: root.width; height: root.height;
        text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: #ffffff73;
        font-family: root.icon ? "Material Design Icons" : root.family;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: center; overflow: root.overflow; wrap: root.wrap;
    }
}

// M8 digit roll: a digit rolls up like an odometer (180 ms, ease-out) when it changes; clipped only while it rolls,
// so the rim is whole at rest. k = 0: a plain text.
export component RollDigit {
    in property <int> d;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <bool> paper;
    in property <duration> dur: 180ms;
    // the shown digit is a plain value (a binding to d would already hold the new digit when `changed` runs)
    property <int> now-d;
    property <int> old-d;
    init => { root.now-d = root.d; }
    property <bool> rolling;
    property <duration> t0;
    changed d => { root.old-d = root.now-d; root.now-d = root.d; root.t0 = animation-tick(); root.rolling = true; }
    Timer { interval: root.dur + 20ms; running: root.rolling; triggered => { root.rolling = false; } }
    property <float> p: root.rolling ? clamp((animation-tick() - root.t0) / root.dur, 0, 1) : 1;
    property <float> e: 1 - Math.pow(1 - root.p, 3);
    property <length> m: 4px;
    preferred-width: g.preferred-width; preferred-height: g.preferred-height;
    min-width: g.preferred-width; min-height: g.preferred-height;
    // the roll runs in a window around the digits (Noto Sans: the digits fill 0.36–1.07 em of the 1.36 em line;
    // the window is 0.30–1.12 em, room for the rim), whatever height a layout gives the digit
    property <length> lh: g.preferred-height;
    property <length> ct: 0.30 * root.font-size;
    property <length> ch: 0.82 * root.font-size;
    Rectangle {
        x: -root.m; y: (root.height - root.lh) / 2 + root.ct; width: root.width + 2 * root.m; height: root.ch; clip: root.rolling;
        g := GlowText { x: root.m; y: -root.ct + (1 - root.e) * root.ch; width: root.width; height: root.lh; text: root.now-d; font-size: root.font-size;
            font-weight: root.font-weight; color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
        if root.rolling: GlowText { x: root.m; y: -root.ct - root.e * root.ch; width: root.width; height: root.lh; text: root.old-d; font-size: root.font-size;
            font-weight: root.font-weight; color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
    }
}

// 25.C2 ink digit: a changed digit fills in from the bottom like ink (a clip rising over it, 280 ms) while the old one
// fades; clipped only while it fills.
export component InkDigit {
    in property <int> d;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <bool> paper;
    property <int> now-d;
    property <int> old-d;
    init => { root.now-d = root.d; }
    property <bool> filling;
    property <duration> t0;
    changed d => { root.old-d = root.now-d; root.now-d = root.d; root.t0 = animation-tick(); root.filling = true; }
    Timer { interval: 300ms; running: root.filling; triggered => { root.filling = false; } }
    property <float> e: root.filling ? 1 - Math.pow(1 - clamp((animation-tick() - root.t0) / 280ms, 0, 1), 2) : 1;
    preferred-width: g.preferred-width; preferred-height: g.preferred-height;
    min-width: g.preferred-width; min-height: g.preferred-height;
    property <length> lh: g.preferred-height;
    property <length> ct: 0.30 * root.font-size;
    property <length> ch: 0.82 * root.font-size;
    if root.filling: GlowText { x: 0; y: (root.height - root.lh) / 2; width: root.width; height: root.lh; text: root.old-d; font-size: root.font-size;
        font-weight: root.font-weight; color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; opacity: 1 - root.e; }
    Rectangle {
        property <length> cy: root.filling ? (root.height - root.lh) / 2 + root.ct + (1 - root.e) * root.ch : 0px;
        x: -4px; y: self.cy; width: root.width + 8px; height: root.height - self.cy + 4px; clip: root.filling;
        g := GlowText { x: 4px; y: (root.height - root.lh) / 2 - parent.cy; width: root.width; height: root.lh; text: root.now-d; font-size: root.font-size;
            font-weight: root.font-weight; color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
    }
}

// Two clock digits ("07", "23", or "7") whose changed digit rolls (M8), or fills in like ink (ink, 25.C2); any other
// text is shown as it is.
export component RollPair inherits HorizontalLayout {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <bool> paper;
    in property <bool> ink;
    in property <duration> dur: 180ms;
    property <bool> num: root.text.is-float() && root.text.character-count <= 2;
    property <int> n: root.num ? root.text.to-float() : 0;
    spacing: 0;
    if root.num && !root.ink && root.text.character-count == 2: RollDigit { d: Math.floor(root.n / 10); font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; dur: root.dur; }
    if root.num && !root.ink: RollDigit { d: Math.mod(root.n, 10); font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; dur: root.dur; }
    if root.num && root.ink && root.text.character-count == 2: InkDigit { d: Math.floor(root.n / 10); font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
    if root.num && root.ink: InkDigit { d: Math.mod(root.n, 10); font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
    if !root.num: GlowText { text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; paper: root.paper; }
}

// A text line for titles: when it does not fit, it is either cut off with … or, with `scroll`, it
// runs to the left in a loop (holds 1.5 s at the start of each round). speed 1..5 = slow..fast.
// Short texts never move. k = GlowText rim (0 = plain).
component MarqueeLine {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> scroll;
    in property <float> speed: 3;
    in property <duration> t0;             // when this text came: its scroll starts from the beginning there
    property <length> tw: probe.preferred-width;
    property <bool> moving: root.scroll && self.tw > root.width;
    property <length> gap: 48px;
    property <float> v: root.speed <= 1 ? 14 : root.speed <= 2 ? 22 : root.speed <= 3 ? 32 : root.speed <= 4 ? 46 : 64;   // px / s
    property <float> period: (self.tw + self.gap) / 1px / self.v + 1.5;                                                  // s
    property <float> t: Math.mod(max(0, (animation-tick() - root.t0) / 1ms / 1000), self.period);
    property <length> off: max(0, self.t - 1.5) * self.v * 1px;
    probe := Text { visible: false; text: root.text; font-size: root.font-size; font-weight: root.font-weight; }
    Rectangle {
    clip: root.moving;
    if !root.moving: GlowText {
        width: root.width; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; overflow: elide;
    }
    if root.moving: GlowText {
        x: -root.off; width: root.tw; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow;
    }
    if root.moving: GlowText {
        x: -root.off + root.tw + root.gap; width: root.tw; height: root.height; text: root.text; font-size: root.font-size; font-weight: root.font-weight;
        color: root.color; k: root.k; neon: root.neon; glow: root.glow;
    }
    }
}

export component Marquee {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 400;
    in property <brush> color: #ffffff;
    in property <float> k;
    in property <bool> neon;
    in property <color> glow: #ff2bd6;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> scroll;
    in property <float> speed: 3;
    // a new text fades in over the old one (250 ms), two lines
    property <string> ta: root.text;
    property <string> tb;
    property <duration> ta0: Clock.base;
    property <duration> tb0;
    property <bool> on-b;
    changed text => {
        if root.on-b { root.ta = root.text; root.ta0 = animation-tick(); root.on-b = false; }
        else { root.tb = root.text; root.tb0 = animation-tick(); root.on-b = true; }
    }
    property <float> kb: root.on-b ? 1 : 0;
    animate kb { duration: 250ms; easing: ease-in-out; }
    if root.kb < 0.999: MarqueeLine {
        width: root.width; height: root.height; opacity: 1 - root.kb;
        text: root.ta; t0: root.ta0; font-size: root.font-size; font-weight: root.font-weight; color: root.color; k: root.k;
        neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; scroll: root.scroll; speed: root.speed;
    }
    if root.kb > 0.001: MarqueeLine {
        width: root.width; height: root.height; opacity: root.kb;
        text: root.tb; t0: root.tb0; font-size: root.font-size; font-weight: root.font-weight; color: root.color; k: root.k;
        neon: root.neon; glow: root.glow; horizontal-alignment: root.horizontal-alignment; scroll: root.scroll; speed: root.speed;
    }
}

// The LAUDEN logo mark (red disc with the house), from assets/logo.svg.
// The software renderer fills paths non-zero only, so the even-odd cut-outs
// of the SVG are drawn as layers: disc, house lines, house inside.
export component LogoMark inherits Rectangle {
    // the PanelOS mark: P in Morse in two rows (dot dash / dash dot); dots Signal, dashes the text colour of the ground
    in property <length> size: 32px;
    in property <color> lines: Theme.text;    // the dashes
    in property <color> disc: Theme.brand;    // the dots (grey while the panel is offline)
    property <length> u: self.size / 10;
    width: self.size;
    height: self.size;
    Rectangle { x: 0; y: (root.size - root.u * 6) / 2; width: root.size; height: root.u * 6;
        Rectangle { x: 0; y: 0; width: root.u * 2; height: root.u * 2; border-radius: root.u; background: root.disc; }
        Rectangle { x: root.u * 4; y: 0; width: root.u * 6; height: root.u * 2; border-radius: root.u; background: root.lines; }
        Rectangle { x: 0; y: root.u * 4; width: root.u * 6; height: root.u * 2; border-radius: root.u; background: root.lines; }
        Rectangle { x: root.u * 8; y: root.u * 4; width: root.u * 2; height: root.u * 2; border-radius: root.u; background: root.disc; }
    }
}

// the app icon's shape: a superellipse (n = 4, continuous curvature, every side gently curved)
export component Squircle inherits Path {
    in property <color> tone;
    viewbox-width: 100; viewbox-height: 100;
    fill: root.tone;
    commands: "M 100.00 50.00 L 99.98 59.91 L 99.92 64.01 L 99.83 67.14 L 99.69 69.78 L 99.52 72.08 L 99.30 74.16 L 99.05 76.05 L 98.76 77.79 L 98.43 79.42 L 98.06 80.93 L 97.65 82.35 L 97.20 83.69 L 96.70 84.95 L 96.17 86.14 L 95.59 87.27 L 94.97 88.33 L 94.31 89.34 L 93.60 90.29 L 92.85 91.19 L 92.04 92.04 L 91.19 92.85 L 90.29 93.60 L 89.34 94.31 L 88.33 94.97 L 87.27 95.59 L 86.14 96.17 L 84.95 96.70 L 83.69 97.20 L 82.35 97.65 L 80.93 98.06 L 79.42 98.43 L 77.79 98.76 L 76.05 99.05 L 74.16 99.30 L 72.08 99.52 L 69.78 99.69 L 67.14 99.83 L 64.01 99.92 L 59.91 99.98 L 50.00 100.00 L 40.09 99.98 L 35.99 99.92 L 32.86 99.83 L 30.22 99.69 L 27.92 99.52 L 25.84 99.30 L 23.95 99.05 L 22.21 98.76 L 20.58 98.43 L 19.07 98.06 L 17.65 97.65 L 16.31 97.20 L 15.05 96.70 L 13.86 96.17 L 12.73 95.59 L 11.67 94.97 L 10.66 94.31 L 9.71 93.60 L 8.81 92.85 L 7.96 92.04 L 7.15 91.19 L 6.40 90.29 L 5.69 89.34 L 5.03 88.33 L 4.41 87.27 L 3.83 86.14 L 3.30 84.95 L 2.80 83.69 L 2.35 82.35 L 1.94 80.93 L 1.57 79.42 L 1.24 77.79 L 0.95 76.05 L 0.70 74.16 L 0.48 72.08 L 0.31 69.78 L 0.17 67.14 L 0.08 64.01 L 0.02 59.91 L 0.00 50.00 L 0.02 40.09 L 0.08 35.99 L 0.17 32.86 L 0.31 30.22 L 0.48 27.92 L 0.70 25.84 L 0.95 23.95 L 1.24 22.21 L 1.57 20.58 L 1.94 19.07 L 2.35 17.65 L 2.80 16.31 L 3.30 15.05 L 3.83 13.86 L 4.41 12.73 L 5.03 11.67 L 5.69 10.66 L 6.40 9.71 L 7.15 8.81 L 7.96 7.96 L 8.81 7.15 L 9.71 6.40 L 10.66 5.69 L 11.67 5.03 L 12.73 4.41 L 13.86 3.83 L 15.05 3.30 L 16.31 2.80 L 17.65 2.35 L 19.07 1.94 L 20.58 1.57 L 22.21 1.24 L 23.95 0.95 L 25.84 0.70 L 27.92 0.48 L 30.22 0.31 L 32.86 0.17 L 35.99 0.08 L 40.09 0.02 L 50.00 0.00 L 59.91 0.02 L 64.01 0.08 L 67.14 0.17 L 69.78 0.31 L 72.08 0.48 L 74.16 0.70 L 76.05 0.95 L 77.79 1.24 L 79.42 1.57 L 80.93 1.94 L 82.35 2.35 L 83.69 2.80 L 84.95 3.30 L 86.14 3.83 L 87.27 4.41 L 88.33 5.03 L 89.34 5.69 L 90.29 6.40 L 91.19 7.15 L 92.04 7.96 L 92.85 8.81 L 93.60 9.71 L 94.31 10.66 L 94.97 11.67 L 95.59 12.73 L 96.17 13.86 L 96.70 15.05 L 97.20 16.31 L 97.65 17.65 L 98.06 19.07 L 98.43 20.58 L 98.76 22.21 L 99.05 23.95 L 99.30 25.84 L 99.52 27.92 L 99.69 30.22 L 99.83 32.86 L 99.92 35.99 L 99.98 40.09 Z";
}

// the settings button: the PanelOS mark on the app icon's shape (never a gear)
export component MarkButton inherits Rectangle {
    in property <length> size: 44px;
    callback clicked;
    width: self.size;
    height: self.size;
    property <float> sq: touch.pressed ? 0.95 : 1;
    animate sq { duration: touch.pressed ? 60ms : 180ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    Squircle { x: root.size * (1 - root.sq) / 2; y: self.x; width: root.size * root.sq; height: self.width; tone: touch.pressed ? Theme.button-pressed : Theme.button; }
    touch := TouchArea { clicked => { root.clicked(); } }
    LogoMark { x: (root.size - self.width) / 2; y: (root.size - self.height) / 2; size: root.size * 0.58; }
}

// the mark as a signal: its four parts light up one after another in Morse rhythm (dot, dash, dash, dot), each fading
// like an ember after it went out; the app drives `t` (seconds). Offline: slower, and the parts never fully dark.
export component MorseMark inherits Rectangle {
    in property <length> size: 120px;
    in property <float> t;
    in property <bool> slow;
    in property <color> dot-col: Theme.brand;
    in property <color> dash-col: Theme.text;
    property <length> u: self.size / 10;
    property <float> unit: root.slow ? 0.42 : 0.2;                 // one Morse unit in seconds
    property <float> ph: Math.mod(root.t / root.unit, 18);          // dot 1, gap 1, dash 3, gap 1, dash 3, gap 1, dot 1, pause 7
    property <float> base: root.slow ? 0.30 : 0.16;
    pure function lvl(start: float, len: float) -> float {
        root.ph < start ? 0.0 : root.ph < start + len ? 1.0 : max(0.0, 1.0 - (root.ph - start - len) / 3.0)
    }
    property <float> l0: root.lvl(0, 1);
    property <float> l1: root.lvl(2, 3);
    property <float> l2: root.lvl(6, 3);
    property <float> l3: root.lvl(10, 1);
    width: self.size;
    height: self.size;
    for e in [{ x: 0, y: 0, w: 2, dot: true, l: root.l0 }, { x: 4, y: 0, w: 6, dot: false, l: root.l1 },
              { x: 0, y: 4, w: 6, dot: false, l: root.l2 }, { x: 8, y: 4, w: 2, dot: true, l: root.l3 }]: Rectangle {
        property <color> c: e.dot ? root.dot-col : root.dash-col;
        x: e.x * root.u; y: (root.size - root.u * 6) / 2 + e.y * root.u; width: e.w * root.u; height: root.u * 2;
        Rectangle { x: -root.u * 1.6; y: -root.u * 1.6; width: parent.width + root.u * 3.2; height: parent.height + root.u * 3.2; border-radius: root.u * 2.6;
            background: parent.c.with-alpha(0.10 * e.l); }
        Rectangle { x: -root.u * 0.8; y: -root.u * 0.8; width: parent.width + root.u * 1.6; height: parent.height + root.u * 1.6; border-radius: root.u * 1.8;
            background: parent.c.with-alpha(0.22 * e.l); }
        Rectangle { border-radius: root.u; background: parent.c.with-alpha(root.base + (1 - root.base) * e.l); }
    }
}

// The page on screen and the quick shade's page row (spec 32.0): the page that is on screen fills in what the row
// shows ("Music settings", the look's name and its lead icon); the row asks that page to open its settings in the
// look's own menu by raising `open-request` (a page opens them when the count changes while it is on screen).
export global PageMenu {
    in-out property <string> title;
    in-out property <string> look;
    in-out property <string> icon;
    in-out property <bool> has-settings;
    in-out property <int> open-request;
}

// A look's menu (spec 32.0): the host places the menu and dims the page; the look draws the menu itself (its own
// object and motion) as this element's children.
// - kind 0, a picker: it hangs from the chip, right edge x 464, from y 48; kind 1, page settings: x 16-464, from y 48.
// - The menu grows to its content (`need`), up to y 468 (`max-h`, 420 px); beyond that the look scrolls its body.
// - The page dims to 30 % black (`deep`: 55 %) in 160 ms; a tap beside the menu calls close(). The chip again or a
//   Done button in the menu call the page's own close as well.
// - Motion clocks for the look, in ms since the menu opened / began to close: `t-in`, `t-out`. They run only while
//   the motion lasts (`in-ms`, `out-ms`), so a menu at rest draws no frames. `shown` stays true until `out-ms` after
//   the close. A menu opened again while it is leaving starts its entrance at once (the newer menu stays).
// - Retro looks (neon, synthwave, arcade) step in whole 40 ms frames: they read `t-in-40` / `t-out-40`.
// - The look's menu frame carries its own TouchArea (an empty one will do), so a tap on the menu is not a tap beside it.
export component MenuHost inherits Rectangle {
    in property <bool> open;
    in property <int> kind;
    in property <length> menu-w: root.kind == 0 ? 320px : 448px;
    in property <length> need: 200px;
    in property <bool> deep;
    in property <bool> dim: true;                 // false: a menu over another one (the page is dimmed once)
    in property <duration> in-ms: 400ms;
    in property <duration> out-ms: 200ms;
    callback close();
    out property <length> max-h: 420px;
    out property <length> menu-x: root.kind == 0 ? 464px - root.menu-w : 16px;
    out property <length> menu-y: 48px;
    out property <length> menu-h: Math.min(root.need, root.max-h);
    out property <bool> scrolls: root.need > root.max-h;
    out property <bool> shown: root.open || root.leaving;
    property <bool> entering;
    property <bool> leaving;
    property <duration> t0;
    property <duration> t1;
    changed open => {
        if root.open {
            root.leaving = false;
            root.t0 = animation-tick();
            root.entering = true;
        } else {
            root.entering = false;
            root.t1 = animation-tick();
            root.leaving = true;
        }
    }
    Timer { interval: root.in-ms; running: root.entering; triggered => { root.entering = false; } }
    Timer { interval: root.out-ms; running: root.leaving; triggered => { root.leaving = false; } }
    out property <float> t-in: root.entering ? (animation-tick() - root.t0) / 1ms : root.in-ms / 1ms;
    out property <float> t-out: root.leaving ? (animation-tick() - root.t1) / 1ms : (root.open ? 0 : root.out-ms / 1ms);
    out property <float> t-in-40: Math.floor(root.t-in / 40) * 40;
    out property <float> t-out-40: Math.floor(root.t-out / 40) * 40;
    // the dim: 160 ms in and out
    property <float> dk: root.open ? 1 : 0;
    animate dk { duration: 160ms; easing: ease-out; }
    visible: root.shown;
    x: 0; y: 0; width: 480px; height: 480px;
    Rectangle {
        background: #000000;
        opacity: root.dim ? (root.deep ? 0.55 : 0.30) * root.dk : 0;
    }
    TouchArea { enabled: root.open; clicked => { root.close(); } }
    @children
}

// Jelly motion (spec 28.15), closed-form in the time t (ms) since a change:
// edge: 1 − e^(−t/τ)·(cos ωt + sin ωt / (ωτ)), ω = 2π/T — starts at rest, overshoots, rings out;
// wobble: 1 + A·e^(−t/150)·cos(2πt/170) (the width; the height is 1/that, so the area stays);
// cap: a soft limit c·tanh(x/c) for an overshoot x.
export global Jelly {
    pure public function edge(t: float, tau: float, per: float) -> float {
        return t <= 0 ? 0 : 1 - Math.pow(2.71828, -t / tau) * (Math.cos(360deg * t / per) + Math.sin(360deg * t / per) / (6.28318 / per * tau));
    }
    pure public function wobble(t: float, a: float) -> float {
        return t <= 0 ? 1 : 1 + a * Math.pow(2.71828, -t / 150) * Math.cos(360deg * t / 170);
    }
    pure public function cap(x: float, c: float) -> float {
        // tanh(y) = (e^2y − 1) / (e^2y + 1)
        return x <= 0 ? x : c * (Math.pow(2.71828, 2 * x / c) - 1) / (Math.pow(2.71828, 2 * x / c) + 1);
    }
}

// A segmented control (spec 28.4, touch density): 40 px, 2 px padding, a 36 px pill; the chosen pill is the text
// colour and its label the ground colour (an icon in it Signal); the pill moves with jelly edges (28.15): the leading
// edge overshoots (soft-capped at 0.28 × its height), the trailing one follows 30 ms later; it thins while stretched and
// bulges when squashed. Options are equally wide.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <[string]> icons;
    in property <int> selected;
    callback picked(int);
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-raised: Theme.surface-raised;
    in property <color> tk-text: Theme.text;
    in property <color> tk-on-text: Theme.background;
    in property <color> tk-accent: Theme.accent;
    in property <color> tk-pill: root.tk-text;       // the pill, when a look gives it its own colour
    // the look's shape and letters: corners (-1: the control's own), font, size, weight, capitals
    in property <length> tk-radius: -1px;
    in property <string> tk-font;
    in property <length> tk-font-size: 15px;
    in property <int> tk-font-weight: 500;
    in property <bool> tk-caps;
    height: 40px;
    border-radius: root.tk-radius >= 0px ? root.tk-radius : 20px;
    background: root.tk-raised;
    property <int> n: Math.max(1, root.options.length);
    property <length> pad: 2px;
    property <length> seg: (root.width - 2 * root.pad) / root.n;
    property <length> ph: root.height - 2 * root.pad;
    // the motion: from where the pill was to the chosen one
    property <int> from: root.selected;
    property <duration> t0;
    property <bool> moving;
    changed selected => {
        root.t0 = animation-tick();
        root.moving = true;
    }
    Timer { interval: 760ms; running: root.moving; triggered => { root.moving = false; root.from = root.selected; } }
    property <float> t: root.moving ? (animation-tick() - root.t0) / 1ms : 2000;
    property <length> l0: root.pad + root.from * root.seg;
    property <length> l1: root.pad + root.selected * root.seg;
    property <bool> right: root.l1 > root.l0;
    property <length> d: root.l1 - root.l0;
    property <float> lead: Jelly.edge(root.t, 90, 240);
    property <float> trail: Jelly.edge(root.t - 30, 130, 340);
    // the edges: the leading one in the direction of travel, its overshoot soft-capped; both inside the control
    property <length> lead-raw: (root.right ? root.l0 + root.seg : root.l0) + root.d * root.lead;
    property <length> lead-target: root.right ? root.l1 + root.seg : root.l1;
    property <length> lead-over: root.right ? root.lead-raw - root.lead-target : root.lead-target - root.lead-raw;
    property <length> lead-e: root.lead-target + (root.right ? 1 : -1) * Jelly.cap(root.lead-over / 1px, 0.28 * root.ph / 1px) * 1px;
    property <length> trail-raw: (root.right ? root.l0 : root.l0 + root.seg) + root.d * root.trail;
    property <length> trail-target: root.right ? root.l1 : root.l1 + root.seg;
    property <length> trail-over: root.right ? root.trail-raw - root.trail-target : root.trail-target - root.trail-raw;
    property <length> trail-e: root.trail-target + (root.right ? 1 : -1) * Jelly.cap(root.trail-over / 1px, 0.21 * root.ph / 1px) * 1px;
    property <length> pl: Math.max(root.pad, root.right ? root.trail-e : root.lead-e);
    property <length> pr: Math.min(root.width - root.pad, root.right ? root.lead-e : root.trail-e);
    property <length> pw: root.moving ? Math.max(0.6 * root.seg, root.pr - root.pl) : root.seg;
    property <length> px: root.moving ? (root.pl + root.pr) / 2 - root.pw / 2 : root.l1;
    property <length> phh: root.moving ? Math.max(0.8 * root.ph, Math.min(root.height - 2px, root.ph * Math.sqrt(root.seg / Math.max(1px, root.pw)))) : root.ph;
    if root.selected >= 0: Rectangle { x: root.px; y: (root.height - root.phh) / 2; width: root.pw; height: root.phh; border-radius: root.tk-radius >= 0px ? Math.max(0px, root.tk-radius - root.pad) : self.height / 2; background: root.tk-pill; }
    for o[i] in root.options: seg-item := Rectangle {
        x: root.pad + i * root.seg; y: 0; width: root.seg; height: root.height;
        // the labels change colour 70 ms after the tap, over 160 ms
        property <bool> chosen: i == root.selected && root.t >= 70;
        property <float> ck: self.chosen || (i == root.selected && !root.moving) ? 1 : 0;
        animate ck { duration: 160ms; easing: ease-out; }
        HorizontalLayout {
            alignment: center; spacing: 6px;
            if i < root.icons.length && root.icons[i] != "": Icon { text: root.icons[i]; font-size: 18px; color: root.tk-text.mix(root.tk-accent, 1 - seg-item.ck); vertical-alignment: center; }
            Text { text: root.tk-caps ? o.to-uppercase() : o; font-family: root.tk-font; font-size: root.tk-font-size; font-weight: root.tk-font-weight;
                color: root.tk-text.mix(root.tk-on-text, 1 - seg-item.ck); vertical-alignment: center; overflow: elide; }
        }
        TouchArea { clicked => { root.picked(i); } }
    }
}

// A dropdown (spec 28.5, touch density): a 48 px raised field with the chosen name and a chevron; the menu (48 px rows,
// the chosen one with a Signal check and weight 600) opens over the page with a short fade and scale.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> placeholder: "None";
    in property <bool> up;                       // the menu opens above the field (a field low on the screen)
    callback picked(int);
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-raised: Theme.surface-raised;
    in property <color> tk-line: Theme.outline;
    in property <color> tk-text: Theme.text;
    in property <color> tk-muted: Theme.muted;
    in property <color> tk-menu: Theme.surface-raised;
    in property <color> tk-pressed: Theme.surface-pressed;
    in property <color> tk-accent: Theme.accent;
    // the look's shape and letters: corners (-1: the control's own), font, size, weight, capitals
    in property <length> tk-radius: -1px;
    in property <string> tk-font;
    in property <length> tk-font-size: 15px;
    in property <int> tk-font-weight: 500;
    in property <bool> tk-caps;
    height: 48px;
    border-radius: root.tk-radius >= 0px ? root.tk-radius : 14px;
    background: root.tk-raised;
    border-width: pop-open ? 1px : 0px;
    border-color: root.tk-accent.with-alpha(0.45);
    property <bool> pop-open;
    // the list stays on the screen between the status bar and the bottom edge (y 48-468): under the field, else above
    // it, else as far up as it must go (a long list may then cover its field)
    property <length> menu-h: Math.min(8, root.options.length) * 48px + 12px;
    property <bool> opens-up: root.up || root.absolute-position.y + root.height + 6px + root.menu-h > 480px;
    property <string> shown-text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : root.placeholder;
    Text { x: 16px; y: 0; width: parent.width - 52px; height: parent.height; text: root.tk-caps ? root.shown-text.to-uppercase() : root.shown-text;
        font-family: root.tk-font; font-size: root.tk-font-size; font-weight: root.tk-font-weight; color: root.selected >= 0 ? root.tk-text : root.tk-muted;
        vertical-alignment: center; overflow: elide; }
    Icon { x: parent.width - 36px; y: 0; width: 24px; height: parent.height; text: root.pop-open ? "\u{F0143}" : "\u{F0140}"; font-size: 22px; color: root.tk-muted; }
    TouchArea { clicked => { root.pop-open = true; menu.show(); } }
    // the popup's own size is the list's: Slint hit-tests a popup by its root, so a popup without a height takes no
    // taps (every press counts as outside and only closes it) and draws its list centred on a zero-high root
    menu := PopupWindow {
        x: 0;
        y: root.list-y - root.field-y;
        width: root.width;
        height: root.menu-h;
        close-policy: close-on-click-outside;
        Rectangle {
            x: 0; y: 0;
            property <float> k: 0;
            init => { self.k = 1; }
            animate k { duration: 140ms; easing: ease-out; }
            opacity: self.k;
            width: root.width;
            height: Math.min(8, root.options.length) * 48px + 12px;
            border-radius: root.tk-radius >= 0px ? root.tk-radius : 14px; background: root.tk-menu; border-width: 1px; border-color: root.tk-line;
            drop-shadow-blur: 16px; drop-shadow-color: #00000070;
            Flickable {
                x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
                content-height: root.options.length * 48px;
                for o[i] in root.options: Rectangle {
                    y: i * 48px; width: parent.width; height: 48px; border-radius: root.tk-radius >= 0px ? root.tk-radius : 10px;
                    background: row-ta.pressed ? root.tk-pressed : transparent;
                    if i == root.selected: Icon { x: 10px; y: 0; width: 22px; height: parent.height; text: "\u{F012C}"; font-size: 18px; color: root.tk-accent; }
                    Text { x: 40px; y: 0; width: parent.width - 50px; height: parent.height; text: root.tk-caps ? o.to-uppercase() : o; font-family: root.tk-font;
                        font-size: root.tk-font-size; font-weight: i == root.selected ? Math.max(600, root.tk-font-weight) : Math.min(400, root.tk-font-weight);
                        color: root.tk-text; vertical-alignment: center; overflow: elide; }
                    row-ta := TouchArea { clicked => { root.pop-open = false; menu.close(); root.picked(i); } }
                }
            }
        }
    }
}

// Three-way theme switch: 0 light, 1 dark, 2 auto (light sensor).
export component ThemeSwitch inherits Rectangle {
    in property <int> selected: 2;
    callback changed(int);
    height: 40px;
    min-width: 300px;
    Segmented {
        width: parent.width; height: parent.height;
        options: ["Light", "Dark", "Auto"];
        icons: ["\u{F05A8}", "\u{F0594}", "\u{F050E}"];
        selected: root.selected;
        picked(i) => { root.changed(i); }
    }
}

export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text;
    in property <length> size: 44px;
    callback clicked;
    width: self.size;
    height: self.size;
    property <float> sq: touch.pressed ? 0.95 : 1;
    animate sq { duration: touch.pressed ? 60ms : 180ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    Rectangle { x: root.size * (1 - root.sq) / 2; y: self.x; width: root.size * root.sq; height: self.width; border-radius: self.width / 2;
        background: touch.pressed ? Theme.button-pressed : Theme.button; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Icon {
        x: Glyph.nudge(root.icon, root.size * 0.55); width: parent.width; height: parent.height;
        text: root.icon;
        font-size: root.size * 0.55;
        color: root.tint;
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    in property <bool> danger: false;
    in property <bool> primary: false;
    callback clicked;
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-raised: Theme.surface-raised;
    in property <color> tk-pressed: Theme.surface-pressed;
    in property <color> tk-text: Theme.text;
    in property <color> tk-on-text: Theme.background;
    // the look's shape and letters: corners (-1: the control's own), font, size, weight, capitals
    in property <length> tk-radius: -1px;
    in property <string> tk-font;
    in property <length> tk-font-size: 16px;
    in property <int> tk-font-weight: 600;
    in property <bool> tk-caps;
    height: 48px;
    property <float> sq: touch.pressed ? 0.96 : 1;
    animate sq { duration: touch.pressed ? 60ms : 180ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    Rectangle {
        x: root.width * (1 - root.sq) / 2; y: root.height * (1 - root.sq) / 2; width: root.width * root.sq; height: root.height * root.sq;
        border-radius: root.tk-radius >= 0px ? root.tk-radius : self.height / 2;
        background: root.primary ? (touch.pressed ? root.tk-text.with-alpha(0.8) : root.tk-text) : (touch.pressed ? root.tk-pressed : root.tk-raised);
        Text {
            text: root.tk-caps ? root.text.to-uppercase() : root.text;
            font-family: root.tk-font;
            font-size: root.tk-font-size;
            font-weight: root.tk-font-weight;
            color: root.primary ? root.tk-on-text : root.danger ? (Theme.dark ? #FF6A4D : #C7361B) : root.tint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 40px;
    min-width: label.preferred-width + 28px;
    border-radius: 20px;
    background: root.selected ? Theme.accent.with-alpha(0.22) : (touch.pressed ? Theme.button-pressed : Theme.chip);
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.chip-border;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: 15px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One choice of several (spec 28.12/28.13: no choice chips): a segmented control for up to three short options, a
// dropdown otherwise; `selected` is an index (-1 = none).
export component ChipRow inherits Rectangle {
    in property <[string]> items;
    in property <int> selected: -1;
    callback picked(int);
    height: 48px;
    property <bool> seg: root.items.length <= 3 && root.items.length > 0;
    if root.seg: Segmented { y: 4px; width: parent.width; options: root.items; selected: root.selected; picked(i) => { root.picked(i); } }
    if !root.seg: Dropdown { width: parent.width; options: root.items; selected: root.selected; picked(i) => { root.picked(i); } }
}

// The switch (spec 28.3, 28.15): 56 × 32, a 24 px knob 4 px from the edge at rest; off: a raised track with a 1 px line
// drawn inside and a faint knob; on: Signal with a #F5F3EE knob. Pressing flattens the knob 7 px toward its travel; a
// flip moves its leading edge with the lead jelly edge (it stops at the inner wall, 3 px in, so it squashes there) and
// its trailing edge 30 ms later; the height keeps the area.
export component Toggle inherits Rectangle {
    in property <bool> on;
    callback toggled;
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-raised: Theme.surface-raised;
    in property <color> tk-line: Theme.outline;
    in property <color> tk-knob: Theme.faint;
    in property <color> tk-knob-on: #F5F3EE;
    in property <color> tk-accent: Theme.accent;
    width: 56px;
    height: 32px;
    border-radius: 16px;
    property <float> ck: root.on ? 1 : 0;
    animate ck { duration: 160ms; easing: ease-out; }
    background: root.tk-raised.mix(root.tk-accent, 1 - root.ck);
    // the outline, inside
    Rectangle { border-radius: parent.border-radius; border-width: 1px; border-color: root.tk-line.mix(root.tk-accent, 1 - root.ck); }
    property <length> kn: 24px;
    property <length> rest-l: root.on ? root.width - 4px - root.kn : 4px;
    property <length> from-l: root.on ? 4px : root.width - 4px - root.kn;
    property <duration> t0;
    property <bool> moving;
    changed on => { root.t0 = animation-tick(); root.moving = true; }
    Timer { interval: 720ms; running: root.moving; triggered => { root.moving = false; } }
    property <float> t: root.moving ? (animation-tick() - root.t0) / 1ms : 2000;
    property <length> d: root.rest-l - root.from-l;
    property <length> lead-e: (root.on ? root.from-l + root.kn : root.from-l) + root.d * Jelly.edge(root.t, 90, 240);
    property <length> trail-e: (root.on ? root.from-l : root.from-l + root.kn) + root.d * Jelly.edge(root.t - 30, 130, 340);
    property <length> wall-e: root.on ? Math.min(root.lead-e, root.width - 3px) : Math.max(root.lead-e, 3px);
    property <length> kl: root.on ? root.trail-e : root.wall-e;
    property <length> kr: root.on ? root.wall-e : root.trail-e;
    // pressing: 7 px toward the other side (90 ms)
    property <float> pk: ta.pressed ? 1 : 0;
    animate pk { duration: 90ms; easing: ease-out; }
    property <length> kw: root.moving ? Math.max(0.72 * root.kn, root.kr - root.kl) : root.kn + 7px * root.pk;
    property <length> kx: root.moving ? (root.kl + root.kr) / 2 - root.kw / 2 : (root.on ? root.rest-l - 7px * root.pk : root.rest-l);
    property <length> kh: Math.max(0.7 * root.kn, Math.min(root.height - 8px, root.kn * root.kn / root.kw));
    Rectangle { x: root.kx; y: (root.height - root.kh) / 2; width: root.kw; height: root.kh; border-radius: Math.min(self.width, self.height) / 2;
        background: root.tk-knob.mix(root.tk-knob-on, 1 - root.ck); }
    ta := TouchArea {
        clicked => { root.toggled(); }
    }
}

// A checkbox (spec 28.8, 28.15): 22 px, radius 6; off a 1.5 px faint border, on a Signal fill with a #F5F3EE tick; it
// pops and wobbles when ticked, dips when unticked
export component CheckBox inherits Rectangle {
    in property <bool> checked;
    callback toggled;
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-knob: Theme.faint;
    in property <color> tk-knob-on: #F5F3EE;
    in property <color> tk-accent: Theme.accent;
    width: 22px; height: 22px;
    property <duration> t0;
    property <bool> moving;
    changed checked => { root.t0 = animation-tick(); root.moving = true; }
    Timer { interval: 720ms; running: root.moving; triggered => { root.moving = false; } }
    property <float> t: root.moving ? (animation-tick() - root.t0) / 1ms : 2000;
    property <float> pop: !root.moving ? 1 : root.checked ? 0.6 + 0.4 * Jelly.edge(root.t, 90, 230) : 1 - 0.12 * Math.sin(180deg * Math.min(1, root.t / 120));
    property <float> wob: !root.moving ? 1 : Jelly.wobble(root.t, root.checked ? 0.22 : 0.12);
    property <float> tick: root.checked ? Math.max(0, Math.min(1, (root.t - 60) / 150)) : Math.max(0, 1 - root.t / 100);
    Rectangle {
        width: root.width * root.pop * root.wob; height: root.height * root.pop / root.wob;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        border-radius: 6px;
        background: root.checked ? root.tk-accent : transparent;
        border-width: root.checked ? 0px : 1.5px; border-color: root.tk-knob;
        if root.tick > 0.01: Path { width: parent.width; height: parent.height; viewbox-width: 22; viewbox-height: 22;
            stroke: root.tk-knob-on; stroke-width: 2.6px; stroke-line-cap: round; stroke-line-join: round;
            MoveTo { x: 5.5; y: 11.5; }
            LineTo { x: 5.5 + 4 * Math.min(1, root.tick * 2.2); y: 11.5 + 4 * Math.min(1, root.tick * 2.2); }
            LineTo { x: 9.5 + 7 * Math.max(0, root.tick * 1.8 - 0.8); y: 15.5 - 8 * Math.max(0, root.tick * 1.8 - 0.8); } }
    }
    TouchArea { clicked => { root.toggled(); } }
}

export global Brand {
    out property <bool> dark: Theme.dark;
    out property <color> signal: #FF4A1C;
    out property <color> night: #000000;
    out property <color> graphite: #121314;
    out property <color> ink: #101114;
    out property <color> paper: #F5F3EE;
    out property <color> bg: dark ? #000000 : #F5F3EE;
    out property <color> surface: dark ? #121314 : #FFFFFF;
    out property <color> raised: dark ? #1d1f21 : #EBE8E1;
    out property <color> text: dark ? #F5F3EE : #101114;
    out property <color> muted: dark ? #A3A19C : #5F5E5A;
    out property <color> line: dark ? #24262a : #DAD6CD;
    out property <color> pressed: dark ? #2a2c2f : #DEDAD1;
    out property <color> bad: dark ? #FF6A4D : #C7361B;
}

// the slider of the shared control set (spec 28.2, touch density): a 44 px row, a 6 px track (10 px while held) with a
// Signal fill and round caps, the thumb grows from nothing to 22 px while held, a bubble with the value above it (it
// stays 400 ms after the release, then fades); the ends stretch a little (6 px · (1 − e^(−d/40))) and bump
export component TouchSlider inherits Rectangle {
    // a gradient track (colour temperature, colour): 10 px, the thumb visible at rest
    in property <brush> gradient;
    in property <bool> has-gradient;
    in property <string> bubble-text;
    in property <float> value;
    callback changed(float, bool);
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-track: Brand.text.with-alpha(Brand.dark ? 0.14 : 0.12);
    in property <color> tk-accent: Brand.signal;
    in property <color> tk-knob: Brand.dark ? #F5F3EE : #FFFFFF;
    in property <color> tk-text: Brand.text;
    in property <color> tk-on-text: Brand.bg;
    property <float> drag-v;
    property <bool> held: touch.pressed;
    property <float> hk: root.held ? 1 : 0;
    animate hk { duration: root.held ? 120ms : 160ms; easing: ease-out; }
    // the value shown: the finger's while held (a first tap glides there in 180 ms), the app's otherwise
    property <float> shown-raw: root.held ? root.drag-v : root.value;
    property <bool> moving;
    property <float> shown: root.shown-raw;
    animate shown { duration: root.moving ? 0ms : 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
    // past the ends: the finger's overshoot in px, stretched
    property <length> over;
    property <length> band: (root.over >= 0px ? 1 : -1) * 6px * (1 - Math.pow(2.71828, -Math.abs(root.over / 40px)));
    animate band { duration: root.held ? 0ms : 220ms; easing: ease-out; }
    // the bubble: shown while held and 400 ms after
    property <bool> bubble;
    Timer { interval: 400ms; running: !root.held && root.bubble; triggered => { root.bubble = false; } }
    property <float> bk: root.held || root.bubble ? 1 : 0;
    animate bk { duration: root.held ? 80ms : 200ms; easing: ease-out; }
    height: 44px;
    property <length> th: root.has-gradient ? 10px : 6px + 4px * root.hk;
    property <length> tx: Math.min(0px, root.band);
    property <length> tw: root.width + Math.abs(root.band);
    // track and fill
    Rectangle {
        x: root.tx; y: (root.height - root.th) / 2; width: root.tw; height: root.th; border-radius: root.th / 2;
        background: root.has-gradient ? root.gradient : root.tk-track;
        if !root.has-gradient: Rectangle { x: 0; y: 0; width: Math.max(root.th, parent.width * root.shown); height: parent.height; border-radius: parent.border-radius;
            background: root.tk-accent; }
    }
    // the thumb
    property <length> kd: root.has-gradient ? 18px + 4px * root.hk : 22px * root.hk;
    if root.kd > 0.5px: Rectangle {
        x: root.tx + root.tw * root.shown - root.kd / 2; y: (root.height - root.kd) / 2; width: root.kd; height: root.kd; border-radius: root.kd / 2;
        background: root.tk-knob;
        drop-shadow-blur: 3px; drop-shadow-offset-y: 1px; drop-shadow-color: #00000059;
        border-width: 1px; border-color: #0000000f;
    }
    // the value bubble above the thumb
    if root.bk > 0.01: Rectangle {
        property <length> bw: bt.preferred-width + 16px;
        x: Math.max(-8px, Math.min(root.width - self.bw + 8px, root.tx + root.tw * root.shown - self.bw / 2)); y: -22px;
        width: self.bw; height: 24px; border-radius: 8px; background: root.tk-text; opacity: root.bk;
        bt := Text { text: root.bubble-text != "" ? root.bubble-text : Math.round(root.shown * 100) + "%"; font-size: 12px; font-weight: 600; color: root.tk-on-text; horizontal-alignment: center; vertical-alignment: center; }
    }
    touch := TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.moving = false;
                root.bubble = true;
                root.over = 0px;
                root.drag-v = Math.max(0.0, Math.min(1, self.mouse-x / self.width));
                root.changed(root.drag-v, false);
            } else if ev.kind == PointerEventKind.up {
                root.over = 0px;
                root.changed(root.drag-v, true);
            }
        }
        moved => {
            root.moving = true;
            root.over = self.mouse-x < 0px ? self.mouse-x : self.mouse-x > self.width ? self.mouse-x - self.width : 0px;
            root.drag-v = Math.max(0.0, Math.min(1, self.mouse-x / self.width));
            root.changed(root.drag-v, false);
        }
    }
}

// The details sheet's slider (spec 28.2): the label and the value in the row above the shared touch slider (6 px
// track, the thumb and a value bubble while held; gradient tracks 10 px with the thumb at rest).
export component BigSlider inherits VerticalLayout {
    in property <float> value;
    in property <string> title;
    in property <brush> track: Theme.button;
    in property <brush> fill: Theme.accent;
    in property <bool> show-fill: true;
    in property <int> unit: 0;
    in property <int> min-value: 0;
    in property <int> max-value: 100;
    callback changed(float);
    property <float> live: root.value;
    property <string> vtext: root.unit == 0 ? round(root.live * 100) + " %"
        : root.unit == 1 ? round(root.min-value + root.live * (root.max-value - root.min-value)) + " K" : "";
    spacing: 0;
    HorizontalLayout { height: 22px;
        Text { text: root.title; font-size: 15px; font-weight: 500; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: root.vtext; font-size: 14px; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; }
    }
    TouchSlider { value: root.value; has-gradient: !root.show-fill; gradient: root.track;
        bubble-text: root.unit == 1 ? root.vtext : root.unit == 2 ? " " : "";
        changed(v, final) => { root.live = v; if final { root.changed(v); } } }
}

// The weekday row (spec 28.10, 28.15): seven round toggles Mo-Su (40 px), raised with a muted letter; a chosen day is a
// disc in the look's colour with a ground-colour letter. Jelly: a press squashes the day to 1.08 x 0.92 (90 ms); choosing
// pops the disc from 0.4 (J-edge 90/260, x J-wobble 0.20), the day's ground wobbles 0.10 and its neighbours 0.05 40 ms
// later, the letter turns at 0.6; un-choosing swells the disc to 1.08 (60 ms) and drops it into the centre (120 ms), the
// ground wobbles 0.08 from 60 ms, the neighbours 0.04 from 100 ms. Done in 750 ms.
export component WeekdayRow inherits Rectangle {
    in property <[bool]> days;
    callback toggled(int);
    // the look's colours (spec 32.0 tokens); the defaults are the plain look's
    in property <color> tk-raised: Theme.surface-raised;
    in property <color> tk-muted: Theme.muted;
    in property <color> tk-text: Theme.text;          // the chosen day's disc
    in property <color> tk-on-text: Theme.background; // its letter
    in property <[string]> names: ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
    in property <string> family: "Noto Sans";
    in property <int> weight: 500;
    height: 40px;
    property <length> cell: 40px;
    property <length> step: (root.width - root.cell) / 6;
    // the last change: which day, chosen or not, when
    property <int> ci: -1;
    property <bool> cv;
    property <duration> t0;
    property <bool> moving;
    Timer { interval: 760ms; running: root.moving; triggered => { root.moving = false; } }
    property <float> t: root.moving ? (animation-tick() - root.t0) / 1ms : 2000;
    for d[i] in root.names: day := Rectangle {
        property <bool> on: i < root.days.length && root.days[i];
        property <bool> me: i == root.ci && root.moving;
        property <bool> next: (i == root.ci - 1 || i == root.ci + 1) && root.moving;
        // the ground's wobble (width; the height keeps the area)
        property <float> gw: day.me ? (root.cv ? Jelly.wobble(root.t, 0.10) : (root.t < 60 ? 1 : Jelly.wobble(root.t - 60, 0.08)))
            : day.next ? (root.cv ? (root.t < 40 ? 1 : Jelly.wobble(root.t - 40, 0.05)) : (root.t < 100 ? 1 : Jelly.wobble(root.t - 100, 0.04))) : 1;
        // the disc's size: popping in, or swelling and dropping out
        property <float> ds: !day.me ? (day.on ? 1 : 0)
            : root.cv ? (0.4 + 0.6 * Jelly.edge(root.t, 90, 260)) * Jelly.wobble(root.t, 0.20)
            : root.t < 60 ? 1 + 0.08 * root.t / 60 : 1.08 * Math.max(0, 1 - Math.pow((root.t - 60) / 120, 2));
        property <bool> lit: day.me ? (root.cv ? day.ds > 0.6 : day.ds > 0.6) : day.on;
        // pressing: 1.08 x 0.92 (90 ms)
        property <float> pk: dta.pressed ? 1 : 0;
        animate pk { duration: 90ms; easing: ease-out; }
        property <float> sx: day.gw * (1 + 0.08 * day.pk);
        property <float> sy: (1 / day.gw) * (1 - 0.08 * day.pk);
        x: i * root.step; y: 0; width: root.cell; height: root.cell;
        Rectangle {
            width: root.cell * day.sx; height: root.cell * day.sy; x: (root.cell - self.width) / 2; y: (root.cell - self.height) / 2;
            border-radius: Math.min(self.width, self.height) / 2; background: root.tk-raised;
        }
        if day.ds > 0.01: Rectangle {
            width: root.cell * day.sx * Math.min(1.3, day.ds); height: root.cell * day.sy * Math.min(1.3, day.ds);
            x: (root.cell - self.width) / 2; y: (root.cell - self.height) / 2;
            border-radius: Math.min(self.width, self.height) / 2; background: root.tk-text;
        }
        Text { text: d; font-family: root.family; font-size: 13px; font-weight: root.weight; color: day.lit ? root.tk-on-text : root.tk-muted;
            horizontal-alignment: center; vertical-alignment: center; }
        dta := TouchArea {
            clicked => {
                root.ci = i;
                root.cv = !day.on;
                root.t0 = animation-tick();
                root.moving = true;
                root.toggled(i);
            }
        }
    }
}
