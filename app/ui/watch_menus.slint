// The stopwatch tab's only menu (spec 36): the page's settings in the stopwatch look's own object (plain: the brand
// card, chronograph: the watch's steel case back, timing tower: the race timing board, LCD watch: its case and LCD lit by
// LIGHT, nixie: a walnut base with a brass plate and amber writing): functions, colours, the stopwatch look. The
// stopwatch shows durations, so it has no time format.
import { Theme, Act } from "theme.slint";
import { MenuHost, Segmented, Dropdown, TextButton } from "widgets.slint";
import { MenuInk, LookInk, MenuMotion, SetRow, FunctionChecks, InkText } from "alarm_menus.slint";

// One row of the settings: the timing tower draws it as a tower row (a dark strip with a coloured left edge).
component WatchRow inherits Rectangle {
    in property <int> look;
    in property <color> edge;
    in property <float> k: 1;              // sliding in: from 60 px to the right with a fade
    opacity: root.k;
    height: lay.preferred-height;
    if root.look == 2: Rectangle { x: 60px * (1 - root.k); border-radius: 4px; background: #14161b;
        Rectangle { x: 0; width: 3px; border-top-left-radius: 4px; border-bottom-left-radius: 4px; background: root.edge; } }
    lay := VerticalLayout {
        x: 60px * (1 - root.k);
        padding-left: root.look == 2 ? 12px : 0px; padding-right: root.look == 2 ? 12px : 0px;
        padding-top: root.look == 2 ? 2px : 0px; padding-bottom: root.look == 2 ? 4px : 0px;
        @children
    }
}

export component WatchSettings inherits Rectangle {
    in-out property <bool> open;
    in property <int> look;
    in property <bool> alarm-on;
    in property <bool> timer-on;
    in property <bool> watch-on;
    in property <bool> colourful;
    width: 480px; height: 480px;
    property <int> lk: root.look;
    changed open => { if root.open { root.lk = root.look; } }
    property <MenuInk> ink: LookInk.watch(root.lk);
    property <bool> caps: root.lk != 0;
    property <color> emboss: root.lk == 1 ? #ffffff80 : transparent;
    // a new look: the menu goes, then comes back as the new look's menu
    property <bool> reopen;
    Timer { interval: 300ms; running: root.reopen && !root.open; triggered => { root.reopen = false; root.open = true; } }
    // the frame's parts around the rows: where they start and end
    property <length> top: root.lk == 1 ? 20px + 44px : root.lk == 2 ? 46px : root.lk == 3 ? 10px + 22px + 10px + 30px : root.lk == 4 ? 16px + 38px : 52px;
    property <length> bottom: root.lk == 1 ? 14px : root.lk == 2 ? 12px : root.lk == 3 ? 12px + 22px + 10px : root.lk == 4 ? 14px : 16px;
    property <length> side: root.lk == 1 ? 22px : root.lk == 2 ? 10px : root.lk == 3 ? 12px + 14px : root.lk == 4 ? 18px : 16px;
    host := MenuHost {
        open: root.open; kind: 1;
        need: root.top + body.preferred-height + root.bottom;
        in-ms: root.lk == 0 ? 140ms : root.lk == 1 ? 700ms : root.lk == 2 ? 400ms : root.lk == 3 ? 1200ms : 520ms;
        out-ms: root.lk == 0 ? 100ms : root.lk == 1 ? 180ms : root.lk == 2 ? 140ms : root.lk == 3 ? 160ms : 200ms;
        close => { root.open = false; }
        property <float> ti: self.t-in;
        property <float> to: self.t-out;
        property <bool> leaving: !root.open;
        property <float> hh: self.menu-h / 1px;
        // chronograph and LCD drop in stiffly and leave upwards; the tower fades in and its rows slide in; the nixie base
        // opens from the plate down
        property <float> dy: root.lk == 1 ? (self.leaving ? -(self.hh + 60) * MenuMotion.ei(self.to / 180) : MenuMotion.drop(self.ti, 70, 240, 3, self.hh))
            : root.lk == 3 ? (self.leaving ? -(self.hh + 60) * MenuMotion.ei(self.to / 160) : MenuMotion.drop(self.ti, 60, 200, 2, self.hh)) : 0;
        property <float> dx: root.lk == 2 && self.leaving ? 30 * MenuMotion.ei(self.to / 140) : 0;
        property <float> fade: root.lk == 0 ? (self.leaving ? 1 - self.to / 100 : MenuMotion.eo(self.ti / 140))
            : root.lk == 2 ? (self.leaving ? 1 - self.to / 140 : Math.min(1, self.ti / 100)) : 1;
        property <float> reveal: root.lk == 4 ? (self.leaving ? 1 - MenuMotion.ei(self.to / 200) : MenuMotion.eo(self.ti / 240)) : 1;
        // the moment it seats (the J-edge drop's first landing)
        property <float> seat: root.lk == 1 ? 168 : 144;
        // chronograph: the glint sweeps across after it seats (420 ms)
        property <float> glint: root.lk == 1 && !self.leaving && self.ti > self.seat ? MenuMotion.eo((self.ti - self.seat) / 420) : -1;
        // LCD: blank while it slides, then lit teal, fading back to grey over 1 s; its writing comes in with an LCD's lag
        property <float> lit: root.lk == 3 && !self.leaving ? (self.ti < self.seat ? 0 : Math.max(0, 1 - (self.ti - self.seat) / 1000)) : 0;
        property <float> lcd-ink: root.lk == 3 && !self.leaving ? (self.ti < self.seat ? 0 : Math.min(1, (self.ti - self.seat) / 60)) : 1;
        // nixie: the writing dim (12 %) while the base opens, then it warms up: 90 %, 20 %, 100 % in 40 ms steps
        property <float> warm: root.lk != 4 || self.leaving ? 1 : self.ti < 240 ? 0.12 : self.ti < 280 ? 0.9 : self.ti < 320 ? 0.2 : 1;
        property <float> writing: root.lk == 4 ? self.warm : root.lk == 3 ? self.lcd-ink : 1;
        Rectangle {
            x: host.menu-x - 30px; y: host.menu-y;
            width: host.menu-w + 60px; height: root.lk == 4 ? host.menu-h * host.reveal : host.menu-h + 40px;
            clip: root.lk == 4;
            opacity: host.fade;
            frame := Rectangle {
                x: 30px + host.dx * 1px; y: host.dy * 1px; width: host.menu-w; height: host.menu-h;
                // plain: the brand settings card
                if root.lk == 0: Rectangle { border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.outline;
                    drop-shadow-blur: 24px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000073; }
                if root.lk == 0: Text { x: 16px; y: 12px; height: 32px; text: "Alarms & timers"; font-family: "Space Grotesk"; font-size: 20px; font-weight: 500;
                    color: Theme.text; vertical-alignment: center; }
                // chronograph: brushed steel, an engraved double ring, four screw lugs, engraved print
                if root.lk == 1: Rectangle { border-radius: 24px; drop-shadow-blur: 28px; drop-shadow-offset-y: 14px; drop-shadow-color: #0000008c;
                    background: @linear-gradient(135deg, #9ea3a8 0%, #dfe2e5 35%, #8d9297 62%, #c9cdd0 100%);
                    Rectangle { x: 10px; y: 2px; width: parent.width - 20px; height: parent.height - 4px; clip: true; cache-rendering-hint: true;
                        for b in 146: Rectangle { x: b * 3px; y: 0; width: 1px; height: parent.height; background: #ffffff0d; } }
                    Rectangle { border-radius: 24px; border-width: 2px; border-color: #00000033; }
                    Rectangle { x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px; border-radius: 19px; border-width: 2px; border-color: #ffffff38; }
                    Rectangle { x: 7px; y: 7px; width: parent.width - 14px; height: parent.height - 14px; border-radius: 17px; border-width: 1px; border-color: #0000001f; }
                    for l in [{ x: 12, y: 12, a: 30 }, { x: -24, y: 12, a: -40 }, { x: 12, y: -24, a: 75 }, { x: -24, y: -24, a: 10 }]: Rectangle {
                        x: l.x < 0 ? parent.width + l.x * 1px : l.x * 1px; y: l.y < 0 ? parent.height + l.y * 1px : l.y * 1px; width: 12px; height: 12px;
                        border-radius: 6px; background: @radial-gradient(circle, #eef0f2 0%, #7d8288 100%);
                        drop-shadow-blur: host.ti > host.seat || host.leaving ? 0px : 2px; drop-shadow-offset-y: 1px; drop-shadow-color: #00000066;
                        Path { x: -0.6px; y: -0.6px; width: 13.2px; height: 13.2px; viewbox-width: 12; viewbox-height: 12; stroke: #0000008c; stroke-width: 1.2px;
                            commands: "M " + (6 - 4 * Math.cos(l.a * 1deg)) + " " + (6 - 4 * Math.sin(l.a * 1deg)) + " L " + (6 + 4 * Math.cos(l.a * 1deg)) + " " + (6 + 4 * Math.sin(l.a * 1deg)); } }
                    // the glint: a white band at an angle sweeping across from left to right
                    if host.glint >= 0 && host.glint < 1: Rectangle { clip: true; border-radius: 24px;
                        Path { x: (-0.4 + 1.6 * host.glint) * parent.width - 70px; y: 0; width: 140px; height: parent.height; viewbox-width: 140; viewbox-height: 100;
                            fill: #ffffff99; opacity: 1 - host.glint * 0.3; commands: "M 60 0 L 134 0 L 80 100 L 6 100 Z"; } }
                }
                if root.lk == 1: InkText { x: 40px; y: 20px; width: parent.width - 80px; text: "SETTINGS"; ink: #262a2f; size: 15px; weight: 700; spacing: 3px;
                    emboss: #ffffff99; align: center; }
                if root.lk == 1: InkText { x: 40px; y: 42px; width: parent.width - 80px; text: "STAINLESS STEEL · WATER RESISTANT 50 M"; ink: #4b5056; size: 8.5px;
                    weight: 700; spacing: 1.5px; emboss: #ffffff80; align: center; }
                // timing tower: the black board, a purple header stripe with a green LIVE tag
                if root.lk == 2: Rectangle { border-radius: 10px; background: #0b0c0f; border-width: 1px; border-color: #ffffff0f;
                    drop-shadow-blur: 28px; drop-shadow-offset-y: 14px; drop-shadow-color: #00000099;
                    Rectangle { x: 0; y: 0; width: parent.width; height: 36px; border-top-left-radius: 10px; border-top-right-radius: 10px;
                        background: @linear-gradient(90deg, #a24bff 0%, #6a2bd1 100%);
                        Text { x: 14px; text: "SETTINGS"; font-size: 14px; font-weight: 800; font-italic: true; letter-spacing: 2px; color: #ffffff; vertical-alignment: center; }
                        Rectangle { x: parent.width - 14px - 40px; y: 10px; width: 40px; height: 17px; border-radius: 3px; background: #22c55e;
                            Text { text: "LIVE"; font-size: 10px; font-weight: 800; letter-spacing: 1px; color: #04140a; horizontal-alignment: center; vertical-alignment: center; } } } }
                // LCD watch: the black resin case with its printed button names, the grey-green LCD inside
                if root.lk == 3: Rectangle { border-radius: 28px; background: @linear-gradient(180deg, #1c1d20 0%, #0e0f10 100%);
                    drop-shadow-blur: 28px; drop-shadow-offset-y: 14px; drop-shadow-color: #00000099;
                    Rectangle { border-radius: 28px; border-width: 2px; border-color: #2a2b2f; }
                    for p in [{ t: "LIGHT", r: false, b: false, c: #e8a33c }, { t: "START·STOP", r: true, b: false, c: #b9bcc2 },
                              { t: "MODE", r: false, b: true, c: #b9bcc2 }, { t: "LAP·RESET", r: true, b: true, c: #b9bcc2 }]: Text {
                        x: p.r ? parent.width - 22px - 120px : 22px; y: p.b ? parent.height - 10px - 22px : 10px; width: 120px; height: 22px; text: p.t;
                        font-size: 9px; font-weight: 700; letter-spacing: 1.5px; color: p.c; vertical-alignment: center;
                        horizontal-alignment: p.r ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    Rectangle { x: 12px; y: 32px; width: parent.width - 24px; height: parent.height - 64px; border-radius: 12px;
                        background: #c0c8a6.mix(#86e3d4, 1 - host.lit);
                        Rectangle { border-radius: 12px; background: @linear-gradient(160deg, #ffffff2e 0%, #ffffff00 50%, #0000000f 100%); }
                        Rectangle { x: 12px; y: 0; width: parent.width - 24px; height: 4px; background: #00000026; }
                        Rectangle { x: 14px; y: 10px; width: parent.width - 28px; height: 24px; opacity: host.lcd-ink;
                            Text { x: 0; width: 120px; text: "SET"; font-size: 16px; font-weight: 800; letter-spacing: 3px; color: #1e2418;
                                horizontal-alignment: left; vertical-alignment: center; }
                            Text { x: parent.width - 60px; width: 60px; text: "CHR"; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: #1e2418b3;
                                horizontal-alignment: right; vertical-alignment: center; }
                            Rectangle { y: parent.height + 2px; height: 2px; background: #1e2418b3; } } } }
                // nixie: walnut under a dark veil, a soft inner shadow, the brass plate with SETTINGS engraved
                if root.lk == 4: Rectangle { border-radius: 16px; clip: true; drop-shadow-blur: 28px; drop-shadow-offset-y: 14px; drop-shadow-color: #00000099;
                    Image { x: 0; y: 0; width: 448px; height: 400px; source: @image-url("timers/sw/menu-walnut.png"); }
                    Rectangle { border-radius: 16px; border-width: 6px; border-color: #00000040; }
                    Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: #ffdcaa26; } }
                if root.lk == 4: Rectangle { x: (parent.width - 132px) / 2; y: 16px; width: 132px; height: 26px; border-radius: 4px;
                    background: @linear-gradient(180deg, #e6c47c 0%, #b48a40 55%, #8f6a2c 100%); drop-shadow-blur: 4px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000080;
                    Rectangle { x: 4px; y: 0; width: parent.width - 8px; height: 1px; background: #fff0c899; }
                    Text { y: 1px; text: "SETTINGS"; font-size: 12px; font-weight: 700; letter-spacing: 3px; color: #ffebbe59; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "SETTINGS"; font-size: 12px; font-weight: 700; letter-spacing: 3px; color: #3a2a10; horizontal-alignment: center; vertical-alignment: center; } }
                TouchArea { }
                Flickable {
                    x: root.side; y: root.top; width: parent.width - 2 * root.side; height: parent.height - root.top - root.bottom;
                    content-height: body.preferred-height; interactive: host.scrolls;
                    opacity: host.writing;
                    body := VerticalLayout {
                        width: parent.width;
                        spacing: root.lk == 2 ? 4px : 0px;
                        // the tower's rows slide in from the right one after another (40 ms apart, 180 ms each)
                        WatchRow { look: root.lk; edge: #a24bff; k: root.lk == 2 && !host.leaving ? MenuMotion.eo((host.ti - 60) / 180) : 1;
                            SetRow { label: root.caps ? "FUNCTIONS" : "Functions"; ink: root.ink; emboss: root.emboss;
                                FunctionChecks { ink: root.ink; alarm-on: root.alarm-on; timer-on: root.timer-on; watch-on: root.watch-on; caps: root.caps; } } }
                        WatchRow { look: root.lk; edge: #22c55e; k: root.lk == 2 && !host.leaving ? MenuMotion.eo((host.ti - 100) / 180) : 1;
                            SetRow { label: root.caps ? "COLOURS" : "Colours"; ink: root.ink; emboss: root.emboss;
                                Segmented { options: ["Colourful", "One colour"]; selected: root.colourful ? 0 : 1;
                                    tk-raised: root.ink.raised; tk-text: root.ink.text; tk-pill: root.ink.pill; tk-on-text: root.ink.on-text; tk-accent: root.ink.accent;
                                    picked(i) => { Act.act("alarms.colourful", i == 0 ? "1" : "0"); } } } }
                        WatchRow { look: root.lk; edge: #f5c518; k: root.lk == 2 && !host.leaving ? MenuMotion.eo((host.ti - 140) / 180) : 1;
                            SetRow { label: root.caps ? "STOPWATCH LOOK" : "Stopwatch look"; ink: root.ink; emboss: root.emboss;
                                Dropdown { options: ["Plain", "Chronograph", "Timing tower", "LCD watch", "Nixie"]; selected: root.lk;
                                    tk-raised: root.ink.raised; tk-line: root.ink.line; tk-text: root.ink.text; tk-muted: root.ink.muted; tk-menu: root.ink.menu;
                                    tk-pressed: root.ink.pressed; tk-accent: root.ink.accent;
                                    picked(i) => { if i != root.lk { Act.act("watch.look", i); root.open = false; root.reopen = true; } } } } }
                        WatchRow { look: 0; k: root.lk == 2 && !host.leaving ? MenuMotion.eo((host.ti - 180) / 180) : 1;
                            HorizontalLayout { padding-top: 8px; padding-right: root.lk == 2 ? 2px : 0px;
                                Rectangle { horizontal-stretch: 1; }
                                TextButton { width: 116px; text: "Done"; primary: true; tk-text: root.ink.save; tk-on-text: root.ink.on-save; clicked => { root.open = false; } } } }
                    }
                }
            }
        }
    }
}
