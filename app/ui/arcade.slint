// The arcade screen (spec 33.4): the menus of the neon looks (the thermostat's neon look, the timers' synthwave look, the
// home page's synthwave background) come up on one small CRT in the scene's colour. Everything on it moves in whole
// 40 ms frames (no springs, no easing, no squash); the screen's own switch-on and switch-off are drawn at 30 frames
// per second (whole 33 ms steps).
//
// - ArcadeScreen: the glass with its scanlines, the tube border with its glow, the chrome title, an optional
//   "CREDIT 99 · © PANELOS" foot; the content goes in as children, placed in the body (`body-x`, `body-y`, `body-w`).
// - ArcadeBlocks: a single choice as words in the pixel font; the current one is an inverse block in the tube colour.
//   Blocks wrap to a new line instead of cutting.
// - ArcadeBlock: one action block (Done, +1 MIN, PAUSE, i …): filled with the tube colour, or a dim fill (`fill`) that
//   lights up when pressed.
// - ArcadeText: the pixel font with a soft glow; it wraps.
// The software renderer draws gradients without rounded corners, so the glass is made of bands and corner pieces.

export global Arcade {
    // the rows' own arcade colours (the rooms list), the dark ink on a lit block, the font
    out property <[color]> rows: [#ff4fd8, #ffd23f, #2bffc6, #22d8ff, #c27bff, #ff7a3d, #7dff6a, #ff5c8a];
    out property <color> ink: #14062a;
    out property <string> font: "Press Start 2P";
    // a label of `n` characters in the pixel font (monospaced: every glyph is one em wide), with its letter spacing
    pure public function text-w(n: int, size: length) -> length {
        return n * (size + 0.4px);
    }
}

// The pixel font with a soft glow around the letters (four copies under them); long text wraps.
export component ArcadeText {
    in property <string> text;
    in property <length> font-size: 9px;
    in property <color> color: #ffffffbf;
    in property <color> glow: transparent;
    in property <float> glow-k: 0.35;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <TextVerticalAlignment> vertical-alignment: center;
    in property <TextWrap> wrap: word-wrap;
    preferred-width: t.preferred-width;
    preferred-height: t.preferred-height;
    min-height: t.preferred-height;
    for o in [{ x: -1.5, y: 0 }, { x: 1.5, y: 0 }, { x: 0, y: -1.5 }, { x: 0, y: 1.5 }]: Text {
        visible: root.glow.alpha > 0;
        x: o.x * 1px; y: o.y * 1px; width: root.width; height: root.height;
        text: root.text; font-family: Arcade.font; font-size: root.font-size; letter-spacing: 0.4px;
        color: root.glow.with-alpha(root.glow-k); wrap: root.wrap;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: root.vertical-alignment;
    }
    t := Text {
        width: root.width; height: root.height;
        text: root.text; font-family: Arcade.font; font-size: root.font-size; letter-spacing: 0.4px;
        color: root.color; wrap: root.wrap;
        horizontal-alignment: root.horizontal-alignment; vertical-alignment: root.vertical-alignment;
    }
}

// a vertical gradient in a rounded box (top colour to bottom colour), drawn as three bands and four corner pieces
component RoundedGlass inherits Rectangle {
    in property <color> top;
    in property <color> bottom;
    in property <length> radius: 16px;
    property <float> rk: root.height > 0px ? root.radius / root.height : 0;
    property <color> c-top: root.top.mix(root.bottom, 1 - root.rk / 2);
    property <color> c-bot: root.bottom.mix(root.top, 1 - root.rk / 2);
    Rectangle { x: root.radius; y: 0; width: root.width - 2 * root.radius; height: root.radius;
        background: @linear-gradient(180deg, root.top 0%, root.top.mix(root.bottom, 1 - root.rk) 100%); }
    Rectangle { x: 0; y: root.radius; width: root.width; height: root.height - 2 * root.radius;
        background: @linear-gradient(180deg, root.top.mix(root.bottom, 1 - root.rk) 0%, root.bottom.mix(root.top, 1 - root.rk) 100%); }
    Rectangle { x: root.radius; y: root.height - root.radius; width: root.width - 2 * root.radius; height: root.radius;
        background: @linear-gradient(180deg, root.bottom.mix(root.top, 1 - root.rk) 0%, root.bottom 100%); }
    for c in [{ x: 0, y: 0, p: "M 0 10 A 10 10 0 0 1 10 0 L 10 10 Z", b: false }, { x: 1, y: 0, p: "M 0 0 A 10 10 0 0 1 10 10 L 0 10 Z", b: false },
              { x: 0, y: 1, p: "M 0 0 L 10 0 L 10 10 A 10 10 0 0 1 0 0 Z", b: true }, { x: 1, y: 1, p: "M 0 0 L 10 0 A 10 10 0 0 1 0 10 Z", b: true }]: Path {
        x: c.x * (root.width - root.radius); y: c.y * (root.height - root.radius); width: root.radius; height: root.radius;
        viewbox-width: 10; viewbox-height: 10; commands: c.p; fill: c.b ? root.c-bot : root.c-top;
    }
}

// The CRT: glass #1a0938 → #060210 at 93–95 %, scanlines (1 px of 26 % black every 3 px), a 2 px tube border in the
// scene's colour mixed with 28 % white with an outer and an inner glow, radius 16; the chrome title in the pixel font
// (white → ice blue → the scene's colour → pale pink) with a glow. Switching on: a white line lights across the
// middle (90 ms), opens to the full screen (160 ms) under a flash that fades from 55 %, the picture flickers in.
// Switching off: the picture collapses to a line (110 ms), the line to a dot that fades (90 ms).
export component ArcadeScreen inherits Rectangle {
    in property <color> tube: #ff2bd6;
    in property <string> title;
    in property <bool> foot;                        // "CREDIT 99" / "© PANELOS" under the body
    // the motion clocks (MenuHost: t-in / t-out in ms): `leaving` from the moment the screen starts to switch off
    in property <float> t-in: 1000;
    in property <float> t-out;
    in property <bool> leaving;
    out property <length> pad-x: 16px;
    out property <length> head-h: 12px + 4px + title-t.preferred-height + 12px;
    out property <length> foot-h: root.foot ? 9px + 10px + 10px : 10px;
    out property <length> body-x: root.pad-x;
    out property <length> body-y: root.head-h;
    out property <length> body-w: root.width - 2 * root.pad-x;
    out property <length> body-h: root.height - root.head-h - root.foot-h;
    out property <length> radius: 16px;
    // the motion, in whole 33 ms steps
    property <float> tq-in: Math.floor(root.t-in / 33) * 33;
    property <float> tq-out: Math.floor(root.t-out / 33) * 33;
    pure function eo(u: float) -> float { return 1 - Math.pow(1 - clamp(u, 0, 1), 3); }
    pure function ei(u: float) -> float { return Math.pow(clamp(u, 0, 1), 3); }
    property <length> half: root.height / 2 - 1px;
    // the visible window of the picture (insets from each side)
    property <length> ix: root.leaving ? (root.tq-out < 110 ? 0px : (root.width / 2 - 2px) * root.ei((root.tq-out - 110) / 90))
        : (root.tq-in < 90 ? root.width / 2 * (1 - root.eo(root.tq-in / 90)) : 0px);
    property <length> iy: root.leaving ? (root.tq-out < 110 ? root.half * root.ei(root.tq-out / 110) : root.half)
        : (root.tq-in < 90 ? root.half : root.half * (1 - root.eo((root.tq-in - 90) / 160)));
    property <float> flash: root.leaving ? (root.tq-out < 110 ? 0.7 * root.ei(root.tq-out / 110) : 0.7)
        : (root.tq-in < 90 ? 1 : 0.55 * (1 - clamp((root.tq-in - 90) / 170, 0, 1)));
    property <float> fade: root.leaving && root.tq-out >= 110 ? 1 - root.ei((root.tq-out - 110) / 90) : 1;
    // the picture: hidden while the tube warms up, a flicker (on, off for a step, on), hidden while switching off
    property <bool> picture: !root.leaving && ((root.tq-in >= 165 && root.tq-in < 198) || root.tq-in >= 231);
    property <bool> settled: !root.leaving && root.tq-in >= 250;
    property <color> line: root.tube.mix(#ffffff, 0.72);

    // the outer glow, once the screen is open
    for g[i] in [{ d: 2, a: 0.30 }, { d: 4, a: 0.14 }, { d: 6, a: 0.06 }]: Rectangle {
        visible: root.settled;
        x: -g.d * 1px; y: -g.d * 1px; width: root.width + 2 * g.d * 1px; height: root.height + 2 * g.d * 1px;
        border-radius: root.radius + g.d * 1px; border-width: 2px; border-color: root.tube.with-alpha(g.a);
    }
    win := Rectangle {
        x: root.ix; y: root.iy; width: root.width - 2 * root.ix; height: Math.max(2px, root.height - 2 * root.iy);
        clip: !root.settled;
        opacity: root.fade;
        Rectangle {
            x: -root.ix; y: -root.iy; width: root.width; height: root.height;
            RoundedGlass { width: parent.width; height: parent.height; radius: root.radius; top: #1a0938ed; bottom: #060210f2; }
            // the picture
            Rectangle {
                visible: root.picture;
                // the chrome title: the same text clipped into 1 px bands, each in its colour of the chrome
                Rectangle {
                    x: root.pad-x; y: 16px; width: root.width - 2 * root.pad-x; height: title-t.preferred-height;
                    for o in [{ x: -2, y: 0 }, { x: 2, y: 0 }, { x: 0, y: -2 }, { x: 0, y: 2 }]: Text {
                        x: o.x * 1px; y: o.y * 1px; width: parent.width; height: parent.height;
                        text: root.title; font-family: Arcade.font; font-size: 15px; letter-spacing: 1px; wrap: word-wrap;
                        horizontal-alignment: center; color: root.tube.with-alpha(0.30);
                    }
                    title-t := Text {
                        visible: false;
                        width: parent.width; text: root.title; font-family: Arcade.font; font-size: 15px; letter-spacing: 1px; wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    for i in Math.min(64, Math.ceil(title-t.preferred-height / 1px)): Rectangle {
                        property <float> f: (i + 0.5) / Math.max(1, title-t.preferred-height / 1px);
                        y: i * 1px; height: 1px; width: parent.width; clip: true;
                        Text {
                            y: -i * 1px; width: parent.width; height: title-t.preferred-height;
                            text: root.title; font-family: Arcade.font; font-size: 15px; letter-spacing: 1px; wrap: word-wrap;
                            horizontal-alignment: center;
                            color: parent.f < 0.42 ? #ffffff.mix(#c4f1ff, 1 - parent.f / 0.42)
                                : parent.f < 0.54 ? #c4f1ff.mix(root.tube, 1 - (parent.f - 0.42) / 0.12)
                                : root.tube.mix(#ffe0f6, 1 - (parent.f - 0.54) / 0.46);
                        }
                    }
                }
                Rectangle {
                    x: root.body-x; y: root.body-y; width: root.body-w; height: root.body-h;
                    @children
                }
                if root.foot: Rectangle {
                    x: root.pad-x + 2px; y: root.height - 10px - 10px; width: root.width - 2 * root.pad-x - 4px; height: 10px;
                    Text { x: 0; width: parent.width; text: "CREDIT 99"; font-family: Arcade.font; font-size: 8px; color: #ffffff80; vertical-alignment: center; }
                    Text { x: 0; width: parent.width; text: "© PANELOS"; font-family: Arcade.font; font-size: 8px; color: #ffffff80;
                        horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            // scanlines over everything but the rounded corners
            Image { x: 0; y: root.radius; width: root.width; height: root.height - 2 * root.radius; source: @image-url("images/scanlines.png");
                image-fit: fill; source-clip-x: 0; source-clip-y: 0; source-clip-width: root.width / 1px; source-clip-height: (root.height - 2 * root.radius) / 1px; }
            for b in [0, 1]: Image { x: root.radius; y: b * (root.height - root.radius); width: root.width - 2 * root.radius; height: root.radius;
                source: @image-url("images/scanlines.png"); image-fit: fill; source-clip-x: 0; source-clip-y: 0;
                source-clip-width: (root.width - 2 * root.radius) / 1px; source-clip-height: root.radius / 1px; }
            // the inner glow and the tube
            for g in [{ d: 9, w: 5, a: 0.05 }, { d: 5, w: 4, a: 0.10 }, { d: 2, w: 3, a: 0.20 }]: Rectangle {
                x: g.d * 1px; y: g.d * 1px; width: root.width - 2 * g.d * 1px; height: root.height - 2 * g.d * 1px;
                border-radius: root.radius - g.d * 1px; border-width: g.w * 1px; border-color: root.tube.with-alpha(g.a);
            }
            Rectangle { border-radius: root.radius; border-width: 2px; border-color: root.line; }
            // the flash of the tube warming up (and the bright line of switching off)
            Rectangle { visible: root.flash > 0.004; border-radius: root.iy > root.height / 2 - 20px ? 1px : root.radius; background: #ffffff; opacity: root.flash; }
        }
    }
}

struct FlowPos { x: length, row: int }

// A single choice as arcade blocks: words in the pixel font (white 75 %); the current one an inverse block (the tube
// colour, dark text, a glow, radius 2). Each block at least 40 × 44 px, 7 px side padding, 2 px apart; a row that does
// not fit wraps (up to 16 choices). A tap moves the block at once and it blinks twice (on, off, on, off, on: 40 ms
// frames); `picked` fires at the tap, `settled` after the blink (a new look or scene is applied then). A tap on the
// current block lights it at 55 % for two frames.
export component ArcadeBlocks inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <color> tube: #ff2bd6;
    in property <length> font-size: 9px;
    in property <bool> align-right;                // an inline row: the blocks end at the right edge
    callback picked(int);
    callback settled(int);
    property <length> gap: 2px;
    property <length> bh: 44px;
    // the block shown lit: follows `selected`, moves at once on a tap
    property <int> lit: root.selected;
    changed selected => { if !root.blinking { root.lit = root.selected; } }
    property <bool> blinking;
    property <int> frame;
    property <int> zap: -1;
    property <int> zap-frame;
    Timer { interval: 40ms; running: root.blinking; triggered => {
        root.frame += 1;
        if root.frame >= 5 { root.blinking = false; root.settled(root.lit); }
    } }
    Timer { interval: 40ms; running: root.zap >= 0; triggered => { root.zap-frame += 1; if root.zap-frame >= 2 { root.zap = -1; } } }
    pure function bw(i: int) -> length {
        return i < root.options.length ? Math.min(root.width, Math.max(40px, Arcade.text-w(root.options[i].character-count, root.font-size) + 16px)) : 0px;
    }
    pure function place(p: FlowPos, w: length) -> FlowPos {
        return p.x > 0px && p.x + w > root.width ? { x: 0px, row: p.row + 1 } : p;
    }
    pure function after(p: FlowPos, i: int) -> FlowPos {
        if i >= root.options.length { return p; }
        let q = root.place(p, root.bw(i));
        return { x: q.x + root.bw(i) + root.gap, row: q.row };
    }
    property <FlowPos> s0: { x: 0px, row: 0 };
    property <FlowPos> s1: root.after(root.s0, 0);
    property <FlowPos> s2: root.after(root.s1, 1);
    property <FlowPos> s3: root.after(root.s2, 2);
    property <FlowPos> s4: root.after(root.s3, 3);
    property <FlowPos> s5: root.after(root.s4, 4);
    property <FlowPos> s6: root.after(root.s5, 5);
    property <FlowPos> s7: root.after(root.s6, 6);
    property <FlowPos> s8: root.after(root.s7, 7);
    property <FlowPos> s9: root.after(root.s8, 8);
    property <FlowPos> s10: root.after(root.s9, 9);
    property <FlowPos> s11: root.after(root.s10, 10);
    property <FlowPos> s12: root.after(root.s11, 11);
    property <FlowPos> s13: root.after(root.s12, 12);
    property <FlowPos> s14: root.after(root.s13, 13);
    property <FlowPos> s15: root.after(root.s14, 14);
    property <[FlowPos]> starts: [root.s0, root.s1, root.s2, root.s3, root.s4, root.s5, root.s6, root.s7, root.s8, root.s9, root.s10,
        root.s11, root.s12, root.s13, root.s14, root.s15];
    property <int> n: Math.min(16, root.options.length);
    property <int> rows: root.n == 0 ? 1 : root.place(root.starts[root.n - 1], root.bw(root.n - 1)).row + 1;
    // the width each row takes (to right-align an inline row)
    property <length> last-end: root.n == 0 ? 0px : root.place(root.starts[root.n - 1], root.bw(root.n - 1)).x + root.bw(root.n - 1);
    out property <length> need-h: root.rows * root.bh + (root.rows - 1) * root.gap;
    preferred-height: root.need-h;
    min-height: root.need-h;
    for o[i] in root.options: blk := Rectangle {
        property <FlowPos> p: i < 16 ? root.place(root.starts[i], root.bw(i)) : { x: 0px, row: root.rows };
        property <bool> on: i == root.lit && (!root.blinking || Math.mod(root.frame, 2) == 0);
        property <bool> zapped: i == root.zap;
        x: root.align-right && root.rows == 1 ? root.width - root.last-end + self.p.x : self.p.x;
        y: self.p.row * (root.bh + root.gap);
        width: root.bw(i); height: root.bh;
        if blk.on: Rectangle { x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; border-radius: 4px; border-width: 2px;
            border-color: root.tube.with-alpha(0.30); }
        if blk.on: Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; border-radius: 6px; border-width: 2px;
            border-color: root.tube.with-alpha(0.12); }
        Rectangle { border-radius: 2px; background: blk.on ? root.tube : blk.zapped ? root.tube.with-alpha(0.55) : transparent; }
        Text {
            x: 7px; width: parent.width - 14px; height: parent.height;
            text: o; font-family: Arcade.font; font-size: root.font-size; letter-spacing: 0.4px; wrap: word-wrap;
            horizontal-alignment: center; vertical-alignment: center;
            color: blk.on ? Arcade.ink : blk.zapped ? #ffffff : #ffffffbf;
        }
        TouchArea {
            clicked => {
                if i == root.lit && !root.blinking {
                    root.zap = i; root.zap-frame = 0;
                } else if i != root.lit {
                    root.lit = i; root.frame = 0; root.blinking = true;
                    root.picked(i);
                }
            }
        }
    }
}

// One action block (Done, +1 MIN, PAUSE / GO ON, CANCEL, i): the pixel font in caps, radius 2; filled with the tube
// colour (`fill` 1, dark text) or a dim fill (`fill` 0.28, white text). A press lights it in the tube colour with a
// glow for two 40 ms frames, then `clicked` fires.
export component ArcadeBlock inherits Rectangle {
    in property <string> text;
    in property <color> tube: #ff2bd6;
    in property <float> fill: 1;
    in property <length> font-size: 10px;
    in property <string> icon;                     // a glyph instead of the text (Material Design Icons)
    callback clicked;
    min-width: 40px;
    preferred-width: Math.max(40px, Arcade.text-w(root.text.character-count, root.font-size) + 28px);
    height: 44px;
    property <int> frame: -1;
    Timer { interval: 40ms; running: root.frame >= 0; triggered => {
        root.frame += 1;
        if root.frame >= 2 { root.frame = -1; root.clicked(); }
    } }
    property <bool> lit: root.frame >= 0;
    if root.lit || root.fill >= 1: Rectangle { x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; border-radius: 4px;
        border-width: 2px; border-color: root.tube.with-alpha(root.lit ? 0.4 : 0.25); }
    if root.lit: Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; border-radius: 6px;
        border-width: 2px; border-color: root.tube.with-alpha(0.14); }
    Rectangle { border-radius: 2px; background: root.lit ? root.tube.mix(#ffffff, 0.8) : root.tube.with-alpha(root.fill); }
    if root.icon == "": Text {
        x: 6px; width: parent.width - 12px;
        text: root.text; font-family: Arcade.font; font-size: root.font-size; letter-spacing: 0.4px; wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
        color: root.lit || root.fill >= 0.6 ? Arcade.ink : #ffffff;
    }
    if root.icon != "": Text {
        text: root.icon; font-family: "Material Design Icons"; font-size: 22px;
        horizontal-alignment: center; vertical-alignment: center;
        color: root.lit || root.fill >= 0.6 ? Arcade.ink : #ffffff;
    }
    TouchArea { clicked => { if root.frame < 0 { root.frame = 0; } } }
}
