// Design tokens: colours (dark and light), type scale, spacing and radii.
// `dark` is set by the app (setting: dark, light, or auto = by the sun /
// the light sensor).

// Taps, holds and drags anywhere in the UI go to the app through this one
// callback: what ("music.play", "set.brightness", ...) and a value ("", an
// index, a number as text).
// The word lists of src/text.pak for texts the UI files draw themselves: a place's lines, or its first line.
export global Words {
    pure callback list(string) -> [string];
    pure callback line(string) -> string;
}

export global Act {
    callback act(string, string);
    // a drag on a page that moves sideways (the turntable's arm): the pages do not swipe meanwhile
    in-out property <bool> hold-swipe;
    // a rotary control on the page on screen (the thermostat's dial or knob): a drag that starts on its ring never turns
    // the page. The ring from lock-r0 to lock-r1 around (lock-cx, lock-cy), over the arc lock-a0 … lock-a1 (degrees,
    // 0 = right, clockwise); lock-r1 0: none. The page sets it while it is on screen.
    in-out property <length> lock-cx;
    in-out property <length> lock-cy;
    in-out property <length> lock-r0;
    in-out property <length> lock-r1;
    in-out property <float> lock-a0;
    in-out property <float> lock-a1: 360;
    // counts the rings set, so a page takes away only the ring it set itself (not one another page set since)
    in-out property <int> lock-serial;
    public pure function locked(x: length, y: length) -> bool {
        let r = Math.sqrt(Math.pow((x - self.lock-cx) / 1px, 2) + Math.pow((y - self.lock-cy) / 1px, 2)) * 1px;
        let a = atan2((y - self.lock-cy) / 1px, (x - self.lock-cx) / 1px) / 1deg;
        self.lock-r1 > 0px && r >= self.lock-r0 && r <= self.lock-r1 && Math.mod(Math.mod(a - self.lock-a0, 360) + 360, 360) <= self.lock-a1 - self.lock-a0
    }
}

// The animations' clock base. Slint turns a time into a 32-bit float before any arithmetic, and the
// animation clock counts from the start: after days such a float only has steps of tens of
// milliseconds and motion stutters. Animations therefore count from this base, which the app sets
// anew whenever nothing animated is in view (the screensaver starts, the screen goes off), so the
// number stays small and exact however long the panel runs.
export global Clock {
    in-out property <duration> base;
    // calm (the app: nobody near and nothing asked of the panel for 10 minutes): every clock's colon turns from
    // breathing into a plain step, bright one second and dim the next, and the seconds tick once a second
    in-out property <bool> calm;
    // the time format of every clock time the panel shows (one panel-wide value; durations never change):
    // true 24-hour ("18:45"), false 12-hour ("6:45 PM")
    in-out property <bool> h24: true;
}

export global Theme {
    in-out property <bool> dark: true;
    // the palette between light (0) and dark (1): the app's theme switch eases it over 0.4 s, every colour with it
    in-out property <float> k: 1;

    // PanelOS palette: Night is the panel's own screen, Paper the light ground, Graphite the dark surfaces,
    // Ink the text on light, Paper the text on dark, Signal the accent (brand guidelines, November 2026).
    out property <color> background: (#000000).mix(#F5F3EE, k);
    out property <color> surface: (#121314).mix(#ffffff, k);
    out property <color> surface-raised: (#1d1f21).mix(#EBE8E1, k);
    out property <color> surface-pressed: (#2a2c2f).mix(#DEDAD1, k);
    out property <color> outline: (#24262a).mix(#DAD6CD, k);

    // Text
    out property <color> text: (#F5F3EE).mix(#101114, k);
    out property <color> muted: (#A3A19C).mix(#5F5E5A, k);
    out property <color> faint: (#6B6A67).mix(#9A978F, k);

    // Brand and states: Signal is both the mark's dots and the interface accent.
    out property <color> brand: #FF4A1C;
    in-out property <color> accent: #FF4A1C;
    out property <color> accent-pressed: accent.darker(0.2);
    out property <color> on-accent: #ffffff;
    out property <color> warning: (#f5a524).mix(#b26a00, k);
    out property <color> success: (#34c77b).mix(#138a4e, k);
    out property <color> danger: (#ff5a5f).mix(#d0222a, k);

    out property <color> scrim: (#000000c0).mix(#00000070, k);

    // Type scale
    out property <length> font-display: 84px;
    out property <length> font-title: 22px;
    out property <length> font-heading: 18px;
    out property <length> font-body: 17px;
    out property <length> font-label: 15px;
    out property <length> font-caption: 13px;

    // Font weights (Noto Sans is a variable font: any weight 100–900)
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-strong: 600;
    // Headings and the wordmark: Space Grotesk Medium; everything else Noto Sans
    out property <string> heading-family: "Space Grotesk";
    out property <int> heading-weight: 500;

    // Spacing and shape
    out property <length> pad: 16px;
    out property <length> gap: 8px;
    out property <length> radius: 20px;
    out property <length> radius-small: 14px;

    // On-screen keyboards (Wi-Fi password, hidden network, Home Assistant
    // address) sit in the same block on every screen, so every key stays
    // exactly where it was: 4 rows from keyboard-top, theme switch below.
    out property <length> keyboard-top: 224px;
    out property <length> key-height: 44px;
    out property <length> key-gap: 6px;
    out property <length> switch-top: 424px;

    // Earlier names, used by the screens not redesigned yet.
    out property <color> card: surface;
    out property <color> card-on: (#1d1f21).mix(#ffffff, k);
    out property <color> card-pressed: surface-pressed;
    out property <color> button: surface-raised;
    out property <color> button-pressed: surface-pressed;
    out property <color> sheet: (#121314).mix(#FBFAF7, k);
    out property <color> badge-off: (#F5F3EE12).mix(#1011140d, k);
    out property <color> chip: (#1d1f21).mix(#ffffff, k);
    out property <color> chip-border: (#1d1f21).mix(#DAD6CD, k);
}
