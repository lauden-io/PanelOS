// Clock faces from the stopwatch and alarm looks (spec 24.9): the nixie tubes, the LCD quartz watch and the
// twin-bell clock, for the screensaver and the clock widget. Each is drawn in its own frame (the design boards'
// numbers) and scaled to fit, centred. Seg7 (the seven-segment digit) is shared with the timers page.
import { Theme } from "theme.slint";

// The next alarm and whether one rings (set from the timers page's properties in app.slint).
export global AlarmNow {
    in-out property <float> next-h: -1;   // the next alarm's hour of the day (0..24), -1 when none is on
    in-out property <bool> ringing;       // an alarm rings now
}

// A seven-segment digit in the 480 x 480 frame (spec 24.3, the board's geometry): slanted by 0.09, every unlit segment a
// faint ghost (7 %). d: 0-9, 10 = "L", -1 = blank.
export component Seg7 inherits Rectangle {
    in property <int> d: -1;
    in property <float> x0;
    in property <float> y0;
    in property <float> w;
    in property <float> h;
    in property <float> t;
    in property <color> ink;
    in property <float> slant: 0.09;
    in property <float> gap: 0.18;
    in property <color> off;              // an unlit segment in its own colour (no ghost)
    in property <bool> ghost: true;
    in property <bool> lag;               // the segments lag like a real LCD (25.T8)
    width: 480px; height: 480px;
    property <[int]> masks: [63, 6, 91, 79, 102, 109, 125, 7, 127, 111, 56];
    property <int> mask: root.d >= 0 && root.d <= 10 ? root.masks[root.d] : 0;
    property <float> g: root.t * root.gap;
    property <float> m: root.y0 + root.h / 2;
    pure function px(x: float, y: float) -> float { x + (root.y0 + root.h - y) * root.slant }
    pure function pt(x: float, y: float) -> string { root.px(x, y) + " " + y }
    pure function hor(y: float) -> string {
        "M " + root.pt(root.x0 + root.g + root.t / 2, y + root.t / 2) + " L " + root.pt(root.x0 + root.g + root.t, y) + " L " + root.pt(root.x0 + root.w - root.g - root.t, y)
            + " L " + root.pt(root.x0 + root.w - root.g - root.t / 2, y + root.t / 2) + " L " + root.pt(root.x0 + root.w - root.g - root.t, y + root.t)
            + " L " + root.pt(root.x0 + root.g + root.t, y + root.t) + " Z"
    }
    pure function ver(x: float, ya: float, yb: float) -> string {
        "M " + root.pt(x + root.t / 2, ya) + " L " + root.pt(x + root.t, ya + root.t / 2) + " L " + root.pt(x + root.t, yb - root.t / 2)
            + " L " + root.pt(x + root.t / 2, yb) + " L " + root.pt(x, yb - root.t / 2) + " L " + root.pt(x, ya + root.t / 2) + " Z"
    }
    pure function on(bit: int) -> bool { Math.mod(Math.floor(root.mask / bit), 2) == 1 }
    for sg[i] in [
        { b: 1, c: root.hor(root.y0) },
        { b: 2, c: root.ver(root.x0 + root.w - root.t, root.y0 + root.g + root.t / 2, root.m - root.g) },
        { b: 4, c: root.ver(root.x0 + root.w - root.t, root.m + root.g, root.y0 + root.h - root.g - root.t / 2) },
        { b: 8, c: root.hor(root.y0 + root.h - root.t) },
        { b: 16, c: root.ver(root.x0, root.m + root.g, root.y0 + root.h - root.g - root.t / 2) },
        { b: 32, c: root.ver(root.x0, root.y0 + root.g + root.t / 2, root.m - root.g) },
        { b: 64, c: root.hor(root.m - root.t / 2) },
    ]: Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480;
        property <bool> lit: root.on(sg.b);
        fill: root.ghost || self.lit ? root.ink : root.off; opacity: root.ghost && !self.lit ? 0.07 : 1; commands: sg.c;
        // 25.T8: like a real LCD a segment comes on in 60 ms and goes off in 120 ms
        states [
            lag-on when root.lag && self.lit: { opacity: 1; in { animate opacity { duration: 60ms; } } }
            lag-off when root.lag && !self.lit: { opacity: root.ghost ? 0.07 : 1; in { animate opacity { duration: 120ms; } } }
        ]
    }
}

// One nixie tube of the clock (board C1): smoky glass (28 %) so the background shows through, the faint cathode
// stack, the lit digit in four orange strokes, the 45 degree mesh in front, the socket. 54 x 132.
component NixieGlass inherits Rectangle {
    in property <int> d;
    in property <float> f: 1;             // the glow, never quite steady
    width: 54px; height: 132px;
    property <float> lit: root.d >= 0 && root.d <= 9 ? 1 : 0;   // -1: an unlit tube (12-hour mode's first hour tube before 10)
    // a digit change crossfades with an afterglow (as 25.T9): the old cathode dies over 120 ms, the new lights over 60 ms
    property <int> cur: -1;
    property <int> old: -1;
    property <duration> t0;
    property <bool> fading;
    init => { root.cur = root.d; }
    changed d => { root.old = root.cur; root.cur = root.d; root.t0 = animation-tick(); root.fading = true; }
    Timer { interval: 130ms; running: root.fading; triggered => { root.fading = false; } }
    property <float> since: root.fading ? (animation-tick() - root.t0) / 1ms : 1000;
    property <float> new-k: clamp(root.since / 60, 0, 1);
    property <float> old-k: root.old >= 0 && root.old <= 9 && root.old != root.d ? 1 - clamp(root.since / 120, 0, 1) : 0;
    property <[string]> nx: ["M18 2 C30 2 34 16 34 36 C34 56 30 70 18 70 C6 70 2 56 2 36 C2 16 6 2 18 2 Z", "M11 13 L19 3 L19 70", "M4 16 C4 6 11 2 18 2 C27 2 32 8 32 17 C32 30 18 40 4 70 L33 70", "M4 4 L31 4 L16 30 C27 29 33 37 33 49 C33 62 26 70 17 70 C9 70 4 66 3 60", "M26 70 L26 2 L3 50 L34 50", "M31 3 L8 3 L5 32 C9 28 13 27 18 27 C28 27 33 35 33 48 C33 62 26 70 17 70 C9 70 4 66 3 60", "M28 6 C25 3 22 2 18 2 C8 2 3 14 3 40 C3 60 9 70 18 70 C27 70 33 62 33 52 C33 42 27 34 18 34 C10 34 4 40 3 48", "M3 3 L33 3 L13 70", "M18 34 C9 34 5 28 5 18 C5 8 11 2 18 2 C25 2 31 8 31 18 C31 28 27 34 18 34 C8 34 3 42 3 52 C3 63 10 70 18 70 C26 70 33 63 33 52 C33 42 28 34 18 34 Z", "M8 66 C11 69 14 70 18 70 C28 70 33 58 33 32 C33 12 27 2 18 2 C9 2 3 10 3 20 C3 30 9 38 18 38 C26 38 32 32 33 24"];
    Rectangle { x: 4px; y: 122px; width: 46px; height: 10px; border-radius: 3px; background: #141010; border-width: 1px; border-color: #2c2622; }
    Rectangle { x: -0.6px; y: -0.6px; width: 55.2px; height: 125.2px; border-radius: 26.6px; background: #180e0847; border-width: 1.2px; border-color: #ffffff47; }
    Path { x: 0; y: 0; width: 54px; height: 124px; viewbox-width: 54; viewbox-height: 124; fill: #ff6a14; opacity: 0.13 * root.f;
        commands: "M 7 62 A 20 34 0 1 0 47 62 A 20 34 0 1 0 7 62 Z"; }
    for g[i] in root.nx: Path { visible: i != root.d; x: 1px; y: 18px; width: 52px; height: 88px; viewbox-x: -8; viewbox-y: -8; viewbox-width: 52; viewbox-height: 88;
        fill: transparent; stroke: #8a7462; stroke-width: 1.4px; stroke-line-cap: round; stroke-line-join: round; opacity: 0.38; commands: g; }
    if root.old-k > 0: Rectangle {
        for w[i] in [{ s: 11px, c: #ff5a00, o: 0.16 }, { s: 6px, c: #ff7a1a, o: 0.42 }, { s: 3px, c: #ffb066, o: 0.9 }, { s: 1.2px, c: #fff0dc, o: 1.0 }]: Path {
            x: 1px; y: 18px; width: 52px; height: 88px; viewbox-x: -8; viewbox-y: -8; viewbox-width: 52; viewbox-height: 88;
            fill: transparent; stroke: w.c; stroke-width: w.s; stroke-line-cap: round; stroke-line-join: round; opacity: w.o * root.old-k * (i < 3 ? root.f : 1);
            commands: root.nx[root.old]; }
    }
    for w[i] in [{ s: 11px, c: #ff5a00, o: 0.16 }, { s: 6px, c: #ff7a1a, o: 0.42 }, { s: 3px, c: #ffb066, o: 0.9 }, { s: 1.2px, c: #fff0dc, o: 1.0 }]: Path {
        x: 1px; y: 18px; width: 52px; height: 88px; viewbox-x: -8; viewbox-y: -8; viewbox-width: 52; viewbox-height: 88;
        fill: transparent; stroke: w.c; stroke-width: w.s; stroke-line-cap: round; stroke-line-join: round; opacity: w.o * root.new-k * root.lit * (i < 3 ? root.f : 1);
        commands: root.d >= 0 && root.d <= 9 ? root.nx[root.d] : root.nx[0]; }
    Path { x: 0; y: 0; width: 54px; height: 124px; viewbox-width: 54; viewbox-height: 124; fill: transparent; stroke: #b9967a; stroke-width: 0.6px; opacity: 0.34;
        commands: "M 43 14 L 47 18 M 11 14 L 7 18 M 34 14 L 47 27 M 20 14 L 7 27 M 25 14 L 47 36 M 29 14 L 7 36 M 16 14 L 47 45 M 38 14 L 7 45 M 7 14 L 47 54 M 47 14 L 7 54 M 7 23 L 47 63 M 47 23 L 7 63 M 7 32 L 47 72 M 47 32 L 7 72 M 7 41 L 47 81 M 47 41 L 7 81 M 7 50 L 47 90 M 47 50 L 7 90 M 7 59 L 47 99 M 47 59 L 7 99 M 7 68 L 47 108 M 47 68 L 7 108 M 7 77 L 42 112 M 47 77 L 12 112 M 7 86 L 33 112 M 47 86 L 21 112 M 7 95 L 24 112 M 47 95 L 30 112 M 7 104 L 15 112 M 47 104 L 39 112"; }
    Rectangle { x: 9px; y: 8px; width: 5px; height: 92px; border-radius: 2.5px; background: #ffffff29; }
    Rectangle { x: 20px; y: 2px; width: 14px; height: 5px; border-radius: 2.5px; background: #ffffff24; }
}

// The walnut plinth (boards C1 and S4): grain lines, end-grain shading, a bevel highlight, the darker lower edge and a
// soft contact shadow. The grain is drawn for the two clock widths (hh:mm 284, hh:mm:ss 420).
component WalnutPlinth inherits Rectangle {
    in property <bool> wide;              // 420 px instead of 284
    property <float> pw: root.wide ? 420 : 284;
    width: root.pw * 1px; height: 26px;
    Path { x: -root.pw * 0.02px; y: 0; width: root.pw * 1.04px; height: 40px; viewbox-width: root.pw * 1.04; viewbox-height: 40; fill: #000000; opacity: 0.45;
        commands: "M 0 29 A " + root.pw * 0.52 + " 6 0 1 0 " + root.pw * 1.04 + " 29 A " + root.pw * 0.52 + " 6 0 1 0 0 29 Z"; }
    Rectangle { border-radius: 5px; background: @linear-gradient(180deg, #8a5634 0%, #6b3f22 45%, #3f2313 100%); }
    if !root.wide: Rectangle {
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 1.1px; opacity: 0.42;
            commands: "M 0 3.6 L 10 4.2 L 20 4.1 L 30 3.8 L 40 4 L 50 4.5 L 60 4.4 L 70 3.8 L 80 3.4 L 90 3.7 L 100 3.8 L 110 3.2 L 120 2.7 L 130 2.9 L 140 3.4 L 150 3.4 L 160 3 L 170 3.2 L 180 3.9 L 190 4.3 L 200 4 L 210 3.8 L 220 4.2 L 230 4.6 L 240 4.2 L 250 3.6 L 260 3.5 L 270 3.8 L 280 3.6"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 5.6 L 10 6.8 L 20 6.2 L 30 6 L 40 6.2 L 50 6.2 L 60 5.4 L 70 4.8 L 80 4.9 L 90 5.1 L 100 4.8 L 110 4.3 L 120 4.5 L 130 5.2 L 140 5.5 L 150 5.3 L 160 5.3 L 170 6.1 L 180 6.7 L 190 6.5 L 200 6.1 L 210 6.3 L 220 6.7 L 230 6.4 L 240 5.7 L 250 5.3 L 260 5.5 L 270 5.4 L 280 4.8"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 7.5 L 10 7.7 L 20 7 L 30 7.1 L 40 7.1 L 50 6.6 L 60 5.9 L 70 6 L 80 6.5 L 90 6.7 L 100 6.4 L 110 6.6 L 120 7.4 L 130 8.1 L 140 8 L 150 8 L 160 8.5 L 170 9.1 L 180 9 L 190 8.4 L 200 8.2 L 210 8.5 L 220 8.3 L 230 7.4 L 240 6.8 L 250 6.8 L 260 6.9 L 270 6.4 L 280 5.8"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 9.4 L 10 8.5 L 20 8.7 L 30 9.1 L 40 9.1 L 50 8.6 L 60 8.7 L 70 9.3 L 80 9.7 L 90 9.4 L 100 9.2 L 110 9.7 L 120 10.3 L 130 10.1 L 140 9.7 L 150 9.8 L 160 10.2 L 170 10.2 L 180 9.6 L 190 9.3 L 200 9.5 L 210 9.7 L 220 9.2 L 230 8.6 L 240 8.8 L 250 9.2 L 260 9.1 L 270 8.6 L 280 8.5"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 1.1px; opacity: 0.22;
            commands: "M 0 11.3 L 10 10.3 L 20 11 L 30 11.4 L 40 11.1 L 50 11.1 L 60 11.7 L 70 12.3 L 80 12.2 L 90 11.8 L 100 12.1 L 110 12.6 L 120 12.5 L 130 11.9 L 140 11.6 L 150 11.9 L 160 11.9 L 170 11.3 L 180 10.7 L 190 10.8 L 200 11 L 210 10.7 L 220 10.1 L 230 10.1 L 240 10.6 L 250 10.8 L 260 10.5 L 270 10.4 L 280 11"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 13.3 L 10 13.9 L 20 14.5 L 30 14.3 L 40 14.1 L 50 14.4 L 60 14.9 L 70 14.8 L 80 14.1 L 90 13.9 L 100 14.2 L 110 14.1 L 120 13.4 L 130 12.7 L 140 12.8 L 150 13 L 160 12.5 L 170 11.8 L 180 11.8 L 190 12.2 L 200 12.3 L 210 11.9 L 220 11.8 L 230 12.5 L 240 13.1 L 250 13 L 260 12.8 L 270 13.4 L 280 14.2"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 15.2 L 10 16.1 L 20 16 L 30 15.4 L 40 15.3 L 50 15.7 L 60 15.7 L 70 15.1 L 80 14.7 L 90 15 L 100 15.3 L 110 14.9 L 120 14.3 L 130 14.4 L 140 14.9 L 150 14.9 L 160 14.4 L 170 14.3 L 180 14.8 L 190 15.2 L 200 14.9 L 210 14.7 L 220 15.1 L 230 15.7 L 240 15.7 L 250 15.2 L 260 15.4 L 270 15.9 L 280 16.1"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 17.1 L 10 17.6 L 20 16.9 L 30 16.5 L 40 16.7 L 50 16.9 L 60 16.4 L 70 15.9 L 80 16 L 90 16.5 L 100 16.4 L 110 16 L 120 16 L 130 16.6 L 140 16.9 L 150 16.7 L 160 16.5 L 170 17.1 L 180 17.7 L 190 17.6 L 200 17.3 L 210 17.5 L 220 18.2 L 230 18.3 L 240 17.9 L 250 17.7 L 260 18.1 L 270 18.4 L 280 17.9"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 1.1px; opacity: 0.42;
            commands: "M 0 19 L 10 17.8 L 20 17.4 L 30 17.6 L 40 18.1 L 50 18 L 60 17.6 L 70 17.8 L 80 18.5 L 90 18.8 L 100 18.6 L 110 18.6 L 120 19.2 L 130 19.9 L 140 19.8 L 150 19.5 L 160 19.8 L 170 20.5 L 180 20.6 L 190 20.1 L 200 20 L 210 20.4 L 220 20.6 L 230 20 L 240 19.5 L 250 19.5 L 260 19.8 L 270 19.4 L 280 18.6"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 21 L 10 20.2 L 20 20.4 L 30 21 L 40 21.2 L 50 20.8 L 60 20.7 L 70 21.3 L 80 21.7 L 90 21.4 L 100 21.1 L 110 21.3 L 120 21.9 L 130 21.8 L 140 21.3 L 150 21.2 L 160 21.7 L 170 21.8 L 180 21.3 L 190 20.9 L 200 21.1 L 210 21.5 L 220 21.1 L 230 20.5 L 240 20.5 L 250 20.9 L 260 20.9 L 270 20.3 L 280 20"; }
        Path { x: 0; y: 0; width: 284px; height: 26px; viewbox-width: 284; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 22.9 L 10 23.1 L 20 23.7 L 30 24 L 40 23.7 L 50 23.4 L 60 23.7 L 70 24.2 L 80 24 L 90 23.4 L 100 23.4 L 110 23.8 L 120 23.8 L 130 23.2 L 140 22.8 L 150 23 L 160 23.2 L 170 22.8 L 180 22.1 L 190 22.2 L 200 22.5 L 210 22.4 L 220 21.8 L 230 21.6 L 240 22.1 L 250 22.3 L 260 21.9 L 270 21.6 L 280 22"; }
    }
    if root.wide: Rectangle {
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 1.1px; opacity: 0.42;
            commands: "M 0 3.6 L 10 4.2 L 20 4.1 L 30 3.8 L 40 4 L 50 4.5 L 60 4.4 L 70 3.8 L 80 3.4 L 90 3.7 L 100 3.8 L 110 3.2 L 120 2.7 L 130 2.9 L 140 3.4 L 150 3.4 L 160 3 L 170 3.2 L 180 3.9 L 190 4.3 L 200 4 L 210 3.8 L 220 4.2 L 230 4.6 L 240 4.2 L 250 3.6 L 260 3.5 L 270 3.8 L 280 3.6 L 290 2.9 L 300 2.7 L 310 3.2 L 320 3.5 L 330 3.2 L 340 3 L 350 3.5 L 360 4.2 L 370 4.2 L 380 3.8 L 390 3.9 L 400 4.5 L 410 4.5 L 420 3.9"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 5.6 L 10 6.8 L 20 6.2 L 30 6 L 40 6.2 L 50 6.2 L 60 5.4 L 70 4.8 L 80 4.9 L 90 5.1 L 100 4.8 L 110 4.3 L 120 4.5 L 130 5.2 L 140 5.5 L 150 5.3 L 160 5.3 L 170 6.1 L 180 6.7 L 190 6.5 L 200 6.1 L 210 6.3 L 220 6.7 L 230 6.4 L 240 5.7 L 250 5.3 L 260 5.5 L 270 5.4 L 280 4.8 L 290 4.3 L 300 4.6 L 310 5 L 320 5 L 330 4.7 L 340 5 L 350 5.9 L 360 6.2 L 370 6 L 380 6 L 390 6.5 L 400 6.9 L 410 6.5 L 420 5.9"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 7.5 L 10 7.7 L 20 7 L 30 7.1 L 40 7.1 L 50 6.6 L 60 5.9 L 70 6 L 80 6.5 L 90 6.7 L 100 6.4 L 110 6.6 L 120 7.4 L 130 8.1 L 140 8 L 150 8 L 160 8.5 L 170 9.1 L 180 9 L 190 8.4 L 200 8.2 L 210 8.5 L 220 8.3 L 230 7.4 L 240 6.8 L 250 6.8 L 260 6.9 L 270 6.4 L 280 5.8 L 290 6 L 300 6.6 L 310 6.8 L 320 6.6 L 330 6.8 L 340 7.7 L 350 8.3 L 360 8.2 L 370 8.1 L 380 8.6 L 390 9.2 L 400 9 L 410 8.3 L 420 8.1"; }
