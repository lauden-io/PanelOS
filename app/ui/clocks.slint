            Rectangle { x: 235px; y: 205px; width: 10px; height: 10px; border-radius: 5px; background: #101114; }
            Rectangle { x: 238px; y: 208px; width: 4px; height: 4px; border-radius: 2px; background: #FF4A1C; }
