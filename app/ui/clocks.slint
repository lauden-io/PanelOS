            for n in [{ v: "12", x: 240, y: 161 }, { v: "3", x: 289, y: 210 }, { v: "6", x: 240, y: 259 }, { v: "9", x: 191, y: 210 }]: Text { x: (n.x - 20) * 1px; y: (n.y - 12) * 1px; width: 40px; height: 24px; text: n.v; font-family: "Space Grotesk"; font-size: 15px; font-weight: 500;
