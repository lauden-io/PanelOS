        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 13.3 L 10 13.9 L 20 14.5 L 30 14.3 L 40 14.1 L 50 14.4 L 60 14.9 L 70 14.8 L 80 14.1 L 90 13.9 L 100 14.2 L 110 14.1 L 120 13.4 L 130 12.7 L 140 12.8 L 150 13 L 160 12.5 L 170 11.8 L 180 11.8 L 190 12.2 L 200 12.3 L 210 11.9 L 220 11.8 L 230 12.5 L 240 13.1 L 250 13 L 260 12.8 L 270 13.4 L 280 14.2 L 290 14.3 L 300 14 L 310 14.1 L 320 14.7 L 330 14.9 L 340 14.4 L 350 14 L 360 14.2 L 370 14.4 L 380 13.9 L 390 13.1 L 400 12.9 L 410 13.1 L 420 12.9"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 15.2 L 10 16.1 L 20 16 L 30 15.4 L 40 15.3 L 50 15.7 L 60 15.7 L 70 15.1 L 80 14.7 L 90 15 L 100 15.3 L 110 14.9 L 120 14.3 L 130 14.4 L 140 14.9 L 150 14.9 L 160 14.4 L 170 14.3 L 180 14.8 L 190 15.2 L 200 14.9 L 210 14.7 L 220 15.1 L 230 15.7 L 240 15.7 L 250 15.2 L 260 15.4 L 270 15.9 L 280 16.1 L 290 15.7 L 300 15.4 L 310 15.7 L 320 16.1 L 330 15.7 L 340 15.1 L 350 15.2 L 360 15.5 L 370 15.4 L 380 14.8 L 390 14.5 L 400 14.9 L 410 15.1 L 420 14.6"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 17.1 L 10 17.6 L 20 16.9 L 30 16.5 L 40 16.7 L 50 16.9 L 60 16.4 L 70 15.9 L 80 16 L 90 16.5 L 100 16.4 L 110 16 L 120 16 L 130 16.6 L 140 16.9 L 150 16.7 L 160 16.5 L 170 17.1 L 180 17.7 L 190 17.6 L 200 17.3 L 210 17.5 L 220 18.2 L 230 18.3 L 240 17.9 L 250 17.7 L 260 18.1 L 270 18.4 L 280 17.9 L 290 17.3 L 300 17.4 L 310 17.7 L 320 17.4 L 330 16.7 L 340 16.5 L 350 16.8 L 360 16.8 L 370 16.3 L 380 15.8 L 390 16.1 L 400 16.5 L 410 16.3 L 420 15.9"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 1.1px; opacity: 0.42;
            commands: "M 0 19 L 10 17.8 L 20 17.4 L 30 17.6 L 40 18.1 L 50 18 L 60 17.6 L 70 17.8 L 80 18.5 L 90 18.8 L 100 18.6 L 110 18.6 L 120 19.2 L 130 19.9 L 140 19.8 L 150 19.5 L 160 19.8 L 170 20.5 L 180 20.6 L 190 20.1 L 200 20 L 210 20.4 L 220 20.6 L 230 20 L 240 19.5 L 250 19.5 L 260 19.8 L 270 19.4 L 280 18.6 L 290 18.4 L 300 18.7 L 310 18.6 L 320 17.9 L 330 17.5 L 340 17.8 L 350 18.1 L 360 17.8 L 370 17.4 L 380 17.6 L 390 18.3 L 400 18.4 L 410 18.1 L 420 18.2"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #2c170b; stroke-width: 0.7px; opacity: 0.42;
            commands: "M 0 21 L 10 20.2 L 20 20.4 L 30 21 L 40 21.2 L 50 20.8 L 60 20.7 L 70 21.3 L 80 21.7 L 90 21.4 L 100 21.1 L 110 21.3 L 120 21.9 L 130 21.8 L 140 21.3 L 150 21.2 L 160 21.7 L 170 21.8 L 180 21.3 L 190 20.9 L 200 21.1 L 210 21.5 L 220 21.1 L 230 20.5 L 240 20.5 L 250 20.9 L 260 20.9 L 270 20.3 L 280 20 L 290 20.4 L 300 20.8 L 310 20.4 L 320 20 L 330 20.3 L 340 20.8 L 350 20.8 L 360 20.3 L 370 20.4 L 380 21 L 390 21.3 L 400 21 L 410 20.7 L 420 21.2"; }
        Path { x: 0; y: 0; width: 420px; height: 26px; viewbox-width: 420; viewbox-height: 26; fill: transparent; stroke: #c08a5c; stroke-width: 0.7px; opacity: 0.22;
            commands: "M 0 22.9 L 10 23.1 L 20 23.7 L 30 24 L 40 23.7 L 50 23.4 L 60 23.7 L 70 24.2 L 80 24 L 90 23.4 L 100 23.4 L 110 23.8 L 120 23.8 L 130 23.2 L 140 22.8 L 150 23 L 160 23.2 L 170 22.8 L 180 22.1 L 190 22.2 L 200 22.5 L 210 22.4 L 220 21.8 L 230 21.6 L 240 22.1 L 250 22.3 L 260 21.9 L 270 21.6 L 280 22 L 290 22.5 L 300 22.5 L 310 22.1 L 320 22.3 L 330 23 L 340 23.3 L 350 22.9 L 360 22.8 L 370 23.4 L 380 23.9 L 390 23.7 L 400 23.3 L 410 23.6 L 420 24.1"; }
    }
    Rectangle { border-radius: 5px; background: @linear-gradient(90deg, #00000059 0%, #00000000 6%, #00000000 94%, #00000066 100%); }
    Rectangle { x: 4px; y: 0; width: parent.width - 8px; height: 1.6px; border-radius: 1px; background: #ffffff38; }
    Rectangle { x: 0; y: parent.height - 1.6px; width: parent.width; height: 1.6px; border-radius: 1px; background: #00000059; }
}

// Style 8: the nixie tubes as a clock (board C1): hh:mm, seconds optional, the colon as two neon dots, on the walnut
// plinth; nothing else behind them. Native frame 302 x 168 (438 x 168 with seconds).
export component NixieClock inherits Rectangle {
    in property <string> hh;              // the hour shown (12-hour mode: "6", its first tube dark)
    in property <string> ampm;            // "" 24-hour; "AM" / "PM": a small neon lamp beside the minutes, lit for PM
    in property <string> mm;
    in property <float> seconds;          // 0..60
    in property <bool> show-seconds;
    in property <bool> live: true;        // on screen: only then the glow flickers (off screen nothing redraws)
    property <float> fw: root.show-seconds ? 438 : 302;
    property <float> fh: 168;
    property <float> k: min(root.width / 1px / root.fw, root.height / 1px / root.fh);
    property <int> h: root.hh.to-float();
    property <int> m: root.mm.to-float();
    property <int> s: Math.floor(root.seconds);
    property <int> lead: root.ampm != "" && root.h < 10 ? -1 : Math.floor(root.h / 10);
    // the glow of each tube, never quite steady (12 times a second)
    property <float> ft;
    Timer { interval: 80ms; running: root.live; triggered => { root.ft = animation-tick() / 1ms; } }
    pure function fl(n: int) -> float { 0.94 + 0.06 * Math.abs(Math.sin(1rad * (root.ft / 37 + n * 1.7)) * Math.sin(1rad * (root.ft / 91 + n))) }
    fr := Rectangle {
        width: root.fw * 1px; height: root.fh * 1px;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        transform-scale-x: root.k; transform-scale-y: root.k; transform-origin: { x: self.width / 2, y: self.height / 2 };
        WalnutPlinth { x: 9px; y: 132px; wide: root.show-seconds; }
        // the digits: 60 px apart in a pair, 16 px for a colon (tube lefts from the board's layout)
        for t[i] in root.show-seconds ? [{ x: 26, d: root.lead }, { x: 86, d: Math.mod(root.h, 10) }, { x: 162, d: Math.floor(root.m / 10) },
                { x: 222, d: Math.mod(root.m, 10) }, { x: 298, d: Math.floor(root.s / 10) }, { x: 358, d: Math.mod(root.s, 10) }]
            : [{ x: 26, d: root.lead }, { x: 86, d: Math.mod(root.h, 10) }, { x: 162, d: Math.floor(root.m / 10) }, { x: 222, d: Math.mod(root.m, 10) }]:
            NixieGlass { x: t.x * 1px; y: 0; d: t.d; f: root.fl(i); }
        for c in root.show-seconds ? [151, 287] : [151]: Rectangle {
            for yy in [46, 80]: Rectangle {
                Rectangle { x: (c - 8.5) * 1px; y: (yy - 8.5) * 1px; width: 17px; height: 17px; border-radius: 8.5px; background: #ff6a00; opacity: 0.18; }
                Rectangle { x: (c - 4.6) * 1px; y: (yy - 4.6) * 1px; width: 9.2px; height: 9.2px; border-radius: 4.6px; background: #ff8a2a; opacity: 0.5; }
                Rectangle { x: (c - 2.6) * 1px; y: (yy - 2.6) * 1px; width: 5.2px; height: 5.2px; border-radius: 2.6px; background: #ffd8a8; }
            }
        }
        // 12-hour mode: the PM lamp at the right end (a small neon bulb, lit for PM), "PM" stamped on the plinth under it
        if root.ampm != "": pm := Rectangle {
            property <float> lx: root.show-seconds ? 426 : 290;
            property <bool> on: root.ampm == "PM";
            Rectangle { x: (pm.lx - 7) * 1px; y: 92px; width: 14px; height: 21px; border-radius: 7px; background: #180e0847; border-width: 1px; border-color: #ffffff47; }
            if pm.on: Rectangle { x: (pm.lx - 11) * 1px; y: 91.5px; width: 22px; height: 22px; border-radius: 11px; background: #ff6a00; opacity: 0.2 * root.fl(7); }
            if pm.on: Rectangle { x: (pm.lx - 6) * 1px; y: 96.5px; width: 12px; height: 12px; border-radius: 6px; background: #ff8a2a; opacity: 0.5; }
            Rectangle { x: (pm.lx - 3.5) * 1px; y: 99px; width: 7px; height: 7px; border-radius: 3.5px; background: pm.on ? #ffd8a8 : #8a7462; opacity: pm.on ? 1 : 0.38; }
            Text { x: (pm.lx - 23) * 1px; y: 138px; width: 30px; height: 14px; text: "PM"; font-size: 10px; font-weight: 700; letter-spacing: 1px;
                color: #e0b884; opacity: 0.8; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// Style 9: the LCD quartz watch as a clock (boards C2, C4): HH:MM in segments with a blinking colon, small seconds, the
// weekday and the date, AL when an alarm is on; the resin case (white in light mode) from 3 x 2 cells, the LCD alone
// below that. A tap on the LCD lights it for 3 s.
export component LcdClock inherits Rectangle {
    in property <string> hh;              // the hour shown ("6" in 12-hour mode; its first digit is blank before 10 anyway)
    in property <string> ampm;            // "" 24-hour; "AM" / "PM": the PM segment above the seconds (a faint ghost for AM)
    in property <string> mm;
    in property <float> seconds;
    in property <string> weekday;         // "WE"
    in property <string> date;            // "11-18"
    in property <bool> cased: true;
    property <bool> glow;
    Timer { interval: 3s; running: root.glow; triggered => { root.glow = false; } }
    property <float> fw: root.cased ? 348 : 212;
    property <float> fh: root.cased ? 200 : 84;
    property <float> ox: root.cased ? 66 : 246;
    property <float> oy: root.cased ? 58 : 62;
    property <float> k: min(root.width / 1px / root.fw, root.height / 1px / root.fh);
    property <int> h: root.hh.to-float();
    property <int> m: root.mm.to-float();
    property <int> s: Math.floor(root.seconds);
    property <float> colon: Math.mod(root.seconds, 1) < 0.5 ? 1 : 0.08;
    property <color> body: Theme.dark ? #1b1c20 : #efece5;
    property <color> bevel: Theme.dark ? #2b2c31 : #d6d2c8;
    property <color> pusher: Theme.dark ? #3a3b40 : #c9c5bb;
    property <color> print: Theme.dark ? #a7a39b : #55524c;
    property <float> gk: root.glow ? 1 : 0;
    animate gk { duration: root.glow ? 60ms : 1000ms; easing: ease-out; }
    property <color> ink: #0b2723.mix(#1d2620, root.gk);
    property <brush> lcd: @linear-gradient(180deg, #7fe7d6.mix(#b6c2ac, root.gk) 0%, #45c2b0.mix(#9cab95, root.gk) 100%);
    fr := Rectangle {
        width: root.fw * 1px; height: root.fh * 1px;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        transform-scale-x: root.k; transform-scale-y: root.k; transform-origin: { x: self.width / 2, y: self.height / 2 };
        // the board's 480 x 480 frame
        Rectangle { x: -root.ox * 1px; y: -root.oy * 1px; width: 480px; height: 480px;
            if root.cased: Rectangle {
                Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #000000; opacity: 0.4;
                    commands: "M 80 250 A 160 8 0 1 0 400 250 A 160 8 0 1 0 80 250 Z"; }
                for pp in [{ x: 66, y: 84 }, { x: 66, y: 196 }, { x: 402, y: 84 }, { x: 402, y: 196 }]: Rectangle {
                    x: pp.x * 1px; y: pp.y * 1px; width: 12px; height: 22px; border-radius: 3px; background: root.pusher; }
                Rectangle { x: 74px; y: 58px; width: 332px; height: 188px; border-radius: 40px; background: root.body; }
                Rectangle { x: 82.5px; y: 66.5px; width: 315px; height: 171px; border-radius: 33.5px; border-width: 3px; border-color: root.bevel; }
                for pr in [{ x: 100, y: 84, t: "LIGHT", a: 0 }, { x: 380, y: 84, t: "ALARM", a: 2 }, { x: 100, y: 226, t: "MODE", a: 0 }, { x: 380, y: 226, t: "ADJUST", a: 2 }]: Text {
                    x: (pr.a == 0 ? pr.x : pr.x - 100) * 1px; y: (pr.y - 8.6) * 1px; width: 100px; text: pr.t; font-size: 8px; font-weight: 700; letter-spacing: 1.2px;
                    color: root.print; horizontal-alignment: pr.a == 0 ? TextHorizontalAlignment.left : TextHorizontalAlignment.right; }
                Text { x: 190px; y: 75.4px; width: 100px; text: "QUARTZ"; font-size: 8px; font-weight: 700; letter-spacing: 2px; color: #FF4A1C; horizontal-alignment: center; }
                Rectangle { x: 103px; y: 91px; width: 274px; height: 124px; border-radius: 13px; background: root.lcd; border-width: 2px; border-color: #2e8f82.mix(#7d8a76, root.gk); }
                Text { x: 120px; y: 98px; text: root.weekday; font-size: 15px; font-weight: 700; letter-spacing: 1px; color: root.ink; }
                Text { x: 260px; y: 98px; width: 100px; text: root.date; font-size: 15px; font-weight: 700; color: root.ink; horizontal-alignment: right; }
                Text { x: 196px; y: 102.3px; text: "AL"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: root.ink; opacity: AlarmNow.next-h >= 0 ? 1 : 0.08; }
                Text { x: 222px; y: 102.3px; text: "SIG"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: root.ink; opacity: 0.08; }
                Seg7 { d: root.h >= 10 ? Math.floor(root.h / 10) : -1; x0: 124; y0: 124; w: 40; h: 66; t: 8; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.h, 10); x0: 172; y0: 124; w: 40; h: 66; t: 8; ink: root.ink; lag: true; }
                Seg7 { d: Math.floor(root.m / 10); x0: 238; y0: 124; w: 40; h: 66; t: 8; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.m, 10); x0: 286; y0: 124; w: 40; h: 66; t: 8; ink: root.ink; lag: true; }
                Seg7 { d: Math.floor(root.s / 10); x0: 334; y0: 162; w: 16; h: 28; t: 4; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.s, 10); x0: 352; y0: 162; w: 16; h: 28; t: 4; ink: root.ink; lag: true; }
                if root.ampm != "": Text { x: 336px; y: 134px; text: "PM"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: root.ink; opacity: root.ampm == "PM" ? 1 : 0.08; }
                Rectangle { x: 228.6px; y: 142.6px; width: 6.8px; height: 6.8px; border-radius: 3.4px; background: root.ink; opacity: root.colon; }
                Rectangle { x: 225.6px; y: 168.6px; width: 6.8px; height: 6.8px; border-radius: 3.4px; background: root.ink; opacity: root.colon; }
            }
            if !root.cased: Rectangle {
                Rectangle { x: 246px; y: 62px; width: 212px; height: 84px; border-radius: 12px; background: root.body; }
                Rectangle { x: 254px; y: 68px; width: 196px; height: 72px; border-radius: 8px; background: root.lcd; }
                Text { x: 264px; y: 72.3px; text: root.weekday; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: root.ink; }
                Text { x: 340px; y: 72.3px; width: 100px; text: root.date; font-size: 10px; font-weight: 700; color: root.ink; horizontal-alignment: right; }
                Seg7 { d: root.h >= 10 ? Math.floor(root.h / 10) : -1; x0: 266; y0: 92; w: 28; h: 42; t: 6; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.h, 10); x0: 300; y0: 92; w: 28; h: 42; t: 6; ink: root.ink; lag: true; }
                Seg7 { d: Math.floor(root.m / 10); x0: 352; y0: 92; w: 28; h: 42; t: 6; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.m, 10); x0: 386; y0: 92; w: 28; h: 42; t: 6; ink: root.ink; lag: true; }
                Seg7 { d: Math.floor(root.s / 10); x0: 420; y0: 114; w: 11; h: 20; t: 3; ink: root.ink; lag: true; }
                Seg7 { d: Math.mod(root.s, 10); x0: 432; y0: 114; w: 11; h: 20; t: 3; ink: root.ink; lag: true; }
                if root.ampm != "": Text { x: 421px; y: 96px; text: "PM"; font-size: 7px; font-weight: 700; letter-spacing: 0.5px; color: root.ink; opacity: root.ampm == "PM" ? 1 : 0.08; }
                Rectangle { x: 342.6px; y: 101.6px; width: 4.8px; height: 4.8px; border-radius: 2.4px; background: root.ink; opacity: root.colon; }
                Rectangle { x: 340.6px; y: 118.6px; width: 4.8px; height: 4.8px; border-radius: 2.4px; background: root.ink; opacity: root.colon; }
            }
        }
    }
    // the LCD's tap (outside the scaled frame, so it lands where the LCD is drawn)
    property <float> lx: root.cased ? 104 : 254;
    property <float> ly: root.cased ? 92 : 68;
    property <float> lw: root.cased ? 272 : 196;
    property <float> lh: root.cased ? 122 : 72;
    TouchArea {
        x: fr.x + fr.width / 2 + (root.lx - root.ox - root.fw / 2) * root.k * 1px; y: fr.y + fr.height / 2 + (root.ly - root.oy - root.fh / 2) * root.k * 1px;
        width: root.lw * root.k * 1px; height: root.lh * root.k * 1px;
        clicked => { root.glow = true; }
    }
}

// Style 10: the twin-bell alarm clock as a clock (boards C3, C4): hour, minute and second hands, the alarm hand at the
// next alarm (hidden when none is on), a contact shadow under the feet; when an alarm rings it rings too (the A1 shake).
// Native frame x 150..330, y 98..304 of the board.
export component TwinBellClock inherits Rectangle {
    in property <float> hours;            // 0..12
    in property <float> minutes;          // 0..60
    in property <float> seconds;          // 0..60
    in property <bool> show-seconds: true;
    in property <color> metal: #c9c6bf;
    in property <bool> highlight: true;   // the body's highlight arc (the clock; the A1 look has none)
    in property <bool> shadow: true;      // the contact shadow under the feet
    in property <bool> ting;              // 25.T10: the hammer taps the left bell once (150 ms) …
    in property <float> ting-t;           // … ms into it
    property <float> fw: 180;
    property <float> fh: 206;
    property <float> k: min(root.width / 1px / root.fw, root.height / 1px / root.fh);
    property <bool> ring: AlarmNow.ringing;
    property <int> rk: root.ring ? Math.mod(Math.floor(animation-tick() / 45ms), 2) : 0;
    property <float> sx: root.ring ? (root.rk == 1 ? 2.5 : -2.5) : 0;
    property <float> sy: root.ring ? (root.rk == 1 ? -1 : 1) : 0;
    property <float> bl: root.ring ? (root.rk == 1 ? -2 : 2) : 0;
    property <float> hx: root.ring ? (root.rk == 1 ? 228 : 252) : root.ting ? 240 - 12 * Math.sin(180deg * clamp(root.ting-t / 150, 0, 1)) : 240;
    property <float> jump: root.ting && root.ting-t > 50 && root.ting-t < 110 ? -1 : 0;
    property <angle> ha: root.hours / 12 * 360deg;
    property <angle> ma: root.minutes / 60 * 360deg;
    property <angle> sa: root.seconds / 60 * 360deg;
    property <angle> aa: Math.mod(AlarmNow.next-h, 12) / 12 * 360deg;
    pure function px(a: angle, r: float) -> float { 240 + r * Math.sin(a) }
    pure function py(a: angle, r: float) -> float { 210 - r * Math.cos(a) }
    fr := Rectangle {
        width: root.fw * 1px; height: root.fh * 1px;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        transform-scale-x: root.k; transform-scale-y: root.k; transform-origin: { x: self.width / 2, y: self.height / 2 };
        // the contact shadow stays on the ground
        if root.shadow: Path { x: -150px; y: -98px; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #000000; opacity: 0.45;
            commands: "M 167 296 A 73 6.7 0 1 0 313 296 A 73 6.7 0 1 0 167 296 Z"; }
        Rectangle { x: (root.sx - 150) * 1px; y: (root.sy - 98) * 1px; width: 480px; height: 480px;
            Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: root.metal; stroke-width: 6px; stroke-line-cap: round;
                commands: "M 204 132 Q 240 84 276 132"; }
            Rectangle { x: root.bl * 1px; y: root.jump * 1px; width: 480px; height: 480px;
                Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #FF4A1C; commands: "M 164.5 160.1 A 26 26 -36 0 1 206.6 129.6 Z"; }
                Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: #c8320c; stroke-width: 6px; stroke-line-cap: round; commands: "M 165.1 160.9 L 207.1 130.4"; }
                Rectangle { x: 165.1px; y: 118.2px; width: 8px; height: 8px; border-radius: 4px; background: root.metal; }
            }
            Rectangle { x: -root.bl * 1px; y: 0; width: 480px; height: 480px;
                Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: #FF4A1C; commands: "M 273.4 129.6 A 26 26 36 0 1 315.5 160.1 Z"; }
                Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: #c8320c; stroke-width: 6px; stroke-line-cap: round; commands: "M 272.9 130.4 L 314.9 160.9"; }
                Rectangle { x: 306.9px; y: 118.2px; width: 8px; height: 8px; border-radius: 4px; background: root.metal; }
            }
            Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: root.metal; stroke-width: 3px; stroke-line-cap: round;
                commands: "M 240 132 L " + root.hx + " 108"; }
            Rectangle { x: (root.hx - 6) * 1px; y: 100px; width: 12px; height: 12px; border-radius: 6px; background: root.metal; }
            Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: root.metal; stroke-width: 8px; stroke-line-cap: round;
                commands: "M 194 272 L 180 294 M 286 272 L 300 294"; }
            Rectangle { x: 152px; y: 122px; width: 176px; height: 176px; border-radius: 88px; background: #FF4A1C; border-width: 4px; border-color: #c8320c; }
            if root.highlight: Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: #ffffff; stroke-width: 4px; stroke-line-cap: round; opacity: 0.25;
                commands: "M 178 160 A 80 80 0 0 1 252 128"; }
            Rectangle { x: 168px; y: 138px; width: 144px; height: 144px; border-radius: 72px; background: #F5F3EE; }
            Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: transparent; stroke: #101114; stroke-width: 1px; stroke-line-cap: round;
