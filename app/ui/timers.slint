// Alarms, timers and stopwatch on one panel. Each function can be switched off; when more than one is
// on, tabs at the top switch between them (no separate panels).
// Colours: colourful (every timer and alarm its own vibrant colour, the app assigns them) or one colour
// (the panel colour) — one setting for the whole panel. Themes for the timers: 0 plain, 1 kitchen dial,
// 2 hourglass, 3 synthwave (four scenes with their own colours, no colour setting), 4 flip cards.
// Rings and lines are Paths (the software renderer draws arcs, it can't rotate or clip round). A Path
// fits its stroke inside its own box (the drawing shrinks by one stroke width and moves by half of it),
// so every stroked Path here gets a box one stroke width larger to keep its coordinates exact.
// Images are drawn at their exact size (the renderer scales without filtering). Coloured shapes are a
// white mask (colorize = the colour) with a grey + alpha shading layer on top.
import { Theme, Act, Clock, Words } from "theme.slint";
import { Icon, Glyph, PlayGlyph, GlowText, RollDigit, Dropdown, MenuHost, PageMenu } from "widgets.slint";
import { AlarmClock, AlarmEditor, AlarmSettings, AlarmRing } from "alarm_menus.slint";
import { WatchSettings } from "watch_menus.slint";
import { FlapCard } from "panels.slint";
import { NewTimerMenu, TimerSettingsMenu, LookFrame, TimerLooks, RollTime, ArcKey } from "timer_menus.slint";
import { ArcadeScreen, ArcadeBlock } from "arcade.slint";
import { Keyboard } from "overlays.slint";
import { Seg7, TwinBellClock } from "clocks.slint";

export struct TimerItem {
    label: string,      // "Pasta", "" when unnamed
    remaining: float,   // seconds
    total: float,       // seconds
    running: bool,      // false = paused
    tint: color,        // its colour (colourful mode) or the panel colour
}

export struct AlarmItem {
    time: string,       // "6:45"
    days: string,       // "Mon–Fri"
    label: string,      // "Wake up"
    on: bool,
    tint: color,        // its colour (colourful mode) or the panel colour
    hour: float,        // its time as hours of the day (6.75)
    soon: bool,         // on and due within 24 hours
}

// synthwave: a pixel car pulling away from the viewer along a floor line (the app sends one at a time:
// a random line, never the last one, a random 10–30 s from below the front edge to the horizon; the next
// one comes when it is gone)
export struct SwCar {
    line: float,        // which floor line (-4 … 4: 0 = the middle one, negative = left)
    kind: int,          // 0 wedge, 1 flat tail with four round lights, 2 rounded fastback, 3 louvre, 4 winged, 5 patrol (police)
    tint: color,        // its colour (random, vivid)
    born: float,        // the scene clock (seconds) when it appeared
    dur: float,         // seconds from below the front edge to the horizon
    pushed: bool,       // shoved by a tap (25.H5) …
    push-t: float,      // … at this scene time
    push-dir: float,    // … to this side (1 right, -1 left)
}

// text and line colour that follows the theme (the synthwave scene, the ringing screen, the flip box and the kitchen
// knob keep their own colours)
global TFg { out property <color> c: Theme.dark ? #ffffff : #101114; }

// A tab's entrance clock (25.T15, T16; the timers tab keeps its own, 25.T14): it starts every time `shown` turns on (the
// pager settles on the page with the tab open, the tab is picked, the screensaver or a ring ends) and runs once for
// `length`; while the tab is out of view it waits armed, and each look shows its zero.
component TabEntrance {
    in property <bool> shown;
    in property <duration> length: 1000ms;
    callback started();
    out property <bool> armed: true;
    property <bool> entering;
    property <duration> e0;
    function start() { root.armed = false; root.e0 = animation-tick(); root.entering = true; root.started(); }
    Timer { interval: root.length; running: root.entering; triggered => { root.entering = false; } }
    init => { if root.shown { root.start(); } }
    changed shown => { if root.shown { root.start(); } else { root.entering = false; root.armed = true; } }
    // ms into the entrance; large once it is over (the clock is read only while it runs)
    out property <float> ent: root.armed ? 0 : root.entering ? (animation-tick() - root.e0) / 1ms : 100000;
    out property <bool> calm: !root.armed && !root.entering;
}

component Ring inherits Rectangle {
    in property <float> fr;             // 0..1 of the circle, from the top, clockwise
    in property <length> stroke: 10px;
    in property <color> arc;
    in property <color> track: TFg.c.with-alpha(0.12);
    property <float> r: (self.width - self.stroke) / 2 / 1px;
    property <float> c: self.width / 2 / 1px;
    in property <float> left: -1;       // seconds left (the last ten pulse); -1: not a running timer
    // the app counts whole seconds: the arc glides from one to the next (linear, 1 s) instead of stepping; more time
    // (+1 min) refills it in 300 ms (M17)
    property <bool> refill;
    changed fr => { if root.fr > root.fr-s + 0.02 { root.refill = true; } }
    Timer { interval: 320ms; running: root.refill; triggered => { root.refill = false; } }
    property <float> fr-s: root.fr;
    animate fr-s { duration: root.refill ? 300ms : 1000ms; easing: linear; }
    // a new ring draws from nothing to full in 400 ms before it runs (M16)
    property <float> intro: 0;
    init => { root.intro = 1; root.aq = root.stepped(root.a); }
    animate intro { duration: 400ms; easing: ease-out; }
    // the page entrance (25.T14): the ring fills from empty to its fraction (the page sets the share, 0..1)
    in property <float> grow: 1;
    property <float> shown: min(root.intro, root.fr-s) * root.grow;
    property <angle> a: min(0.9999, max(0, root.shown)) * 360deg;
    // the arc as drawn: in steps of half a pixel along it, taken only when a step is passed (the glide moves it a
    // fraction of a pixel per frame; building the arc's path anew every frame cost several ms per ring)
    property <angle> step: max(0.05deg, 1rad * 0.5 / max(1, root.r));
    pure function stepped(x: angle) -> angle { Math.round(x / root.step) * root.step }
    property <angle> aq;
    changed a => { if Math.abs(root.stepped(root.a) - root.aq) > 0.001deg { root.aq = root.stepped(root.a); } }
    // the last ten seconds: the ring brightens with each second, a soft 300 ms pulse (M18)
    property <duration> pulse-t0;
    changed left => { if root.left > 0 && root.left <= 10 { root.pulse-t0 = animation-tick(); } }
    property <float> pulse: root.left > 0 && root.left <= 10.5 ? Math.pow(2.71828, -(animation-tick() - root.pulse-t0) / 300ms) : 0;
    Rectangle { border-radius: self.width / 2; border-width: root.stroke; border-color: root.track; }
    if root.shown > 0.001: Path {
        x: -root.stroke / 2; y: -root.stroke / 2; width: root.width + root.stroke; height: root.height + root.stroke;
        viewbox-width: root.width / 1px; viewbox-height: root.height / 1px;
        stroke: root.arc.brighter(0.45 * root.pulse); stroke-width: root.stroke;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.aq > 180deg ? "1" : "0") + " 1 "
            + (root.c + root.r * Math.sin(root.aq)) + " " + (root.c - root.r * Math.cos(root.aq));
    }
}

// One nixie tube's lit part (spec 24.4): the warm haze in the glass, all ten cathodes faint, the lit digit glowing orange
// (four strokes, no blur), never quite steady. The tube's fixed parts, the glass and the socket behind this and the anode
// mesh and the highlights in front of it, are NixieTubeBack and NixieTubeFront: the look draws them for all its tubes in
// one layer behind and one in front, so a frame draws only what lights.
component NixieTube inherits Rectangle {
    in property <int> d;
    in property <int> n;                  // which tube (its own flicker)
    in property <bool> steady;            // a running stopwatch: no flicker and no fade (the digits change too fast to see them)
    width: 54px; height: 140px;
    property <[string]> nx: ["M18 2 C30 2 34 16 34 36 C34 56 30 70 18 70 C6 70 2 56 2 36 C2 16 6 2 18 2 Z", "M11 13 L19 3 L19 70", "M4 16 C4 6 11 2 18 2 C27 2 32 8 32 17 C32 30 18 40 4 70 L33 70", "M4 4 L31 4 L16 30 C27 29 33 37 33 49 C33 62 26 70 17 70 C9 70 4 66 3 60", "M26 70 L26 2 L3 50 L34 50", "M31 3 L8 3 L5 32 C9 28 13 27 18 27 C28 27 33 35 33 48 C33 62 26 70 17 70 C9 70 4 66 3 60", "M28 6 C25 3 22 2 18 2 C8 2 3 14 3 40 C3 60 9 70 18 70 C27 70 33 62 33 52 C33 42 27 34 18 34 C10 34 4 40 3 48", "M3 3 L33 3 L13 70", "M18 34 C9 34 5 28 5 18 C5 8 11 2 18 2 C25 2 31 8 31 18 C31 28 27 34 18 34 C8 34 3 42 3 52 C3 63 10 70 18 70 C26 70 33 63 33 52 C33 42 28 34 18 34 Z", "M8 66 C11 69 14 70 18 70 C28 70 33 58 33 32 C33 12 27 2 18 2 C9 2 3 10 3 20 C3 30 9 38 18 38 C26 38 32 32 33 24"];
    // the glow's unsteadiness, 12 times a second (not every frame)
    property <float> ft;
    Timer { interval: 80ms; running: !root.steady; triggered => { root.ft = animation-tick() / 1ms; } }
    // the digit pictures (tools/nixie_digits.py), looked up by their path whenever a digit changes: the image cache then
    // gives every tube the one picture of that digit that is already on the GPU (a picture kept in a list property is a
    // copy of the file that is uploaded again every time it is shown anew)
    pure function glow(k: int) -> image { k == 1 ? @image-url("timers/nixie/digit-1.png") : k == 2 ? @image-url("timers/nixie/digit-2.png") : k == 3 ? @image-url("timers/nixie/digit-3.png") : k == 4 ? @image-url("timers/nixie/digit-4.png") : k == 5 ? @image-url("timers/nixie/digit-5.png") : k == 6 ? @image-url("timers/nixie/digit-6.png") : k == 7 ? @image-url("timers/nixie/digit-7.png") : k == 8 ? @image-url("timers/nixie/digit-8.png") : k == 9 ? @image-url("timers/nixie/digit-9.png") : @image-url("timers/nixie/digit-0.png") }
    pure function core(k: int) -> image { k == 1 ? @image-url("timers/nixie/digit-1-core.png") : k == 2 ? @image-url("timers/nixie/digit-2-core.png") : k == 3 ? @image-url("timers/nixie/digit-3-core.png") : k == 4 ? @image-url("timers/nixie/digit-4-core.png") : k == 5 ? @image-url("timers/nixie/digit-5-core.png") : k == 6 ? @image-url("timers/nixie/digit-6-core.png") : k == 7 ? @image-url("timers/nixie/digit-7-core.png") : k == 8 ? @image-url("timers/nixie/digit-8-core.png") : k == 9 ? @image-url("timers/nixie/digit-9-core.png") : @image-url("timers/nixie/digit-0-core.png") }
    property <float> f: 0.94 + 0.06 * Math.abs(Math.sin(1rad * (root.ft / 37 + root.n * 1.7)) * Math.sin(1rad * (root.ft / 91 + root.n)));
    // a digit change (25.T9): the old cathode dies over 120 ms while the new one lights over 60 ms
    property <int> cur: -1;
    property <int> old: -1;
    property <duration> t0;
    property <bool> fading;
    init => { root.cur = root.d; }
    changed d => { root.old = root.cur; root.cur = root.d; root.t0 = animation-tick(); root.fading = !root.steady; }
    // the lit digit follows `cur`, which changes only when the digit does: `d` is worked out again whenever the running
    // time moves, and a picture bound to it would be made anew in every tube at every step, not only where the digit
    // changed
    property <int> lit: root.cur >= 0 && root.cur <= 9 ? root.cur : 0;
    Timer { interval: 130ms; running: root.fading; triggered => { root.fading = false; } }
    property <float> since: root.fading ? (animation-tick() - root.t0) / 1ms : 1000;
    property <float> new-k: max(0.5, clamp(root.since / 60, 0, 1));
    property <float> old-k: root.old >= 0 && root.old <= 9 && root.old != root.cur ? 1 - clamp(root.since / 120, 0, 1) : 0;
    // (inside the glass outline, x 0-54 and y 0-132, which NixieTubeBack draws)
    Rectangle { x: 6px; y: 20px; width: 42px; height: 96px; background: @radial-gradient(circle, #ff6e14.with-alpha(0.22 * root.f) 0%, #ff6e1400 70%); }
    // the ten faint cathodes: drawn once into their own layer (the lit digit covers its own)
    Rectangle { cache-rendering-hint: true;
        for g[i] in root.nx: Path { x: 9px; y: 30px; width: 36px; height: 72px; viewbox-width: 36; viewbox-height: 72;
            stroke: #7a6655; stroke-width: 1.5px; stroke-line-cap: round; stroke-line-join: round; opacity: 0.32; commands: g; } }
    // the digit going out (the same pictures as the lit one)
    if root.old-k > 0: Image { x: 3px; y: 24px; width: 48px; height: 84px; source: root.glow(root.old); opacity: root.old-k * root.f; }
    if root.old-k > 0: Image { x: 3px; y: 24px; width: 48px; height: 84px; source: root.core(root.old); opacity: root.old-k; }
    // the lit digit: its glow (flickering) and its core, pictures of the four strokes (tools/nixie_digits.py): a
    // textured quad each, where four wide strokes per digit and frame kept the running stopwatch under 30 fps
    Image { x: 3px; y: 24px; width: 48px; height: 84px; source: root.glow(root.lit); opacity: root.steady ? 1 : root.new-k * root.f; }
    Image { x: 3px; y: 24px; width: 48px; height: 84px; source: root.core(root.lit); opacity: root.steady ? 1 : root.new-k; }
}

// A nixie tube's fixed parts behind its lit part: the glass with its faint sheen and rim, the socket.
component NixieTubeBack inherits Rectangle {
    width: 54px; height: 140px;
    Rectangle { x: 0; y: 0; width: 54px; height: 132px; border-radius: 26px; border-width: 1px; border-color: #ffffff29;
        background: @linear-gradient(90deg, #ffffff05 0%, #ffffff0f 22%, #ffffff04 50%, #ffffff0b 100%); }
    Rectangle { x: 4px; y: 128px; width: 46px; height: 12px; border-radius: 3px; background: #121010; border-width: 1px; border-color: #2a2522; }
}

// A nixie tube's fixed parts in front of its lit part: the 45° anode mesh and the glass highlights.
component NixieTubeFront inherits Rectangle {
    width: 54px; height: 132px;
    Path { x: 0; y: 0; width: 54px; height: 132px; viewbox-width: 54; viewbox-height: 132; stroke: #b08a6a; stroke-width: 0.6px; opacity: 0.32;
        commands: "M 43.0 14.0 L 47.0 18.0 M 11.0 14.0 L 7.0 18.0 M 34.0 14.0 L 47.0 27.0 M 20.0 14.0 L 7.0 27.0 M 25.0 14.0 L 47.0 36.0 M 29.0 14.0 L 7.0 36.0 M 16.0 14.0 L 47.0 45.0 M 38.0 14.0 L 7.0 45.0 M 7.0 14.0 L 47.0 54.0 M 47.0 14.0 L 7.0 54.0 M 7.0 23.0 L 47.0 63.0 M 47.0 23.0 L 7.0 63.0 M 7.0 32.0 L 47.0 72.0 M 47.0 32.0 L 7.0 72.0 M 7.0 41.0 L 47.0 81.0 M 47.0 41.0 L 7.0 81.0 M 7.0 50.0 L 47.0 90.0 M 47.0 50.0 L 7.0 90.0 M 7.0 59.0 L 47.0 99.0 M 47.0 59.0 L 7.0 99.0 M 7.0 68.0 L 47.0 108.0 M 47.0 68.0 L 7.0 108.0 M 7.0 77.0 L 47.0 117.0 M 47.0 77.0 L 7.0 117.0 M 7.0 86.0 L 39.0 118.0 M 47.0 86.0 L 15.0 118.0 M 7.0 95.0 L 30.0 118.0 M 47.0 95.0 L 24.0 118.0 M 7.0 104.0 L 21.0 118.0 M 47.0 104.0 L 33.0 118.0 M 7.0 113.0 L 12.0 118.0 M 47.0 113.0 L 42.0 118.0"; }
    Rectangle { x: 9px; y: 8px; width: 5px; height: 96px; border-radius: 3px; background: #ffffff21; }
    Rectangle { x: 20px; y: 2px; width: 14px; height: 6px; border-radius: 3px; background: #ffffff1a; }
}

// A straight stroke in the 480 × 480 screen frame (box grown by the stroke width, see above).
component Seg inherits Path {
    in property <float> x1;
    in property <float> y1;
    in property <float> x2;
    in property <float> y2;
    x: -self.stroke-width / 2; y: -self.stroke-width / 2;
    width: 480px + self.stroke-width; height: 480px + self.stroke-width;
    viewbox-width: 480; viewbox-height: 480;
    commands: "M " + root.x1 + " " + root.y1 + " L " + root.x2 + " " + root.y2;
}

// A glowing tube: wide faint halos, the colour, a white core; the unused part a dim tube.
component NeonRing inherits Rectangle {
    in property <float> fr;
    in property <length> stroke: 8px;
    in property <color> glow;
    in property <bool> paused;
    in property <float> grow: 1;          // the page entrance (25.T14): the share of the fraction shown
    property <float> k: root.paused ? 0.5 : 1;
    Ring { x: -6px; y: -6px; width: root.width + 12px; height: root.height + 12px; stroke: root.stroke + 12px; fr: 0; track: root.glow.with-alpha(0.05); }
    Ring { width: root.width; height: root.height; stroke: root.stroke; fr: 0; track: root.glow.with-alpha(0.16); }
    Ring { x: -12px; y: -12px; width: root.width + 24px; height: root.height + 24px; stroke: root.stroke + 24px; track: transparent; fr: root.fr; grow: root.grow; arc: root.glow.with-alpha(0.06 * root.k); }
    Ring { x: -6px; y: -6px; width: root.width + 12px; height: root.height + 12px; stroke: root.stroke + 12px; track: transparent; fr: root.fr; grow: root.grow; arc: root.glow.with-alpha(0.13 * root.k); }
    Ring { x: -2px; y: -2px; width: root.width + 4px; height: root.height + 4px; stroke: root.stroke + 4px; track: transparent; fr: root.fr; grow: root.grow; arc: root.glow.with-alpha(0.32 * root.k); }
    Ring { width: root.width; height: root.height; stroke: root.stroke; track: transparent; fr: root.fr; grow: root.grow; arc: root.paused ? root.glow.with-alpha(0.6) : root.glow; }
    Ring { x: root.stroke * 0.35; y: root.stroke * 0.35; width: root.width - root.stroke * 0.7; height: root.height - root.stroke * 0.7; stroke: root.stroke * 0.3;
        track: transparent; fr: root.fr; grow: root.grow; arc: #ffffff.with-alpha(0.8 * root.k); }
}

// Neon lettering: a soft coloured glow, a thin dark rim that follows the glyphs, a white core.
component NeonText inherits Rectangle {
    // drawn once into a layer; a live text (one that changes every second) is drawn directly
    in property <bool> live;
    cache-rendering-hint: !root.live;
    in property <string> text;
    in property <length> size: 52px;
    in property <int> weight: 300;
    in property <color> glow;
    in property <color> rim;
    in property <color> core: #ffffff;
    // what is drawn follows the inputs only when they really change: a parent whose data changes every second (a
    // running timer's row) re-evaluates them every second, which would rebuild the layer each time (a 40-50 ms frame)
    property <string> tx;
    property <length> sz;
    property <int> wt;
    property <color> gl;
    property <color> rm;
    property <color> cr;
    init => { root.tx = root.text; root.sz = root.size; root.wt = root.weight; root.gl = root.glow; root.rm = root.rim; root.cr = root.core; }
    changed text => { root.tx = root.text; }
    changed size => { root.sz = root.size; }
    changed weight => { root.wt = root.weight; }
    changed glow => { root.gl = root.glow; }
    changed rim => { root.rm = root.rim; }
    changed core => { root.cr = root.core; }
    for o in [{ x: -2.5, y: 0 }, { x: 2.5, y: 0 }, { x: 0, y: -2.5 }, { x: 0, y: 2.5 }]: Text {
        x: o.x * 1px; y: o.y * 1px; width: root.width; height: root.height; text: root.tx; font-size: root.sz; font-weight: root.wt;
        color: root.gl.with-alpha(0.38); horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    for o in [{ x: -1, y: -1 }, { x: 1, y: -1 }, { x: -1, y: 1 }, { x: 1, y: 1 }, { x: 0, y: -1.4 }, { x: 0, y: 1.4 }, { x: -1.4, y: 0 }, { x: 1.4, y: 0 }]: Text {
        x: o.x * 1px; y: o.y * 1px; width: root.width; height: root.height; text: root.tx; font-size: root.sz; font-weight: root.wt;
        color: root.rm; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    Text { width: root.width; height: root.height; text: root.tx; font-size: root.sz; font-weight: root.wt;
        color: root.cr; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
}

// A running time in neon, one cached layer per digit: each second only the digits that change are drawn again
// (the whole time as one live text re-set its 13 layers every second: a 40-50 ms frame over the moving scene).
// The cells are set only when they really change, so the others keep their layers.
component NeonClock inherits Rectangle {
    in property <float> t;                 // seconds left
    in property <length> size-short: 52px; // m:ss
    in property <length> size-long: 40px;  // h:mm:ss
    in property <int> weight: 400;
    in property <color> glow;
    in property <color> rim;
    property <bool> long;                  // h:mm:ss (else m:ss)
    property <string> c0;                  // the lead: minutes, or hours
    property <string> c2;
    property <string> c3;
    property <string> c5;
    property <string> c6;
    property <length> size: root.long ? root.size-long : root.size-short;
    function update() {
        let lg = root.t >= 3600;
        let c = Math.ceil(root.t);
        let mm = lg ? Math.mod(Math.floor(c / 60), 60) : Math.floor(c / 60);
        let ss = Math.mod(c, 60);
        let l0 = lg ? "" + Math.floor(root.t / 3600) : "" + mm;
        let a = lg ? "" + Math.floor(mm / 10) : "" + Math.floor(ss / 10);
        let b = lg ? "" + Math.mod(mm, 10) : "" + Math.mod(ss, 10);
        if root.long != lg { root.long = lg; }
        if root.c0 != l0 { root.c0 = l0; }
        if root.c2 != a { root.c2 = a; }
        if root.c3 != b { root.c3 = b; }
        if lg && root.c5 != "" + Math.floor(ss / 10) { root.c5 = "" + Math.floor(ss / 10); }
        if lg && root.c6 != "" + Math.mod(ss, 10) { root.c6 = "" + Math.mod(ss, 10); }
    }
    init => { root.update(); }
    changed t => { root.update(); }
    property <length> dw: p-digit.preferred-width;
    property <length> cw: p-colon.preferred-width;
    property <length> lw: p-lead.preferred-width;
    property <length> total: root.long ? root.lw + 2 * root.cw + 4 * root.dw : root.lw + root.cw + 2 * root.dw;
    property <length> x0: (root.width - root.total) / 2 - 4px;   // 4 px either side of a cell for the glow
    p-digit := Text { visible: false; text: "0"; font-size: root.size; font-weight: root.weight; }
    p-colon := Text { visible: false; text: ":"; font-size: root.size; font-weight: root.weight; }
    p-lead := Text { visible: false; text: root.c0; font-size: root.size; font-weight: root.weight; }
    NeonText { x: root.x0; width: root.lw + 8px; height: root.height; text: root.c0; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    NeonText { x: root.x0 + root.lw; width: root.cw + 8px; height: root.height; text: ":"; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    NeonText { x: root.x0 + root.lw + root.cw; width: root.dw + 8px; height: root.height; text: root.c2; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    NeonText { x: root.x0 + root.lw + root.cw + root.dw; width: root.dw + 8px; height: root.height; text: root.c3; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    if root.long: NeonText { x: root.x0 + root.lw + root.cw + 2 * root.dw; width: root.cw + 8px; height: root.height; text: ":"; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    if root.long: NeonText { x: root.x0 + root.lw + 2 * root.cw + 2 * root.dw; width: root.dw + 8px; height: root.height; text: root.c5; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
    if root.long: NeonText { x: root.x0 + root.lw + 2 * root.cw + 3 * root.dw; width: root.dw + 8px; height: root.height; text: root.c6; size: root.size; weight: root.weight; glow: root.glow; rim: root.rim; }
}

component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 56px;
    in property <length> icon-size: 28px;
    in property <color> fill: TFg.c.with-alpha(0.12);
    in property <color> ink: TFg.c;
    in property <bool> outline;
    in property <color> line: TFg.c.with-alpha(0.30);
    in property <length> ring-w;       // a ring around the round button (its own, so it squishes with it)
    in property <color> ring-c;
    in property <string> act;          // what a tap does (Act), with `act-value`
    in property <string> act-value;
    width: self.size; height: self.size;
    // a press squishes it to 0.95 (60 ms) and springs it back with a small overshoot (M1)
    property <float> sq: rb-touch.pressed ? 0.95 : 1;
    animate sq { duration: rb-touch.pressed ? 60ms : 180ms; easing: cubic-bezier(0.34, 1.6, 0.64, 1); }
    Rectangle {
        x: root.size * (1 - root.sq) / 2; y: self.x; width: root.size * root.sq; height: self.width; border-radius: self.width / 2;
        background: root.outline ? transparent : root.fill;
        border-width: root.ring-w > 0 ? root.ring-w : root.outline ? 1.5px : 0px; border-color: root.ring-w > 0 ? root.ring-c : root.line;
    }
    // play / pause morph into each other (M13); every other icon as it is
    property <bool> pp: root.icon == "\u{F040A}" || root.icon == "\u{F03E4}";
    if root.pp: PlayGlyph { x: (parent.width - root.icon-size * 96 / 62) / 2; y: (parent.height - root.icon-size * 96 / 62) / 2;
        width: root.icon-size * 96 / 62; height: self.width; playing: root.icon == "\u{F03E4}"; ink: root.ink; }
    if !root.pp: Icon { width: parent.width; height: parent.height; text: root.icon; font-size: root.icon-size; color: root.ink; }
    rb-touch := TouchArea { clicked => { if root.act != "" { Act.act(root.act, root.act-value); } } }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <length> h: 48px;
    in property <color> fill: TFg.c.with-alpha(0.12);
    in property <color> ink: TFg.c;
    in property <color> line: transparent;
    in property <length> font-size: 16px;
    in property <string> act;
    in property <string> act-value;
    height: self.h; width: t.preferred-width + 36px; border-radius: self.h / 2; background: root.fill;
    border-width: root.line == transparent ? 0px : 1.5px; border-color: root.line;
    opacity: p-touch.pressed ? 0.6 : 1;
    t := Text { x: 18px; width: self.preferred-width; height: parent.height; text: root.text; font-size: root.font-size; font-weight: 600; color: root.ink; vertical-alignment: center; }
    p-touch := TouchArea { clicked => { if root.act != "" { Act.act(root.act, root.act-value); } } }
}

// +1 min · play / pause · remove, centred on a row
component TimerControls inherits HorizontalLayout {
    in property <bool> running;
    in property <color> tint;
    in property <length> play: 64px;
    in property <bool> neon;
    in property <int> index;
    alignment: center; spacing: 20px;
    VerticalLayout { alignment: center; Pill { act: "timers.add"; act-value: root.index; text: "+1 min"; h: 44px; ink: root.neon ? #ffffff : TFg.c; fill: root.neon ? #00000059 : TFg.c.with-alpha(0.12); line: root.neon ? root.tint.with-alpha(0.7) : transparent; } }
    RoundButton { size: root.play; icon-size: root.play * 0.52; fill: root.neon ? #00000059 : root.tint; ink: root.neon ? root.tint.mix(#ffffff, 0.6) : #ffffff; outline: false;
        ring-w: root.neon ? 2px : 0px; ring-c: root.tint;
        icon: root.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: root.index; }
    VerticalLayout { alignment: center; RoundButton { act: "timers.cancel"; act-value: root.index; size: 44px; icon-size: 22px; fill: root.neon ? #00000059 : transparent; outline: !root.neon; ink: root.neon ? #ffffff : TFg.c;
        ring-w: 1.5px; ring-c: root.neon ? root.tint.with-alpha(0.6) : TFg.c.with-alpha(0.30); icon: "\u{F0156}"; } }
}

// The alarms as chips (twin-bell, sunrise, 24-hour dial): a dot in the alarm's colour (filled while on), its time and
// days; two to a row, further rows scroll, so every alarm can be reached. A tap switches it on or off; a hold of 500 ms
// opens it in the editor (its dot blinks twice while held; it opens on release).
component AlarmChips inherits Rectangle {
    in property <[AlarmItem]> alarms;
    in property <color> fill;
    in property <color> ink;
    in property <color> fade-to: transparent;   // the page's ground: more rows below fade into it
    callback toggled(int);
    callback edit(int);
    property <length> cw: (root.width - 8px) / 2;
    property <int> rows: Math.ceil(root.alarms.length / 2);
    fl := Flickable {
        width: root.width; height: root.height;
        content-height: Math.max(self.height, root.rows * 48px - 8px);
        interactive: root.rows * 48px - 8px > self.height;
        for a[i] in root.alarms: chip := Rectangle {
            x: root.alarms.length == 1 ? (root.width - root.cw) / 2 : Math.mod(i, 2) * (root.cw + 8px);
            y: Math.floor(i / 2) * 48px;
            width: root.cw; height: 40px; border-radius: 20px; background: root.fill; opacity: a.on ? 1 : 0.5;
            property <bool> down;
            property <bool> held;
            property <duration> t0;
            Timer { interval: 500ms; running: chip.down && !chip.held; triggered => { chip.held = true; } }
            property <bool> blink: chip.down && !chip.held && Math.mod(Math.floor((animation-tick() - chip.t0) / 125ms), 2) == 1;
            Rectangle { x: 12px; y: (parent.height - 8px) / 2; width: 8px; height: 8px; border-radius: 4px; background: a.on ? a.tint : transparent;
                border-width: 1.5px; border-color: a.tint; opacity: chip.blink ? 0 : 1; }
            tm := Text { x: 26px; height: parent.height; text: AlarmClock.of(a.hour); font-size: 14px; font-weight: 600; color: root.ink; vertical-alignment: center; }
            property <length> dx: 26px + tm.preferred-width + 8px;
            probe := Text { visible: false; text: a.days; font-size: 13px; font-weight: 500; }
            Text { x: chip.dx; width: parent.width - chip.dx - 12px; height: parent.height; text: a.days;
                font-size: probe.preferred-width <= parent.width - chip.dx - 12px ? 13px : 11px; font-weight: 500;
                color: root.ink.with-alpha(0.75); vertical-alignment: center; wrap: word-wrap; }
            TouchArea {
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        chip.down = true;
                        chip.held = false;
                        chip.t0 = animation-tick();
                    } else if ev.kind == PointerEventKind.up && chip.down {
                        chip.down = false;
                        if chip.held { root.edit(i); } else { root.toggled(i); }
                        chip.held = false;
                    } else if ev.kind == PointerEventKind.cancel {
                        chip.down = false;
                        chip.held = false;
                    }
                }
            }
        }
    }
    // more below: a soft fade at the foot (until the list is scrolled to its end)
    if root.fade-to != transparent && fl.content-y > fl.height - fl.content-height + 2px: Rectangle {
        y: root.height - 22px; height: 22px; background: @linear-gradient(180deg, root.fade-to.with-alpha(0) 0%, root.fade-to 100%); }
}

// The synthwave scene: sky, floor with lines gliding towards the viewer, a shooting star now and then
// (stars scene), pixel cars pulling away, swaying palms (beach). Used by the timers page and, with a
// day / night crossfade, by the home page background.
export component SynthScene inherits Rectangle {
    in property <image> back;              // sky (480 x 330)
    in property <image> floor;             // floor (480 x 150)
    in property <image> back2;             // second sky / floor faded in on top by mix (home page: night)
    in property <image> floor2;
    in property <float> mix;
    in property <image> back3;             // the beach's dawn view, over the night view by mix3 (morning twilight)
    in property <image> floor3;
    in property <float> mix3;
    in property <int> scene;               // 0 sunset, 1 city, 2 beach, 3 stars
    in property <color> grid;              // the moving floor lines
    in property <float> t;                 // seconds (the floor glides 1.2 line spacings per second)
    in property <[SwCar]> cars;
    in property <image> palm-l;
    in property <image> palm-r;
    in property <image> palm-l2;           // the next frame, over the first at the fraction (smooth sway)
    in property <image> palm-r2;
    in property <float> palm-lk;
    in property <float> palm-rk;
    in property <float> star-k: 1;         // shooting star strength (home page: only at night)
    in property <bool> taps;               // 25.H4 / H5: the home background answers taps (sky: a shooting star, road: a car, a car: a shove)
    in property <float> pulse-t: -1;       // 25.T4: ms into the neon pulse running from the horizon to the front (600 ms), -1 none
    // the sky and the floor; during a crossfade (home page: day <-> night) the second pair on top
    if root.mix < 0.999: Image { x: 0; y: 0; width: 480px; height: 330px; source: root.back; }
    if root.mix < 0.999: Image { x: 0; y: 330px; width: 480px; height: 150px; source: root.floor; }
    if root.mix > 0.001: Image { x: 0; y: 0; width: 480px; height: 330px; source: root.back2; opacity: root.mix; }
    if root.mix > 0.001: Image { x: 0; y: 330px; width: 480px; height: 150px; source: root.floor2; opacity: root.mix; }
    if root.mix * root.mix3 > 0.001: Image { x: 0; y: 0; width: 480px; height: 330px; source: root.back3; opacity: root.mix * root.mix3; }
    if root.mix * root.mix3 > 0.001: Image { x: 0; y: 330px; width: 480px; height: 150px; source: root.floor3; opacity: root.mix * root.mix3; }
    // floor lines gliding towards the viewer (one line spacing every 0.83 s)
    for k in 18: fl := Rectangle {
        property <float> d: 0.7 * (k + 1 - (root.t * 1.2 - Math.floor(root.t * 1.2))) + 0.3;
        property <float> yy: 330 + 150 / self.d;
        // the newest (farthest) line fades in over its first spacing instead of appearing at once; lines sit
        // at their exact (sub-pixel) place so the slow far ones glide instead of stepping a pixel at a time
        property <float> a: max(0.1, min(1, (self.yy - 331) / 70)) * (k == 17 ? root.t * 1.2 - Math.floor(root.t * 1.2) : 1);
        visible: self.yy < 481 && self.yy > 332;
        x: 0; y: (self.yy - 2) * 1px; width: 480px; height: 5px;
        background: root.grid.with-alpha(0.10 * self.a);
        Rectangle { y: 1px; height: 3px; background: root.grid.with-alpha(0.22 * fl.a); }
        Rectangle { y: 2px; height: fl.yy > 410 ? 2px : 1px; background: root.grid.with-alpha(0.9 * fl.a); }
    }
    // the neon pulse: a bright band in the grid's colour, speeding up towards the viewer like the floor lines
    if root.pulse-t >= 0 && root.pulse-t < 600: Rectangle {
        property <float> k: root.pulse-t / 600;
        property <float> yy: 330 + 150 * self.k * self.k;
        property <float> h: 3 + 15 * self.k;
        x: 0; y: (self.yy - self.h) * 1px; width: 480px; height: self.h * 2px;
        background: @linear-gradient(180deg, root.grid.with-alpha(0) 0%, root.grid.with-alpha(0.55) 50%, root.grid.with-alpha(0) 100%);
        Rectangle { y: parent.height / 2 - 1px; height: 2px; background: root.grid.mix(#ffffff, 0.5); }
    }
    // shooting star now and then (stars scene, every 10 s)
    property <float> sh: (root.t / 10) - Math.floor(root.t / 10);
    if root.scene == 3 && root.sh < 0.16 && root.star-k > 0.01: star := Rectangle {
        opacity: root.star-k;
        property <float> p: root.sh / 0.16;
        property <float> hx: 270 + self.p * 200;
        property <float> hy: 112 + self.p * 52;
        Seg { stroke: #ffffff26; stroke-width: 3px; x1: star.hx - 64; y1: star.hy - 18; x2: star.hx; y2: star.hy; }
        Seg { stroke: #ffffffb3; stroke-width: 1.4px; x1: star.hx - 40; y1: star.hy - 11; x2: star.hx; y2: star.hy; }
        Rectangle { x: (star.hx - 1.5) * 1px; y: (star.hy - 1.5) * 1px; width: 3px; height: 3px; border-radius: 1.5px; background: #ffffff; }
    }
    // 25.H4: a tap on the sky sends a shooting star from there (0.6 s); a tap on the road asks for a car in that lane
    property <float> tap-x;
    property <float> tap-y;
    property <bool> tap-star;
    property <duration> tap-t0;
    Timer { interval: 620ms; running: root.tap-star; triggered => { root.tap-star = false; } }
    if root.taps: TouchArea {
        clicked => {
            if self.mouse-y < 330px {
                root.tap-x = self.mouse-x / 1px; root.tap-y = self.mouse-y / 1px; root.tap-t0 = animation-tick(); root.tap-star = true;
            } else {
                Act.act("synth.lane", (self.mouse-x / 1px) + ":" + (self.mouse-y / 1px));
            }
        }
    }
    if root.tap-star: tstar := Rectangle {
        property <float> p: clamp((animation-tick() - root.tap-t0) / 600ms, 0, 1);
        property <float> hx: root.tap-x + self.p * 150;
        property <float> hy: root.tap-y + self.p * 40;
        opacity: 1 - self.p * self.p;
        Seg { stroke: #ffffff26; stroke-width: 3px; x1: tstar.hx - 64 * min(1, tstar.p * 4); y1: tstar.hy - 18 * min(1, tstar.p * 4); x2: tstar.hx; y2: tstar.hy; }
        Seg { stroke: #ffffffb3; stroke-width: 1.4px; x1: tstar.hx - 40 * min(1, tstar.p * 4); y1: tstar.hy - 11 * min(1, tstar.p * 4); x2: tstar.hx; y2: tstar.hy; }
        Rectangle { x: (tstar.hx - 1.5) * 1px; y: (tstar.hy - 1.5) * 1px; width: 3px; height: 3px; border-radius: 1.5px; background: #ffffff; }
    }
    // the car kinds' layers (paint takes the car's colour; the patrol car's paint is empty: its livery is fixed)
    property <[image]> car-paint: [@image-url("timers/sw/pcar-0-paint.png"), @image-url("timers/sw/pcar-1-paint.png"), @image-url("timers/sw/pcar-2-paint.png"), @image-url("timers/sw/pcar-3-paint.png"), @image-url("timers/sw/pcar-4-paint.png"), @image-url("timers/sw/pcar-5-paint.png")];
    property <[image]> car-shade: [@image-url("timers/sw/pcar-0-shade.png"), @image-url("timers/sw/pcar-1-shade.png"), @image-url("timers/sw/pcar-2-shade.png"), @image-url("timers/sw/pcar-3-shade.png"), @image-url("timers/sw/pcar-4-shade.png"), @image-url("timers/sw/pcar-5-shade.png")];
    property <[image]> car-fixed: [@image-url("timers/sw/pcar-0-fixed.png"), @image-url("timers/sw/pcar-1-fixed.png"), @image-url("timers/sw/pcar-2-fixed.png"), @image-url("timers/sw/pcar-3-fixed.png"), @image-url("timers/sw/pcar-4-fixed.png"), @image-url("timers/sw/pcar-5-fixed.png")];
    // 25.H5: the three-quarter sprites, nose left (yaw) and nose right (yawr)
    property <[image]> yaw-paint: [@image-url("timers/sw/pcar-0-yaw-paint.png"), @image-url("timers/sw/pcar-1-yaw-paint.png"), @image-url("timers/sw/pcar-2-yaw-paint.png"), @image-url("timers/sw/pcar-3-yaw-paint.png"), @image-url("timers/sw/pcar-4-yaw-paint.png"), @image-url("timers/sw/pcar-5-yaw-paint.png")];
    property <[image]> yaw-shade: [@image-url("timers/sw/pcar-0-yaw-shade.png"), @image-url("timers/sw/pcar-1-yaw-shade.png"), @image-url("timers/sw/pcar-2-yaw-shade.png"), @image-url("timers/sw/pcar-3-yaw-shade.png"), @image-url("timers/sw/pcar-4-yaw-shade.png"), @image-url("timers/sw/pcar-5-yaw-shade.png")];
    property <[image]> yaw-fixed: [@image-url("timers/sw/pcar-0-yaw-fixed.png"), @image-url("timers/sw/pcar-1-yaw-fixed.png"), @image-url("timers/sw/pcar-2-yaw-fixed.png"), @image-url("timers/sw/pcar-3-yaw-fixed.png"), @image-url("timers/sw/pcar-4-yaw-fixed.png"), @image-url("timers/sw/pcar-5-yaw-fixed.png")];
    property <[image]> yawr-paint: [@image-url("timers/sw/pcar-0-yawr-paint.png"), @image-url("timers/sw/pcar-1-yawr-paint.png"), @image-url("timers/sw/pcar-2-yawr-paint.png"), @image-url("timers/sw/pcar-3-yawr-paint.png"), @image-url("timers/sw/pcar-4-yawr-paint.png"), @image-url("timers/sw/pcar-5-yawr-paint.png")];
    property <[image]> yawr-shade: [@image-url("timers/sw/pcar-0-yawr-shade.png"), @image-url("timers/sw/pcar-1-yawr-shade.png"), @image-url("timers/sw/pcar-2-yawr-shade.png"), @image-url("timers/sw/pcar-3-yawr-shade.png"), @image-url("timers/sw/pcar-4-yawr-shade.png"), @image-url("timers/sw/pcar-5-yawr-shade.png")];
    property <[image]> yawr-fixed: [@image-url("timers/sw/pcar-0-yawr-fixed.png"), @image-url("timers/sw/pcar-1-yawr-fixed.png"), @image-url("timers/sw/pcar-2-yawr-fixed.png"), @image-url("timers/sw/pcar-3-yawr-fixed.png"), @image-url("timers/sw/pcar-4-yawr-fixed.png"), @image-url("timers/sw/pcar-5-yawr-fixed.png")];
    // pixel cars pulling away along a floor line, big near, smaller towards the horizon (far ones first)
    for c in root.cars: car := Rectangle {
        // a shove (25.H5): pt seconds into it (2.5 s); it slows to 60 % (the time it loses moves it back on its trip), slides
        // 1.25 lanes away from the tap and steers back; yawed away from the tap while it slides, the other way as it steers back
        property <float> pt: c.pushed ? root.t - c.push-t : 100;
        property <bool> skid: c.pushed && self.pt >= 0 && self.pt < 2.5;
        property <float> lost: !c.pushed || self.pt < 0 ? 0 : self.pt < 2.5 ? 0.4 * (2.5 / 3.1416) * (1 - Math.cos(180deg * self.pt / 2.5)) : 0.4 * 2 * 2.5 / 3.1416;
        property <float> slide: !car.skid ? 0 : car.pt < 0.9 ? 1.25 * (1 - Math.pow(1 - car.pt / 0.9, 2))
            : 1.25 * (1 - (car.pt - 0.9) / 1.6 * (car.pt - 0.9) / 1.6 * (3 - 2 * (car.pt - 0.9) / 1.6));
        // 0 straight, 1 nose right, -1 nose left
        property <int> yaw: !car.skid ? 0 : car.pt < 0.9 ? (c.push-dir > 0 ? 1 : -1) : car.pt < 1.5 ? (c.push-dir > 0 ? -1 : 1) : 0;
        // depth: 0.46 = still under the bottom edge … 1 = tyres on the edge, 176 px wide … 60 = 3 px, gone
        property <float> age: max(0, root.t - c.born - self.lost);
        property <float> d: 0.46 * Math.pow(60 / 0.46, min(1, self.age / max(1, c.dur)));
        property <float> sp: 43.8 / self.d + 2.2;           // floor line spacing at this depth
        property <float> s: 176 / 48 / car.d;                // sprite scale: 176 px wide at d 1, shrinking to nothing
        property <float> cx: 240 + (c.line + c.push-dir * self.slide) * self.sp;         // on its line
        property <float> gy: 330 + 150 / car.d;              // ground under the tyres
        property <float> sm: max(0, min(1, (1.8 - car.d) / 0.8));  // smoke only while it pulls away (near)
        // it fades out over the last 6 % of the trip (a few pixels wide by then) instead of vanishing
        property <float> fade: max(0, min(1, (1 - min(1, self.age / max(1, c.dur))) / 0.06));
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            opacity: car.fade;
            source: car.yaw == 0 ? root.car-paint[c.kind] : car.yaw > 0 ? root.yawr-paint[c.kind] : root.yaw-paint[c.kind];
            colorize: c.tint; }
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            opacity: car.fade;
            source: car.yaw == 0 ? root.car-shade[c.kind] : car.yaw > 0 ? root.yawr-shade[c.kind] : root.yaw-shade[c.kind]; }
        if car.d < 59.9: Image { x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            opacity: car.fade;
            source: car.yaw == 0 ? root.car-fixed[c.kind] : car.yaw > 0 ? root.yawr-fixed[c.kind] : root.yaw-fixed[c.kind]; }
        // a tap on the car shoves it away from the tap (a fresh shove while it skids)
        if root.taps && car.d < 6: TouchArea { x: (car.cx - 26 * car.s) * 1px; y: (car.gy - 24 * car.s) * 1px; width: 52px * car.s; height: 28px * car.s;
            clicked => { Act.act("synth.push", c.born + ":" + (self.mouse-x < self.width / 2 ? 1 : -1)); } }
        // heavy tyre smoke while it skids: 14 squares from both rear tyres, 2-6 sprite pixels, drifting back and outwards (0.8 s)
        if car.skid && car.pt < 1.6: Rectangle {
            for p in 14: Rectangle {
                property <float> side: Math.mod(p, 2) == 0 ? -1 : 1;
                property <float> ph: car.pt * 1.25 + p / 14 - Math.floor(car.pt * 1.25 + p / 14);
                property <float> sz: Math.round((2 + Math.mod(p * 7, 5)) * (0.8 + 0.4 * self.ph) * car.s);
                x: (car.cx + self.side * (17 + 12 * self.ph) * car.s - self.sz / 2) * 1px;
                y: (car.gy - 3 * car.s + self.ph * 12 * car.s - self.sz / 2) * 1px;
                width: self.sz * 1px; height: self.sz * 1px;
                background: #e6dcf5.with-alpha(0.6 * (1 - self.ph) * car.fade);
            }
        }
        // the patrol car's light bar: red flashes twice (on 70 ms, off 60, on 70, off 120), then blue the same
        property <float> fp: Math.mod(car.age, 0.64);
        // (the overlays stay; only their opacity flashes)
        if c.kind == 5 && car.d < 59.9: Image {
            x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            opacity: car.fp < 0.07 || (car.fp >= 0.13 && car.fp < 0.20) ? car.fade : 0;
            source: car.yaw == 0 ? @image-url("timers/sw/pcar-5-flash-red.png") : car.yaw > 0 ? @image-url("timers/sw/pcar-5-yawr-flash-red.png") : @image-url("timers/sw/pcar-5-yaw-flash-red.png"); }
        if c.kind == 5 && car.d < 59.9: Image {
            x: (car.cx - 24 * car.s) * 1px; y: (car.gy - 22 * car.s) * 1px; width: 48px * car.s; height: 24px * car.s; image-rendering: pixelated;
            opacity: (car.fp >= 0.32 && car.fp < 0.39) || (car.fp >= 0.45 && car.fp < 0.52) ? car.fade : 0;
            source: car.yaw == 0 ? @image-url("timers/sw/pcar-5-flash-blue.png") : car.yaw > 0 ? @image-url("timers/sw/pcar-5-yawr-flash-blue.png") : @image-url("timers/sw/pcar-5-yaw-flash-blue.png"); }
        // a little pixel smoke from the rear tyres, drifting towards the viewer
        if car.sm > 0: Rectangle {
            for p in 6: Rectangle {
                property <float> side: p < 3 ? -1 : 1;
                property <float> ph: car.age * 2 + Math.mod(p, 3) / 3 - Math.floor(car.age * 2 + Math.mod(p, 3) / 3);
                property <float> sz: Math.round((1 + 2 * self.ph) * car.s);
                x: (car.cx + self.side * (17 + 3 * self.ph) * car.s - self.sz / 2) * 1px;
                y: (car.gy - 3 * car.s + self.ph * 7 * car.s - self.sz / 2) * 1px;
                width: self.sz * 1px; height: self.sz * 1px;
                background: #e6dcf5.with-alpha(0.5 * (1 - self.ph) * car.sm);
            }
        }
    }
    // swaying palms (beach)
    if root.scene == 2: Image { x: -34px; y: 112px; width: 210px; height: 300px; source: root.palm-l; }
    if root.scene == 2: Image { x: -34px; y: 112px; width: 210px; height: 300px; source: root.palm-l2; opacity: root.palm-lk; }
    if root.scene == 2: Image { x: 304px; y: 112px; width: 210px; height: 300px; source: root.palm-r; }
    if root.scene == 2: Image { x: 304px; y: 112px; width: 210px; height: 300px; source: root.palm-r2; opacity: root.palm-rk; }
}

// One timer's menu (spec 34): where the plain and synthwave grids show several timers, a tap on one opens it over its
// cell: the name in its colour, a 124 px ring with the time and "of 10:00" / "Paused", the agreed timer controls. It counts
// down live; × cancels the timer and the menu goes. Plain: the brand card (300 px) growing from the cell's centre;
// synthwave: the arcade screen (320 px) with the name as its chrome title and the controls as arcade keys.
component TimerMenu inherits Rectangle {
    in property <bool> arcade;
    in property <TimerItem> t;
    in property <color> tint;              // its colour as the page shows it (synthwave: its place's neon)
    in property <color> tube;
    in property <int> index;
    in property <float> t-in: 1000;
    in property <float> t-out;
    in property <bool> leaving;
    in property <length> grow-x;
    in property <length> grow-y;
    in property <length> name-h;           // the name's height (TimersPage measures it for the menu's size)
    pure function two(n: int) -> string { return (n < 10 ? "0" : "") + n; }
    pure function clock(t: float) -> string {
        return t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(Math.ceil(t) / 60), 60)) + ":" + root.two(Math.mod(Math.ceil(t), 60))
            : Math.floor(Math.ceil(t) / 60) + ":" + root.two(Math.mod(Math.ceil(t), 60));
    }
    property <string> name: root.t.label != "" ? root.t.label : "Timer";
    property <float> fr: root.t.total > 0 ? root.t.remaining / root.t.total : 0;
    // plain: the brand card with the name, the ring with the time, +1 min · pause / go on · cancel
    if !root.arcade: LookFrame {
        width: root.width; height: root.height;
        look: 0; sk: TimerLooks.skin(0); title: "";
        t-in: root.t-in; t-out: root.t-out; leaving: root.leaving;
        grow-x: root.grow-x; grow-y: root.grow-y;
        Rectangle {
            property <length> ry: 6px + 8px + root.name-h + 8px;
            Text { x: 16px; y: 6px + 8px; width: root.width - 32px; height: root.name-h; text: root.name; font-size: 16px; font-weight: 600; wrap: word-wrap;
                color: root.tint.mix(TFg.c, 0.6); horizontal-alignment: center; vertical-alignment: center; }
            Ring { x: (root.width - 124px) / 2; y: parent.ry; width: 124px; height: 124px; stroke: 8px; fr: root.fr; arc: root.tint;
                opacity: root.t.running ? 1 : 0.55; left: root.t.running ? Math.ceil(root.t.remaining) : -1; }
            RollTime { x: 0; y: parent.ry + 62px - 26px; width: root.width; height: 38px; t: root.t.remaining; size: root.t.remaining >= 3600 ? 24px : 30px;
                weight: 600; color: TFg.c; }
            Text { x: 0; y: parent.ry + 62px + 13px; width: root.width; height: 16px; text: root.t.running ? "of " + root.clock(root.t.total) : "Paused";
                font-size: 12px; color: TFg.c.with-alpha(0.55); horizontal-alignment: center; vertical-alignment: center; }
            TimerControls { x: 0; y: parent.ry + 124px + 10px; width: root.width; height: 56px; play: 56px; running: root.t.running; tint: root.tint; index: root.index; }
        }
    }
    // synthwave: the arcade screen with the name as its title, the neon ring, the time in the pixel font, the controls as
    // arcade keys (+1 MIN at 28 %, pause / go on in the timer's neon, cancel outlined)
    if root.arcade: ArcadeScreen {
        width: root.width; height: root.height;
        tube: root.tube; title: root.name.to-uppercase(); t-in: root.t-in; t-out: root.t-out; leaving: root.leaving;
        TouchArea { }
        Rectangle {
            NeonRing { x: (parent.width - 124px) / 2; y: 0; width: 124px; height: 124px; stroke: 8px; glow: root.tint; paused: !root.t.running; fr: root.fr; }
            Text { x: 0; y: 62px - 16px; width: parent.width; height: 22px; text: root.clock(root.t.remaining); font-family: "Press Start 2P";
                font-size: root.t.remaining >= 3600 ? 13px : 17px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
            Text { x: 0; y: 62px + 10px; width: parent.width; height: 14px; text: root.t.running ? "OF " + root.clock(root.t.total) : "PAUSED";
                font-family: "Press Start 2P"; font-size: 7px; color: #ffffffb3; horizontal-alignment: center; vertical-alignment: center; }
            HorizontalLayout {
                x: 0; y: 124px + 12px; width: parent.width; height: 44px; alignment: center; spacing: 6px;
                ArcadeBlock { text: "+1 MIN"; fill: 0.28; tube: root.tube; font-size: 9px; clicked => { Act.act("timers.add", root.index); } }
                ArcadeBlock { width: 48px; icon: root.t.running ? "\u{F03E4}" : "\u{F040A}"; fill: 1; tube: root.tint; clicked => { Act.act("timers.toggle", root.index); } }
                ArcKey { icon: "\u{F0156}"; tube: root.tube; clicked => { Act.act("timers.cancel", root.index); } }
            }
        }
    }
}

export component TimersPage inherits Rectangle {
    in property <bool> alarm-on: true;    // functions switched on in the settings
    in property <bool> timer-on: true;
    in property <bool> watch-on: true;
    in property <int> mode: 1;            // 0 alarms, 1 timers, 2 stopwatch
    in property <int> theme;              // timers: 0 plain, 1 kitchen, 2 hourglass, 3 synthwave, 4 flip
    in property <[TimerItem]> timers;
    in property <int> pick;               // kitchen, hourglass, flip: the timer shown big
    in property <bool> quick;             // the quick starts over the running timers (the + cell)
    in property <int> sheet: -1;          // one timer's own sheet (a tap on it where several run), -1: none
    in property <[AlarmItem]> alarms;
    in property <string> next-alarm;      // "6:45 · in 14 h 52 min"
    in property <color> next-tint: #ffb21e;
    in property <float> watch: 0;         // stopwatch, seconds
    in property <bool> watch-running;
    in property <[float]> laps;           // lap times, newest first
    in property <float> lap-at;           // the stopwatch's time at the last lap
    in property <float> lap-best: -1;     // the best lap (-1: none yet)
    in property <[float]> lap-marks;      // the laps' times on the stopwatch, oldest first (up to 8)
    in property <int> sw-look;            // stopwatch look: 0 plain, 1 chronograph, 2 timing tower, 3 LCD watch, 4 nixie
    in property <int> alarm-look;         // alarm look: 0 plain, 1 twin-bell, 2 sunrise, 3 clock radio, 4 24-hour dial
    in property <float> now-h;            // the time now, hours of the day
    in property <float> now-s;            // … and its seconds (smooth)
    in property <float> next-h: -1;       // the next alarm, hours of the day (-1: none on)
    in property <int> next-in: -1;        // … minutes until it
    in property <string> next-time;       // … "6:45"
    in property <string> next-label;      // … its label
    in property <string> dawn-from;       // … half an hour before it ("6:15")
    in property <float> sunrise-h: 7;     // the sun, hours of the day (from Home Assistant)
    in property <float> sunset-h: 16.5;
    in property <color> watch-tint: #3d9bff;
    in property <bool> ringing;           // a timer or an alarm rings (full screen)
    in property <bool> ring-alarm;        // … it is an alarm
    in property <string> ring-label;
    in property <string> ring-time;       // alarm: "6:45"
    in property <float> ring-over;        // timer: seconds since it finished
    in property <color> ring-tint: #e8262d;
    in property <float> pulse;            // 0..1, the ringing background breathes (app animation)
    in property <bool> settings;          // the settings sheet
    in property <bool> colourful: true;
    // hourglass: the app picks the sand frame for the time left (48 levels) and the stream frame
    in property <image> hg-sand-mask;
    in property <image> hg-sand-shade;
    in property <float> hg-peak: 214;     // top of the heap in the bottom bulb (image y)
    in property <image> hg-stream-mask;
    in property <image> hg-stream-shade;
    // synthwave: scene 0 sunset, 1 city, 2 beach, 3 stars (the app picks one at random when the page opens,
    // unless one is chosen); its pictures; the animation clock; passing cars; the palms' current frames
    in property <int> sw-scene;
    in property <int> sw-choice: -1;      // settings: -1 surprise me, 0..3 a fixed scene
    in property <image> sw-back;
    in property <image> sw-floor;
    in property <float> sw-t;             // seconds
    in property <[SwCar]> sw-cars;
    in property <image> sw-palm-l;
    in property <image> sw-palm-r;
    in property <image> sw-palm-l2;
    in property <image> sw-palm-r2;
    in property <float> sw-palm-lk;
    in property <float> sw-palm-rk;
    // alarm editor (new alarm or a tap on one) and its keyboard for the label
    in property <bool> edit;
    in property <bool> edit-new: true;
    in-out property <int> edit-h: 6;
    in-out property <int> edit-m: 45;
    in property <[bool]> edit-days: [true, true, true, true, true, false, false];
    in property <string> edit-label;
    in property <int> edit-sound;          // index into sounds; sounds.length = the one set in Home Assistant
    in property <string> edit-ha-sound;    // a sound set in Home Assistant for this alarm (music or own file), "" none
    in property <bool> edit-keyboard;
    in property <bool> edit-info;          // the ⓘ note on sounds
    in property <bool> ha-sounds;
    in property <bool> edit-timer;         // the editor sets a new timer (hours, minutes, label)          // sounds picked in Home Assistant reach the panel (the ⓘ shows then)
    in property <int> kb-layer;
    in property <int> kb-layout;            // letters: 0 Latin, 1 Cyrillic (the globe key)
    in property <color> edit-tint: #ffb21e;
    // the page is on the screen (the pager shows it; no screensaver): its menus close when it leaves (#9)
    in property <bool> on-screen: true;
    // a snoozed alarm: the time of day it rings again (-1: none); the ringing alarm's time as hours of the day
    in property <float> snooze-h: -1;
    in property <float> ring-h: -1;
    // the alarm and stopwatch tabs' settings menus (spec 35, 36), raised by the quick shade's page row
    in-out property <bool> al-menu;
    in-out property <bool> sw-menu;
    property <[string]> sounds: ["Rise and Shine", "Up and At 'Em", "Early Bird", "Saved by the Bell", "Old School", "Neon Sunrise"];

    pure function two(n: int) -> string { (n < 10 ? "0" : "") + n }
    pure function clock(t: float) -> string {
        t >= 3600 ? Math.floor(t / 3600) + ":" + root.two(Math.mod(Math.floor(Math.ceil(t) / 60), 60)) + ":" + root.two(Math.mod(Math.ceil(t), 60))
            : Math.floor(Math.ceil(t) / 60) + ":" + root.two(Math.mod(Math.ceil(t), 60))
    }
    pure function name(l: string) -> string { l != "" ? l : "Timer" }
    property <int> n: root.timers.length;
    property <int> funcs: (root.alarm-on ? 1 : 0) + (root.timer-on ? 1 : 0) + (root.watch-on ? 1 : 0);
    property <length> top: root.funcs > 1 ? 98px : 52px;          // content starts under the tabs
    // a timer ends (25.T1, T4): the plain look's ring bursts (300 ms), the synthwave floor pulses (600 ms), then the
    // ringing screen comes
    property <bool> pre-ring;
    property <duration> ring-t0;
    property <int> ring-theme;
    changed ringing => {
        if root.ringing && !root.ring-alarm && root.mode == 1 && (root.theme == 0 || root.theme == 3) {
            root.ring-theme = root.theme;
            root.ring-t0 = animation-tick();
            root.pre-ring = true;
        } else {
            root.pre-ring = false;
        }
    }
    Timer { interval: root.ring-theme == 3 ? 600ms : 300ms; running: root.pre-ring; triggered => { root.pre-ring = false; } }
    property <float> ring-t: root.pre-ring ? (animation-tick() - root.ring-t0) / 1ms : 1000;
    property <bool> ring-shown: root.ringing && !root.pre-ring;
    property <TimerItem> cur: root.n > 0 ? root.timers[min(root.pick, root.n - 1)] : { label: "", remaining: 0, total: 1, running: false, tint: #e8262d };
    property <float> fr: root.cur.total > 0 ? root.cur.remaining / root.cur.total : 0;
    property <bool> synth: (!root.ringing || (root.pre-ring && root.ring-theme == 3)) && root.mode == 1 && root.theme == 3;
    property <bool> synth-quick: root.synth;   // the quick starts in the synthwave look (over the scene, or its veil)
    property <[color]> sw-rings: [#ff2a6d, #ffd319, #ff8b3d, #c86bfa, #00e5ff, #ff2e88, #f9f871, #8a5cff,
                                  #ff6ec7, #00f0c8, #ffb86b, #a17bff, #7df9ff, #b967ff, #01ffc3, #ff71ce];
    property <[color]> sw-grids: [#ff2bd6, #00e5ff, #00f0c8, #b967ff];
    property <[color]> sw-deep: [#1d0634, #060424, #241047, #08051e];
    property <color> grid: root.sw-grids[root.sw-scene];
    property <color> deep: root.sw-deep[root.sw-scene];
    background: Theme.background;

    // ---------------------------------------------------------------- the timers tab: its state (spec 34, 25.T14)
    in property <[int]> cells;             // the grids' timers: the four that end soonest (indexes into timers)
    pure function eo(u: float) -> float { return 1 - Math.pow(1 - clamp(u, 0, 1), 3); }
    // the timer a grid cell shows
    pure function at(c: int) -> int { return c < root.cells.length ? root.cells[c] : c; }
    // the page entrance (25.T14): a timer that starts `delay` ms in fills / counts up over 420 ms (ease-out); the
    // synthwave tally in 8 steps of 40 ms and one frame off; every timer shows its zero while the tab is out of view
    pure function ent-k(delay: float) -> float { return tm.armed ? 0 : root.eo((tm.ent - delay) / 420); }
    pure function sw-k(delay: float) -> float { return tm.armed ? 0 : clamp(Math.floor((tm.ent - delay) / 40) + 1, 0, 8) / 8; }
    pure function sw-off(delay: float) -> bool { return !tm.armed && tm.ent - delay >= 320 && tm.ent - delay < 360; }
    tm := Rectangle {
        width: 0px; height: 0px;
        // the entrance runs every time the timers tab comes into view (once), ringing aside
        property <bool> shown: root.on-screen && root.mode == 1 && !root.ringing;
        property <bool> armed: true;
        property <bool> entering;
        property <duration> e0;
        function start() { self.armed = false; self.e0 = animation-tick(); self.entering = true; }
        Timer { interval: 1000ms; running: tm.entering; triggered => { tm.entering = false; } }
        changed shown => { if self.shown { self.start(); } else { self.entering = false; self.armed = true; } }
        // ms into the entrance; large once it is over (the clock is read only while it runs)
        property <float> ent: tm.armed ? 0 : tm.entering ? (animation-tick() - tm.e0) / 1ms : 100000;
        property <bool> calm: !tm.armed && !tm.entering;
        // the quick shade's page row (spec 32.0): "Timers settings · <look>"; it asks for the settings in the look's menu
        property <bool> pm-on: root.on-screen && root.mode == 1;
        property <int> pm-look: root.theme;
        function publish() {
            if self.pm-on {
                PageMenu.title = "Timers settings";
                PageMenu.look = TimerLooks.names[Math.max(0, Math.min(4, root.theme))];
                PageMenu.icon = TimerLooks.icons[Math.max(0, Math.min(4, root.theme))];
                PageMenu.has-settings = true;
            }
        }
        init => { if self.shown { self.start(); } self.publish(); }
        changed pm-on => { self.publish(); }
        changed pm-look => { self.publish(); }
        property <int> req: PageMenu.open-request;
        changed req => { if self.pm-on && !root.ringing { Act.act("timers.settings", "open"); } }
        // a new look in the settings: the menu goes in the old look (the arcade blinks the block first), the look changes,
        // the menu comes again in the new one
        property <int> swap-to: -1;
        property <bool> swapping;
        Timer { interval: TimerLooks.out-ms(root.theme) + 20ms; running: tm.swapping;
            triggered => { Act.act("timers.look", tm.swap-to); tm.swapping = false; } }
    }

    // ---------------------------------------------------------------- the alarm and stopwatch tabs' entrances (25.T15, T16)
    // As the timers tab's: every time the tab comes into view, once, ringing aside; each look runs from its zero to where
    // it stands in its own way (alarms in at most 700 ms, the stopwatch in at most 600 ms); not on data updates.
    al-ent := TabEntrance { width: 0px; height: 0px; shown: root.on-screen && root.mode == 0 && !root.ringing; length: 700ms; }
    sw-ent := TabEntrance { width: 0px; height: 0px; shown: root.on-screen && root.mode == 2 && !root.ringing; length: 650ms;
        started => { root.sw-w0 = root.watch; root.sw-l0 = Math.max(0, root.watch - root.lap-at); } }
    // the share of an alarm look's entrance done after `ms` (ease-out): 0 while the tab waits, 1 once it is over
    pure function ak(ms: float) -> float { return al-ent.armed ? 0 : root.eo(al-ent.ent / ms); }
    pure function sk(ms: float) -> float { return sw-ent.armed ? 0 : root.eo(sw-ent.ent / ms); }
    // the stopwatch's time and the running lap's when the entrance started
    property <float> sw-w0;
    property <float> sw-l0;
    // a time as the stopwatch entrance shows it: it counts up from zero through the values in between and arrives at the
    // live time (a running stopwatch goes on meanwhile), then it is the live time
    pure function sw-run(now: float, from: float, ms: float) -> float {
        return sw-ent.armed ? 0 : sw-ent.calm ? now : Math.max(0, now - (1 - root.sk(ms)) * from);
    }
    // a hand's place (0 .. period) as the entrance shows it: it sweeps forward from 0 to the live place, one turn at most
    pure function sw-hand(now: float, from: float, period: float, ms: float) -> float {
        return sw-ent.armed ? 0 : sw-ent.calm ? Math.mod(now, period) : Math.mod(now - (1 - root.sk(ms)) * Math.mod(from, period), period);
    }

    // ---------------------------------------------------------------- timers, plain
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n == 1: one := Rectangle {
        property <TimerItem> t: root.timers[0];
        Ring { x: (root.width - 240px) / 2; y: root.top + 4px; width: 240px; height: 240px; stroke: 12px;
            fr: one.t.total > 0 ? one.t.remaining / one.t.total : 0; arc: one.t.tint; opacity: one.t.running ? 1 : 0.55;  left: root.cur.running ? Math.ceil(root.cur.remaining) : -1;
            grow: root.ent-k(0); }
        Text { x: (root.width - 180px) / 2; y: root.top + 66px; width: 180px; height: 24px; text: root.name(one.t.label); font-size: 18px; font-weight: 600;
            color: one.t.tint.mix(TFg.c, 0.55); horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        RollTime { x: 0; y: root.top + 92px; width: root.width; height: 62px; t: one.t.remaining * root.ent-k(0); quiet: !tm.calm; size: one.t.remaining >= 3600 ? 46px : 58px;
            weight: 600; color: TFg.c; }
        Text { x: 0; y: root.top + 156px; width: root.width; height: 20px; text: one.t.running ? "of " + root.clock(one.t.total) : "Paused";
            font-size: 14px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
        TimerControls { x: 0; y: root.top + 262px; width: root.width; height: 64px; running: one.t.running; tint: one.t.tint; index: 0; }
    }
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n == 2: Rectangle {
        for t[i] in root.timers: Rectangle {
            x: 24px + i * 224px; y: root.top + 6px; width: 208px; height: 300px;
            Ring { x: 4px; y: 0; width: 200px; height: 200px; stroke: 10px; fr: t.total > 0 ? t.remaining / t.total : 0; arc: t.tint; opacity: t.running ? 1 : 0.55; left: t.running ? Math.ceil(t.remaining) : -1;
                grow: root.ent-k(60 * i); }
            TouchArea { x: 4px; y: 0; width: 200px; height: 200px; clicked => { Act.act("timers.sheet", i); } }
            Text { x: 29px; y: 56px; width: 150px; height: 22px; text: root.name(t.label); font-size: 16px; font-weight: 600; color: t.tint.mix(TFg.c, 0.55);
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            RollTime { x: 0; y: 78px; width: 208px; height: 46px; t: t.remaining * root.ent-k(60 * i); quiet: !tm.calm; size: t.remaining >= 3600 ? 32px : 40px; weight: 600; color: TFg.c; }
            Text { x: 0; y: 124px; width: 208px; height: 18px; text: t.running ? "of " + root.clock(t.total) : "Paused"; font-size: 13px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
            HorizontalLayout {
                x: 0; y: 222px; width: 208px; height: 56px; alignment: center; spacing: 16px;
                RoundButton { size: 56px; icon-size: 30px; fill: t.tint; ink: #ffffff; icon: t.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: i; }
                VerticalLayout { alignment: center; RoundButton { size: 44px; icon-size: 22px; outline: true; icon: "\u{F0156}"; act: "timers.cancel"; act-value: i; } }
            }
        }
    }
    if !root.ringing && root.mode == 1 && root.theme == 0 && root.n >= 3: Rectangle {
        for c in 4: cell := Rectangle {
            x: 20px + Math.mod(c, 2) * 224px; y: root.top + Math.floor(c / 2) * 176px; width: 216px; height: 168px;
            border-radius: 20px; background: TFg.c.with-alpha(0.05);
            // three: the fourth cell is the "+"; four or more: the four that end soonest (34.7)
            property <bool> has: c < root.n;
            property <int> ti: Math.min(root.at(c), root.n - 1);
            property <TimerItem> t: self.has ? root.timers[self.ti] : { label: "", remaining: 0, total: 0, running: false, tint: #ffffff };
            TouchArea { clicked => { if cell.has { Act.act("timers.sheet", cell.ti); } else { Act.act("timers.new", ""); } } }
            if cell.has: Ring { x: (cell.width - 116px) / 2; y: 12px; width: 116px; height: 116px; stroke: 8px;
                fr: cell.t.total > 0 ? cell.t.remaining / cell.t.total : 0; arc: cell.t.tint; opacity: cell.t.running ? 1 : 0.55; left: cell.t.running ? Math.ceil(cell.t.remaining) : -1;
                grow: root.ent-k(60 * c); }
            if cell.has: RollTime { x: 0; y: 12px + 36px; width: cell.width; height: 44px; t: cell.t.remaining * root.ent-k(60 * c); quiet: !tm.calm;
                size: cell.t.remaining >= 3600 ? 22px : 28px; weight: 600; color: TFg.c; }
            if cell.has && !cell.t.running: Text { x: 0; y: 12px + 76px; width: cell.width; height: 14px; text: "Paused"; font-size: 11px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
            if cell.has: Text { x: 12px; y: 136px; width: cell.width - 24px; height: 22px; text: root.name(cell.t.label); font-size: 15px; font-weight: 600; color: cell.t.tint.mix(TFg.c, 0.55);
                horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            if !cell.has: Rectangle {
                Rectangle { x: (parent.width - 60px) / 2; y: 54px; width: 60px; height: 60px; border-radius: 30px; border-width: 1.5px; border-color: TFg.c.with-alpha(0.30);
                    Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 28px; color: TFg.c.with-alpha(0.80); } }
            }
        }
    }

    // ---------------------------------------------------------------- kitchen, hourglass, flip: one timer big, chips for the others
    property <bool> themed: !root.ringing && root.mode == 1 && (root.theme == 1 || root.theme == 2 || root.theme == 4) && root.n >= 1;
    // the chips list every timer (34.7), equally wide, wrapping onto more rows when they do not fit; without tabs the round +
    // keeps the row's right end
    chip-m := Text { visible: false; text: "0:00:00"; font-size: 13px; font-weight: 600; }
    property <length> chip-w: chip-m.preferred-width + 34px;
    property <length> chip-area: root.funcs > 1 ? root.width - 32px : root.width - 32px - 56px;
    property <int> chip-k: Math.max(1, Math.floor((root.chip-area + 8px) / (root.chip-w + 8px)));
    property <int> chip-rows: root.n > 1 ? Math.ceil(root.n / root.chip-k) : 0;
    property <length> vis: root.top + root.chip-rows * 38px;         // where the theme picture starts
    if root.themed && root.n > 1: Rectangle {
        x: 16px; y: root.top; width: root.chip-area; height: root.chip-rows * 38px;
        for t[i] in root.timers: Rectangle {
            property <int> crow: Math.floor(i / root.chip-k);
            property <int> in-row: Math.min(root.chip-k, root.n - self.crow * root.chip-k);
            x: (parent.width - self.in-row * (root.chip-w + 8px) + 8px) / 2 + Math.mod(i, root.chip-k) * (root.chip-w + 8px);
            y: self.crow * 38px;
            width: root.chip-w; height: 30px; border-radius: 15px;
            background: i == root.pick ? t.tint : t.tint.with-alpha(0.18);
            TouchArea { clicked => { Act.act("timers.pick", i); } }
            Rectangle { x: 12px; y: 11px; width: 8px; height: 8px; border-radius: 4px; background: i == root.pick ? #ffffff : t.tint; }
            Text { x: 24px; width: parent.width - 30px; height: parent.height; text: root.clock(t.remaining); font-size: 13px; font-weight: 600;
                color: i == root.pick ? #ffffff : t.tint.mix(TFg.c, 0.6); vertical-alignment: center; horizontal-alignment: center; }
        }
    }
    if root.themed: TimerControls { x: 0; y: 384px; width: root.width; height: 56px; play: 56px; running: root.cur.running; tint: root.cur.tint; index: min(root.pick, root.n - 1); }

    // 1 kitchen: a turning dial (the minute under the pointer = what is left), the time on the knob.
    // Body, face light and knob are drawn layers; the minute ring turns under the fixed light.
    if root.themed && root.theme == 1: kit := Rectangle {
        property <float> cx: 240;
        property <float> cy: Math.round((root.vis / 1px + 380) / 2);
        property <float> rf: 94;
        property <float> mins-now: root.cur.remaining / 60;
        // more time (25.T2): three ratchet steps of 40 ms (a 1 px jolt each) to one minute mark past the new time, then a
        // 200 ms spring back
        property <float> wind-from;
        property <float> wind-to;
        property <bool> winding;
        property <duration> wind-t0;
        changed mins-now => {
            if kit.mins-now > kit.mins-last + 0.4 {
                kit.wind-from = kit.mins-last;
                kit.wind-to = kit.mins-now;
                kit.wind-t0 = animation-tick();
                kit.winding = true;
            }
            kit.mins-last = kit.mins-now;
        }
        property <float> mins-last;
        init => { kit.mins-last = kit.mins-now; }
        Timer { interval: 330ms; running: kit.winding; triggered => { kit.winding = false; } }
        property <float> wt: kit.winding ? (animation-tick() - kit.wind-t0) / 1ms : 1000;
        property <float> mins-run: !kit.winding ? kit.mins-now
            : kit.wt < 120 ? kit.wind-from + (kit.wind-to + 1 - kit.wind-from) * Math.min(3, Math.floor(kit.wt / 40) + 1) / 3
            : kit.wind-to + (kit.mins-now - kit.wind-to) + Math.pow(1 - clamp((kit.wt - 120) / 200, 0, 1), 2) * Math.cos(clamp((kit.wt - 120) / 200, 0, 1) * 180deg * 0.5);
        property <length> jolt: kit.winding && kit.wt < 120 && Math.mod(kit.wt, 40) < 14 ? 1px : 0px;
        // the page entrance (25.T14): the scale winds from 0 to one minute mark past the time (400 ms, ease-out) with T2's
        // 1 px jolt at the 5-minute marks it passes (at most 8), then springs back (200 ms); the knob counts up
        property <float> e: tm.ent;
        property <float> goal: kit.mins-now + 1;
        property <float> ent-mins: tm.armed ? 0 : kit.e < 400 ? kit.goal * root.eo(kit.e / 400)
            : kit.mins-now + Math.pow(1 - clamp((kit.e - 400) / 200, 0, 1), 2) * Math.cos(clamp((kit.e - 400) / 200, 0, 1) * 90deg);
        property <float> mins: tm.calm ? kit.mins-run : kit.ent-mins;
        property <int> mark: Math.floor(kit.ent-mins / 5);
        property <int> stride: Math.max(1, Math.ceil(kit.goal / 5 / 8));
        property <float> mark-t: 400 * (1 - Math.pow(Math.max(0, 1 - kit.mark * 5 / Math.max(1, kit.goal)), 1 / 3));
        property <length> ent-jolt: !tm.armed && !tm.calm && kit.e < 400 && kit.mark >= 1 && Math.mod(kit.mark, kit.stride) == 0 && kit.e - kit.mark-t < 14 ? 1px : 0px;
        y: kit.jolt + kit.ent-jolt;
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/shadow.png"); }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/body-mask.png"); colorize: root.cur.tint; }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/body-shade.png"); }
        Rectangle { x: (kit.cx - kit.rf) * 1px; y: (kit.cy - kit.rf) * 1px; width: 2 * kit.rf * 1px; height: self.width; border-radius: self.width / 2; background: #f1e8d6; }
        // minute ticks and numbers, turned so that the remaining minutes sit under the pointer
        for m in 60: tk := Rectangle {
            property <angle> a: (m - kit.mins) * 6deg;
            property <float> r1: kit.rf - (Math.mod(m, 5) == 0 ? 12 : 7);
            property <float> r2: kit.rf - 3;
            Seg { stroke: #3b352d; stroke-width: Math.mod(m, 5) == 0 ? 2px : 1px;
                x1: kit.cx + tk.r1 * Math.sin(tk.a); y1: kit.cy - tk.r1 * Math.cos(tk.a); x2: kit.cx + tk.r2 * Math.sin(tk.a); y2: kit.cy - tk.r2 * Math.cos(tk.a); }
        }
        for m in 12: Text {
            property <angle> a: (m * 5 - kit.mins) * 6deg;
            property <float> rn: kit.rf - 27;
            x: (kit.cx + self.rn * Math.sin(self.a) - 16) * 1px; y: (kit.cy - self.rn * Math.cos(self.a) - 10) * 1px; width: 32px; height: 20px;
            text: m * 5; font-size: 15px; font-weight: 700; color: #3b352d; horizontal-alignment: center; vertical-alignment: center;
        }
        Image { x: (kit.cx - 132) * 1px; y: (kit.cy - 132) * 1px; width: 264px; height: 264px; source: @image-url("timers/kit/face-light.png"); }
        // knob with the time
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-shadow.png"); }
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-mask.png"); colorize: root.cur.tint.mix(#000000, 0.22); }
        Image { x: (kit.cx - 62) * 1px; y: (kit.cy - 32) * 1px; width: 124px; height: 64px; source: @image-url("timers/kit/knob-shade.png"); }
        RollTime { x: (kit.cx - 52) * 1px; y: (kit.cy - 22) * 1px; width: 104px; height: 44px; quiet: !tm.calm;
            t: tm.calm ? root.cur.remaining : Math.min(root.cur.remaining, kit.ent-mins * 60); size: root.cur.remaining >= 3600 ? 18px : 22px; weight: 700; color: #ffffff; }
    }

    // 2 hourglass: glass, wooden frame and sand drawn as layers; the app picks the sand frame
    // (the amount is true to the time left) and the stream frame while it runs; the time on the right
    if root.themed && root.theme == 2: hg := Rectangle {
        property <length> x0: 54px;
        property <length> y0: root.vis + max(0px, (380px - root.vis - 244px) / 2);
        // the page entrance (25.T14): the glass turns over (T3, 500 ms), then the level steps from full to the current one
        // (400 ms) with the stream running; out of view the sand lies in the lower bulb
        property <float> e: tm.ent;
        property <bool> flip-ent: !tm.armed && !tm.calm && hg.e < 600;
        property <bool> pouring: !tm.armed && !tm.calm && hg.e >= 500 && hg.e < 900;
        property <bool> flowing: hg.pouring || (tm.calm && root.cur.running && root.fr > 0.002 && root.fr < 0.998);
        // the sand: 48 levels true to the time left (47 = full top), the next level fading in by the fraction,
        // the time left gliding between the app's whole seconds; the stream falls while it runs
        property <[image]> masks: [@image-url("timers/hg/sand-mask-00.png"), @image-url("timers/hg/sand-mask-01.png"), @image-url("timers/hg/sand-mask-02.png"), @image-url("timers/hg/sand-mask-03.png"), @image-url("timers/hg/sand-mask-04.png"), @image-url("timers/hg/sand-mask-05.png"), @image-url("timers/hg/sand-mask-06.png"), @image-url("timers/hg/sand-mask-07.png"), @image-url("timers/hg/sand-mask-08.png"), @image-url("timers/hg/sand-mask-09.png"), @image-url("timers/hg/sand-mask-10.png"), @image-url("timers/hg/sand-mask-11.png"), @image-url("timers/hg/sand-mask-12.png"), @image-url("timers/hg/sand-mask-13.png"), @image-url("timers/hg/sand-mask-14.png"), @image-url("timers/hg/sand-mask-15.png"), @image-url("timers/hg/sand-mask-16.png"), @image-url("timers/hg/sand-mask-17.png"), @image-url("timers/hg/sand-mask-18.png"), @image-url("timers/hg/sand-mask-19.png"), @image-url("timers/hg/sand-mask-20.png"), @image-url("timers/hg/sand-mask-21.png"), @image-url("timers/hg/sand-mask-22.png"), @image-url("timers/hg/sand-mask-23.png"), @image-url("timers/hg/sand-mask-24.png"), @image-url("timers/hg/sand-mask-25.png"), @image-url("timers/hg/sand-mask-26.png"), @image-url("timers/hg/sand-mask-27.png"), @image-url("timers/hg/sand-mask-28.png"), @image-url("timers/hg/sand-mask-29.png"), @image-url("timers/hg/sand-mask-30.png"), @image-url("timers/hg/sand-mask-31.png"), @image-url("timers/hg/sand-mask-32.png"), @image-url("timers/hg/sand-mask-33.png"), @image-url("timers/hg/sand-mask-34.png"), @image-url("timers/hg/sand-mask-35.png"), @image-url("timers/hg/sand-mask-36.png"), @image-url("timers/hg/sand-mask-37.png"), @image-url("timers/hg/sand-mask-38.png"), @image-url("timers/hg/sand-mask-39.png"), @image-url("timers/hg/sand-mask-40.png"), @image-url("timers/hg/sand-mask-41.png"), @image-url("timers/hg/sand-mask-42.png"), @image-url("timers/hg/sand-mask-43.png"), @image-url("timers/hg/sand-mask-44.png"), @image-url("timers/hg/sand-mask-45.png"), @image-url("timers/hg/sand-mask-46.png"), @image-url("timers/hg/sand-mask-47.png")];
        property <[image]> shades: [@image-url("timers/hg/sand-shade-00.png"), @image-url("timers/hg/sand-shade-01.png"), @image-url("timers/hg/sand-shade-02.png"), @image-url("timers/hg/sand-shade-03.png"), @image-url("timers/hg/sand-shade-04.png"), @image-url("timers/hg/sand-shade-05.png"), @image-url("timers/hg/sand-shade-06.png"), @image-url("timers/hg/sand-shade-07.png"), @image-url("timers/hg/sand-shade-08.png"), @image-url("timers/hg/sand-shade-09.png"), @image-url("timers/hg/sand-shade-10.png"), @image-url("timers/hg/sand-shade-11.png"), @image-url("timers/hg/sand-shade-12.png"), @image-url("timers/hg/sand-shade-13.png"), @image-url("timers/hg/sand-shade-14.png"), @image-url("timers/hg/sand-shade-15.png"), @image-url("timers/hg/sand-shade-16.png"), @image-url("timers/hg/sand-shade-17.png"), @image-url("timers/hg/sand-shade-18.png"), @image-url("timers/hg/sand-shade-19.png"), @image-url("timers/hg/sand-shade-20.png"), @image-url("timers/hg/sand-shade-21.png"), @image-url("timers/hg/sand-shade-22.png"), @image-url("timers/hg/sand-shade-23.png"), @image-url("timers/hg/sand-shade-24.png"), @image-url("timers/hg/sand-shade-25.png"), @image-url("timers/hg/sand-shade-26.png"), @image-url("timers/hg/sand-shade-27.png"), @image-url("timers/hg/sand-shade-28.png"), @image-url("timers/hg/sand-shade-29.png"), @image-url("timers/hg/sand-shade-30.png"), @image-url("timers/hg/sand-shade-31.png"), @image-url("timers/hg/sand-shade-32.png"), @image-url("timers/hg/sand-shade-33.png"), @image-url("timers/hg/sand-shade-34.png"), @image-url("timers/hg/sand-shade-35.png"), @image-url("timers/hg/sand-shade-36.png"), @image-url("timers/hg/sand-shade-37.png"), @image-url("timers/hg/sand-shade-38.png"), @image-url("timers/hg/sand-shade-39.png"), @image-url("timers/hg/sand-shade-40.png"), @image-url("timers/hg/sand-shade-41.png"), @image-url("timers/hg/sand-shade-42.png"), @image-url("timers/hg/sand-shade-43.png"), @image-url("timers/hg/sand-shade-44.png"), @image-url("timers/hg/sand-shade-45.png"), @image-url("timers/hg/sand-shade-46.png"), @image-url("timers/hg/sand-shade-47.png")];
        property <[float]> peaks: [146.6, 147.58, 148.56, 149.52, 150.47, 151.41, 152.35, 153.28, 154.21, 155.13, 156.04, 156.96, 157.87, 158.78, 159.69, 160.6, 161.51, 162.43, 163.36, 164.29, 165.23, 166.17, 167.13, 168.09, 169.07, 170.05, 171.05, 172.07, 173.1, 174.15, 175.21, 176.3, 177.41, 178.54, 179.7, 180.88, 182.1, 183.36, 184.68, 186.08, 187.58, 189.18, 190.92, 192.82, 194.89, 197.32, 200.76, 214.0];
        property <[image]> stream-masks: [@image-url("timers/hg/stream-mask-0.png"), @image-url("timers/hg/stream-mask-1.png"), @image-url("timers/hg/stream-mask-2.png"), @image-url("timers/hg/stream-mask-3.png")];
        property <[image]> stream-shades: [@image-url("timers/hg/stream-shade-0.png"), @image-url("timers/hg/stream-shade-1.png"), @image-url("timers/hg/stream-shade-2.png"), @image-url("timers/hg/stream-shade-3.png")];
        property <float> frs: root.fr;
        animate frs { duration: 1000ms; easing: linear; }
        property <float> lf-run: Math.max(0, Math.min(47, hg.frs * 47));
        property <float> lf: tm.armed ? 0 : tm.calm ? hg.lf-run : hg.e < 500 ? 47 : 47 + (hg.lf-run - 47) * clamp((hg.e - 500) / 400, 0, 1);
        // The level and the tint are plain properties, set only when they really change. The renderer draws a
        // coloured picture once and keeps it while its source and colour stay; bound to the gliding amount (or to
        // the timer row, new every second) they counted as changed each frame and the sand was coloured again
        // every frame (measured: 32 instead of 60 frames a second while it ran).
        property <int> li;
        property <color> tint-now: root.cur.tint;
        property <color> tint;
        init => {
            hg.li = Math.min(46, Math.floor(hg.lf));
            hg.tint = hg.tint-now;
            if root.cur.total - root.cur.remaining < 2 { hg.flip-t0 = animation-tick(); hg.flipping = true; }
        }
        changed lf => {
            if Math.min(46, Math.floor(hg.lf)) != hg.li {
                hg.li = Math.min(46, Math.floor(hg.lf));
            }
        }
        changed tint-now => {
            if hg.tint != hg.tint-now {
                hg.tint = hg.tint-now;
            }
        }
        property <float> lk: Math.max(0, Math.min(1, hg.lf - hg.li));
        property <float> peak: hg.peaks[hg.li] + (hg.peaks[hg.li + 1] - hg.peaks[hg.li]) * hg.lk;
        // the stream's four frames follow each other every 83 ms, each fading into the next (no steps)
        property <float> sp: hg.flowing ? (animation-tick() - Clock.base) / 1ms / 83 : 0;
        property <int> si: Math.mod(Math.floor(hg.sp), 4);
        property <float> sk: hg.sp - Math.floor(hg.sp);
        // a new timer (25.T3): the glass flips through 9 frames (20 … 180 degrees) in 500 ms, ease-in-out, the sand sliding
        // inside; then a 100 ms crossfade to the normal layers at the full level
        property <string> key: root.cur.label + "|" + root.cur.total;
        property <bool> flipping;
        property <duration> flip-t0;
        changed key => { if root.cur.total - root.cur.remaining < 2 { hg.flip-t0 = animation-tick(); hg.flipping = true; } }
        Timer { interval: 620ms; running: hg.flipping; triggered => { hg.flipping = false; } }
        property <float> ft: hg.flipping ? (animation-tick() - hg.flip-t0) / 1ms : hg.flip-ent ? hg.e : 1000;
        property <float> fu: clamp(hg.ft / 500, 0, 1);
        property <float> fe: hg.fu < 0.5 ? 2 * hg.fu * hg.fu : 1 - Math.pow(2 - 2 * hg.fu, 2) / 2;
        property <int> fk: Math.max(1, Math.min(9, Math.ceil(hg.fe * 9)));
        property <float> normal-k: !hg.flipping && !hg.flip-ent ? 1 : hg.ft < 500 ? 0 : clamp((hg.ft - 500) / 100, 0, 1);
        property <[image]> flip-back: [@image-url("timers/hg/flip-back-1.png"), @image-url("timers/hg/flip-back-2.png"), @image-url("timers/hg/flip-back-3.png"), @image-url("timers/hg/flip-back-4.png"), @image-url("timers/hg/flip-back-5.png"), @image-url("timers/hg/flip-back-6.png"), @image-url("timers/hg/flip-back-7.png"), @image-url("timers/hg/flip-back-8.png"), @image-url("timers/hg/flip-back-9.png")];
        property <[image]> flip-mask: [@image-url("timers/hg/flip-sand-mask-1.png"), @image-url("timers/hg/flip-sand-mask-2.png"), @image-url("timers/hg/flip-sand-mask-3.png"), @image-url("timers/hg/flip-sand-mask-4.png"), @image-url("timers/hg/flip-sand-mask-5.png"), @image-url("timers/hg/flip-sand-mask-6.png"), @image-url("timers/hg/flip-sand-mask-7.png"), @image-url("timers/hg/flip-sand-mask-8.png"), @image-url("timers/hg/flip-sand-mask-9.png")];
        property <[image]> flip-shade: [@image-url("timers/hg/flip-sand-shade-1.png"), @image-url("timers/hg/flip-sand-shade-2.png"), @image-url("timers/hg/flip-sand-shade-3.png"), @image-url("timers/hg/flip-sand-shade-4.png"), @image-url("timers/hg/flip-sand-shade-5.png"), @image-url("timers/hg/flip-sand-shade-6.png"), @image-url("timers/hg/flip-sand-shade-7.png"), @image-url("timers/hg/flip-sand-shade-8.png"), @image-url("timers/hg/flip-sand-shade-9.png")];
        property <[image]> flip-front: [@image-url("timers/hg/flip-front-1.png"), @image-url("timers/hg/flip-front-2.png"), @image-url("timers/hg/flip-front-3.png"), @image-url("timers/hg/flip-front-4.png"), @image-url("timers/hg/flip-front-5.png"), @image-url("timers/hg/flip-front-6.png"), @image-url("timers/hg/flip-front-7.png"), @image-url("timers/hg/flip-front-8.png"), @image-url("timers/hg/flip-front-9.png")];
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/floor-shadow.png"); }
        if (hg.flipping || hg.flip-ent) && hg.normal-k < 1: Rectangle {
            x: hg.x0 - 64px; y: hg.y0 - 32px; width: 300px; height: 300px;
            opacity: 1 - hg.normal-k;
            Image { width: 300px; height: 300px; source: hg.flip-back[hg.fk - 1]; }
            Image { width: 300px; height: 300px; source: hg.flip-mask[hg.fk - 1]; colorize: hg.tint; }
            Image { width: 300px; height: 300px; source: hg.flip-shade[hg.fk - 1]; }
            Image { width: 300px; height: 300px; source: hg.flip-front[hg.fk - 1]; }
        }
        Rectangle { opacity: hg.normal-k;
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/post-back.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/glass-back.png"); }
        // The sand, the two bulbs apart (split at the neck: rows 0-119 hold the top sand, the bottom sand starts below row 139). Top: the current level, the fuller one
        // before it fading out over it (the top drains). Bottom: the smaller heap before it, the current level's
        // bigger heap fading in over it (the heap grows); drawn the top way, the bottom heap jumped at every
        // level change. (Both levels stay in place and only fade: with a short timer the level changes several
        // times a second, and making and dropping these layers each time made the sand stutter.)
        Rectangle {
            x: hg.x0; y: hg.y0; width: 172px; height: 120px; clip: true;
            Image { x: 0; y: 0; width: 172px; height: 244px; source: hg.masks[hg.li]; colorize: hg.tint; }
            Image { x: 0; y: 0; width: 172px; height: 244px; source: hg.shades[hg.li]; }
            Image { x: 0; y: 0; width: 172px; height: 244px; source: hg.masks[hg.li + 1]; colorize: hg.tint; opacity: hg.lk; }
            Image { x: 0; y: 0; width: 172px; height: 244px; source: hg.shades[hg.li + 1]; opacity: hg.lk; }
        }
        Rectangle {
            x: hg.x0; y: hg.y0 + 120px; width: 172px; height: 124px; clip: true;
            Image { x: 0; y: -120px; width: 172px; height: 244px; source: hg.masks[hg.li + 1]; colorize: hg.tint; }
            Image { x: 0; y: -120px; width: 172px; height: 244px; source: hg.shades[hg.li + 1]; }
            Image { x: 0; y: -120px; width: 172px; height: 244px; source: hg.masks[hg.li]; colorize: hg.tint; opacity: 1 - hg.lk; }
            Image { x: 0; y: -120px; width: 172px; height: 244px; source: hg.shades[hg.li]; opacity: 1 - hg.lk; }
        }
        if hg.flowing: Rectangle {
            x: hg.x0 + 84px; y: hg.y0 + 118px; width: 5px; height: max(0px, (hg.peak - 118) * 1px + 1px); clip: true;
            // each stream frame is a picture of its own (coloured once); only their opacity moves: frame si
            // fully, the next one fading in over it (frame 0 once more after frame 3)
            for k in 5: Rectangle {
                x: 0; y: 0; width: 5px; height: 98px;
                property <float> w: k == hg.si ? 1 : (k == hg.si + 1 ? hg.sk : 0);
                Image { x: 0; y: 0; width: 5px; height: 98px; source: hg.stream-masks[Math.mod(k, 4)]; colorize: hg.tint; opacity: parent.w; }
                Image { x: 0; y: 0; width: 5px; height: 98px; source: hg.stream-shades[Math.mod(k, 4)]; opacity: parent.w; }
            }
        }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/glass-front.png"); }
        Image { x: hg.x0; y: hg.y0; width: 172px; height: 244px; source: @image-url("timers/hg/frame.png"); }
        }
        // name, time, total on the right
        // the name over the time: a long one wraps (up to three lines)
        Text { x: 252px; y: hg.y0 + 118px - 40px - 75px; width: 210px; height: 75px; text: root.name(root.cur.label); font-size: 17px; font-weight: 600;
            color: root.cur.tint.mix(TFg.c, 0.55); wrap: word-wrap; vertical-alignment: bottom; }
        RollTime { x: 250px; y: hg.y0 + 118px - 40px; width: 214px; height: 62px; align: left; quiet: !tm.calm;
            t: tm.calm ? root.cur.remaining : root.cur.remaining * root.eo(hg.e / 900); size: root.cur.remaining >= 3600 ? 42px : 56px; weight: 600; color: TFg.c; }
        Text { x: 252px; y: hg.y0 + 118px + 24px; width: 210px; height: 20px; text: root.cur.running ? "of " + root.clock(root.cur.total) : "Paused"; font-size: 14px; color: TFg.c.with-alpha(0.50); vertical-alignment: center; }
    }

    // 4 flip: split-flap minutes and seconds on the timer's colour
    if root.themed && root.theme == 4: flp := Rectangle {
        property <bool> hrs: root.cur.remaining >= 3600;
        property <int> mm: self.hrs ? min(99, Math.floor(root.cur.remaining / 3600)) : Math.floor(Math.ceil(root.cur.remaining) / 60);
        property <int> ss: self.hrs ? Math.mod(Math.floor(root.cur.remaining / 60), 60) : Math.mod(Math.ceil(root.cur.remaining), 60);
        property <length> ch: 132px;
        property <length> cw: 82px;
        property <length> fy: (root.vis + 378px - self.ch) / 2 + 6px;
        // the page entrance (25.T14): every card 0, then each flaps down through the digits to its own (60 ms a flap, the
        // cards starting 30 ms apart from the left); out of view the cards show 0
        pure function fd(i: int, g: int) -> string {
            return tm.armed ? "0" : tm.calm ? "" + g : "" + Math.max(0, Math.min(g, Math.floor((tm.ent - 30 * i) / 60)));
        }
        Rectangle { x: 16px; y: root.vis; width: root.width - 32px; height: 378px - root.vis; border-radius: 22px; background: root.cur.tint.mix(#000000, 0.8);
            Rectangle { x: 18px; y: 3px; width: parent.width - 36px; height: 2px; border-radius: 1px; background: #ffffff40; } }
        Text { x: 32px; y: root.vis + 4px; width: root.width - 64px; height: Math.max(26px, flp.fy - root.vis - 6px); text: root.name(root.cur.label); font-size: 18px; font-weight: 700;
            color: #ffffff; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
        HorizontalLayout {
            x: 0; y: flp.fy; width: root.width; height: flp.ch; alignment: center; spacing: 8px;
            // the cards flip at every change, shortened to 2 x 160 ms (they change every second)
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; new-digit: flp.fd(0, Math.floor(flp.mm / 10)); dur: tm.calm ? 320ms : 60ms;
                delay: tm.calm ? 210ms : 0ms; search: tm.calm; }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; new-digit: flp.fd(1, Math.mod(flp.mm, 10)); dur: tm.calm ? 320ms : 60ms;
                delay: tm.calm ? 140ms : 0ms; search: tm.calm; }
            VerticalLayout { alignment: center; spacing: 26px;
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ffffff; }
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #ffffff; } }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; new-digit: flp.fd(2, Math.floor(flp.ss / 10)); dur: tm.calm ? 320ms : 60ms;
                delay: tm.calm ? 70ms : 0ms; }
            FlapCard { width: flp.cw; height: flp.ch; card: #17171b; weight: 700; new-digit: flp.fd(3, Math.mod(flp.ss, 10)); dur: tm.calm ? 320ms : 60ms; }
        }
        Text { x: 0; y: flp.fy + flp.ch + 10px; width: root.width; height: 20px; text: (flp.hrs ? "h : min  ·  " : "") + (root.cur.running ? "of " + root.clock(root.cur.total) : "Paused");
            font-size: 14px; color: #ffffffcc; horizontal-alignment: center; vertical-alignment: center; }
    }

    // ---------------------------------------------------------------- 3 synthwave: the scene, then the tubes
    if root.synth: syn := Rectangle {
        SynthScene { back: root.sw-back; floor: root.sw-floor; scene: root.sw-scene; grid: root.grid; t: root.sw-t; cars: root.sw-cars;
            pulse-t: root.pre-ring && root.ring-theme == 3 ? root.ring-t : -1;
            palm-l: root.sw-palm-l; palm-r: root.sw-palm-r; palm-l2: root.sw-palm-l2; palm-r2: root.sw-palm-r2; palm-lk: root.sw-palm-lk; palm-rk: root.sw-palm-rk; }

        // one timer: a big tube, the controls at the bottom
        if root.n == 1 && !root.quick: Rectangle {
            // (no layer around the whole timer: its static texts are layers of their own, the time and the ring live)
            property <TimerItem> t: root.timers[0];
            property <color> g: self.t.running && self.t.remaining < 60 ? #ff5a5f : root.sw-rings[root.sw-scene * 4];
            NeonRing { x: (root.width - 212px) / 2; y: root.top + 8px; width: 212px; height: 212px; stroke: 8px; glow: parent.g; paused: !parent.t.running;
                fr: parent.t.total > 0 ? parent.t.remaining / parent.t.total : 0; grow: root.sw-k(0); visible: !root.sw-off(0); }
            NeonText { x: (root.width - 160px) / 2; y: root.top + 58px; width: 160px; height: 24px; text: root.name(parent.t.label); size: 17px; weight: 600;
                glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.45); }
            NeonClock { x: 0; y: root.top + 84px; width: root.width; height: 62px; t: parent.t.remaining * root.sw-k(0); size-short: 54px; size-long: 42px; weight: 400;
                glow: parent.g; rim: root.deep; }
            NeonText { x: 0; y: root.top + 146px; width: root.width; height: 20px; text: parent.t.running ? "of " + root.clock(parent.t.total) : "PAUSED"; size: 13px; weight: 600;
                glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.6); }
            TimerControls { x: 0; y: 384px; width: root.width; height: 56px; play: 56px; running: parent.t.running; tint: parent.g; neon: true; index: 0; }
        }
        // two timers: tubes side by side, small controls under each
        if root.n == 2 && !root.quick: Rectangle {
            // (no layer around the whole timer: its static texts are layers of their own, the time and the ring live)
            for t[i] in root.timers: tc := Rectangle {
                property <color> g: t.running && t.remaining < 60 ? #ff5a5f : root.sw-rings[root.sw-scene * 4 + i];
                x: 22px + i * 230px; y: root.top + 12px; width: 206px; height: 300px;
                NeonRing { x: 8px; y: 0; width: 190px; height: 190px; stroke: 7px; glow: parent.g; paused: !t.running; fr: t.total > 0 ? t.remaining / t.total : 0;
                    grow: root.sw-k(60 * i); visible: !root.sw-off(60 * i); }
                TouchArea { x: 8px; y: 0; width: 190px; height: 190px; clicked => { Act.act("timers.sheet", i); } }
                NeonText { x: 28px; y: 50px; width: 150px; height: 22px; text: root.name(t.label); size: 15px; weight: 600; glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.45); }
                NeonClock { x: 0; y: 72px; width: 206px; height: 50px; t: t.remaining * root.sw-k(60 * i); size-short: 40px; size-long: 32px; weight: 400; glow: parent.g; rim: root.deep; }
                NeonText { x: 0; y: 122px; width: 206px; height: 18px; text: t.running ? "of " + root.clock(t.total) : "PAUSED"; size: 12px; weight: 600; glow: parent.g; rim: root.deep; core: parent.g.mix(#ffffff, 0.6); }
                HorizontalLayout {
                    x: 0; y: 206px; width: 206px; height: 52px; alignment: center; spacing: 10px;
                    VerticalLayout { alignment: center; Pill { act: "timers.add"; act-value: i; text: "+1 min"; h: 40px; ink: #ffffff; fill: #00000059; line: tc.g.with-alpha(0.7); } }
                    RoundButton { size: 52px; icon-size: 28px; fill: #00000059; ring-w: 2px; ring-c: tc.g; ink: tc.g.mix(#ffffff, 0.6); icon: t.running ? "\u{F03E4}" : "\u{F040A}"; act: "timers.toggle"; act-value: i; }
                    VerticalLayout { alignment: center; RoundButton { size: 40px; icon-size: 20px; fill: #00000059; ring-w: 1.5px; ring-c: tc.g.with-alpha(0.6); icon: "\u{F0156}"; act: "timers.cancel"; act-value: i; } }
                }
            }
        }
        // three or four: a grid of smaller tubes
        if root.n >= 3 && !root.quick: Rectangle {
            // (no layer around the whole timer: its static texts are layers of their own, the time and the ring live)
            for c in 4: scell := Rectangle {
                x: 20px + Math.mod(c, 2) * 224px; y: root.top + Math.floor(c / 2) * 176px; width: 216px; height: 168px;
                property <bool> has: c < root.n;
                property <int> ti: Math.min(root.at(c), root.n - 1);
                property <TimerItem> t: self.has ? root.timers[self.ti] : { label: "", remaining: 0, total: 0, running: false, tint: #ffffff };
                property <color> g: self.t.running && self.t.remaining < 60 && self.has ? #ff5a5f : root.sw-rings[root.sw-scene * 4 + Math.mod(c, 4)];
                TouchArea { clicked => { if scell.has { Act.act("timers.sheet", scell.ti); } else { Act.act("timers.new", ""); } } }
                if scell.has: NeonRing { x: (scell.width - 118px) / 2; y: 10px; width: 118px; height: 118px; stroke: 6px; glow: scell.g; paused: !scell.t.running;
                    fr: scell.t.total > 0 ? scell.t.remaining / scell.t.total : 0; grow: root.sw-k(60 * c); visible: !root.sw-off(60 * c); }
                if scell.has: NeonClock { x: 0; y: 10px + 38px; width: scell.width; height: 42px; t: scell.t.remaining * root.sw-k(60 * c); size-short: 28px; size-long: 22px; weight: 400;
                    glow: scell.g; rim: root.deep; }
                if scell.has && !scell.t.running: NeonText { x: 0; y: 10px + 76px; width: scell.width; height: 14px; text: "PAUSED"; size: 10px; weight: 600; glow: scell.g; rim: root.deep; core: scell.g.mix(#ffffff, 0.6); }
                if scell.has: NeonText { x: 12px; y: 136px; width: scell.width - 24px; height: 22px; text: root.name(scell.t.label); size: 15px; weight: 600;
                    glow: scell.g; rim: root.deep; core: scell.g.mix(#ffffff, 0.45); }
                if !scell.has: Rectangle { x: (parent.width - 60px) / 2; y: 40px; width: 60px; height: 60px; border-radius: 30px; border-width: 1.5px; border-color: root.grid.with-alpha(0.7);
                    background: #00000059;
                    Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 28px; color: root.grid.mix(#ffffff, 0.5); } }
            }
        }
    }

    // ---------------------------------------------------------------- no timer: quick starts
    if !root.ringing && root.mode == 1 && (root.n == 0 || root.quick): Rectangle {
        cache-rendering-hint: true;
        // over running timers: the look stays (the synthwave scene under a dark veil, the status bar readable on it)
        background: root.n > 0 ? (root.synth ? #00000066 : Theme.background) : transparent;
        if root.n > 0: TouchArea { clicked => { Act.act("timers.quick-close", ""); } }
        Rectangle { x: (root.width - 80px) / 2; y: root.top + 18px; width: 80px; height: 80px; border-radius: 40px; background: root.synth-quick ? #0000008c : TFg.c.with-alpha(0.05);
            Icon { width: parent.width; height: parent.height; text: "\u{F13AB}"; font-size: 42px; color: root.synth-quick ? #ffffffcc : TFg.c.with-alpha(0.40); } }
        if !root.synth-quick: Text { x: 0; y: root.top + 106px; width: root.width; height: 24px; text: root.n > 0 ? "New timer" : "No timers"; font-size: 17px; color: TFg.c.with-alpha(0.50); horizontal-alignment: center; vertical-alignment: center; }
        // over the bright sun: white with a firm rim
        if root.synth-quick: GlowText { x: 0; y: root.top + 106px; width: root.width; height: 24px; text: root.n > 0 ? "New timer" : "No timers"; font-size: 17px; font-weight: 600; color: #ffffff; k: 2; horizontal-alignment: center; }
        for m[i] in [1, 3, 5, 10, 15, 30]: Rectangle {
            x: 60px + Math.mod(i, 3) * 124px; y: root.top + 150px + Math.floor(i / 3) * 62px; width: 112px; height: 54px; border-radius: 27px;
            background: root.synth-quick ? (qs-touch.pressed ? #000000b3 : #0000008c) : (qs-touch.pressed ? TFg.c.with-alpha(0.2) : TFg.c.with-alpha(0.10));
            border-width: root.synth-quick ? 1px : 0px; border-color: root.grid.with-alpha(0.55);
            qs-touch := TouchArea { clicked => { Act.act("timers.start", m * 60); } }
            Text { width: parent.width; height: parent.height; text: m + " min"; font-size: 18px; font-weight: 600; color: root.synth-quick ? #ffffff : TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { x: (root.width - 54px) / 2; y: root.top + 290px; width: 54px; height: 54px; border-radius: 27px;
            border-width: 1.5px; border-color: root.synth-quick ? root.grid.with-alpha(0.55) : TFg.c.with-alpha(0.30); background: root.synth-quick ? #0000008c : transparent;
            Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 26px; color: root.synth-quick ? #ffffff : TFg.c.with-alpha(0.80); }
            TouchArea { clicked => { Act.act("timers.new", ""); } } }
    }

    property <int> lap-n: root.laps.length;
    property <int> lap-last;
    property <bool> lap-sliding;
    property <duration> lap-t0;
    init => { root.lap-last = root.laps.length; }
    changed lap-n => { if root.lap-n > root.lap-last { root.lap-t0 = animation-tick(); root.lap-sliding = true; } root.lap-last = root.lap-n; }
    Timer { interval: 200ms; running: root.lap-sliding; triggered => { root.lap-sliding = false; } }
    property <length> lap-off: root.lap-sliding ? -34px * Math.pow(1 - clamp((animation-tick() - root.lap-t0) / 180ms, 0, 1), 3) : 0px;
    // ---------------------------------------------------------------- the next-alarm line (#31: a snoozed ring shows first)
    property <bool> snoozed: root.snooze-h >= 0;
    // the plain look's entrance (25.T15): the line counts its minutes down from the full time (a day, or the next whole day
    // above the time left) to the time left (M10, 420 ms, ease-out); the rows stay still
    property <int> al-full: 1440 * Math.ceil((root.next-in + 1) / 1440);
    property <int> al-in: al-ent.calm ? root.next-in : Math.round(root.al-full + (root.next-in - root.al-full) * root.ak(420));
    property <string> next-line: root.snoozed ? "Snoozed · rings at " + AlarmClock.of(root.snooze-h)
        : root.next-in >= 0 ? AlarmClock.of(root.next-h) + " · " + AlarmClock.when(root.al-in) : "No alarm on";
    // a tap on a chip switches the alarm (the look's T10-T13 motion when it goes on); a hold opens the editor
    function chip-toggle(i: int) {
        if i < root.alarms.length && !root.alarms[i].on {
            root.bell-t0 = animation-tick(); root.bell-shake = true; root.on-t0 = animation-tick(); root.on-i = i; root.on-anim = true;
        }
        Act.act("alarms.toggle", i);
    }
    // ---------------------------------------------------------------- alarm looks (spec 24): 4 24-hour dial
    // midnight at the bottom, noon at the top, the night darker; the sleep arc from now to the next alarm in Signal with the
    // sleep left in the middle; the alarms as markers (filled: on and due within 24 h, a ring: on, another day, faint: off);
    // the now hand; under it the alarms as chips (a tap toggles)
    // the time left: "8 h 58 min", or "12 min" under an hour
    pure function left-text(m: int) -> string { m >= 60 ? Math.floor(m / 60) + " h " + Math.mod(m, 60) + " min" : m + " min" }
    pure function dang(h: float) -> angle { (h / 24 * 360 + 180) * 1deg }
    pure function dpx(h: float, r: float) -> float { 240 + r * Math.sin(root.dang(h)) }
    pure function dpy(h: float, r: float) -> float { 216 - r * Math.cos(root.dang(h)) }
    pure function darc(h1: float, h2: float) -> string {
        "M " + root.dpx(h1, 112) + " " + root.dpy(h1, 112) + " A 112 112 0 " + (Math.mod(h2 - h1 + 24, 24) > 12 ? "1" : "0") + " 1 " + root.dpx(h2, 112) + " " + root.dpy(h2, 112)
    }
    property <float> arc-span: root.next-h >= 0 ? Math.mod(root.next-h - root.now-h + 24, 24) : 0;
    property <float> arc-shown: root.arc-span;
    animate arc-shown { duration: 400ms; easing: ease-in-out; }
    if !root.ringing && root.mode == 0 && root.alarm-look == 4: dial := Rectangle {
        // the entrance (25.T15): the sleep arc draws from now to the next alarm (as 25.T13, 400 ms) while the time left
        // counts up with it (M10)
        property <float> k: root.ak(400);
        property <color> day: Theme.dark ? #1d1e22 : #e6e2d9;
        property <color> night: Theme.dark ? #0e1424 : #c9c4b8;
        property <color> faint: TFg.c.with-alpha(0.55);
        Rectangle { x: 240px - 112px - 9px; y: 216px - 112px - 9px; width: 242px; height: 242px; border-radius: 121px; border-width: 18px; border-color: parent.day; }
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: parent.night; stroke-width: 18px;
            commands: root.darc(root.sunset-h, root.sunrise-h); }
        if root.arc-shown * dial.k > 0.02: Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: #FF4A1C; stroke-width: 18px;
            stroke-line-cap: round; opacity: 0.9; commands: root.darc(root.now-h, root.now-h + root.arc-shown * dial.k); }
        for k in 24: Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke-line-cap: round;
            stroke: Math.mod(k, 6) == 0 ? TFg.c : parent.faint; stroke-width: Math.mod(k, 6) == 0 ? 2.4px : 1.2px;
            commands: "M " + root.dpx(k, 99) + " " + root.dpy(k, 99) + " L " + root.dpx(k, Math.mod(k, 6) == 0 ? 89 : 94) + " " + root.dpy(k, Math.mod(k, 6) == 0 ? 89 : 94); }
        for n in [0, 6, 12, 18, 3, 9, 15, 21]: Text { x: (root.dpx(n, 76) - 20) * 1px; y: (root.dpy(n, 76) - 10) * 1px; width: 40px; height: 20px; text: n;
            font-family: "Space Grotesk"; font-size: Math.mod(n, 6) == 0 ? 15px : 11px; font-weight: 500; color: Math.mod(n, 6) == 0 ? TFg.c : parent.faint;
            horizontal-alignment: center; vertical-alignment: center; }
        // the sun at noon, the moon at midnight
        Rectangle { x: 233px; y: 151px; width: 14px; height: 14px; border-radius: 7px; border-width: 1.6px; border-color: parent.faint; }
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: parent.faint; stroke-width: 1.6px; stroke-line-cap: round;
            commands: "M 240 145 L 240 141 M 240 175 L 240 171 M 227 158 L 223 158 M 257 158 L 253 158"; }
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; fill: parent.faint;
            commands: "M 246 268 A 10 10 0 1 1 238 253 A 8 8 0 0 0 246 268 Z"; }
        // the now hand
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: TFg.c; stroke-width: 2.4px; stroke-line-cap: round;
            commands: "M " + root.dpx(root.now-h, 16) + " " + root.dpy(root.now-h, 16) + " L " + root.dpx(root.now-h, 126) + " " + root.dpy(root.now-h, 126); }
        Rectangle { x: (root.dpx(root.now-h, 112) - 7) * 1px; y: (root.dpy(root.now-h, 112) - 7) * 1px; width: 14px; height: 14px; border-radius: 7px;
            background: TFg.c; border-width: 2px; border-color: Theme.background; }
        // the alarms on the ring
        for a in root.alarms: Rectangle { x: (root.dpx(a.hour, 112) - 10.5) * 1px; y: (root.dpy(a.hour, 112) - 10.5) * 1px; width: 21px; height: 21px; border-radius: 10.5px;
            background: a.on && a.soon ? a.tint : Theme.background; border-width: 3px; border-color: a.on ? a.tint : parent.faint; }
        // between the 6 and the 18: the time left (or that no alarm is on) and the next alarm under it
        Text { x: 172px; y: 166px; width: 136px; height: 34px; text: root.snoozed ? "Snoozed" : root.next-in < 0 ? "No alarm on" : root.left-text(Math.round(root.next-in * dial.k));
            font-family: root.next-in < 0 || root.snoozed ? "Noto Sans" : "Space Grotesk"; font-size: root.next-in < 0 || root.snoozed ? 15px : root.next-in >= 600 ? 22px : 26px;
            font-weight: root.next-in < 0 || root.snoozed ? 600 : 500;
            color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        if root.next-in >= 0 || root.snoozed: Text { x: 162px; y: 198px; width: 156px; height: 18px;
            text: root.snoozed ? "rings at " + AlarmClock.of(root.snooze-h) : "of sleep until " + AlarmClock.of(root.next-h); font-size: 13px; font-weight: 500;
            color: parent.faint; horizontal-alignment: center; vertical-alignment: center; }
        // the alarms as chips
        AlarmChips { x: 16px; y: 358px; width: root.width - 32px; height: 90px; alarms: root.alarms; fill: TFg.c.with-alpha(0.08); ink: TFg.c; fade-to: Theme.background;
            toggled(i) => { root.chip-toggle(i); } edit(i) => { Act.act("alarms.edit", i); } }
    }

    // 3 clock radio (spec 24.7, 35.7): the body (a picture) centred in the free space between the tabs and the next-alarm line;
    // the red LED time (a PM dot in 12-hour mode), AL1-AL3 lit for the presets that are on, three preset keys (a tap
    // switches that alarm on or off, a hold of 500 ms opens it in the editor while its LED blinks twice; an empty slot is a
    // "+" key for a new alarm: the radio handles three alarms), a 12H / 24H slide switch on the body
    property <bool> radio-al: root.on-anim && root.on-i >= 0 && root.on-i < root.alarms.length && root.alarm-look == 3;
    property <float> radio-h: root.radio-al ? root.alarms[root.on-i].hour : root.now-h;
    property <int> radio-hh: Math.floor(root.radio-h + 0.0001);
    property <int> radio-sh: Clock.h24 ? root.radio-hh : (Math.mod(root.radio-hh, 12) == 0 ? 12 : Math.mod(root.radio-hh, 12));
    property <int> radio-mm: Math.mod(Math.floor(root.radio-h * 60 + 0.001), 60);
    // the entrance (25.T15): the LED powers up, every segment (and AL1-AL3, PM) at 45 % for 80 ms, then the time; the
    // preset LEDs of the alarms that are on light one after the other, 60 ms apart (each fading in as T12's). While the tab
    // waits the LED is dark. radio-led: 0 dark, 1 the test, 2 the time.
    property <int> radio-led: al-ent.armed ? 0 : al-ent.calm || al-ent.ent >= 80 ? 2 : 1;
    property <color> radio-dim: #ff2d1a.mix(#2a0c09, 0.45);
    pure function radio-key-at(k: int) -> float {
        return 80 + 60 * ((k >= 1 && root.alarms.length > 0 && root.alarms[0].on ? 1 : 0) + (k >= 2 && root.alarms.length > 1 && root.alarms[1].on ? 1 : 0));
    }
    if !root.ringing && root.mode == 0 && root.alarm-look == 3: radio := Rectangle {
        property <length> ry: root.top - 10px + Math.max(0px, (404px - (root.top - 10px) - 236px) / 2);
        property <length> dy: radio.ry - 98px;
        property <color> body: Theme.dark ? #17171a : #e7dec9;
        property <color> print: Theme.dark ? #4a4a50 : #b3a585;
        Image { x: 30px; y: radio.ry; width: 420px; height: 236px; source: Theme.dark ? @image-url("timers/radio-dark.png") : @image-url("timers/radio-light.png"); }
        disp := Rectangle { x: 0; y: radio.dy; width: 480px; height: 480px;
            property <color> ink: root.radio-led == 1 ? root.radio-dim : #ff2d1a;
            Seg7 { d: root.radio-led == 1 ? 8 : root.radio-led == 0 ? -1 : root.radio-sh >= 10 ? Math.floor(root.radio-sh / 10) : -1; x0: 234; y0: 152; w: 34; h: 62; t: 7; slant: 0; gap: 0.2; ghost: false; ink: disp.ink; off: #2a0c09; }
            Seg7 { d: root.radio-led == 1 ? 8 : root.radio-led == 0 ? -1 : Math.mod(root.radio-sh, 10); x0: 274; y0: 152; w: 34; h: 62; t: 7; slant: 0; gap: 0.2; ghost: false; ink: disp.ink; off: #2a0c09; }
            Seg7 { d: root.radio-led == 1 ? 8 : root.radio-led == 0 ? -1 : Math.floor(root.radio-mm / 10); x0: 326; y0: 152; w: 34; h: 62; t: 7; slant: 0; gap: 0.2; ghost: false; ink: disp.ink; off: #2a0c09; }
            Seg7 { d: root.radio-led == 1 ? 8 : root.radio-led == 0 ? -1 : Math.mod(root.radio-mm, 10); x0: 366; y0: 152; w: 34; h: 62; t: 7; slant: 0; gap: 0.2; ghost: false; ink: disp.ink; off: #2a0c09; }
            Rectangle { x: 311px; y: 170px; width: 8px; height: 8px; border-radius: 4px; background: root.radio-led == 0 ? #2a0c09 : disp.ink; }
            Rectangle { x: 309px; y: 202px; width: 8px; height: 8px; border-radius: 4px; background: root.radio-led == 0 ? #2a0c09 : disp.ink; }
            // 12-hour mode: the PM dot beside the digits, as real clock radios have it
            property <bool> pm: root.radio-led == 1 || (root.radio-led == 2 && root.radio-hh >= 12);
            if !Clock.h24: Rectangle { x: 217px; y: 156px; width: 7px; height: 7px; border-radius: 3.5px; background: disp.pm ? disp.ink : #3a1410;
                drop-shadow-blur: disp.pm && root.radio-led == 2 ? 5px : 0px; drop-shadow-color: #ff2d1acc; }
            if !Clock.h24: Text { x: 210px; y: 166px; width: 21px; text: "PM"; font-size: 8px; font-weight: 700; color: disp.pm ? disp.ink : #3a1410; horizontal-alignment: center; }
            // AL1-AL3: one per preset key, lit while that alarm is on
            for k in 3: Text { x: (228 + k * 30) * 1px; y: 236px; text: "AL" + (k + 1); font-size: 10px; font-weight: 700; letter-spacing: 1px;
                color: root.radio-led == 1 ? root.radio-dim : root.radio-led == 2 && k < root.alarms.length && root.alarms[k].on ? #ff2d1a : #3a1410; }
        }
        // the 12H / 24H slide switch on the body, where the print was (the print moves left of it)
        sw12 := Rectangle { x: 30px + 18px; y: radio.ry + 210px; width: 160px; height: 21px; background: radio.body;
            Text { x: 4px; height: parent.height; text: "PANELOS"; font-size: 9px; font-weight: 700; letter-spacing: 2px; color: radio.print; vertical-alignment: center; }
            property <float> sk: Clock.h24 ? 1 : 0;
            animate sk { duration: 120ms; easing: ease-out; }
            Text { x: 78px; height: parent.height; text: "12H"; font-size: 9px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center;
                color: Clock.h24 ? radio.print : radio.print.mix(Theme.dark ? #ffffff : #000000, 0.45); }
            Rectangle { x: 100px; y: 5px; width: 30px; height: 12px; border-radius: 6px; background: Theme.dark ? #0b0b0d : #cfc3a6;
                Rectangle { x: 2px + 12px * sw12.sk; y: 1px; width: 14px; height: 10px; border-radius: 5px; background: Theme.dark ? #5a5b62 : #f6f1e4; } }
            Text { x: 134px; height: parent.height; text: "24H"; font-size: 9px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center;
                color: Clock.h24 ? radio.print.mix(Theme.dark ? #ffffff : #000000, 0.45) : radio.print; }
            TouchArea { x: 70px; y: -12px; width: 90px; height: 44px; clicked => { Clock.h24 = !Clock.h24; Act.act("set.h24", Clock.h24 ? "true" : "false"); } }
        }
        // the preset keys
        for k in 3: key := Rectangle {
            property <bool> has: k < root.alarms.length;
            property <AlarmItem> a: key.has ? root.alarms[k] : { time: "", days: "", label: "", on: false, tint: #ffffff, hour: 0, soon: false };
            property <bool> down;
            property <bool> held;
            property <duration> t0;
            Timer { interval: 500ms; running: key.down && key.has && !key.held; triggered => { key.held = true; } }
            // while held: the LED blinks twice
            property <bool> blink: key.down && key.has && !key.held && Math.mod(Math.floor((animation-tick() - key.t0) / 125ms), 2) == 1;
            // on, and lit by the entrance (dark while the tab waits)
            property <bool> lit: key.a.on && (al-ent.calm || (!al-ent.armed && al-ent.ent >= root.radio-key-at(k)));
            x: 212px + k * (68px + 8px); y: radio.ry + 164px + (key.down ? 2px : 0px); width: 68px; height: 54px; border-radius: 9px;
            background: Theme.dark ? #26262b : #f4eedf;
            Rectangle { x: 0; y: parent.height - 3px; width: parent.width; height: 3px; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px;
                background: Theme.dark ? #121214 : #cdbf9f; }
            if key.has: Rectangle { x: 8px; y: 7px; width: 6px; height: 6px; border-radius: 3px;
                background: (key.lit != key.blink) ? #ff2d1a : (Theme.dark ? #3a3a40 : #bfb196);
                drop-shadow-blur: key.lit != key.blink ? 6px : 0px; drop-shadow-color: #ff2d1a;
                animate background { duration: 150ms; } }
            Text { x: parent.width - 18px; y: 4px; width: 10px; text: k + 1; font-size: 10px; font-weight: 700; color: Theme.dark ? #e8e4dc : #3a332a; opacity: 0.6;
                horizontal-alignment: right; }
            if key.has: Text { x: 2px; y: 18px; width: parent.width - 4px; height: 28px; text: AlarmClock.of(key.a.hour); font-size: Clock.h24 ? 15px : 13px; font-weight: 700;
                color: Theme.dark ? #e8e4dc : #3a332a; horizontal-alignment: center; vertical-alignment: center; opacity: key.a.on ? 1 : 0.5; }
            // an empty slot: a dim "+"
            if !key.has: Icon { y: 6px; text: "\u{F0415}"; font-size: 24px; color: Theme.dark ? #e8e4dc : #3a332a; opacity: 0.35; }
            TouchArea {
                pointer-event(ev) => {
                    if ev.kind == PointerEventKind.down {
                        key.down = true;
                        key.held = false;
                        key.t0 = animation-tick();
                    } else if ev.kind == PointerEventKind.up && key.down {
                        key.down = false;
                        if !key.has {
                            Act.act("alarms.new", "");
                        } else if key.held {
                            Act.act("alarms.edit", k);
                        } else {
                            root.chip-toggle(k);
                        }
                        key.held = false;
                    } else if ev.kind == PointerEventKind.cancel {
                        key.down = false;
                        key.held = false;
                    }
                }
            }
        }
        HorizontalLayout { x: 16px; y: 410px; width: root.width - 32px; height: 22px; alignment: center; spacing: 8px;
            if root.snoozed: Icon { text: "\u{F068E}"; font-size: 17px; color: TFg.c.with-alpha(0.7); }
            Text { text: root.snoozed ? "Snoozed" : root.next-in < 0 ? "No alarm on" : "Next " + AlarmClock.of(root.next-h); font-size: 15px; font-weight: 600; color: TFg.c; vertical-alignment: center; }
            if root.next-in >= 0 || root.snoozed: Text { text: root.snoozed ? "rings at " + AlarmClock.of(root.snooze-h) : AlarmClock.when(root.next-in); font-size: 15px; font-weight: 500;
                color: TFg.c.with-alpha(0.55); vertical-alignment: center; }
        }
    }

    // 2 sunrise: the page is a sky with two hills; the next alarm big in the sky; half an hour before it the sky goes from
    // night to dawn (by 60 %) and on to sunrise, the stars fade and the sun rises after the half (spec 24.6)
    property <float> dawn: root.next-in >= 0 && root.next-in <= 30 ? clamp(1 - root.next-in / 30, 0, 1) : 0;
    // the entrance (25.T15): the sky starts at night and brightens to the sky of now (500 ms, ease-out); the big time rolls
    // up from 0:00 to the alarm (its digits rolling, M8), the hours as the time format writes them
    property <float> dawn-in: root.dawn * root.ak(500);
    property <bool> sky-bright: !Theme.dark || root.dawn-in > 0.78;
    property <int> sun-hh: Math.floor(root.next-h + 0.0001);
    property <int> sun-dh: Clock.h24 ? Math.mod(root.sun-hh, 24) : (Math.mod(root.sun-hh, 12) == 0 ? 12 : Math.mod(root.sun-hh, 12));
    property <int> sun-v: Math.round((root.sun-dh * 60 + Math.mod(Math.round((root.next-h - root.sun-hh) * 60), 60)) * root.ak(500));
    pure function sky3(i: int, k: float) -> color {
        k < 0.6 ? root.sky-c(1, i).mix(root.sky-c(0, i), k / 0.6) : root.sky-c(2, i).mix(root.sky-c(1, i), (k - 0.6) / 0.4)
    }
    pure function sky-c(stage: int, i: int) -> color {
        Theme.dark
            ? (stage == 0 ? [#050b1c, #0f1c3c, #22335a][i] : stage == 1 ? [#2a2b5c, #b0517a, #ffa862][i] : [#5f8fcf, #f3b58a, #ffcf86][i])
            : (stage == 0 ? [#cfd7e2, #dde3ea, #eef0f2][i] : stage == 1 ? [#d9cfe0, #f0d6d8, #fbe2c8][i] : [#cfe2f3, #f7e7cf, #ffd6a0][i])
    }
    if !root.ringing && root.mode == 0 && root.alarm-look == 2: sky := Rectangle {
        property <color> fg: root.sky-bright ? #101114 : #F5F3EE;
        property <color> faint: root.sky-bright ? #10111499 : #F5F3EEa6;
        background: @linear-gradient(180deg, root.sky3(0, root.dawn-in) 0%, root.sky3(1, root.dawn-in) 55%, root.sky3(2, root.dawn-in) 100%);
        if Theme.dark: Rectangle {
            for st in [{ x: 175, y: 107, r: 1.5, tw: 4.09 }, { x: 47, y: 78, r: 1.2, tw: 3.66 }, { x: 269, y: 139, r: 0.8, tw: 0.54 }, { x: 224, y: 65, r: 1.0, tw: 0.57 }, { x: 227, y: 60, r: 0.8, tw: 5.95 }, { x: 332, y: 61, r: 1.5, tw: 0.31 }, { x: 123, y: 53, r: 1.0, tw: 1.82 }, { x: 83, y: 90, r: 1.2, tw: 3.52 }, { x: 359, y: 122, r: 0.8, tw: 3.65 }, { x: 337, y: 126, r: 1.2, tw: 0.61 }, { x: 374, y: 62, r: 0.8, tw: 3.89 }, { x: 264, y: 248, r: 1.2, tw: 2.92 }, { x: 242, y: 215, r: 1.2, tw: 1.56 }, { x: 102, y: 154, r: 0.8, tw: 3.61 }, { x: 278, y: 283, r: 1.2, tw: 4.58 }, { x: 157, y: 67, r: 0.8, tw: 3.21 }, { x: 94, y: 205, r: 1.0, tw: 5.86 }, { x: 225, y: 50, r: 0.8, tw: 4.80 }, { x: 303, y: 190, r: 1.2, tw: 4.37 }, { x: 314, y: 284, r: 1.5, tw: 0.43 }, { x: 57, y: 168, r: 1.5, tw: 4.38 }, { x: 43, y: 61, r: 1.2, tw: 4.06 }, { x: 358, y: 258, r: 1.2, tw: 4.50 }, { x: 464, y: 207, r: 0.8, tw: 5.91 }, { x: 191, y: 116, r: 0.8, tw: 3.10 }, { x: 121, y: 177, r: 1.0, tw: 4.64 }, { x: 213, y: 230, r: 1.5, tw: 0.51 }, { x: 239, y: 235, r: 1.2, tw: 5.55 }, { x: 429, y: 250, r: 1.2, tw: 4.44 }, { x: 193, y: 224, r: 1.0, tw: 0.95 }]: Rectangle { x: (st.x - st.r) * 1px; y: (st.y - st.r) * 1px; width: st.r * 2px; height: st.r * 2px; border-radius: st.r * 1px; background: #ffffff;
                opacity: max(0, 1 - root.dawn-in * 1.7) * (0.55 + 0.45 * Math.sin(1rad * ((animation-tick() / 1ms) / 900 + st.tw))); }
        }
        property <float> sun-k: max(max(0, (root.dawn-in - 0.5) / 0.5), root.on-t < 600 ? 0.6 * Math.sin(180deg * root.on-t / 600) : 0);
        Rectangle { x: 318px - 110px; y: (392 - sky.sun-k * 96) * 1px - 110px; width: 220px; height: 220px; border-radius: 110px; opacity: sky.sun-k;
            background: @radial-gradient(circle, #ffd27abf 0%, #ffd27a00 100%); }
        Rectangle { x: 288px; y: (392 - sky.sun-k * 96) * 1px - 30px; width: 60px; height: 60px; border-radius: 30px; background: #ffd98a; }
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480;
            fill: Theme.dark ? #5a3a4a.mix(#0d1526, root.dawn-in) : #d8b9a4.mix(#c3cad3, root.dawn-in);
            commands: "M 0 338 C 60 318 120 322 180 334 C 250 348 320 312 400 318 C 440 321 465 330 480 334 L 480 480 L 0 480 Z"; }
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480;
            fill: Theme.dark ? #2e1d29.mix(#060a14, root.dawn-in) : #c49c86.mix(#b4bcc6, root.dawn-in);
            commands: "M 0 362 C 90 352 160 366 240 364 C 330 362 400 350 480 356 L 480 480 L 0 480 Z"; }
        HorizontalLayout { x: 0; y: 128px; width: root.width; height: 100px; alignment: center; spacing: 6px;
            if root.next-in < 0: Text { text: "–:––"; font-family: "Space Grotesk"; font-size: 96px; font-weight: 500;
                letter-spacing: -2px; color: sky.fg; vertical-alignment: center; }
            if root.next-in >= 0: HorizontalLayout { spacing: -2px;
                if root.sun-v >= 600: RollDigit { d: Math.floor(root.sun-v / 600); family: "Space Grotesk"; font-size: 96px; font-weight: 500; color: sky.fg; }
                RollDigit { d: Math.mod(Math.floor(root.sun-v / 60), 10); family: "Space Grotesk"; font-size: 96px; font-weight: 500; color: sky.fg; }
                Text { text: ":"; font-family: "Space Grotesk"; font-size: 96px; font-weight: 500; color: sky.fg; vertical-alignment: center; }
                RollDigit { d: Math.floor(Math.mod(root.sun-v, 60) / 10); family: "Space Grotesk"; font-size: 96px; font-weight: 500; color: sky.fg; }
                RollDigit { d: Math.mod(root.sun-v, 10); family: "Space Grotesk"; font-size: 96px; font-weight: 500; color: sky.fg; }
            }
            if root.next-in >= 0 && !Clock.h24: VerticalLayout { padding-bottom: 22px; alignment: end;
                Text { text: AlarmClock.ampm(root.next-h); font-family: "Space Grotesk"; font-size: 30px; font-weight: 500; color: sky.fg; } }
        }
        Text { x: 0; y: 234px; width: root.width; height: 22px; text: root.next-in < 0 ? "No alarm on" : root.next-label; font-size: 17px; font-weight: 600; color: sky.fg;
            horizontal-alignment: center; vertical-alignment: center; }
        if root.next-in >= 0 || root.snoozed: Text { x: 16px; y: 256px; width: root.width - 32px; height: 20px; font-size: 14px; color: sky.faint;
            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
            text: root.snoozed ? "Snoozed · rings at " + AlarmClock.of(root.snooze-h)
                : AlarmClock.when(root.next-in) + " · the sky brightens from " + AlarmClock.of(Math.mod(root.next-h + 23.5, 24)); }
        AlarmChips { x: 16px; y: 352px; width: root.width - 32px; height: 96px; alarms: root.alarms; fill: Theme.dark ? #F5F3EE1f : #10111414; ink: Theme.dark ? #F5F3EE : #101114;
            toggled(i) => { root.chip-toggle(i); } edit(i) => { Act.act("alarms.edit", i); } }
    }

    // 1 twin-bell clock: the red clock (a picture) with its hour, minute and second hands and the alarm hand (Signal, an
    // arrow tip) at the next alarm; under it the next alarm and the time left, then the alarms as chips (a tap toggles)
    if !root.ringing && root.mode == 0 && root.alarm-look == 1: bell := Rectangle {
        // the entrance (25.T15): the hands spin forward from 12:00 to the time (500 ms, ease-out, one turn at most); on
        // arrival the hammer taps once (T10)
        property <float> k: root.ak(500);
        property <bool> tap: !al-ent.armed && !al-ent.calm && al-ent.ent >= 500 && al-ent.ent < 650;
        TwinBellClock { x: 150px; y: 98px; width: 180px; height: 206px; metal: Theme.dark ? #b9b6af : #8d8a84; highlight: false; shadow: false;
            hours: Math.mod(root.now-h, 12) * bell.k; minutes: Math.mod(root.now-h * 60, 60) * bell.k; seconds: root.now-s * bell.k;
            ting: root.on-t < 150 || bell.tap; ting-t: root.on-t < 150 ? root.on-t : al-ent.ent - 500; }
        HorizontalLayout { x: 0; y: 316px; width: root.width; height: 24px; alignment: center; spacing: 8px;
            Text { text: root.snoozed ? "Snoozed" : root.next-in < 0 ? "No alarm on" : "Next " + AlarmClock.of(root.next-h); font-size: 16px; font-weight: 600; color: TFg.c; vertical-alignment: center; }
            if root.next-in >= 0 || root.snoozed: Text { text: root.snoozed ? "rings at " + AlarmClock.of(root.snooze-h) : AlarmClock.when(root.next-in); font-size: 15px;
                color: TFg.c.with-alpha(0.55); vertical-alignment: center; }
        }
        AlarmChips { x: 16px; y: 352px; width: root.width - 32px; height: 96px; alarms: root.alarms; fill: TFg.c.with-alpha(0.08); ink: TFg.c; fade-to: Theme.background;
            toggled(i) => { root.chip-toggle(i); } edit(i) => { Act.act("alarms.edit", i); } }
    }

    // ---------------------------------------------------------------- alarms
    property <bool> bell-shake;
    property <duration> bell-t0;
    // an alarm switched on (25.T10-T12): which one, when; for a second
    property <bool> on-anim;
    property <duration> on-t0;
    property <int> on-i: -1;
    Timer { interval: 1s; running: root.on-anim; triggered => { root.on-anim = false; } }
    property <float> on-t: root.on-anim ? (animation-tick() - root.on-t0) / 1ms : 2000;
    // the stopwatch reset (25.T6 flyback, 25.T9 anti-poisoning cycle) and a new lap (T6 drop, T7 push)
    // The reset (only from a stopped stopwatch) is seen on the time at rest, -1 while it runs: a running stopwatch's time
    // changes in every frame, and a handler watching it would ask for every next frame on every page while it runs.
    property <float> sw-rest: root.watch-running ? -1 : root.watch;
    property <float> sw-prev;
    property <bool> flyback;
    property <duration> fly-t0;
    property <float> fly-from;
    Timer { interval: 420ms; running: root.flyback; triggered => { root.flyback = false; } }
    changed sw-rest => {
        if root.sw-rest == 0 && root.sw-prev > 0 {
            root.fly-from = root.sw-prev;
            root.fly-t0 = animation-tick();
            root.flyback = true;
        }
        if root.sw-rest >= 0 {
            root.sw-prev = root.sw-rest;
        }
    }
    property <float> fly-k: root.flyback ? 1 - Math.pow(1 - clamp((animation-tick() - root.fly-t0) / 400ms, 0, 1), 3) : 1;
    property <int> lapn: root.laps.length;
    property <int> lapn-last;
    property <bool> lap-new;
    property <duration> lapd-t0;
    changed lapn => { if root.lapn > root.lapn-last { root.lapd-t0 = animation-tick(); root.lap-new = true; } root.lapn-last = root.lapn; }
    Timer { interval: 520ms; running: root.lap-new; triggered => { root.lap-new = false; } }
    property <float> lap-t: root.lap-new ? (animation-tick() - root.lapd-t0) / 1ms : 1000;
    Timer { interval: 300ms; running: root.bell-shake; triggered => { root.bell-shake = false; } }
    if !root.ringing && root.mode == 0: Rectangle {
        // (the clock radio fills this corner: no + there)
        Rectangle { visible: root.alarm-look != 3; x: root.width - 20px - 44px; y: root.top; width: 44px; height: 44px; border-radius: 22px; border-width: 1.5px; border-color: TFg.c.with-alpha(0.30);
            TouchArea { clicked => { Act.act("alarms.new", ""); } }
            Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 24px; color: TFg.c.with-alpha(0.80); } }
        Rectangle {
            visible: root.alarm-look == 0;
            x: 20px; y: root.top; width: root.width - 40px - 52px; height: 44px; border-radius: 22px; background: TFg.c.with-alpha(0.05);
            HorizontalLayout { alignment: center; spacing: 8px; padding-left: 12px; padding-right: 12px;
                // M20: switching an alarm on shakes the bell ±2 px, 3 cycles in 300 ms
                Rectangle { width: 22px;
                    Icon { x: root.bell-shake ? 2px * Math.sin(1080deg * clamp((animation-tick() - root.bell-t0) / 300ms, 0, 1)) : 0px;
                        width: parent.width; height: parent.height; text: root.snoozed ? "\u{F068E}" : "\u{F0020}"; font-size: 20px; color: root.next-tint; } }
                Text { text: root.next-line; font-size: 15px; font-weight: 600; color: TFg.c.with-alpha(0.85); vertical-alignment: center; overflow: elide; }
            }
        }
        Flickable {
            visible: root.alarm-look == 0;
            x: 0; y: root.top + 56px; width: root.width; height: 448px - root.top - 56px;
            content-height: max(self.height, root.alarms.length * 78px);
        for a[i] in root.alarms: Rectangle {
            x: 20px; y: i * 78px; width: root.width - 40px; height: 70px; border-radius: 18px; background: TFg.c.with-alpha(0.04);
            TouchArea { clicked => { Act.act("alarms.edit", i); } }
            Rectangle { x: 0; y: 14px; width: 4px; height: parent.height - 28px; border-radius: 2px; background: a.on ? a.tint : TFg.c.with-alpha(0.15); }
            rt := Text { x: 18px; y: 0; height: parent.height; text: AlarmClock.digits(a.hour); font-size: 34px; font-weight: 600; color: a.on ? TFg.c : TFg.c.with-alpha(0.35); vertical-alignment: center; }
            // 12-hour mode: AM / PM small beside the digits, on their baseline
            ra := Text { x: 18px + rt.preferred-width + 4px; y: 0; height: parent.height - 18px; text: AlarmClock.ampm(a.hour); font-size: 15px; font-weight: 600;
                color: a.on ? TFg.c.with-alpha(0.7) : TFg.c.with-alpha(0.3); vertical-alignment: bottom; }
            property <length> lx: Math.max(138px, 18px + rt.preferred-width + (Clock.h24 ? 0px : ra.preferred-width + 4px) + 16px);
            lp := Text { visible: false; text: a.label; font-size: 16px; font-weight: 600; }
            property <bool> long: lp.preferred-width > self.width - self.lx - 80px;
            Text { x: parent.lx; y: parent.long ? 6px : 13px; width: parent.width - parent.lx - 80px; height: parent.long ? 36px : 22px; text: a.label;
                font-size: parent.long ? 13px : 16px; font-weight: 600; color: a.on ? a.tint.mix(TFg.c, 0.5) : TFg.c.with-alpha(0.35); wrap: word-wrap; vertical-alignment: center; }
            Text { x: parent.lx; y: parent.long ? 44px : 35px; width: parent.width - parent.lx - 80px; height: 20px; text: a.days; font-size: 13px; color: a.on ? TFg.c.with-alpha(0.60) : TFg.c.with-alpha(0.25); wrap: word-wrap; vertical-alignment: center; }
            Rectangle {
                x: parent.width - 72px; y: (parent.height - 30px) / 2; width: 54px; height: 30px; border-radius: 15px; background: a.on ? a.tint : TFg.c.with-alpha(0.15);
                TouchArea { x: -12px; y: -16px; width: parent.width + 24px; height: parent.height + 32px; clicked => { if !a.on { root.bell-t0 = animation-tick(); root.bell-shake = true; root.on-t0 = animation-tick(); root.on-i = i; root.on-anim = true; } Act.act("alarms.toggle", i); } }
                Rectangle { x: a.on ? parent.width - 27px : 3px; y: 3px; width: 24px; height: 24px; border-radius: 12px; background: #ffffff; }
            }
        }
        }
        // more below: a soft fade above the page dots
        if root.alarms.length * 78px > 448px - root.top - 56px: Rectangle { x: 0; y: 448px - 34px; width: root.width; height: 34px;
            background: @linear-gradient(180deg, Theme.background.with-alpha(0) 0%, Theme.background 100%); }
    }

    // ---------------------------------------------------------------- stopwatch looks (spec 24): 1 chronograph, 2 timing tower
    // (the tabs, the page dots and the bottom controls stay where the plain look has them)
    // a difference with two decimals ("1.40")
    pure function d2(x: float) -> string { Math.floor(Math.round(Math.abs(x) * 100) / 100) + "." + root.two(Math.mod(Math.round(Math.abs(x) * 100), 100)) }
    pure function lapfmt(t: float) -> string { Math.floor(t / 60) + ":" + root.two(Math.mod(Math.floor(t), 60)) + "." + root.two(Math.mod(Math.floor(t * 100), 100)) }
    property <color> sw-faint: TFg.c.with-alpha(0.55);
    // 1 chronograph: the dial (a picture), the 30-minute counter's hand, the digital window, the sweep hand (Signal, with a tail
    // and a counterweight, every frame), the laps as small triangles outside the dial (the newest Signal)
    // (#87) with laps the dial slides left (300 ms) and the lap list stands at its right: newest on top, every lap scrolls into view
    property <float> chrono-k: root.laps.length > 0 ? 1 : 0;
    animate chrono-k { duration: 300ms; easing: ease-out; }
    if !root.ringing && root.mode == 2 && root.sw-look == 1 && root.chrono-k > 0.001: Flickable {
        x: 288px + 40px * (1 - root.chrono-k); y: 100px; width: 176px; height: 252px; opacity: root.chrono-k;
        content-height: Math.max(self.height, root.laps.length * 36px);
        for l[i] in root.laps: Rectangle {
            y: i * 36px + root.lap-off; height: 32px; opacity: i == 0 ? 1 + root.lap-off / 34px : 1;
            border-radius: 8px; background: i == 0 ? #FF4A1C.with-alpha(Theme.dark ? 0.16 : 0.12) : TFg.c.with-alpha(0.05);
            Text { x: 10px; width: 64px; height: parent.height; text: "LAP " + (root.laps.length - i); font-size: 11px; font-weight: 700; letter-spacing: 1px;
                color: i == 0 ? #FF4A1C : root.sw-faint; vertical-alignment: center; }
            Text { x: parent.width - 10px - 100px; width: 100px; height: parent.height; text: root.lapfmt(l); font-family: "Space Grotesk"; font-size: 16px; font-weight: 500;
                color: TFg.c; horizontal-alignment: right; vertical-alignment: center; }
        }
    }
    if !root.ringing && root.mode == 2 && root.sw-look == 1: Rectangle {
        x: -102px * root.chrono-k;
        Image { x: 109px; y: 95px; width: 262px; height: 262px; source: Theme.dark ? @image-url("timers/sw/chrono-dark.png") : @image-url("timers/sw/chrono-light.png"); }
        // the entrance (25.T16): the hands sweep forward from 0 to the time (one turn at most, 500 ms, ease-out), the minute
        // counter with them, the window counts up; the lap markers drop onto the bezel one after another with T6's bounce
        property <angle> sa: root.flyback ? Math.mod(root.fly-from, 60) / 60 * 360deg * (1 - root.fly-k) : root.sw-hand(root.watch, root.sw-w0, 60, 500) / 60 * 360deg;
        property <angle> ma: root.flyback ? Math.mod(root.fly-from / 60, 30) / 30 * 360deg * (1 - root.fly-k) : root.sw-hand(root.watch / 60, root.sw-w0 / 60, 30, 500) / 30 * 360deg;
        // the newest marker falls 10 px onto the bezel in 180 ms and bounces 2 px (120 ms)
        property <float> drop: root.lap-t < 180 ? 10 * (1 - Math.pow(root.lap-t / 180, 2)) : root.lap-t < 300 ? 2 * Math.sin(180deg * (root.lap-t - 180) / 120) : 0;
        // the minute counter's hand
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: TFg.c; stroke-width: 2px; stroke-line-cap: round;
            commands: "M 240 180 L " + (240 + 19 * Math.sin(parent.ma)) + " " + (180 - 19 * Math.cos(parent.ma)); }
        Rectangle { x: 237px; y: 177px; width: 6px; height: 6px; border-radius: 3px; background: TFg.c; }
        Text { x: 190px; y: 256px; width: 100px; height: 28px; text: root.lapfmt(root.sw-run(root.watch, root.sw-w0, 500)); font-family: "Space Grotesk"; font-size: 17px; font-weight: 500;
            color: TFg.c; horizontal-alignment: center; vertical-alignment: center; }
        // the laps outside the dial
        for m[i] in root.lap-marks: Path {
            property <angle> a: Math.mod(m, 60) / 60 * 360deg;
            // the entrance: ms into this marker's drop (30 ms after the one before), -1 before it
            property <float> et: sw-ent.armed ? -1 : sw-ent.calm ? 1000 : sw-ent.ent - 30 * i;
            property <float> edr: self.et < 180 ? 10 * (1 - Math.pow(Math.max(0, self.et) / 180, 2)) : self.et < 300 ? 2 * Math.sin(180deg * (self.et - 180) / 120) : 0;
            visible: self.et >= 0;
            property <float> dr: (i == root.lap-marks.length - 1 ? parent.drop : 0) + self.edr;
            x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480;
            fill: i == root.lap-marks.length - 1 ? #FF4A1C : root.sw-faint;
            commands: "M " + (240 + (123 + self.dr) * Math.sin(self.a)) + " " + (226 - (123 + self.dr) * Math.cos(self.a))
                + " L " + (240 + (130 + self.dr) * Math.sin(self.a - 2.0deg)) + " " + (226 - (130 + self.dr) * Math.cos(self.a - 2.0deg))
                + " L " + (240 + (130 + self.dr) * Math.sin(self.a + 2.0deg)) + " " + (226 - (130 + self.dr) * Math.cos(self.a + 2.0deg)) + " Z";
        }
        // the sweep hand: tip at r 113, tail 24 px back, a counterweight at 18 px
        Path { x: 0; y: 0; width: 480px; height: 480px; viewbox-width: 480; viewbox-height: 480; stroke: #FF4A1C; stroke-width: 2.2px; stroke-line-cap: round;
            commands: "M " + (240 - 24 * Math.sin(parent.sa)) + " " + (226 + 24 * Math.cos(parent.sa)) + " L " + (240 + 113 * Math.sin(parent.sa)) + " " + (226 - 113 * Math.cos(parent.sa)); }
        Rectangle { x: 240px - 18px * Math.sin(parent.sa) - 5px; y: 226px + 18px * Math.cos(parent.sa) - 5px; width: 10px; height: 10px; border-radius: 5px; background: #FF4A1C; }
        Rectangle { x: 233px; y: 219px; width: 14px; height: 14px; border-radius: 7px; background: TFg.c; }
        Rectangle { x: 237.4px; y: 223.4px; width: 5.2px; height: 5.2px; border-radius: 2.6px; background: #FF4A1C; }
    }
    // 2 timing tower: the lap and its running time, the total and a delta chip against the best lap (green while faster,
    // Signal once slower), the last five laps (the best in purple)
    property <float> lap-now: max(0, root.watch - root.lap-at);
    if !root.ringing && root.mode == 2 && root.sw-look == 2: tower := Rectangle {
        property <color> green: Theme.dark ? #3ddc84 : #13804a;
        property <color> red: Theme.dark ? #ff7a55 : #c8320c;
        Text { x: 24px; y: 100px; width: 260px; height: 16px; text: "LAP " + (root.laps.length + 1); font-size: 12px; font-weight: 700; letter-spacing: 1.6px; color: root.sw-faint; }
        Text { x: 24px; y: 116px; width: 280px; height: 64px; text: root.lapfmt(root.sw-run(root.lap-now, root.sw-l0, 420)); font-family: "Space Grotesk"; font-size: 58px; font-weight: 500;
            letter-spacing: -1px; color: TFg.c; vertical-alignment: center; }
        Text { x: 296px; y: 100px; width: 160px; height: 16px; text: "TOTAL"; font-size: 12px; font-weight: 700; letter-spacing: 1.6px; color: root.sw-faint; horizontal-alignment: right; }
        Text { x: 296px; y: 116px; width: 160px; height: 30px; text: root.lapfmt(root.sw-run(root.watch, root.sw-w0, 420)); font-family: "Space Grotesk"; font-size: 22px; font-weight: 500; color: TFg.c;
            horizontal-alignment: right; vertical-alignment: center; }
        if root.lap-best >= 0: Rectangle {
            property <float> d: root.lap-now - root.lap-best;
            property <string> t: (self.d < 0 ? "−" : "+") + root.d2(self.d);
            x: 456px - dt.preferred-width - 20px; y: 152px; width: dt.preferred-width + 20px; height: 28px; border-radius: 6px;
            background: self.d < 0 ? tower.green.with-alpha(Theme.dark ? 0.16 : 0.14) : #FF4A1C.with-alpha(Theme.dark ? 0.18 : 0.14);
            dt := Text { x: 10px; text: parent.t; font-family: "Space Grotesk"; font-size: 18px; font-weight: 500; color: parent.d < 0 ? tower.green : tower.red;
                vertical-alignment: center; height: parent.height; }
        }
        // the header and the rows
        Text { x: 24px; y: 190px; width: 44px; height: 18px; text: "LAP"; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; color: root.sw-faint; vertical-alignment: center; }
        Text { x: 68px; y: 190px; width: 200px; height: 18px; text: "TIME"; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; color: root.sw-faint; vertical-alignment: center; }
        Text { x: 360px; y: 190px; width: 96px; height: 18px; text: "GAP"; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; color: root.sw-faint; vertical-alignment: center;
            horizontal-alignment: right; }
        property <float> push: root.lap-t < 220 ? 1 - Math.pow(1 - root.lap-t / 220, 3) : 1;
        // (#87) every lap: five rows show, the older ones scroll into view
        Flickable { x: 24px; y: 210px; width: 432px; height: 147px;
            content-height: Math.max(self.height, root.laps.length * 30px);
        for l[i] in root.laps: row := Rectangle {
            property <bool> best: root.lap-best >= 0 && Math.abs(l - root.lap-best) < 0.0005;
            // the entrance (25.T16): the rows drop in from the top one after another (14 px with a fade, 40 ms apart, 180 ms
            // each, ease-out)
            property <float> eu: sw-ent.armed ? 0 : root.eo((sw-ent.ent - 40 * i) / 180);
            x: 0; y: (i - 1 + tower.push) * 30px - (1 - row.eu) * 14px; width: 432px; height: 27px; border-radius: 6px; background: TFg.c.with-alpha(0.05);
            opacity: (i == 0 ? tower.push : 1) * row.eu;
            clip: true;
            // a new best lap: a purple shimmer sweeps across its row (500 ms)
            if i == 0 && row.best && root.lap-t < 500: Rectangle {
                x: -140px + (parent.width + 140px) * (root.lap-t / 500); y: 0; width: 140px; height: parent.height;
                background: @linear-gradient(90deg, #9b4dff00 0%, #9b4dff59 50%, #9b4dff00 100%);
            }
            Rectangle { x: 4px; y: 3px; width: 30px; height: 21px; border-radius: 4px; background: row.best ? #9b4dff : TFg.c.with-alpha(Theme.dark ? 0.14 : 0.12);
                Text { text: root.laps.length - i; font-size: 12px; font-weight: 700; color: row.best ? #ffffff : TFg.c; horizontal-alignment: center; vertical-alignment: center; } }
            Text { x: 44px; width: 220px; height: parent.height; text: root.lapfmt(l); font-family: "Space Grotesk"; font-size: 17px; font-weight: 500; color: TFg.c; vertical-alignment: center; }
            Text { x: parent.width - 104px; width: 96px; height: parent.height; text: row.best ? "BEST" : "+" + root.d2(l - root.lap-best);
                font-family: "Space Grotesk"; font-size: 15px; font-weight: 500; color: row.best ? #9b4dff : root.sw-faint; horizontal-alignment: right; vertical-alignment: center; }
        }
        }
    }

    // 3 LCD sports watch: a resin body with its printed pusher labels and a grey-green LCD with segment digits (ghosts at
    // 7 %), the last lap below, CHR / LAP / ▶ RUN; a tap on the LCD lights it teal for 3 s
    property <bool> lcd-glow;
    Timer { interval: 3s; running: root.lcd-glow; triggered => { root.lcd-glow = false; } }
    property <float> lcd-k: root.lcd-glow ? 1 : 0;
    animate lcd-k { duration: root.lcd-glow ? 60ms : 1000ms; easing: ease-out; }
    if !root.ringing && root.mode == 2 && root.sw-look == 3: lcdw := Rectangle {
        property <color> body: Theme.dark ? #1b1c20 : #ece9e2;
        property <color> bevel: Theme.dark ? #2b2c31 : #d6d2c8;
        property <color> pusher: Theme.dark ? #3a3b40 : #c9c5bb;
        property <color> print: Theme.dark ? #a7a39b : #55524c;
        property <color> ink: #0b2723.mix(#1d2620, root.lcd-k);
        // the entrance (25.T16), with a time on the stopwatch: every segment lights at once for 80 ms (all 8s and every
        // mark), then the time shows with the LCD's lag (T8); while the tab waits the LCD is blank. st: 0 blank, 1 all lit,
        // 2 the time
        property <int> st: sw-ent.armed ? (root.watch > 0 ? 0 : 2) : sw-ent.calm || sw-ent.ent >= 80 || root.sw-w0 <= 0 ? 2 : 1;
        pure function dg(v: int) -> int { return lcdw.st == 1 ? 8 : lcdw.st == 0 ? -1 : v; }
        property <float> dots: lcdw.st == 0 ? 0.07 : 1;
        for pp in [{ x: 36, y: 134 }, { x: 36, y: 290 }, { x: 432, y: 134 }, { x: 432, y: 290 }]: Rectangle {
            x: pp.x * 1px; y: pp.y * 1px; width: 12px; height: 22px; border-radius: 3px; background: lcdw.pusher; }
        Rectangle { x: 44px; y: 102px; width: 392px; height: 242px; border-radius: 46px; background: lcdw.body; }
        Rectangle { x: 56px; y: 114px; width: 368px; height: 218px; border-radius: 36px; border-width: 3px; border-color: lcdw.bevel; }
        for pr in [{ x: 72, y: 122, t: "LIGHT", a: 0, c: false }, { x: 408, y: 122, t: "START / STOP", a: 2, c: false }, { x: 72, y: 316, t: "MODE", a: 0, c: false },
                   { x: 408, y: 316, t: "LAP / RESET", a: 2, c: false }, { x: 240, y: 122, t: "1/100 SEC", a: 1, c: true }, { x: 240, y: 316, t: "LAP MEMORY 8", a: 1, c: false }]: Text {
            x: (pr.a == 0 ? pr.x : pr.a == 1 ? pr.x - 100 : pr.x - 200) * 1px; y: pr.y * 1px; width: 200px; height: 11px; text: pr.t; font-size: 9px; font-weight: 700;
            letter-spacing: pr.c ? 2px : 1.2px; color: pr.c ? #FF4A1C : lcdw.print;
            horizontal-alignment: pr.a == 0 ? TextHorizontalAlignment.left : pr.a == 1 ? TextHorizontalAlignment.center : TextHorizontalAlignment.right; }
        Rectangle { x: 80px; y: 140px; width: 320px; height: 166px; border-radius: 14px;
            background: @linear-gradient(180deg, #7fe7d6.mix(#b6c2ac, root.lcd-k) 0%, #45c2b0.mix(#9cab95, root.lcd-k) 100%);
            border-width: 2px; border-color: #2e8f82.mix(#7d8a76, root.lcd-k);
            TouchArea { clicked => { root.lcd-glow = true; } } }
        Text { x: 98px; y: 153px; text: "CHR"; font-size: 12px; font-weight: 700; letter-spacing: 1px; color: lcdw.ink; opacity: lcdw.st == 0 ? 0.08 : 1; }
        Text { x: 140px; y: 154px; text: "LAP"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: lcdw.ink;
            opacity: lcdw.st == 1 || (lcdw.st == 2 && root.laps.length > 0) ? 1 : 0.08; }
        Text { x: 172px; y: 154px; text: "SPLIT"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: lcdw.ink; opacity: lcdw.st == 1 ? 1 : 0.08; }
        Text { x: 282px; y: 154px; width: 100px; text: "▶ RUN"; font-size: 10px; font-weight: 700; letter-spacing: 1px; color: lcdw.ink; horizontal-alignment: right;
            opacity: lcdw.st == 1 ? 1 : lcdw.st == 2 && root.watch-running && Math.mod(Math.floor(animation-tick() / 500ms), 2) == 0 ? 1 : 0.08; }
        property <int> mins: Math.mod(Math.floor(root.watch / 60), 100);
        property <int> secs: Math.mod(Math.floor(root.watch), 60);
        property <int> cs: Math.mod(Math.floor(root.watch * 100), 100);
        Seg7 { d: lcdw.dg(lcdw.mins >= 10 ? Math.floor(lcdw.mins / 10) : -1); x0: 102; y0: 184; w: 40; h: 66; t: 8; ink: lcdw.ink; lag: true; }
        Seg7 { d: lcdw.dg(Math.mod(lcdw.mins, 10)); x0: 150; y0: 184; w: 40; h: 66; t: 8; ink: lcdw.ink; lag: true; }
        Seg7 { d: lcdw.dg(Math.floor(lcdw.secs / 10)); x0: 214; y0: 184; w: 40; h: 66; t: 8; ink: lcdw.ink; lag: true; }
        Seg7 { d: lcdw.dg(Math.mod(lcdw.secs, 10)); x0: 262; y0: 184; w: 40; h: 66; t: 8; ink: lcdw.ink; lag: true; }
        Seg7 { d: lcdw.dg(Math.floor(lcdw.cs / 10)); x0: 322; y0: 210; w: 26; h: 40; t: 6; ink: lcdw.ink; lag: true; }
        Seg7 { d: lcdw.dg(Math.mod(lcdw.cs, 10)); x0: 352; y0: 210; w: 26; h: 40; t: 6; ink: lcdw.ink; lag: true; }
        Rectangle { x: 201.4px; y: 201.4px; width: 7.2px; height: 7.2px; border-radius: 3.6px; background: lcdw.ink; opacity: lcdw.dots; }
        Rectangle { x: 198.4px; y: 227.4px; width: 7.2px; height: 7.2px; border-radius: 3.6px; background: lcdw.ink; opacity: lcdw.dots; }
        Rectangle { x: 312px; y: 246px; width: 5px; height: 5px; background: lcdw.ink; opacity: lcdw.dots; }
        // (#87) the laps in two LCD lines, L nn m:ss.cc, newest on top; the older ones scroll into view
        if root.laps.length > 0: Flickable {
            x: 96px; y: 256px; width: 290px; height: 48px;
            content-height: Math.max(self.height, root.laps.length * 24px);
            for l[i] in root.laps: Rectangle {
                property <int> n: root.laps.length - i;
                y: i * 24px; height: 24px;
                Seg7 { x: -96px; y: 0; d: lcdw.dg(10); x0: 104; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(parent.n >= 10 ? Math.mod(Math.floor(parent.n / 10), 10) : -1); x0: 122; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.mod(parent.n, 10)); x0: 138; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.mod(Math.floor(l / 60), 10)); x0: 170; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Rectangle { x: 90px; y: 7px; width: 3px; height: 3px; background: lcdw.ink; opacity: lcdw.dots; }
                Rectangle { x: 89px; y: 15px; width: 3px; height: 3px; background: lcdw.ink; opacity: lcdw.dots; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.floor(Math.mod(Math.floor(l), 60) / 10)); x0: 196; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.mod(Math.floor(l), 10)); x0: 212; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Rectangle { x: 133px; y: 19px; width: 3px; height: 3px; background: lcdw.ink; opacity: lcdw.dots; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.floor(Math.mod(Math.floor(l * 100), 100) / 10)); x0: 236; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
                Seg7 { x: -96px; y: 0; d: lcdw.dg(Math.mod(Math.floor(l * 100), 10)); x0: 252; y0: 2; w: 13; h: 20; t: 3; ink: lcdw.ink; lag: true; }
            }
        }
    }

    // 4 nixie tubes: mm ss cc in six tubes and three neon dots on a walnut plinth inside a dark case, the last lap below
    if !root.ringing && root.mode == 2 && root.sw-look == 4: nix := Rectangle {
        // the time as the tubes show it: the live time in every frame, hundredths included (only the tubes whose digit
        // changed draw anything new)
        property <int> mins: Math.mod(Math.floor(root.watch / 60), 100);
        property <int> secs: Math.mod(Math.floor(root.watch), 60);
        property <int> cs: Math.mod(Math.floor(root.watch * 100), 100);
        // what never changes behind the lit tubes, drawn once into one layer: the case, the plinth (board S4: walnut with
        // grain lines and a knot, end-grain shading, a bevel highlight, the darker lower edge and a soft contact shadow),
        // each tube's glass and socket
        Rectangle { cache-rendering-hint: true;
            Rectangle { x: 22px; y: 108px; width: 436px; height: 200px; border-radius: 18px; background: Theme.dark ? #0e0c0b : #1a1614; }
            // (the shadow's box hugs it, 2 px round, so the layer holds no empty screen)
            Path { x: 18px; y: 294px; width: 444px; height: 16px; viewbox-x: 18; viewbox-y: 294; viewbox-width: 444; viewbox-height: 16; fill: #000000; opacity: 0.5;
                commands: "M 20 302 A 220 6 0 1 0 460 302 A 220 6 0 1 0 20 302 Z"; }
            Rectangle { x: 30px; y: 264px; width: 420px; height: 34px; border-radius: 6px;
                background: @linear-gradient(180deg, #8a5634 0%, #6b3f22 45%, #3f2313 100%);
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 1.2px; opacity: 0.42;
                    commands: "M0 4.1 L10 4.8 L20 4.7 L30 4.3 L40 4.5 L50 5.1 L60 5.0 L70 4.3 L80 3.9 L90 4.2 L100 4.2 L110 3.6 L120 3.0 L130 3.3 L140 3.8 L150 3.8 L160 3.4 L170 3.6 L180 4.4 L190 4.8 L200 4.5 L210 4.3 L220 4.8 L230 5.2 L240 4.7 L250 4.0 L260 3.9 L270 4.3 L280 4.0 L290 3.3 L300 3.0 L310 3.5 L320 3.9 L330 3.6 L340 3.3 L350 3.9 L360 4.7 L370 4.7 L380 4.3 L390 4.4 L400 5.0 L410 5.1 L420 4.4"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #c08a5c; stroke-width: 0.8px; opacity: 0.22;
                    commands: "M0 6.4 L10 7.8 L20 7.2 L30 6.9 L40 7.2 L50 7.1 L60 6.3 L70 5.5 L80 5.6 L90 5.9 L100 5.5 L110 5.0 L120 5.2 L130 5.9 L140 6.3 L150 6.1 L160 6.2 L170 7.0 L180 7.7 L190 7.5 L200 7.1 L210 7.3 L220 7.8 L230 7.4 L240 6.5 L250 6.1 L260 6.3 L270 6.3 L280 5.5 L290 4.9 L300 5.3 L310 5.8 L320 5.7 L330 5.4 L340 5.8 L350 6.8 L360 7.2 L370 6.9 L380 6.9 L390 7.6 L400 8.0 L410 7.5 L420 6.8"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 8.8 L10 9.0 L20 8.3 L30 8.3 L40 8.3 L50 7.7 L60 7.0 L70 7.0 L80 7.7 L90 7.8 L100 7.5 L110 7.7 L120 8.7 L130 9.4 L140 9.4 L150 9.3 L160 9.9 L170 10.6 L180 10.5 L190 9.9 L200 9.7 L210 9.9 L220 9.7 L230 8.7 L240 8.0 L250 8.0 L260 8.1 L270 7.6 L280 6.9 L290 7.1 L300 7.8 L310 8.0 L320 7.7 L330 8.0 L340 9.0 L350 9.7 L360 9.6 L370 9.5 L380 10.1 L390 10.7 L400 10.5 L410 9.7 L420 9.5"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 11.1 L10 10.1 L20 10.3 L30 10.8 L40 10.7 L50 10.2 L60 10.3 L70 11.0 L80 11.4 L90 11.1 L100 10.9 L110 11.5 L120 12.1 L130 11.9 L140 11.4 L150 11.5 L160 12.1 L170 12.1 L180 11.4 L190 11.0 L200 11.3 L210 11.5 L220 10.9 L230 10.2 L240 10.4 L250 10.8 L260 10.7 L270 10.1 L280 10.1 L290 10.8 L300 11.2 L310 10.9 L320 10.7 L330 11.2 L340 11.9 L350 11.8 L360 11.4 L370 11.5 L380 12.1 L390 12.2 L400 11.5 L410 11.2 L420 11.5"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #c08a5c; stroke-width: 0.8px; opacity: 0.22;
                    commands: "M0 13.5 L10 12.3 L20 13.1 L30 13.5 L40 13.3 L50 13.2 L60 13.9 L70 14.6 L80 14.5 L90 14.1 L100 14.3 L110 14.9 L120 14.8 L130 14.1 L140 13.8 L150 14.1 L160 14.2 L170 13.4 L180 12.7 L190 12.8 L200 13.1 L210 12.8 L220 12.1 L230 12.0 L240 12.6 L250 12.9 L260 12.5 L270 12.4 L280 13.1 L290 13.8 L300 13.7 L310 13.5 L320 13.9 L330 14.7 L340 14.8 L350 14.3 L360 14.2 L370 14.7 L380 14.9 L390 14.2 L400 13.6 L410 13.6 L420 13.9"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 15.8 L10 16.5 L20 17.2 L30 17.1 L40 16.8 L50 17.1 L60 17.7 L70 17.6 L80 16.8 L90 16.6 L100 16.9 L110 16.8 L120 16.0 L130 15.2 L140 15.3 L150 15.5 L160 14.9 L170 14.2 L180 14.1 L190 14.6 L200 14.7 L210 14.2 L220 14.2 L230 14.9 L240 15.6 L250 15.5 L260 15.4 L270 16.0 L280 16.9 L290 17.1 L300 16.7 L310 16.8 L320 17.5 L330 17.8 L340 17.2 L350 16.7 L360 16.9 L370 17.1 L380 16.5 L390 15.6 L400 15.4 L410 15.6 L420 15.4"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 18.2 L10 19.3 L20 19.1 L30 18.4 L40 18.3 L50 18.8 L60 18.8 L70 18.1 L80 17.6 L90 17.9 L100 18.3 L110 17.8 L120 17.2 L130 17.3 L140 17.8 L150 17.8 L160 17.3 L170 17.2 L180 17.8 L190 18.2 L200 17.9 L210 17.6 L220 18.1 L230 18.7 L240 18.7 L250 18.3 L260 18.4 L270 19.0 L280 19.3 L290 18.7 L300 18.4 L310 18.8 L320 19.2 L330 18.8 L340 18.1 L350 18.1 L360 18.6 L370 18.4 L380 17.7 L390 17.4 L400 17.8 L410 18.0 L420 17.5"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #c08a5c; stroke-width: 0.8px; opacity: 0.22;
                    commands: "M0 20.5 L10 21.0 L20 20.2 L30 19.8 L40 20.1 L50 20.3 L60 19.7 L70 19.1 L80 19.3 L90 19.8 L100 19.7 L110 19.2 L120 19.2 L130 19.9 L140 20.3 L150 20.0 L160 19.9 L170 20.5 L180 21.2 L190 21.1 L200 20.8 L210 21.0 L220 21.8 L230 21.9 L240 21.4 L250 21.2 L260 21.7 L270 22.0 L280 21.4 L290 20.8 L300 20.9 L310 21.2 L320 20.9 L330 20.1 L340 19.8 L350 20.2 L360 20.2 L370 19.6 L380 19.1 L390 19.4 L400 19.9 L410 19.6 L420 19.1"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 1.2px; opacity: 0.42;
                    commands: "M0 22.9 L10 21.5 L20 21.0 L30 21.2 L40 21.8 L50 21.7 L60 21.3 L70 21.4 L80 22.2 L90 22.6 L100 22.4 L110 22.4 L120 23.1 L130 23.8 L140 23.7 L150 23.4 L160 23.8 L170 24.6 L180 24.7 L190 24.1 L200 24.0 L210 24.4 L220 24.6 L230 24.0 L240 23.4 L250 23.5 L260 23.7 L270 23.3 L280 22.4 L290 22.1 L300 22.5 L310 22.4 L320 21.6 L330 21.1 L340 21.5 L350 21.8 L360 21.5 L370 21.0 L380 21.3 L390 22.0 L400 22.2 L410 21.8 L420 21.9"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 25.2 L10 24.4 L20 24.6 L30 25.3 L40 25.5 L50 25.1 L60 24.9 L70 25.6 L80 26.1 L90 25.8 L100 25.4 L110 25.7 L120 26.3 L130 26.2 L140 25.6 L150 25.5 L160 26.0 L170 26.2 L180 25.6 L190 25.1 L200 25.4 L210 25.8 L220 25.4 L230 24.7 L240 24.7 L250 25.2 L260 25.1 L270 24.5 L280 24.2 L290 24.6 L300 25.0 L310 24.6 L320 24.1 L330 24.4 L340 25.0 L350 25.0 L360 24.5 L370 24.6 L380 25.3 L390 25.6 L400 25.2 L410 25.0 L420 25.5"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #c08a5c; stroke-width: 0.8px; opacity: 0.22;
                    commands: "M0 27.6 L10 27.8 L20 28.5 L30 28.9 L40 28.6 L50 28.2 L60 28.5 L70 29.1 L80 28.9 L90 28.2 L100 28.1 L110 28.6 L120 28.6 L130 27.9 L140 27.4 L150 27.7 L160 28.0 L170 27.4 L180 26.7 L190 26.7 L200 27.2 L210 27.0 L220 26.3 L230 26.1 L240 26.6 L250 26.9 L260 26.5 L270 26.1 L280 26.5 L290 27.2 L300 27.1 L310 26.7 L320 26.9 L330 27.6 L340 28.0 L350 27.6 L360 27.5 L370 28.1 L380 28.7 L390 28.5 L400 28.1 L410 28.4 L420 29.0"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 0.8px; opacity: 0.42;
                    commands: "M0 29.9 L10 31.3 L20 31.7 L30 31.3 L40 30.6 L50 30.5 L60 30.8 L70 30.7 L80 29.9 L90 29.4 L100 29.6 L110 29.8 L120 29.2 L130 28.5 L140 28.6 L150 29.0 L160 28.8 L170 28.1 L180 28.0 L190 28.6 L200 28.9 L210 28.5 L220 28.3 L230 28.8 L240 29.5 L250 29.4 L260 29.1 L270 29.4 L280 30.3 L290 30.6 L300 30.3 L310 30.3 L320 31.0 L330 31.5 L340 31.3 L350 30.9 L360 31.2 L370 31.8 L380 31.7 L390 31.1 L400 30.9 L410 31.4 L420 31.4"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: transparent; stroke: #2c170b; stroke-width: 1px; opacity: 0.45;
                    commands: "M 283 17 A 9 3.2 0 1 0 301 17 A 9 3.2 0 1 0 283 17 Z"; }
                Path { x: 0; y: 0; width: 420px; height: 34px; viewbox-width: 420; viewbox-height: 34; fill: #2c170b; opacity: 0.45;
                    commands: "M 288 17 A 4 1.4 0 1 0 296 17 A 4 1.4 0 1 0 288 17 Z"; }
                Rectangle { border-radius: 6px; background: @linear-gradient(90deg, #00000061 0%, #00000000 5%, #00000000 95%, #0000006b 100%); }
                Rectangle { x: 4px; y: 0; width: 412px; height: 1.8px; border-radius: 1px; background: #ffffff3d; }
                Rectangle { x: 0; y: 32px; width: 420px; height: 2px; border-radius: 1px; background: #00000066; } }
            for x in [47, 107, 183, 243, 319, 379]: NixieTubeBack { x: x * 1px; y: 124px; }
        }
        property <bool> cycling: root.flyback && (animation-tick() - root.fly-t0) < 400ms;
        // the entrance (25.T16), with a time on the stopwatch: every tube runs through 0-9 once (T9's cycle, 400 ms), then
        // stops on its digit; while the tab waits the tubes show 0
        property <bool> ent-cycle: !sw-ent.armed && !sw-ent.calm && sw-ent.ent < 400 && root.sw-w0 > 0;
        for x[i] in [47, 107, 183, 243, 319, 379]: NixieTube { x: x * 1px; y: 124px; n: i; steady: root.watch-running && i >= 4;
            d: nix.cycling ? Math.mod(Math.floor((animation-tick() - root.fly-t0) / 40ms) + i, 10)
                : nix.ent-cycle ? Math.mod(Math.floor(sw-ent.ent / 40) + i, 10) : sw-ent.armed ? 0
                : i == 0 ? Math.floor(nix.mins / 10) : i == 1 ? Math.mod(nix.mins, 10) : i == 2 ? Math.floor(nix.secs / 10) : i == 3 ? Math.mod(nix.secs, 10)
                : i == 4 ? Math.floor(nix.cs / 10) : Math.mod(nix.cs, 10); }
        // what never changes in front of the lit tubes, drawn once into one layer: each tube's anode mesh and glass
        // highlights, the three neon dots with their glow
        Rectangle { cache-rendering-hint: true;
            for x in [47, 107, 183, 243, 319, 379]: NixieTubeFront { x: x * 1px; y: 124px; }
            for dt in [{ x: 167, y: 164 }, { x: 167, y: 202 }, { x: 303, y: 222 }]: Rectangle { x: dt.x * 1px; y: dt.y * 1px; width: 9px; height: 9px; border-radius: 4.5px;
                background: #ffb35c; drop-shadow-blur: 10px; drop-shadow-color: #ff6a00; } }
        // the laps under the case, newest on top; two lines show, the rest scrolls
        if root.laps.length > 0: Flickable { x: 90px; y: 310px; width: 300px; height: 48px; content-height: max(self.height, root.laps.length * 24px);
            for l[i] in root.laps: Text { x: 0; y: i * 24px; width: parent.width; height: 24px; horizontal-alignment: center; vertical-alignment: center;
                text: "LAP " + (root.laps.length - i) + "   " + root.lapfmt(l); font-size: 18px; font-weight: 300; letter-spacing: 1px;
                color: i == 0 ? #ffb35c : #ffb35c99; } }
    }

    // ---------------------------------------------------------------- stopwatch
    if !root.ringing && root.mode == 2: sw := Rectangle {
        property <bool> plain: root.sw-look == 0;
        // the entrance (25.T16): the time counts up through the values in between (M10, 420 ms, ease-out), then runs live;
        // the laps list rolls in from the top
        property <float> v: sw.plain ? root.sw-run(root.watch, root.sw-w0, 420) : root.watch;
        property <length> roll: (1 - root.sk(420)) * Math.min(3, root.laps.length) * 34px;
        property <int> cs: Math.mod(Math.floor(sw.v * 100), 100);
        property <string> main: sw.v >= 3600 ? Math.floor(sw.v / 3600) + ":" + root.two(Math.mod(Math.floor(sw.v / 60), 60)) + ":" + root.two(Math.mod(Math.floor(sw.v), 60))
            : Math.floor(sw.v / 60) + ":" + root.two(Math.mod(Math.floor(sw.v), 60));
        property <length> big: root.watch >= 3600 ? 60px : 76px;
        // the hundredths share the big digits' baseline (Noto Sans descent = 0.293 em)
        HorizontalLayout {
            visible: sw.plain;
            x: 0; y: root.top + 30px; width: root.width; height: 92px; alignment: center; spacing: 2px;
            Text { text: sw.main; font-size: sw.big; font-weight: 600; color: TFg.c; vertical-alignment: bottom; }
            VerticalLayout { padding-bottom: (sw.big - 36px) * 0.293;
                Text { text: "." + root.two(sw.cs); font-size: 36px; font-weight: 600; color: TFg.c.with-alpha(0.50); vertical-alignment: bottom; } }
        }
        Text { visible: sw.plain; x: 0; y: root.top + 124px; width: root.width; height: 20px; text: root.watch-running ? "Running" : root.watch > 0 ? "Stopped" : ""; font-size: 14px; color: TFg.c.with-alpha(0.50);
            horizontal-alignment: center; vertical-alignment: center; }
        // M19: a new lap slides in from the top and pushes the others down (180 ms); the fourth slides out under the edge
        Flickable { visible: sw.plain; x: 40px; y: root.top + 156px; width: root.width - 80px; height: 3 * 34px;
            content-height: Math.max(self.height, root.laps.length * 34px);
        for l[i] in root.laps: Rectangle {
            x: 0; y: i * 34px + root.lap-off - sw.roll; width: parent.width; height: 30px;
            opacity: i == 0 ? 1 + root.lap-off / 34px : 1;
            Text { x: 0; width: 100px; height: parent.height; text: "Lap " + (root.laps.length - i); font-size: 15px; color: TFg.c.with-alpha(0.60); vertical-alignment: center; }
            Text { x: parent.width - 140px; width: 140px; height: parent.height; text: (l >= 3600 ? Math.floor(l / 3600) + ":" + root.two(Math.mod(Math.floor(l / 60), 60)) : Math.floor(l / 60) + "") + ":" + root.two(Math.mod(Math.floor(l), 60)) + "." + root.two(Math.mod(Math.floor(l * 100), 100));
                font-size: 15px; font-weight: 600; color: TFg.c.with-alpha(0.85); horizontal-alignment: right; vertical-alignment: center; }
            Rectangle { y: parent.height - 1px; height: 1px; background: TFg.c.with-alpha(0.08); }
        }
        }
        HorizontalLayout {
            x: 0; y: 362px; width: root.width; height: 72px; alignment: center; spacing: 22px;
            // one lap button (the flag) while it runs, Reset when stopped; play / pause stays in the middle
            Rectangle { width: 96px;
                if root.watch-running: RoundButton { x: (parent.width - 48px) / 2; y: (parent.height - 48px) / 2; size: 48px; icon-size: 24px; outline: true;
                    icon: "\u{F023D}"; act: "watch.lap"; }
                if !root.watch-running && root.watch > 0: Pill { x: (parent.width - self.width) / 2; y: (parent.height - 48px) / 2; text: "Reset"; h: 48px; act: "watch.reset"; } }
            RoundButton { size: 72px; icon-size: 38px; fill: root.watch-tint; ink: #ffffff; icon: root.watch-running ? "\u{F03E4}" : "\u{F040A}"; act: "watch.toggle"; }
            Rectangle { width: 96px; }
        }
    }

    // ---------------------------------------------------------------- another timer (the quick starts): the round + (34.7)
    // plain and synthwave while one or two run (three have a "+" cell in their grid, four or more fill it); kitchen, hourglass
    // and flip whenever timers run
    if !root.ringing && root.mode == 1 && root.n >= 1 && (root.n < 3 || root.theme == 1 || root.theme == 2 || root.theme == 4) && !root.quick: Rectangle {
        x: root.width - 16px - 40px; y: root.funcs > 1 ? 50px : 48px; width: 40px; height: 40px; border-radius: 20px;
        background: root.synth ? (add-ta.pressed ? #000000b3 : #00000080) : (add-ta.pressed ? TFg.c.with-alpha(0.22) : TFg.c.with-alpha(0.12));
        border-width: root.synth ? 1px : 0px; border-color: root.grid.with-alpha(0.55);
        Icon { width: parent.width; height: parent.height; text: "\u{F0415}"; font-size: 24px; color: root.synth ? #ffffff : TFg.c; }
        add-ta := TouchArea { x: -6px; y: -6px; width: parent.width + 12px; height: parent.height + 12px; clicked => { Act.act("timers.quick", ""); } }
    }

    // ---------------------------------------------------------------- tabs (only the functions switched on)
    if !root.ringing && root.funcs > 1: HorizontalLayout {
        x: 0; y: 52px; width: root.width; height: 36px; alignment: center; spacing: 8px;
        for f[i] in [
            { k: 0, on: root.alarm-on, icon: "\u{F0020}", text: "Alarm", badge: 0 },
            { k: 1, on: root.timer-on, icon: "\u{F13AB}", text: "Timer", badge: root.n },
            { k: 2, on: root.watch-on, icon: "\u{F0150}", text: "Stopwatch", badge: 0 },
        ]: Rectangle {
            visible: f.on;
            width: f.on ? tt.preferred-width + 54px + (f.badge > 0 ? 24px : 0px) : 0px; height: 36px; border-radius: 18px;
            TouchArea { clicked => { Act.act("timers.mode", f.k); } }
            background: f.k == root.mode ? (root.synth ? #00000080 : TFg.c.with-alpha(0.15)) : (root.synth ? #00000047 : transparent);
            border-width: f.k == root.mode ? 0px : 1px; border-color: root.synth ? root.grid.with-alpha(0.45) : TFg.c.with-alpha(0.18);
            Icon { x: 12px; y: 0; width: 22px; height: parent.height; text: f.icon; font-size: 18px; color: root.synth ? (f.k == root.mode ? #ffffff : #ffffffa6) : (f.k == root.mode ? TFg.c : TFg.c.with-alpha(0.65)); }
            tt := Text { x: 38px; y: 0; width: self.preferred-width; height: parent.height; text: f.text; font-size: 14px; font-weight: 600; color: root.synth ? (f.k == root.mode ? #ffffff : #ffffffa6) : (f.k == root.mode ? TFg.c : TFg.c.with-alpha(0.65)); vertical-alignment: center; }
            if f.badge > 0: Rectangle { x: 38px + tt.preferred-width + 6px; y: 8px; width: 20px; height: 20px; border-radius: 10px; background: root.synth ? #ffffff : TFg.c;
                Text { width: parent.width; height: parent.height; text: f.badge; font-size: 12px; font-weight: 700; color: root.synth || Theme.dark ? #111113 : #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
        }
    }

    // T1: the ring bursts into 8 dots flying out from where the one big ring was (300 ms)
    if root.pre-ring && root.ring-theme == 0: Rectangle {
        property <float> k: clamp(root.ring-t / 300, 0, 1);
        property <float> e: 1 - Math.pow(1 - self.k, 2);
        for d in 8: Rectangle {
            property <angle> a: d * 45deg - 90deg;
            property <float> r: 114 + 70 * parent.e;
            property <float> s: 12 * (1 - 0.5 * parent.k);
            x: (240 + self.r * Math.cos(self.a) - self.s / 2) * 1px; y: root.top + (128 + self.r * Math.sin(self.a) - self.s / 2) * 1px;
            width: self.s * 1px; height: self.s * 1px; border-radius: self.s / 2 * 1px; background: root.ring-tint; opacity: 1 - parent.k;
        }
    }

    // ---------------------------------------------------------------- ringing: full screen until stop
    // (an alarm in the twin-bell, sunrise, clock radio or 24-hour dial look rings in its look's own way, #30)
    if root.ring-shown && root.ring-alarm && root.alarm-look > 0: AlarmRing {
        look: root.alarm-look; time: root.ring-time; hour: root.ring-h >= 0 ? root.ring-h : root.now-h; label: root.ring-label; pulse: root.pulse;
        tint: root.ring-tint; now-h: root.now-h; sunrise-h: root.sunrise-h; sunset-h: root.sunset-h;
    }
    if root.ring-shown && !(root.ring-alarm && root.alarm-look > 0): Rectangle {
        background: @radial-gradient(circle, root.ring-tint.mix(#000000, 0.55 + 0.25 * root.pulse) 0%, root.ring-tint.mix(#000000, 0.22) 100%);
        if !root.ring-alarm: Rectangle { x: (root.width - 112px) / 2; y: 70px; width: 112px; height: 112px; border-radius: 56px; background: #ffffff26;
            Icon { width: parent.width; height: parent.height; text: "\u{F13AB}"; font-size: 60px; color: #ffffff; } }
        if root.ring-alarm: Text { x: 0; y: 60px; width: root.width; height: 130px; text: root.ring-time; font-size: 112px; font-weight: 700; color: #ffffff;
            horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 24px; y: 204px; width: root.width - 48px; height: 46px; text: root.ring-alarm ? root.ring-label : root.name(root.ring-label); font-size: 34px; font-weight: 700; color: #ffffff;
            horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { x: 0; y: 250px; width: root.width; height: 26px; text: root.ring-alarm ? "Good morning" : "Time's up  ·  +" + root.clock(root.ring-over); font-size: 18px; color: #ffffffcc;
            horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { x: (root.width - 220px) / 2; y: 312px; width: 220px; height: 64px; border-radius: 32px; background: #ffffff;
            Text { width: parent.width; height: parent.height; text: "Stop"; font-size: 22px; font-weight: 700; color: root.ring-tint.mix(#000000, 0.6); horizontal-alignment: center; vertical-alignment: center; } }
        Rectangle { x: (root.width - 140px) / 2; y: 392px; width: 140px; height: 44px; border-radius: 22px; background: #ffffff2e;
            Text { width: parent.width; height: parent.height; text: root.ring-alarm ? "Snooze 9 min" : "+1 min"; font-size: 16px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; } }
    }

    // ---------------------------------------------------------------- the timers tab's menus (spec 34): one timer's menu, the
    // new timer and the page's settings, each an object of the timer look (MenuHost places it, dims the page and closes it on
    // a tap beside it); they close when the page leaves the screen or a timer rings
    property <color> tm-tube: TimerLooks.tubes[Math.max(0, Math.min(3, root.sw-scene))];
    // one timer's menu: where the plain and synthwave looks show several timers, over the cell it came from
    property <bool> tm-cells: (root.theme == 0 || root.theme == 3) && root.n >= 2;
    property <bool> sheet-on: !root.ringing && root.mode == 1 && root.on-screen && root.tm-cells && root.sheet >= 0 && root.sheet < root.n;
    // the timer it shows, its cell and its place (kept while the menu leaves)
    property <TimerItem> st-live: root.sheet >= 0 && root.sheet < root.n ? root.timers[root.sheet] : root.st-kept;
    property <TimerItem> st-kept;
    changed st-live => { root.st-kept = root.st-live; }
    property <int> st-cell: root.n == 2 ? root.sheet : root.at(0) == root.sheet ? 0 : root.at(1) == root.sheet ? 1 : root.at(2) == root.sheet ? 2
        : root.n > 3 && root.at(3) == root.sheet ? 3 : -1;
    property <length> st-cx-live: root.st-cell < 0 ? 240px : root.n == 2 ? (root.theme == 3 ? 22px + root.st-cell * 230px + 103px : 28px + root.st-cell * 224px + 100px)
        : 20px + Math.mod(root.st-cell, 2) * 224px + 108px;
    property <length> st-cy-live: root.st-cell < 0 ? 258px : root.n == 2 ? root.top + (root.theme == 3 ? 12px + 95px : 6px + 100px)
        : root.top + Math.floor(root.st-cell / 2) * 176px + 84px;
    property <length> st-cx: root.sheet >= 0 ? root.st-cx-live : root.st-cx-kept;
    property <length> st-cy: root.sheet >= 0 ? root.st-cy-live : root.st-cy-kept;
    property <length> st-cx-kept;
    property <length> st-cy-kept;
    changed st-cx => { root.st-cx-kept = root.st-cx; }
    changed st-cy => { root.st-cy-kept = root.st-cy; }
    st-name := Text { visible: false; width: 268px; text: root.name(root.st-live.label); font-size: 16px; font-weight: 600; wrap: word-wrap; }
    st-title := Text { visible: false; width: 288px; text: root.name(root.st-live.label).to-uppercase(); font-family: "Press Start 2P"; font-size: 15px;
        letter-spacing: 1px; wrap: word-wrap; }
    property <length> st-w: root.theme == 3 ? 320px : 300px;
    property <length> st-need: root.theme == 3 ? st-title.preferred-height + 230px : st-name.preferred-height + 228px;
    property <length> st-h: Math.min(420px, root.st-need);
    property <length> st-x: clamp(root.st-cx - root.st-w / 2, 16px, 464px - root.st-w);
    property <length> st-y: clamp(root.st-cy - root.st-h / 2, 48px, 468px - root.st-h);
    // its colour as the page shows it (the synthwave scene's neon for its cell, red in its last minute)
    property <color> st-tint: root.theme != 3 ? root.st-live.tint
        : root.st-live.running && root.st-live.remaining < 60 ? #ff5a5f : root.sw-rings[root.sw-scene * 4 + Math.max(0, root.st-cell)];
    sheet-host := MenuHost {
        open: root.sheet-on; kind: 0; need: root.st-need;
        in-ms: root.theme == 3 ? 360ms : 140ms; out-ms: root.theme == 3 ? 200ms : 100ms;
        close => { Act.act("timers.sheet-close", ""); }
        TimerMenu {
            x: root.st-x; y: root.st-y; width: root.st-w; height: root.st-h;
            arcade: root.theme == 3; t: root.st-live; tint: root.st-tint; tube: root.tm-tube; index: Math.max(0, root.sheet);
            t-in: sheet-host.t-in; t-out: sheet-host.t-out; leaving: !sheet-host.open;
            grow-x: root.st-cx - root.st-x; grow-y: root.st-cy - root.st-y; name-h: st-name.preferred-height;
        }
    }
    // the new timer (the grid's "+" cell, the custom quick start)
    property <bool> new-on: !root.ringing && root.mode == 1 && root.on-screen && root.edit && root.edit-timer;
    new-host := MenuHost {
        open: root.new-on; kind: 1; need: newm.need;
        in-ms: TimerLooks.in-ms(root.theme); out-ms: TimerLooks.out-ms(root.theme);
        close => { Act.act("alarm.close", ""); }
        newm := NewTimerMenu {
            x: new-host.menu-x; y: new-host.menu-y; width: new-host.menu-w; height: new-host.menu-h;
            look: root.theme; tube: root.tm-tube; opened: new-host.open;
            hours <=> root.edit-h; minutes <=> root.edit-m; label: root.edit-label;
            t-in: new-host.t-in; t-out: new-host.t-out; leaving: !new-host.open;
            start => { Act.act("timers.create", ""); }
            edit-label => { Act.act("alarm.label", ""); }
        }
    }
    // the page's settings on the timers tab (the quick shade's page row)
    property <bool> set-on: !root.ringing && root.mode == 1 && root.on-screen && root.settings && !tm.swapping;
    set-host := MenuHost {
        open: root.set-on; kind: 1; need: setm.need;
        in-ms: TimerLooks.in-ms(root.theme); out-ms: TimerLooks.out-ms(root.theme);
        close => { Act.act("timers.settings", "close"); }
        setm := TimerSettingsMenu {
            x: set-host.menu-x; y: set-host.menu-y; width: set-host.menu-w; height: set-host.menu-h;
            look: root.theme; tube: root.tm-tube;
            t-in: set-host.t-in; t-out: set-host.t-out; leaving: !set-host.open;
            alarm-on: root.alarm-on; timer-on: root.timer-on; watch-on: root.watch-on; colourful: root.colourful;
            scene-choice: root.sw-choice >= -1 ? root.sw-choice : root.sw-scene;
            function-toggled(k) => { Act.act("timers.function", k); }
            colourful-picked(c) => { Act.act("timers.colourful", c ? "1" : "0"); }
            look-picked(i) => {
                if i != root.theme && !tm.swapping {
                    tm.swap-to = i;
                    tm.swapping = true;
                }
            }
            scene-picked(i) => { Act.act("timers.scene", i); }
            done => { Act.act("timers.settings", "close"); }
        }
    }

    // ---------------------------------------------------------------- alarm editor (spec 35): the alarm look's own menu under the
    // status bar, from the + or an alarm; hidden (not closed) while its label keyboard is up
    AlarmEditor {
        visible: !root.edit-keyboard;
        open: root.edit && !root.edit-timer && !root.ringing;
        look: root.alarm-look; is-new: root.edit-new; h <=> root.edit-h; m <=> root.edit-m; days: root.edit-days; label: root.edit-label;
        sound: root.edit-sound; ha-sounds: root.ha-sounds; info: root.edit-info; now-h: root.now-h + root.now-s / 3600;
        sound-options: root.edit-ha-sound != "" ? [root.sounds[0], root.sounds[1], root.sounds[2], root.sounds[3], root.sounds[4], root.sounds[5], root.edit-ha-sound]
            : [root.sounds[0], root.sounds[1], root.sounds[2], root.sounds[3], root.sounds[4], root.sounds[5]];
    }
    // label keyboard (the same block as on the setup screens); a label holds up to 60 characters (a timer's; an alarm's 32):
    // the count shows under the field, and a key pressed at the limit shakes the field (±4 px, three times in 300 ms); the
    // end of a long label stays in view
    if root.edit && root.edit-keyboard: kbv := Rectangle {
        background: Theme.background;
        TouchArea { }
        property <int> limit: root.edit-timer ? 60 : 32;
        property <int> count: root.edit-label.character-count;
        property <bool> full: kbv.count >= kbv.limit;
        property <bool> shaking;
        property <duration> s0;
        Timer { interval: 320ms; running: kbv.shaking; triggered => { kbv.shaking = false; } }
        property <length> shake: kbv.shaking ? 4px * Math.sin(1080deg * clamp((animation-tick() - kbv.s0) / 300ms, 0, 1)) : 0px;
        Text { x: 20px; y: 52px; height: 34px; text: root.edit-timer ? "Timer label" : "Alarm label"; font-size: 20px; font-weight: 600; color: TFg.c; vertical-alignment: center; }
        Rectangle { x: parent.width - 16px - 88px; y: 52px; width: 88px; height: 34px; border-radius: 17px; background: TFg.c;
            Text { width: parent.width; height: parent.height; text: "Done"; font-size: 15px; font-weight: 600; color: Theme.dark ? #101114 : #F5F3EE; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { Act.act("alarm.key", "enter"); } } }
        Rectangle {
            x: 16px + kbv.shake; y: 100px; width: parent.width - 32px; height: 52px; border-radius: 14px; background: TFg.c.with-alpha(0.07); border-width: 1.5px; border-color: root.edit-tint;
            Rectangle {
                x: 16px; width: parent.width - 66px; height: parent.height; clip: true;
                lt := Text { x: Math.min(0px, parent.width - 6px - self.preferred-width); width: self.preferred-width; height: parent.height; text: root.edit-label; font-size: 18px;
                    color: TFg.c; vertical-alignment: center; }
                Rectangle { x: lt.x + lt.width + 2px; y: 14px; width: 2px; height: 24px; background: root.edit-tint; }
            }
            if root.edit-label != "": Rectangle { x: parent.width - 44px; y: 8px; width: 36px; height: 36px; border-radius: 18px;
                Icon { width: parent.width; height: parent.height; text: "\u{F0159}"; font-size: 20px; color: TFg.c.with-alpha(0.50); }
                TouchArea { clicked => { Act.act("alarm.key", "clear"); } } }
        }
        Text { x: 20px; y: 162px; width: parent.width - 40px - 72px; height: 20px; text: root.edit-timer ? (root.edit-h > 0 ? root.edit-h + " h " : "") + root.edit-m + " min"
                : AlarmClock.hm(root.edit-h, root.edit-m) + "  ·  " + root.sounds[min(root.edit-sound, root.sounds.length - 1)];
            font-size: 13px; color: TFg.c.with-alpha(0.50); vertical-alignment: center; overflow: elide; }
        Text { x: parent.width - 20px - 72px; y: 162px; width: 72px; height: 20px; text: kbv.count + " / " + kbv.limit; font-size: 13px;
            font-weight: kbv.full ? 700 : 400; color: kbv.full ? root.edit-tint : TFg.c.with-alpha(0.50); horizontal-alignment: right; vertical-alignment: center; }
        Keyboard { x: Theme.pad; y: Theme.keyboard-top; width: root.width - 2 * Theme.pad; layer: root.kb-layer; layout: root.kb-layout; enter-label: "Done"; accent: root.edit-tint;
            key(k) => {
                if kbv.full && k != "enter" && k != "back" && k != "clear" && k != "shift" && k != "symbols" && k != "layout" {
                    kbv.s0 = animation-tick();
                    kbv.shaking = true;
                }
                Act.act("alarm.key", k);
            } }
    }

    // ---------------------------------------------------------------- the alarm and stopwatch tabs' settings (spec 35, 36): the page's
    // settings in the look's own menu, raised by the quick shade's page row (PageMenu) while the tab is on screen
    AlarmSettings { open <=> root.al-menu; look: root.alarm-look; alarm-on: root.alarm-on; timer-on: root.timer-on; watch-on: root.watch-on; colourful: root.colourful; }
    WatchSettings { open <=> root.sw-menu; look: root.sw-look; alarm-on: root.alarm-on; timer-on: root.timer-on; watch-on: root.watch-on; colourful: root.colourful; }
    property <[string]> alarm-looks: ["Plain", "Twin-bell", "Sunrise", "Clock radio", "24-hour dial"];
    property <[string]> watch-looks: ["Plain", "Chronograph", "Timing tower", "LCD watch", "Nixie"];
    property <[string]> alarm-icons: ["\u{F0020}", "\u{F078E}", "\u{F059C}", "\u{F0439}", "\u{F1478}"];
    property <[string]> watch-icons: ["\u{F051B}", "\u{F0589}", "\u{F023C}", "\u{F0897}", "\u{F06E9}"];
    // what the shade's page row shows for the tab on screen (the timers tab fills in its own)
    property <string> pm-look: root.mode == 0 ? "Alarms · " + root.alarm-looks[Math.max(0, Math.min(4, root.alarm-look))]
        : root.mode == 2 ? "Stopwatch · " + root.watch-looks[Math.max(0, Math.min(4, root.sw-look))] : "";
    function pm-fill() {
        if root.on-screen && root.mode != 1 {
            PageMenu.title = "Timers settings";
            PageMenu.look = root.pm-look;
            PageMenu.icon = root.mode == 0 ? root.alarm-icons[Math.max(0, Math.min(4, root.alarm-look))] : root.watch-icons[Math.max(0, Math.min(4, root.sw-look))];
            PageMenu.has-settings = true;
        }
    }
    Rectangle {
        // (helper properties: a page knows when it is on screen, its tab and the page row's request)
        property <bool> shown: root.on-screen;
        property <string> look: root.pm-look;
        property <int> req: PageMenu.open-request;
        property <int> tab: root.mode;
        property <bool> rings: root.ringing;
        init => { root.pm-fill(); }
        changed shown => {
            root.pm-fill();
            // #9: the menus close when the page leaves the screen
            if !root.on-screen {
                root.al-menu = false;
                root.sw-menu = false;
                if root.edit && !root.edit-timer { Act.act("alarm.close", ""); }
            }
        }
        changed look => { root.pm-fill(); }
        changed tab => { root.al-menu = false; root.sw-menu = false; root.pm-fill(); }
        changed rings => {
            if root.ringing {
                root.al-menu = false;
                root.sw-menu = false;
                if root.edit && !root.edit-timer { Act.act("alarm.close", ""); }
            }
        }
        changed req => {
            if root.on-screen && !root.ringing {
                if root.mode == 0 { root.sw-menu = false; root.al-menu = true; }
                if root.mode == 2 { root.al-menu = false; root.sw-menu = true; }
            }
        }
    }
}
