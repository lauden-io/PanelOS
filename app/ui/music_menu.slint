// The music page's menus (spec 32.1): "Play on" hangs from the speaker chip, the page's settings come down under the
// status bar (opened from the quick shade's page row). Each look draws them as an object of its own world:
//   skin 0, the brand card (plain, full cover): the 28.5 menu; settings on the surface card;
//   skin 1, the record sleeve (turntable): "Play on" is the back of the sleeve, the settings the inner sleeve;
//   skin 2, the J-card (cassette, half cassette): a mixtape tracklist in blue pen, the settings its Side B.
// The host (MenuHost) places the menu, dims the page and runs the motion clocks; this draws the menu and moves it.
import { Theme, Act } from "theme.slint";
import { Icon, Dropdown, Segmented, Toggle, TextButton, TouchSlider, Jelly } from "widgets.slint";

export struct MusicPlayer {
    name: string,       // "Kitchen speaker"
    icon: string,       // speaker, display, TV …
    active: bool,       // the page shows / controls this one
    grouped: bool,      // plays together with the active one
    playing: bool,      // plays something (maybe something else)
    now: string,        // what it plays ("Go West · Pet Shop Boys"), empty when idle
}

// cubic ease-out and ease-in on 0..1
global MenuEase {
    public pure function eo(u: float) -> float {
        let v = 1 - Math.max(0, Math.min(1, u));
        return 1 - v * v * v;
    }
    public pure function ei(u: float) -> float {
        let v = Math.max(0, Math.min(1, u));
        return v * v * v;
    }
}

// the J-card's pen circle: four quarter ellipses of slightly different radii (a circle drawn by hand)
component PenCircle inherits Path {
    viewbox-width: 34;
    viewbox-height: 34;
    MoveTo { x: 16.32; y: 0; }
    ArcTo { x: 34; y: 15.3; radius-x: 17.68; radius-y: 15.3; sweep: true; }
    ArcTo { x: 18.36; y: 34; radius-x: 15.64; radius-y: 18.7; sweep: true; }
    ArcTo { x: 0; y: 18.7; radius-x: 18.36; radius-y: 15.3; sweep: true; }
    ArcTo { x: 16.32; y: 0; radius-x: 16.32; radius-y: 18.7; sweep: true; }
    Close { }
}

// the sleeve's dotted rule (1 px dots, 1 px apart)
component Dots inherits Rectangle {
    height: 1px;
    clip: true;
    Image { x: 0; y: 0; width: 448px; height: 1px; source: @image-url("music/menu/sleeve-dots.png"); }
}

// a round row button: ⇄ (move the music there) or + / ✓ (play there too / plays there)
component RowButton inherits Rectangle {
    in property <int> skin;
    in property <string> glyph;
    in property <bool> filled;            // grouped (or the shown player's check)
    in property <bool> signal;            // the shown player's check on the brand card: Signal ground
    in property <color> ink;
    in property <color> paper;
    in property <bool> enabled: true;
    callback tapped;
    property <length> d: root.skin == 0 ? 36px : root.skin == 1 ? 32px : 34px;
    width: root.d;
    height: root.d;
    if root.skin != 2: Rectangle {
        border-radius: root.d / 2;
        background: root.skin == 0 ? (root.signal ? #FF4A1C : root.filled ? root.ink.with-alpha(0.18) : transparent) : (root.filled ? root.ink : transparent);
        border-width: root.filled ? 0px : root.skin == 0 ? 1.5px : 2px;
        border-color: root.skin == 0 ? root.ink.with-alpha(0.3) : root.ink;
    }
    if root.skin == 2: PenCircle {
        width: root.d; height: root.d;
        fill: root.filled ? root.ink : transparent;
        stroke: root.ink; stroke-width: 2px;
    }
    Icon {
        text: root.glyph; font-size: 20px;
        color: root.skin == 0 ? (root.signal ? #ffffff : root.ink) : root.filled ? (root.skin == 1 ? root.paper : #ffffff) : root.ink;
    }
    opacity: ta.pressed ? 0.6 : 1;
    ta := TouchArea { x: (root.d - 44px) / 2; y: (root.d - 44px) / 2; width: 44px; height: 44px; enabled: root.enabled; clicked => { root.tapped(); } }
}

// one player of "Play on": the number (or the speaker), the name (wraps to a second line), what it plays, ⇄ and + / ✓
component PlayerRow inherits Rectangle {
    in property <int> skin;
    in property <MusicPlayer> p;
    in property <int> n;
    in property <bool> flash;
    in property <color> ink;
    in property <color> muted;
    in property <color> paper;
    callback tap();
    callback transfer();
    callback group();
    property <length> pl: root.skin == 0 ? 10px : 0px;
    property <length> pr: root.skin == 0 ? 4px : 0px;
    property <length> gap: root.skin == 0 ? 10px : 8px;
    property <length> no-w: root.skin == 0 ? 22px : root.skin == 1 ? 26px : 24px;
    property <length> bt: root.skin == 0 ? 36px : root.skin == 1 ? 32px : 34px;
    property <length> nx: root.pl + root.no-w + root.gap;
    property <length> nw: root.width - root.nx - root.gap - (root.p.active ? 0px : root.bt + root.gap) - root.bt - root.pr;
    property <string> now: root.p.now != "" ? root.p.now : root.p.active ? "Shown here" : "";
    property <length> eq-w: root.p.now != "" && root.p.playing ? 17px : 0px;
    property <length> name-h: name.preferred-height;
    property <length> now-h: root.now != "" ? now-t.preferred-height : 0px;
    property <length> block: root.name-h + root.now-h;
    property <length> top: (root.height - root.block) / 2;
    height: Math.max(52px, root.block + 8px);
    border-radius: root.skin == 0 ? 10px : 0px;
    background: root.flash ? (root.skin == 0 ? Theme.surface-pressed : root.skin == 1 ? #2b26201a : #2a4fa014)
        : root.skin == 0 && root.p.active ? #FF4A1C29 : transparent;
    TouchArea { clicked => { root.tap(); } }
    // the speaker (brand), "A1" (sleeve), "1." (J-card)
    if root.skin == 0: Icon { x: root.pl; y: 0; width: root.no-w; height: root.height; text: root.p.icon; font-size: 22px;
        color: root.p.active ? root.ink : root.muted; }
    if root.skin != 0: Text { x: root.pl; y: 0; width: root.no-w; height: root.height;
        text: root.skin == 1 ? "A" + (root.n + 1) : (root.n + 1) + ".";
        font-family: root.skin == 1 ? "Courier Prime" : "Caveat"; font-size: root.skin == 1 ? 13px : 22px; font-weight: 700;
        color: root.skin == 1 && root.p.active ? #FF4A1C : root.ink; vertical-alignment: center; }
    // the sleeve's marker stroke and the J-card's highlighter under the shown player's name
    if root.skin != 0 && root.p.active: Rectangle {
        x: root.nx; y: root.top + root.name-h * 0.58; width: Math.min(root.nw, name.preferred-width); height: root.name-h * 0.42;
        background: root.skin == 1 ? #FF4A1C38 : #FFD60080;
    }
    name := Text {
        x: root.nx; y: root.top; width: root.nw;
        text: root.skin == 1 ? root.p.name.to-uppercase() : root.p.name;
        wrap: word-wrap;
        font-family: root.skin == 1 ? "Oswald" : root.skin == 2 ? "Caveat" : "";
        font-size: root.skin == 0 ? 15px : root.skin == 1 ? 18px : 25px;
        font-weight: root.skin == 0 ? (root.p.active ? 600 : 400) : root.skin == 1 ? 500 : 700;
        letter-spacing: root.skin == 1 ? 0.5px : 0px;
        color: root.skin == 2 ? #2a4fa0 : root.ink;
    }
    // what it plays: three bars while it plays
    if root.eq-w > 0: Rectangle {
        x: root.nx; y: root.top + root.name-h + 3px; width: 11px; height: 11px;
        Rectangle { x: 0; y: 5px; width: 3px; height: 6px; border-radius: 1px; background: #FF4A1C; }
        Rectangle { x: 4px; y: 0; width: 3px; height: 11px; border-radius: 1px; background: #FF4A1C; }
        Rectangle { x: 8px; y: 2px; width: 3px; height: 9px; border-radius: 1px; background: #FF4A1C; }
    }
    now-t := Text {
        x: root.nx + root.eq-w; y: root.top + root.name-h; width: root.nw - root.eq-w;
        visible: root.now != "";
        text: root.now;
        wrap: word-wrap;
        font-family: root.skin == 1 ? "Courier Prime" : root.skin == 2 ? "Caveat" : "";
        font-size: root.skin == 0 ? 12px : root.skin == 1 ? 12px : 17px;
        font-weight: root.skin == 2 ? 500 : 400;
        color: root.muted;
    }
    // ⇄ (not for the shown one) and + / ✓
    if !root.p.active: RowButton {
        x: root.width - root.pr - root.bt - root.gap - root.bt; y: (root.height - root.bt) / 2;
        skin: root.skin; glyph: "\u{F04E1}"; ink: root.ink; paper: root.paper;
        tapped => { root.transfer(); }
    }
    RowButton {
        x: root.width - root.pr - root.bt; y: (root.height - root.bt) / 2;
        skin: root.skin; glyph: root.p.active || root.p.grouped ? "\u{F012C}" : "\u{F0415}";
        filled: root.p.active || root.p.grouped; signal: root.skin == 0 && root.p.active;
        ink: root.ink; paper: root.paper; enabled: !root.p.active;
        tapped => { root.group(); }
    }
    // the sleeve's dotted rule and the J-card's ruled line under every track
    if root.skin == 1: Dots { x: 0; y: root.height - 1px; width: root.width; }
    if root.skin == 2: Rectangle { x: 0; y: root.height - 1px; width: root.width; height: 1px; background: #5078c84d; }
}

// a settings row: the label above its control (or beside it: `inline`), in the skin's own lettering
component MenuSetRow inherits Rectangle {
    in property <int> skin;
    in property <string> label;
    in property <bool> inline;
    in property <length> ctl-h;
    in property <length> ctl-w: 56px;
    in property <color> ink;
    in property <color> muted;
    property <length> px: root.skin == 0 ? 10px : 2px;
    property <length> lw: root.inline ? root.width - 2 * root.px - root.ctl-w - 12px : root.width - 2 * root.px;
    property <length> lh: lbl.preferred-height;
    height: root.inline ? Math.max(root.lh, root.ctl-h) + 16px : 8px + root.lh + 6px + root.ctl-h + 8px;
    lbl := Text {
        x: root.px; y: root.inline ? (root.height - root.lh) / 2 : 8px; width: root.lw;
        text: root.skin == 1 ? root.label.to-uppercase() : root.label;
        wrap: word-wrap;
        font-family: root.skin == 1 ? "Courier Prime" : root.skin == 2 ? "Caveat" : "";
        font-size: root.skin == 0 ? (root.inline ? 15px : 14px) : root.skin == 1 ? 12px : 22px;
        font-weight: root.skin == 0 ? (root.inline ? 400 : 500) : 700;
        letter-spacing: root.skin == 1 ? 1.5px : 0px;
        color: root.skin == 0 ? (root.inline ? root.ink : root.muted) : #2b2620;
    }
    Rectangle {
        x: root.inline ? root.width - root.px - root.ctl-w : root.px;
        y: root.inline ? (root.height - root.ctl-h) / 2 : 8px + root.lh + 6px;
        width: root.inline ? root.ctl-w : root.width - 2 * root.px;
        height: root.ctl-h;
        @children
    }
    if root.skin == 1: Dots { x: 0; y: root.height - 1px; width: root.width; }
    if root.skin == 2: Rectangle { x: 0; y: root.height - 1px; width: root.width; height: 1px; background: #5078c84d; }
}

export component MusicMenu inherits Rectangle {
    in property <int> skin;                // 0 brand card, 1 record sleeve, 2 J-card
    in property <int> kind;                // 0 "Play on", 1 the page's settings
    in property <bool> open;
    in property <float> t-in;              // the host's motion clocks (ms)
    in property <float> t-out;
    in property <[MusicPlayer]> players;
    in property <int> style;               // the page's look: 0 plain, 1 full cover, 2 turntable, 3 cassette, 4 half cassette
    in property <int> holds;
    in property <int> wood;
    in property <[image]> woods;
    in property <bool> scroll;
    in property <float> scroll-speed: 3;
    in property <bool> cover-blur;
    in property <bool> cs-cover;
    in property <color> tape: #e8701e;     // the J-card's spine: the tape's colour
    callback pick-look(int);
    callback done();
    // ---- the skin's colours (spec 32.0 tokens)
    property <color> paper: root.skin == 0 ? (root.kind == 0 ? Theme.surface-raised : Theme.surface) : root.skin == 1 ? (root.kind == 0 ? #ece4d1 : #f4efe4) : #fbfaf6;
    property <color> ink: root.skin == 0 ? Theme.text : root.skin == 1 ? #2b2620 : #2a4fa0;
    property <color> muted: root.skin == 0 ? Theme.muted : root.skin == 1 ? #6b6256 : #6c7486;
    property <color> line: root.skin == 0 ? Theme.outline : root.skin == 1 ? #2b262052 : #2a4fa061;
    property <color> raised: root.skin == 0 ? Theme.surface-raised : root.skin == 1 ? #2b262014 : #2a4fa014;
    property <color> pressed: root.skin == 0 ? Theme.surface-pressed : root.skin == 1 ? #2b262029 : #2a4fa029;
    property <color> on-text: root.skin == 0 ? Theme.background : root.skin == 1 ? #f3ecdc : #fbfaf6;
    property <color> menu: root.skin == 0 ? Theme.surface-raised : root.skin == 1 ? #f3ecdc : #fbfaf6;
    property <color> track: root.skin == 0 ? Theme.text.with-alpha(Theme.dark ? 0.14 : 0.12) : root.skin == 1 ? #2b26202e : #2a4fa033;
    property <color> knob: root.skin == 0 ? Theme.faint : root.ink;
    // ---- the parts around the body: the head above, the footer / Done below
    property <length> pad-x: root.skin == 0 ? 7px : root.skin == 1 ? 16px : 14px;
    property <length> body-y: root.skin == 0 ? (root.kind == 0 ? 39px : 48px) : root.skin == 1 ? 55px : 68px;
    property <length> foot: root.skin == 0 ? (root.kind == 0 ? 7px : 69px) : root.skin == 1 ? (root.kind == 0 ? 31px : 68px) : (root.kind == 0 ? 10px : 68px);
    property <length> fixed: root.body-y + root.foot;
    out property <length> need: root.fixed + (root.kind == 0 ? list.preferred-height : sets.preferred-height);
    property <length> body-h: Math.max(0px, root.height - root.fixed);
    // ---- motion
    // brand card (28.5): 140 ms, 0.96 → 1 with a fade, from the edge it hangs from; out: a 100 ms fade
    property <float> bu: MenuEase.eo(root.t-in / 140);
    // the sleeve: pulled out from the right edge (J-edge 90 / 300, at most 8 px past), back in 180 ms ease-in; the inner
    // sleeve drops in from the top (J-edge 80 / 300, at most 6 px past) with a short sway, up again in 180 ms
    property <float> s-w: root.width / 1px + 24;
    property <float> s-x: root.s-w * (1 - Jelly.edge(root.t-in, 90, 300));
    property <float> s-h: root.height / 1px + 60;
    property <float> s-y: root.s-h * (1 - Jelly.edge(root.t-in, 80, 300));
    property <bool> s-rest: root.t-in >= (root.kind == 0 ? 650 : 700);
    property <length> s-dx: root.skin != 1 ? 0px : !root.open ? (root.kind == 0 ? root.s-w * MenuEase.ei(root.t-out / 180) * 1px : 0px)
        : root.s-rest ? 0px : root.kind == 0 ? (root.s-x > 0 ? root.s-x : -Jelly.cap(-root.s-x, 8)) * 1px
        : 3px * Math.sin(360deg * root.t-in / 260) * Math.pow(2.71828, -root.t-in / 220);
    property <length> s-dy: root.skin != 1 || root.kind == 0 ? 0px : !root.open ? -root.s-h * MenuEase.ei(root.t-out / 180) * 1px
        : root.s-rest ? 0px : -(root.s-y > 0 ? root.s-y : -Jelly.cap(-root.s-y, 6)) * 1px;
    // the J-card: the spine drops first (90 ms), the card unfolds down from it (260 ms ease-out) with a moving crease
    // shadow, then a 3 px bounce; it folds up in 200 ms
    property <float> j-h: root.height / 1px;
    property <float> j-shown: !root.open ? root.j-h * (1 - MenuEase.ei(root.t-out / 200))
        : root.t-in < 90 ? 26 * MenuEase.eo(root.t-in / 90) : 26 + (root.j-h - 26) * MenuEase.eo((root.t-in - 90) / 260);
    property <length> j-bounce: root.open && root.t-in > 350 && root.t-in < 520 ? 3px * Math.sin(180deg * Math.min(1, (root.t-in - 350) / 170)) : 0px;
    property <bool> j-fold: root.open && root.t-in > 90 && root.t-in < 350;
    // ---- state
    property <int> flash-i: -1;
    property <float> speed-live: (root.scroll-speed - 1) / 4;
    // the counter's swatches: 52 px apart by 8, a 4 px margin for the chosen one's ring
    property <int> wood-cols: Math.max(1, Math.floor((root.width - 2 * root.pad-x - (root.skin == 0 ? 20px : 4px) - 8px + 8px) / 60px));
    property <int> wood-rows: Math.max(1, Math.ceil(root.woods.length / root.wood-cols));
    changed open => {
        if self.open {
            self.flash-i = -1;
            list-f.content-y = 0;
            set-f.content-y = 0;
        }
    }
    // a tap on a player flashes the row for 90 ms, then shows that player here (the panel remembers it)
    Timer { interval: 90ms; running: root.flash-i >= 0; triggered => { Act.act("music.show", root.flash-i); root.flash-i = -1; } }

    card := Rectangle {
        x: root.s-dx;
        y: root.skin == 2 ? root.j-bounce : root.s-dy;
        width: root.width;
        height: root.skin == 2 ? Math.max(0, Math.min(root.j-h, root.j-shown)) * 1px : root.height;
        opacity: root.skin != 0 ? 1 : root.open ? root.bu : Math.max(0, 1 - root.t-out / 100);
        transform-scale-x: root.skin == 0 && root.open ? 0.96 + 0.04 * root.bu : 1;
        transform-scale-y: root.skin == 0 && root.open ? 0.96 + 0.04 * root.bu : 1;
        transform-origin: { x: root.kind == 0 ? self.width : self.width / 2, y: 0px };
        clip: true;
        border-radius: root.skin == 0 ? 14px : root.skin == 1 ? 3px : 4px;
        background: root.paper;
        border-width: root.skin == 2 ? 0px : 1px;
        border-color: root.skin == 0 ? root.line : #00000014;
        drop-shadow-blur: root.skin == 0 ? 32px : 30px;
        drop-shadow-offset-y: root.skin == 0 ? 12px : 14px;
        drop-shadow-color: root.skin == 0 ? #00000073 : #00000080;
        // taps on the menu stay on it (a tap beside it closes it)
        TouchArea { }

        // ---- the record sleeve's card stock: grain, the worn ring of the record inside, a soft darker rim
        if root.skin == 1: Image { x: 0; y: 0; width: 448px; height: 420px; source: @image-url("music/menu/sleeve-grain.png"); }
        if root.skin == 1 && root.kind == 0: Rectangle {
            x: root.width - 170px; y: root.height - 150px; width: 300px; height: 300px; border-radius: 150px;
            border-width: 46px; border-color: #3c281408;
            Rectangle { border-radius: 150px; border-width: 2px; border-color: #3c281412; }
        }
        if root.skin == 1: Rectangle { x: 0; y: 0; width: root.width; height: 40px; background: @linear-gradient(180deg, #785a321f 0%, #785a3200 100%); }
        if root.skin == 1: Rectangle { x: 0; y: root.height - 40px; width: root.width; height: 40px; background: @linear-gradient(0deg, #785a321f 0%, #785a3200 100%); }
        if root.skin == 1: Rectangle { x: 0; y: 0; width: 40px; height: root.height; background: @linear-gradient(90deg, #785a321f 0%, #785a3200 100%); }
        if root.skin == 1: Rectangle { x: root.width - 40px; y: 0; width: 40px; height: root.height; background: @linear-gradient(270deg, #785a321f 0%, #785a3200 100%); }

        // ---- the head
        // brand: "Play on" (13 / 600 muted) or "Music" (Space Grotesk 20)
        if root.skin == 0: Text {
            x: root.pad-x + 10px; y: root.kind == 0 ? 7px + 8px : 7px + 10px; width: root.width - 2 * root.pad-x - 20px; height: root.kind == 0 ? 18px : 27px;
            text: root.kind == 0 ? "Play on" : "Music";
            font-family: root.kind == 0 ? "" : "Space Grotesk";
            font-size: root.kind == 0 ? 13px : 20px; font-weight: root.kind == 0 ? 600 : 500;
            color: root.kind == 0 ? root.muted : root.ink; vertical-alignment: center;
        }
        // sleeve: "PLAY ON" / "SETTINGS" over a double rule, "SIDE A" / "SIDE B" at the right
        if root.skin == 1: Text {
            x: root.pad-x; y: 14px; width: root.width - 2 * root.pad-x - 70px; height: 30px;
            text: root.kind == 0 ? "PLAY ON" : "SETTINGS";
            font-family: "Oswald"; font-size: 28px; font-weight: 700; letter-spacing: 3px; color: #2b2620; vertical-alignment: center;
        }
        if root.skin == 1: Text {
            x: root.width - root.pad-x - 80px; y: 14px; width: 80px; height: 30px;
            text: root.kind == 0 ? "SIDE A" : "SIDE B";
            font-family: "Courier Prime"; font-size: 12px; font-weight: 700; letter-spacing: 2px; color: #2b2620;
            horizontal-alignment: right; vertical-alignment: bottom;
        }
        if root.skin == 1: Rectangle { x: root.pad-x; y: 48px; width: root.width - 2 * root.pad-x; height: 1px; background: #2b2620; }
        if root.skin == 1: Rectangle { x: root.pad-x; y: 50px; width: root.width - 2 * root.pad-x; height: 1px; background: #2b2620; }
        // J-card: the spine in the tape's colour with its crease, then "Play on" / "Settings" in pen over a line
        if root.skin == 2: Rectangle {
            x: 0; y: 0; width: root.width; height: 26px; background: root.tape;
            Text { x: 14px; width: parent.width - 28px; text: root.kind == 0 ? "PANELOS MIX · SIDE A" : "PANELOS MIX · SIDE B";
                font-family: "Oswald"; font-size: 12px; font-weight: 600; letter-spacing: 3px; color: #ffffff; vertical-alignment: center; }
        }
        if root.skin == 2: Rectangle { x: 0; y: 26px; width: root.width; height: 1px; background: #00000033; }
        if root.skin == 2: Rectangle { x: 0; y: 27px; width: root.width; height: 1px; background: #ffffffb3; }
        if root.skin == 2: Text {
            x: root.pad-x; y: 32px; width: root.width - 2 * root.pad-x; height: 30px;
            text: root.kind == 0 ? "Play on" : "Settings";
            font-family: "Caveat"; font-size: 30px; font-weight: 700; color: #2b2620; vertical-alignment: center;
        }
        if root.skin == 2: Rectangle { x: root.pad-x; y: 66px; width: root.width - 2 * root.pad-x; height: 2px; background: root.tape; }

        // ---- "Play on": the players
        list-f := Flickable {
            x: root.pad-x; y: root.body-y; width: root.width - 2 * root.pad-x; height: root.body-h;
            visible: root.kind == 0;
            content-height: Math.max(self.height, list.preferred-height);
            list := VerticalLayout {
                width: parent.width; height: self.preferred-height;
                alignment: start;
                for p[i] in root.players: PlayerRow {
                    skin: root.skin; p: p; n: i; flash: root.flash-i == i;
                    ink: root.ink; muted: root.muted; paper: root.paper;
                    tap => { if root.flash-i < 0 { root.flash-i = i; } }
                    transfer => { Act.act("music.transfer", i); }
                    group => { Act.act("music.group", i); }
                }
            }
        }
        // the sleeve's catalogue line
        if root.skin == 1 && root.kind == 0: Text {
            x: root.pad-x; y: root.height - 31px + 8px; width: root.width - 2 * root.pad-x; height: 13px;
            text: "PNL·0005  ·  33⅓ RPM  ·  STEREO";
            font-family: "Courier Prime"; font-size: 9.5px; font-weight: 700; letter-spacing: 1.5px; color: #6b6256;
            horizontal-alignment: right; vertical-alignment: center;
        }

        // ---- the page's settings: look, what the record / tape holds, the counter's wood, the cover, long titles
        set-f := Flickable {
            x: root.pad-x; y: root.body-y; width: root.width - 2 * root.pad-x; height: root.body-h;
            visible: root.kind == 1;
            content-height: Math.max(self.height, sets.preferred-height);
            sets := VerticalLayout {
                width: parent.width; height: self.preferred-height;
                alignment: start;
                MenuSetRow {
                    skin: root.skin; label: "Look"; ctl-h: 48px; ink: root.ink; muted: root.muted;
                    Dropdown {
                        width: parent.width;
                        options: ["Plain", "Full cover", "Turntable", "Cassette", "Half cassette"];
                        selected: root.style;
                        tk-raised: root.raised; tk-line: root.line; tk-text: root.ink; tk-muted: root.muted; tk-menu: root.menu; tk-pressed: root.pressed;
                        picked(i) => { root.pick-look(i); }
                    }
                }
                if root.style >= 2: MenuSetRow {
                    skin: root.skin; label: root.style == 2 ? "The record holds" : "The tape holds"; ctl-h: 40px; ink: root.ink; muted: root.muted;
                    Segmented {
                        width: parent.width;
                        options: ["One track", "Whole queue"];
                        selected: root.holds;
                        tk-raised: root.raised; tk-text: root.ink; tk-on-text: root.on-text;
                        picked(i) => { Act.act("music.holds", i); }
                    }
                }
                // turntable: the wood of the counter it stands on (photo swatches, as many in a row as fit)
                if root.style == 2: MenuSetRow {
                    skin: root.skin; label: "Counter"; ink: root.ink; muted: root.muted;
                    ctl-h: 8px + root.wood-rows * 32px + (root.wood-rows - 1) * 10px;
                    for w[i] in root.woods: Rectangle {
                        x: 4px + Math.mod(i, root.wood-cols) * 60px; y: 4px + Math.floor(i / root.wood-cols) * 42px; width: 52px; height: 32px;
                        Rectangle { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; border-radius: 7px;
                            border-width: i == root.wood ? 2px : 0px; border-color: root.ink; }
                        Rectangle {
                            border-radius: 4px; clip: true; border-width: 1px; border-color: #00000040;
                            Image { width: parent.width; height: parent.height; source: w; image-fit: cover; }
                        }
                        TouchArea { x: -4px; y: -6px; width: parent.width + 8px; height: parent.height + 12px; clicked => { Act.act("music.wood", i); } }
                    }
                }
                if root.style == 0 || root.style >= 3: MenuSetRow {
                    skin: root.skin; label: root.style == 0 ? "Blurred cover" : "Cover behind the cassette"; inline: true; ctl-h: 32px; ink: root.ink; muted: root.muted;
                    Toggle {
                        on: root.style == 0 ? root.cover-blur : root.cs-cover;
                        tk-raised: root.raised; tk-line: root.line; tk-knob: root.knob;
                        toggled => {
                            Act.act(root.style == 0 ? "music.blur" : "music.cover-bg", root.style == 0 ? (root.cover-blur ? "0" : "1") : (root.cs-cover ? "0" : "1"));
                        }
                    }
                }
                MenuSetRow {
                    skin: root.skin; label: "Long titles"; ctl-h: 40px; ink: root.ink; muted: root.muted;
                    Segmented {
                        width: parent.width;
                        options: ["Cut off", "Scroll"];
                        selected: root.scroll ? 1 : 0;
                        tk-raised: root.raised; tk-text: root.ink; tk-on-text: root.on-text;
                        picked(i) => { Act.act("music.scroll", i); }
                    }
                }
                // the scroll speed in five steps, slow .. fast (the bubble names the step)
                if root.scroll: MenuSetRow {
                    skin: root.skin; label: "Scroll speed"; ctl-h: 44px; ink: root.ink; muted: root.muted;
                    TouchSlider {
                        width: parent.width;
                        value: (root.scroll-speed - 1) / 4;
                        bubble-text: ["Slow", "Calm", "Medium", "Brisk", "Fast"][Math.round(root.speed-live * 4)];
                        tk-track: root.track; tk-knob: root.skin == 0 ? (Theme.dark ? #F5F3EE : #FFFFFF) : root.ink; tk-text: root.ink; tk-on-text: root.on-text;
                        changed(v, final) => {
                            root.speed-live = v;
                            if final { Act.act("music.speed", Math.round(v * 4) + 1); }
                        }
                    }
                }
            }
        }
        // Done (28.7 primary) at the bottom right
        if root.kind == 1: TextButton {
            property <length> pad: root.skin == 0 ? 10px : 2px;
            width: done-w.preferred-width + 44px;
            x: root.width - root.pad-x - self.pad - self.width;
            y: root.height - root.foot + (root.skin == 0 ? 6px : 8px);
            text: "Done"; primary: true;
            tk-raised: root.raised; tk-pressed: root.pressed; tk-text: root.ink; tk-on-text: root.on-text;
            clicked => { root.done(); }
        }
        done-w := Text { visible: false; text: "Done"; font-size: 16px; font-weight: 600; }

        // the J-card's crease shadow while it unfolds
        if root.skin == 2 && root.j-fold: Rectangle {
            x: 0; y: Math.max(0, root.j-shown - 28) * 1px; width: root.width; height: 28px;
            background: @linear-gradient(180deg, #00000000 0%, #00000033 100%);
        }
    }
}
